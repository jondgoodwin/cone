// ---- Device and CommandQueue: the Device, the end of a frame, and the memory,
// image and pipeline-layout helpers the Device uses ----

// A logical GPU: what makes buffers, textures, shaders, pipelines, command
// encoders and swapchains
pub struct Device {
  backend: DeviceBackend;
  pub queue: CommandQueue;
  pub frameNumber: u64;             // frames ended so far
  pub timestampPeriod: f32 = 0.;    // nanoseconds a timestamp's tick; 0: its queue keeps no time
  pub maxAnisotropy: f32 = 0.;      // the most anisotropic filtering a sampler may ask for; 0: the GPU has none
  pub rayTracing: bool = false;     // the device was made with ray queries and acceleration structures (raytracing.cone);
                                   // false on a GPU that lacks them, which then draws exactly as it always did
  pub compute: ComputeCapabilities = new ComputeCapabilities();   // compute features (features.cone): the flags are what the
                                   // device was made with, the numbers the GPU's
  pub maxStorageBufferBindingSize: u64 = MAX_STORAGE_BUFFER_BINDING_SIZE;   // the most bytes a bound storage buffer ranges over
                                   // (WebGPU's 128 MiB; the GPU's own with ComputeRequest.largeBuffers)
  pub maxStorageBuffersPerStage: u32 = MAX_STORAGE_BUFFERS_PER_SHADER_STAGE;   // the most storage buffers one shader stage sees (8; ditto)

  pub fn isValid(self: &) bool { (backend.device as *u8 as usize) != 0usize }

  // Begin a frame, if one is not begun: wait until the GPU has finished the
  // frame that last used this frame's state, and reset its command pools.
  // 'getCurrentTexture', 'createCommandEncoder', 'writeBuffer' and
  // 'createTexture' begin one themselves.
  pub fn beginFrame(self: &mut) { beginQueueFrame(&mut queue); }

  // End a frame that presents nothing (a swapchain's 'present' ends its own):
  // its fence is signalled once all it submitted is done
  pub fn endFrame(self: &mut) {
    if !queue.backend.inFrame { return; }
    endFrameSignalling(self, 0u32, null);
  }

  // Wait until the GPU has finished everything submitted
  pub fn waitIdle(self: &mut) {
    if self.isValid() { check(backend.fns.deviceWaitIdle(backend.device), "vkDeviceWaitIdle"); }
  }

  // Whether the GPU has finished frame 'frame' (the 'frameNumber' it was
  // recorded under: every command submitted in it, and the uploads before
  // them). Never waits. False while the frame is still being recorded, since
  // its fence is signalled only when it ends ('endFrame', or a swapchain's
  // 'present').
  pub fn frameDone(self: &, frame: u64) bool {
    if frame >= frameNumber { return false; }
    if !self.isValid() { return true; }
    // Its state comes round again FRAMES_IN_FLIGHT frames on, and the frame
    // that reuses it waited for its fence when it began
    let reuser = frame + u64.from(FRAMES_IN_FLIGHT);
    if reuser < frameNumber || (reuser == frameNumber && queue.backend.inFrame) { return true; }
    let i = usize.from(frame % u64.from(FRAMES_IN_FLIGHT));
    if !queue.backend.frames[i].pending { return true; }
    var fence = queue.backend.frames[i].fence;
    backend.fns.waitForFences(backend.device, 1u32, &mut fence as *vulkan.Fence, vulkan.TRUE, 0u64) == vulkan.SUCCESS
  }

  // Wait until the GPU has finished frame 'frame', and nothing submitted
  // after it. A frame still being recorded is not waited for, since it would
  // never finish: end it first.
  pub fn waitFrame(self: &mut, frame: u64) {
    if frame >= frameNumber || self.frameDone(frame) { return; }
    let i = usize.from(frame % u64.from(FRAMES_IN_FLIGHT));
    var fence = queue.backend.frames[i].fence;
    check(backend.fns.waitForFences(backend.device, 1u32, &mut fence as *vulkan.Fence, vulkan.TRUE, NO_TIMEOUT),
      "vkWaitForFences");
  }

  // A fence of its own, unsignalled, for one submission
  // ('queue.submitSignalling' or 'queue.signal'), which another thread may
  // wait on: it is never reset or reused, as a frame's fence is. Check
  // 'isValid'.
  pub fn createFence(self: &) Fence {
    var fence = new vulkan.Fence(0u64);
    if self.isValid() {
      let fci = new vulkan.FenceCreateInfo();
      check(backend.fns.createFence(backend.device, &fci, nullp(), &mut fence), "vkCreateFence");
    }
    new Fence(backend.device, backend.fns, fence, false)
  }

  // A command encoder, recording into a command buffer of this frame's
  pub fn createCommandEncoder(self: &mut) CommandEncoder {
    beginQueueFrame(&mut queue);
    let cmd = nextCommandBuffer(&mut queue);
    new CommandEncoder(new EncoderBackend(cmd, queue.fns))
  }

  // A swapchain presenting to 'surface', its textures 'width' by 'height'
  // (the window's drawable size, window's 'size'), in an sRGB format where
  // the surface offers one, presented in step with the display's refresh
  // (WebGPU's "fifo"). With 'depthFormat' TEXTURE_FORMAT_DEPTH32_FLOAT, it
  // also keeps a depth texture of its size, made again with it
  // (TEXTURE_FORMAT_UNDEFINED: none). Check 'isValid'.
  pub fn createSwapChain(self: &mut, surface: &Surface, width: u32, height: u32, depthFormat: u32) SwapChain {
    var sc = new SwapChain(new SwapChainBackend(backend.device, backend.fns, backend.physical, backend.ifns, surface.backend.surface,
      new vulkan.SwapchainKHR(0u64), vulkan.FORMAT_UNDEFINED, 0u32, 0u32, false,
      new Array[vulkan.Image, 8] <- fill new vulkan.Image(0u64),
      new Array[vulkan.ImageView, 8] <- fill new vulkan.ImageView(0u64),
      new Array[vulkan.Semaphore, 8] <- fill new vulkan.Semaphore(0u64), new Array[bool, 8] <- fill false,
      new Array[vulkan.Semaphore, 2] <- fill new vulkan.Semaphore(0u64), 0u32, 0u32, false, true, width, height,
      vkFormat(depthFormat), new vulkan.Image(0u64), new vulkan.DeviceMemory(0u64), new vulkan.ImageView(0u64), false,
      queue.backend.memory),
      0u32, 0u32, TEXTURE_FORMAT_UNDEFINED, depthFormat, 0u64);
    if !self.isValid() || !surface.isValid() { return sc; }
    let sci = new vulkan.SemaphoreCreateInfo();
    var i = 0usize;
    while i < 2usize {
      var sem = new vulkan.Semaphore(0u64);
      check(backend.fns.createSemaphore(backend.device, &sci, nullp(), &mut sem), "vkCreateSemaphore");
      sc.backend.acquire[i] = sem;
      i = i + 1usize;
    }
    sc.configure();
    sc
  }

  // A buffer of 'size' bytes, for 'usage' (BUFFER_USAGE_... OR-ed). One the
  // CPU maps (MAP_READ or MAP_WRITE) is in memory the CPU sees, and mapped
  // for as long as it lives: one it only reads (MAP_READ alone) in memory
  // the CPU caches, where the GPU has it, so reading it back is fast; any
  // other is in the GPU's own memory, written by 'queue.writeBuffer' (with
  // COPY_DST) or cleared by 'queue.clearBuffer'. Check 'isValid'.
  pub fn createBuffer(self: &mut, size: u64, usage: u32) Buffer {
    var vkUsage = 0u32;
    if (usage & BUFFER_USAGE_COPY_SRC) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_TRANSFER_SRC_BIT; }
    if (usage & (BUFFER_USAGE_COPY_DST | BUFFER_USAGE_QUERY_RESOLVE)) != 0u32 {
      vkUsage = vkUsage | vulkan.BUFFER_USAGE_TRANSFER_DST_BIT;
    }
    if (usage & BUFFER_USAGE_INDEX) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_INDEX_BUFFER_BIT; }
    if (usage & BUFFER_USAGE_VERTEX) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_VERTEX_BUFFER_BIT; }
    if (usage & BUFFER_USAGE_UNIFORM) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_UNIFORM_BUFFER_BIT; }
    if (usage & BUFFER_USAGE_STORAGE) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_STORAGE_BUFFER_BIT; }
    if (usage & BUFFER_USAGE_INDIRECT) != 0u32 { vkUsage = vkUsage | vulkan.BUFFER_USAGE_INDIRECT_BUFFER_BIT; }
    // Ray tracing: the GPU reads these by address (a build's inputs, its scratch, the structure's own memory)
    if (usage & (BUFFER_USAGE_ACCELERATION_STRUCTURE_INPUT | BUFFER_USAGE_ACCELERATION_STRUCTURE_SCRATCH
        | BUFFER_USAGE_ACCELERATION_STRUCTURE_STORAGE)) != 0u32 {
      if !rayTracing {
        fail("createBuffer: an acceleration structure's buffer on a device without ray tracing");
        return new Buffer(new BufferBackend(backend.device, backend.fns, new vulkan.Buffer(0u64), new vulkan.DeviceMemory(0u64),
          nullp(), true), size, usage);
      }
      vkUsage = vkUsage | vulkan.BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT | vulkan.BUFFER_USAGE_STORAGE_BUFFER_BIT;
      if (usage & BUFFER_USAGE_ACCELERATION_STRUCTURE_INPUT) != 0u32 {
        vkUsage = vkUsage | vulkan.BUFFER_USAGE_ACCELERATION_STRUCTURE_BUILD_INPUT_READ_ONLY_BIT_KHR;
      }
      if (usage & BUFFER_USAGE_ACCELERATION_STRUCTURE_STORAGE) != 0u32 {
        vkUsage = vkUsage | vulkan.BUFFER_USAGE_ACCELERATION_STRUCTURE_STORAGE_BIT_KHR;
      }
    }
    // More than the GPU allows one buffer or one allocation (which a buffer is): refused here, once, naming the
    // limit, rather than left to Vulkan (compute.maxBufferSize, compute.maxMemoryAllocationSize)
    if self.isValid() && ((compute.maxBufferSize != 0u64 && size > compute.maxBufferSize)
        || (compute.maxMemoryAllocationSize != 0u64 && size > compute.maxMemoryAllocationSize)) {
      fail("createBuffer: more bytes than the GPU allows one buffer or one memory allocation (compute.maxBufferSize, compute.maxMemoryAllocationSize)");
      return new Buffer(new BufferBackend(backend.device, backend.fns, new vulkan.Buffer(0u64), new vulkan.DeviceMemory(0u64),
        nullp(), true), size, usage);
    }
    let mapping = usage & (BUFFER_USAGE_MAP_READ | BUFFER_USAGE_MAP_WRITE);
    var b = new BufferBackend(backend.device, backend.fns, new vulkan.Buffer(0u64), new vulkan.DeviceMemory(0u64), nullp(), true);
    if self.isValid() { b = allocateBuffer(&backend.fns, backend.device, &queue.backend.memory, size, vkUsage, mapping); }
    new Buffer(b, size, usage)
  }

  // The ray-tracing structure over one mesh's triangles, 'vertexCount' float3 positions and
  // 'indexCount' u32 indices, both buffers made with BUFFER_USAGE_ACCELERATION_STRUCTURE_INPUT
  // (raytracing.cone). Needs 'rayTracing'. Check 'isValid'.
  pub fn createBottomLevel(self: &mut, positions: &Buffer, vertexCount: u32, indices: &Buffer, indexCount: u32) AccelerationStructure {
    makeBottomLevel(self, positions, vertexCount, indices, indexCount)
  }

  // The structure over up to 'maxInstances' placed bottom-level ones (raytracing.cone). Needs
  // 'rayTracing'. Check 'isValid'.
  pub fn createTopLevel(self: &mut, maxInstances: u32) AccelerationStructure { makeTopLevel(self, maxInstances) }

  // A texture 'desc' describes, in the GPU's own memory: one to draw into,
  // its usage TEXTURE_USAGE_RENDER_ATTACHMENT (and TEXTURE_USAGE_COPY_SRC to
  // read it back), its format a color format or TEXTURE_FORMAT_DEPTH32_FLOAT;
  // one shaders sample, its usage TEXTURE_USAGE_TEXTURE_BINDING (and
  // TEXTURE_USAGE_COPY_DST, for 'queue.writeTexture' to fill it), of a color
  // format; with both usages, a color texture drawn into by some passes
  // and sampled by later ones (an HDR frame, a bloom chain, a cube map drawn
  // face by face and level by level); or a storage texture that compute
  // shaders read and write texel by texel, its usage
  // TEXTURE_USAGE_STORAGE_BINDING (with TEXTURE_BINDING too, if later passes
  // sample it), of r32float, r32uint, rgba16float or rgba8unorm. A 3-D
  // texture ('dimension' TEXTURE_DIMENSION_3D) is sampled or a storage
  // texture, not drawn into, and at most MAX_TEXTURE_DIMENSION_3D each way.
  // It is moved to the layout it rests in ahead of the next submission.
  // Check 'isValid'.
  pub fn createTexture(self: &mut, desc: &TextureDescriptor) Texture {
    var result = new Texture(new TextureBackend(new vulkan.Image(0u64), new vulkan.ImageView(0u64), KIND_NONE, true,
      backend.device, backend.fns, new vulkan.DeviceMemory(0u64)), desc.width, desc.height, desc.format, desc.usage,
      desc.mipLevelCount, desc.depthOrArrayLayers, desc.dimension);
    if !self.isValid() { return result; }
    let attachment = (desc.usage & TEXTURE_USAGE_RENDER_ATTACHMENT) != 0u32;
    let sampled = (desc.usage & TEXTURE_USAGE_TEXTURE_BINDING) != 0u32;
    let storage = (desc.usage & TEXTURE_USAGE_STORAGE_BINDING) != 0u32;
    let volume = desc.dimension == TEXTURE_DIMENSION_3D;
    if !attachment && !sampled && !storage {
      fail("createTexture: a texture is drawn into (TEXTURE_USAGE_RENDER_ATTACHMENT), sampled (TEXTURE_USAGE_TEXTURE_BINDING), a storage texture (TEXTURE_USAGE_STORAGE_BINDING), or more than one");
      return result;
    }
    if desc.dimension != TEXTURE_DIMENSION_2D && !volume {
      fail("createTexture: a texture is 2-D or 3-D");
      return result;
    }
    let format = vkFormat(desc.format);
    if format == vulkan.FORMAT_UNDEFINED {
      fail("createTexture: the format is not one offered");
      return result;
    }
    // The levels halve all three sides of a 3-D texture, the width and
    // height of a 2-D one
    var largest = umax(desc.width, desc.height);
    if volume { largest = umax(largest, desc.depthOrArrayLayers); }
    if desc.mipLevelCount == 0u32 || desc.mipLevelCount > 16u32 || desc.depthOrArrayLayers == 0u32
        || (largest >> (desc.mipLevelCount - 1u32)) == 0u32 {
      fail("createTexture: no levels or layers, or more levels than halving its size allows");
      return result;
    }
    let depth = desc.format == TEXTURE_FORMAT_DEPTH32_FLOAT;
    if sampled && depth && !attachment {
      fail("createTexture: a depth texture that is sampled is also drawn into (shadow maps)");
      return result;
    }
    if storage && (attachment || !isStorageFormat(desc.format)) {
      fail("createTexture: a storage texture is r32float, r32uint, rgba16float or rgba8unorm, and not drawn into (yet)");
      return result;
    }
    if volume && (attachment || largest > MAX_TEXTURE_DIMENSION_3D) {
      fail("createTexture: a 3-D texture is not drawn into (yet), and is at most 2048 texels each way");
      return result;
    }
    var kind = KIND_COLOR;
    var vkUsage = vulkan.IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
    if depth {
      kind = KIND_DEPTH;
      vkUsage = vulkan.IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT;
    }
    if sampled && depth {
      // Drawn into by depth-only passes and sampled: rests read-only
      kind = KIND_DEPTH_SAMPLED;
    } elif sampled {
      kind = KIND_SAMPLED;
      vkUsage = 0u32;
      if attachment {
        kind = KIND_RENDER_SAMPLED;
        vkUsage = vulkan.IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
      }
    }
    if storage {
      kind = KIND_STORAGE;
      vkUsage = vulkan.IMAGE_USAGE_STORAGE_BIT;
    }
    if (desc.usage & TEXTURE_USAGE_COPY_SRC) != 0u32 { vkUsage = vkUsage | vulkan.IMAGE_USAGE_TRANSFER_SRC_BIT; }
    if (desc.usage & TEXTURE_USAGE_COPY_DST) != 0u32 { vkUsage = vkUsage | vulkan.IMAGE_USAGE_TRANSFER_DST_BIT; }
    if (desc.usage & TEXTURE_USAGE_TEXTURE_BINDING) != 0u32 { vkUsage = vkUsage | vulkan.IMAGE_USAGE_SAMPLED_BIT; }
    // Six square layers, or a multiple of six, may be seen as a cube (wgpu's
    // rule: WebGPU decides at the view)
    var flags = 0u32;
    if !volume && desc.depthOrArrayLayers % 6u32 == 0u32 && desc.width == desc.height {
      flags = vulkan.IMAGE_CREATE_CUBE_COMPATIBLE_BIT;
    }
    var image = new vulkan.Image(0u64);
    var memory = new vulkan.DeviceMemory(0u64);
    var view = new vulkan.ImageView(0u64);
    if !makeImageLevels(&backend.fns, backend.device, &queue.backend.memory, desc.width, desc.height, format, vkUsage,
        desc.mipLevelCount, desc.depthOrArrayLayers, flags, volume, &mut image, &mut memory, &mut view) {
      return result;
    }
    result.backend.image = image;
    result.backend.memory = memory;
    result.backend.view = view;
    result.backend.kind = kind;
    result.backend.mipCount = desc.mipLevelCount;
    result.backend.layerCount = if volume { 1u32 } else { desc.depthOrArrayLayers };
    // Room for a view of each level of each layer, a cube and an array view
    // of each level, and a few more
    result.backend.views = newViews(desc.mipLevelCount * (desc.depthOrArrayLayers + 2u32) + 8u32);
    let cmd = uploadCommands(&mut queue);
    if !isNull(cmd) { firstLayout(&backend.fns, cmd, image, kind); }
    result
  }

  // A shader module from SPIR-V: 32-bit words, as tools/shaders/shaders.py
  // embeds them. A compute entry point's workgroup must be within WebGPU's
  // limits (MAX_COMPUTE_WORKGROUP_SIZE_X and the rest). Check 'isValid'.
  pub fn createShaderModule(self: &, spirv: &Array[u32]) ShaderModule {
    var module = new vulkan.ShaderModule(0u64);
    if self.isValid() && spirv.len > 0usize && workgroupsWithinLimits(spirv) && capabilitiesEnabled(spirv, &compute) {
      let ci = new vulkan.ShaderModuleCreateInfo(codeSize: spirv.len * 4usize, pCode: &spirv[0] as *u32);
      check(backend.fns.createShaderModule(backend.device, &ci, nullp(), &mut module), "vkCreateShaderModule");
    }
    new ShaderModule(new ShaderModuleBackend(backend.device, backend.fns, module))
  }

  // A bind group layout: the bindings a bind group of it has, each a
  // uniform or storage buffer, a sampler, a texture or a storage texture,
  // seen by the stages its 'visibility' names.
  // Bindings are numbered below MAX_BINDINGS. Check 'isValid'.
  pub fn createBindGroupLayout(self: &, entries: &Array[BindGroupLayoutEntry]) BindGroupLayout {
    var result = new BindGroupLayout(new BindGroupLayoutBackend(backend.device, backend.fns, new vulkan.DescriptorSetLayout(0u64),
      new Array[u32, 16] <- fill 0u32, new Array[u32, 3] <- fill 0u32, new Array[u32, 3] <- fill 0u32));
    if !self.isValid() { return result; }
    if entries.len > usize.from(MAX_BINDINGS) {
      fail("createBindGroupLayout: more than 16 entries");
      return result;
    }
    var bindings = new Array[vulkan.DescriptorSetLayoutBinding, 16] <- fill new vulkan.DescriptorSetLayoutBinding(
      pImmutableSamplers: null);
    var i = 0usize;
    while i < entries.len {
      let e = entries[i];
      if e.binding >= MAX_BINDINGS {
        fail("createBindGroupLayout: a binding numbered 16 or more");
        return result;
      }
      let storageBuffer = e.kind == BINDING_KIND_BUFFER && e.bufferType != BUFFER_BINDING_TYPE_UNIFORM;
      let storageTexture = e.kind == BINDING_KIND_STORAGE_TEXTURE;
      if !bindingWithinWebGPU(&e) { return result; }
      let type = descriptorType(e.kind, e.bufferType);
      bindings[i].binding = e.binding;
      bindings[i].descriptorType = type;
      bindings[i].stageFlags = shaderStages(e.visibility);
      result.backend.types[usize.from(e.binding)] = type;
      // What each stage sees, counted for the pipeline layout's limits
      var s = 0usize;
      while s < 3usize {
        if (e.visibility & (1u32 << u32.from(s))) != 0u32 {
          if storageBuffer { result.backend.storageBuffers[s] = result.backend.storageBuffers[s] + 1u32; }
          if storageTexture { result.backend.storageTextures[s] = result.backend.storageTextures[s] + 1u32; }
        }
        s = s + 1usize;
      }
      i = i + 1usize;
    }
    let ci = new vulkan.DescriptorSetLayoutCreateInfo(bindingCount: u32.from(entries.len),
      pBindings: &bindings as *vulkan.DescriptorSetLayoutBinding);
    var layout = new vulkan.DescriptorSetLayout(0u64);
    check(backend.fns.createDescriptorSetLayout(backend.device, &ci, nullp(), &mut layout), "vkCreateDescriptorSetLayout");
    result.backend.layout = layout;
    result
  }

  // A pipeline layout: the bind groups a pipeline of it binds, in order
  // (group 0 first, at most MAX_BIND_GROUPS), and 'immediateSize' bytes of
  // immediates (a multiple of 4, at most MAX_IMMEDIATE_SIZE; 0 for none).
  // No stage may see more than MAX_STORAGE_BUFFERS_PER_SHADER_STAGE storage
  // buffers or MAX_STORAGE_TEXTURES_PER_SHADER_STAGE storage textures in all
  // (WebGPU's limits). Check 'isValid'.
  pub fn createPipelineLayout(self: &, bindGroupLayouts: &Array[&BindGroupLayout], immediateSize: u32) PipelineLayout {
    if bindGroupLayouts.len > usize.from(MAX_BIND_GROUPS) {
      fail("createPipelineLayout: more than 4 bind groups");
      return new PipelineLayout(new PipelineLayoutBackend(backend.device, backend.fns, new vulkan.PipelineLayout(0u64)), 0u32);
    }
    var sets = new Array[vulkan.DescriptorSetLayout, 4] <- fill new vulkan.DescriptorSetLayout(0u64);
    var buffers = new Array[u32, 3] <- fill 0u32;
    var textures = new Array[u32, 3] <- fill 0u32;
    var i = 0usize;
    while i < bindGroupLayouts.len {
      sets[i] = bindGroupLayouts[i].backend.layout;
      var s = 0usize;
      while s < 3usize {
        buffers[s] = buffers[s] + bindGroupLayouts[i].backend.storageBuffers[s];
        textures[s] = textures[s] + bindGroupLayouts[i].backend.storageTextures[s];
        s = s + 1usize;
      }
      i = i + 1usize;
    }
    var s = 0usize;
    while s < 3usize {
      if buffers[s] > maxStorageBuffersPerStage || textures[s] > MAX_STORAGE_TEXTURES_PER_SHADER_STAGE {
        fail("createPipelineLayout: a stage sees more storage buffers than the device allows (8, or with ComputeRequest.largeBuffers the GPU's own) or more than 4 storage textures (WebGPU's limits)");
        return new PipelineLayout(new PipelineLayoutBackend(backend.device, backend.fns, new vulkan.PipelineLayout(0u64)), 0u32);
      }
      s = s + 1usize;
    }
    makePipelineLayout(&backend.fns, backend.device, u32.from(bindGroupLayouts.len), &sets, immediateSize)
  }

  // A pipeline layout with no bind groups, only 'immediateSize' bytes of
  // immediates (0 for none)
  pub fn createEmptyPipelineLayout(self: &, immediateSize: u32) PipelineLayout {
    let sets = new Array[vulkan.DescriptorSetLayout, 4] <- fill new vulkan.DescriptorSetLayout(0u64);
    makePipelineLayout(&backend.fns, backend.device, 0u32, &sets, immediateSize)
  }

  // A render pipeline, as 'desc' describes it: what its shaders are, how
  // vertices are read from vertex buffers, how triangles are rasterized, and
  // the formats of the color target and (if any) the depth texture it draws
  // into. The viewport and the scissor rectangle are set as it draws (a
  // render pass sets them to the whole target when it begins). Check
  // 'isValid'.
  pub fn createRenderPipeline(self: &, desc: &RenderPipelineDescriptor) RenderPipeline {
    var result = new RenderPipeline(new PipelineBackend(backend.device, backend.fns, new vulkan.Pipeline(0u64), desc.layout.backend.layout));
    if !self.isValid() { return result; }

    // The two stages
    var vertexName = String.from(desc.vertexEntryPoint);
    var fragmentName = String.from(desc.fragmentEntryPoint);
    var stages = new Array[vulkan.PipelineShaderStageCreateInfo, 2] <- fill new vulkan.PipelineShaderStageCreateInfo(
      module: new vulkan.ShaderModule(0u64), pName: nullp(), pSpecializationInfo: nullp());
    stages[0].stage = vulkan.SHADER_STAGE_VERTEX_BIT;
    stages[0].module = desc.vertexModule.backend.module;
    stages[0].pName = vertexName.cstr().ptr();
    stages[1].stage = vulkan.SHADER_STAGE_FRAGMENT_BIT;
    stages[1].module = desc.fragmentModule.backend.module;
    stages[1].pName = fragmentName.cstr().ptr();

    // The vertex buffers, and their attributes
    if desc.buffers.len > usize.from(MAX_VERTEX_BUFFERS) {
      fail("createRenderPipeline: more than 8 vertex buffers");
      return result;
    }
    var bindings = new Array[vulkan.VertexInputBindingDescription, 8] <- fill new vulkan.VertexInputBindingDescription(0u32, 0u32);
    var attributes = new Array[vulkan.VertexInputAttributeDescription, 16] <- fill new vulkan.VertexInputAttributeDescription(
      0u32, 0u32, 0u32, 0u32);
    var attributeCount = 0usize;
    var b = 0usize;
    while b < desc.buffers.len {
      let layout = desc.buffers[b];
      bindings[b].binding = u32.from(b);
      bindings[b].stride = u32.from(layout.arrayStride);
      if layout.stepMode == VERTEX_STEP_MODE_INSTANCE { bindings[b].inputRate = vulkan.VERTEX_INPUT_RATE_INSTANCE; }
      var a = 0usize;
      while a < layout.attributes.len {
        if attributeCount == usize.from(MAX_VERTEX_ATTRIBUTES) {
          fail("createRenderPipeline: more than 16 vertex attributes");
          return result;
        }
        let attribute = layout.attributes[a];
        attributes[attributeCount] = new vulkan.VertexInputAttributeDescription(attribute.shaderLocation, u32.from(b),
          vertexFormat(attribute.format), u32.from(attribute.offset));
        attributeCount = attributeCount + 1usize;
        a = a + 1usize;
      }
      b = b + 1usize;
    }
    let vertexInput = new vulkan.PipelineVertexInputStateCreateInfo(
      vertexBindingDescriptionCount: u32.from(desc.buffers.len),
      pVertexBindingDescriptions: &bindings as *vulkan.VertexInputBindingDescription,
      vertexAttributeDescriptionCount: u32.from(attributeCount),
      pVertexAttributeDescriptions: &attributes as *vulkan.VertexInputAttributeDescription);
    let inputAssembly = new vulkan.PipelineInputAssemblyStateCreateInfo(topology: topology(desc.topology));
    let viewport = new vulkan.PipelineViewportStateCreateInfo(viewportCount: 1u32,
      pViewports: null, scissorCount: 1u32, pScissors: null);

    // Rasterization: which faces are culled, and which way round a front
    // face goes (the viewport is flipped, so the screen's way round is
    // Vulkan's)
    var cull = vulkan.CULL_MODE_NONE;
    if desc.cullMode == CULL_MODE_FRONT { cull = vulkan.CULL_MODE_FRONT_BIT; }
    if desc.cullMode == CULL_MODE_BACK { cull = vulkan.CULL_MODE_BACK_BIT; }
    var front = vulkan.FRONT_FACE_COUNTER_CLOCKWISE;
    if desc.frontFace == FRONT_FACE_CW { front = vulkan.FRONT_FACE_CLOCKWISE; }
    var raster = new vulkan.PipelineRasterizationStateCreateInfo(cullMode: cull, frontFace: front);
    if desc.depthBiasConstant != 0. || desc.depthBiasSlopeScale != 0. {
      raster.depthBiasEnable = vulkan.TRUE;
      raster.depthBiasConstantFactor = desc.depthBiasConstant;
      raster.depthBiasSlopeFactor = desc.depthBiasSlopeScale;
    }
    let multisample = new vulkan.PipelineMultisampleStateCreateInfo(pSampleMask: null);

    // Depth
    let hasDepth = desc.depthFormat != TEXTURE_FORMAT_UNDEFINED;
    var depthState = new vulkan.PipelineDepthStencilStateCreateInfo(front: new vulkan.StencilOpState(),
      back: new vulkan.StencilOpState());
    if hasDepth {
      depthState.depthTestEnable = vulkan.TRUE;
      if desc.depthWriteEnabled { depthState.depthWriteEnable = vulkan.TRUE; }
      depthState.depthCompareOp = desc.depthCompare - 1u32;    // Vulkan's order, from 0
    }

    // One color target, written whole unless the descriptor blends
    var blendAttachment = new vulkan.PipelineColorBlendAttachmentState();
    if desc.blendEnabled {
      blendAttachment.blendEnable = vulkan.TRUE;
      blendAttachment.srcColorBlendFactor = blendFactor(desc.colorSrcFactor);
      blendAttachment.dstColorBlendFactor = blendFactor(desc.colorDstFactor);
      blendAttachment.srcAlphaBlendFactor = blendFactor(desc.alphaSrcFactor);
      blendAttachment.dstAlphaBlendFactor = blendFactor(desc.alphaDstFactor);
    }
    // (a depth-only pipeline, colorFormat UNDEFINED, has none)
    let colorCount = if desc.colorFormat == TEXTURE_FORMAT_UNDEFINED { 0u32 } else { 1u32 };
    let blend = new vulkan.PipelineColorBlendStateCreateInfo(attachmentCount: colorCount,
      pAttachments: &blendAttachment as *vulkan.PipelineColorBlendAttachmentState, blendConstants: new Array[f32, 4] <- fill 0f);
    let dynamics: Array[u32, 2] = [vulkan.DYNAMIC_STATE_VIEWPORT, vulkan.DYNAMIC_STATE_SCISSOR];
    let dynamic = new vulkan.PipelineDynamicStateCreateInfo(dynamicStateCount: 2u32,
      pDynamicStates: &dynamics as *u32);
    let colorFormats: Array[u32, 1] = [vkFormat(desc.colorFormat)];
    var rendering = new vulkan.PipelineRenderingCreateInfo(colorAttachmentCount: colorCount,
      pColorAttachmentFormats: &colorFormats as *u32);
    if hasDepth { rendering.depthAttachmentFormat = vkFormat(desc.depthFormat); }

    let ci = new vulkan.GraphicsPipelineCreateInfo(pNext: &rendering as *u8, stageCount: 2u32,
      pStages: &stages as *vulkan.PipelineShaderStageCreateInfo,
      pVertexInputState: &vertexInput as *vulkan.PipelineVertexInputStateCreateInfo,
      pInputAssemblyState: &inputAssembly as *vulkan.PipelineInputAssemblyStateCreateInfo,
      pTessellationState: nullp(),
      pViewportState: &viewport as *vulkan.PipelineViewportStateCreateInfo,
      pRasterizationState: &raster as *vulkan.PipelineRasterizationStateCreateInfo,
      pMultisampleState: &multisample as *vulkan.PipelineMultisampleStateCreateInfo,
      pDepthStencilState: &depthState as *vulkan.PipelineDepthStencilStateCreateInfo,
      pColorBlendState: &blend as *vulkan.PipelineColorBlendStateCreateInfo,
      pDynamicState: &dynamic as *vulkan.PipelineDynamicStateCreateInfo,
      layout: desc.layout.backend.layout, renderPass: new vulkan.RenderPass(0u64),
      basePipelineHandle: new vulkan.Pipeline(0u64));
    var pipeline = new vulkan.Pipeline(0u64);
    check(backend.fns.createGraphicsPipelines(backend.device, new vulkan.PipelineCache(0u64), 1u32,
      &ci as *vulkan.GraphicsPipelineCreateInfo, nullp(), &mut pipeline as *vulkan.Pipeline), "vkCreateGraphicsPipelines");
    result.backend.pipeline = pipeline;
    result
  }

  // A compute pipeline, as 'desc' describes it: its shader's entry point
  // and the layout of what it binds. Check 'isValid'.
  pub fn createComputePipeline(self: &, desc: &ComputePipelineDescriptor) ComputePipeline {
    var result = new ComputePipeline(new PipelineBackend(backend.device, backend.fns, new vulkan.Pipeline(0u64), desc.layout.backend.layout));
    if !self.isValid() || !desc.module.isValid() || !desc.layout.isValid() { return result; }
    var name = String.from(desc.entryPoint);
    let stage = new vulkan.PipelineShaderStageCreateInfo(stage: vulkan.SHADER_STAGE_COMPUTE_BIT,
      module: desc.module.backend.module, pName: name.cstr().ptr(), pSpecializationInfo: nullp());
    let ci = new vulkan.ComputePipelineCreateInfo(stage: stage, layout: desc.layout.backend.layout,
      basePipelineHandle: new vulkan.Pipeline(0u64));
    var pipeline = new vulkan.Pipeline(0u64);
    check(backend.fns.createComputePipelines(backend.device, new vulkan.PipelineCache(0u64), 1u32,
      &ci as *vulkan.ComputePipelineCreateInfo, nullp(), &mut pipeline as *vulkan.Pipeline), "vkCreateComputePipelines");
    result.backend.pipeline = pipeline;
    result
  }

  // A query set of 'count' queries (at most MAX_QUERY_COUNT) of 'type':
  // QUERY_TYPE_TIMESTAMP, the GPU's clock, written by
  // 'encoder.writeTimestamp' and copied into a buffer by
  // 'encoder.resolveQuerySet'. The device must keep time
  // ('timestampPeriod' above 0). Check 'isValid'.
  pub fn createQuerySet(self: &, type: u32, count: u32) QuerySet {
    var result = new QuerySet(new QuerySetBackend(backend.device, backend.fns, new vulkan.QueryPool(0u64)), type, count);
    if !self.isValid() { return result; }
    if type != QUERY_TYPE_TIMESTAMP || count == 0u32 || count > MAX_QUERY_COUNT || timestampPeriod <= 0. {
      fail("createQuerySet: timestamps only, 1 to 4096 of them, on a device that keeps time");
      return result;
    }
    let ci = new vulkan.QueryPoolCreateInfo(queryType: vulkan.QUERY_TYPE_TIMESTAMP, queryCount: count);
    var pool = new vulkan.QueryPool(0u64);
    check(backend.fns.createQueryPool(backend.device, &ci, nullp(), &mut pool), "vkCreateQueryPool");
    result.backend.pool = pool;
    result
  }

  // A sampler, filtering and wrapping as 'desc' says. Check 'isValid'.
  pub fn createSampler(self: &, desc: &SamplerDescriptor) Sampler {
    var sampler = new vulkan.Sampler(0u64);
    if self.isValid() {
      var mipmapMode = vulkan.SAMPLER_MIPMAP_MODE_NEAREST;
      if desc.mipmapFilter == FILTER_MODE_LINEAR { mipmapMode = vulkan.SAMPLER_MIPMAP_MODE_LINEAR; }
      var ci = new vulkan.SamplerCreateInfo(magFilter: vkFilter(desc.magFilter),
        minFilter: vkFilter(desc.minFilter), mipmapMode: mipmapMode, addressModeU: vkAddressMode(desc.addressModeU),
        addressModeV: vkAddressMode(desc.addressModeV), addressModeW: vkAddressMode(desc.addressModeW),
        minLod: desc.lodMinClamp, maxLod: desc.lodMaxClamp);
      // Anisotropic filtering where asked for (above 1) and the device has it,
      // as much as it can do if that is less
      var want = f32.from(desc.maxAnisotropy);
      if want > maxAnisotropy { want = maxAnisotropy; }
      if want > 1. {
        ci.anisotropyEnable = vulkan.TRUE;
        ci.maxAnisotropy = want;
      }
      // A comparison sampler (WebGPU's 'compare'): the texel is compared
      // with the reference and the result, filtered over the footprint,
      // is the sample (hardware percentage-closer filtering of a shadow map)
      if desc.compare != 0u32 {
        ci.compareEnable = vulkan.TRUE;
        ci.compareOp = desc.compare - 1u32;      // Vulkan's order, from 0
      }
      check(backend.fns.createSampler(backend.device, &ci, nullp(), &mut sampler), "vkCreateSampler");
    }
    new Sampler(new SamplerBackend(backend.device, backend.fns, sampler))
  }

  // A bind group of 'layout': what each of its bindings is given ('entries',
  // one for each binding the layout has, of the kind it has: a buffer, a
  // texture's view or a sampler). Check 'isValid'.
  pub fn createBindGroup(self: &, layout: &BindGroupLayout, entries: &Array[BindGroupEntry]) BindGroup {
    var result = new BindGroup(new BindGroupBackend(backend.device, backend.fns, new vulkan.DescriptorPool(0u64), new vulkan.DescriptorSet(0u64)));
    if !self.isValid() { return result; }
    if entries.len > usize.from(MAX_BINDINGS) {
      fail("createBindGroup: more than 16 entries");
      return result;
    }
    // A pool of its own, holding just its set: destroying the pool frees it
    // How many of each descriptor type: uniform and storage buffers,
    // samplers, sampled images, storage images
    let types: Array[u32, 6] = [vulkan.DESCRIPTOR_TYPE_UNIFORM_BUFFER, vulkan.DESCRIPTOR_TYPE_STORAGE_BUFFER,
      vulkan.DESCRIPTOR_TYPE_SAMPLER, vulkan.DESCRIPTOR_TYPE_SAMPLED_IMAGE, vulkan.DESCRIPTOR_TYPE_STORAGE_IMAGE,
      vulkan.DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR];
    var counts = new Array[u32, 6] <- fill 0u32;
    var i = 0usize;
    while i < entries.len {
      if entries[i].binding >= MAX_BINDINGS { return result; }
      let type = layout.backend.types[usize.from(entries[i].binding)];
      // A storage buffer's binding: WebGPU's alignment and size limits
      if type == vulkan.DESCRIPTOR_TYPE_STORAGE_BUFFER {
        let b = entries[i].backend;
        var size = b.size;
        if size == WHOLE_SIZE && b.bufferSize >= b.offset { size = b.bufferSize - b.offset; }
        if b.offset % MIN_STORAGE_BUFFER_OFFSET_ALIGNMENT != 0u64 || size > maxStorageBufferBindingSize {
          fail("createBindGroup: a storage buffer bound from an offset not a multiple of 256, or more bytes of it than the device binds (128 MiB, or with ComputeRequest.largeBuffers the GPU's maxStorageBufferRange)");
          return result;
        }
      }
      var t = 0usize;
      while t < 6usize {
        if types[t] == type { counts[t] = counts[t] + 1u32; }
        t = t + 1usize;
      }
      i = i + 1usize;
    }
    var sizes = new Array[vulkan.DescriptorPoolSize, 6] <- fill new vulkan.DescriptorPoolSize(vulkan.DESCRIPTOR_TYPE_UNIFORM_BUFFER, 1u32);
    var sizeCount = 0usize;
    var t = 0usize;
    while t < 6usize {
      if counts[t] > 0u32 {
        sizes[sizeCount] = new vulkan.DescriptorPoolSize(types[t], counts[t]);
        sizeCount = sizeCount + 1usize;
      }
      t = t + 1usize;
    }
    let pci = new vulkan.DescriptorPoolCreateInfo(maxSets: 1u32, poolSizeCount: u32.from(sizeCount),
      pPoolSizes: &sizes as *vulkan.DescriptorPoolSize);
    var pool = new vulkan.DescriptorPool(0u64);
    if !check(backend.fns.createDescriptorPool(backend.device, &pci, nullp(), &mut pool), "vkCreateDescriptorPool") {
      return result;
    }
    result.backend.pool = pool;
    var setLayout = layout.backend.layout;
    let ai = new vulkan.DescriptorSetAllocateInfo(descriptorPool: pool, descriptorSetCount: 1u32,
      pSetLayouts: &mut setLayout as *vulkan.DescriptorSetLayout);
    var set = new vulkan.DescriptorSet(0u64);
    if !check(backend.fns.allocateDescriptorSets(backend.device, &ai, &mut set as *vulkan.DescriptorSet),
        "vkAllocateDescriptorSets") {
      return result;
    }
    result.backend.set = set;

    var infos = new Array[vulkan.DescriptorBufferInfo, 16] <- fill new vulkan.DescriptorBufferInfo(new vulkan.Buffer(0u64), 0u64, 0u64);
    var images = new Array[vulkan.DescriptorImageInfo, 16] <- fill new vulkan.DescriptorImageInfo(new vulkan.Sampler(0u64),
      new vulkan.ImageView(0u64), vulkan.IMAGE_LAYOUT_UNDEFINED);
    var structures = new Array[vulkan.AccelerationStructureKHR, 16] <- fill new vulkan.AccelerationStructureKHR(0u64);
    var structureWrites = new Array[vulkan.WriteDescriptorSetAccelerationStructureKHR, 16] <- fill
      new vulkan.WriteDescriptorSetAccelerationStructureKHR(pAccelerationStructures: null);
    var writes = new Array[vulkan.WriteDescriptorSet, 16] <- fill new vulkan.WriteDescriptorSet(
      dstSet: new vulkan.DescriptorSet(0u64), pImageInfo: null,
      pBufferInfo: null, pTexelBufferView: null);
    i = 0usize;
    while i < entries.len {
      let e = entries[i];
      writes[i].dstSet = set;
      writes[i].dstBinding = e.binding;
      writes[i].descriptorCount = 1u32;
      writes[i].descriptorType = layout.backend.types[usize.from(e.binding)];
      if e.backend.kind == BINDING_KIND_BUFFER {
        var range = e.backend.size;
        if range == WHOLE_SIZE { range = vulkan.WHOLE_SIZE; }
        infos[i] = new vulkan.DescriptorBufferInfo(e.backend.buffer, e.backend.offset, range);
        writes[i].pBufferInfo = (&infos as *u8 + i * mem.sizeof[vulkan.DescriptorBufferInfo]()) as *vulkan.DescriptorBufferInfo;
      } elif e.backend.kind == BINDING_KIND_ACCELERATION_STRUCTURE {
        structures[i] = new vulkan.AccelerationStructureKHR(e.backend.accel);
        structureWrites[i] = new vulkan.WriteDescriptorSetAccelerationStructureKHR(
          pAccelerationStructures: (&structures as *u8 + i * mem.sizeof[vulkan.AccelerationStructureKHR]()) as *vulkan.AccelerationStructureKHR);
        writes[i].pNext = (&structureWrites as *u8 + i * mem.sizeof[vulkan.WriteDescriptorSetAccelerationStructureKHR]()) as *u8;
      } else {
        // A texture is bound in the layout it rests in (a sampled one the
        // shader-read layout, a storage texture the general); a sampler has none
        images[i] = new vulkan.DescriptorImageInfo(e.backend.sampler, e.backend.view, e.backend.imageLayout);
        writes[i].pImageInfo = (&images as *u8 + i * mem.sizeof[vulkan.DescriptorImageInfo]()) as *vulkan.DescriptorImageInfo;
      }
      i = i + 1usize;
    }
    backend.fns.updateDescriptorSets(backend.device, u32.from(entries.len), &writes as *vulkan.WriteDescriptorSet, 0u32, nullp());
    result
  }

  // Its end, after its buffers and swapchains, once the GPU is idle
  fn final(self: &uni) {
    if !self.isValid() { return; }
    backend.fns.deviceWaitIdle(backend.device);
    var i = 0usize;
    while i < 2usize {
      destroyReleased(&backend.fns, backend.device, &mut queue.backend.frames[i], true);
      backend.fns.destroyCommandPool(backend.device, queue.backend.frames[i].pool, nullp());
      backend.fns.destroyFence(backend.device, queue.backend.frames[i].fence, nullp());
      destroyRetired(&backend.fns, backend.device, &mut queue.backend.frames[i], true);
      if queue.backend.frames[i].staging.buffer.h != 0u64 {
        backend.fns.destroyBuffer(backend.device, queue.backend.frames[i].staging.buffer, nullp());
        backend.fns.freeMemory(backend.device, queue.backend.frames[i].staging.memory, nullp());
      }
      i = i + 1usize;
    }
    if queue.backend.flushFence.h != 0u64 { backend.fns.destroyFence(backend.device, queue.backend.flushFence, nullp()); }
    backend.fns.destroyDevice(backend.device, nullp());
  }
}

// End the current frame: one submission, of the frame's uploads if there
// are any, which waits for the acquired swapchain image if nothing did,
// signals 'signalCount' semaphores and the frame's fence (a signal covers
// every command submitted before it), and moves on to the next frame
fn endFrameSignalling(device: &mut Device, signalCount: u32, signals: *vulkan.SemaphoreSubmitInfo) bool {
  let i = usize.from(device.queue.backend.frameIndex);
  let ok = submitCommands(&mut device.queue, nullCommandBuffer(), device.queue.backend.frames[i].fence,
    signalCount, signals);
  device.queue.backend.frames[i].pending = ok;
  device.queue.backend.frameIndex = (device.queue.backend.frameIndex + 1u32) % FRAMES_IN_FLIGHT;
  device.queue.backend.inFrame = false;
  device.frameNumber = device.frameNumber + 1u64;
  ok
}

// The first memory type of those in 'bits' that has all of 'want'
fn memoryType(props: &vulkan.PhysicalDeviceMemoryProperties, bits: u32, want: u32) u32 {
  var i = 0u32;
  while i < props.memoryTypeCount {
    if (bits & (1u32 << i)) != 0u32 && (props.memoryTypes[usize.from(i)].propertyFlags & want) == want { return i; }
    i = i + 1u32;
  }
  0xFFFFFFFFu32
}

// Memory of a type in 'bits' with 'want', of 'size' bytes: its own
// allocation
fn allocate(fns: &DevFns, device: vulkan.Device, props: &vulkan.PhysicalDeviceMemoryProperties, req: &vulkan.MemoryRequirements,
    want: u32) vulkan.DeviceMemory {
  allocateFlagged(fns, device, props, req, want, false)
}

// The same, for a buffer whose device address is taken (ray tracing's inputs, scratch and structures): the
// allocation says so (VkMemoryAllocateFlagsInfo)
fn allocateFlagged(fns: &DevFns, device: vulkan.Device, props: &vulkan.PhysicalDeviceMemoryProperties, req: &vulkan.MemoryRequirements,
    want: u32, addressable: bool) vulkan.DeviceMemory {
  var memory = new vulkan.DeviceMemory(0u64);
  let typeIndex = memoryType(props, req.memoryTypeBits, want);
  if typeIndex == 0xFFFFFFFFu32 {
    fail("no memory type suits the buffer or texture");
    return memory;
  }
  let flags = new vulkan.MemoryAllocateFlagsInfo(flags: vulkan.MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT);
  let mai = new vulkan.MemoryAllocateInfo(pNext: if addressable { &flags as *u8 } else { null },
    allocationSize: req.size, memoryTypeIndex: typeIndex);
  check(fns.allocateMemory(device, &mai, nullp(), &mut memory), "vkAllocateMemory");
  memory
}

// The memory type for a buffer the CPU maps as 'mapping' says (MAP_READ,
// MAP_WRITE, both), of those in 'bits'. One it writes is in coherent memory
// (write-combined, uncached, where the GPU has it: right for writes, which
// the CPU never reads back); one it writes and reads, coherent and cached
// if there is such, else as one it writes. One it only reads is in cached
// memory, which the CPU reads as fast as its own (on the RTX 4060 Laptop,
// 40 MB copied out in 6 ms from cached memory, 135 ms from uncached, which
// the CPU reads without caching or prefetching): coherent and cached if
// there is such, else cached, which its 'mappedRange' then invalidates,
// else coherent, as one it writes.
fn mappedMemoryType(props: &vulkan.PhysicalDeviceMemoryProperties, bits: u32, mapping: u32) u32 {
  let visible = vulkan.MEMORY_PROPERTY_HOST_VISIBLE_BIT;
  let coherent = vulkan.MEMORY_PROPERTY_HOST_COHERENT_BIT;
  let cached = vulkan.MEMORY_PROPERTY_HOST_CACHED_BIT;
  var t = 0xFFFFFFFFu32;
  if (mapping & BUFFER_USAGE_MAP_READ) != 0u32 {
    t = memoryType(props, bits, visible | coherent | cached);
    if t == 0xFFFFFFFFu32 && (mapping & BUFFER_USAGE_MAP_WRITE) == 0u32 {
      t = memoryType(props, bits, visible | cached);
    }
  }
  if t == 0xFFFFFFFFu32 { t = memoryType(props, bits, visible | coherent); }
  t
}

// A buffer of 'size' bytes with Vulkan's 'usage', in memory of its own: the
// CPU's, and mapped, if 'mapping' (MAP_READ, MAP_WRITE or both: how the CPU
// uses it), else the GPU's
fn allocateBuffer(fns: &DevFns, device: vulkan.Device, props: &vulkan.PhysicalDeviceMemoryProperties, size: u64, usage: u32,
    mapping: u32) BufferBackend {
  var result = new BufferBackend(device, *fns, new vulkan.Buffer(0u64), new vulkan.DeviceMemory(0u64), nullp(), true);
  let mapped = mapping != 0u32;
  let bci = new vulkan.BufferCreateInfo(size: size, usage: usage, pQueueFamilyIndices: null);
  var buffer = new vulkan.Buffer(0u64);
  if !check(fns.createBuffer(device, &bci, nullp(), &mut buffer), "vkCreateBuffer") { return result; }
  result.buffer = buffer;
  var req = zeroed[vulkan.MemoryRequirements]();
  fns.getBufferMemoryRequirements(device, buffer, &mut req);
  var memory = new vulkan.DeviceMemory(0u64);
  if mapped {
    let typeIndex = mappedMemoryType(props, req.memoryTypeBits, mapping);
    if typeIndex == 0xFFFFFFFFu32 {
      fail("no memory type suits the buffer or texture");
      return result;
    }
    result.coherent = (props.memoryTypes[usize.from(typeIndex)].propertyFlags
      & vulkan.MEMORY_PROPERTY_HOST_COHERENT_BIT) != 0u32;
    let mai = new vulkan.MemoryAllocateInfo(allocationSize: req.size, memoryTypeIndex: typeIndex);
    check(fns.allocateMemory(device, &mai, nullp(), &mut memory), "vkAllocateMemory");
  } else {
    memory = allocateFlagged(fns, device, props, &req, vulkan.MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
      (usage & vulkan.BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT) != 0u32);
  }
  if memory.h == 0u64 { return result; }
  result.memory = memory;
  check(fns.bindBufferMemory(device, buffer, memory, 0u64), "vkBindBufferMemory");
  if mapped {
    var p = nullp();
    if check(fns.mapMemory(device, memory, 0u64, vulkan.WHOLE_SIZE, 0u32, &mut p), "vkMapMemory") {
      result.mapped = p;
    }
  }
  result
}

// A 2-D image 'width' by 'height' of 'format' and Vulkan's 'usage', in the
// GPU's memory, of its own, and a view of all of it
fn makeImage(fns: &DevFns, device: vulkan.Device, props: &vulkan.PhysicalDeviceMemoryProperties, width: u32, height: u32,
    format: u32, usage: u32, image: &mut vulkan.Image, memory: &mut vulkan.DeviceMemory, view: &mut vulkan.ImageView) bool {
  makeImageLevels(fns, device, props, width, height, format, usage, 1u32, 1u32, 0u32, false, image, memory, view)
}

// The same, of 'levels' mip levels and 'layers' layers, made with 'flags'
// (cube-compatible, say); the view is of every level and layer, 2-D or, with
// several layers, a 2-D array. A 'volume' is 3-D, 'layers' deep, its view 3-D.
fn makeImageLevels(fns: &DevFns, device: vulkan.Device, props: &vulkan.PhysicalDeviceMemoryProperties, width: u32, height: u32,
    format: u32, usage: u32, levels: u32, layers: u32, flags: u32, volume: bool, image: &mut vulkan.Image,
    memory: &mut vulkan.DeviceMemory, view: &mut vulkan.ImageView) bool {
  var imageType = vulkan.IMAGE_TYPE_2D;
  var depth = 1u32;
  var arrayLayers = layers;
  if volume {
    imageType = vulkan.IMAGE_TYPE_3D;
    depth = layers;
    arrayLayers = 1u32;
  }
  let ici = new vulkan.ImageCreateInfo(flags: flags, imageType: imageType, format: format,
    extent: new vulkan.Extent3D(width, height, depth), mipLevels: levels, arrayLayers: arrayLayers, usage: usage,
    pQueueFamilyIndices: null);
  if !check(fns.createImage(device, &ici, nullp(), image), "vkCreateImage") { return false; }
  var req = zeroed[vulkan.MemoryRequirements]();
  fns.getImageMemoryRequirements(device, *image, &mut req);
  *memory = allocate(fns, device, props, &req, vulkan.MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
  if memory.h == 0u64 { return false; }
  if !check(fns.bindImageMemory(device, *image, *memory, 0u64), "vkBindImageMemory") { return false; }
  var viewType = vulkan.IMAGE_VIEW_TYPE_2D;
  if arrayLayers > 1u32 { viewType = vulkan.IMAGE_VIEW_TYPE_2D_ARRAY; }
  if volume { viewType = vulkan.IMAGE_VIEW_TYPE_3D; }
  let vci = new vulkan.ImageViewCreateInfo(image: *image, viewType: viewType, format: format,
    components: new vulkan.ComponentMapping(), subresourceRange: new vulkan.ImageSubresourceRange(aspectMask: aspectOf(format),
    levelCount: levels, layerCount: arrayLayers));
  check(fns.createImageView(device, &vci, nullp(), view), "vkCreateImageView")
}

fn makePipelineLayout(fns: &DevFns, device: vulkan.Device, setCount: u32, sets: &Array[vulkan.DescriptorSetLayout, 4],
    immediateSize: u32) PipelineLayout {
  var result = new PipelineLayout(new PipelineLayoutBackend(device, *fns, new vulkan.PipelineLayout(0u64)), immediateSize);
  if (device as *u8 as usize) == 0usize { return result; }
  if immediateSize > MAX_IMMEDIATE_SIZE || (immediateSize & 3u32) != 0u32 {
    fail("a pipeline layout's immediates are more than 128 bytes, or not a multiple of 4");
    return result;
  }
  let range = new vulkan.PushConstantRange(immediateStages(), 0u32, immediateSize);
  var ranges = 0u32;
  if immediateSize > 0u32 { ranges = 1u32; }
  let ci = new vulkan.PipelineLayoutCreateInfo(setLayoutCount: setCount,
    pSetLayouts: sets as *vulkan.DescriptorSetLayout, pushConstantRangeCount: ranges,
    pPushConstantRanges: &range as *vulkan.PushConstantRange);
  var layout = new vulkan.PipelineLayout(0u64);
  check(fns.createPipelineLayout(device, &ci, nullp(), &mut layout), "vkCreatePipelineLayout");
  result.backend.layout = layout;
  result
}
