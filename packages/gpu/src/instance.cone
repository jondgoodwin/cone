// ---- Instance ----

struct InstanceBackend {
  handle: vulkan.Instance;
  messenger: vulkan.DebugUtilsMessengerEXT;
  loaded: bool;             // SDL loaded the Vulkan loader for it
  fns: InstFns;             // the instance's functions, found when it was made
}

// The entry point: Vulkan loaded, an instance made with what a window's
// surface needs, and validation and debug messages on where they are offered
pub struct Instance {
  backend: InstanceBackend;
  pub validation: bool;         // the Khronos validation layer is on
  pub syncValidation: bool;     // and its synchronization validation
  pub debugMessages: bool;      // the loader's and layers' warnings and errors are reported

  // Make an instance for 'appName'. The vulkan package found the Vulkan
  // loader when the program started; SDL loads its own copy (the OS counts
  // both) to name the surface extensions and make surfaces. Check
  // 'isValid': without a Vulkan 1.3 loader it is not, and why has gone to
  // stderr.
  pub fn create(appName: &str) Instance {
    var result = new Instance(new InstanceBackend(0usize as vulkan.Instance, new vulkan.DebugUtilsMessengerEXT(0u64), false,
      noInstFns()), false, false, false);
    if !vulkan.available() {
      fail("no Vulkan loader (vulkan-1.dll) was found, or it lacks its global functions");
      return result;
    }
    if !sdl.InitSubSystem(sdl.INIT_VIDEO) {
      fail("SDL's video subsystem did not start");
      return result;
    }
    if !sdl.Vulkan_LoadLibrary(nullp()) {
      fail("SDL could not load the Vulkan loader");
      return result;
    }
    result.backend.loaded = true;
    var version = 0u32;
    if !check(vulkan.enumerateInstanceVersion(&mut version), "vkEnumerateInstanceVersion") { return result; }
    if version < vulkan.API_VERSION_1_3 {
      fail("the Vulkan loader is older than Vulkan 1.3");
      return result;
    }

    // The extensions a surface needs (SDL's answer for this platform), and
    // debug utils if the loader has them
    var exts = new Array[*u8, 12] <- fill null;
    var count = 0u32;
    let surfaceExts = sdl.Vulkan_GetInstanceExtensions(&mut count);
    if !surfaceExts || count > 10u32 {
      fail("SDL could not name the surface extensions");
      return result;
    }
    var next = 0u32;
    while next < count {
      exts[usize.from(next)] = *(surfaceExts + usize.from(next));
      next = next + 1u32;
    }
    result.debugMessages = hasInstanceExtension(nullp(), "VK_EXT_debug_utils");
    if result.debugMessages {
      exts[usize.from(next)] = &"VK_EXT_debug_utils" as *u8;
      next = next + 1u32;
    }
    let layerName = &"VK_LAYER_KHRONOS_validation" as *u8;
    result.validation = hasInstanceLayer(cstr.fromPtr(layerName));
    let layers: Array[*u8, 1] = [layerName];

    // Synchronization validation, set through the layer's settings: it checks
    // every barrier and semaphore for a hazard between commands. Its shader
    // accesses heuristic makes it see what shaders read and write through
    // storage buffers and storage textures, from the SPIR-V: without it,
    // a compute pass's writes are invisible to it.
    result.syncValidation = result.validation && hasInstanceExtension(layerName, "VK_EXT_layer_settings");
    if result.syncValidation {
      exts[usize.from(next)] = &"VK_EXT_layer_settings" as *u8;
      next = next + 1u32;
    }
    let on: Array[u32, 1] = [vulkan.TRUE];
    let setting = [new vulkan.LayerSettingEXT(pLayerName: layerName, pSettingName: &"validate_sync" as *u8,
        valueCount: 1u32, pValues: &on as *u8),
      new vulkan.LayerSettingEXT(pLayerName: layerName, pSettingName: &"syncval_shader_accesses_heuristic" as *u8,
        valueCount: 1u32, pValues: &on as *u8)];
    let settings = new vulkan.LayerSettingsCreateInfoEXT(settingCount: 2u32,
      pSettings: &setting as *vulkan.LayerSettingEXT);
    var chain = nullp();
    if result.syncValidation { chain = &settings as *u8; }

    // The messenger's create-info, chained, catches instance creation's own
    // messages; the messenger itself is made from one with nothing chained
    let severities = vulkan.DEBUG_UTILS_MESSAGE_SEVERITY_WARNING_BIT_EXT | vulkan.DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT;
    let types = vulkan.DEBUG_UTILS_MESSAGE_TYPE_GENERAL_BIT_EXT | vulkan.DEBUG_UTILS_MESSAGE_TYPE_VALIDATION_BIT_EXT
      | vulkan.DEBUG_UTILS_MESSAGE_TYPE_PERFORMANCE_BIT_EXT;
    let dbg = new vulkan.DebugUtilsMessengerCreateInfoEXT(messageSeverity: severities,
      messageType: types, pfnUserCallback: &onDebugMessage, pUserData: nullp());
    let dbgChained = new vulkan.DebugUtilsMessengerCreateInfoEXT(pNext: chain, messageSeverity: severities,
      messageType: types, pfnUserCallback: &onDebugMessage, pUserData: nullp());
    if result.debugMessages { chain = &dbgChained as *u8; }
    var name = String.from(appName);
    let app = new vulkan.ApplicationInfo(pApplicationName: name.cstr().ptr(), pEngineName: &"Cone gpu" as *u8);
    var layerCount = 0u32;
    if result.validation { layerCount = 1u32; }
    let ci = new vulkan.InstanceCreateInfo(pNext: chain, pApplicationInfo: &app as *vulkan.ApplicationInfo,
      enabledLayerCount: layerCount, ppEnabledLayerNames: &layers as **u8,
      enabledExtensionCount: next, ppEnabledExtensionNames: &exts as **u8);
    var handle = 0usize as vulkan.Instance;
    if !check(vulkan.createInstance(&ci, nullp(), &mut handle), "vkCreateInstance") { return result; }
    result.backend.handle = handle;
    result.backend.fns = new Arc[imm, vulkan.InstanceFns](vulkan.InstanceFns.load(handle));
    let ifns = result.backend.fns;
    if ifns.missing != 0u32 {
      fail("the Vulkan instance lacks some of its functions");
      return result;
    }
    if result.debugMessages && ifns.hasDebugUtils() {
      var messenger = new vulkan.DebugUtilsMessengerEXT(0u64);
      if check(ifns.createDebugUtilsMessengerEXT(handle, &dbg, nullp(), &mut messenger), "vkCreateDebugUtilsMessengerEXT") {
        result.backend.messenger = messenger;
      }
    }
    result
  }

  // Whether the instance was made
  pub fn isValid(self: &) bool { (backend.handle as *u8 as usize) != 0usize }

  // The surface of a window made for Vulkan (window's 'openVulkan', whose
  // 'sdlHandle' this takes). Check 'isValid'.
  pub fn createSurface(self: &, window: *sdl.Window) Surface {
    var surface = new vulkan.SurfaceKHR(0u64);
    if self.isValid() {
      if !sdl.Vulkan_CreateSurface(window, backend.handle as *u8, nullp(), &mut surface.h) {
        fail("SDL could not make a Vulkan surface of the window");
      }
    }
    new Surface(new SurfaceBackend(backend.handle, surface, backend.fns))
  }

  // The GPU to draw to 'surface' with: one supporting Vulkan 1.3, dynamic
  // rendering, synchronization2 and swapchains, with a queue that both draws
  // and presents to the surface ('Surface.none()': that only draws). Where
  // there are several, 'powerPreference'
  // (WebGPU's) chooses: POWER_PREFERENCE_HIGH_PERFORMANCE a discrete GPU
  // before an integrated one, POWER_PREFERENCE_LOW_POWER the other way round.
  // Check 'isValid'.
  pub fn requestAdapter(self: &, surface: &Surface, powerPreference: u32) Adapter {
    var chosen = 0usize as vulkan.PhysicalDevice;
    var chosenFamily = 0u32;
    var chosenScore = 0;
    if self.isValid() {
      // How many devices, asked first; every one is considered
      var n = 0u32;
      let counted = check(backend.fns.enumeratePhysicalDevices(backend.handle, &mut n, null), "vkEnumeratePhysicalDevices");
      var devices = List[vulkan.PhysicalDevice].empty();
      devices.resize(usize.from(n), 0usize as vulkan.PhysicalDevice);
      if counted && check(backend.fns.enumeratePhysicalDevices(backend.handle, &mut n, devices.viewMut() as *vulkan.PhysicalDevice),
          "vkEnumeratePhysicalDevices") {
        devices.truncate(usize.from(n));
        var i = 0usize;
        while i < devices.len() {
          var family = 0u32;
          let score = adapterScore(&backend.fns, *devices[i], surface.backend.surface, powerPreference, &mut family);
          if score > chosenScore {
            chosen = *devices[i];
            chosenFamily = family;
            chosenScore = score;
          }
          i = i + 1usize;
        }
      }
    }
    if chosenScore == 0 {
      fail("no GPU supports Vulkan 1.3 with dynamic rendering and synchronization2 (and presents to the surface)");
      return new Adapter(new AdapterBackend(chosen, 0u32, backend.fns), String.from(""), ADAPTER_TYPE_UNKNOWN, String.from(""), 0u32, 0u32);
    }
    var props = zeroed[vulkan.PhysicalDeviceProperties]();
    backend.fns.getPhysicalDeviceProperties(chosen, &mut props);
    var name = String.empty();
    appendCStr(&mut name, &mut props.deviceName as *u8);
    var version = String.empty();
    version <- u64.from(vulkan.apiVersionMajor(props.apiVersion));
    version.appendByte('.');
    version <- u64.from(vulkan.apiVersionMinor(props.apiVersion));
    version.appendByte('.');
    version <- u64.from(vulkan.apiVersionPatch(props.apiVersion));
    var kind = ADAPTER_TYPE_UNKNOWN;
    if props.deviceType == vulkan.PHYSICAL_DEVICE_TYPE_DISCRETE_GPU { kind = ADAPTER_TYPE_DISCRETE_GPU; }
    if props.deviceType == vulkan.PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU { kind = ADAPTER_TYPE_INTEGRATED_GPU; }
    if props.deviceType == vulkan.PHYSICAL_DEVICE_TYPE_CPU { kind = ADAPTER_TYPE_CPU; }
    new Adapter(new AdapterBackend(chosen, chosenFamily, backend.fns), name, kind, version, props.vendorID, props.deviceID)
  }

  // Its end, after every object made from it
  fn final(self: &uni) {
    if self.isValid() {
      if backend.messenger.h != 0u64 { backend.fns.destroyDebugUtilsMessengerEXT(backend.handle, backend.messenger, nullp()); }
      backend.fns.destroyInstance(backend.handle, nullp());
    }
    if backend.loaded { sdl.Vulkan_UnloadLibrary(); }
    sdl.QuitSubSystem(sdl.INIT_VIDEO);
  }
}

// How well 'physical' suits: 0 if it cannot be used, else higher for the
// kind of GPU 'powerPreference' prefers; 'family' gets the queue family that
// draws and presents
fn adapterScore(ifns: &InstFns, physical: vulkan.PhysicalDevice, surface: vulkan.SurfaceKHR, powerPreference: u32, family: &mut u32) i32 {
  var discrete = 3;
  var integrated = 2;
  if powerPreference == POWER_PREFERENCE_LOW_POWER {
    discrete = 2;
    integrated = 3;
  }
  var props = zeroed[vulkan.PhysicalDeviceProperties]();
  ifns.getPhysicalDeviceProperties(physical, &mut props);
  if props.apiVersion < vulkan.API_VERSION_1_3 { return 0; }
  if !hasDeviceExtension(ifns, physical, "VK_KHR_swapchain") { return 0; }

  var f13 = new vulkan.PhysicalDeviceVulkan13Features();
  var f2 = new vulkan.PhysicalDeviceFeatures2(pNext: &mut f13 as *u8, features: zeroed[vulkan.PhysicalDeviceFeatures]());
  ifns.getPhysicalDeviceFeatures2(physical, &mut f2);
  if f13.dynamicRendering != vulkan.TRUE || f13.synchronization2 != vulkan.TRUE { return 0; }

  // How many families, asked first, then all of them
  var n = 0u32;
  ifns.getPhysicalDeviceQueueFamilyProperties(physical, &mut n, null);
  var families = List[vulkan.QueueFamilyProperties].empty();
  families.resize(usize.from(n), zeroed[vulkan.QueueFamilyProperties]());
  ifns.getPhysicalDeviceQueueFamilyProperties(physical, &mut n, families.viewMut() as *vulkan.QueueFamilyProperties);
  families.truncate(usize.from(n));
  var i = 0u32;
  while i < n {
    var presents = vulkan.TRUE;       // with no surface, any queue family that draws
    if surface.h != 0u64 { ifns.getPhysicalDeviceSurfaceSupportKHR(physical, i, surface, &mut presents); }
    if (families[usize.from(i)].queueFlags & vulkan.QUEUE_GRAPHICS_BIT) != 0u32 && presents == vulkan.TRUE {
      *family = i;
      if props.deviceType == vulkan.PHYSICAL_DEVICE_TYPE_DISCRETE_GPU { return discrete; }
      if props.deviceType == vulkan.PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU { return integrated; }
      return 1;
    }
    i = i + 1u32;
  }
  0
}

// ---- Surface ----

struct SurfaceBackend {
  instance: vulkan.Instance;
  surface: vulkan.SurfaceKHR;
  fns: InstFns;                 // its instance's functions
}

// A window's surface, which a SwapChain presents to
pub struct Surface {
  backend: SurfaceBackend;

  pub fn isValid(self: &) bool { backend.surface.h != 0u64 }

  // No surface: for 'requestAdapter' when nothing is to be presented
  // (WebGPU's compatibleSurface left out)
  pub fn none() Surface { new Surface(new SurfaceBackend(0usize as vulkan.Instance, new vulkan.SurfaceKHR(0u64), noInstFns())) }

  fn final(self: &uni) {
    if self.isValid() { backend.fns.destroySurfaceKHR(backend.instance, backend.surface, nullp()); }
  }
}

// ---- Adapter ----

struct AdapterBackend {
  physical: vulkan.PhysicalDevice;
  queueFamily: u32;
  fns: InstFns;                 // its instance's functions
}

// A GPU, and what it is
pub struct Adapter {
  backend: AdapterBackend;
  pub name: String;             // "Intel(R) UHD Graphics 770"
  pub adapterType: u32;         // ADAPTER_TYPE_...
  pub backendVersion: String;   // the version of the API underneath: "1.3.290" (Vulkan)
  pub vendorID: u32;
  pub deviceID: u32;

  pub fn isValid(self: &) bool { (backend.physical as *u8 as usize) != 0usize }

  // The API underneath
  pub fn backendName(self: &) &str { "Vulkan" }

  // A device on this GPU, with one queue that draws and presents. Check
  // 'isValid'.
  pub fn requestDevice(self: &) Device { self.requestDeviceWith(true) }

  // Whether this GPU can build acceleration structures and cast rays from shaders (ray queries):
  // VK_KHR_acceleration_structure, VK_KHR_ray_query and buffer device addresses, each with its
  // feature. Ray tracing here is ray query, not the ray-tracing pipeline (see raytracing.cone).
  pub fn supportsRayTracing(self: &) bool {
    if !self.isValid() { return false; }
    if !hasDeviceExtension(&backend.fns, backend.physical, "VK_KHR_acceleration_structure")
        || !hasDeviceExtension(&backend.fns, backend.physical, "VK_KHR_ray_query")
        || !hasDeviceExtension(&backend.fns, backend.physical, "VK_KHR_deferred_host_operations") {
      return false;
    }
    var rq = new vulkan.PhysicalDeviceRayQueryFeaturesKHR();
    var accel = new vulkan.PhysicalDeviceAccelerationStructureFeaturesKHR(pNext: &mut rq as *u8);
    var address = new vulkan.PhysicalDeviceBufferDeviceAddressFeatures(pNext: &mut accel as *u8);
    var available = new vulkan.PhysicalDeviceFeatures2(pNext: &mut address as *u8, features: zeroed[vulkan.PhysicalDeviceFeatures]());
    backend.fns.getPhysicalDeviceFeatures2(backend.physical, &mut available);
    address.bufferDeviceAddress == vulkan.TRUE && accel.accelerationStructure == vulkan.TRUE && rq.rayQuery == vulkan.TRUE
  }

  // The same, with ray tracing asked for or not: a device made with 'false' draws as one on a GPU
  // that has none (to show the fallback on a GPU that has it). With 'true' on a GPU without it, no
  // ray tracing either; check 'device.rayTracing'.
  pub fn requestDeviceWith(self: &, rayTracing: bool) Device { self.makeDevice(rayTracing, &new ComputeRequest()) }

  // What this GPU offers for compute (features.cone): 16-bit floats, 8-bit storage, the integer dot product,
  // the subgroup, and its buffer and memory limits, as a plain value
  pub fn computeCapabilities(self: &) ComputeCapabilities {
    if !self.isValid() { return new ComputeCapabilities(); }
    queryCompute(&backend.fns, backend.physical)
  }

  // The GPU's memory heaps, in the order Vulkan lists them
  pub fn memoryHeaps(self: &) List[MemoryHeapInfo] {
    var heaps = List[MemoryHeapInfo].empty();
    if !self.isValid() { return heaps; }
    var memory = zeroed[vulkan.PhysicalDeviceMemoryProperties]();
    backend.fns.getPhysicalDeviceMemoryProperties(backend.physical, &mut memory);
    var h = 0usize;
    while h < usize.from(memory.memoryHeapCount) && h < 16usize {
      heaps.push(new MemoryHeapInfo(memory.memoryHeaps[h].size, (memory.memoryHeaps[h].flags & vulkan.MEMORY_HEAP_DEVICE_LOCAL_BIT) != 0u32));
      h = h + 1usize;
    }
    heaps
  }

  // A device made with the compute features 'request' asks for, each enabled if this GPU has it
  // (features.cone says what, and what 'device.compute' then answers). Ray tracing is not asked for.
  // Check 'isValid'.
  pub fn requestComputeDevice(self: &, request: &ComputeRequest) Device { self.makeDevice(false, request) }

  fn makeDevice(self: &, rayTracing: bool, request: &ComputeRequest) Device {
    var result = new Device(new DeviceBackend(0usize as vulkan.Device, noDevFns(), backend.fns, backend.physical, backend.queueFamily,
      new vulkan.RayFns()), new CommandQueue(zeroed[QueueBackend](), noDevFns()), 0u64);
    if !self.isValid() { return result; }

    let priorities: Array[f32, 1] = [1.];
    let qci = new vulkan.DeviceQueueCreateInfo(queueFamilyIndex: backend.queueFamily, queueCount: 1u32,
      pQueuePriorities: &priorities as *f32);
    let useRay = rayTracing && self.supportsRayTracing();
    var rqf = new vulkan.PhysicalDeviceRayQueryFeaturesKHR(rayQuery: vulkan.TRUE);
    var accelf = new vulkan.PhysicalDeviceAccelerationStructureFeaturesKHR(pNext: &mut rqf as *u8, accelerationStructure: vulkan.TRUE);
    var addressf = new vulkan.PhysicalDeviceBufferDeviceAddressFeatures(pNext: &mut accelf as *u8, bufferDeviceAddress: vulkan.TRUE);

    // The compute features: those asked for that the GPU has (features.cone). Vulkan 1.1 and 1.2's feature
    // structures are chained only when one is asked for, so a device asking for none is made exactly as it
    // always was (and, as Vulkan 1.2's structure includes bufferDeviceAddress, never together with ray
    // tracing's own structure: 'requestComputeDevice' asks for no ray tracing).
    let has = queryCompute(&backend.fns, backend.physical);
    let on = enabledCompute(&has, request);
    let chained = request.wantsFeatures() && !useRay;
    var f12 = new vulkan.PhysicalDeviceVulkan12Features(
      storageBuffer8BitAccess: vkBool(on.storage8Bit), uniformAndStorageBuffer8BitAccess: vkBool(on.storage8Bit),
      shaderFloat16: vkBool(on.float16Arithmetic), shaderInt8: vkBool(on.int8Arithmetic),
      shaderSubgroupExtendedTypes: vkBool(on.subgroupExtendedTypes));
    var f11 = new vulkan.PhysicalDeviceVulkan11Features(pNext: &mut f12 as *u8,
      storageBuffer16BitAccess: vkBool(on.storage16Bit), uniformAndStorageBuffer16BitAccess: vkBool(on.storage16Bit));
    let f13 = new vulkan.PhysicalDeviceVulkan13Features(
      pNext: if useRay { &mut addressf as *u8 } elif chained { &mut f11 as *u8 } else { null },
      synchronization2: vulkan.TRUE, dynamicRendering: vulkan.TRUE, shaderIntegerDotProduct: vkBool(on.integerDotProduct));
    let exts: Array[*u8, 4] = [&"VK_KHR_swapchain" as *u8, &"VK_KHR_acceleration_structure" as *u8,
      &"VK_KHR_ray_query" as *u8, &"VK_KHR_deferred_host_operations" as *u8];
    // Anisotropic filtering, the one optional core feature asked for: on
    // where the GPU has it (every desktop one does), else samplers filter
    // trilinearly only ('Device.maxAnisotropy' is 0)
    var props = zeroed[vulkan.PhysicalDeviceProperties]();
    backend.fns.getPhysicalDeviceProperties(backend.physical, &mut props);
    var available = new vulkan.PhysicalDeviceFeatures2(pNext: null, features: zeroed[vulkan.PhysicalDeviceFeatures]());
    backend.fns.getPhysicalDeviceFeatures2(backend.physical, &mut available);
    var enabled = zeroed[vulkan.PhysicalDeviceFeatures]();
    if available.features.raw[vulkan.FEATURE_SAMPLER_ANISOTROPY] == vulkan.TRUE && props.limits.maxSamplerAnisotropy >= 1. {
      enabled.raw[vulkan.FEATURE_SAMPLER_ANISOTROPY] = vulkan.TRUE;
      result.maxAnisotropy = props.limits.maxSamplerAnisotropy;
    }
    if on.int16Arithmetic { enabled.raw[vulkan.FEATURE_SHADER_INT16] = vulkan.TRUE; }
    // What the device is made with and held to (features.cone): the layer's WebGPU-default limits, or with
    // 'largeBuffers' the GPU's own; never above what the GPU allows
    result.compute = on;
    result.maxStorageBufferBindingSize = if request.largeBuffers { has.maxStorageBufferRange } else { MAX_STORAGE_BUFFER_BINDING_SIZE };
    if result.maxStorageBufferBindingSize > has.maxStorageBufferRange { result.maxStorageBufferBindingSize = has.maxStorageBufferRange; }
    result.maxStorageBuffersPerStage = if request.largeBuffers { has.maxPerStageDescriptorStorageBuffers } else { MAX_STORAGE_BUFFERS_PER_SHADER_STAGE };
    if result.maxStorageBuffersPerStage > has.maxPerStageDescriptorStorageBuffers {
      result.maxStorageBuffersPerStage = has.maxPerStageDescriptorStorageBuffers;
    }
    if request.largeBuffers && result.maxStorageBuffersPerStage > MAX_BIND_GROUPS * MAX_BINDINGS {
      result.maxStorageBuffersPerStage = MAX_BIND_GROUPS * MAX_BINDINGS;       // a layer has at most 4 groups of 16 bindings
    }
    let dci = new vulkan.DeviceCreateInfo(pNext: &f13 as *u8, queueCreateInfoCount: 1u32,
      pQueueCreateInfos: &qci as *vulkan.DeviceQueueCreateInfo, ppEnabledLayerNames: null,
      enabledExtensionCount: if useRay { 4u32 } else { 1u32 }, ppEnabledExtensionNames: &exts as **u8,
      pEnabledFeatures: &enabled as *vulkan.PhysicalDeviceFeatures);
    var device = 0usize as vulkan.Device;
    if !check(backend.fns.createDevice(backend.physical, &dci, nullp(), &mut device), "vkCreateDevice") { return result; }
    result.backend.device = device;
    result.backend.fns = new Arc[imm, vulkan.DeviceFns](vulkan.DeviceFns.load(&*backend.fns, device));
    result.queue.fns = result.backend.fns;
    let fns = result.backend.fns;
    if fns.missing != 0u32 {
      fail("the Vulkan device lacks some of its functions");
      return result;
    }
    if useRay {
      result.backend.ray = vulkan.RayFns.load(&*backend.fns, device);
      result.rayTracing = result.backend.ray.found;
    }
    var queue = 0usize as vulkan.Queue;
    fns.getDeviceQueue(device, backend.queueFamily, 0u32, &mut queue);
    result.queue.backend.handle = queue;
    result.queue.backend.device = device;
    backend.fns.getPhysicalDeviceMemoryProperties(backend.physical, &mut result.queue.backend.memory);

    // Timestamps, if the queue keeps time: a tick's length
    var n = 0u32;
    backend.fns.getPhysicalDeviceQueueFamilyProperties(backend.physical, &mut n, null);
    var families = List[vulkan.QueueFamilyProperties].empty();
    families.resize(usize.from(n), zeroed[vulkan.QueueFamilyProperties]());
    backend.fns.getPhysicalDeviceQueueFamilyProperties(backend.physical, &mut n, families.viewMut() as *vulkan.QueueFamilyProperties);
    families.truncate(usize.from(n));
    if backend.queueFamily < n && families[usize.from(backend.queueFamily)].timestampValidBits > 0u32 {
      result.timestampPeriod = props.limits.timestampPeriod;
    }

    // Each frame in flight: its fence, and thread 0's command pool
    let fci = new vulkan.FenceCreateInfo();
    // (a command buffer that begins again after a flush has run it resets itself)
    let pci = new vulkan.CommandPoolCreateInfo(
      flags: vulkan.COMMAND_POOL_CREATE_TRANSIENT_BIT | vulkan.COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
      queueFamilyIndex: backend.queueFamily);
    var i = 0usize;
    while i < 2usize {
      var fence = new vulkan.Fence(0u64);
      check(fns.createFence(device, &fci, nullp(), &mut fence), "vkCreateFence");
      result.queue.backend.frames[i].fence = fence;
      var pool = new vulkan.CommandPool(0u64);
      check(fns.createCommandPool(device, &pci, nullp(), &mut pool), "vkCreateCommandPool");
      result.queue.backend.frames[i].pool = pool;
      i = i + 1usize;
    }
    result
  }
}
