// ---- Constants ----

// Frames the CPU may record ahead of the GPU
pub const FRAMES_IN_FLIGHT = 2u32;

const MAX_SWAPCHAIN_IMAGES = 8u32;
const MAX_FRAME_COMMAND_BUFFERS = 16u32;
const MAX_RETIRED_STAGING = 8u32;
const STAGING_BLOCK = 65536u64;           // the least staging block a frame takes
const NO_TIMEOUT = 0xFFFFFFFFFFFFFFFFu64;

// The rest of a buffer from an offset (WebGPU's size left out)
pub const WHOLE_SIZE = 0xFFFFFFFFFFFFFFFFu64;

// Texture formats (WebGPU's names)
pub const TEXTURE_FORMAT_UNDEFINED = 0u32;
pub const TEXTURE_FORMAT_RGBA8_UNORM = 1u32;
pub const TEXTURE_FORMAT_RGBA8_UNORM_SRGB = 2u32;
pub const TEXTURE_FORMAT_BGRA8_UNORM = 3u32;
pub const TEXTURE_FORMAT_BGRA8_UNORM_SRGB = 4u32;
pub const TEXTURE_FORMAT_DEPTH32_FLOAT = 5u32;
pub const TEXTURE_FORMAT_RGBA16_FLOAT = 6u32;    // half floats: HDR color
pub const TEXTURE_FORMAT_R32_FLOAT = 7u32;       // one f32 a texel
pub const TEXTURE_FORMAT_R32_UINT = 8u32;        // one u32 a texel

// A texture's dimension (WebGPU's): a 2-D image (of layers, perhaps), or a
// 3-D one, its depth 'depthOrArrayLayers'
pub const TEXTURE_DIMENSION_2D = 2u32;
pub const TEXTURE_DIMENSION_3D = 3u32;

// A texture view's dimension (WebGPU's): one 2-D image, several (layers),
// six layers seen as the faces of a cube, sampled by direction, or a 3-D
// texture's volume
pub const TEXTURE_VIEW_DIMENSION_2D = 1u32;
pub const TEXTURE_VIEW_DIMENSION_2D_ARRAY = 2u32;
pub const TEXTURE_VIEW_DIMENSION_CUBE = 3u32;
pub const TEXTURE_VIEW_DIMENSION_3D = 4u32;

// Texture usages (WebGPU's bits), OR-ed together
pub const TEXTURE_USAGE_COPY_SRC = 0x1u32;
pub const TEXTURE_USAGE_COPY_DST = 0x2u32;
pub const TEXTURE_USAGE_TEXTURE_BINDING = 0x4u32;
pub const TEXTURE_USAGE_STORAGE_BINDING = 0x8u32;
pub const TEXTURE_USAGE_RENDER_ATTACHMENT = 0x10u32;

// What a render pass does with an attachment at its start and its end
pub const LOAD_OP_CLEAR = 1u32;
pub const LOAD_OP_LOAD = 2u32;
pub const STORE_OP_STORE = 1u32;
pub const STORE_OP_DISCARD = 2u32;

// Buffer usages (WebGPU's bits), OR-ed together
pub const BUFFER_USAGE_MAP_READ = 0x1u32;
pub const BUFFER_USAGE_MAP_WRITE = 0x2u32;
pub const BUFFER_USAGE_COPY_SRC = 0x4u32;
pub const BUFFER_USAGE_COPY_DST = 0x8u32;
pub const BUFFER_USAGE_INDEX = 0x10u32;
pub const BUFFER_USAGE_VERTEX = 0x20u32;
pub const BUFFER_USAGE_UNIFORM = 0x40u32;
pub const BUFFER_USAGE_STORAGE = 0x80u32;
pub const BUFFER_USAGE_INDIRECT = 0x100u32;
pub const BUFFER_USAGE_QUERY_RESOLVE = 0x200u32;

// Shader stages (WebGPU's bits), OR-ed together: which see a binding
pub const SHADER_STAGE_VERTEX = 0x1u32;
pub const SHADER_STAGE_FRAGMENT = 0x2u32;
pub const SHADER_STAGE_COMPUTE = 0x4u32;

// What a bind group layout's binding is: a buffer, a sampler, a texture
// shaders sample, or a storage texture they read and write texel by texel
// (WebGPU's entry has a 'buffer', 'sampler', 'texture' or 'storageTexture'
// member)
pub const BINDING_KIND_BUFFER = 1u32;
pub const BINDING_KIND_SAMPLER = 2u32;
pub const BINDING_KIND_TEXTURE = 3u32;
pub const BINDING_KIND_STORAGE_TEXTURE = 4u32;

// What a bind group layout's buffer binding holds
pub const BUFFER_BINDING_TYPE_UNIFORM = 1u32;
pub const BUFFER_BINDING_TYPE_STORAGE = 2u32;
pub const BUFFER_BINDING_TYPE_READ_ONLY_STORAGE = 3u32;

// What shaders may do with a storage texture binding (WebGPU's)
pub const STORAGE_TEXTURE_ACCESS_WRITE_ONLY = 1u32;
pub const STORAGE_TEXTURE_ACCESS_READ_ONLY = 2u32;
pub const STORAGE_TEXTURE_ACCESS_READ_WRITE = 3u32;

// What a texture binding's texels are (WebGPU's sampleType): an r32float or
// r32uint texture is not filtered, so it is UNFILTERABLE_FLOAT or UINT, and
// sampled with a nearest sampler or read by 'Load'. Vulkan's layout does not
// need it; a WebGPU backend's does.
pub const TEXTURE_SAMPLE_TYPE_FLOAT = 1u32;
pub const TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT = 2u32;
pub const TEXTURE_SAMPLE_TYPE_UINT = 3u32;

// What a query set holds (WebGPU's): GPU timestamps
pub const QUERY_TYPE_TIMESTAMP = 2u32;
// The most queries a query set may hold (WebGPU's)
pub const MAX_QUERY_COUNT = 4096u32;

// How a sampler filters, and how it wraps coordinates outside 0 to 1
// (WebGPU's names)
pub const FILTER_MODE_NEAREST = 1u32;
pub const FILTER_MODE_LINEAR = 2u32;
pub const ADDRESS_MODE_CLAMP_TO_EDGE = 1u32;
pub const ADDRESS_MODE_REPEAT = 2u32;
pub const ADDRESS_MODE_MIRROR_REPEAT = 3u32;

// A vertex attribute's format (WebGPU's names)
pub const VERTEX_FORMAT_FLOAT32 = 1u32;
pub const VERTEX_FORMAT_FLOAT32X2 = 2u32;
pub const VERTEX_FORMAT_FLOAT32X3 = 3u32;
pub const VERTEX_FORMAT_FLOAT32X4 = 4u32;
pub const VERTEX_FORMAT_UNORM8X4 = 5u32;

// Whether a vertex buffer steps once a vertex or once an instance
pub const VERTEX_STEP_MODE_VERTEX = 1u32;
pub const VERTEX_STEP_MODE_INSTANCE = 2u32;

pub const INDEX_FORMAT_UINT16 = 1u32;
pub const INDEX_FORMAT_UINT32 = 2u32;

pub const PRIMITIVE_TOPOLOGY_POINT_LIST = 1u32;
pub const PRIMITIVE_TOPOLOGY_LINE_LIST = 2u32;
pub const PRIMITIVE_TOPOLOGY_LINE_STRIP = 3u32;
pub const PRIMITIVE_TOPOLOGY_TRIANGLE_LIST = 4u32;
pub const PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP = 5u32;

// Which way round a front face's corners go, seen on the screen (clip
// space's y up), and which faces are not drawn
pub const FRONT_FACE_CCW = 1u32;
pub const FRONT_FACE_CW = 2u32;
pub const CULL_MODE_NONE = 1u32;
pub const CULL_MODE_FRONT = 2u32;
pub const CULL_MODE_BACK = 3u32;

// A depth test's comparison of a fragment's depth with the one held
pub const COMPARE_FUNCTION_NEVER = 1u32;
pub const COMPARE_FUNCTION_LESS = 2u32;
pub const COMPARE_FUNCTION_EQUAL = 3u32;
pub const COMPARE_FUNCTION_LESS_EQUAL = 4u32;
pub const COMPARE_FUNCTION_GREATER = 5u32;
pub const COMPARE_FUNCTION_NOT_EQUAL = 6u32;
pub const COMPARE_FUNCTION_GREATER_EQUAL = 7u32;
pub const COMPARE_FUNCTION_ALWAYS = 8u32;

// Blending (WebGPU's GPUBlendFactor and GPUBlendOperation): what a fragment's
// color (the source) and what the target holds (the destination) are each
// multiplied by before they are added. A pipeline blends only when its
// descriptor's 'blendEnabled' is set.
pub const BLEND_FACTOR_ZERO = 1u32;
pub const BLEND_FACTOR_ONE = 2u32;
pub const BLEND_FACTOR_SRC_ALPHA = 3u32;
pub const BLEND_FACTOR_ONE_MINUS_SRC_ALPHA = 4u32;

// The most bytes of immediates a pipeline layout may have: what every
// Vulkan device offers as push constants
pub const MAX_IMMEDIATE_SIZE = 128u32;
// The most bind groups a pipeline layout may have (WebGPU's default limit),
// vertex buffers a pipeline may read, attributes in all, and the highest
// binding number in a bind group layout, plus one
pub const MAX_BIND_GROUPS = 4u32;
pub const MAX_VERTEX_BUFFERS = 8u32;
pub const MAX_VERTEX_ATTRIBUTES = 16u32;
pub const MAX_BINDINGS = 16u32;

// Compute's limits: WebGPU's defaults, which every WebGPU implementation
// offers, so a program within them runs in a browser too. Vulkan's are
// higher on every desktop GPU; the layer holds programs to these. A compute
// entry point's workgroup (Slang's [numthreads(x, y, z)]) is at most 256 by
// 256 by 64 and 256 invocations in all ('createShaderModule' checks); a
// dispatch is at most 65535 workgroups each way ('dispatchWorkgroups'
// checks); a stage sees at most 8 storage buffers and 4 storage textures
// ('createPipelineLayout' checks); a storage buffer binding is at most 128
// MiB, from an offset a multiple of 256 ('createBindGroup' checks); a 3-D
// texture is at most 2048 texels each way ('createTexture' checks); and a
// workgroup's shared memory is at most 16 KiB (not checked: that needs the
// shader's variables' sizes).
pub const MAX_COMPUTE_WORKGROUP_SIZE_X = 256u32;
pub const MAX_COMPUTE_WORKGROUP_SIZE_Y = 256u32;
pub const MAX_COMPUTE_WORKGROUP_SIZE_Z = 64u32;
pub const MAX_COMPUTE_INVOCATIONS_PER_WORKGROUP = 256u32;
pub const MAX_COMPUTE_WORKGROUPS_PER_DIMENSION = 65535u32;
pub const MAX_COMPUTE_WORKGROUP_STORAGE_SIZE = 16384u32;
pub const MAX_STORAGE_BUFFERS_PER_SHADER_STAGE = 8u32;
pub const MAX_STORAGE_TEXTURES_PER_SHADER_STAGE = 4u32;
pub const MAX_STORAGE_BUFFER_BINDING_SIZE = 134217728u64;
pub const MIN_STORAGE_BUFFER_OFFSET_ALIGNMENT = 256u64;
pub const MAX_TEXTURE_DIMENSION_3D = 2048u32;

// Which GPU 'requestAdapter' prefers where there are several (WebGPU's)
pub const POWER_PREFERENCE_HIGH_PERFORMANCE = 1u32;   // a discrete GPU first
pub const POWER_PREFERENCE_LOW_POWER = 2u32;          // an integrated GPU first

// Adapter types (WebGPU's)
pub const ADAPTER_TYPE_DISCRETE_GPU = 1u32;
pub const ADAPTER_TYPE_INTEGRATED_GPU = 2u32;
pub const ADAPTER_TYPE_CPU = 3u32;
pub const ADAPTER_TYPE_UNKNOWN = 4u32;

// What 'getCurrentTexture' found
pub const SURFACE_TEXTURE_SUCCESS_OPTIMAL = 1u32;     // a texture to draw into
pub const SURFACE_TEXTURE_SUCCESS_SUBOPTIMAL = 2u32;  // a texture; the swapchain is made again after it
pub const SURFACE_TEXTURE_SKIPPED = 3u32;             // the window has no area: draw nothing this frame
pub const SURFACE_TEXTURE_OUTDATED = 4u32;            // out of date even when made again
pub const SURFACE_TEXTURE_ERROR = 5u32;               // failed (on stderr)

// What a texture is, which decides the layout it rests in between commands
const KIND_NONE = 0u32;
const KIND_SURFACE = 1u32;         // a swapchain's: presentation's layout
const KIND_COLOR = 2u32;           // a color attachment: its attachment layout
const KIND_DEPTH = 3u32;           // a depth attachment: its attachment layout
const KIND_SAMPLED = 4u32;         // a texture shaders sample: the shader-read layout
const KIND_RENDER_SAMPLED = 5u32;  // drawn into and sampled: the shader-read layout, but the
                                   // attachment layout for the part a pass draws into
const KIND_STORAGE = 6u32;         // a storage texture (and perhaps sampled): the general layout,
                                   // which storage reads and writes, sampling and copies all take

// The most buffers a frame may release ('queue.releaseBuffer') before it
// comes round again; more wait for the device to be idle
const MAX_RELEASED = 64u32;
