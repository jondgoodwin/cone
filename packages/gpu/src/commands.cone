// ---- Barriers ----

// Record a layout transition of all of 'image' ('aspect' of it), with the
// stages and accesses before and after it
fn transition(fns: &DevFns, cmd: vulkan.CommandBuffer, image: vulkan.Image, aspect: u32, oldLayout: u32, newLayout: u32,
    srcStage: u64, srcAccess: u64, dstStage: u64, dstAccess: u64) {
  transitionRange(fns, cmd, image, vulkan.ImageSubresourceRange(aspectMask: aspect), oldLayout, newLayout,
    srcStage, srcAccess, dstStage, dstAccess);
}

// The same, of the levels and layers 'range' names
fn transitionRange(fns: &DevFns, cmd: vulkan.CommandBuffer, image: vulkan.Image, range: vulkan.ImageSubresourceRange, oldLayout: u32,
    newLayout: u32, srcStage: u64, srcAccess: u64, dstStage: u64, dstAccess: u64) {
  let barrier = vulkan.ImageMemoryBarrier2(srcStageMask: srcStage, srcAccessMask: srcAccess,
    dstStageMask: dstStage, dstAccessMask: dstAccess, oldLayout: oldLayout, newLayout: newLayout, image: image,
    subresourceRange: range);
  let dep = vulkan.DependencyInfo(pMemoryBarriers: null,
    pBufferMemoryBarriers: null, imageMemoryBarrierCount: 1u32,
    pImageMemoryBarriers: &barrier as *vulkan.ImageMemoryBarrier2);
  fns.cmdPipelineBarrier2(cmd, &dep);
}

// The level and layer a view names (a pass draws into one of each)
fn viewRange(backend: &TextureBackend) vulkan.ImageSubresourceRange {
  vulkan.ImageSubresourceRange(aspectMask: vulkan.IMAGE_ASPECT_COLOR_BIT, baseMipLevel: backend.baseMip,
    levelCount: 1u32, baseArrayLayer: backend.baseLayer, layerCount: 1u32)
}

// The layout a texture of 'kind' rests in between commands
fn restLayout(kind: u32) u32 {
  if kind == KIND_SURFACE { return vulkan.IMAGE_LAYOUT_PRESENT_SRC_KHR; }
  if kind == KIND_DEPTH { return vulkan.IMAGE_LAYOUT_DEPTH_ATTACHMENT_OPTIMAL; }
  if kind == KIND_SAMPLED || kind == KIND_RENDER_SAMPLED { return vulkan.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL; }
  if kind == KIND_STORAGE { return vulkan.IMAGE_LAYOUT_GENERAL; }
  if kind == KIND_DEPTH_SAMPLED { return vulkan.IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL; }
  vulkan.IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
}

// Move a new texture of 'kind' from 'undefined' to the layout it rests in,
// every level and layer of it
fn firstLayout(fns: &DevFns, cmd: vulkan.CommandBuffer, image: vulkan.Image, kind: u32) {
  var aspect = vulkan.IMAGE_ASPECT_COLOR_BIT;
  var stages = vulkan.PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT;
  if kind == KIND_DEPTH {
    aspect = vulkan.IMAGE_ASPECT_DEPTH_BIT;
    stages = vulkan.PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT | vulkan.PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT;
  }
  if kind == KIND_DEPTH_SAMPLED {
    aspect = vulkan.IMAGE_ASPECT_DEPTH_BIT;
    stages = vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
  }
  if kind == KIND_SAMPLED || kind == KIND_RENDER_SAMPLED || kind == KIND_STORAGE {
    stages = vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
  }
  let all = vulkan.ImageSubresourceRange(aspectMask: aspect, levelCount: vulkan.REMAINING_MIP_LEVELS,
    layerCount: vulkan.REMAINING_ARRAY_LAYERS);
  transitionRange(fns, cmd, image, all, vulkan.IMAGE_LAYOUT_UNDEFINED, restLayout(kind),
    vulkan.PIPELINE_STAGE_2_NONE, vulkan.ACCESS_2_NONE, stages, vulkan.ACCESS_2_NONE);
}

// ---- Commands ----

struct EncoderBackend {
  cmd: vulkan.CommandBuffer;
  fns: DevFns;
}

// Records commands, finished into a CommandBuffer for the queue
pub struct CommandEncoder {
  backend: EncoderBackend;

  // Whether it records: not once finished, nor when the frame had no
  // command buffer left for it (refused, and counted, when it was made).
  // What an encoder that does not record is asked to do is not done.
  pub fn isValid(self: &) bool { !isNull(backend.cmd) }

  // Begin drawing into one color attachment, cleared or kept as 'attachment'
  // says
  pub fn beginRenderPass(self: &mut, attachment: &RenderPassColorAttachment) RenderPass {
    let none = RenderPassDepthStencilAttachment(TextureView(TextureBackend(vulkan.Image(0u64),
      vulkan.ImageView(0u64), KIND_NONE, false, 0usize as vulkan.Device, backend.fns, vulkan.DeviceMemory(0u64)),
      0u32, 0u32, TEXTURE_FORMAT_UNDEFINED));
    beginPass(&backend.fns, backend.cmd, attachment, false, &none)
  }

  // Begin drawing into a color attachment and a depth attachment
  pub fn beginRenderPassWithDepth(self: &mut, attachment: &RenderPassColorAttachment,
      depth: &RenderPassDepthStencilAttachment) RenderPass {
    beginPass(&backend.fns, backend.cmd, attachment, true, depth)
  }

  // Begin a depth-only pass: no color attachment, just 'depth', a view of
  // one layer of a depth texture (shadow maps: a cascade each). The view
  // may be of a depth texture also bound for sampling
  // (TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING), which
  // moves to the attachment layout for the pass (the earlier readers done
  // first) and back to the read-only layout at 'end', what the pass wrote
  // visible to the shaders that sample it. Pipelines drawn in it have
  // 'colorFormat' TEXTURE_FORMAT_UNDEFINED.
  pub fn beginDepthPass(self: &mut, depth: &RenderPassDepthStencilAttachment) RenderPass {
    beginDepthOnly(&backend.fns, backend.cmd, depth)
  }

  // Build an acceleration structure (raytracing.cone): all of a bottom level's triangles, or the first
  // 'count' instances written to a top level's 'instances' buffer. Outside a pass. After what was
  // recorded before it, and visible to everything recorded after, a shader's rays included.
  pub fn buildAccelerationStructure(self: &mut, structure: &AccelerationStructure, count: u32) {
    recordBuild(self, structure, count);
  }

  // Begin dispatching compute shaders (WebGPU's 'beginComputePass'). What
  // earlier commands wrote is visible to its shaders and its indirect
  // dispatches.
  pub fn beginComputePass(self: &mut) ComputePassEncoder {
    if isNull(backend.cmd) {
      return ComputePassEncoder(ComputePassBackend(backend.cmd, backend.fns, false, vulkan.PipelineLayout(0u64), false));
    }
    memoryBarrier(&backend.fns, backend.cmd, vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_MEMORY_WRITE_BIT,
      vulkan.PIPELINE_STAGE_2_COMPUTE_SHADER_BIT | vulkan.PIPELINE_STAGE_2_DRAW_INDIRECT_BIT,
      vulkan.ACCESS_2_MEMORY_READ_BIT | vulkan.ACCESS_2_MEMORY_WRITE_BIT);
    ComputePassEncoder(ComputePassBackend(backend.cmd, backend.fns, true, vulkan.PipelineLayout(0u64), false))
  }

  // Write the GPU's clock into query 'queryIndex' of 'querySet' (of
  // timestamps) once every command before it is done. Outside a pass: the
  // time between two is the time the commands between them took.
  pub fn writeTimestamp(self: &mut, querySet: &QuerySet, queryIndex: u32) {
    if isNull(backend.cmd) { return; }
    if !querySet.isValid() || queryIndex >= querySet.count {
      fail("writeTimestamp: no such query");
      return;
    }
    backend.fns.cmdResetQueryPool(backend.cmd, querySet.backend.pool, queryIndex, 1u32);
    backend.fns.cmdWriteTimestamp2(backend.cmd, vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, querySet.backend.pool, queryIndex);
  }

  // Copy queries 'firstQuery' to 'firstQuery' + 'queryCount' of 'querySet'
  // into 'destination' (made with BUFFER_USAGE_QUERY_RESOLVE) at
  // 'destinationOffset' (a multiple of 256), each a u64: WebGPU's
  // 'resolveQuerySet'. Each query must have been written in this encoder's
  // submission or before. A timestamp is in ticks of 'device.timestampPeriod'
  // nanoseconds, where WebGPU's are nanoseconds.
  pub fn resolveQuerySet(self: &mut, querySet: &QuerySet, firstQuery: u32, queryCount: u32, destination: &Buffer,
      destinationOffset: u64) {
    if isNull(backend.cmd) { return; }
    if !querySet.isValid() || firstQuery + queryCount > querySet.count
        || (destination.usage & BUFFER_USAGE_QUERY_RESOLVE) == 0u32 || (destinationOffset & 255u64) != 0u64
        || destinationOffset + u64.from(queryCount) * 8u64 > destination.size {
      fail("resolveQuerySet: no such queries, or the buffer has no BUFFER_USAGE_QUERY_RESOLVE, or no room at an offset a multiple of 256");
      return;
    }
    memoryBarrier(&backend.fns, backend.cmd, vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_MEMORY_WRITE_BIT,
      vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT);
    backend.fns.cmdCopyQueryPoolResults(backend.cmd, querySet.backend.pool, firstQuery, queryCount, destination.backend.buffer,
      destinationOffset, 8u64, vulkan.QUERY_RESULT_64_BIT | vulkan.QUERY_RESULT_WAIT_BIT);
    memoryBarrier(&backend.fns, backend.cmd, vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT,
      vulkan.PIPELINE_STAGE_2_HOST_BIT | vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
      vulkan.ACCESS_2_HOST_READ_BIT | vulkan.ACCESS_2_MEMORY_READ_BIT | vulkan.ACCESS_2_MEMORY_WRITE_BIT);
  }

  // Copy all of 'texture' (a color texture with COPY_SRC, or a swapchain's;
  // its first level, and its first layer or, of a 3-D texture, every slice)
  // into 'buffer', from its start, row after row and slice after slice with
  // no gap between them (4 bytes a texel, 8 of rgba16float). WebGPU pads
  // each row to 256 bytes; this does not.
  pub fn copyTextureToBuffer(self: &mut, texture: &Texture, buffer: &Buffer) {
    if isNull(backend.cmd) { return; }
    let image = texture.backend.image;
    let rest = restLayout(texture.backend.kind);
    let depth = if texture.dimension == TEXTURE_DIMENSION_3D { texture.depthOrArrayLayers } else { 1u32 };
    if u64.from(texture.width) * u64.from(texture.height) * u64.from(depth) * u64.from(bytesPerTexel(texture.format)) > buffer.size {
      fail("copyTextureToBuffer: the buffer is smaller than the texture");
      return;
    }
    // What wrote it (a render pass) before the copy reads it; presentation's
    // hand-off is the acquire semaphore's
    var srcStage = vulkan.PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT;
    var srcAccess = vulkan.ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT;
    if texture.backend.kind == KIND_SURFACE {
      srcStage = vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
      srcAccess = vulkan.ACCESS_2_NONE;
    }
    // One drawn into and sampled: after the shaders that sampled it too
    if texture.backend.kind == KIND_RENDER_SAMPLED { srcStage = vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT; }
    // A storage texture, or one filled by 'writeTexture': after whatever wrote it
    if texture.backend.kind == KIND_STORAGE || texture.backend.kind == KIND_SAMPLED {
      srcStage = vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
      srcAccess = vulkan.ACCESS_2_MEMORY_WRITE_BIT;
    }
    transition(&backend.fns, backend.cmd, image, vulkan.IMAGE_ASPECT_COLOR_BIT, rest, vulkan.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
      srcStage, srcAccess, vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_READ_BIT);
    let region = vulkan.BufferImageCopy(imageSubresource: vulkan.ImageSubresourceLayers(),
      imageOffset: vulkan.Offset3D(0i32, 0i32, 0i32), imageExtent: vulkan.Extent3D(texture.width, texture.height, depth));
    backend.fns.cmdCopyImageToBuffer(backend.cmd, image, vulkan.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buffer.backend.buffer,
      1u32, &region as *vulkan.BufferImageCopy);
    // Back to the layout it rests in, once the copy has read it
    transition(&backend.fns, backend.cmd, image, vulkan.IMAGE_ASPECT_COLOR_BIT, vulkan.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, rest,
      vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_NONE,
      vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_NONE);
    // What was copied, visible to the CPU once the frame is done
    let bb = vulkan.BufferMemoryBarrier2(srcStageMask: vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT,
      srcAccessMask: vulkan.ACCESS_2_TRANSFER_WRITE_BIT, dstStageMask: vulkan.PIPELINE_STAGE_2_HOST_BIT,
      dstAccessMask: vulkan.ACCESS_2_HOST_READ_BIT, buffer: buffer.backend.buffer);
    let dep = vulkan.DependencyInfo(pMemoryBarriers: null,
      bufferMemoryBarrierCount: 1u32, pBufferMemoryBarriers: &bb as *vulkan.BufferMemoryBarrier2,
      pImageMemoryBarriers: null);
    backend.fns.cmdPipelineBarrier2(backend.cmd, &dep);
  }

  // Copy 'size' bytes of 'source', from 'sourceOffset', into 'destination'
  // at 'destinationOffset'. What the CPU wrote to a mapped source before the
  // submission is what is copied; a mapped destination holds the bytes once
  // the frame is done.
  pub fn copyBufferToBuffer(self: &mut, source: &Buffer, sourceOffset: u64, destination: &Buffer,
      destinationOffset: u64, size: u64) {
    if isNull(backend.cmd) { return; }
    // After what earlier commands did with either buffer
    memoryBarrier(&backend.fns, backend.cmd, vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_MEMORY_WRITE_BIT,
      vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_READ_BIT | vulkan.ACCESS_2_TRANSFER_WRITE_BIT);
    let region = vulkan.BufferCopy(sourceOffset, destinationOffset, size);
    backend.fns.cmdCopyBuffer(backend.cmd, source.backend.buffer, destination.backend.buffer, 1u32,
      &region as *vulkan.BufferCopy);
    // What was copied, visible to the CPU and to what the GPU does next
    memoryBarrier(&backend.fns, backend.cmd, vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT,
      vulkan.PIPELINE_STAGE_2_HOST_BIT | vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
      vulkan.ACCESS_2_HOST_READ_BIT | vulkan.ACCESS_2_MEMORY_READ_BIT | vulkan.ACCESS_2_MEMORY_WRITE_BIT);
  }

  // The commands recorded, for the queue to submit. The encoder records
  // nothing more.
  pub fn finish(self: &mut) CommandBuffer {
    let cmd = backend.cmd;
    backend.cmd = nullCommandBuffer();
    if !isNull(cmd) { check(backend.fns.endCommandBuffer(cmd), "vkEndCommandBuffer"); }
    CommandBuffer(CommandBufferBackend(cmd))
  }
}

// Begin rendering into 'color' and, if 'hasDepth', 'depth': the barriers
// each needs after what earlier commands did with it, then the whole
// attachment as the viewport and the scissor rectangle
fn beginPass(fns: &DevFns, cmd: vulkan.CommandBuffer, color: &RenderPassColorAttachment, hasDepth: bool,
    depth: &RenderPassDepthStencilAttachment) RenderPass {
  // An encoder that does not record begins a pass that records nothing
  if isNull(cmd) {
    return RenderPass(PassBackend(cmd, *fns, vulkan.Image(0u64), 0u32, false, vulkan.PipelineLayout(0u64),
      vulkan.ImageSubresourceRange()));
  }
  let view = color.view;
  let kind = view.backend.kind;
  let clear = color.loadOp == LOAD_OP_CLEAR;
  if view.backend.mipCount != 1u32 || view.backend.layerCount != 1u32 {
    fail("beginRenderPass: a pass draws into a view of one level and one layer");
  }
  // What was there is not needed if it is cleared; what wrote it last (an
  // earlier pass) is done first. A swapchain texture comes from the layout
  // presentation wants, presentation's hand-off being the acquire
  // semaphore's; a texture the device made to draw into rests in the
  // attachment layout; one also sampled rests in the shader-read layout,
  // what wrote it made visible at the end of that pass, and what sampled it
  // done first. Only the level and layer the view names move.
  var oldLayout = restLayout(kind);
  if clear { oldLayout = vulkan.IMAGE_LAYOUT_UNDEFINED; }
  var srcAccess = vulkan.ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT;
  if kind == KIND_SURFACE || kind == KIND_RENDER_SAMPLED { srcAccess = vulkan.ACCESS_2_NONE; }
  var dstAccess = vulkan.ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT;
  if !clear { dstAccess = dstAccess | vulkan.ACCESS_2_COLOR_ATTACHMENT_READ_BIT; }
  transitionRange(fns, cmd, view.backend.image, viewRange(&view.backend), oldLayout,
    vulkan.IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
    vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, srcAccess,
    vulkan.PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, dstAccess);
  var loadOp = vulkan.ATTACHMENT_LOAD_OP_LOAD;
  if clear { loadOp = vulkan.ATTACHMENT_LOAD_OP_CLEAR; }
  var storeOp = vulkan.ATTACHMENT_STORE_OP_STORE;
  if color.storeOp == STORE_OP_DISCARD { storeOp = vulkan.ATTACHMENT_STORE_OP_DONT_CARE; }
  let c = color.clearValue;
  let colorInfo = vulkan.RenderingAttachmentInfo(imageView: view.backend.view,
    resolveImageView: vulkan.ImageView(0u64), loadOp: loadOp, storeOp: storeOp,
    clearValue: vulkan.clearColor(c.red, c.green, c.blue, c.alpha));

  // The depth attachment: after earlier passes' depth tests and writes
  var depthLoad = vulkan.ATTACHMENT_LOAD_OP_LOAD;
  var depthStore = vulkan.ATTACHMENT_STORE_OP_STORE;
  var depthClear = vulkan.ClearValue(Array[u32, 4]() <- fill 0u32);
  var depthSampled = false;
  if hasDepth {
    let depthClears = depth.depthLoadOp == LOAD_OP_CLEAR;
    // A depth texture also sampled (TEXTURE_USAGE_TEXTURE_BINDING) rests in
    // the read-only layout: it moves to the attachment layout for the pass
    // (the earlier samplers done first) and back at 'end'
    depthSampled = depth.view.backend.kind == KIND_DEPTH_SAMPLED;
    var depthOld = vulkan.IMAGE_LAYOUT_DEPTH_ATTACHMENT_OPTIMAL;
    if depthSampled { depthOld = vulkan.IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL; }
    var depthAccess = vulkan.ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
    if depthClears {
      depthOld = vulkan.IMAGE_LAYOUT_UNDEFINED;
      depthLoad = vulkan.ATTACHMENT_LOAD_OP_CLEAR;
    } else {
      depthAccess = depthAccess | vulkan.ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT;
    }
    if depth.depthStoreOp == STORE_OP_DISCARD { depthStore = vulkan.ATTACHMENT_STORE_OP_DONT_CARE; }
    let tests = vulkan.PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT | vulkan.PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT;
    let depthSrcStage = if depthSampled { vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT } else { tests };
    let depthSrcAccess = if depthSampled { vulkan.ACCESS_2_NONE } else { vulkan.ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT };
    transition(fns, cmd, depth.view.backend.image, vulkan.IMAGE_ASPECT_DEPTH_BIT, depthOld,
      vulkan.IMAGE_LAYOUT_DEPTH_ATTACHMENT_OPTIMAL, depthSrcStage, depthSrcAccess,
      tests, depthAccess | vulkan.ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT);
    *(&mut depthClear as *f32) = depth.depthClearValue;
  }
  let depthInfo = vulkan.RenderingAttachmentInfo(imageView: depth.view.backend.view,
    imageLayout: vulkan.IMAGE_LAYOUT_DEPTH_ATTACHMENT_OPTIMAL, resolveImageView: vulkan.ImageView(0u64),
    loadOp: depthLoad, storeOp: depthStore, clearValue: depthClear);
  var depthPointer: *vulkan.RenderingAttachmentInfo = null;
  if hasDepth { depthPointer = &depthInfo as *vulkan.RenderingAttachmentInfo; }

  let ri = vulkan.RenderingInfo(
    renderArea: vulkan.Rect2D(vulkan.Offset2D(0i32, 0i32), vulkan.Extent2D(view.width, view.height)),
    colorAttachmentCount: 1u32, pColorAttachments: &colorInfo as *vulkan.RenderingAttachmentInfo,
    pDepthAttachment: depthPointer, pStencilAttachment: null);
  fns.cmdBeginRendering(cmd, &ri);
  setViewportFlipped(fns, cmd, 0., 0., f32.from(view.width), f32.from(view.height), 0., 1.);
  let scissor = vulkan.Rect2D(vulkan.Offset2D(0i32, 0i32), vulkan.Extent2D(view.width, view.height));
  fns.cmdSetScissor(cmd, 0u32, 1u32, &scissor as *vulkan.Rect2D);
  var backend = PassBackend(cmd, *fns, view.backend.image, kind, true, vulkan.PipelineLayout(0u64), viewRange(&view.backend));
  if hasDepth && depthSampled {
    backend.depthImage = depth.view.backend.image;
    backend.depthSampled = true;
    backend.depthRange = vulkan.ImageSubresourceRange(aspectMask: vulkan.IMAGE_ASPECT_DEPTH_BIT,
      baseMipLevel: depth.view.backend.baseMip, levelCount: 1u32, baseArrayLayer: depth.view.backend.baseLayer,
      layerCount: 1u32);
  }
  RenderPass(backend)
}

// Begin rendering into the depth view alone (no color attachment): the layer
// it names moves to the attachment layout (from the shader-read layout, the
// earlier samplers done first, or from nothing if it is cleared), the whole
// view the viewport and the scissor rectangle
fn beginDepthOnly(fns: &DevFns, cmd: vulkan.CommandBuffer, depth: &RenderPassDepthStencilAttachment) RenderPass {
  if isNull(cmd) {
    return RenderPass(PassBackend(cmd, *fns, vulkan.Image(0u64), 0u32, false, vulkan.PipelineLayout(0u64),
      vulkan.ImageSubresourceRange()));
  }
  let view = depth.view;
  let kind = view.backend.kind;
  if view.backend.mipCount != 1u32 || view.backend.layerCount != 1u32 {
    fail("beginDepthPass: a pass draws into a view of one level and one layer");
  }
  let range = vulkan.ImageSubresourceRange(aspectMask: vulkan.IMAGE_ASPECT_DEPTH_BIT, baseMipLevel: view.backend.baseMip,
    levelCount: 1u32, baseArrayLayer: view.backend.baseLayer, layerCount: 1u32);
  let clears = depth.depthLoadOp == LOAD_OP_CLEAR;
  let tests = vulkan.PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT | vulkan.PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT;
  var oldLayout = restLayout(kind);
  var srcStage = tests;
  var srcAccess = vulkan.ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
  if kind == KIND_DEPTH_SAMPLED {
    // What sampled it is done first; reads need no cache flush
    srcStage = vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
    srcAccess = vulkan.ACCESS_2_NONE;
  }
  if clears { oldLayout = vulkan.IMAGE_LAYOUT_UNDEFINED; }
  var dstAccess = vulkan.ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
  if !clears { dstAccess = dstAccess | vulkan.ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT; }
  transitionRange(fns, cmd, view.backend.image, range, oldLayout, vulkan.IMAGE_LAYOUT_DEPTH_ATTACHMENT_OPTIMAL,
    srcStage, srcAccess, tests, dstAccess);
  var depthClear = vulkan.ClearValue(Array[u32, 4]() <- fill 0u32);
  *(&mut depthClear as *f32) = depth.depthClearValue;
  var loadOp = vulkan.ATTACHMENT_LOAD_OP_LOAD;
  if clears { loadOp = vulkan.ATTACHMENT_LOAD_OP_CLEAR; }
  var storeOp = vulkan.ATTACHMENT_STORE_OP_STORE;
  if depth.depthStoreOp == STORE_OP_DISCARD { storeOp = vulkan.ATTACHMENT_STORE_OP_DONT_CARE; }
  let depthInfo = vulkan.RenderingAttachmentInfo(imageView: view.backend.view,
    imageLayout: vulkan.IMAGE_LAYOUT_DEPTH_ATTACHMENT_OPTIMAL, resolveImageView: vulkan.ImageView(0u64),
    loadOp: loadOp, storeOp: storeOp, clearValue: depthClear);
  let ri = vulkan.RenderingInfo(
    renderArea: vulkan.Rect2D(vulkan.Offset2D(0i32, 0i32), vulkan.Extent2D(view.width, view.height)),
    colorAttachmentCount: 0u32, pColorAttachments: null,
    pDepthAttachment: &depthInfo as *vulkan.RenderingAttachmentInfo, pStencilAttachment: null);
  fns.cmdBeginRendering(cmd, &ri);
  setViewportFlipped(fns, cmd, 0., 0., f32.from(view.width), f32.from(view.height), 0., 1.);
  let scissor = vulkan.Rect2D(vulkan.Offset2D(0i32, 0i32), vulkan.Extent2D(view.width, view.height));
  fns.cmdSetScissor(cmd, 0u32, 1u32, &scissor as *vulkan.Rect2D);
  RenderPass(PassBackend(cmd, *fns, view.backend.image, kind, true, vulkan.PipelineLayout(0u64), range))
}

// The viewport from ('x', 'y'), 'w' by 'h', with y down from the top of the
// attachment, flipped so that clip space's y is up, as WebGPU's is
fn setViewportFlipped(fns: &DevFns, cmd: vulkan.CommandBuffer, x: f32, y: f32, w: f32, h: f32, minDepth: f32, maxDepth: f32) {
  let vp = vulkan.Viewport(x, y + h, w, 0. - h, minDepth, maxDepth);
  fns.cmdSetViewport(cmd, 0u32, 1u32, &vp as *vulkan.Viewport);
}

// A color attachment of a render pass: the view drawn into, what is done
// with what it holds at the start (cleared to 'clearValue', or kept) and at
// the end (stored, or discarded)
pub struct RenderPassColorAttachment {
  pub view: TextureView;
  pub loadOp: u32 = LOAD_OP_CLEAR;
  pub storeOp: u32 = STORE_OP_STORE;
  pub clearValue: Color;
}

// A depth attachment of a render pass: the depth texture's view, what is
// done with its depths at the start (cleared to 'depthClearValue', or kept)
// and at the end (stored, or discarded)
pub struct RenderPassDepthStencilAttachment {
  pub view: TextureView;
  pub depthLoadOp: u32 = LOAD_OP_CLEAR;
  pub depthStoreOp: u32 = STORE_OP_STORE;
  pub depthClearValue: f32 = 1.;
}

struct PassBackend {
  cmd: vulkan.CommandBuffer;
  fns: DevFns;
  image: vulkan.Image;
  kind: u32;
  open: bool;
  layout: vulkan.PipelineLayout;    // the bound pipeline's
  range: vulkan.ImageSubresourceRange;  // the color attachment's level and layer
  // A depth attachment that is also sampled (beginRenderPassWithDepth): moved
  // back to the read-only layout at 'end'
  depthImage: vulkan.Image = vulkan.Image(0u64);
  depthSampled: bool = false;
  depthRange: vulkan.ImageSubresourceRange = vulkan.ImageSubresourceRange();
}

// Drawing into attachments, begun by 'beginRenderPass' and ended by 'end'
pub struct RenderPass {
  backend: PassBackend;

  // Draw with 'pipeline' from here on
  pub fn setPipeline(self: &mut, pipeline: &RenderPipeline) {
    if isNull(backend.cmd) { return; }
    backend.fns.cmdBindPipeline(backend.cmd, vulkan.PIPELINE_BIND_POINT_GRAPHICS, pipeline.backend.pipeline);
    backend.layout = pipeline.backend.layout;
  }

  // Bind 'group' as the pipeline's bind group 'index'
  pub fn setBindGroup(self: &mut, index: u32, group: &BindGroup) {
    if isNull(backend.cmd) { return; }
    if backend.layout.h == 0u64 {
      fail("setBindGroup before setPipeline");
      return;
    }
    var set = group.backend.set;
    backend.fns.cmdBindDescriptorSets(backend.cmd, vulkan.PIPELINE_BIND_POINT_GRAPHICS, backend.layout, index, 1u32,
      &mut set as *vulkan.DescriptorSet, 0u32, null);
  }

  // Read vertex buffer 'slot' of the pipeline from 'buffer', from 'offset'
  pub fn setVertexBuffer(self: &mut, slot: u32, buffer: &Buffer, offset: u64) {
    if isNull(backend.cmd) { return; }
    var b = buffer.backend.buffer;
    var o = offset;
    backend.fns.cmdBindVertexBuffers(backend.cmd, slot, 1u32, &mut b as *vulkan.Buffer, &mut o as *u64);
  }

  // Read indices ('format': INDEX_FORMAT_UINT16 or _UINT32) from 'buffer',
  // from 'offset'
  pub fn setIndexBuffer(self: &mut, buffer: &Buffer, format: u32, offset: u64) {
    if isNull(backend.cmd) { return; }
    var type = vulkan.INDEX_TYPE_UINT32;
    if format == INDEX_FORMAT_UINT16 { type = vulkan.INDEX_TYPE_UINT16; }
    backend.fns.cmdBindIndexBuffer(backend.cmd, buffer.backend.buffer, offset, type);
  }

  // Set 'size' bytes of the immediates, from 'offset' (both multiples of
  // 4), to the bytes at 'data', for the draws after
  pub fn setImmediates(self: &mut, offset: u32, data: *u8, size: u32) {
    if isNull(backend.cmd) { return; }
    if backend.layout.h == 0u64 {
      fail("setImmediates before setPipeline");
      return;
    }
    backend.fns.cmdPushConstants(backend.cmd, backend.layout, immediateStages(), offset, size, data);
  }

  // Draw into the rectangle from ('x', 'y'), 'width' by 'height' pixels, of
  // the attachments ('y' down from their top), with depths from 'minDepth'
  // to 'maxDepth'
  pub fn setViewport(self: &mut, x: f32, y: f32, width: f32, height: f32, minDepth: f32, maxDepth: f32) {
    if isNull(backend.cmd) { return; }
    setViewportFlipped(&backend.fns, backend.cmd, x, y, width, height, minDepth, maxDepth);
  }

  // Draw nothing outside the rectangle from ('x', 'y'), 'width' by 'height'
  // pixels ('y' down from the top)
  pub fn setScissorRect(self: &mut, x: u32, y: u32, width: u32, height: u32) {
    if isNull(backend.cmd) { return; }
    let r = vulkan.Rect2D(vulkan.Offset2D(i32.from(x), i32.from(y)), vulkan.Extent2D(width, height));
    backend.fns.cmdSetScissor(backend.cmd, 0u32, 1u32, &r as *vulkan.Rect2D);
  }

  // Draw 'vertexCount' vertices from 'firstVertex', 'instanceCount' times
  pub fn draw(self: &mut, vertexCount: u32, instanceCount: u32, firstVertex: u32, firstInstance: u32) {
    if isNull(backend.cmd) { return; }
    backend.fns.cmdDraw(backend.cmd, vertexCount, instanceCount, firstVertex, firstInstance);
  }

  // Draw 'indexCount' indices from 'firstIndex', each 'baseVertex' added to,
  // 'instanceCount' times
  pub fn drawIndexed(self: &mut, indexCount: u32, instanceCount: u32, firstIndex: u32, baseVertex: i32, firstInstance: u32) {
    if isNull(backend.cmd) { return; }
    backend.fns.cmdDrawIndexed(backend.cmd, indexCount, instanceCount, firstIndex, baseVertex, firstInstance);
  }

  // Draw as 'draw' does, its four arguments (vertexCount, instanceCount,
  // firstVertex, firstInstance: u32s) read by the GPU from 'buffer' at
  // 'offset' (a multiple of 4): a buffer made with BUFFER_USAGE_INDIRECT,
  // written by a compute pass before this pass, say
  pub fn drawIndirect(self: &mut, buffer: &Buffer, offset: u64) {
    if isNull(backend.cmd) { return; }
    if (buffer.usage & BUFFER_USAGE_INDIRECT) == 0u32 || (offset & 3u64) != 0u64 || offset + 16u64 > buffer.size {
      fail("drawIndirect: the buffer has no BUFFER_USAGE_INDIRECT, or the offset is not a multiple of 4 or leaves no room");
      return;
    }
    backend.fns.cmdDrawIndirect(backend.cmd, buffer.backend.buffer, offset, 1u32, 16u32);
  }

  // Draw as 'drawIndexed' does, its five arguments (indexCount,
  // instanceCount, firstIndex, baseVertex an i32, firstInstance) read by the
  // GPU from 'buffer' at 'offset', as 'drawIndirect' reads its four
  pub fn drawIndexedIndirect(self: &mut, buffer: &Buffer, offset: u64) {
    if isNull(backend.cmd) { return; }
    if (buffer.usage & BUFFER_USAGE_INDIRECT) == 0u32 || (offset & 3u64) != 0u64 || offset + 20u64 > buffer.size {
      fail("drawIndexedIndirect: the buffer has no BUFFER_USAGE_INDIRECT, or the offset is not a multiple of 4 or leaves no room");
      return;
    }
    backend.fns.cmdDrawIndexedIndirect(backend.cmd, buffer.backend.buffer, offset, 1u32, 20u32);
  }

  // The end of the pass; a swapchain texture goes back to the layout kept
  // between commands, and so does one sampled by later passes, what the pass
  // wrote visible to the shaders that sample it
  pub fn end(self: &mut) {
    if !backend.open { return; }
    backend.open = false;
    backend.fns.cmdEndRendering(backend.cmd);
    if backend.kind == KIND_RENDER_SAMPLED {
      transitionRange(&backend.fns, backend.cmd, backend.image, backend.range, vulkan.IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
        vulkan.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
        vulkan.PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, vulkan.ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
        vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_SHADER_READ_BIT);
    }
    if backend.depthSampled {
      transitionRange(&backend.fns, backend.cmd, backend.depthImage, backend.depthRange, vulkan.IMAGE_LAYOUT_DEPTH_ATTACHMENT_OPTIMAL,
        vulkan.IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL,
        vulkan.PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT | vulkan.PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT,
        vulkan.ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT,
        vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_SHADER_READ_BIT);
    }
    if backend.kind == KIND_DEPTH_SAMPLED {
      transitionRange(&backend.fns, backend.cmd, backend.image, backend.range, vulkan.IMAGE_LAYOUT_DEPTH_ATTACHMENT_OPTIMAL,
        vulkan.IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL,
        vulkan.PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT | vulkan.PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT,
        vulkan.ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT,
        vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_SHADER_READ_BIT);
    }
    if backend.kind == KIND_SURFACE {
      transition(&backend.fns, backend.cmd, backend.image, vulkan.IMAGE_ASPECT_COLOR_BIT, vulkan.IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
        vulkan.IMAGE_LAYOUT_PRESENT_SRC_KHR,
        vulkan.PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, vulkan.ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
        vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_NONE);
    }
  }
}

struct CommandBufferBackend {
  cmd: vulkan.CommandBuffer;
}

// Recorded commands, to submit once ('device.queue.submit')
pub struct CommandBuffer {
  backend: CommandBufferBackend;
}
