// ---- Device and CommandQueue: the frames in flight, and the CommandQueue ----

// A block of staging memory, mapped
struct StagingBlock {
  buffer vulkan.Buffer;
  memory vulkan.DeviceMemory;
  mapped *u8;
  size u64;
}

// One frame in flight's state
struct FrameState {
  fence vulkan.Fence;          // signalled by the frame's last submission
  pending bool;                // its fence will be signalled
  pool vulkan.CommandPool;     // recording thread 0's pool (one per thread, when there are threads)
  buffers Array[vulkan.CommandBuffer, 16];   // allocated from the pool, reused each time the frame comes round
  allocated u32;
  used u32;
  upload vulkan.CommandBuffer; // recording uploads and textures' first layouts, until the next submission
  spare vulkan.CommandBuffer;  // the upload buffer a flush ran, to record the next uploads into
  staging StagingBlock;        // where uploads are copied from, from its start
  stagingUsed u64;
  stagingTaken u64;            // bytes taken from staging this round (the frame so far)
  stagingEstimate u64;         // what a round takes, estimated: the last rounds' most, each half the next's
  retired *StagingBlock;       // blocks outgrown this frame, freed when it comes round
  retiredCount u32;
  retiredCapacity u32;
  released *ReleasedObject;    // buffers, textures and bind groups released this frame, destroyed when it comes round
  releasedCount u32;
  releasedCapacity u32;
}

const RELEASED_BUFFER = 0u32;
const RELEASED_TEXTURE = 1u32;
const RELEASED_GROUP = 2u32;

// What 'queue.releaseBuffer', 'releaseTexture' and 'releaseBindGroup' took,
// destroyed once its frame is done
struct ReleasedObject {
  kind u32;                    // RELEASED_...
  buffer vulkan.Buffer;        // a buffer's, with its memory
  memory vulkan.DeviceMemory;  // (and a texture's)
  image vulkan.Image;          // a texture's, with its views
  view vulkan.ImageView;
  views *ViewCache;
  pool vulkan.DescriptorPool;  // a bind group's, which frees its set
}

// Destroy everything one frame's state released, and free its list when asked (its room is
// otherwise kept for the next time)
fn destroyReleased(fns &DevFns, device vulkan.Device, frame &mut FrameState, freeList bool) {
  var d = 0usize;
  while d < usize.from(frame.releasedCount) {
    let o = frame.released + d;
    if o.kind == RELEASED_GROUP {
      fns.destroyDescriptorPool(device, o.pool, nullp());
    } elif o.kind == RELEASED_TEXTURE {
      if o.view.h != 0u64 { fns.destroyImageView(device, o.view, nullp()); }
      endViews(fns, device, o.views);
      fns.destroyImage(device, o.image, nullp());
      if o.memory.h != 0u64 { fns.freeMemory(device, o.memory, nullp()); }
    } else {
      fns.destroyBuffer(device, o.buffer, nullp());
      fns.freeMemory(device, o.memory, nullp());
    }
    d = d + 1usize;
  }
  frame.releasedCount = 0u32;
  if freeList and (frame.released as usize) != 0usize {
    libc.free(frame.released as *u8);
    frame.released = null;
    frame.releasedCapacity = 0u32;
  }
}

// Destroy the staging blocks one frame's state outgrew, and free its list when asked
fn destroyRetired(fns &DevFns, device vulkan.Device, frame &mut FrameState, freeList bool) {
  var r = 0usize;
  while r < usize.from(frame.retiredCount) {
    let b = frame.retired + r;
    fns.destroyBuffer(device, b.buffer, nullp());
    fns.freeMemory(device, b.memory, nullp());
    r = r + 1usize;
  }
  frame.retiredCount = 0u32;
  if freeList and (frame.retired as usize) != 0usize {
    libc.free(frame.retired as *u8);
    frame.retired = null;
    frame.retiredCapacity = 0u32;
  }
}

struct DeviceBackend {
  device vulkan.Device;
  fns DevFns;                  // its functions, found when it was made
  ifns InstFns;                // its instance's
  physical vulkan.PhysicalDevice;
  queueFamily u32;
  ray vulkan.RayFns;           // the ray-tracing functions, found when the device was made with ray tracing
}

struct QueueBackend {
  handle vulkan.Queue;
  device vulkan.Device;
  acquired vulkan.Semaphore;   // the current swapchain image's acquire semaphore,
  waiting bool;                // until a submission waits for it
  frames Array[FrameState, 2];
  flushFence vulkan.Fence;     // signalled by a mid-frame flush of uploads (made the first time, reset after each wait)
  frameIndex u32;              // which of 'frames' is being recorded
  inFrame bool;
  memory vulkan.PhysicalDeviceMemoryProperties;
}

// The device's queue: what it submits runs in the order submitted. It keeps
// the frames in flight.
pub struct CommandQueue {
  backend QueueBackend;
  fns DevFns;                  // the device's functions (here and not in the backend, which is made zeroed)

  // Submit the commands 'cmd' holds, after the uploads 'writeBuffer' asked
  // for. The first submission after a swapchain texture is acquired waits
  // for it to be ready to draw into.
  pub fn submit(self &mut, cmd CommandBuffer) bool {
    if isNull(cmd.backend.cmd) { return false; }
    submitCommands(self, cmd.backend.cmd, new vulkan.Fence(0u64), 0u32, null)
  }

  // Submit as 'submit' does, and signal 'fence' (one from 'createFence',
  // not submitted before) once the GPU has finished these commands and
  // everything submitted before them. False, and the fence not submitted,
  // if nothing was.
  pub fn submitSignalling(self &mut, cmd CommandBuffer, fence &mut Fence) bool {
    if isNull(cmd.backend.cmd) or fence.fence.h == 0u64 or fence.submitted { return false; }
    fence.submitted = submitCommands(self, cmd.backend.cmd, fence.fence, 0u32, null);
    fence.submitted
  }

  // Signal 'fence' (one from 'createFence', not submitted before) once the
  // GPU has finished everything submitted so far, and the uploads asked for
  // since: a submission of no commands of its own
  pub fn signal(self &mut, fence &mut Fence) bool {
    if fence.fence.h == 0u64 or fence.submitted { return false; }
    fence.submitted = submitCommands(self, nullCommandBuffer(), fence.fence, 0u32, null);
    fence.submitted
  }

  // Write 'size' bytes from 'data' into 'buffer' at 'offset', which must be
  // a buffer with BUFFER_USAGE_COPY_DST. The bytes are copied now (into
  // staging memory), and into the buffer by the GPU ahead of whatever is
  // submitted next, after everything submitted before and after the writes
  // made before it: WebGPU's 'queue.writeBuffer'. A frame that writes more
  // than 32 MiB in all waits part-way for the GPU to copy what it has
  // written (once for each 32 MiB), so that staging memory stays small.
  pub fn writeBuffer(self &mut, buffer &Buffer, offset u64, data *u8, size u64) {
    if size == 0u64 { return; }
    if (buffer.usage & BUFFER_USAGE_COPY_DST) == 0u32 {
      fail("writeBuffer: the buffer was not made with BUFFER_USAGE_COPY_DST");
      return;
    }
    if offset + size > buffer.size {
      fail("writeBuffer: the bytes run past the buffer's end");
      return;
    }
    // In pieces of at most MAX_STAGING_BLOCK, so that staging memory stays
    // bounded however many bytes are written at once
    var written = 0u64;
    while written < size {
      let piece = if size - written > MAX_STAGING_BLOCK { MAX_STAGING_BLOCK } else { size - written };
      if isNull(uploadCommands(self)) or !stagingRoom(self, piece) { return; }
      let cmd = uploadCommands(self);
      let i = usize.from(backend.frameIndex);
      let at = backend.frames[i].stagingUsed;
      libc.memcpy(backend.frames[i].staging.mapped + usize.from(at), data + usize.from(written), usize.from(piece));
      backend.frames[i].stagingUsed = at + piece;
      // After the frame's earlier copies, which may have written the same
      // bytes (two writes to one buffer in a frame land in the order made)
      memoryBarrier(&fns, cmd, vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT,
        vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT);
      let region = new vulkan.BufferCopy(at, offset + written, piece);
      fns.cmdCopyBuffer(cmd, backend.frames[i].staging.buffer, buffer.backend.buffer, 1u32,
        &region as *vulkan.BufferCopy);
      written = written + piece;
    }
  }

  // Set 'size' bytes of 'buffer' from 'offset' to zero, on the GPU, ahead of
  // whatever is submitted next and in order with the writes made before it,
  // as 'writeBuffer' writes: no bytes cross from the CPU (vkCmdFillBuffer).
  // The buffer must have BUFFER_USAGE_COPY_DST, and 'offset' and 'size' be
  // multiples of 4. WebGPU's 'clearBuffer' is the command encoder's; this is
  // the queue's, for a buffer zeroed before any encoder records into it.
  pub fn clearBuffer(self &mut, buffer &Buffer, offset u64, size u64) {
    if size == 0u64 { return; }
    if (buffer.usage & BUFFER_USAGE_COPY_DST) == 0u32 {
      fail("clearBuffer: the buffer was not made with BUFFER_USAGE_COPY_DST");
      return;
    }
    if (offset & 3u64) != 0u64 or (size & 3u64) != 0u64 or offset + size > buffer.size {
      fail("clearBuffer: the offset or size is not a multiple of 4, or the bytes run past the buffer's end");
      return;
    }
    let cmd = uploadCommands(self);
    if isNull(cmd) { return; }
    // After the frame's earlier copies and clears, which may have written
    // the same bytes
    memoryBarrier(&fns, cmd, vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT,
      vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT);
    fns.cmdFillBuffer(cmd, buffer.backend.buffer, offset, size, 0u32);
  }

  // Write the 'width' x 'height' texels at ('x', 'y') of 'texture' (a 2-D,
  // single-layer color texture made with TEXTURE_USAGE_COPY_DST that shaders
  // sample, its first level) from 'data': the rows from the top, each
  // 'bytesPerRow' bytes apart (at least a row, a multiple of the texel's size
  // and of 4). What the rest of the texture holds is kept. The bytes are
  // copied now, and into the texture by the GPU ahead of whatever is
  // submitted next, after the frames already submitted that sample it:
  // WebGPU's 'queue.writeTexture' with an origin and a size. A texture
  // never written must be written whole once ('writeTexture') first, for its
  // layout to be one that holds contents.
  pub fn writeTextureRegion(self &mut, texture &Texture, data *u8, bytesPerRow u32, x u32, y u32, width u32, height u32) {
    if (texture.usage & TEXTURE_USAGE_COPY_DST) == 0u32 {
      fail("writeTextureRegion: the texture was not made with TEXTURE_USAGE_COPY_DST");
      return;
    }
    if texture.backend.kind != KIND_SAMPLED or texture.dimension != TEXTURE_DIMENSION_2D
        or texture.depthOrArrayLayers != 1u32 or texture.format == TEXTURE_FORMAT_DEPTH32_FLOAT {
      fail("writeTextureRegion: only a single-layer 2-D color texture shaders sample is written");
      return;
    }
    if width == 0u32 or height == 0u32 { return; }
    if x + width > texture.width or y + height > texture.height {
      fail("writeTextureRegion: the region runs past the texture's edge");
      return;
    }
    let texel = bytesPerTexel(texture.format);
    if bytesPerRow < width * texel or bytesPerRow % texel != 0u32 or (bytesPerRow & 3u32) != 0u32 {
      fail("writeTextureRegion: bytesPerRow is less than a row, or not a multiple of a texel and of 4");
      return;
    }
    let size = u64.from(bytesPerRow) * u64.from(height);
    if isNull(uploadCommands(self)) or !stagingRoom(self, size) { return; }
    let cmd = uploadCommands(self);
    let i = usize.from(backend.frameIndex);
    let at = backend.frames[i].stagingUsed;
    libc.memcpy(backend.frames[i].staging.mapped + usize.from(at), data, usize.from(size));
    backend.frames[i].stagingUsed = at + size;
    // The rest of the texture is kept, so the transition starts from the
    // layout it rests in; earlier samplings of it are done first
    transition(&fns, cmd, texture.backend.image, vulkan.IMAGE_ASPECT_COLOR_BIT, restLayout(texture.backend.kind),
      vulkan.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
      vulkan.ACCESS_2_MEMORY_READ_BIT | vulkan.ACCESS_2_MEMORY_WRITE_BIT,
      vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT);
    let region = new vulkan.BufferImageCopy(bufferOffset: at, bufferRowLength: bytesPerRow / texel,
      imageSubresource: new vulkan.ImageSubresourceLayers(),
      imageOffset: new vulkan.Offset3D(i32.from(x), i32.from(y), 0i32),
      imageExtent: new vulkan.Extent3D(width, height, 1u32));
    fns.cmdCopyBufferToImage(cmd, backend.frames[i].staging.buffer, texture.backend.image,
      vulkan.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1u32, &region as *vulkan.BufferImageCopy);
    transition(&fns, cmd, texture.backend.image, vulkan.IMAGE_ASPECT_COLOR_BIT, vulkan.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
      restLayout(texture.backend.kind), vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT,
      vulkan.ACCESS_2_TRANSFER_WRITE_BIT, vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
      vulkan.ACCESS_2_MEMORY_READ_BIT | vulkan.ACCESS_2_MEMORY_WRITE_BIT);
  }

  // Write all of 'texture' (one made with TEXTURE_USAGE_COPY_DST, a color
  // texture shaders sample or a storage texture; its first level) from
  // 'data': its rows from the top, each 'bytesPerRow' bytes apart (at least
  // a row, a multiple of the texel's size and of 4), and a 3-D texture's
  // slices from the front, each 'height' rows. The bytes are copied now,
  // and into the texture by the GPU ahead of whatever is submitted next:
  // WebGPU's 'queue.writeTexture', for the whole texture.
  pub fn writeTexture(self &mut, texture &Texture, data *u8, bytesPerRow u32) {
    if (texture.usage & TEXTURE_USAGE_COPY_DST) == 0u32 {
      fail("writeTexture: the texture was not made with TEXTURE_USAGE_COPY_DST");
      return;
    }
    if (texture.backend.kind != KIND_SAMPLED and texture.backend.kind != KIND_STORAGE)
        or texture.format == TEXTURE_FORMAT_DEPTH32_FLOAT {
      fail("writeTexture: only a color texture shaders sample (TEXTURE_USAGE_TEXTURE_BINDING), or a storage texture, is written");
      return;
    }
    let texel = bytesPerTexel(texture.format);
    if bytesPerRow < texture.width * texel or bytesPerRow % texel != 0u32 or (bytesPerRow & 3u32) != 0u32 {
      fail("writeTexture: bytesPerRow is less than a row, or not a multiple of a texel and of 4");
      return;
    }
    let depth = if texture.dimension == TEXTURE_DIMENSION_3D { texture.depthOrArrayLayers } else { 1u32 };
    let size = u64.from(bytesPerRow) * u64.from(texture.height) * u64.from(depth);
    if isNull(uploadCommands(self)) or !stagingRoom(self, size) { return; }
    let cmd = uploadCommands(self);
    let i = usize.from(backend.frameIndex);
    let at = backend.frames[i].stagingUsed;
    libc.memcpy(backend.frames[i].staging.mapped + usize.from(at), data, usize.from(size));
    backend.frames[i].stagingUsed = at + size;
    // All of it is written, so what it held is not kept; earlier samplings
    // of it are done first (the upload's barrier covers every stage)
    transition(&fns, cmd, texture.backend.image, vulkan.IMAGE_ASPECT_COLOR_BIT, vulkan.IMAGE_LAYOUT_UNDEFINED,
      vulkan.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_NONE,
      vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT);
    let region = new vulkan.BufferImageCopy(bufferOffset: at, bufferRowLength: bytesPerRow / texel,
      imageSubresource: new vulkan.ImageSubresourceLayers(), imageOffset: new vulkan.Offset3D(0i32, 0i32, 0i32),
      imageExtent: new vulkan.Extent3D(texture.width, texture.height, depth));
    fns.cmdCopyBufferToImage(cmd, backend.frames[i].staging.buffer, texture.backend.image,
      vulkan.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1u32, &region as *vulkan.BufferImageCopy);
    // Back to the layout it rests in, the copy visible to the shaders that
    // sample it (or read and write it, a storage texture)
    transition(&fns, cmd, texture.backend.image, vulkan.IMAGE_ASPECT_COLOR_BIT, vulkan.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
      restLayout(texture.backend.kind), vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT,
      vulkan.ACCESS_2_TRANSFER_WRITE_BIT, vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
      vulkan.ACCESS_2_MEMORY_READ_BIT | vulkan.ACCESS_2_MEMORY_WRITE_BIT);
  }

  // Write every mip level of 'texture' (a 2-D, single-layer one made with
  // TEXTURE_USAGE_COPY_DST that shaders sample) from 'data': the levels one
  // after another, the largest first, each tightly packed (its rows
  // width x texel size bytes apart, from the top; a level is half the one
  // before in each direction, at least 1). The bytes are copied now, and into
  // the texture by the GPU ahead of whatever is submitted next, as
  // 'writeTexture' does for the first level alone.
  pub fn writeTextureLevels(self &mut, texture &Texture, data *u8) {
    if (texture.usage & TEXTURE_USAGE_COPY_DST) == 0u32 {
      fail("writeTextureLevels: the texture was not made with TEXTURE_USAGE_COPY_DST");
      return;
    }
    if texture.backend.kind != KIND_SAMPLED or texture.dimension != TEXTURE_DIMENSION_2D
        or texture.depthOrArrayLayers != 1u32 or texture.mipLevelCount > 16u32 {
      fail("writeTextureLevels: only a single-layer 2-D texture shaders sample is written");
      return;
    }
    let texel = bytesPerTexel(texture.format);
    let levels = texture.mipLevelCount;
    var size = 0u64;
    var l = 0u32;
    while l < levels {
      let w = if (texture.width >> l) > 0u32 { texture.width >> l } else { 1u32 };
      let h = if (texture.height >> l) > 0u32 { texture.height >> l } else { 1u32 };
      size = size + u64.from(w) * u64.from(h) * u64.from(texel);
      l = l + 1u32;
    }
    if isNull(uploadCommands(self)) or !stagingRoom(self, size) { return; }
    let cmd = uploadCommands(self);
    let i = usize.from(backend.frameIndex);
    let at = backend.frames[i].stagingUsed;
    libc.memcpy(backend.frames[i].staging.mapped + usize.from(at), data, usize.from(size));
    backend.frames[i].stagingUsed = at + size;
    let all = new vulkan.ImageSubresourceRange(aspectMask: vulkan.IMAGE_ASPECT_COLOR_BIT, levelCount: levels);
    transitionRange(&fns, cmd, texture.backend.image, all, vulkan.IMAGE_LAYOUT_UNDEFINED,
      vulkan.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_NONE,
      vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT);
    var regions = new Array[vulkan.BufferImageCopy, 16] <- fill zeroed[vulkan.BufferImageCopy]();
    var offset = at;
    l = 0u32;
    while l < levels {
      let w = if (texture.width >> l) > 0u32 { texture.width >> l } else { 1u32 };
      let h = if (texture.height >> l) > 0u32 { texture.height >> l } else { 1u32 };
      regions[usize.from(l)] = new vulkan.BufferImageCopy(bufferOffset: offset, bufferRowLength: w,
        imageSubresource: new vulkan.ImageSubresourceLayers(mipLevel: l),
        imageOffset: new vulkan.Offset3D(0i32, 0i32, 0i32), imageExtent: new vulkan.Extent3D(w, h, 1u32));
      offset = offset + u64.from(w) * u64.from(h) * u64.from(texel);
      l = l + 1u32;
    }
    fns.cmdCopyBufferToImage(cmd, backend.frames[i].staging.buffer, texture.backend.image,
      vulkan.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, levels, &regions as *vulkan.BufferImageCopy);
    transitionRange(&fns, cmd, texture.backend.image, all, vulkan.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
      restLayout(texture.backend.kind), vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT,
      vulkan.ACCESS_2_TRANSFER_WRITE_BIT, vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
      vulkan.ACCESS_2_MEMORY_READ_BIT | vulkan.ACCESS_2_MEMORY_WRITE_BIT);
  }

  // Take 'buffer' out of use: it is not valid from now on, and its memory
  // is freed once the GPU has finished every frame that may have used it
  // (when this frame's state comes round again), without waiting for the
  // device to be idle, as dropping a buffer does: WebGPU's
  // 'buffer.destroy()'. For replacing what is drawn, frame by frame.
  pub fn releaseBuffer(self &mut, buffer &mut Buffer) {
    if buffer.backend.buffer.h == 0u64 and buffer.backend.memory.h == 0u64 { return; }
    // In a frame, so that its fence is signalled after all that used it
    beginQueueFrame(self);
    queueReleased(self, usize.from(backend.frameIndex), new ReleasedObject(RELEASED_BUFFER, buffer.backend.buffer,
      buffer.backend.memory, new vulkan.Image(0u64), new vulkan.ImageView(0u64), null, new vulkan.DescriptorPool(0u64)));
    buffer.backend.buffer = new vulkan.Buffer(0u64);
    buffer.backend.memory = new vulkan.DeviceMemory(0u64);
    buffer.backend.mapped = nullp();
  }

  // Take 'texture' out of use, as 'releaseBuffer' does a buffer: it is not
  // valid from now on, and its image, views and memory are destroyed once
  // the GPU has finished every frame that may have used it, without waiting
  // for the device to be idle, as dropping a texture does. A bind group
  // that binds it ('createBindGroup') must be released ('releaseBindGroup')
  // or dropped too, and not used again. A swapchain's texture is not the
  // device's to release: nothing happens.
  pub fn releaseTexture(self &mut, texture &mut Texture) {
    if !texture.backend.owned or (texture.backend.image.h == 0u64 and texture.backend.memory.h == 0u64) { return; }
    beginQueueFrame(self);
    queueReleased(self, usize.from(backend.frameIndex), new ReleasedObject(RELEASED_TEXTURE, new vulkan.Buffer(0u64),
      texture.backend.memory, texture.backend.image, texture.backend.view, texture.backend.views,
      new vulkan.DescriptorPool(0u64)));
    texture.backend.image = new vulkan.Image(0u64);
    texture.backend.view = new vulkan.ImageView(0u64);
    texture.backend.memory = new vulkan.DeviceMemory(0u64);
    texture.backend.views = null;
  }

  // Take 'group' out of use the same way: its descriptor pool (and so its
  // set) is destroyed once the GPU has finished every frame that may have
  // drawn with it. It does not release the buffers and textures it binds.
  pub fn releaseBindGroup(self &mut, group &mut BindGroup) {
    if group.backend.pool.h == 0u64 { return; }
    beginQueueFrame(self);
    queueReleased(self, usize.from(backend.frameIndex), new ReleasedObject(RELEASED_GROUP, new vulkan.Buffer(0u64),
      new vulkan.DeviceMemory(0u64), new vulkan.Image(0u64), new vulkan.ImageView(0u64), null, group.backend.pool));
    group.backend.pool = new vulkan.DescriptorPool(0u64);
    group.backend.set = new vulkan.DescriptorSet(0u64);
  }

  // How many released buffers, textures and bind groups wait for their frame to come round
  pub fn pendingReleases(self &) u32 {
    backend.frames[0].releasedCount + backend.frames[1].releasedCount
  }
}

// Add 'o' to the objects frame state 'i' destroys when it comes round, growing the list by doubling
fn queueReleased(queue &mut CommandQueue, i usize, o ReleasedObject) {
  if queue.backend.frames[i].releasedCount == queue.backend.frames[i].releasedCapacity {
    let capacity = if queue.backend.frames[i].releasedCapacity == 0u32 { 64u32 } else { queue.backend.frames[i].releasedCapacity * 2u32 };
    let grown = libc.calloc(usize.from(capacity), mem.sizeof[ReleasedObject]()) as *ReleasedObject;
    if (queue.backend.frames[i].released as usize) != 0usize {
      libc.memcpy(grown as *u8, queue.backend.frames[i].released as *u8,
        usize.from(queue.backend.frames[i].releasedCount) * mem.sizeof[ReleasedObject]());
      libc.free(queue.backend.frames[i].released as *u8);
    }
    queue.backend.frames[i].released = grown;
    queue.backend.frames[i].releasedCapacity = capacity;
  }
  *(queue.backend.frames[i].released + usize.from(queue.backend.frames[i].releasedCount)) = o;
  queue.backend.frames[i].releasedCount = queue.backend.frames[i].releasedCount + 1u32;
}

// Submit the uploads recorded in this frame so far and wait until the GPU has run them (and what was submitted
// before them), so that the frame's staging memory is free to copy new bytes into from its start. The upload
// command buffer, once run, is kept to record the next uploads into.
fn flushStaging(queue &mut CommandQueue) {
  let i = usize.from(queue.backend.frameIndex);
  let upload = queue.backend.frames[i].upload;
  if isNull(upload) { return; }
  if queue.backend.flushFence.h == 0u64 {
    let fci = new vulkan.FenceCreateInfo();
    var made = new vulkan.Fence(0u64);
    check(queue.fns.createFence(queue.backend.device, &fci, nullp(), &mut made), "vkCreateFence");
    queue.backend.flushFence = made;
  }
  var fence = queue.backend.flushFence;
  if submitCommands(queue, nullCommandBuffer(), fence, 0u32, null) {
    check(queue.fns.waitForFences(queue.backend.device, 1u32, &mut fence as *vulkan.Fence, vulkan.TRUE, NO_TIMEOUT),
      "vkWaitForFences");
    check(queue.fns.resetFences(queue.backend.device, 1u32, &mut fence as *vulkan.Fence), "vkResetFences");
    queue.backend.frames[i].spare = upload;
  }
}

// Add 'block' to the staging blocks frame state 'i' destroys when it comes round, growing the list by doubling
fn retireStaging(queue &mut CommandQueue, i usize, block StagingBlock) {
  if queue.backend.frames[i].retiredCount == queue.backend.frames[i].retiredCapacity {
    let capacity = if queue.backend.frames[i].retiredCapacity == 0u32 { 8u32 } else { queue.backend.frames[i].retiredCapacity * 2u32 };
    let grown = libc.calloc(usize.from(capacity), mem.sizeof[StagingBlock]()) as *StagingBlock;
    if (queue.backend.frames[i].retired as usize) != 0usize {
      libc.memcpy(grown as *u8, queue.backend.frames[i].retired as *u8,
        usize.from(queue.backend.frames[i].retiredCount) * mem.sizeof[StagingBlock]());
      libc.free(queue.backend.frames[i].retired as *u8);
    }
    queue.backend.frames[i].retired = grown;
    queue.backend.frames[i].retiredCapacity = capacity;
  }
  *(queue.backend.frames[i].retired + usize.from(queue.backend.frames[i].retiredCount)) = block;
  queue.backend.frames[i].retiredCount = queue.backend.frames[i].retiredCount + 1u32;
}

// As frame state 'i' comes round (the GPU is done with its staging block): estimate what a round takes from
// staging, and give back a block that is four times that or more, leaving the next round to make one of the
// estimate's size. The estimate is the most of the last rounds, each counting half as much as the one
// after it, so one spike does not leave its block for long and a steady load never gives its block back.
fn shrinkStaging(queue &mut CommandQueue, i usize) {
  let taken = if queue.backend.frames[i].stagingTaken > MAX_STAGING_BLOCK { MAX_STAGING_BLOCK } else { queue.backend.frames[i].stagingTaken };
  let decayed = queue.backend.frames[i].stagingEstimate / 2u64;
  queue.backend.frames[i].stagingEstimate = if taken > decayed { taken } else { decayed };
  queue.backend.frames[i].stagingTaken = 0u64;
  let size = queue.backend.frames[i].staging.size;
  if queue.backend.frames[i].staging.buffer.h != 0u64 and size > STAGING_BLOCK
      and size >= queue.backend.frames[i].stagingEstimate * 4u64 {
    queue.fns.destroyBuffer(queue.backend.device, queue.backend.frames[i].staging.buffer, nullp());
    queue.fns.freeMemory(queue.backend.device, queue.backend.frames[i].staging.memory, nullp());
    queue.backend.frames[i].staging = zeroed[StagingBlock]();
  }
}

// Begin a frame, if one is not begun: wait until the GPU has finished the
// frame that last used this frame's state, and reset its command pools and
// staging memory
fn beginQueueFrame(queue &mut CommandQueue) {
  if queue.backend.inFrame or (queue.backend.device as *u8 as usize) == 0usize { return; }
  let device = queue.backend.device;
  let i = usize.from(queue.backend.frameIndex);
  if queue.backend.frames[i].pending {
    var fence = queue.backend.frames[i].fence;
    check(queue.fns.waitForFences(device, 1u32, &mut fence as *vulkan.Fence, vulkan.TRUE, NO_TIMEOUT),
      "vkWaitForFences");
    check(queue.fns.resetFences(device, 1u32, &mut fence as *vulkan.Fence), "vkResetFences");
    queue.backend.frames[i].pending = false;
  }
  check(queue.fns.resetCommandPool(device, queue.backend.frames[i].pool, 0u32), "vkResetCommandPool");
  queue.backend.frames[i].used = 0u32;
  queue.backend.frames[i].upload = nullCommandBuffer();
  queue.backend.frames[i].spare = nullCommandBuffer();
  destroyRetired(&queue.fns, device, &mut queue.backend.frames[i], false);
  destroyReleased(&queue.fns, device, &mut queue.backend.frames[i], false);
  shrinkStaging(queue, i);
  queue.backend.frames[i].stagingUsed = 0u64;
  queue.backend.inFrame = true;
}

// The next unused command buffer of the current frame's pool, begun
fn nextCommandBuffer(queue &mut CommandQueue) vulkan.CommandBuffer {
  let i = usize.from(queue.backend.frameIndex);
  if queue.backend.frames[i].used == MAX_FRAME_COMMAND_BUFFERS {
    fail("a frame recorded more than 16 command buffers");
    return nullCommandBuffer();
  }
  if queue.backend.frames[i].used == queue.backend.frames[i].allocated {
    let ai = new vulkan.CommandBufferAllocateInfo(commandPool: queue.backend.frames[i].pool,
      commandBufferCount: 1u32);
    var cmd = nullCommandBuffer();
    if !check(queue.fns.allocateCommandBuffers(queue.backend.device, &ai, &mut cmd as *vulkan.CommandBuffer),
        "vkAllocateCommandBuffers") {
      return nullCommandBuffer();
    }
    queue.backend.frames[i].buffers[usize.from(queue.backend.frames[i].allocated)] = cmd;
    queue.backend.frames[i].allocated = queue.backend.frames[i].allocated + 1u32;
  }
  let cmd = queue.backend.frames[i].buffers[usize.from(queue.backend.frames[i].used)];
  queue.backend.frames[i].used = queue.backend.frames[i].used + 1u32;
  let bi = new vulkan.CommandBufferBeginInfo(flags: vulkan.COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
    pInheritanceInfo: nullp());
  check(queue.fns.beginCommandBuffer(cmd, &bi), "vkBeginCommandBuffer");
  cmd
}

// A global memory barrier between everything before it and everything after
fn memoryBarrier(fns &DevFns, cmd vulkan.CommandBuffer, srcStage u64, srcAccess u64, dstStage u64, dstAccess u64) {
  let mb = new vulkan.MemoryBarrier2(srcStageMask: srcStage, srcAccessMask: srcAccess,
    dstStageMask: dstStage, dstAccessMask: dstAccess);
  let dep = new vulkan.DependencyInfo(memoryBarrierCount: 1u32, pMemoryBarriers: &mb as *vulkan.MemoryBarrier2,
    pBufferMemoryBarriers: null,
    pImageMemoryBarriers: null);
  fns.cmdPipelineBarrier2(cmd, &dep);
}

// The frame's upload commands, begun if they are not: copies into buffers
// from staging, and textures moved to their first layouts, submitted ahead
// of the next submission. They start with a barrier after everything
// submitted before them (their copies write what earlier commands may still
// read or write).
fn uploadCommands(queue &mut CommandQueue) vulkan.CommandBuffer {
  beginQueueFrame(queue);
  let i = usize.from(queue.backend.frameIndex);
  if !isNull(queue.backend.frames[i].upload) { return queue.backend.frames[i].upload; }
  var cmd = queue.backend.frames[i].spare;
  if isNull(cmd) {
    cmd = nextCommandBuffer(queue);
  } else {
    // The one a flush ran, recorded again (its pool lets a begun buffer reset itself)
    queue.backend.frames[i].spare = nullCommandBuffer();
    let bi = new vulkan.CommandBufferBeginInfo(flags: vulkan.COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
      pInheritanceInfo: nullp());
    check(queue.fns.beginCommandBuffer(cmd, &bi), "vkBeginCommandBuffer");
  }
  if isNull(cmd) { return cmd; }
  memoryBarrier(&queue.fns, cmd, vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_MEMORY_WRITE_BIT,
    vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT);
  queue.backend.frames[i].upload = cmd;
  cmd
}

// Room for 'size' bytes in the frame's staging block, from 'stagingUsed'
// (made a multiple of 16), which it never refuses for want of room:
//  - a block that is full and below MAX_STAGING_BLOCK is outgrown: a block
//    twice the size (at least the bytes asked for) replaces it, the old one
//    retired until the frame comes round again, since the copies already
//    recorded read from it;
//  - a block of MAX_STAGING_BLOCK or more is not outgrown: the uploads
//    recorded so far are submitted and waited for ('flushStaging'), and the
//    bytes go at its start again, so a frame of any size uploads through a
//    block of at most that size;
//  - bytes of more than MAX_STAGING_BLOCK (a texture's) get a block of their
//    own, their size.
// A block whose bytes the GPU has finished with, or has none yet, is
// destroyed rather than retired.
fn stagingRoom(queue &mut CommandQueue, size u64) bool {
  let i = usize.from(queue.backend.frameIndex);
  var at = (queue.backend.frames[i].stagingUsed + 15u64) & 0xFFFFFFFFFFFFFFF0u64;
  if queue.backend.frames[i].staging.buffer.h != 0u64 and at + size > queue.backend.frames[i].staging.size
      and queue.backend.frames[i].staging.size >= MAX_STAGING_BLOCK and size <= queue.backend.frames[i].staging.size {
    flushStaging(queue);
    at = 0u64;
  }
  if queue.backend.frames[i].staging.buffer.h != 0u64 and at + size <= queue.backend.frames[i].staging.size {
    queue.backend.frames[i].stagingUsed = at;
    queue.backend.frames[i].stagingTaken = queue.backend.frames[i].stagingTaken + size;
    return true;
  }
  let old = queue.backend.frames[i].staging;
  if old.buffer.h != 0u64 {
    if queue.backend.frames[i].stagingUsed == 0u64 {
      destroyStaging(queue, old);
    } else {
      retireStaging(queue, i, old);
    }
  }
  var blockSize = STAGING_BLOCK;
  if old.size * 2u64 > blockSize { blockSize = old.size * 2u64; }
  if old.size == 0u64 {
    while blockSize < queue.backend.frames[i].stagingEstimate and blockSize < MAX_STAGING_BLOCK { blockSize = blockSize * 2u64; }
  }
  while blockSize < size and blockSize < MAX_STAGING_BLOCK { blockSize = blockSize * 2u64; }
  if blockSize > MAX_STAGING_BLOCK { blockSize = MAX_STAGING_BLOCK; }
  if blockSize < size { blockSize = (size + STAGING_BLOCK - 1u64) / STAGING_BLOCK * STAGING_BLOCK; }
  let made = allocateBuffer(&queue.fns, queue.backend.device, &queue.backend.memory, blockSize,
    vulkan.BUFFER_USAGE_TRANSFER_SRC_BIT, BUFFER_USAGE_MAP_WRITE);
  queue.backend.frames[i].staging = new StagingBlock(made.buffer, made.memory, made.mapped, blockSize);
  queue.backend.frames[i].stagingUsed = 0u64;
  if made.memory.h == 0u64 or (made.mapped as usize) == 0usize {
    // Not made: nothing to copy into, and none kept to be copied into later
    destroyStaging(queue, queue.backend.frames[i].staging);
    queue.backend.frames[i].staging = zeroed[StagingBlock]();
    return false;
  }
  queue.backend.frames[i].stagingTaken = queue.backend.frames[i].stagingTaken + size;
  true
}

// Destroy a staging block the GPU is not using
fn destroyStaging(queue &mut CommandQueue, block StagingBlock) {
  if block.buffer.h != 0u64 { queue.fns.destroyBuffer(queue.backend.device, block.buffer, nullp()); }
  if block.memory.h != 0u64 { queue.fns.freeMemory(queue.backend.device, block.memory, nullp()); }
}

// Submit 'cmd' (if not null), after the frame's uploads (if any), waiting
// for the acquired swapchain image if no submission has yet, signalling
// 'fence' and 'signalCount' semaphores
fn submitCommands(queue &mut CommandQueue, cmd vulkan.CommandBuffer, fence vulkan.Fence, signalCount u32,
    signals *vulkan.SemaphoreSubmitInfo) bool {
  var cbis = new Array[vulkan.CommandBufferSubmitInfo, 2] <- fill new vulkan.CommandBufferSubmitInfo(
    commandBuffer: nullCommandBuffer());
  var count = 0usize;
  if queue.backend.inFrame {
    let i = usize.from(queue.backend.frameIndex);
    let upload = queue.backend.frames[i].upload;
    if !isNull(upload) {
      // What was copied, visible to everything after
      memoryBarrier(&queue.fns, upload, vulkan.PIPELINE_STAGE_2_ALL_TRANSFER_BIT, vulkan.ACCESS_2_TRANSFER_WRITE_BIT,
        vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT, vulkan.ACCESS_2_MEMORY_READ_BIT | vulkan.ACCESS_2_MEMORY_WRITE_BIT);
      check(queue.fns.endCommandBuffer(upload), "vkEndCommandBuffer");
      cbis[count].commandBuffer = upload;
      count = count + 1usize;
      queue.backend.frames[i].upload = nullCommandBuffer();
    }
  }
  if !isNull(cmd) {
    cbis[count].commandBuffer = cmd;
    count = count + 1usize;
  }
  let waitInfo = new vulkan.SemaphoreSubmitInfo(semaphore: queue.backend.acquired,
    stageMask: vulkan.PIPELINE_STAGE_2_ALL_COMMANDS_BIT);
  var waits = 0u32;
  if queue.backend.waiting { waits = 1u32; }
  let submit = new vulkan.SubmitInfo2(waitSemaphoreInfoCount: waits,
    pWaitSemaphoreInfos: &waitInfo as *vulkan.SemaphoreSubmitInfo, commandBufferInfoCount: u32.from(count),
    pCommandBufferInfos: &cbis as *vulkan.CommandBufferSubmitInfo, signalSemaphoreInfoCount: signalCount,
    pSignalSemaphoreInfos: signals);
  queue.backend.waiting = false;
  check(queue.fns.queueSubmit2(queue.backend.handle, 1u32, &submit as *vulkan.SubmitInfo2, fence), "vkQueueSubmit2")
}
