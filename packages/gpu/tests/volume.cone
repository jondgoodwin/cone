// 3-D textures and storage textures on a real GPU: written by compute,
// read and written in place, filled by 'queue.writeTexture', sampled by a
// render pass, written again after it, and read back. Only a failure prints.
//
// Four 16 x 8 x 4 storage textures, volume.slang's shaders:
// 1. 'doubled' (r32float, read and written) is filled by 'writeTexture' with
//    texel i = i / 2 (exact in binary), and doubleMain writes back 2 v + 1:
//    i + 1, every texel exactly.
// 2. fillMain writes 'values' (r32float) x + 16 y + 128 z + base (base 0),
//    'hashes' (r32uint) (73856093 x) ^ (19349663 y) ^ (83492791 z), and
//    'colors' (rgba16float) (x, y, z, 0.5): small integers and a half, exact
//    in half floats.
// 3. A render pass samples 'values' (a 3-D view, nearest: r32float is not
//    filtered) into a 16 x 8 rgba8unorm target: pixel (x, y) is texel
//    (x, y, 1), less 128, over 255, so its red is x + 16 y exactly. The pass
//    reads what the compute pass wrote: without the compute pass's closing
//    barrier, a read-after-write hazard.
// 4. A second compute pass writes 'values' again with base 1000, after the
//    render pass sampled it (a write-after-read hazard without the barrier
//    that opens it); read back, every texel is x + 16 y + 128 z + 1000, and
//    the hashes and colors are as 2 says.
//
// GPU_POWER_PREFERENCE=low-power tests the integrated GPU where there are
// two. It needs a GPU driver with Vulkan 1.3 and SDL3.dll; with the Vulkan
// SDK, validation and synchronization validation are on, and must say
// nothing.

mod volume;

import testing use *;
import libc;
import geomath use *;
import gpu use *;

const W = 16u32;
const H = 8u32;
const D = 4u32;
const TEXELS = 512usize;

fn preference() u32 {
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize and libc.strcmp(env, &"low-power" as *u8) == 0i32 { return POWER_PREFERENCE_LOW_POWER; }
  POWER_PREFERENCE_HIGH_PERFORMANCE;
}

fn word(p *u8, index usize) u32 { *((p + index * 4usize) as *u32); }
fn float(p *u8, index usize) f32 { *((p + index * 4usize) as *f32); }

// A half float's value, for the normal numbers and zero a test writes
fn half(h u16) f32 {
  imm bits = u32.from(h);
  imm exponent = (bits >> 10u32) & 31u32;
  if exponent == 0u32 { return 0.; }
  imm f = ((bits & 0x8000u32) << 16u32) | ((exponent + 112u32) << 23u32) | ((bits & 0x3FFu32) << 13u32);
  f as f32;
}

fn main() i32 {
  mut instance = Instance.create("volume");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, preference());
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");

  // ---- The textures ----
  imm valuesDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_R32_FLOAT,
    TEXTURE_USAGE_STORAGE_BINDING | TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_SRC, depthOrArrayLayers: D,
    dimension: TEXTURE_DIMENSION_3D);
  mut values = device.createTexture(&valuesDesc);
  imm hashesDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_R32_UINT,
    TEXTURE_USAGE_STORAGE_BINDING | TEXTURE_USAGE_COPY_SRC, depthOrArrayLayers: D, dimension: TEXTURE_DIMENSION_3D);
  mut hashes = device.createTexture(&hashesDesc);
  imm colorsDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA16_FLOAT,
    TEXTURE_USAGE_STORAGE_BINDING | TEXTURE_USAGE_COPY_SRC, depthOrArrayLayers: D, dimension: TEXTURE_DIMENSION_3D);
  mut colors = device.createTexture(&colorsDesc);
  imm doubledDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_R32_FLOAT,
    TEXTURE_USAGE_STORAGE_BINDING | TEXTURE_USAGE_COPY_DST | TEXTURE_USAGE_COPY_SRC, depthOrArrayLayers: D,
    dimension: TEXTURE_DIMENSION_3D);
  mut doubled = device.createTexture(&doubledDesc);
  require(values.isValid() and hashes.isValid() and colors.isValid() and doubled.isValid(), "four 3-D storage textures");
  mut valuesBack = device.createBuffer(2048u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut hashesBack = device.createBuffer(2048u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut colorsBack = device.createBuffer(4096u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut doubledBack = device.createBuffer(2048u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  imm targetDesc = new TextureDescriptor(W, H, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut target = device.createTexture(&targetDesc);
  mut pixels = device.createBuffer(512u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);

  // 1. 'doubled' filled from the CPU: texel i is i / 2
  mut halves Array[f32, 512] = [512; 0.];
  mut i = 0usize;
  while i < TEXELS {
    halves[i] = f32.from(i) * 0.5;
    i = i + 1usize;
  }
  device.queue.writeTexture(&doubled, &halves as *u8, W * 4u32);

  // ---- The pipelines and bind groups ----
  mut shader = device.createShaderModule(&VOLUME_SPIRV);
  imm storageEntries = [
    new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_STORAGE_TEXTURE,
      format: TEXTURE_FORMAT_R32_FLOAT, viewDimension: TEXTURE_VIEW_DIMENSION_3D),
    new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_STORAGE_TEXTURE,
      format: TEXTURE_FORMAT_R32_UINT, viewDimension: TEXTURE_VIEW_DIMENSION_3D),
    new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_STORAGE_TEXTURE,
      format: TEXTURE_FORMAT_RGBA16_FLOAT, viewDimension: TEXTURE_VIEW_DIMENSION_3D),
    new BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_COMPUTE, kind: BINDING_KIND_STORAGE_TEXTURE,
      format: TEXTURE_FORMAT_R32_FLOAT, storageAccess: STORAGE_TEXTURE_ACCESS_READ_WRITE,
      viewDimension: TEXTURE_VIEW_DIMENSION_3D)];
  mut storageLayout = device.createBindGroupLayout(&storageEntries);
  imm storageLayouts = [&storageLayout];
  mut computeLayout = device.createPipelineLayout(&storageLayouts, 4u32);
  imm fillDesc = new ComputePipelineDescriptor(layout: &computeLayout, module: &shader, entryPoint: "fillMain");
  mut fillPipeline = device.createComputePipeline(&fillDesc);
  imm doubleDesc = new ComputePipelineDescriptor(layout: &computeLayout, module: &shader, entryPoint: "doubleMain");
  mut doublePipeline = device.createComputePipeline(&doubleDesc);
  imm valuesView = values.createView();
  imm hashesView = hashes.createView();
  imm colorsView = colors.createView();
  imm doubledView = doubled.createView();
  imm storageGroupEntries = [BindGroupEntry.texture(0u32, &valuesView), BindGroupEntry.texture(1u32, &hashesView),
    BindGroupEntry.texture(2u32, &colorsView), BindGroupEntry.texture(3u32, &doubledView)];
  mut storageGroup = device.createBindGroup(&storageLayout, &storageGroupEntries);
  require(fillPipeline.isValid() and doublePipeline.isValid() and storageGroup.isValid(), "the compute pipelines and bind group");

  imm sampleEntries = [
    new BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
      sampleType: TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT, viewDimension: TEXTURE_VIEW_DIMENSION_3D),
    new BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER)];
  mut sampleLayout = device.createBindGroupLayout(&sampleEntries);
  imm sampleLayouts = [&sampleLayout];
  mut drawLayout = device.createPipelineLayout(&sampleLayouts, 0u32);
  imm noAttributes = [new VertexAttribute(VERTEX_FORMAT_FLOAT32, 0u64, 0u32)];
  imm noBuffers = [new VertexBufferLayout(arrayStride: 4u64, attributes: &noAttributes)];
  imm drawDesc = new RenderPipelineDescriptor(layout: &drawLayout, vertexModule: &shader, buffers: &noBuffers[..0],
    fragmentModule: &shader, colorFormat: TEXTURE_FORMAT_RGBA8_UNORM);
  mut drawPipeline = device.createRenderPipeline(&drawDesc);
  imm nearestDesc = new SamplerDescriptor(magFilter: FILTER_MODE_NEAREST, minFilter: FILTER_MODE_NEAREST,
    addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
    addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
  mut nearest = device.createSampler(&nearestDesc);
  imm volumeDesc = new TextureViewDescriptor(dimension: TEXTURE_VIEW_DIMENSION_3D);
  imm volumeView = values.createViewWith(&volumeDesc);
  imm sampleGroupEntries = [BindGroupEntry.texture(4u32, &volumeView), BindGroupEntry.sampler(5u32, &nearest)];
  mut sampleGroup = device.createBindGroup(&sampleLayout, &sampleGroupEntries);
  require(drawPipeline.isValid() and volumeView.isValid() and sampleGroup.isValid(), "the render pipeline and bind group");

  // ---- 1 to 4 ----
  mut encoder = device.createCommandEncoder();
  {
    mut pass = encoder.beginComputePass();
    imm base Array[f32, 1] = [0.];
    pass.setPipeline(&fillPipeline);
    pass.setBindGroup(0u32, &storageGroup);
    pass.setImmediates(0u32, &base as *u8, 4u32);
    pass.dispatchWorkgroups(W / 4u32, H / 4u32, D / 4u32);
    pass.setPipeline(&doublePipeline);
    pass.dispatchWorkgroups(W / 4u32, H / 4u32, D / 4u32);
    pass.end();
  }
  {
    imm attachment = new RenderPassColorAttachment(view: target.createView(), clearValue: new Color(0., 0., 0., 1.));
    mut pass = encoder.beginRenderPass(&attachment);
    pass.setPipeline(&drawPipeline);
    pass.setBindGroup(0u32, &sampleGroup);
    pass.draw(3u32, 1u32, 0u32, 0u32);
    pass.end();
  }
  {
    mut pass = encoder.beginComputePass();
    imm base Array[f32, 1] = [1000.];
    pass.setPipeline(&fillPipeline);
    pass.setBindGroup(0u32, &storageGroup);
    pass.setImmediates(0u32, &base as *u8, 4u32);
    pass.dispatchWorkgroups(W / 4u32, H / 4u32, D / 4u32);
    pass.end();
  }
  encoder.copyTextureToBuffer(&values, &valuesBack);
  encoder.copyTextureToBuffer(&hashes, &hashesBack);
  encoder.copyTextureToBuffer(&colors, &colorsBack);
  encoder.copyTextureToBuffer(&doubled, &doubledBack);
  encoder.copyTextureToBuffer(&target, &pixels);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();

  // ---- The checks ----
  imm v = valuesBack.mappedRange();
  imm h = hashesBack.mappedRange();
  imm c = colorsBack.mappedRange();
  imm d = doubledBack.mappedRange();
  mut badDoubled = 0u32;
  mut badValues = 0u32;
  mut badHashes = 0u32;
  mut badColors = 0u32;
  mut z = 0u32;
  while z < D {
    mut y = 0u32;
    while y < H {
      mut x = 0u32;
      while x < W {
        imm at = usize.from(x + W * y + W * H * z);
        if float(d, at) != f32.from(at) + 1. { badDoubled = badDoubled + 1u32; }
        if float(v, at) != f32.from(x + 16u32 * y + 128u32 * z) + 1000. { badValues = badValues + 1u32; }
        if word(h, at) != (x * 73856093u32) ^ (y * 19349663u32) ^ (z * 83492791u32) { badHashes = badHashes + 1u32; }
        imm texel = (c + at * 8usize) as *u16;
        if half(*texel) != f32.from(x) or half(*(texel + 1usize)) != f32.from(y) or half(*(texel + 2usize)) != f32.from(z)
            or half(*(texel + 3usize)) != 0.5 {
          badColors = badColors + 1u32;
        }
        x = x + 1u32;
      }
      y = y + 1u32;
    }
    z = z + 1u32;
  }
  expectUInt(u64.from(badDoubled), 0u64, "every texel written by writeTexture, read and written back doubled");
  expectUInt(u64.from(badValues), 0u64, "every r32float texel of the second compute pass");
  expectUInt(u64.from(badHashes), 0u64, "every r32uint texel");
  expectUInt(u64.from(badColors), 0u64, "every rgba16float texel");
  imm px = pixels.mappedRange();
  mut badPixels = 0u32;
  mut y = 0u32;
  while y < H {
    mut x = 0u32;
    while x < W {
      imm at = px + usize.from((x + W * y) * 4u32);
      if u32.from(*at) != x + 16u32 * y { badPixels = badPixels + 1u32; }
      x = x + 1u32;
    }
    y = y + 1u32;
  }
  expectUInt(u64.from(badPixels), 0u64, "every pixel sampled from the 3-D texture the first compute pass wrote");
  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}

