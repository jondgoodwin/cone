// Textures drawn into and sampled, of several levels and layers, in half
// floats, seen as a cube: what the render package's HDR frame, bloom chain
// and environment cubes need.
//
// 1. An rgba16float texture 8 x 8, 4 levels, 6 layers, made to be both drawn
//    into and sampled. Each face f of each level l is drawn into through a
//    2-D view of that one face and level, with the value 10 f + l + 2.5
//    (more than 1: a half float keeps it, exactly, where an 8-bit target
//    would clamp it to 1).
// 2. A cube view of all of it is sampled by a second pass into a 64 x 64
//    rgba8unorm target: block (f, l) reads face f's middle at level l,
//    nearest, and writes a sixty-fourth of it, so it is stored as
//    (10 f + l + 2.5) / 64 x 255, rounded. Every face of every level is
//    checked, to within 1.
// 3. A view asked for twice is made once.
//
// Only a failure prints. It needs a GPU driver with Vulkan 1.3 and SDL3.dll;
// with the Vulkan SDK, validation and synchronization validation are on,
// and must say nothing.

mod levels;

import testing use *;
import geomath use *;
import gpu use *;

fn main() i32 {
  mut instance = Instance.create("levels");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, POWER_PREFERENCE_HIGH_PERFORMANCE);
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");

  imm cubeDesc = new TextureDescriptor(8u32, 8u32, TEXTURE_FORMAT_RGBA16_FLOAT,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_TEXTURE_BINDING, 4u32, 6u32);
  mut cube = device.createTexture(&cubeDesc);
  require(cube.isValid(), "a cube of half floats, four levels, drawn into and sampled");
  imm targetDesc = new TextureDescriptor(64u32, 64u32, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut target = device.createTexture(&targetDesc);
  mut readback = device.createBuffer(16384u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  imm p = readback.mappedRange();

  mut shader = device.createShaderModule(&LEVELS_SPIRV);
  imm attributes = [new VertexAttribute(VERTEX_FORMAT_FLOAT32, 0u64, 0u32)];
  imm buffers = [new VertexBufferLayout(arrayStride: 4u64, attributes: &attributes)];
  mut fillLayout = device.createEmptyPipelineLayout(16u32);
  imm fillDesc = new RenderPipelineDescriptor(layout: &fillLayout, vertexModule: &shader, vertexEntryPoint: "fullscreenMain",
    buffers: &buffers[..0], fragmentModule: &shader, fragmentEntryPoint: "fillMain",
    colorFormat: TEXTURE_FORMAT_RGBA16_FLOAT);
  mut fillPipeline = device.createRenderPipeline(&fillDesc);
  imm entries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_TEXTURE,
      viewDimension: TEXTURE_VIEW_DIMENSION_CUBE),
    new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_FRAGMENT, kind: BINDING_KIND_SAMPLER)];
  mut groupLayout = device.createBindGroupLayout(&entries);
  imm groupLayouts = [&groupLayout];
  mut readLayout = device.createPipelineLayout(&groupLayouts, 0u32);
  imm readDesc = new RenderPipelineDescriptor(layout: &readLayout, vertexModule: &shader, vertexEntryPoint: "fullscreenMain",
    buffers: &buffers[..0], fragmentModule: &shader, fragmentEntryPoint: "readMain",
    colorFormat: TEXTURE_FORMAT_RGBA8_UNORM);
  mut readPipeline = device.createRenderPipeline(&readDesc);
  imm samplerDesc = new SamplerDescriptor(magFilter: FILTER_MODE_NEAREST, minFilter: FILTER_MODE_NEAREST,
    addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
    addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
  mut sampler = device.createSampler(&samplerDesc);
  imm wholeDesc = new TextureViewDescriptor(dimension: TEXTURE_VIEW_DIMENSION_CUBE);
  imm whole = cube.createViewWith(&wholeDesc);
  require(whole.isValid(), "a cube view of every level");
  imm groupEntries = [BindGroupEntry.texture(0u32, &whole), BindGroupEntry.sampler(1u32, &sampler)];
  mut group = device.createBindGroup(&groupLayout, &groupEntries);
  require(fillPipeline.isValid() and readPipeline.isValid() and group.isValid(), "the pipelines and the bind group");

  // ---- 1. Each face of each level drawn ----
  mut encoder = device.createCommandEncoder();
  mut level = 0u32;
  while level < 4u32 {
    mut face = 0u32;
    while face < 6u32 {
      imm viewDesc = new TextureViewDescriptor(baseMipLevel: level, mipLevelCount: 1u32, baseArrayLayer: face,
        arrayLayerCount: 1u32);
      imm view = cube.createViewWith(&viewDesc);
      expectUInt(u64.from(view.width), u64.from(8u32 >> level), "a level's view is the level's size");
      imm attachment = new RenderPassColorAttachment(view: view, clearValue: new Color(0., 0., 0., 1.));
      mut pass = encoder.beginRenderPass(&attachment);
      pass.setPipeline(&fillPipeline);
      imm data Array[f32, 4] = [10. * f32.from(face) + f32.from(level) + 2.5, 0., 0., 0.];
      pass.setImmediates(0u32, &data as *u8, 16u32);
      pass.draw(3u32, 1u32, 0u32, 0u32);
      pass.end();
      face = face + 1u32;
    }
    level = level + 1u32;
  }

  // ---- 2. Read back through the cube view ----
  {
    imm attachment = new RenderPassColorAttachment(view: target.createView(), clearValue: new Color(0., 0., 0., 1.));
    mut pass = encoder.beginRenderPass(&attachment);
    pass.setPipeline(&readPipeline);
    pass.setBindGroup(0u32, &group);
    pass.draw(3u32, 1u32, 0u32, 0u32);
    pass.end();
  }
  encoder.copyTextureToBuffer(&target, &readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  level = 0u32;
  while level < 4u32 {
    mut face = 0u32;
    while face < 6u32 {
      imm x = usize.from(face) * 8usize + 4usize;
      imm y = usize.from(level) * 16usize + 8usize;
      imm got = f64.from(*(p + (y * 64usize + x) * 4usize));
      imm want = f64.from((10. * f32.from(face) + f32.from(level) + 2.5) / 64. * 255.);
      expectFloat(got, want, 1d, "a face of a level, drawn through its own view and read through the cube's");
      face = face + 1u32;
    }
    level = level + 1u32;
  }

  // ---- 3. A view asked for twice is made once ----
  imm again = cube.createViewWith(&wholeDesc);
  expectBool(again.backend.view.h == whole.backend.view.h, true, "the same view, asked for again");

  expectUInt(u64.from(failures()), 0u64, "no Vulkan call failed");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}

