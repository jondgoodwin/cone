  0x00000008u32, 0x000000f0u32, 0x000000e9u32, 0x000500b0u32, 0x0000001fu32, 0x000000f1u32,
  0x000000f0u32, 0x00000052u32, 0x000300f7u32, 0x000000f3u32, 0x00000000u32, 0x000400fau32,
  0x000000f1u32, 0x000000f3u32, 0x000000f2u32, 0x000200f8u32, 0x000000f2u32, 0x000200f9u32,
  0x00000108u32, 0x000200f8u32, 0x000000f3u32, 0x00050084u32, 0x00000008u32, 0x000000f4u32,
  0x00000099u32, 0x00000021u32, 0x00050080u32, 0x00000008u32, 0x000000f5u32, 0x000000f4u32,
  0x000000a3u32, 0x00050084u32, 0x00000008u32, 0x000000f6u32, 0x000000f5u32, 0x00000052u32,
  0x0004003du32, 0x00000008u32, 0x000000f7u32, 0x000000e9u32, 0x00050080u32, 0x00000008u32,
  0x000000f8u32, 0x000000f6u32, 0x000000f7u32, 0x00060041u32, 0x00000059u32, 0x000000f9u32,
  0x0000005eu32, 0x00000027u32, 0x000000f8u32, 0x0004003du32, 0x00000008u32, 0x000000fau32,
  0x000000f9u32, 0x00050084u32, 0x00000008u32, 0x000000fbu32, 0x000000a3u32, 0x00000052u32,
  0x00050080u32, 0x00000008u32, 0x000000fdu32, 0x000000fbu32, 0x000000f7u32, 0x00060041u32,
  0x00000059u32, 0x000000feu32, 0x00000064u32, 0x00000027u32, 0x000000fdu32, 0x0004003du32,
  0x00000008u32, 0x000000ffu32, 0x000000feu32, 0x0004003du32, 0x00000026u32, 0x00000100u32,
  0x000000e8u32, 0x00061162u32, 0x00000026u32, 0x00000101u32, 0x000000fau32, 0x000000ffu32,
  0x00000000u32, 0x00050080u32, 0x00000026u32, 0x00000102u32, 0x00000101u32, 0x00000100u32,
  0x000200f9u32, 0x00000103u32, 0x000200f8u32, 0x00000103u32, 0x000200f9u32, 0x00000104u32,
  0x000200f8u32, 0x00000104u32, 0x0004003du32, 0x00000008u32, 0x00000105u32, 0x000000e9u32,
  0x00050080u32, 0x00000008u32, 0x00000106u32, 0x00000105u32, 0x0000006du32, 0x0003003eu32,
  0x000000e8u32, 0x00000102u32, 0x0003003eu32, 0x000000e9u32, 0x00000106u32, 0x000200f9u32,
  0x00000107u32, 0x000200f8u32, 0x00000107u32, 0x000200f9u32, 0x000000ecu32, 0x000200f8u32,
  0x00000108u32, 0x0004003du32, 0x00000026u32, 0x00000109u32, 0x000000e8u32, 0x0004006fu32,
  0x00000005u32, 0x000000aeu32, 0x00000109u32, 0x00050085u32, 0x00000005u32, 0x000000afu32,
  0x000000aeu32, 0x000000abu32, 0x0004003du32, 0x00000005u32, 0x000000b0u32, 0x00000089u32,
  0x00050081u32, 0x00000005u32, 0x000000b1u32, 0x000000b0u32, 0x000000afu32, 0x000200f9u32,
  0x00000090u32, 0x000200f8u32, 0x00000090u32, 0x000200f9u32, 0x00000091u32, 0x000200f8u32,
  0x00000091u32, 0x0004003du32, 0x00000008u32, 0x000000b4u32, 0x0000008au32, 0x00050080u32,
  0x00000008u32, 0x000000b5u32, 0x000000b4u32, 0x000000b6u32, 0x0003003eu32, 0x00000089u32,
  0x000000b1u32, 0x0003003eu32, 0x0000008au32, 0x000000b5u32, 0x000200f9u32, 0x00000092u32,
  0x000200f8u32, 0x00000092u32, 0x000200f9u32, 0x0000008bu32, 0x000200f8u32, 0x00000094u32,
  0x0004003du32, 0x00000005u32, 0x000000bbu32, 0x00000089u32, 0x0006015eu32, 0x00000005u32,
  0x000000bcu32, 0x000000bdu32, 0x00000000u32, 0x000000bbu32, 0x0004003du32, 0x00000015u32,
  0x000000beu32, 0x0000009bu32, 0x00050051u32, 0x00000008u32, 0x000000bfu32, 0x000000beu32,
  0x00000000u32, 0x000500aau32, 0x0000001fu32, 0x000000c0u32, 0x000000bfu32, 0x0000001cu32,
  0x000300f7u32, 0x00000096u32, 0x00000000u32, 0x000400fau32, 0x000000c0u32, 0x00000095u32,
  0x00000096u32, 0x000200f8u32, 0x00000095u32, 0x00060041u32, 0x00000032u32, 0x000000c2u32,
  0x00000083u32, 0x00000027u32, 0x00000099u32, 0x0003003eu32, 0x000000c2u32, 0x000000bcu32,
  0x000200f9u32, 0x00000096u32, 0x000200f8u32, 0x00000096u32, 0x000100fdu32, 0x00010038u32
];
// spirv-end

fn yesNo(b bool) &str { if b { "yes" } else { "no" } }

fn main() i32 {
  let report = (libc.getenv("GPU_COMPUTE_REPORT") as usize) != 0usize;
  var instance = Instance.create("computefeatures");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  var none = Surface.none();
  var adapter = instance.requestAdapter(&none, preference());
  require(adapter.isValid(), "an adapter");

  // ---- 1. The query ----
  let has = adapter.computeCapabilities();
  let heaps = adapter.memoryHeaps();
  if report {
    printStr("adapter: "); printStr(adapter.name.view()); printStr(" (Vulkan "); printStr(adapter.backendVersion.view()); printStr(")\n");
    printStr("float16Arithmetic "); printStr(yesNo(has.float16Arithmetic));
    printStr(", storage16Bit "); printStr(yesNo(has.storage16Bit));
    printStr(", int16Arithmetic "); printStr(yesNo(has.int16Arithmetic)); printStr("\n");
    printStr("int8Arithmetic "); printStr(yesNo(has.int8Arithmetic));
    printStr(", storage8Bit "); printStr(yesNo(has.storage8Bit));
    printStr(", subgroupExtendedTypes "); printStr(yesNo(has.subgroupExtendedTypes)); printStr("\n");
    printStr("integerDotProduct "); printStr(yesNo(has.integerDotProduct));
    printStr(", accelerated: 4x8 packed signed "); printStr(yesNo(has.dot4x8PackedSignedAccelerated));
    printStr(", unsigned "); printStr(yesNo(has.dot4x8PackedUnsignedAccelerated));
    printStr(", mixed "); printStr(yesNo(has.dot4x8PackedMixedAccelerated));
    printStr(", 8-bit signed "); printStr(yesNo(has.dot8BitSignedAccelerated)); printStr("\n");
    printStr("subgroup size "); printUInt(u64.from(has.subgroupSize));
    printStr(" (range "); printUInt(u64.from(has.subgroupMinSize)); printStr(" to "); printUInt(u64.from(has.subgroupMaxSize));
    printStr("), stages "); printUInt(u64.from(has.subgroupStages));
    printStr(" (compute is "); printUInt(u64.from(SHADER_STAGE_COMPUTE)); printStr("), operations (bits) ");
    printUInt(u64.from(has.subgroupOperations)); printStr(", quad in all stages "); printStr(yesNo(has.subgroupQuadInAllStages));
    printStr("\n");
    printStr("maxBufferSize "); printUInt(has.maxBufferSize);
    printStr(", maxMemoryAllocationSize "); printUInt(has.maxMemoryAllocationSize);
    printStr(", maxStorageBufferRange "); printUInt(has.maxStorageBufferRange); printStr("\n");
    printStr("maxPerStageDescriptorStorageBuffers "); printUInt(u64.from(has.maxPerStageDescriptorStorageBuffers));
    printStr(", minStorageBufferOffsetAlignment "); printUInt(has.minStorageBufferOffsetAlignment);
    printStr(", maxMemoryAllocationCount "); printUInt(u64.from(has.maxMemoryAllocationCount)); printStr("\n");
    printStr("workgroup: invocations "); printUInt(u64.from(has.maxComputeWorkGroupInvocations));
    printStr(", size "); printUInt(u64.from(has.maxComputeWorkGroupSizeX)); printStr(" x ");
    printUInt(u64.from(has.maxComputeWorkGroupSizeY)); printStr(" x "); printUInt(u64.from(has.maxComputeWorkGroupSizeZ));
    printStr(", shared memory "); printUInt(u64.from(has.maxComputeSharedMemorySize)); printStr("\n");
    printStr("memory heaps: "); printUInt(u64.from(has.heapCount)); printStr(", device-local total ");
    printUInt(has.deviceLocalBytes); printStr(", largest device-local ");
    printUInt(has.largestDeviceLocalHeap); printStr(", other ");
    printUInt(has.otherHeapBytes); printStr("\n");
    var h = 0usize;
    while h < heaps.len() {
      printStr("  heap "); printUInt(u64.from(h)); printStr(": "); printUInt(heaps[h].bytes); printStr(" bytes, ");
      printStr(if heaps[h].deviceLocal { "device-local\n" } else { "not device-local\n" });
      h = h + 1usize;
    }
  }
  expect(has.subgroupSize >= 1u32 && (has.subgroupSize & (has.subgroupSize - 1u32)) == 0u32, "a power-of-two subgroup size");
  expect(has.subgroupMinSize <= has.subgroupSize && has.subgroupSize <= has.subgroupMaxSize, "the subgroup size is in its range");
  expect(has.maxBufferSize >= MAX_STORAGE_BUFFER_BINDING_SIZE && has.maxStorageBufferRange >= MAX_STORAGE_BUFFER_BINDING_SIZE,
    "buffers can be as large as WebGPU's default binding");
  expect(has.maxMemoryAllocationSize >= MAX_STORAGE_BUFFER_BINDING_SIZE, "an allocation can be that large");
  expect(has.deviceLocalBytes > 0u64 && has.largestDeviceLocalHeap > 0u64 && has.heapCount == u32.from(heaps.len()),
    "the memory heaps are counted, and some are the GPU's own");
  expect(has.maxPerStageDescriptorStorageBuffers >= MAX_STORAGE_BUFFERS_PER_SHADER_STAGE
    && has.maxComputeWorkGroupInvocations >= MAX_COMPUTE_INVOCATIONS_PER_WORKGROUP, "compute limits at least WebGPU's");
  expectBool(has.integerDotProduct || !has.dot4x8PackedSignedAccelerated, true, "dot products are accelerated only where they exist");
  expectBool(has.hasSubgroupOps(SUBGROUP_OP_BASIC), (has.subgroupStages & SHADER_STAGE_COMPUTE) != 0u32
    && (has.subgroupOperations & SUBGROUP_OP_BASIC) != 0u32, "hasSubgroupOps says what the bits say");
  expectBool(has.hasSubgroupOps(0u32), (has.subgroupStages & SHADER_STAGE_COMPUTE) != 0u32, "no operations asked: compute has subgroups or not");

  // ---- 2. A drawing device enables none of it ----
  {
    var plain = adapter.requestDevice();
    require(plain.isValid(), "a drawing device");
    let c = plain.compute;
    expect(!c.float16Arithmetic && !c.storage16Bit && !c.int16Arithmetic && !c.int8Arithmetic && !c.storage8Bit
      && !c.subgroupExtendedTypes && !c.integerDotProduct, "a drawing device enables none of the compute features");
    expectUInt(c.maxBufferSize, has.maxBufferSize, "but its numbers are the GPU's");
    expectUInt(plain.maxStorageBufferBindingSize, 134217728u64, "and its binding limit WebGPU's 128 MiB");
    expectUInt(u64.from(plain.maxStorageBuffersPerStage), 8u64, "and its storage buffers a stage 8");
    if has.float16Arithmetic {
      expectUInt(u64.from(failures()), 0u64, "nothing has failed before the refusal");
      let refused = plain.createShaderModule(&CFHALF_SPIRV);
      expectBool(refused.isValid(), false, "a shader needing 16-bit floats is refused by a drawing device");
      expectUInt(u64.from(failures()), 1u64, "with one failure");
    } else {
      expect(true, "no 16-bit floats on this GPU");
      expect(true, "so no refusal to count");
      expect(true, "(skipped)");
    }
  }
  let refusals = failures();

  // ---- 3. What a compute device enables ----
  {
    let onlyHalf = new ComputeRequest(float16: true);
    var d = adapter.requestComputeDevice(&onlyHalf);
    require(d.isValid(), "a device asking for 16-bit floats");
    let c = d.compute;
    expectBool(c.float16Arithmetic, has.float16Arithmetic, "16-bit arithmetic enabled if present");
    expectBool(c.storage16Bit, has.storage16Bit, "16-bit storage enabled if present");
    expect(!c.int8Arithmetic && !c.storage8Bit && !c.integerDotProduct && !c.int16Arithmetic && !c.subgroupExtendedTypes,
      "and nothing else");
    expectUInt(d.maxStorageBufferBindingSize, 134217728u64, "without largeBuffers the limit stays at 128 MiB");
  }
  {
    let everything = ComputeRequest.all();
    var d = adapter.requestComputeDevice(&everything);
    require(d.isValid(), "a device asking for everything");
    let c = d.compute;
    expect(c.float16Arithmetic == has.float16Arithmetic && c.storage16Bit == has.storage16Bit
      && c.int16Arithmetic == has.int16Arithmetic && c.int8Arithmetic == has.int8Arithmetic
      && c.storage8Bit == has.storage8Bit && c.subgroupExtendedTypes == has.subgroupExtendedTypes
      && c.integerDotProduct == has.integerDotProduct, "everything present is enabled");
    expectUInt(d.maxStorageBufferBindingSize, has.maxStorageBufferRange, "largeBuffers: the binding limit is the GPU's maxStorageBufferRange");
    let perStage = if has.maxPerStageDescriptorStorageBuffers > 64u32 { 64u32 } else { has.maxPerStageDescriptorStorageBuffers };
    expectUInt(u64.from(d.maxStorageBuffersPerStage), u64.from(perStage), "and the storage buffers a stage the GPU's (at most 64)");

    // ---- 5. A buffer larger than the GPU allows ----
    let before = failures();
    let tooBig = d.createBuffer(has.maxBufferSize + 1u64, BUFFER_USAGE_STORAGE);
    expectBool(tooBig.isValid(), false, "a buffer over maxBufferSize is not made");
    expectUInt(u64.from(failures() - before), 1u64, "and fails once");
    // A layout seeing more storage buffers than a drawing device allows is made by this one
    var wide = List[BindGroupLayoutEntry].empty();
    var i = 0u32;
    while i < 12u32 {
      wide.push(new BindGroupLayoutEntry(binding: i, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE));
      i = i + 1u32;
    }
    var wideLayout = d.createBindGroupLayout(wide.view());
    let wideLayouts = [&wideLayout];
    let wideBefore = failures();
    let widePipeline = d.createPipelineLayout(&wideLayouts, 0u32);
    expectBool(widePipeline.isValid(), perStage >= 12u32, "a layout of 12 storage buffers is made when the GPU allows it");
    expectUInt(u64.from(failures() - wideBefore), if perStage >= 12u32 { 0u64 } else { 1u64 }, "and refused when it does not");
  }
  let planned = failures();

  // ---- 4. The features at work ----
  var device = adapter.requestComputeDevice(&ComputeRequest.all());
  require(device.isValid(), "a compute device");
  let c = device.compute;
  var readback = device.createBuffer(65536u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  var r = readback.mappedRange();
  require((r as usize) != 0usize, "a read-back buffer");
  var seed = 20261014u64;

  // cfhalf: 256 elements
  {
    let ran = c.float16Arithmetic && c.storage16Bit;
    var bad = 0u32;
    if ran {
      var a = new Array[u16, 2048] <- fill 0u16;
      var b = new Array[u16, 256] <- fill 0u16;
      var i = 0usize;
      while i < 2048usize {
        a[i] = u16.from(toHalf(f64.from(i32.from(next(&mut seed) % 2001u64) - 1000) / 128.0));
        i = i + 1usize;
      }
      i = 0usize;
      while i < 256usize {
        b[i] = u16.from(toHalf(f64.from(i32.from(next(&mut seed) % 2001u64) - 1000) / 128.0));
        i = i + 1usize;
      }
      var ba = storage(&mut device, 4096u64);
      var bb = storage(&mut device, 512u64);
      var out = storage(&mut device, 1024u64);
      device.queue.writeBuffer(&ba, 0u64, &a as *u8, 4096u64);
      device.queue.writeBuffer(&bb, 0u64, &b as *u8, 512u64);
      var shader = device.createShaderModule(&CFHALF_SPIRV);
      require(shader.isValid(), "the half-precision shader on a device with 16-bit floats");
      let bufs = [&ba, &bb, &out];
      // multiply
      r = run(&mut device, &shader, "halfMul", &bufs, 4u32, &out, 1024u64, &readback);
      i = 0usize;
      while i < 256usize {
        let want = f32.from(halve(fromHalf(u32.from(a[i])) * fromHalf(u32.from(b[i]))));
        if f32At(r, i) != want { bad = bad + 1u32; }
        i = i + 1usize;
      }
      // add
      r = run(&mut device, &shader, "halfAdd", &bufs, 4u32, &out, 1024u64, &readback);
      i = 0usize;
      while i < 256usize {
        let want = f32.from(halve(fromHalf(u32.from(a[i])) + fromHalf(u32.from(b[i]))));
        if f32At(r, i) != want { bad = bad + 1u32; }
        i = i + 1usize;
      }
      // eight adds in a row, each rounded to half
      r = run(&mut device, &shader, "halfSum", &bufs, 4u32, &out, 256u64 * 4u64, &readback);
      i = 0usize;
      while i < 256usize {
        var s = 0.0;
        var k = 0usize;
        while k < 8usize {
          s = halve(s + fromHalf(u32.from(a[i * 8usize + k])));
          k = k + 1usize;
        }
        if f32At(r, i) != f32.from(s) { bad = bad + 1u32; }
        i = i + 1usize;
      }
    } else {
      expect(true, "no 16-bit floats in storage and arithmetic on this GPU: skipped");
    }
    expectUInt(u64.from(bad), 0u64, "16-bit multiply, add and eight chained adds: every answer the CPU twin's, bit for bit");
  }

  // cfbytes: 256 bytes
  {
    let ran = c.int8Arithmetic && c.storage8Bit;
    var bad = 0u32;
    if ran {
      var bytes = new Array[u8, 256] <- fill 0u8;
      var i = 0usize;
      while i < 256usize {
        bytes[i] = u8.from(next(&mut seed) % 256u64);
        i = i + 1usize;
      }
      var input = storage(&mut device, 256u64);
      var input2 = storage(&mut device, 256u64);
      var out = storage(&mut device, 1024u64);
      device.queue.writeBuffer(&input, 0u64, &bytes as *u8, 256u64);
      device.queue.writeBuffer(&input2, 0u64, &bytes as *u8, 256u64);
      var shader = device.createShaderModule(&CFBYTES_SPIRV);
      require(shader.isValid(), "the 8-bit shader on a device with 8-bit storage");
      let bufs = [&input, &input2, &out];
      r = run(&mut device, &shader, "byteMain", &bufs, 4u32, &out, 1024u64, &readback);
      i = 0usize;
      while i < 256usize {
        let s = i32.from(bytes[i]) - if bytes[i] >= 128u8 { 256 } else { 0 };
        let want = 3 * s + i32.from(bytes[i ^ 1usize]);
        if i32.from(word(r, i)) != want { bad = bad + 1u32; }
        i = i + 1usize;
      }
    } else {
      expect(true, "no 8-bit integers in storage and arithmetic on this GPU: skipped");
    }
    expectUInt(u64.from(bad), 0u64, "bytes read signed and unsigned from storage buffers: every answer the CPU twin's");
  }

  // cfdot: 256 words each
  {
    var bad = 0u32;
    if c.integerDotProduct {
      var x = new Array[u32, 256] <- fill 0u32;
      var y = new Array[u32, 256] <- fill 0u32;
      var i = 0usize;
      while i < 256usize {
        x[i] = u32.from(next(&mut seed)) * 2u32 + u32.from(next(&mut seed) % 2u64);
        y[i] = u32.from(next(&mut seed)) * 2u32 + u32.from(next(&mut seed) % 2u64);
        i = i + 1usize;
      }
      var bufX = storage(&mut device, 1024u64);
      var bufY = storage(&mut device, 1024u64);
      var out = storage(&mut device, 1024u64);
      device.queue.writeBuffer(&bufX, 0u64, &x as *u8, 1024u64);
      device.queue.writeBuffer(&bufY, 0u64, &y as *u8, 1024u64);
      var shader = device.createShaderModule(&CFDOT_SPIRV);
      require(shader.isValid(), "the dot product shader on a device with it");
      let bufs = [&bufX, &bufY, &out];
      r = run(&mut device, &shader, "dotSigned", &bufs, 4u32, &out, 1024u64, &readback);
      i = 0usize;
      while i < 256usize {
        var want = i32.from(i);
        var k = 0u32;
        while k < 4u32 {
          want = want + signedByte(x[i], k) * signedByte(y[i], k);
          k = k + 1u32;
        }
        if i32.from(word(r, i)) != want { bad = bad + 1u32; }
        i = i + 1usize;
      }
      r = run(&mut device, &shader, "dotUnsigned", &bufs, 4u32, &out, 1024u64, &readback);
      i = 0usize;
      while i < 256usize {
        var want = i32.from(i);
        var k = 0u32;
        while k < 4u32 {
          want = want + unsignedByte(x[i], k) * unsignedByte(y[i], k);
          k = k + 1u32;
        }
        if i32.from(word(r, i)) != want { bad = bad + 1u32; }
        i = i + 1usize;
      }
    } else {
      expect(true, "no integer dot product on this GPU: skipped");
    }
    expectUInt(u64.from(bad), 0u64, "the packed 4 x 8-bit dot product, signed and unsigned: every answer the CPU twin's");
  }

  // cfwave: one workgroup of 64, 7 words each
  {
    var bad = 0u32;
    if c.hasSubgroupOps(SUBGROUP_OP_BASIC | SUBGROUP_OP_ARITHMETIC | SUBGROUP_OP_BALLOT | SUBGROUP_OP_SHUFFLE) {
      var v = new Array[u32, 64] <- fill 0u32;
      var i = 0usize;
      while i < 64usize {
        v[i] = u32.from(next(&mut seed) % 1000u64);
        i = i + 1usize;
      }
      var bv = storage(&mut device, 256u64);
      var out = storage(&mut device, 64u64 * 7u64 * 4u64);
      device.queue.writeBuffer(&bv, 0u64, &v as *u8, 256u64);
      var shader = device.createShaderModule(&CFWAVE_SPIRV);
      require(shader.isValid(), "the subgroup shader");
      let bufs = [&bv, &out];
      r = run(&mut device, &shader, "waveMain", &bufs, 1u32, &out, 64u64 * 7u64 * 4u64, &readback);
      i = 0usize;
      while i < 64usize {
        let size = usize.from(word(r, i * 7usize));
        let lane = usize.from(word(r, i * 7usize + 1usize));
        if size != usize.from(c.subgroupSize) || lane != i % size { bad = bad + 1u32; }
        // The subgroup this invocation is in: its lanes, clipped to the workgroup
        let first = i - lane;
        var last = first + size;
        if last > 64usize { last = 64usize; }
        var sum = 0u32;
        var before = 0u32;
        var biggest = 0u32;
        var odd = 0u32;
        var j = first;
        while j < last {
          sum = sum + v[j];
          if j < i { before = before + v[j]; }
          if v[j] > biggest { biggest = v[j]; }
          if v[j] % 2u32 == 1u32 { odd = odd + 1u32; }
          j = j + 1usize;
        }
        if word(r, i * 7usize + 2usize) != sum || word(r, i * 7usize + 3usize) != before
            || word(r, i * 7usize + 4usize) != biggest || word(r, i * 7usize + 5usize) != odd { bad = bad + 1u32; }
        if size > 3usize && word(r, i * 7usize + 6usize) != v[first + 3usize] { bad = bad + 1u32; }
        i = i + 1usize;
      }
    } else {
      expect(true, "no subgroup operations in compute on this GPU: skipped");
    }
    expectUInt(u64.from(bad), 0u64, "subgroup size, lane, sum, prefix sum, maximum, ballot count and shuffle: every answer the CPU twin's");
  }

  // cfquant: 128 rows of 64 blocks of 32 weights
  {
    var badRows = 0u32;
    var badSubgroup = 0u32;
    let rows = 128usize;
    if c.float16Arithmetic && c.storage16Bit && c.integerDotProduct {
      var weights = new Array[u32, 65536] <- fill 0u32;       // rows * 64 blocks * 8 words
      var wscale = new Array[u16, 8192] <- fill 0u16;         // rows * 64 blocks
      var acts = new Array[u32, 512] <- fill 0u32;            // 64 blocks * 8 words
      var ascale = new Array[f32, 64] <- fill 0f;
      var i = 0usize;
      while i < 65536usize {
        var w = 0u32;
        var k = 0u32;
        while k < 4u32 {
          let q = i32.from(next(&mut seed) % 255u64) - 127;       // -127 to 127
          w = w | ((u32.from(q + 256) & 255u32) << (8u32 * k));
          k = k + 1u32;
        }
        weights[i] = w;
        i = i + 1usize;
      }
      i = 0usize;
      while i < 512usize {
        var w = 0u32;
        var k = 0u32;
        while k < 4u32 {
          let q = i32.from(next(&mut seed) % 255u64) - 127;
          w = w | ((u32.from(q + 256) & 255u32) << (8u32 * k));
          k = k + 1u32;
        }
        acts[i] = w;
        i = i + 1usize;
      }
      i = 0usize;
      while i < 8192usize {
        wscale[i] = u16.from(toHalf(f64.from(i32.from(next(&mut seed) % 15u64) + 1) / 256.0));
        i = i + 1usize;
      }
      i = 0usize;
      while i < 64usize {
        ascale[i] = f32.from(i32.from(next(&mut seed) % 9u64) + 1) / 128f;
        i = i + 1usize;
      }
      var bw = storage(&mut device, 262144u64);
      var bws = storage(&mut device, 16384u64);
      var ba = storage(&mut device, 2048u64);
      var bas = storage(&mut device, 256u64);
      var out = storage(&mut device, 512u64);
      device.queue.writeBuffer(&bw, 0u64, &weights as *u8, 262144u64);
      device.queue.writeBuffer(&bws, 0u64, &wscale as *u8, 16384u64);
      device.queue.writeBuffer(&ba, 0u64, &acts as *u8, 2048u64);
      device.queue.writeBuffer(&bas, 0u64, &ascale as *u8, 256u64);
      var shader = device.createShaderModule(&CFQUANT_SPIRV);
      require(shader.isValid(), "the quantised matrix-vector shader");
      let bufs = [&bw, &bws, &ba, &bas, &out];

      // The twin: per block the exact integer sum, scaled in float, added in order
      var want = new Array[f32, 128] <- fill 0f;
      var reference = new Array[f64, 128] <- fill 0.0;
      var magnitude = new Array[f64, 128] <- fill 0.0;
      var row = 0usize;
      while row < rows {
        var acc = 0f;
        var exact = 0.0;
        var size = 0.0;
        var b = 0usize;
        while b < 64usize {
          var s = 0;
          var j = 0usize;
          while j < 8usize {
            let wv = weights[(row * 64usize + b) * 8usize + j];
            let av = acts[b * 8usize + j];
            var k = 0u32;
            while k < 4u32 {
              s = s + signedByte(wv, k) * signedByte(av, k);
              k = k + 1u32;
            }
            j = j + 1usize;
          }
          let scale = f32.from(fromHalf(u32.from(wscale[row * 64usize + b]))) * ascale[b];
          acc = acc + f32.from(s) * scale;
          let term = f64.from(s) * f64.from(scale);
          exact = exact + term;
          size = size + (if term < 0.0 { 0.0 - term } else { term });
          b = b + 1usize;
        }
        want[row] = acc;
        reference[row] = exact;
        magnitude[row] = size;
        row = row + 1usize;
      }

      r = run(&mut device, &shader, "q8Rows", &bufs, 2u32, &out, 512u64, &readback);
      row = 0usize;
      while row < rows {
        if f32At(r, row) != want[row] { badRows = badRows + 1u32; }
        row = row + 1usize;
      }
      if c.hasSubgroupOps(SUBGROUP_OP_ARITHMETIC) && c.subgroupSize >= 32u32 {
        r = run(&mut device, &shader, "q8Subgroup", &bufs, 128u32, &out, 512u64, &readback);
        row = 0usize;
        while row < rows {
          let got = f64.from(f32At(r, row));
          let err = if got > reference[row] { got - reference[row] } else { reference[row] - got };
          if err > 0.00001 * magnitude[row] + 0.000001 { badSubgroup = badSubgroup + 1u32; }
          row = row + 1usize;
        }
      }
    } else {
      expect(true, "no 16-bit floats with the dot product on this GPU: skipped");
    }
    expectUInt(u64.from(badRows), 0u64, "the quantised matrix-vector product, a row an invocation: every row the CPU twin's, bit for bit");
    expectUInt(u64.from(badSubgroup), 0u64, "and a row a subgroup: every row within a float tolerance of the twin's");
  }

  expectUInt(u64.from(failures()), u64.from(planned), "no failure beyond the refusals the test provoked");
  expectUInt(u64.from(refusals), 1u64 - (if has.float16Arithmetic { 0u64 } else { 1u64 }), "the drawing device's refusal was the first");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done()
}
