// The compute features of the gpu package (features.cone) on a real GPU, with
// no window. Only a failure prints; with GPU_COMPUTE_REPORT set it also prints
// everything the GPU offers (the numbers the PR reports). A check the GPU
// cannot run (a feature it lacks) counts as passed, so the output is the same
// on every GPU, and the report says which ran.
//
// 1. The query: 'adapter.computeCapabilities()' answers what the GPU offers,
//    and its numbers are sane (a power-of-two subgroup size, a device-local
//    heap, buffers larger than WebGPU's default limits).
// 2. A drawing device ('requestDevice') enables none of it: its
//    'compute' flags are false, its limits are WebGPU's (128 MiB, 8 buffers),
//    and a shader that needs 16-bit floats is refused at 'createShaderModule',
//    once, naming the feature.
// 3. 'requestComputeDevice' enables what is asked for and present, and no
//    more: a request for 16-bit floats alone enables those and not 8-bit
//    storage; one for everything enables everything the GPU has; largeBuffers
//    lifts the two limits to the GPU's own.
// 4. The features at work, each kernel's answers checked against its CPU twin
//    (the same arithmetic written in Cone: half-precision rounded after every
//    operation, bytes widened with their sign, the dot product summed in
//    integers, subgroups grouped by the size and lane the GPU reports):
//    - cfhalf.slang: half multiply, half add, and eight half adds in a row;
//    - cfbytes.slang: signed and unsigned bytes read from storage buffers;
//    - cfdot.slang: the packed 4 x 8-bit integer dot product, signed and unsigned;
//    - cfwave.slang: a subgroup's size, lane, sum, prefix sum, maximum, ballot
//      count and a shuffle;
//    - cfquant.slang: a Q8_0-style quantised matrix-vector product (8-bit
//      weights with half scales, int dot product): one invocation a row (bit
//      for bit the twin's answer) and one subgroup a row (the twin's within a
//      float tolerance, the sum being in another order).
// 5. 'createBuffer' refuses a buffer larger than the GPU's maxBufferSize,
//    once, and makes none.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.dll (which loads Vulkan); with
// the Vulkan SDK, validation and synchronization validation are on, and must say
// nothing. GPU_POWER_PREFERENCE=low-power tests the integrated GPU where there
// are two.

mod computefeatures;

import testing use *;
import stdio use *;
import libc;
import gpu use *;
import collections use List;

// The power preference GPU_POWER_PREFERENCE asks for
fn preference() u32 {
  let env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize && libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { return POWER_PREFERENCE_LOW_POWER; }
  POWER_PREFERENCE_HIGH_PERFORMANCE
}

// ---- Half-precision floats, written in Cone ----

// 2 to the power 'e', exactly
fn pow2(e i32) f64 {
  var r = 1.0;
  var k = e;
  while k > 0 { r = r * 2.0; k = k - 1; }
  while k < 0 { r = r / 2.0; k = k + 1; }
  r
}

// 'v' (not negative) rounded to the nearest whole number, a tie to the even one
fn roundEven(v f64) u32 {
  let t = u32.from(v);
  let d = v - f64.from(t);
  if d > 0.5 { return t + 1u32; }
  if d < 0.5 { return t; }
  if t % 2u32 == 0u32 { t } else { t + 1u32 }
}

// The half-precision bit pattern nearest 'x', ties to even (the rounding the GPU does for each operation), for
// the magnitudes the test uses: no NaN, infinities past 65520
fn toHalf(x f64) u32 {
  var sign = 0u32;
  var a = x;
  if a < 0.0 {
    sign = 0x8000u32;
    a = 0.0 - a;
  }
  if a == 0.0 { return sign; }
  if a >= 65520.0 { return sign | 0x7C00u32; }
  var e = 0;
  var m = a;
  while m >= 2.0 {
    m = m / 2.0;
    e = e + 1;
  }
  while m < 1.0 {
    m = m * 2.0;
    e = e - 1;
  }
  if e < -14 {
    // Below the smallest normal: whole units of 2^-24
    return sign | roundEven(a * 16777216.0);
  }
  // A mantissa that rounds up to 1024 carries into the exponent, which is what adding it does
  sign | ((u32.from(e + 15) << 10u32) + roundEven((m - 1.0) * 1024.0))
}

// The value of a half-precision bit pattern
fn fromHalf(h u32) f64 {
  let s = if (h & 0x8000u32) != 0u32 { -1.0 } else { 1.0 };
  let e = i32.from((h >> 10u32) & 31u32);
  let m = f64.from(h & 1023u32);
  if e == 0 { return s * m * pow2(-24); }
  s * (1.0 + m / 1024.0) * pow2(e - 15)
}

// The half nearest 'x', as a value
fn halve(x f64) f64 { fromHalf(toHalf(x)) }

// ---- Data ----

// The next number of a small linear congruential generator (31 bits)
fn next(state &mut u64) u64 {
  *state = (*state * 1103515245u64 + 12345u64) % 2147483648u64;
  *state
}

fn signedByte(w u32, k u32) i32 {
  let v = i32.from((w >> (8u32 * k)) & 255u32);
  if v >= 128 { v - 256 } else { v }
}

fn unsignedByte(w u32, k u32) i32 { i32.from((w >> (8u32 * k)) & 255u32) }

// ---- Running a kernel ----

// Dispatch 'entry' of 'shader' over 'buffers' (bindings 0, 1, ...; all storage) in 'groups' workgroups, copy
// 'bytes' of 'out' into 'readback' (a buffer the CPU maps), and wait for the GPU; the bytes, read through the
// pointer it answers
fn run(device &mut Device, shader &ShaderModule, entry &str, buffers &Array[&Buffer], groups u32, out &Buffer,
    bytes u64, readback &Buffer) *u8 {
  var layoutEntries = List[BindGroupLayoutEntry].empty();
  var groupEntries = List[BindGroupEntry].empty();
  var i = 0usize;
  while i < buffers.len {
    layoutEntries.push(new BindGroupLayoutEntry(binding: u32.from(i), visibility: SHADER_STAGE_COMPUTE,
      bufferType: BUFFER_BINDING_TYPE_STORAGE));
    groupEntries.push(BindGroupEntry.buffer(u32.from(i), buffers[i]));
    i = i + 1usize;
  }
  var groupLayout = device.createBindGroupLayout(layoutEntries.view());
  let groupLayouts = [&groupLayout];
  var layout = device.createPipelineLayout(&groupLayouts, 0u32);
  let desc = new ComputePipelineDescriptor(layout: &layout, module: shader, entryPoint: entry);
  var pipeline = device.createComputePipeline(&desc);
  var group = device.createBindGroup(&groupLayout, groupEntries.view());
  require(pipeline.isValid() && group.isValid(), "a compute pipeline and its bind group");
  var encoder = device.createCommandEncoder();
  {
    var pass = encoder.beginComputePass();
    pass.setPipeline(&pipeline);
    pass.setBindGroup(0u32, &group);
    pass.dispatchWorkgroups(groups);
    pass.end();
  }
  encoder.copyBufferToBuffer(out, 0u64, readback, 0u64, bytes);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  readback.mappedRange()
}

fn storage(device &mut Device, bytes u64) Buffer {
  device.createBuffer(bytes, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC)
}

fn word(p *u8, i usize) u32 { *((p + i * 4usize) as *u32) }
fn f32At(p *u8, i usize) f32 { *((p + i * 4usize) as *f32) }

