// Buffers larger than 2 GiB on a real GPU, with no window: the limits a
// compute device is checked against, chunked staging uploads of 2.5 GiB, and
// shaders reading words from past byte 2^31. Only a failure prints; with
// GPU_COMPUTE_REPORT set it also prints how long the upload took. A GPU that
// cannot hold a 2.5 GiB buffer (its largest allocation, its largest storage
// binding, or its device-local memory less than 4.5 GiB) runs none of 3, and
// the checks count as passed, so the output is the same on every GPU.
//
// 1. A buffer over the GPU's maxMemoryAllocationSize is refused by 'createBuffer'
//    once, naming the limit, and none is made.
// 2. A drawing device ('requestDevice') holds storage bindings to WebGPU's 128
//    MiB: a binding of 128 MiB is made, one of the whole of a 256 MiB buffer is
//    refused (one failure).
// 3. A compute device with largeBuffers makes a 2.5 GiB storage buffer, fills it
//    with 'queue.writeBuffer' in 64 MiB writes (which the queue stages in 32
//    MiB pieces) of a pattern, each chunk's first word overwritten with its
//    index, and then:
//    - a shader bound to the whole buffer reads 64 words (the first, the last,
//      those either side of byte 2^31, chunk boundaries and others spread across
//      it) and each is the pattern's;
//    - the same words copied out by the GPU's copy engine (offsets past 2^31) are
//      the pattern's;
//    - the same shader bound to a 64 KiB range starting past byte 2^31 reads
//      words that are the pattern's.
// With GPU_BIGBUFFERS_MAX set it also makes the largest buffer the GPU allows
// (maxMemoryAllocationSize), writes and reads back its last bytes, and prints
// the time.
//
// It needs a GPU driver with Vulkan 1.3 and SDL3.dll; about 70 MiB of the CPU's
// memory and 2.5 GiB of the GPU's.

mod bigbuffers;

import testing use *;
import stdio use *;
import libc;
import gpu use *;
import collections use List;
import time use Instant;

const GIB = 1073741824u64;
const SIZE = 2684354560u64;             // 2.5 GiB
const CHUNK = 67108864u64;              // bytes of one write: 64 MiB
const CHUNK_WORDS = 16777216u64;        // words of one write

// The word the pattern holds at word index 'k' of the buffer
fn expected(k u64) u32 {
  let chunk = k / CHUNK_WORDS;
  let within = k % CHUNK_WORDS;
  if within == 0u64 { return u32.from(chunk); }
  if within == 1u64 { return 0xC0FFEEu32; }
  u32.from((within * 2654435761u64) % 4294967296u64);
}

fn word(p *u8, i usize) u32 { *((p + i * 4usize) as *u32); }

// Dispatch probeMain over (big, probes -> out) once, 64 invocations, and copy the 64 words out to 'readback'
fn probe(device &mut Device, shader &ShaderModule, big &BindGroupEntry, probes &Buffer, out &Buffer, readback &Buffer) *u8 {
  let layoutEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
    new BindGroupLayoutEntry(binding: 1u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
    new BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE)];
  var groupLayout = device.createBindGroupLayout(&layoutEntries);
  let groupLayouts = [&groupLayout];
  var layout = device.createPipelineLayout(&groupLayouts, 0u32);
  let desc = new ComputePipelineDescriptor(layout: &layout, module: shader, entryPoint: "probeMain");
  var pipeline = device.createComputePipeline(&desc);
  let groupEntries = [*big, BindGroupEntry.buffer(1u32, probes), BindGroupEntry.buffer(2u32, out)];
  var group = device.createBindGroup(&groupLayout, &groupEntries);
  if !pipeline.isValid() or !group.isValid() { return null; }
  var encoder = device.createCommandEncoder();
  {
    var pass = encoder.beginComputePass();
    pass.setPipeline(&pipeline);
    pass.setBindGroup(0u32, &group);
    pass.dispatchWorkgroups(1u32);
    pass.end();
  }
  encoder.copyBufferToBuffer(out, 0u64, readback, 0u64, 256u64);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  readback.mappedRange();
}

