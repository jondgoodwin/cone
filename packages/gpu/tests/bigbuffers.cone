// Written by tools/shaders/shaders.py from bigbuffer.slang (sha256 6fc1cafa928daf0fa8193fbbaba9ae04beb3e527371ef10f29322246d8136452): do not edit.
let BIGBUFFER_SPIRV Array[u32, 252] = [
  0x07230203u32, 0x00010500u32, 0x00280000u32, 0x0000001du32, 0x00000000u32, 0x00020011u32,
  0x00000001u32, 0x000b000au32, 0x5f565053u32, 0x5f52484bu32, 0x726f7473u32, 0x5f656761u32,
  0x66667562u32, 0x735f7265u32, 0x61726f74u32, 0x635f6567u32, 0x7373616cu32, 0x00000000u32,
  0x0003000eu32, 0x00000000u32, 0x00000001u32, 0x000a000fu32, 0x00000005u32, 0x00000002u32,
  0x626f7270u32, 0x69614d65u32, 0x0000006eu32, 0x00000012u32, 0x00000016u32, 0x00000019u32,
  0x00000009u32, 0x00060010u32, 0x00000002u32, 0x00000011u32, 0x00000040u32, 0x00000001u32,
  0x00000001u32, 0x00030003u32, 0x0000000bu32, 0x00000001u32, 0x00030005u32, 0x0000000au32,
  0x00000069u32, 0x00070005u32, 0x0000000fu32, 0x74535752u32, 0x74637572u32, 0x64657275u32,
  0x66667542u32, 0x00007265u32, 0x00060006u32, 0x0000000fu32, 0x00000000u32, 0x656d5f5fu32,
  0x7265626du32, 0x00000030u32, 0x00040005u32, 0x00000012u32, 0x75736572u32, 0x0000746cu32,
  0x00070005u32, 0x00000014u32, 0x75727453u32, 0x72757463u32, 0x75426465u32, 0x72656666u32,
  0x00000000u32, 0x00060006u32, 0x00000014u32, 0x00000000u32, 0x656d5f5fu32, 0x7265626du32,
  0x00000030u32, 0x00040005u32, 0x00000016u32, 0x626f7270u32, 0x00007365u32, 0x00030005u32,
  0x00000019u32, 0x00676962u32, 0x00050005u32, 0x00000002u32, 0x626f7270u32, 0x69614d65u32,
  0x0000006eu32, 0x00040047u32, 0x00000009u32, 0x0000000bu32, 0x0000001cu32, 0x00040047u32,
  0x0000000du32, 0x00000006u32, 0x00000004u32, 0x00040047u32, 0x00000010u32, 0x00000006u32,
  0x00000004u32, 0x00030047u32, 0x0000000fu32, 0x00000002u32, 0x00050048u32, 0x0000000fu32,
  0x00000000u32, 0x00000023u32, 0x00000000u32, 0x00040047u32, 0x00000012u32, 0x00000021u32,
  0x00000002u32, 0x00040047u32, 0x00000012u32, 0x00000022u32, 0x00000000u32, 0x00030047u32,
  0x00000014u32, 0x00000002u32, 0x00050048u32, 0x00000014u32, 0x00000000u32, 0x00000023u32,
  0x00000000u32, 0x00040047u32, 0x00000016u32, 0x00000021u32, 0x00000001u32, 0x00040047u32,
  0x00000016u32, 0x00000022u32, 0x00000000u32, 0x00030047u32, 0x00000016u32, 0x00000018u32,
  0x00040047u32, 0x00000019u32, 0x00000021u32, 0x00000000u32, 0x00040047u32, 0x00000019u32,
  0x00000022u32, 0x00000000u32, 0x00030047u32, 0x00000019u32, 0x00000018u32, 0x00020013u32,
  0x00000001u32, 0x00030021u32, 0x00000003u32, 0x00000001u32, 0x00040015u32, 0x00000005u32,
  0x00000020u32, 0x00000000u32, 0x00040017u32, 0x00000006u32, 0x00000005u32, 0x00000003u32,
  0x00040020u32, 0x00000008u32, 0x00000001u32, 0x00000006u32, 0x00040015u32, 0x0000000bu32,
  0x00000020u32, 0x00000001u32, 0x0004002bu32, 0x0000000bu32, 0x0000000cu32, 0x00000000u32,
  0x00040020u32, 0x0000000du32, 0x0000000cu32, 0x00000005u32, 0x0003001du32, 0x00000010u32,
  0x00000005u32, 0x0003001eu32, 0x0000000fu32, 0x00000010u32, 0x00040020u32, 0x00000011u32,
  0x0000000cu32, 0x0000000fu32, 0x0003001eu32, 0x00000014u32, 0x00000010u32, 0x00040020u32,
  0x00000015u32, 0x0000000cu32, 0x00000014u32, 0x0004003bu32, 0x00000008u32, 0x00000009u32,
  0x00000001u32, 0x0004003bu32, 0x00000011u32, 0x00000012u32, 0x0000000cu32, 0x0004003bu32,
  0x00000015u32, 0x00000016u32, 0x0000000cu32, 0x0004003bu32, 0x00000015u32, 0x00000019u32,
  0x0000000cu32, 0x00050036u32, 0x00000001u32, 0x00000002u32, 0x00000000u32, 0x00000003u32,
  0x000200f8u32, 0x00000004u32, 0x0004003du32, 0x00000006u32, 0x00000007u32, 0x00000009u32,
  0x00050051u32, 0x00000005u32, 0x0000000au32, 0x00000007u32, 0x00000000u32, 0x00060041u32,
  0x0000000du32, 0x0000000eu32, 0x00000012u32, 0x0000000cu32, 0x0000000au32, 0x00060041u32,
  0x0000000du32, 0x00000013u32, 0x00000016u32, 0x0000000cu32, 0x0000000au32, 0x0004003du32,
  0x00000005u32, 0x00000017u32, 0x00000013u32, 0x00060041u32, 0x0000000du32, 0x00000018u32,
  0x00000019u32, 0x0000000cu32, 0x00000017u32, 0x0004003du32, 0x00000005u32, 0x0000001au32,
  0x00000018u32, 0x0003003eu32, 0x0000000eu32, 0x0000001au32, 0x000100fdu32, 0x00010038u32
];
// spirv-end

fn main() i32 {
  let report = (libc.getenv("GPU_COMPUTE_REPORT") as usize) != 0usize;
  let maxTest = (libc.getenv("GPU_BIGBUFFERS_MAX") as usize) != 0usize;
  var instance = Instance.create("bigbuffers");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  var none = Surface.none();
  var adapter = instance.requestAdapter(&none, POWER_PREFERENCE_HIGH_PERFORMANCE);
  require(adapter.isValid(), "an adapter");
  let has = adapter.computeCapabilities();

  // ---- 1. Over the allocation limit ----
  {
    var device = adapter.requestComputeDevice(&new ComputeRequest(largeBuffers: true));
    require(device.isValid(), "a compute device");
    let before = failures();
    let tooBig = device.createBuffer(has.maxMemoryAllocationSize + 1u64, BUFFER_USAGE_STORAGE);
    expectBool(tooBig.isValid(), false, "a buffer one byte over maxMemoryAllocationSize is not made");
    expectUInt(u64.from(failures() - before), 1u64, "and fails once");
  }

  // ---- 2. A drawing device binds at most 128 MiB ----
  {
    var device = adapter.requestDevice();
    require(device.isValid(), "a drawing device");
    let layoutEntries = [new BindGroupLayoutEntry(binding: 0u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE)];
    var groupLayout = device.createBindGroupLayout(&layoutEntries);
    var b = device.createBuffer(268435456u64, BUFFER_USAGE_STORAGE);
    require(b.isValid(), "a 256 MiB buffer");
    let whole = [BindGroupEntry.buffer(0u32, &b)];
    let before = failures();
    let refused = device.createBindGroup(&groupLayout, &whole);
    expectBool(refused.isValid(), false, "binding the whole of a 256 MiB buffer is refused by a drawing device");
    expectUInt(u64.from(failures() - before), 1u64, "with one failure");
    let part = [BindGroupEntry.bufferRange(0u32, &b, 0u64, 134217728u64)];
    let made = device.createBindGroup(&groupLayout, &part);
    expectBool(made.isValid(), true, "binding 128 MiB of it is made");
  }
  let planned = failures();

  // ---- 3. A 2.5 GiB buffer ----
  var device = adapter.requestComputeDevice(&new ComputeRequest(largeBuffers: true));
  require(device.isValid(), "a compute device");
  let ran = has.maxBufferSize >= SIZE and has.maxMemoryAllocationSize >= SIZE and has.maxStorageBufferRange >= SIZE
    and has.largestDeviceLocalHeap >= SIZE + 2u64 * GIB;
  var made = true;
  var quiet = true;
  var badShader = 0u32;
  var badCopy = 0u32;
  var badRange = 0u32;
  var big = Buffer.none();
  if ran {
    big = device.createBuffer(SIZE, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    made = big.isValid();
  }
  if ran and made {
    expectUInt(device.maxStorageBufferBindingSize, has.maxStorageBufferRange, "bound whole: the device allows it");

    // The pattern in a 64 MiB block of the CPU's memory, uploaded 40 times
    let block = libc.malloc(usize.from(CHUNK)) as *u32;
    var w = 0usize;
    while w < usize.from(CHUNK_WORDS) {
      *(block + w) = expected(u64.from(w));
      w = w + 1usize;
    }
    let start = Instant.now();
    var at = 0u64;
    var chunk = 0u64;
    while at < SIZE {
      let n = if SIZE - at > CHUNK { CHUNK; } else { SIZE - at; };
      device.queue.writeBuffer(&big, at, block as *u8, n);
      // The chunk's first two words: its index, and a mark
      let tag Array[u32, 2] = [u32.from(chunk), 0xC0FFEEu32];
      device.queue.writeBuffer(&big, at, &tag as *u8, 8u64);
      at = at + n;
      chunk = chunk + 1u64;
    }
    device.endFrame();
    device.waitIdle();
    libc.free(block as *u8);
    if report {
      let seconds = start.elapsed().secondsF64();
      printStr("uploaded 2.5 GiB in "); printFloat(seconds); printStr(" s ("); printFloat(2.5d * 1024d / seconds); printStr(" MiB/s)\n");
    }
    quiet = failures() == planned;

    // Sixty-four words, spread: the ends, either side of byte 2^31, chunk boundaries, and others
    let words = SIZE / 4u64;
    var probes = new Array[u32, 64] <- fill 0u32;
    let fixed Array[u64, 20] = [0u64, 1u64, 2u64, 3u64, words - 1u64, words - 2u64, 536870910u64, 536870911u64, 536870912u64, 536870913u64,
      CHUNK_WORDS - 1u64, CHUNK_WORDS, CHUNK_WORDS + 1u64, 20u64 * CHUNK_WORDS, 20u64 * CHUNK_WORDS + 1u64, 20u64 * CHUNK_WORDS + 777u64,
      39u64 * CHUNK_WORDS, 39u64 * CHUNK_WORDS + 2u64, 32u64 * CHUNK_WORDS - 1u64, 32u64 * CHUNK_WORDS];
    var i = 0usize;
    while i < 20usize {
      probes[i] = u32.from(fixed[i]);
      i = i + 1usize;
    }
    var seed = 1014u64;
    while i < 64usize {
      seed = (seed * 1103515245u64 + 12345u64) % 2147483648u64;
      probes[i] = u32.from(seed * 311u64 % words);
      i = i + 1usize;
    }
    var probeBuffer = device.createBuffer(256u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    var out = device.createBuffer(256u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_SRC);
    var readback = device.createBuffer(1024u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    device.queue.writeBuffer(&probeBuffer, 0u64, &probes as *u8, 256u64);
    var shader = device.createShaderModule(&BIGBUFFER_SPIRV);


    // The whole buffer bound
    let whole = BindGroupEntry.buffer(0u32, &big);
    var r = probe(&mut device, &shader, &whole, &probeBuffer, &out, &readback);
    i = 0usize;
    while i < 64usize {
      // (a pipeline or bind group that was not made answers null: all 64 wrong)
      if (r as usize) == 0usize or word(r, i) != expected(u64.from(probes[i])) { badShader = badShader + 1u32; }
      i = i + 1usize;
    }

    // The same words copied out by the GPU
    {
      var encoder = device.createCommandEncoder();
      i = 0usize;
      while i < 64usize {
        encoder.copyBufferToBuffer(&big, u64.from(probes[i]) * 4u64, &readback, 512u64 + u64.from(i) * 4u64, 4u64);
        i = i + 1usize;
      }
      device.queue.submit(encoder.finish());
      device.endFrame();
      device.waitIdle();
      r = readback.mappedRange();
      i = 0usize;
      while i < 64usize {
        if word(r, 128usize + i) != expected(u64.from(probes[i])) { badCopy = badCopy + 1u32; }
        i = i + 1usize;
      }
    }

    // A 64 KiB range from past byte 2^31, the probes relative to its start
    {
      let offset = 2147483648u64 + 4096u64;
      i = 0usize;
      while i < 64usize {
        probes[i] = u32.from(u64.from(i) * 257u64);
        i = i + 1usize;
      }
      device.queue.writeBuffer(&probeBuffer, 0u64, &probes as *u8, 256u64);
      let ranged = BindGroupEntry.bufferRange(0u32, &big, offset, 65536u64);
      r = probe(&mut device, &shader, &ranged, &probeBuffer, &out, &readback);
      i = 0usize;
      while i < 64usize {
        if (r as usize) == 0usize or word(r, i) != expected(offset / 4u64 + u64.from(probes[i])) { badRange = badRange + 1u32; }
        i = i + 1usize;
      }
    }
    quiet = quiet and failures() == planned;
  } else {
    expect(true, "this GPU cannot hold the 2.5 GiB test buffer: skipped");
  }
  expectBool(made, true, "the 2.5 GiB buffer was made");
  expectBool(quiet, true, "uploading it in 64 MiB writes failed nothing");
  expectUInt(u64.from(badShader), 0u64, "64 words read by a shader bound to the whole buffer, past byte 2^31 included: every one the pattern's");
  expectUInt(u64.from(badCopy), 0u64, "the same words copied out by the GPU: every one the pattern's");
  expectUInt(u64.from(badRange), 0u64, "64 words read through a range bound from past byte 2^31: every one the pattern's");

  // ---- Optional: the largest buffer the GPU allows ----
  if maxTest and has.largestDeviceLocalHeap >= has.maxMemoryAllocationSize + GIB {
    let start = Instant.now();
    var huge = device.createBuffer(has.maxMemoryAllocationSize, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    expectBool(huge.isValid(), true, "the largest buffer the GPU allows is made");
    let tag Array[u32, 2] = [0xABCDEFu32, 0x123456u32];
    device.queue.writeBuffer(&huge, has.maxMemoryAllocationSize - 8u64, &tag as *u8, 8u64);
    var readback = device.createBuffer(64u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    var encoder = device.createCommandEncoder();
    encoder.copyBufferToBuffer(&huge, has.maxMemoryAllocationSize - 8u64, &readback, 0u64, 8u64);
    device.queue.submit(encoder.finish());
    device.endFrame();
    device.waitIdle();
    let r = readback.mappedRange();
    expectUInt(u64.from(word(r, 0usize)), 0xABCDEFu64, "its last bytes are what was written");
    expectUInt(u64.from(word(r, 1usize)), 0x123456u64, "both words");
    if report {
      printStr("largest buffer: "); printUInt(has.maxMemoryAllocationSize); printStr(" bytes made, written and read in ");
      printFloat(start.elapsed().secondsF64()); printStr(" s\n");
    }
  }

  expectUInt(u64.from(failures()), u64.from(planned), "no failure beyond the refusals the test provoked");
  expectUInt(u64.from(validationMessages()), 0u64, "no validation message");
  done();
}
