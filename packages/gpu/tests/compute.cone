// Compute on a real GPU: storage buffers, dispatches that read what the
// dispatch before them wrote, indirect arguments the GPU writes, timestamps,
// and WebGPU's limits held. Only a failure prints.
//
// 1. One compute pass, compute.slang's entry points, one bind group of five
//    storage buffers (the first read-only), 200 elements, input[i] = i + 7:
//    - squareMain, 4 workgroups of 64 (the last partly idle), the count
//      (200) and 12 in the immediates: squares[i] = (i + 7)^2 + 12;
//    - chainMain, the same size: chained[i] = squares[i] + i, which reads
//      what the dispatch before wrote (a missing barrier is a read-after-write
//      hazard, which synchronization validation reports);
//    - argumentsMain, one invocation: an indirect dispatch's arguments from
//      the first square (61 - 57 = 4 workgroups, 1, 1), then an indirect
//      draw's (3 vertices, 1 instance) at byte 16, and the counter zeroed;
//    - countMain, dispatched indirectly from those arguments: each of its
//      4 x 64 invocations adds 1 to the counter (an integer atomic), so it
//      ends at 256 whatever the order.
// 2. A render pass after it draws a full-screen triangle with 'drawIndirect'
//    from the arguments the GPU wrote, in (255, 128, 64) on black, into a
//    16 x 16 rgba8unorm target: every pixel that color, so the draw ran with
//    the arguments the compute pass wrote.
// 3. Timestamps written before and after the compute pass, resolved into a
//    buffer and copied to one the CPU reads: the second is not before the
//    first, and the first is not 0. (Skipped if the queue keeps no time.)
// 4. WebGPU's limits, each refused with one failure and nothing made: a
//    shader module whose workgroup is 512 x 1 x 1; a dispatch of 65536
//    workgroups; a pipeline layout whose compute stage sees 10 storage
//    buffers; a storage texture read and written as rgba16float; a storage
//    buffer the vertex stage may write; a storage buffer bound from byte 4.
//    Six failures in all, and no validation message.
//
// With GPU_COMPUTE_REPORT set, it prints the adapter, whether synchronization
// validation is on, and the compute pass's time. GPU_POWER_PREFERENCE=low-power
// tests the integrated GPU where there are two. It needs a GPU driver with
// Vulkan 1.3 and SDL3.dll; with the Vulkan SDK, validation and
// synchronization validation are on, and must say nothing.

mod compute;

import testing use *;
import stdio use *;
import libc;
import geomath use *;
import gpu use *;

const COUNT = 200u32;

// The power preference GPU_POWER_PREFERENCE asks for
fn preference() u32 {
  imm env = libc.getenv(&"GPU_POWER_PREFERENCE" as *u8);
  if (env as usize) != 0usize and libc.strcmp(env, &"low-power" as *u8) == 0i32 { return POWER_PREFERENCE_LOW_POWER; }
  POWER_PREFERENCE_HIGH_PERFORMANCE;
}

// The u32 at byte 'offset' of 'p'
fn word(p *u8, offset usize) u32 { *((p + offset) as *u32); }

fn main() i32 {
  mut instance = Instance.create("compute");
  require(instance.isValid(), "a Vulkan 1.3 instance");
  imm report = (libc.getenv(&"GPU_COMPUTE_REPORT" as *u8) as usize) != 0usize;
  mut none = Surface.none();
  mut adapter = instance.requestAdapter(&none, preference());
  require(adapter.isValid(), "an adapter");
  mut device = adapter.requestDevice();
  require(device.isValid(), "a device");
  if report {
    printStr("adapter: ");
    printStr(adapter.name.view());
    printStr(if instance.syncValidation { "\nsynchronization validation on\n"; } else { "\nsynchronization validation OFF\n"; });
  }

  // ---- The buffers, the pipelines and the bind group ----
  mut input = device.createBuffer(u64[COUNT] * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
  mut squares = device.createBuffer(u64[COUNT] * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_SRC);
  mut chained = device.createBuffer(u64[COUNT] * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_SRC);
  mut arguments = device.createBuffer(32u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_INDIRECT | BUFFER_USAGE_COPY_SRC);
  mut counter = device.createBuffer(4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_SRC);
  mut readback = device.createBuffer(4096u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  imm r = readback.mappedRange();
  mut data [200; u32] = [200; 0u32];
  mut i = 0usize;
  while i < usize[COUNT] {
    data[i] = u32[i] + 7u32;
    i = i + 1usize;
  }
  device.queue.writeBuffer(&input, 0u64, &data as *u8, u64[COUNT] * 4u64);

  imm entries = [
    BindGroupLayoutEntry[binding: 0u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE],
    BindGroupLayoutEntry[binding: 1u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE],
    BindGroupLayoutEntry[binding: 2u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE],
    BindGroupLayoutEntry[binding: 3u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE],
    BindGroupLayoutEntry[binding: 4u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE]];
  mut groupLayout = device.createBindGroupLayout(&entries);
  imm groupLayouts = [&groupLayout];
  mut layout = device.createPipelineLayout(&groupLayouts, 8u32);
  mut shader = device.createShaderModule(&COMPUTE_SPIRV);
  require(shader.isValid() and layout.isValid(), "the shader and the pipeline layout");
  imm squareDesc = ComputePipelineDescriptor[layout: &layout, module: &shader, entryPoint: "squareMain"];
  mut squarePipeline = device.createComputePipeline(&squareDesc);
  imm chainDesc = ComputePipelineDescriptor[layout: &layout, module: &shader, entryPoint: "chainMain"];
  mut chainPipeline = device.createComputePipeline(&chainDesc);
  imm argumentsDesc = ComputePipelineDescriptor[layout: &layout, module: &shader, entryPoint: "argumentsMain"];
  mut argumentsPipeline = device.createComputePipeline(&argumentsDesc);
  imm countDesc = ComputePipelineDescriptor[layout: &layout, module: &shader, entryPoint: "countMain"];
  mut countPipeline = device.createComputePipeline(&countDesc);
  require(squarePipeline.isValid() and chainPipeline.isValid() and argumentsPipeline.isValid()
    and countPipeline.isValid(), "the four compute pipelines");
  imm groupEntries = [BindGroupEntry.buffer(0u32, &input), BindGroupEntry.buffer(1u32, &squares),
    BindGroupEntry.buffer(2u32, &chained), BindGroupEntry.buffer(3u32, &arguments),
    BindGroupEntry.buffer(4u32, &counter)];
  mut group = device.createBindGroup(&groupLayout, &groupEntries);
  require(group.isValid(), "the bind group");

  // The indirect draw's target and pipeline
  imm targetDesc = TextureDescriptor[16u32, 16u32, TEXTURE_FORMAT_RGBA8_UNORM,
    TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC];
  mut target = device.createTexture(&targetDesc);
  mut pixels = device.createBuffer(1024u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
  mut drawLayout = device.createEmptyPipelineLayout(0u32);
  imm noAttributes = [VertexAttribute[VERTEX_FORMAT_FLOAT32, 0u64, 0u32]];
  imm noBuffers = [VertexBufferLayout[arrayStride: 4u64, attributes: &noAttributes]];
  imm drawDesc = RenderPipelineDescriptor[layout: &drawLayout, vertexModule: &shader, buffers: &noBuffers[..0],
    fragmentModule: &shader, colorFormat: TEXTURE_FORMAT_RGBA8_UNORM];
  mut drawPipeline = device.createRenderPipeline(&drawDesc);
  require(target.isValid() and drawPipeline.isValid(), "the draw's target and pipeline");

  // Timestamps, if the queue keeps time
  imm timing = device.timestampPeriod > 0.;
  mut queries = QuerySet.none();
  if timing { queries = device.createQuerySet(QUERY_TYPE_TIMESTAMP, 2u32); }
  mut resolved = device.createBuffer(256u64, BUFFER_USAGE_QUERY_RESOLVE | BUFFER_USAGE_COPY_SRC);

  // ---- 1 to 3: the pass, the draw, the timestamps ----
  require(failures() == 0u32, "everything made");
  mut encoder = device.createCommandEncoder();
  if timing { encoder.writeTimestamp(&queries, 0u32); }
  {
    mut pass = encoder.beginComputePass();
    imm immediates [2; u32] = [COUNT, 12u32];
    pass.setPipeline(&squarePipeline);
    pass.setBindGroup(0u32, &group);
    pass.setImmediates(0u32, &immediates as *u8, 8u32);
    pass.dispatchWorkgroups(4u32);
    pass.setPipeline(&chainPipeline);
    pass.setImmediates(0u32, &immediates as *u8, 8u32);
    pass.dispatchWorkgroups(4u32, 1u32, 1u32);
    pass.setPipeline(&argumentsPipeline);
    pass.dispatchWorkgroups(1u32);
    pass.setPipeline(&countPipeline);
    pass.dispatchWorkgroupsIndirect(&arguments, 0u64);
    pass.dispatchWorkgroups(65536u32);               // 4: refused, one failure
    pass.end();
  }
  if timing { encoder.writeTimestamp(&queries, 1u32); }
  {
    imm attachment = RenderPassColorAttachment[view: target.createView(), clearValue: Color[0., 0., 0., 1.]];
    mut pass = encoder.beginRenderPass(&attachment);
    pass.setPipeline(&drawPipeline);
    pass.drawIndirect(&arguments, 16u64);
    pass.end();
  }
  encoder.copyBufferToBuffer(&squares, 0u64, &readback, 0u64, u64[COUNT] * 4u64);
  encoder.copyBufferToBuffer(&chained, 0u64, &readback, 1024u64, u64[COUNT] * 4u64);
  encoder.copyBufferToBuffer(&arguments, 0u64, &readback, 2048u64, 32u64);
  encoder.copyBufferToBuffer(&counter, 0u64, &readback, 2112u64, 4u64);
  encoder.copyTextureToBuffer(&target, &pixels);
  if timing {
    encoder.resolveQuerySet(&queries, 0u32, 2u32, &resolved, 0u64);
    encoder.copyBufferToBuffer(&resolved, 0u64, &readback, 2304u64, 16u64);
  }
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();

  // ---- 1. The buffers ----
  mut badSquares = 0u32;
  mut badChained = 0u32;
  i = 0usize;
  while i < usize[COUNT] {
    imm v = u32[i] + 7u32;
    imm square = v * v + 12u32;
    if word(r, i * 4usize) != square { badSquares = badSquares + 1u32; }
    if word(r, 1024usize + i * 4usize) != square + u32[i] { badChained = badChained + 1u32; }
    i = i + 1usize;
  }
  expectUInt(u64[badSquares], 0u64, "every square, from a read-only storage buffer and the immediates");
  expectUInt(u64[badChained], 0u64, "every chained value, from what the dispatch before wrote");
  imm wantArguments [8; u32] = [4u32, 1u32, 1u32, 0u32, 3u32, 1u32, 0u32, 0u32];
  i = 0usize;
  while i < 8usize {
    expectUInt(u64[word(r, 2048usize + i * 4usize)], u64[wantArguments[i]], "an indirect argument the GPU wrote");
    i = i + 1usize;
  }
  expectUInt(u64[word(r, 2112usize)], 256u64, "the indirect dispatch's 4 x 64 invocations, counted");

  // ---- 2. The indirect draw ----
  imm px = pixels.mappedRange();
  mut badPixels = 0u32;
  i = 0usize;
  while i < 256usize {
    imm at = px + i * 4usize;
    if *at != 255u8 or *(at + 1usize) < 127u8 or *(at + 1usize) > 128u8 or *(at + 2usize) != 64u8 {
      badPixels = badPixels + 1u32;
    }
    i = i + 1usize;
  }
  expectUInt(u64[badPixels], 0u64, "every pixel drawn by the indirect draw");

  // ---- 3. Timestamps ----
  if timing {
    imm t0 = *((r + 2304usize) as *u64);
    imm t1 = *((r + 2312usize) as *u64);
    expect(t0 != 0u64, "a first timestamp");
    expect(t1 >= t0, "the second timestamp not before the first");
    if report {
      printStr("compute pass: ");
      printFloat(f64[t1 - t0] * f64[device.timestampPeriod] / 1000d);
      printStr(" microseconds\n");
    }
  } elif report {
    printStr("no timestamps: the queue keeps no time\n");
  }

  // ---- 4. WebGPU's limits ----
  // A module whose one compute entry point is 512 x 1 x 1: the SPIR-V header,
  // then OpExecutionMode %1 LocalSize 512 1 1
  imm oversized [11; u32] = [0x07230203u32, 0x00010500u32, 0u32, 2u32, 0u32,
    0x00060010u32, 1u32, 17u32, 512u32, 1u32, 1u32];
  mut tooWide = device.createShaderModule(&oversized);
  expectBool(tooWide.isValid(), false, "a workgroup of 512 refused");
  imm twice = [&groupLayout, &groupLayout];
  mut tooMany = device.createPipelineLayout(&twice, 0u32);
  expectBool(tooMany.isValid(), false, "10 storage buffers in one stage refused");
  imm halfStorage = [BindGroupLayoutEntry[binding: 0u32, visibility: SHADER_STAGE_COMPUTE,
    kind: BINDING_KIND_STORAGE_TEXTURE, storageAccess: STORAGE_TEXTURE_ACCESS_READ_WRITE,
    format: TEXTURE_FORMAT_RGBA16_FLOAT, viewDimension: TEXTURE_VIEW_DIMENSION_3D]];
  mut readWriteHalf = device.createBindGroupLayout(&halfStorage);
  expectBool(readWriteHalf.isValid(), false, "an rgba16float storage texture read and written refused");
  imm vertexWrites = [BindGroupLayoutEntry[binding: 0u32, visibility: SHADER_STAGE_VERTEX,
    bufferType: BUFFER_BINDING_TYPE_STORAGE]];
  mut vertexStorage = device.createBindGroupLayout(&vertexWrites);
  expectBool(vertexStorage.isValid(), false, "a storage buffer the vertex stage writes refused");
  imm misaligned = [BindGroupEntry.buffer(0u32, &input), BindGroupEntry.bufferRange(1u32, &squares, 4u64, 16u64),
    BindGroupEntry.buffer(2u32, &chained), BindGroupEntry.buffer(3u32, &arguments),
    BindGroupEntry.buffer(4u32, &counter)];
  mut misalignedGroup = device.createBindGroup(&groupLayout, &misaligned);
  expectBool(misalignedGroup.isValid(), false, "a storage buffer bound from byte 4 refused");
  expectUInt(u64[failures()], 6u64, "six refusals, and no Vulkan call failed");
  expectUInt(u64[validationMessages()], 0u64, "no validation message");
  done();
}

