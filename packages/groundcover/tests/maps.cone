// The ground maps: samples, derived signals and distances, each checked against
// a value worked out by hand. Only a failure prints.
//
// - Bilinear sample: on a ramp of heights the sample is the ramp (a bilinear
//   filter reproduces a linear function exactly away from the edge), and a
//   quarter of the way between two texels is a quarter of the way between
//   their values; clamped past the edge.
// - Slope: a plane rising 1 in 2 (h = x / 2) has slope atan(0.5) = 26.5651 degrees
//   everywhere inside, and its normal is (-0.4472, 0.8944, 0).
// - Exposure: flat ground in the open is 1; a wall of height 10 m to the
//   east of ground, with the sun 20 degrees above the eastern horizon, shades
//   the ground within 10 / tan(20) = 27.5 m west of it and leaves the ground
//   beyond that lit.
// - Polyline distance: a point 5 m from a straight path of half-width 1 is 4 m
//   from it; past the path's end the distance is to the end point.
// - Crown: the canopy is its density at the middle and 0 beyond the radius.
// - Moisture: e^(-distance / reach) from 'dry' to 1.

mod maps;

import testing use *;
import libc;
import collections use *;
import geomath use *;
import groundcover use *;

fn main() i32 {
  // A ramp: h = 0.5 x over a 64 m square of 64 texels (1 m texels)
  var ramp = GroundMaps.create(0., 0., 64., 64u32);
  var j = 0u32;
  while j < 64u32 {
    var i = 0u32;
    while i < 64u32 {
      ramp.set(SIGNAL_HEIGHT, i, j, 0.5 * ramp.worldX(i));
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  expectFloat(f64.from(ramp.heightAt(20.25, 31.)), 10.125, 0.0001, "bilinear reproduces the ramp");
  expectFloat(f64.from(ramp.heightAt(10.5, 10.5)), 5.25, 0.0001, "at a texel's centre it is that texel");
  expectFloat(f64.from(ramp.sample(SIGNAL_HEIGHT, 10.75, 10.5)), 5.375, 0.0001, "a quarter of the way between two texels");
  expectFloat(f64.from(ramp.heightAt(-5., 10.)), 0.25, 0.0001, "clamped at the west edge (texel 0 is 0.25)");
  let n = ramp.normalAt(32., 32.);
  expectFloat(f64.from(n.x), -0.4472136, 0.0001, "ramp normal x");
  expectFloat(f64.from(n.y), 0.8944272, 0.0001, "ramp normal y");
  expectFloat(f64.from(n.z), 0.0, 0.0001, "ramp normal z");
  ramp.deriveSlope();
  expectFloat(f64.from(ramp.sample(SIGNAL_SLOPE, 32., 32.)), 26.5650512, 0.001, "slope of a 1 in 2 ramp, degrees");

  // Exposure: ground at 0 for x < 40, a wall 10 m high from x = 40 on, the sun in the east
  var wall = GroundMaps.create(0., 0., 128., 128u32);
  j = 0u32;
  while j < 128u32 {
    var i = 0u32;
    while i < 128u32 {
      if wall.worldX(i) >= 40. { wall.set(SIGNAL_HEIGHT, i, j, 10.); }
      i = i + 1u32;
    }
    j = j + 1u32;
  }
  let el = radians(20.);
  wall.deriveExposure(new Vec3(cos(el), sin(el), 0.), 80.);
  expectFloat(f64.from(wall.sample(SIGNAL_EXPOSURE, 20., 60.)), 0.0, 0.001, "shaded 20 m west of the wall");
  expectFloat(f64.from(wall.sample(SIGNAL_EXPOSURE, 5., 60.)), 1.0, 0.001, "lit 35 m west of the wall (past the 27.5 m shadow)");
  expectFloat(f64.from(wall.sample(SIGNAL_EXPOSURE, 100., 60.)), 1.0, 0.001, "lit on top of the wall");

  // Distances
  var d = GroundMaps.create(0., 0., 64., 64u32);
  var line = List[Vec2].empty();
  line.push(new Vec2(10., 20.));
  line.push(new Vec2(50., 20.));
  d.addPolylineDistance(SIGNAL_PATH, &line, 1.);
  expectFloat(f64.from(d.at(SIGNAL_PATH, 30u32, 25u32)), 4.5, 0.001, "texel (30, 25) is at z = 25.5, 5.5 m off a path of half-width 1: 4.5 m from it");
  expectFloat(f64.from(d.at(SIGNAL_PATH, 30u32, 20u32)), 0.0, 0.001, "on the path (0.5 m off, half-width 1): 0");
  expectFloat(f64.from(d.at(SIGNAL_PATH, 58u32, 20u32)), 7.5147, 0.001, "past the end: the distance to the end point (8.5, 0.5), less 1");
  d.addObject(32., 50., 2.);
  expectFloat(f64.from(d.at(SIGNAL_OBJECT, 32u32, 40u32)), 7.5139, 0.001, "texel (32, 40) is (0.5, 9.5) m from the boulder's middle: 9.514 - 2");

  // A crown
  var c = GroundMaps.create(0., 0., 64., 64u32);
  c.addCrown(32., 32., 10., 0.8);
  expectFloat(f64.from(c.at(SIGNAL_CANOPY, 32u32, 32u32)), 0.789, 0.003, "the crown's middle: density x smoothstep(1 - 0.0707) = 0.8 x 0.9863");
  expectFloat(f64.from(c.at(SIGNAL_CANOPY, 45u32, 32u32)), 0.0, 0.0001, "and nothing beyond the radius");
  let half = c.at(SIGNAL_CANOPY, 37u32, 32u32);
  expect(half > 0.2 and half < 0.6, "between, a smooth fall");

  // Moisture from water
  var w = GroundMaps.create(0., 0., 64., 64u32);
  var stream = List[Vec2].empty();
  stream.push(new Vec2(0., 10.));
  stream.push(new Vec2(64., 10.));
  w.addPolylineDistance(SIGNAL_WATER, &stream, 0.);
  w.deriveMoisture(0.2, 8., 0.);
  let wet = w.at(SIGNAL_MOISTURE, 20u32, 10u32);
  let dry = w.at(SIGNAL_MOISTURE, 20u32, 50u32);
  expect(wet > 0.85, "wet at the water's edge");
  expectFloat(f64.from(dry), 0.2 + 0.8 * libc.exp(0.0 - 40.0 / 8.0), 0.02, "e^(-40/8) from dry to 1 at 40 m");
  done()
}
