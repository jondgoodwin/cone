// ======== CoverRenderer: cover placed and drawn on the GPU ========
//
// Each frame, for every (type, ring) BATCH, a compute dispatch places the
// instances that the camera's surroundings call for (generate.slang: the
// rules of cover.slang over the ground maps), culled to the view frustum, and
// appends them to the batch's range of one instance buffer; a last tiny
// dispatch turns the counters into the indirect draws' instance counts. Then one
// render pass draws every batch with one indirect draw each (draw.slang builds
// each kind's geometry from the instance and the vertex index). The CPU
// writes the frame's uniforms and records the commands; it never learns how many
// instances were placed unless statistics are asked for.
//
// The pass loads the frame and the depth the scene left (render's
// 'keepDepth'), tests against that depth and writes it, so cover is occluded
// by the scene and occludes it.

// How the world looks to the cover this frame
pub struct CoverEnvironment {
  pub light: Light;                 // the sun, as render's Light: its direction the way the light travels
  pub exposure: f32 = 1.;           // the renderer's exposure
  pub time: f32 = 0.;               // seconds
  pub windX: f32 = 1.;              // the direction the wind blows (x, z; normalised here)
  pub windZ: f32 = 0.2;
  pub windSpeed: f32 = 4.;          // metres a second: how fast the gusts travel
  pub gust: f32 = 0.7;              // 0 (calm) to 1 (a gale) in how far the wind bends things
  pub farBlend: f32 = 1.;           // how fully distant cover takes the far field's colour (0 to 1)
  pub cull: bool = true;            // cull instances outside the view
}

struct MeshEntry {
  first: u32;                       // the first vertex in the mesh buffer
  count: u32;                       // vertices (three a triangle)
  radius: f32;                      // the farthest a vertex is from the origin
}

struct Batch {
  typeIndex: u32;
  ring: u32;
  base: u32;                        // its first instance in the buffer
  cap: u32;
  verts: u32;                       // vertices an instance draws
  cell: f32;                        // its lattice cell
  half: f32;                        // the half-width of the square of cells it needs
  near: f32;                        // the span of distances it keeps
  far: f32;
  widthScale: f32;
}

const FRAME_WORDS = 68usize;
const TYPE_WORDS = 112usize;
const GEN_WORDS = 16usize;
const ARGS_WORDS = 8u32;

pub struct CoverRenderer {
  pub generateShader: ShaderModule;
  pub drawShader: ShaderModule;
  pub computeLayout: BindGroupLayout;
  pub drawLayout: BindGroupLayout;
  pub computePipelineLayout: PipelineLayout;
  pub drawPipelineLayout: PipelineLayout;
  pub generatePipeline: ComputePipeline;
  pub finishPipeline: ComputePipeline;
  pub drawPipeline: RenderPipeline;
  pub sampler: Sampler;
  pub frameBuffer: Buffer;
  pub typesBuffer: Buffer;
  pub mapsTexture: Texture;
  pub farTexture: Texture;
  pub instances: Buffer;
  pub counters: Buffer;
  pub args: Buffer;
  pub meshBuffer: Buffer;
  pub readback: Buffer;
  pub mapsView: TextureView;
  pub farView: TextureView;
  pub computeGroup: BindGroup;
  pub drawGroup: BindGroup;
  batches: List[Batch];
  meshes: List[MeshEntry];
  meshData: List[f32];
  mapRect: Vec4;
  pub built: bool;
  pub collectStats: bool = false;   // copy the batches' counts to 'readback' each frame
  pub drawCalls: u32;               // draws the last render made
  pub batchCount: u32;
  pub debugMode: u32;               // 0; 1: draw flat colour (no lighting); 2: place every vertex off screen (only the vertex stage costs)

  // A renderer of cover into targets of 'colorFormat' tested against a depth
  // texture of 'depthFormat'. Check 'isValid'.
  pub fn create(device: &mut Device, colorFormat: u32, depthFormat: u32) CoverRenderer {
    var generateShader = device.createShaderModule(&GENERATE_SPIRV);
    var drawShader = device.createShaderModule(&DRAW_SPIRV);
    let allStages = SHADER_STAGE_VERTEX | SHADER_STAGE_FRAGMENT | SHADER_STAGE_COMPUTE;
    let computeEntries = [
      BindGroupLayoutEntry(binding: 0u32, visibility: allStages),
      BindGroupLayoutEntry(binding: 1u32, visibility: allStages),
      BindGroupLayoutEntry(binding: 2u32, visibility: allStages, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT),
      BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE),
      BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_COMPUTE, bufferType: BUFFER_BINDING_TYPE_STORAGE)];
    var computeLayout = device.createBindGroupLayout(&computeEntries);
    let drawEntries = [
      BindGroupLayoutEntry(binding: 0u32, visibility: allStages & 3u32),
      BindGroupLayoutEntry(binding: 1u32, visibility: allStages & 3u32),
      BindGroupLayoutEntry(binding: 2u32, visibility: SHADER_STAGE_VERTEX, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_UNFILTERABLE_FLOAT),
      BindGroupLayoutEntry(binding: 3u32, visibility: SHADER_STAGE_VERTEX, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      BindGroupLayoutEntry(binding: 4u32, visibility: SHADER_STAGE_VERTEX, bufferType: BUFFER_BINDING_TYPE_READ_ONLY_STORAGE),
      BindGroupLayoutEntry(binding: 5u32, visibility: SHADER_STAGE_VERTEX, kind: BINDING_KIND_TEXTURE,
        sampleType: TEXTURE_SAMPLE_TYPE_FLOAT),
      BindGroupLayoutEntry(binding: 6u32, visibility: SHADER_STAGE_VERTEX, kind: BINDING_KIND_SAMPLER)];
    var drawLayout = device.createBindGroupLayout(&drawEntries);
    let computeLayouts = [&computeLayout];
    var computePipelineLayout = device.createPipelineLayout(&computeLayouts, 64u32);
    let drawLayouts = [&drawLayout];
    var drawPipelineLayout = device.createPipelineLayout(&drawLayouts, 16u32);
    let generateDesc = ComputePipelineDescriptor(layout: &computePipelineLayout, module: &generateShader,
      entryPoint: "generateMain");
    var generatePipeline = device.createComputePipeline(&generateDesc);
    let finishDesc = ComputePipelineDescriptor(layout: &computePipelineLayout, module: &generateShader,
      entryPoint: "finishMain");
    var finishPipeline = device.createComputePipeline(&finishDesc);
    let noBuffers = List[VertexBufferLayout].empty();
    let drawDesc = RenderPipelineDescriptor(layout: &drawPipelineLayout, vertexModule: &drawShader,
      vertexEntryPoint: "vertexMain", buffers: noBuffers.view(), fragmentModule: &drawShader,
      fragmentEntryPoint: "fragmentMain", colorFormat: colorFormat, depthFormat: depthFormat,
      depthWriteEnabled: true, depthCompare: COMPARE_FUNCTION_LESS_EQUAL, cullMode: CULL_MODE_NONE);
    var drawPipeline = device.createRenderPipeline(&drawDesc);
    let samplerDesc = SamplerDescriptor(addressModeU: ADDRESS_MODE_CLAMP_TO_EDGE, addressModeV: ADDRESS_MODE_CLAMP_TO_EDGE,
      addressModeW: ADDRESS_MODE_CLAMP_TO_EDGE);
    var sampler = device.createSampler(&samplerDesc);
    var frameBuffer = device.createBuffer(u64.from(FRAME_WORDS) * 4u64, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    var typesBuffer = device.createBuffer(u64.from(TYPE_WORDS * 12usize) * 4u64, BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST);
    // Placeholders, until 'build' replaces them
    let onePixel = TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_R32_FLOAT, TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_DST);
    var mapsTexture = device.createTexture(&onePixel);
    let oneColor = TextureDescriptor(1u32, 1u32, TEXTURE_FORMAT_RGBA8_UNORM_SRGB, TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_DST);
    var farTexture = device.createTexture(&oneColor);
    var instances = device.createBuffer(48u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    var counters = device.createBuffer(16u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    var args = device.createBuffer(32u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_INDIRECT | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    var meshBuffer = device.createBuffer(32u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    var readback = device.createBuffer(32u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    var mapsView = mapsTexture.createView();
    var farView = farTexture.createView();
    var computeGroup = computeGroupOf(device, &computeLayout, &frameBuffer, &typesBuffer, &mapsView, &instances, &counters, &args);
    var drawGroup = drawGroupOf(device, &drawLayout, &frameBuffer, &typesBuffer, &mapsView, &instances, &meshBuffer, &farView, &sampler);
    CoverRenderer(generateShader, drawShader, computeLayout, drawLayout, computePipelineLayout, drawPipelineLayout,
      generatePipeline, finishPipeline, drawPipeline, sampler, frameBuffer, typesBuffer, mapsTexture, farTexture,
      instances, counters, args, meshBuffer, readback, mapsView, farView, computeGroup, drawGroup,
      List[Batch].empty(), List[MeshEntry].empty(), List[f32].empty(), Vec4(0., 0., 1., 1.), false, false, 0u32, 0u32, 0u32)
  }

  pub fn isValid(self: &) bool {
    generatePipeline.isValid() && finishPipeline.isValid() && drawPipeline.isValid() && sampler.isValid()
      && frameBuffer.isValid() && typesBuffer.isValid()
  }

  // Register a mesh for MESH types to draw; answers its index, to put in a
  // type's 'meshes'. Flat shaded or smooth as the mesh's normals are; its
  // uvs are carried (the shader does not use them yet). The mesh must stand on
  // y = 0 about the origin, at unit scale: an instance scales it by the type's size.
  pub fn addMesh(self: &mut, m: &mesh.Mesh) i32 {
    let first = u32.from(meshData.len() / 8usize);
    var radius = 0f32;
    let nt = m.indices.len() / 3usize;
    var t = 0usize;
    while t < nt {
      var k = 0usize;
      while k < 3usize {
        let v = usize.from(*m.indices[t * 3usize + k]);
        let p = *m.positions[v];
        let nrm = if m.normals.len() > v { *m.normals[v] } else { Vec3(0., 1., 0.) };
        let uv = if m.uvs.len() > v { *m.uvs[v] } else { Vec2(0., 0.) };
        meshData.push(p.x);
        meshData.push(p.y);
        meshData.push(p.z);
        meshData.push(uv.x);
        meshData.push(nrm.x);
        meshData.push(nrm.y);
        meshData.push(nrm.z);
        meshData.push(uv.y);
        let len = p.length();
        if len > radius { radius = len; }
        k = k + 1usize;
      }
      t = t + 1usize;
    }
    meshes.push(MeshEntry(first, u32.from(nt * 3usize), radius));
    i32.from(meshes.len() - 1usize)
  }

  // The vertices an instance of ring 'ring' of type 't' draws
  fn vertsOf(self: &, t: &CoverType, ring: u32) u32 {
    if t.kind == KIND_BLADES { return bladesOf(t.bladesPerTuft, ring) * (6u32 * segmentsOf(ring) - 3u32); }
    if t.kind == KIND_FLOWER { return (6u32 * flowerSegments(ring) - 3u32) + 6u32; }
    if t.kind == KIND_PATCH { let g = patchGrid(ring); return 6u32 * g * g; }
    if t.kind == KIND_LITTER { return 6u32; }
    let mi = t.meshes[usize.from(ring)];
    if mi < 0i32 || usize.from(u32.from(mi)) >= meshes.len() { return 0u32; }
    meshes[usize.from(u32.from(mi))].count
  }

  // Set up everything for the cover types 'types' over the ground 'maps':
  // validate them, pack them, upload the maps and the far field, and make the
  // buffers. False (and nothing drawn) if the types are not valid. Call it
  // again to replace the types or the maps.
  pub fn build(self: &mut, device: &mut Device, types: &List[CoverType], maps: &GroundMaps) bool {
    built = false;
    if !self.isValid() { return false; }
    let faults = problems(types);
    if faults.len() > 0usize {
      print <- "groundcover: "; printStr(faults[0usize].view()); print <- "\n";
      return false;
    }
    // What was there goes once the GPU has finished with it
    device.queue.releaseBindGroup(&mut computeGroup);
    device.queue.releaseBindGroup(&mut drawGroup);
    device.queue.releaseTexture(&mut mapsTexture);
    device.queue.releaseTexture(&mut farTexture);
    // The maps: eight channels side by side in one r32float texture
    let res = maps.res;
    let texDesc = TextureDescriptor(res * u32.from(SIGNALS), res, TEXTURE_FORMAT_R32_FLOAT,
      TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_DST);
    mapsTexture = device.createTexture(&texDesc);
    var texels = List[f32].withCapacity(usize.from(res) * usize.from(res) * SIGNALS);
    var j = 0u32;
    while j < res {
      var c = 0usize;
      while c < SIGNALS {
        var i = 0u32;
        while i < res {
          texels.push(maps.at(c, i, j));
          i = i + 1u32;
        }
        c = c + 1usize;
      }
      j = j + 1u32;
    }
    let tv = texels.view();
    device.queue.writeTexture(&mapsTexture, &tv[0] as *u8, res * u32.from(SIGNALS) * 4u32);
    // The far field
    let farDesc = TextureDescriptor(res, res, TEXTURE_FORMAT_RGBA8_UNORM_SRGB,
      TEXTURE_USAGE_TEXTURE_BINDING | TEXTURE_USAGE_COPY_DST);
    farTexture = device.createTexture(&farDesc);
    if maps.farField.len() == usize.from(res) * usize.from(res) * 4usize {
      let fv = maps.farField.view();
      device.queue.writeTexture(&farTexture, &fv[0] as *u8, res * 4u32);
    } else {
      var grey = List[u8].withCapacity(usize.from(res) * usize.from(res) * 4usize);
      var q = 0usize;
      while q < usize.from(res) * usize.from(res) {
        grey.push(100u8); grey.push(100u8); grey.push(90u8); grey.push(255u8);
        q = q + 1usize;
      }
      let gv = grey.view();
      device.queue.writeTexture(&farTexture, &gv[0] as *u8, res * 4u32);
    }
    mapRect = Vec4(maps.originX, maps.originZ, maps.texel, f32.from(res));
    // The types, packed
    var words = Array[u32, 1344]() <- fill 0u32;
    var i = 0usize;
    while i < types.len() {
      self.packType(&mut words, i, types, i);
      i = i + 1usize;
    }
    device.queue.writeBuffer(&typesBuffer, 0u64, &words as *u8, u64.from(TYPE_WORDS * 12usize) * 4u64);
    // The batches: one for each ring of each type
    batches.clear();
    var total = 0u32;
    i = 0usize;
    while i < types.len() {
      let t = types[i];
      var r = 0u32;
      while r < t.rings {
        let cell = ringCell(t, r);
        var near = 0f32;
        var far = 0f32;
        ringSpan(t, r, &mut near, &mut far);
        var ws = 1f32;
        var q = 0u32;
        while q < latticeRing(t, r) { ws = ws * t.ringStep; q = q + 1u32; }
        batches.push(Batch(u32.from(i), r, total, t.maxInstances, self.vertsOf(t, r), cell, ringHalf(t, r), near, far, ws));
        total = total + t.maxInstances;
        r = r + 1u32;
      }
      i = i + 1usize;
    }
    if u64.from(total) * 48u64 > MAX_STORAGE_BUFFER_BINDING_SIZE {
      print <- "groundcover: the instance buffer would be over the 128 MB storage limit; lower maxInstances\n";
      return false;
    }
    batchCount = u32.from(batches.len());
    device.queue.releaseBuffer(&mut instances);
    instances = device.createBuffer(u64.from(total) * 48u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    device.queue.releaseBuffer(&mut counters);
    counters = device.createBuffer(u64.from(batchCount) * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    device.queue.clearBuffer(&counters, 0u64, u64.from(batchCount) * 4u64);
    device.queue.releaseBuffer(&mut args);
    args = device.createBuffer(u64.from(batchCount) * u64.from(ARGS_WORDS) * 4u64,
      BUFFER_USAGE_STORAGE | BUFFER_USAGE_INDIRECT | BUFFER_USAGE_COPY_DST | BUFFER_USAGE_COPY_SRC);
    var argWords = List[u32].withCapacity(usize.from(batchCount) * 8usize);
    i = 0usize;
    while i < batches.len() {
      let b = batches[i];
      argWords.push(b.verts); argWords.push(0u32); argWords.push(0u32); argWords.push(0u32);
      argWords.push(b.cap); argWords.push(0u32); argWords.push(0u32); argWords.push(0u32);
      i = i + 1usize;
    }
    let aw = argWords.view();
    device.queue.writeBuffer(&args, 0u64, &aw[0] as *u8, u64.from(batchCount) * u64.from(ARGS_WORDS) * 4u64);
    device.queue.releaseBuffer(&mut readback);
    readback = device.createBuffer(u64.from(batchCount) * u64.from(ARGS_WORDS) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
    // The meshes (at least one vertex, so the binding is valid)
    device.queue.releaseBuffer(&mut meshBuffer);
    if meshData.len() == 0usize { meshData.resize(8usize, 0.); }
    meshBuffer = device.createBuffer(u64.from(meshData.len()) * 4u64, BUFFER_USAGE_STORAGE | BUFFER_USAGE_COPY_DST);
    let mv = meshData.view();
    device.queue.writeBuffer(&meshBuffer, 0u64, &mv[0] as *u8, u64.from(meshData.len()) * 4u64);
    // The bind groups over the new resources
    mapsView = mapsTexture.createView();
    farView = farTexture.createView();
    computeGroup = computeGroupOf(device, &computeLayout, &frameBuffer, &typesBuffer, &mapsView, &instances, &counters, &args);
    drawGroup = drawGroupOf(device, &drawLayout, &frameBuffer, &typesBuffer, &mapsView, &instances, &meshBuffer, &farView, &sampler);
    built = computeGroup.isValid() && drawGroup.isValid();
    built
  }

  // Type 'index' of 'types' into slot 'slot' of the packed words (cover.slang's CoverGpu)
  fn packType(self: &, w: &mut Array[u32, 1344], slot: usize, types: &List[CoverType], index: usize) {
    let t = types[index];
    let at = slot * TYPE_WORDS;
    var k = 0usize;
    while k < SIGNALS {
      let win = t.windowOf(k);
      putVec4(w, at + k * 4usize, win.a, win.b, win.c, win.d);
      k = k + 1usize;
    }
    putVec4(w, at + 32usize, t.density, t.clusterRadius, t.cellFactor, t.patchScale);
    putVec4(w, at + 36usize, t.patchThreshold, t.patchSoftness, t.patchFloor, t.sizeNoise);
    putVec4(w, at + 40usize, t.sizeMin, t.sizeMax, t.widthMin, t.widthMax);
    putVec4(w, at + 44usize, t.lean, t.bend, t.wind, t.translucency);
    putVec4(w, at + 48usize, t.baseColor.red, t.baseColor.green, t.baseColor.blue, t.variation);
    putVec4(w, at + 52usize, t.tipColor.red, t.tipColor.green, t.tipColor.blue, t.dryAmount);
    putVec4(w, at + 56usize, t.altColor.red, t.altColor.green, t.altColor.blue, t.albedoNoise);
    putVec4(w, at + 60usize, t.dryColor.red, t.dryColor.green, t.dryColor.blue, t.alignment);
    putVec4(w, at + 64usize, t.flower.red, t.flower.green, t.flower.blue, t.sink);
    putVec4(w, at + 68usize, t.flowerCenter.red, t.flowerCenter.green, t.flowerCenter.blue, f32.from(t.petals));
    putVec4(w, at + 72usize, t.range, t.fadeStart, t.ringStep, f32.from(t.rings));
    putVec4(w, at + 76usize, t.ringEnd[0usize], t.ringEnd[1usize], t.ringEnd[2usize], 0.);
    var q = 0usize;
    while q < MAX_INTERACTIONS {
      if q < t.interactions.len() {
        let ia = t.interactions[q];
        putVec4(w, at + 80usize + q * 4usize, f32.from(ia.other), f32.from(ia.kind), ia.radius, ia.strength);
      }
      q = q + 1usize;
    }
    w[at + 96usize] = t.kind;
    w[at + 97usize] = t.perCluster;
    w[at + 98usize] = typeSeed(t, index);
    w[at + 99usize] = needMask(types, index);
    var ring = 0usize;
    while ring < 3usize {
      var first = 0u32;
      var count = 0u32;
      var radius = 0f32;
      let mi = t.meshes[ring];
      if t.kind == KIND_MESH && mi >= 0i32 && usize.from(u32.from(mi)) < meshes.len() {
        let me = meshes[usize.from(u32.from(mi))];
        first = me.first;
        count = me.count;
        radius = me.radius;
      }
      w[at + 100usize + ring] = first;
      w[at + 104usize + ring] = count;
      w[at + 108usize + ring] = radius as u32;
      ring = ring + 1usize;
    }
    w[at + 103usize] = t.bladesPerTuft;
    w[at + 107usize] = u32.from(t.interactions.len());
  }

  // Write the frame's uniforms (render does it; a caller that only 'place's does it first)
  pub fn writeFrame(self: &mut, device: &mut Device, camera: &Camera, aspect: f32, env: &CoverEnvironment) {
    let viewProjection = camera.projectionMatrix(aspect) * camera.viewMatrix();
    let eye = camera.position();
    var f = Array[f32, 68]() <- fill 0f;
    var k = 0usize;
    while k < 16usize {
      f[k] = viewProjection.m[k];
      k = k + 1usize;
    }
    f[16] = eye.x; f[17] = eye.y; f[18] = eye.z; f[19] = env.time;
    let toLight = Vec3(0., 0., 0.) - env.light.direction;
    f[20] = toLight.x; f[21] = toLight.y; f[22] = toLight.z; f[23] = env.exposure;
    f[24] = env.light.color.red; f[25] = env.light.color.green; f[26] = env.light.color.blue;
    f[28] = env.light.ambient.red; f[29] = env.light.ambient.green; f[30] = env.light.ambient.blue;
    let wl = (env.windX * env.windX + env.windZ * env.windZ).sqrt();
    if wl > 0.00001 {
      f[32] = env.windX / wl; f[33] = env.windZ / wl;
    } else {
      f[32] = 1.; f[33] = 0.;
    }
    f[34] = env.windSpeed; f[35] = env.gust;
    f[36] = mapRect.x; f[37] = mapRect.y; f[38] = mapRect.z; f[39] = mapRect.w;
    f[40] = if env.cull { 6. } else { 0. };
    f[41] = 0.;
    f[42] = env.farBlend;
    // The frustum's planes (Gribb and Hartmann), normalised, for depth 0 to 1
    let m = viewProjection.m;
    var p = 0usize;
    while p < 6usize {
      var a = 0f32; var b = 0f32; var c = 0f32; var d = 0f32;
      if p == 0usize { a = m[3] + m[0]; b = m[7] + m[4]; c = m[11] + m[8]; d = m[15] + m[12]; }
      else if p == 1usize { a = m[3] - m[0]; b = m[7] - m[4]; c = m[11] - m[8]; d = m[15] - m[12]; }
      else if p == 2usize { a = m[3] + m[1]; b = m[7] + m[5]; c = m[11] + m[9]; d = m[15] + m[13]; }
      else if p == 3usize { a = m[3] - m[1]; b = m[7] - m[5]; c = m[11] - m[9]; d = m[15] - m[13]; }
      else if p == 4usize { a = m[2]; b = m[6]; c = m[10]; d = m[14]; }
      else { a = m[3] - m[2]; b = m[7] - m[6]; c = m[11] - m[10]; d = m[15] - m[14]; }
      let len = (a * a + b * b + c * c).sqrt();
      f[44usize + p * 4usize] = a / len;
      f[45usize + p * 4usize] = b / len;
      f[46usize + p * 4usize] = c / len;
      f[47usize + p * 4usize] = d / len;
      p = p + 1usize;
    }
    device.queue.writeBuffer(&frameBuffer, 0u64, &f as *u8, u64.from(FRAME_WORDS) * 4u64);
  }

  // Record the frame: place the cover the camera needs, then draw it into
  // 'target' (what render drew the scene into, its contents kept), tested
  // against and written into 'depth' (kept by render's 'keepDepth'). Two
  // passes in 'encoder': the compute pass, then the render pass.
  pub fn render(self: &mut, device: &mut Device, encoder: &mut CommandEncoder, target: &Texture, depth: &Texture,
      camera: &Camera, env: &CoverEnvironment) {
    drawCalls = 0u32;
    if !built || target.width == 0u32 || target.height == 0u32 { return; }
    let aspect = f32.from(target.width) / f32.from(target.height);
    self.writeFrame(device, camera, aspect, env);
    let eye = camera.position();
    self.place(encoder, eye.x, eye.z);
    if collectStats {
      encoder.copyBufferToBuffer(&args, 0u64, &readback, 0u64, u64.from(batchCount) * u64.from(ARGS_WORDS) * 4u64);
    }
    self.draw(encoder, target, depth);
  }

  // The compute half: place the instances for a camera at (camX, camZ)
  pub fn place(self: &mut, encoder: &mut CommandEncoder, camX: f32, camZ: f32) {
    var pass = encoder.beginComputePass();
    pass.setPipeline(&generatePipeline);
    pass.setBindGroup(0u32, &computeGroup);
    var i = 0usize;
    while i < batches.len() {
      let b = batches[i];
