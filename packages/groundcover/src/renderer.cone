      }
      i = i + 1usize;
    }
    pass.setPipeline(&finishPipeline);
    var g2 = Array[u32, 16]() <- fill 0u32;
    g2[14] = batchCount;
    pass.setImmediates(0u32, &g2 as *u8, 64u32);
    pass.dispatchWorkgroups((batchCount + 63u32) / 64u32, 1u32, 1u32);
    pass.end();
  }

  // The render half: draw what 'place' placed
  pub fn draw(self: &mut, encoder: &mut CommandEncoder, target: &Texture, depth: &Texture) {
    let color = RenderPassColorAttachment(view: target.createView(), loadOp: LOAD_OP_LOAD,
      clearValue: Color(0., 0., 0., 0.));
    let depthAttachment = RenderPassDepthStencilAttachment(view: depth.createView(), depthLoadOp: LOAD_OP_LOAD,
      depthStoreOp: STORE_OP_STORE);
    var pass = encoder.beginRenderPassWithDepth(&color, &depthAttachment);
    pass.setPipeline(&drawPipeline);
    pass.setBindGroup(0u32, &drawGroup);
    var i = 0usize;
    while i < batches.len() {
      let b = batches[i];
      if b.verts > 0u32 {
        var d = Array[u32, 4]() <- fill 0u32;
        d[0] = b.typeIndex; d[1] = b.ring; d[2] = b.base; d[3] = debugMode;
        pass.setImmediates(0u32, &d as *u8, 16u32);
        pass.drawIndirect(&args, u64.from(i) * u64.from(ARGS_WORDS) * 4u64);
        drawCalls = drawCalls + 1u32;
      }
      i = i + 1usize;
    }
    pass.end();
  }

  // The instances each batch placed last frame, raw (before its capacity
  // clamp), for a renderer with 'collectStats' set, once the GPU is idle.
  // Indexed as the batches: type by type, ring by ring.
  pub fn batchCounts(self: &) List[u32] {
    var out = List[u32].empty();
    let p = readback.mappedRange() as *u32;
    var i = 0usize;
    while i < batches.len() {
      out.push(*(p + (i * 8usize + 5usize)));
      i = i + 1usize;
    }
    out
  }

  // The batch number of type 'typeIndex' in 'ring'
  pub fn batchOf(self: &, typeIndex: u32, ring: u32) i32 {
    var i = 0usize;
    while i < batches.len() {
      if batches[i].typeIndex == typeIndex && batches[i].ring == ring { return i32.from(i); }
      i = i + 1usize;
    }
    0i32 - 1i32
  }
}

fn computeGroupOf(device: &mut Device, layout: &BindGroupLayout, frame: &Buffer, types: &Buffer, maps: &TextureView,
    instances: &Buffer, counters: &Buffer, args: &Buffer) BindGroup {
  let entries = [BindGroupEntry.buffer(0u32, frame), BindGroupEntry.buffer(1u32, types), BindGroupEntry.texture(2u32, maps),
    BindGroupEntry.buffer(3u32, instances), BindGroupEntry.buffer(4u32, counters), BindGroupEntry.buffer(5u32, args)];
  device.createBindGroup(layout, &entries)
}

fn drawGroupOf(device: &mut Device, layout: &BindGroupLayout, frame: &Buffer, types: &Buffer, maps: &TextureView,
    instances: &Buffer, meshes: &Buffer, far: &TextureView, sampler: &Sampler) BindGroup {
  let entries = [BindGroupEntry.buffer(0u32, frame), BindGroupEntry.buffer(1u32, types), BindGroupEntry.texture(2u32, maps),
    BindGroupEntry.buffer(3u32, instances), BindGroupEntry.buffer(4u32, meshes), BindGroupEntry.texture(5u32, far),
    BindGroupEntry.sampler(6u32, sampler)];
  device.createBindGroup(layout, &entries)
}

fn putVec4(w: &mut Array[u32, 1344], at: usize, a: f32, b: f32, c: f32, d: f32) {
  w[at] = a as u32;
  w[at + 1usize] = b as u32;
  w[at + 2usize] = c as u32;
  w[at + 3usize] = d as u32;
}

// Blades in a tuft in ring 'ring' (draw.slang's bladesOf): fewer, wider ones farther out
pub fn bladesOf(perTuft: u32, ring: u32) u32 {
  var b = f32.from(perTuft);
  var r = 0u32;
  while r < ring {
    b = b * 0.65;
    r = r + 1u32;
  }
  let n = u32.from(libc.floorf(b));
  if n < 3u32 { return 3u32; }
  n
}

// Segments of a blade in ring 'ring'
pub fn segmentsOf(ring: u32) u32 { if ring < 2u32 { 4u32 - ring } else { 2u32 } }

pub fn flowerSegments(ring: u32) u32 { if ring < 1u32 { 3u32 } else { 2u32 } }

pub fn patchGrid(ring: u32) u32 { if ring < 2u32 { 6u32 - 2u32 * ring } else { 2u32 } }

