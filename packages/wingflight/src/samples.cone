// Plain wings for tests and demos: made of numbers, no species.
//
// 'plainFeathers' adds three fans of feathers to each wing of a spec made by creaturerig's plainBody (or any spec whose
// wings are chains named "wing.R" and "wing.L" of four bones, the shoulder, elbow, wrist and hand): primaries from the
// wrist's segment, long and spread toward the tip; secondaries from the forearm's, nearly straight back; tertials from
// the upper arm's, shorter. 'plainMembrane' instead adds three fingers a wing from the wrist, and
// 'plainMembraneStrips' the skin stretched between the arm, the fingers and the body.

pub fn plainFeathers(spec &mut RigSpec) {
  imm sides = ["wing.R", "wing.L"];
  imm tags = ["feather.R.p", "feather.L.p"];
  imm stags = ["feather.R.s", "feather.L.s"];
  imm ttags = ["feather.R.t", "feather.L.t"];
  mut s = 0usize;
  while s < 2usize {
    // Primaries: from the wrist's segment (bone 2), angles 0.10 to 0.60 rad, lengths 0.30 to 0.22
    addFeatherFan(spec, tags[s], sides[s], 2usize, 8u32, 0.10, 1.0, 0.10, 0.60, 0.30, 0.22, 0.006);
    // Secondaries: from the forearm's (bone 1), nearly straight back
    addFeatherFan(spec, stags[s], sides[s], 1usize, 9u32, 0.0, 1.0, 1.30, 1.10, 0.27, 0.22, 0.006);
    // Tertials: from the upper arm's (bone 0)
    addFeatherFan(spec, ttags[s], sides[s], 0usize, 5u32, 0.2, 1.0, 1.20, 1.40, 0.22, 0.18, 0.006);
    s = s + 1usize;
  }
}

// Three fingers on each wing: chains of kind KIND_OTHER named wing.R.f0, f1, f2 (and wing.L...), a root at the wrist
// and a tip out along the finger
pub fn plainMembrane(spec &mut RigSpec) {
  imm sides = ["wing.R", "wing.L"];
  imm names = ["wing.R.f", "wing.L.f"];
  mut s = 0usize;
  while s < 2usize {
    imm sgn = if s == 0usize { 1.; } else { -1.; };
    imm angles = [0.12, 0.65, 1.15];
    imm lens = [0.36, 0.34, 0.28];
    mut k = 0usize;
    while k < 3usize {
      mut cname = String.from(names[s]);
      cname <- i64.from(k);
      imm c = spec.chain(cname.view(), KIND_OTHER, sides[s], 2i32);
      spec.bone(c, "root", new Vec3(0., 0., 0.), 0.008);
      spec.bone(c, "tip", new Vec3(sgn * lens[k] * cos(angles[k]), 0., lens[k] * sin(angles[k])), 0.006);
      k = k + 1usize;
    }
    s = s + 1usize;
  }
}

// The skin between arm, fingers and body, of a rig built from plainMembrane: for each wing the strip from the arm to the body's
// side, then a strip between each pair of fingers
pub fn plainMembraneStrips(rig &Rig) List[MembraneStrip] {
  mut out = List[MembraneStrip].empty();
  imm wingNames = ["wing.R", "wing.L"];
  imm fingerNames = ["wing.R.f", "wing.L.f"];
  mut s = 0usize;
  while s < 2usize {
    imm wc = rig.chainIndex(wingNames[s]);
    if wc >= 0i32 {
      imm w = usize.from(wc);
      imm shoulder = *rig.chains[w].bones[0usize];
      imm elbow = *rig.chains[w].bones[1usize];
      imm wrist = *rig.chains[w].bones[2usize];
      // The body's side: the spine's bones, behind them
      imm sc = usize.from(rig.chainIndex("spine"));
      imm sn = rig.chains[sc].bones.len();
      imm b0 = *rig.chains[sc].bones[sn - 1usize];
      imm b1 = *rig.chains[sc].bones[sn / 2usize];
      imm b2 = *rig.chains[sc].bones[0usize];
      mut a = List[Anchor].empty();
      mut b = List[Anchor].empty();
      a.push(new Anchor(shoulder, new Vec3(0., 0., 0.)));
      a.push(new Anchor(elbow, new Vec3(0., 0., 0.)));
      a.push(new Anchor(wrist, new Vec3(0., 0., 0.)));
      b.push(new Anchor(b0, new Vec3(0., 0., 0.20)));
      b.push(new Anchor(b1, new Vec3(0., 0., 0.28)));
      b.push(new Anchor(b2, new Vec3(0., 0., 0.34)));
      out.push(new MembraneStrip(a, b, 4u32));
      // Between the fingers: finger k's root and tip against finger k+1's
      mut k = 0usize;
      while k < 2usize {
        mut n0 = String.from(fingerNames[s]);
        n0 <- i64.from(k);
        mut n1 = String.from(fingerNames[s]);
        n1 <- i64.from(k + 1usize);
        imm f0 = usize.from(rig.chainIndex(n0.view()));
        imm f1 = usize.from(rig.chainIndex(n1.view()));
        mut fa = List[Anchor].empty();
        mut fb = List[Anchor].empty();
        fa.push(new Anchor(rig.chains[f0].first(), new Vec3(0., 0., 0.)));
        fa.push(new Anchor(rig.chains[f0].last(), new Vec3(0., 0., 0.)));
        fb.push(new Anchor(rig.chains[f1].first(), new Vec3(0., 0., 0.)));
        fb.push(new Anchor(rig.chains[f1].last(), new Vec3(0., 0., 0.)));
        out.push(new MembraneStrip(fa, fb, 4u32));
        k = k + 1usize;
      }
      // From the last finger to the body: its root and tip against the body's side
      imm last = usize.from(rig.chainIndex(String.from(fingerNames[s]).view())) ;
      imm f2name = String.from(fingerNames[s]);
      mut f2 = f2name.copy();
      f2 <- "2";
      imm f2c = usize.from(rig.chainIndex(f2.view()));
      mut ga = List[Anchor].empty();
      mut gb = List[Anchor].empty();
      ga.push(new Anchor(rig.chains[f2c].first(), new Vec3(0., 0., 0.)));
      ga.push(new Anchor(rig.chains[f2c].last(), new Vec3(0., 0., 0.)));
      gb.push(new Anchor(b1, new Vec3(0., 0., 0.28)));
      gb.push(new Anchor(b2, new Vec3(0., 0., 0.34)));
      out.push(new MembraneStrip(ga, gb, 4u32));
    }
    s = s + 1usize;
  }
  out;
}
