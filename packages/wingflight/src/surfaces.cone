// Wing surfaces as data: feather fans, and membranes.
//
// FEATHERS. A feather is a chain of kind KIND_FEATHER, two bones (root and tip) hung from a bone of the wing, lying in
// the wing's plane at an angle to the span. `addFeatherFan` adds a FAN of them to a RigSpec: `count` feathers along the
// segment of a wing bone, their roots spaced from fraction t0 to t1 of the segment, their angles from the span going from
// angle0 to angle1 toward the trailing edge, their lengths from len0 to len1. Primaries are a fan on the hand's segment
// (angles near 0, long), secondaries a fan on the forearm's (angles near 80 degrees, shorter), tertials on the
// upper arm. 'featherMesh' makes the blades of every feather chain in a rig: a flat leaf, widest at 40% of its length,
// double sided, weighted to the feather's root and tip bones so the tip can bend.
//
// MEMBRANES. A membrane is a skin stretched between lines of anchors on the bones (a bat's, a pterosaur's, a wing
// with a patagium). An anchor is a point fixed in a bone's frame; a STRIP is two lines of anchors, the leading line
// and the trailing line, with equal numbers; the surface is the ladder between them, each rung cut into
// `subdivisions` pieces, and each vertex weighted to the two bones its rung ends on in proportion to its place along
// the rung, so the skin follows both the bones and stretches between them. `membraneMesh` makes it.
//
// Both make a Mesh and per-vertex weights (creaturerig's VertexWeights, four joints and weights a vertex) at the
// rig's REST pose. A program draws them by turning the weights into render's Skin, as for a body mesh.

// A mesh and the weights that bind it to a rig
pub struct SkinnedMesh {
  pub mesh Mesh;
  pub skin VertexWeights;
}

fn pushWeights(skin &mut VertexWeights, j0 usize, j1 usize, w1 f32) {
  skin.joints.push(u32.from(j0));
  skin.joints.push(u32.from(j1));
  skin.joints.push(0u32);
  skin.joints.push(0u32);
  skin.weights.push(1. - w1);
  skin.weights.push(w1);
  skin.weights.push(0.);
  skin.weights.push(0.);
}

// Add a fan of `count` feathers to chain `wingChain` of the spec, hung from its bone number `onBone`
// (counting from the shoulder, 0). Feathers are named `name` and a number. Returns how many were added.
pub fn addFeatherFan(spec &mut RigSpec, name &str, wingChain &str, onBone usize, count u32, t0 f32, t1 f32,
    angle0 f32, angle1 f32, len0 f32, len1 f32, radius f32) u32 {
  let wc = spec.find(wingChain);
  if wc < 0i32 { return 0u32; }
  let w = usize.from(wc);
  let nb = spec.chains[w].bones.len();
  if onBone + 1usize >= nb { return 0u32; }
  let seg = spec.chains[w].bones[onBone + 1usize].offset;
  let x0 = spec.chains[w].bones[0usize].offset.x;
  let side = if x0 < 0. { -1.; } else { 1.; };
  let n = usize.from(count);
  var i = 0usize;
  while i < n {
    let f = if n > 1usize { f32.from(i) / f32.from(n - 1usize); } else { 0.5; };
    let t = t0 + (t1 - t0) * f;
    let phi = angle0 + (angle1 - angle0) * f;
    let len = len0 + (len1 - len0) * f;
    var cname = String.from(name);
    cname <- i64.from(i);
    let c = spec.chain(cname.view(), KIND_FEATHER, wingChain, i32.from(onBone));
    spec.bone(c, "root", seg * t, radius);
    spec.bone(c, "tip", new Vec3(side * len * cos(phi), 0., len * sin(phi)), radius * 0.7);
    i = i + 1usize;
  }
  count;
}

// The blades of every feather chain of the rig, at the rest pose. `width` is the widest a blade gets as a fraction of its
// length, `rows` the pieces along it.
pub fn featherMesh(rig &Rig, width f32, rows u32) SkinnedMesh {
  var m = Mesh.empty();
  var skin = new VertexWeights(List[u32].empty(), List[f32].empty(), 0u32);
  let nr = if rows < 2u32 { 2usize; } else { usize.from(rows); };
  var c = 0usize;
  while c < rig.chains.len() {
    if rig.chains[c].kind == KIND_FEATHER and rig.chains[c].bones.len() >= 2usize {
      let root = rig.chains[c].first();
      let tip = rig.chains[c].last();
      let r = rig.restPosition(root);
      let t = rig.restPosition(tip);
      let d = t - r;
      let len = d.length();
      if len > 0.0001 {
        let dir = d * (1. / len);
        let w = new Vec3(0. - dir.z, 0., dir.x).normalize();
        let base = u32.from(m.positions.len());
        var k = 0usize;
        while k <= nr {
          let f = f32.from(k) / f32.from(nr);
          // A leaf: zero at both ends, widest about 40% along
          let shape = sin(pi * libc.powf(f, 0.7));
          let hw = 0.5 * width * len * shape;
          let p = r + d * f;
          let tipWeight = f * f;
          // Two vertices a row, left and right, each on both faces: top (normal +y) then bottom (normal -y)
          var side = 0usize;
          while side < 2usize {
            let sgn = if side == 0usize { 1.; } else { -1.; };
            m.positions.push(p + w * (hw * sgn));
            m.normals.push(new Vec3(0., 1., 0.));
            pushWeights(&mut skin, root, tip, tipWeight);
            side = side + 1usize;
          }
          side = 0usize;
          while side < 2usize {
            let sgn = if side == 0usize { 1.; } else { -1.; };
            m.positions.push(p + w * (hw * sgn));
            m.normals.push(new Vec3(0., -1., 0.));
            pushWeights(&mut skin, root, tip, tipWeight);
            side = side + 1usize;
          }
          k = k + 1usize;
        }
        // Row k's vertices: top left 4k, top right 4k+1, bottom left 4k+2, bottom right 4k+3
        k = 0usize;
        while k < nr {
          let l0 = base + u32.from(4usize * k);
          let r0 = l0 + 1u32;
          let l1 = base + u32.from(4usize * (k + 1usize));
          let r1 = l1 + 1u32;
          m.indices.push(l0); m.indices.push(l1); m.indices.push(r0);
          m.indices.push(r0); m.indices.push(l1); m.indices.push(r1);
          let bl0 = l0 + 2u32;
          let br0 = r0 + 2u32;
          let bl1 = l1 + 2u32;
          let br1 = r1 + 2u32;
          m.indices.push(bl0); m.indices.push(br0); m.indices.push(bl1);
          m.indices.push(br0); m.indices.push(br1); m.indices.push(bl1);
          k = k + 1usize;
        }
      }
    }
    c = c + 1usize;
  }
  new SkinnedMesh(m, skin);
}

// ---------------------------------------------------------------------------- membranes

// A point fixed in a bone: its place is the bone's rest position plus `offset`
pub struct Anchor {
  pub bone usize;
  pub offset Vec3;
}

pub struct MembraneStrip {
  pub a List[Anchor];            // the leading line
  pub b List[Anchor];            // the trailing line, as many anchors
  pub subdivisions u32;          // pieces a rung is cut into
}

// The ladder between the two lines of every strip, both faces
pub fn membraneMesh(rig &Rig, strips &List[MembraneStrip]) SkinnedMesh {
  var m = Mesh.empty();
  var skin = new VertexWeights(List[u32].empty(), List[f32].empty(), 0u32);
  var s = 0usize;
  while s < strips.len() {
    let st = strips[s];
    let n = st.a.len();
    let sub = if st.subdivisions < 1u32 { 1usize; } else { usize.from(st.subdivisions); };
    if st.b.len() == n and n >= 2usize {
      let base = u32.from(m.positions.len());
      var k = 0usize;
      while k < n {
        let pa = rig.restPosition(st.a[k].bone) + st.a[k].offset;
        let pb = rig.restPosition(st.b[k].bone) + st.b[k].offset;
        var j = 0usize;
        while j <= sub {
          let v = f32.from(j) / f32.from(sub);
          let p = pa + (pb - pa) * v;
          // Top then bottom, the same place, opposite normals
          m.positions.push(p);
          m.normals.push(new Vec3(0., 1., 0.));
          pushWeights(&mut skin, st.a[k].bone, st.b[k].bone, v);
          m.positions.push(p);
          m.normals.push(new Vec3(0., -1., 0.));
          pushWeights(&mut skin, st.a[k].bone, st.b[k].bone, v);
          j = j + 1usize;
        }
        k = k + 1usize;
      }
      // A rung has (sub + 1) places of two vertices each
      let rung = u32.from((sub + 1usize) * 2usize);
      // Which way the strip runs decides which winding faces up: along a rung (leading to trailing) crossed with
      // along the lines; if that points down, the winding is reversed
      let pa0 = rig.restPosition(st.a[0usize].bone) + st.a[0usize].offset;
      let pb0 = rig.restPosition(st.b[0usize].bone) + st.b[0usize].offset;
      let pa1 = rig.restPosition(st.a[1usize].bone) + st.a[1usize].offset;
      let flip = (pb0 - pa0).cross(pa1 - pa0).y < 0.;
      k = 0usize;
      while k + 1usize < n {
        var j = 0usize;
        while j < sub {
          let i00 = base + u32.from(k) * rung + u32.from(j * 2usize);
          let i01 = i00 + 2u32;
          let i10 = i00 + rung;
          let i11 = i10 + 2u32;
          // Top is the first of each pair of vertices, bottom the second
          if !flip {
            m.indices.push(i00); m.indices.push(i01); m.indices.push(i10);
            m.indices.push(i01); m.indices.push(i11); m.indices.push(i10);
            m.indices.push(i00 + 1u32); m.indices.push(i10 + 1u32); m.indices.push(i01 + 1u32);
            m.indices.push(i01 + 1u32); m.indices.push(i10 + 1u32); m.indices.push(i11 + 1u32);
          } else {
            m.indices.push(i00); m.indices.push(i10); m.indices.push(i01);
            m.indices.push(i01); m.indices.push(i10); m.indices.push(i11);
            m.indices.push(i00 + 1u32); m.indices.push(i01 + 1u32); m.indices.push(i10 + 1u32);
            m.indices.push(i01 + 1u32); m.indices.push(i11 + 1u32); m.indices.push(i10 + 1u32);
          }
          j = j + 1usize;
        }
        k = k + 1usize;
      }
    }
    s = s + 1usize;
  }
  new SkinnedMesh(m, skin);
}
