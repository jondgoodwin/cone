// The flight model: a steady glide, a banking turn, a takeoff, a landing.
//
// Glide, by hand, for the plain winged test body (span 1.449 m, area 0.2824 m^2, aspect 7.435, mass 1 kg, lift slope
// 4.951, body drag area 0.0035 m^2, wing dihedral 0.12 rad): flown at an angle of attack of 0.08 rad plus the 0.05 rad
// setting angle, CL = 4.951 x 0.13 = 0.6436, the wings' CD = 0.02 + 0.6436^2 / (pi x 0.85 x 7.435) = 0.04086; the body adds
// 0.0035 / 0.2824 = 0.01239; so D/L = 0.05325 / (0.6436 x cos 0.12 = 0.6390) = 0.0833, a glide angle of 4.76 degrees and a
// speed from lift cos(glide) = weight: V = sqrt(2 x 9.81 / (1.225 x 0.2824 x 0.6390 x cos 4.76)) = 9.44 m/s.
// A turn: a level coordinated turn at bank phi turns at g tan(phi) / V.

mod flight;

import stdio use *;
import testing use *;
import collections use *;
import geomath use *;
import bonepose use *;
import creaturerig use *;
import wingflight use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool {
  expectFloat(f64.from(got), f64.from(want), f64.from(within), label);
}

fn flat(x f32, z f32) f32 { 0.; }

fn plainWing() WingParams {
  mut spec = plainBody(&BodyParams.winged());
  plainFeathers(&mut spec);
  mut b = buildRig(&spec);
  imm rig = b.take();
  imm wings = findWings(&rig);
  estimateWing(&rig, &wings, 1.0);
}

fn airborne(p WingParams, y f32, speed f32) Flier {
  mut f = Flier.make(p, new Vec3(0., y, 0.), 0., 0.4, new Vec3(0., 0.4, 0.));
  f.onGround = false;
  f.vel = new Vec3(0., 0., -speed);
  f.motion.fold = 0.;
  f.tuck = 1.;
  f;
}

fn main() i32 {
  imm p = plainWing();
  expectBool(p.span > 1.3 and p.span < 1.6 and p.area > 0.25 and p.area < 0.4, true, "a span near 1.45 m and an area near 0.3 m^2");
  // The theory for these numbers, as worked above
  imm ar = p.aspectRatio();
  imm cl = 2. * pi / (1. + 2. / ar) * (0.08 + p.incidence);
  imm cdTotal = p.cd0 + cl * cl / (pi * p.oswald * ar) + p.bodyDragArea / p.area;
  imm lift = cl * cos(p.glideDihedral);
  imm gammaTheory = atan2(cdTotal, lift);
  imm vTheory = (2. * 9.81 / (RHO * p.area * lift * cos(gammaTheory))).sqrt();

  // The glide: no flapping, a fixed angle of attack, bank 0
  mut g = airborne(p.copy(), 300., 12.);
  g.alpha = 0.08;
  imm goal = Goal.make(new Vec3(0., 300., -4000.), 11., true);
  g.mode = MODE_GLIDE;
  mut k = 0;
  while k < 60 * 40 {
    g.step(1. / 60., new Commands(0., 0.08, 0., 0., 0.), &goal, &flat);
    k = k + 1;
  }
  near(g.speed(), vTheory, 0.05 * vTheory, "the glide settles at the speed lift = weight gives (within 5%)");
  imm gamma = degrees(asin(-g.vel.y / g.speed()));
  near(gamma, degrees(gammaTheory), 0.6, "on the glide angle D/L gives (within 0.6 degree)");

  // A level turn: hold the height with the autopilot, bank by a goal to the right, compare the turn with g tan(phi) / V
  mut t = airborne(p.copy(), 100., 11.);
  mut tg = Goal.make(new Vec3(1000., 100., 0.), 11., true);
  tg.maxBank = 0.45;
  t.mode = MODE_CRUISE;
  mut yawA f32 = 0.;
  mut bankSum f32 = 0.;
  mut speedSum f32 = 0.;
  mut yawB f32 = 0.;
  mut n = 0.;
  k = 0;
  while k < 60 * 4 {
    t.update(1. / 60., &tg, &flat);
    if k == 60 * 2 { yawA = t.yaw; }
    if k == 60 * 3 { yawB = t.yaw; }
    if k >= 60 * 2 and k < 60 * 3 { bankSum = bankSum + t.bank; speedSum = speedSum + t.speed(); n = n + 1.; }
    k = k + 1;
  }
  imm rate = absf(yawB - yawA) / 1.;
  imm expected = 9.81 * tan(bankSum / n) / (speedSum / n);
  eprint <- "turn: "; eprint <- rate; eprint <- " rad/s against g tan(bank)/V = "; eprint <- expected; eprint <- " at bank "; eprint <- bankSum / n; eprint <- "\n";
  near(rate, absf(expected), 0.12 * absf(expected), "the turn rate is g tan(bank) / V within 12%");
  expectBool(bankSum / n > 0.3, true, "banked to the right (positive)");
  expectBool(absf(t.pos.y - 100.) < 3., true, "and held within 3 m of its height");

  // Takeoff, climb, landing
  mut f = Flier.make(p.copy(), new Vec3(0., 0., 0.), 0., 0.4, new Vec3(0., 0.4, 0.));
  mut fg = Goal.make(new Vec3(0., 14., -400.), 11.5, true);
  mut reached = false;
  mut tAir = 0.;
  mut maxY f32 = 0.;
  mut stage = 0;
  mut lastVy f32 = 0.;
  mut lastAirY f32 = 0.;
  mut landed = false;
  mut tLand = 0.;
  k = 0;
  while k < 60 * 100 and !landed {
    f.update(1. / 60., &fg, &flat);
    if f.pos.y > maxY { maxY = f.pos.y; }
    if tAir == 0. and !f.onGround { tAir = f32.from(k) / 60.; }
    if stage == 0 and f.pos.y > 12. {
      stage = 1;
      fg = Goal.make(new Vec3(f.pos.x, 0., f.pos.z - 130.), 11., false);
    }
    if stage == 1 {
      if !f.onGround { lastVy = f.vel.y; lastAirY = f.pos.y; }
      if f.onGround and f.speed() < 0.05 { landed = true; tLand = f32.from(k) / 60.; }
    }
    k = k + 1;
  }
  expectBool(tAir > 0. and tAir < 6., true, "it takes off within 6 s");
  expectBool(maxY > 12., true, "and climbs to 12 m");
  expectBool(landed, true, "and lands, stopped, within 100 s");
  expectBool(lastVy > -2.5, true, "touching down at under 2.5 m/s of sink");
  expectBool(new Vec2(f.pos.x - fg.target.x, f.pos.z - fg.target.z).length() < 40., true, "within 40 m of the point it was sent to");
  expectUInt(u64.from(f.mode), u64.from(MODE_GROUNDED), "in the grounded mode");
  done();
}
