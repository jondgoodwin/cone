// People made of blends, measured: the base body's own blend weights are none, and a person made of blends meets
// their measures as a direct sculpt does (within 7 per cent). Apart from people.cone because building a sex's 29
// blends is most of a debug build's minute.

mod blends;

import testing use *;
import stdio use *;
import collections use List, String;
import geomath use *;
import bonepose use *;
import humanbody use *;

fn near(got f32, want f32, within f32, label &Array[u8]) bool { expectFloat(f64.from(got), f64.from(want), f64.from(within), label) }

fn testBlends() {
  let set = buildBlendSet(MALE, 1u32);
  // the base's own weights are none
  let w0 = blendWeights(&set, &set.base.measures);
  var most = 0.f;
  var i = 0usize;
  while i < w0.len() { most = maxf(most, absf(*w0[i])); i = i + 1usize; }
  expect(most < 0.001, "the base is the base: no blend");
  // a person of blends meets their measures
  let people = cast();
  let p = people[0usize];
  let b = personBody(&set, &p.measures);
  let meas = measuredOfBody(&b);
  let models = restModels(&b.skeleton);
  near(b.measures.height, p.measures.height, 0.0001, "the person's height");
  i = 1usize;
  while i < 14usize {
    if i != 9usize and i != 6usize and i != 7usize and i != 8usize {
      let want = measureAt(&p.measures, i);
      expect(absf(meas.measure(i, &models) - want) <= 0.07 * want, "a blended measure is the person's");
    }
    i = i + 1usize;
  }
}

fn main() i32 {
  testBlends();
  done()
}
