// The body's surface: the cage subdivided, then projected onto the forms and relaxed.
//
// This is retopology done the other way round. An artist sculpts a dense body, then lays a clean ring mesh
// over it ("shrink-wrap" retopology, Blender's Shrinkwrap modifier, ZBrush's ZRemesher guided by loops).
// Here the clean layout comes first (cage.cone), Catmull-Clark subdivision (sculpt's) makes it a smooth
// surface of quads in the same rings, and each vertex is then moved onto the forms' surface (forms.cone):
//
//   PROJECTION: Newton's steps on the field, p - f(p) grad f / |grad f|^2, from where the subdivision put
//     the vertex, each step at most 15 mm; a vertex sees only the trunk's forms and those of the limbs it is
//     skinned to.
//   RELAXATION: a vertex drifts towards the mean of its ring neighbours across the surface (the tangential
//     part of the umbrella operator, so the shape is not shrunk), then is projected again; three rounds even
//     out the spacing the projection bunches.
//
// No marching cubes: the vertices, their rings and their order are the cage's, at every body and in every
// blend.

pub struct BodySurface {
  pub positions List[Vec3];
  pub quads List[u32];         // the subdivided faces, four corners each (the cage's five-sided and
                               // three-sided faces become quads at the first level)
  pub weights List[f32];       // HUMANOID_BONES a vertex
  pub seam List[u32];          // the neck's open ring, in order round it
  pub nbrStart List[u32];      // each vertex's edge neighbours (a CSR list)
  pub nbr List[u32];
  pub problems List[String];   // the cage's faces PolyMesh refused (none, for a good cage)

  pub fn vertexCount(self &) usize { positions.len() }

  pub fn weight(self &, v usize, b usize) f32 { *weights[v * HUMANOID_BONES + b] }

  // How much of each limb's forms a vertex is projected onto (forms.cone's distanceIn): an arm's as the
  // vertex is skinned to it; both legs, but for a vertex skinned to one leg more than the other, which
  // leaves the other out (the thighs touch: an inner thigh must find its own thigh's surface)
  pub fn reach(self &, v usize) Vec4 {
    let al = self.weight(v, UPPER_ARM_L) + self.weight(v, FOREARM_L) + self.weight(v, HAND_L);
    let ar = self.weight(v, UPPER_ARM_R) + self.weight(v, FOREARM_R) + self.weight(v, HAND_R);
    let ll = self.weight(v, THIGH_L) + self.weight(v, SHIN_L) + self.weight(v, FOOT_L);
    let lr = self.weight(v, THIGH_R) + self.weight(v, SHIN_R) + self.weight(v, FOOT_R);
    new Vec4(smoothstep(0., 0.10, al), smoothstep(0., 0.10, ar), 1. - smoothstep(0., 0.15, lr - ll), 1. - smoothstep(0., 0.15, ll - lr))
  }
}

fn weightName(b usize) String {
  var s = String.from("w");
  s.appendUInt(u64.from(b));
  s
}

// The cage subdivided 'levels' times, its weights with it; not yet projected
pub fn subdivideCage(cage &Cage, levels u32) BodySurface {
  var problems = List[String].empty();
  var pm = PolyMesh.fromPolygons(cage.positions.view(), cage.counts.view(), cage.indices.view(), &mut problems);
  var b = 0usize;
  while b < HUMANOID_BONES {
    let ch = pm.addFloatChannel(VertexDomain, weightName(b).view(), 0.);
    var v = 0usize;
    while v < cage.positions.len() {
      pm.setFloat(ch, u32.from(v), *cage.weights[v * HUMANOID_BONES + b]);
      v = v + 1usize;
    }
    b = b + 1usize;
  }
  let sub = subdivide(&pm, levels);
  let nv = sub.vertexCount();
  var out = new BodySurface(List[Vec3].empty(), List[u32].empty(), List[f32].empty(), List[u32].empty(), List[u32].empty(),
    List[u32].empty(), problems);
  var v = 0usize;
  while v < nv { out.positions.push(*sub.positions[v]); v = v + 1usize; }
  var chs = List[u32].empty();
  b = 0usize;
  while b < HUMANOID_BONES { chs.push(sub.findFloatChannel(VertexDomain, weightName(b).view())); b = b + 1usize; }
  v = 0usize;
  while v < nv {
    var sum = 0.;
    b = 0usize;
    while b < HUMANOID_BONES { sum = sum + maxf(sub.float(*chs[b], u32.from(v)), 0.); b = b + 1usize; }
    b = 0usize;
    while b < HUMANOID_BONES {
      let w = maxf(sub.float(*chs[b], u32.from(v)), 0.);
      out.weights.push(if sum > 0. { w / sum } else { 0. });
      b = b + 1usize;
    }
    v = v + 1usize;
  }
  var f = 0usize;
  while f < sub.faceCount() {
    let vs = sub.faceVertices(u32.from(f));
    var i = 0usize;
    while i < 4usize and i < vs.len() { out.quads.push(*vs[i]); i = i + 1usize; }
    f = f + 1usize;
  }
  // the neck's ring: the boundary, walked from the vertex the cage's seam starts at
  let start = *cage.seam[0usize];
  var h = sub.vertexHalfedge(start);
  // find the boundary half-edge leaving it
  let outs = sub.vertexOutgoing(start);
  var i = 0usize;
  while i < outs.len() {
    if sub.isBoundaryHalfedge(*outs[i]) { h = *outs[i]; }
    i = i + 1usize;
  }
  out.seam.push(start);
  var guard = 0usize;
  while guard < 4096usize {
    let to = sub.toVertex(h);
    if to == start { guard = 4096usize; } else {
      out.seam.push(to);
      h = sub.next(h);
      guard = guard + 1usize;
    }
  }
  // the neighbours along the edges
  var deg = List[u32].empty();
  deg.resize(nv + 1usize, 0u32);
  v = 0usize;
  while v < nv {
    deg.set(v + 1usize, u32.from(sub.vertexNeighbors(u32.from(v)).len()));
    v = v + 1usize;
  }
  v = 0usize;
  while v < nv { deg.set(v + 1usize, *deg[v + 1usize] + *deg[v]); v = v + 1usize; }
  v = 0usize;
  while v < nv {
    let ns = sub.vertexNeighbors(u32.from(v));
    var k = 0usize;
    while k < ns.len() { out.nbr.push(*ns[k]); k = k + 1usize; }
    v = v + 1usize;
  }
  out.nbrStart = deg;
  smoothWeights(&mut out, 4);
  out
}

// The skin weights spread over the surface (each vertex's half way to its neighbours' mean, 'passes' times): an
// animator's smooth brush on the weights, so where a joint's bones meet (the shoulder above all, where the trunk,
// the clavicle and the arm share the cage's patch) no vertex turns differently from its neighbours and folds
pub fn smoothWeights(s &mut BodySurface, passes i32) {
  let nv = s.positions.len();
  let nb = HUMANOID_BONES;
  var p = 0;
  while p < passes {
    var next = List[f32].empty();
    var v = 0usize;
    while v < nv {
      let lo = usize.from(*s.nbrStart[v]);
      let hi = usize.from(*s.nbrStart[v + 1usize]);
      var b = 0usize;
      while b < nb {
        var sum = 0.;
        var k = lo;
        while k < hi { sum = sum + *s.weights[usize.from(*s.nbr[k]) * nb + b]; k = k + 1usize; }
        let own = *s.weights[v * nb + b];
        next.push(if hi > lo { own * 0.5 + 0.5 * sum / f32.from(hi - lo) } else { own });
        b = b + 1usize;
      }
      v = v + 1usize;
    }
    s.weights = next;
    p = p + 1;
  }
}

// How far the surface is from the forms after projection: the mean and the largest distance, metres
pub fn fitError(s &BodySurface, forms &Forms) Vec2 {
  var sum = 0.;
  var most = 0.;
  var v = 0usize;
  while v < s.positions.len() {
    let d = absf(forms.distanceIn(*s.positions[v], s.reach(v)));
    sum = sum + d;
    if d > most { most = d; }
    v = v + 1usize;
  }
  new Vec2(sum / f32.from(s.positions.len()), most)
}

// The surface's edges (each quad's four, shared ones twice) as line indices, for a wireframe
pub fn wireIndices(s &BodySurface) List[u32] {
  var out = List[u32].empty();
  var q = 0usize;
  while q + 3usize < s.quads.len() {
    var e = 0usize;
    while e < 4usize {
      out.push(*s.quads[q + e]);
      out.push(*s.quads[q + (e + 1usize) % 4usize]);
      e = e + 1usize;
    }
    q = q + 4usize;
  }
  out
}

// One vertex moved onto the forms by Newton's steps
fn projectPoint(forms &Forms, p0 Vec3, reach Vec4, steps i32) Vec3 {
  var p = p0;
  var i = 0;
  while i < steps {
    let d = forms.distanceIn(p, reach);
    if absf(d) < 0.00005 { return p; }
    let g = forms.gradientIn(p, reach);
    let gg = g.dot(g);
    if gg < 0.000001 { return p; }
    var step = g * (d / gg);
    let len = step.length();
    if len > 0.015 { step = step * (0.015 / len); }
    p = p - step;
    i = i + 1;
  }
  p
}

// The surface projected onto the forms and relaxed: 'rounds' rounds of relaxation
pub fn projectSurface(s &mut BodySurface, forms &Forms, rounds i32) {
  let nv = s.positions.len();
  var masks = List[Vec4].empty();
  var v = 0usize;
  while v < nv { masks.push(s.reach(v)); v = v + 1usize; }
  v = 0usize;
  while v < nv { s.positions.set(v, projectPoint(forms, *s.positions[v], *masks[v], 10)); v = v + 1usize; }
  var r = 0;
  while r < rounds {
    var next = List[Vec3].empty();
    v = 0usize;
    while v < nv {
      let p = *s.positions[v];
      let lo = usize.from(*s.nbrStart[v]);
      let hi = usize.from(*s.nbrStart[v + 1usize]);
      var avg = new Vec3(0., 0., 0.);
      var k = lo;
      while k < hi { avg = avg + *s.positions[usize.from(*s.nbr[k])]; k = k + 1usize; }
      if hi > lo {
        avg = avg * (1. / f32.from(hi - lo));
        let n = forms.gradientIn(p, *masks[v]).normalize();
        let lap = avg - p;
        let t = lap - n * n.dot(lap);
        next.push(projectPoint(forms, p + t * 0.6, *masks[v], 3));
      } else {
        next.push(p);
      }
      v = v + 1usize;
    }
    s.positions = next;
    r = r + 1;
  }
}
