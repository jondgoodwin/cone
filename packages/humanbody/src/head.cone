// The head: a grid of rows and columns laid over a sculpted skull and face, stitched to the neck.
//
// THE FORMS. As for the body (forms.cone), the head's shape is a field of forms in smooth union: the
// cranium, the forehead and brow ridge, the cheekbones, the mid-face, the jaw (a ramus and a body each side
// and the chin), the cheeks' soft fat, the mouth's mound, the lips, the nose (its bridge, tip and wings),
// the neck; the eye sockets are carved out. Each is placed in the HEAD FRAME (the origin between the eyes
// on the skull's middle line, y up, the face to -z) and sized from the measures: the head's breadth and
// length, the face's length and the cheeks' and jaw's breadths (ANSUR II), and the face's character
// (Measures' brow, nose, lips, chin, cheekbones, jaw).
//
// THE GRID. Columns run round the head, denser at the face, densest across the eyes; rows run down it,
// densest at the eyes and the mouth. Each grid point is found by a RAY from inside the head, its first exit
// from the field: from a centre in the skull for the crown (rows by latitude), straight out from the head's
// upright axis for the face (rows by height: a row is a level line, so the mouth and the lids can lie on
// rows), from a centre above the chin for the underside of the jaw, and straight out from the neck's axis
// below. The crown closes in a fan; the bottom row is the neck's seam.
//
// THE LIDS AND THE MOUTH, after facerig's test head (testhead.cone) with one change: the grid is not fine
// enough for an opening cut across its squares, so the rows near each eye are drawn onto the lids' edges
// (a piecewise-linear remap of height, per column, that puts the row of the upper margin on the upper lid's
// curve and the lower margin's on the lower's, the rows between inside the opening, eased back to level
// rows past the corners). Then, as there: the lids lie on a shell about the eyeball (so a turn about its
// centre closes them over the globe), the points inside the opening are pushed in behind the eyeball, and
// the mouth's row is pushed back into a slot that opens when the jaw drops.

// The face's character and size, for the head's forms and features
pub struct HeadShape {
  pub sB f32;            // breadth's scale (the survey's head breadth over 153 mm)
  pub sL f32;            // length's
  pub sF f32;            // the face's length's
  pub cheek f32;         // half the cheekbones' breadth, metres
  pub jaw f32;           // half the jaw's breadth
  pub brow f32;
  pub nose f32;
  pub noseWidth f32;
  pub lips f32;
  pub chin f32;
  pub cheekbones f32;
  pub jawSquare f32;
  pub male f32;          // 1 a man, 0 a woman
  pub age f32;           // 0 young, 1 old (60 and over)
  pub ipd f32;           // between the eyes' centres
  pub eyeR f32;          // the eyeball's radius
}

pub fn headShapeOf(m &Measures) HeadShape {
  let male = if m.sex == MALE { 1.; } else { 0.; };
  new HeadShape(m.headBreadth / 0.153, m.headLength / 0.200, m.faceLength / 0.120, m.cheekBreadth * 0.5, m.jawBreadth * 0.5,
    m.brow, m.nose, m.noseWidth, m.lips, m.chin, m.cheekbones, m.jaw, male, clampf((m.age - 25.) / 40., 0., 1.),
    0.0615 + 0.0025 * male, 0.0120);
}

// ---- the features' places in the head frame ----

pub struct Features {
  pub eyeZ f32;          // the eyeballs' centres' depth
  pub yg f32;            // the mouth's line
  pub menton f32;        // the chin's lowest point's height
  pub lipZ f32;          // the lips' front
  pub lidHW f32;         // half the eye opening's width
  pub lidHU f32;         // the upper lid's edge above the eye's centre, at the middle
  pub lidHL f32;         // the lower's below
  pub shell f32;         // the lids' shell's radius
  pub mouthHW f32;       // half the mouth's width
}

pub fn featuresOf(s &HeadShape) Features {
  let f = s.sF;
  new Features(-0.0705 * s.sL, -0.0690 * f, -0.1130 * f, -0.0868 * s.sL, 0.0142, 0.0052, 0.0046, s.eyeR + 0.0016,
    0.0245 + 0.002 * s.lips);
}

// The nose's tip's height in the head frame
pub fn noseTipY(s &HeadShape) f32 { -0.0380 * s.sF * (0.85 + 0.3 * s.nose); }

// ---- the forms ----

fn hEll(p Vec3, c Vec3, r Vec3) f32 { ellipsoid(p - c, r); }

// The head's field at p (head frame): negative inside
pub fn headDistance(p Vec3, s &HeadShape, ft &Features, neckR f32, neckZ f32) f32 {
  let b = s.sB;
  let l = s.sL;
  let f = s.sF;
  let ax = absf(p.x);
  let q = new Vec3(ax, p.y, p.z);          // the face is symmetric: one side's forms, mirrored
  let brow = 0.6 + 0.8 * s.brow;
  // THE BASE: the cranium, the forehead, the lower face (a tapered mass from the cheekbones' breadth down
  // to the chin, wider than deep), the upper jaw, the jaw's angles and the neck, blended softly
  var d = hEll(p, new Vec3(0., 0.027 * f, 0.010 * l), new Vec3(0.0765 * b, 0.0885 * f, 0.0995 * l));
  d = softUnion(d, hEll(p, new Vec3(0., 0.030 * f, -0.040 * l), new Vec3(0.060 * b, 0.050 * f, 0.050 * l)), 0.006);
  let cw = s.cheek / 0.0725;
  let jw = s.jaw;
  let sq = 0.8 + 0.5 * s.jawSquare;
  let ch = 0.8 + 0.5 * s.chin;
  // (the lower face narrows from the cheekbones to the jaw: a wedge, its sides flat, not a ball)
  // (narrower below the cheekbones than at them: the cheek falls in under the malar eminence)
  let lower = new Vec3(p.x / (cw * (0.98 - 0.09 * smoothstep(-0.020 * f, -0.062 * f, p.y))), p.y, p.z);
  d = softUnion(d, taperedCapsule(lower, new Vec3(0., -0.016 * f, -0.026 * l), new Vec3(0., -0.088 * f, -0.054 * l), 0.047, 0.020 * ch), 0.010);
  d = softUnion(d, hEll(p, new Vec3(0., -0.042 * f, -0.054 * l), new Vec3(0.034 * b, 0.040 * f, 0.040 * l)), 0.006);
  // the jaw: the ramus down from in front of the ear to the angle, the body forward to the chin, a firm edge
  // (a square jaw: its angle lower, further out and further back, so the edge from the ear to the chin turns a corner)
  let js = s.jawSquare - 0.5;
  let gonion = new Vec3(jw - 0.010 + 0.004 * js, -0.088 * f - 0.006 * js, -0.004 * l + 0.004 * js);
  d = softUnion(d, taperedCapsule(q, new Vec3(jw - 0.013, -0.030 * f, 0.006 * l), gonion, 0.009, 0.008 * sq), 0.004);
  // (the body's lower edge stays above the chin's lowest point, so no ray along a row grazes it)
  d = softUnion(d, taperedCapsule(q, gonion, new Vec3(0.018, -0.103 * f, -0.064 * l), 0.008 * sq, 0.009), 0.004);
  // the masseter: a flat band of muscle from the cheekbone's arch down to the jaw's angle, bridging them so that the
  // cheek under the cheekbone is a plane falling to the jaw, not a hollow between two lumps
  d = softUnion(d, taperedCapsule(q, new Vec3(s.cheek - 0.017, -0.024 * f, -0.030 * l), gonion + new Vec3(-0.004, 0.009, -0.010),
    0.0105, 0.0085), 0.010);
  // the chin: forward and square for a strong one (two mental tubercles either side of the middle)
  let chinZ = -0.071 * l - 0.004 * (s.chin - 0.5);
  d = softUnion(d, hEll(p, new Vec3(0., -0.101 * f, chinZ), new Vec3(0.016 * ch, 0.0120, 0.0120)), 0.004);
  d = softUnion(d, hEll(q, new Vec3(0.009 * ch, -0.105 * f, chinZ + 0.002), new Vec3(0.009, 0.008, 0.009)), 0.003);
  // the neck: round in section at the survey's girth, slimmer where it meets the jaw, widening towards its root
  // (where the trapezius takes it), set back from the jaw so the jaw's edge shows
  d = softUnion(d, taperedCapsule(p, new Vec3(0., -0.070, neckZ + 0.004), new Vec3(0., -0.320, neckZ + 0.006), neckR * 0.92, neckR * 1.12), 0.010);
  // THE FEATURES. The brow ridge and the glabella
  d = softUnion(d, taperedCapsule(q, new Vec3(0.004, 0.0195 * f, -0.0835 * l), new Vec3(0.044 * b, 0.0220 * f, -0.0720 * l),
    0.0080 * brow, 0.0045 * brow), 0.006);
  // the cheekbones (the malar eminence under the eye, small and high) and the arch back towards the ear
  let zyg = 0.7 + 0.6 * s.cheekbones;
  d = softUnion(d, hEll(q, new Vec3(s.cheek - 0.023, -0.010 * f, -0.055 * l), new Vec3(0.017, 0.0105 * zyg, 0.020)), 0.011);
  d = softUnion(d, taperedCapsule(q, new Vec3(s.cheek - 0.022, -0.012 * f, -0.048 * l), new Vec3(s.cheek - 0.008, -0.014 * f, -0.012 * l),
    0.007, 0.006), 0.009);
  // the cheek's soft mass in front, from under the cheekbone to beside the mouth (fills the valley a sculptor would
  // find between the cheekbone, the nose's wing and the mouth's mound)
  d = softUnion(d, hEll(q, new Vec3(s.cheek - 0.034, -0.040 * f, -0.054 * l), new Vec3(0.019, 0.022 * f, 0.020)), 0.012);
  // the eye sockets, carved
  d = smoothSubtract(d, sphere(q - new Vec3(s.ipd * 0.5, 0.0, ft.eyeZ - 0.003), 0.0150), 0.009);
  // and the eyeball with its lids' shell in each (the socket is a hollow round the eye, not a hole: a row's ray near
  // the eye's corners otherwise found the socket's back wall at one height and the face at the next, folds that
  // stood out of the corners as fins)
  d = softUnion(d, sphere(q - new Vec3(s.ipd * 0.5, 0.0, ft.eyeZ), ft.shell + 0.0008), 0.004);
  // the soft fullness below the lower lid, over the orbit's rim to the cheekbone (lower than the lid: it must not cover it)
  d = softUnion(d, hEll(q, new Vec3(s.ipd * 0.5 + 0.004, -0.0215, ft.eyeZ - 0.003), new Vec3(0.019, 0.0085, 0.0105)), 0.010);
  // the mouth's mound over the teeth, curved like the dental arch, and the lips on it
  d = softUnion(d, hEll(p, new Vec3(0., ft.yg - 0.001, -0.067 * l), new Vec3(0.025, 0.019 * f, 0.0155)), 0.008);
  let lf = 0.75 + 0.5 * s.lips;
  // the upper lip: two lobes either side of the middle and the tubercle between them (the cupid's bow is the dip of the
  // lobes' tops at the middle, the philtrum's columns rising from their peaks), thin and laid back on the teeth; the lower
  // lip one fuller roll. Both stand only a little proud of the mound and thin out to the corners
  d = softUnion(d, hEll(q, new Vec3(ft.mouthHW * 0.36, ft.yg + 0.0032 * lf, ft.lipZ + 0.0046), new Vec3(ft.mouthHW * 0.50, 0.0034 * lf, 0.0046 * lf)), 0.004);
  d = softUnion(d, hEll(p, new Vec3(0., ft.yg + 0.0026 * lf, ft.lipZ + 0.0040), new Vec3(0.0052, 0.0028 * lf, 0.0042 * lf)), 0.003);
  d = softUnion(d, hEll(p, new Vec3(0., ft.yg - 0.0048 * lf, ft.lipZ + 0.0058), new Vec3(ft.mouthHW * 0.64, 0.0050 * lf, 0.0056 * lf)), 0.005);
  // the philtrum's columns and the groove between them
  d = softUnion(d, taperedCapsule(q, new Vec3(0.0040, ft.yg + 0.0070, ft.lipZ + 0.0032), new Vec3(0.0030, ft.yg + 0.019, ft.lipZ + 0.0058), 0.0020, 0.0016), 0.003);
  // the nose: the bridge from its root, the tip, the wings
  let nl = 0.85 + 0.3 * s.nose;
  let nw = 0.8 + 0.4 * s.noseWidth;
  let tip = new Vec3(0., noseTipY(s), -0.1035 * l - 0.006 * (s.nose - 0.5));
  d = softUnion(d, taperedCapsule(p, new Vec3(0., 0.004 * f, -0.0845 * l), tip + new Vec3(0., 0.004, 0.002), 0.0060, 0.0072), 0.006);
  d = softUnion(d, hEll(p, tip, new Vec3(0.0080 * nw, 0.0078, 0.0082)), 0.004);
  d = softUnion(d, hEll(q, new Vec3(0.0100 * nw, tip.y - 0.0055, tip.z + 0.0110), new Vec3(0.0070 * nw, 0.0060, 0.0078)), 0.004);
  d;
}

// A soft union (the exponential smooth minimum, -k ln(e^(-a/k) + e^(-b/k))): unlike the quadratic one it is
// associative, so a chain of many forms swells by at most k ln n where n of them meet, not by k at each
pub fn softUnion(a f32, b f32, k f32) f32 {
  let m = minf(a, b);
  m - k * libc.logf(1. + libc.expf(0. - absf(a - b) / k));
}

// The head's field as an sdf Shape in model space, for meshing it to look at (the stages' pictures)
pub struct HeadField {
  pub shape HeadShape;
  pub ft Features;
  pub origin Vec3;
  pub neckR f32;

  pub fn distance(self &, p Vec3) f32 { headDistance(p - origin, &shape, &ft, neckR, 0.012); }
}

pub fn headFieldOf(m &Measures) HeadField {
  let s = headShapeOf(m);
  let ft = featuresOf(&s);
  new HeadField(s, ft, new Vec3(0., m.height - 0.58 * m.headLength, 0.010), m.neckGirth / 6.2831853);
}

// ---- the grid ----

pub const HEAD_COLS = 72usize;

// A row: how its rays are cast
struct RowRay {
  kind u32;          // 0 by latitude from 'centre', 1 level (by height, out from the upright axis)
  value f32;         // the latitude (radians) or the height
  centre Vec3;       // kind 0's centre; kind 1's axis point's z in its z
}

// Column angles: denser at the face and across the eyes (an inverse of the density's running sum)
fn columnAngles(n usize) List[f32] {
  let steps = 2000usize;
  var cdf = List[f32].empty();
  var acc = 0.;
  var i = 0usize;
  while i <= steps {
    cdf.push(acc);
    let th = -pi + 2. * pi * f32.from(i) / f32.from(steps);
    let e = (absf(th) - 0.40) / 0.17;
    let rho = 0.45 + 1.4 * libc.expf(-(th / 0.85) * (th / 0.85)) + 0.9 * libc.expf(-e * e);
    acc = acc + rho;
    i = i + 1usize;
  }
  var out = List[f32].empty();
  var k = 0usize;
  var j = 0usize;
  while k <= n {
    let target = acc * f32.from(k) / f32.from(n);
    while j + 1usize < cdf.len() and *cdf[j + 1usize] < target { j = j + 1usize; }
    let c0 = *cdf[j];
    let c1 = if j + 1usize < cdf.len() { *cdf[j + 1usize]; } else { c0 + 1.; };
    let t = if c1 > c0 { (target - c0) / (c1 - c0); } else { 0.; };
    out.push(-pi + 2. * pi * (f32.from(j) + clampf(t, 0., 1.)) / f32.from(steps));
    k = k + 1usize;
  }
  // exactly -pi and pi at the seam
  out.set(0usize, 0. - pi);
  out.set(n, pi);
  out;
}

// Level rows' heights from y0 down to y1: 'n' of them, denser where 'rho' says
fn levelRows(y0 f32, y1 f32, n usize, ft &Features) List[f32] {
  let steps = 1000usize;
  var cdf = List[f32].empty();
  var acc = 0.;
  var i = 0usize;
  while i <= steps {
    cdf.push(acc);
    let y = y0 + (y1 - y0) * f32.from(i) / f32.from(steps);
    let e = y / 0.011;
    let m = (y - ft.yg) / 0.011;
    let nn = (y + 0.042) / 0.010;
    let cm = (y - ft.menton) / 0.008;
    let low = smoothstep(ft.menton - 0.01, ft.menton - 0.03, y);
    let rho = (1. + 2.2 * libc.expf(-e * e) + 1.6 * libc.expf(-m * m) + 0.5 * libc.expf(-nn * nn) + 0.8 * libc.expf(-cm * cm)) *
      (1. - 0.4 * low);
    acc = acc + rho;
    i = i + 1usize;
  }
  var out = List[f32].empty();
  var k = 0usize;
  var j = 0usize;
  while k < n {
    let target = acc * f32.from(k) / f32.from(n - 1usize);
    while j + 1usize < cdf.len() and *cdf[j + 1usize] < target { j = j + 1usize; }
    let c0 = *cdf[j];
    let c1 = if j + 1usize < cdf.len() { *cdf[j + 1usize]; } else { c0 + 1.; };
    let t = if c1 > c0 { (target - c0) / (c1 - c0); } else { 0.; };
    out.push(y0 + (y1 - y0) * (f32.from(j) + clampf(t, 0., 1.)) / f32.from(steps));
    k = k + 1usize;
  }
  out;
}

// The row nearest 'y' set to it exactly; its index
fn snapRow(rows &mut List[f32], y f32) usize {
  var best = 0usize;
  var i = 1usize;
  while i < rows.len() {
    if absf(*rows[i] - y) < absf(*rows[best] - y) { best = i; }
    i = i + 1usize;
  }
  rows.set(best, y);
  best;
}

// The first exit from the field along a ray from 'o' (inside) in direction 'd': its distance
fn rayExit(o Vec3, d Vec3, s &HeadShape, ft &Features, neckR f32, neckZ f32) f32 {
  let step = 0.0015;
  var t = 0.;
  var prev = headDistance(o, s, ft, neckR, neckZ);
  while t < 0.30 {
    let t1 = t + step;
    let v = headDistance(o + d * t1, s, ft, neckR, neckZ);
    if prev <= 0. and v > 0. {
      var lo = t;
      var hi = t1;
      var k = 0;
      while k < 12 {
        let mid = (lo + hi) * 0.5;
        if headDistance(o + d * mid, s, ft, neckR, neckZ) > 0. { hi = mid; } else { lo = mid; }
        k = k + 1;
      }
      return (lo + hi) * 0.5;
    }
    prev = v;
    t = t1;
  }
  t;
}

// ---- the eye and the mouth (after facerig's test head) ----

// The opening's edges at 'dx' out from the eye's axis: the upper edge's height above its centre line, and
// the lower's (negative); both meet at the corners, the outer corner higher than the inner
fn lidEdges(dx f32, ft &Features) Vec2 {
  let qx = dx / ft.lidHW;
  let h = if absf(qx) < 1. { libc.powf(1. - qx * qx, 0.6); } else { 0.; };
  let tilt = 0.0014 * qx;
  // the upper lid's highest point is inward of the middle, the lower's outward
  let hu = ft.lidHU * h * (1. - 0.18 * qx);
  let hl = ft.lidHL * h * (1. + 0.15 * qx);
  new Vec2(hu + tilt, 0. - hl + tilt);
}

// The rows near an eye drawn onto its lids' edges: 'y' a height in the head frame, 'dx' out from the eye's
// axis; the margins' base rows are at cy + lidHU and cy - lidHL
fn lidWarp(y f32, cy f32, dx f32, ft &Features) f32 {
  let z = 0.020;
  let t = y - cy;
  if t <= 0. - z or t >= z { return y; }
  // past the corners the rows that ran between the margins open out again to their level spacing (left pinched,
  // they draw a crease out from each corner to the temple and the nose)
  let past = smoothstep(1.05, 2.0, absf(dx) / ft.lidHW);
  let e0 = lidEdges(dx, ft);
  let e = new Vec2(e0.x + (ft.lidHU - e0.x) * past, e0.y + (0. - ft.lidHL - e0.y) * past);
  let u = maxf(e.x, e.y + 0.0004);
  let lo = minf(e.y, u - 0.0004);
  var out = t;
  if t < 0. - ft.lidHL { out = 0. - z + (t + z) * (lo + z) / (z - ft.lidHL); }
  elif t > ft.lidHU { out = u + (t - ft.lidHU) * (z - u) / (z - ft.lidHU); }
  else { out = lo + (t + ft.lidHL) * (u - lo) / (ft.lidHU + ft.lidHL); }
  let w = 1. - smoothstep(ft.lidHW * 1.0, ft.lidHW * 2.5, absf(dx));
  cy + t + (out - t) * w;
}

// The lids' shell and the opening, on a point near the eye at 'c' (head frame), side +1 right, -1 left
fn eyeOp(p Vec3, c Vec3, side f32, ft &Features) Vec3 {
  let zone0 = 0.0125;
  let zone1 = 0.030;
  let dx = side * (p.x - c.x);
  let dy = p.y - c.y;
  let r = (dx * dx + dy * dy).sqrt();
  if r >= zone1 { return p; }
  let edges = lidEdges(dx, ft);
  let e = minf(edges.x - dy, dy - edges.y);        // positive inside the opening
  let w = smoothstep(0., 0.0012, e);
  let rr = minf(r, zone0);
  // (past the lids the shell falls back, so it never stands in front of the cheek and the brow: held level there it
  // pulled a ring of face forward round each eye, a puff with a crease at its rim)
  var zShell = c.z - (ft.shell * ft.shell - rr * rr).sqrt() + 0.9 * maxf(r - zone0, 0.);
  // the margin's roll, and the fold above the upper lid
  if e < 0. {
    let along = 1. - smoothstep(0.65, 0.95, absf(dx) / ft.lidHW);
    zShell = zShell - 0.0005 * along * libc.expf(0. - (e / 0.0009) * (e / 0.0009));
  }
  if absf(dx) < ft.lidHW {
    let k = (dy - (edges.x + 0.0050)) / 0.0020;
    let along = 1. - smoothstep(0.5, 1.0, absf(dx) / ft.lidHW);
    zShell = zShell + 0.0007 * along * libc.expf(0. - k * k);
  }
  let zIn = c.z - 0.005;
  // where the face stands in front of the lids' shell (under the brow, over the cheek's top) the face is the surface
  // and the lids come out from under it: a deep-set eye, no fold where shell and face meet
  // past the corners there are no lids: the face is the surface (the shell pulled the rows packed into each corner
  // forward by different amounts, thin fins standing out from the corners)
  let inLid = 1. - smoothstep(0.9, 1.3, absf(dx) / ft.lidHW);
  let zLid = p.z + (softUnion(zShell, p.z, 0.0010) - p.z) * inLid;
  let z = zLid * (1. - w) + zIn * w;
  let bl = smoothstep(zone0, zone1, r);
  new Vec3(p.x, p.y, z * (1. - bl) + p.z * bl);
}

// 'rowY' the height the point's row was cast at: the smooth brush may have moved the point a millimetre or two along
// the lips' curved surface, and the slot must take the whole mouth's row, not only where the brush left it level
fn mouthOp(p Vec3, rowY f32, ft &Features) Vec3 {
  let ax = absf(p.x);
  let taper = 1. - smoothstep(ft.mouthHW - 0.006, ft.mouthHW + 0.002, ax);
  let front = smoothstep(-0.02, -0.06, p.z);
  let dy = (rowY - ft.yg) / 0.0006;
  if absf(dy) > 4.5 { return p; }
  let g = libc.expf(-0.5 * dy * dy);
  new Vec3(p.x, p.y, p.z + 0.012 * g * taper * front);
}

// How much the smooth brush may move a point: none on the lids and the mouth's line, little on the lips and the
// nose's tip, fully elsewhere
fn smoothWeight(p Vec3, ft &Features, cR Vec3, cL Vec3) f32 {
  if p.z > -0.035 { return 1.; }
  let ex = minf(absf(p.x - cR.x), absf(p.x - cL.x)) / (ft.lidHW * 1.9);
  let ey = absf(p.y - cR.y) / 0.015;
  let eye = smoothstep(0.75, 1.15, maxf(ex, ey));
  let mx = absf(p.x) / (ft.mouthHW * 1.15);
  let my = absf(p.y - ft.yg) / 0.013;
  let mouth = 0.15 + 0.85 * smoothstep(0.8, 1.2, maxf(mx, my));
  minf(eye, mouth);
}

// The smooth brush (see buildHead): 'passes' of Taubin's lambda-mu smoothing of the grid's points along their normals
fn smoothHead(pos &mut List[Vec3], nr usize, nc usize, ft &Features, cR Vec3, cL Vec3, passes i32) {
  var w = List[f32].empty();
  var k = 0usize;
  while k < pos.len() { w.push(smoothWeight(*pos[k], ft, cR, cL)); k = k + 1usize; }
  let cols = nc - 1usize;          // the last column is the first's copy
  var pass = 0;
  while pass < passes * 2 {
    let f = if pass % 2 == 0 { 0.5; } else { -0.53; };
    var next = List[Vec3].empty();
    var r = 0usize;
    while r < nr {
      var c = 0usize;
      while c < nc {
        let i = r * nc + c;
        let p = *pos[i];
        if r == 0usize or r + 1usize >= nr {
          next.push(p);
        } else {
          let cl = (c + cols - 1usize) % cols;
          let cr = (c + 1usize) % cols;
          let left = *pos[r * nc + cl];
          let right = *pos[r * nc + cr];
          let up = *pos[(r - 1usize) * nc + c % cols];
          let down = *pos[(r + 1usize) * nc + c % cols];
          let avg = (left + right + up + down) * 0.25;
          let n = (right - left).cross(down - up).normalize();
          let lap = avg - p;
          next.push(p + n * (n.dot(lap) * f * *w[i]));
        }
        c = c + 1usize;
      }
      r = r + 1usize;
    }
    // the seam's copy column follows the first
    r = 0usize;
    while r < nr { next.set(r * nc + cols, *next[r * nc]); r = r + 1usize; }
    *pos = next;
    pass = pass + 1;
  }
}

// ---- the head ----

pub struct Head {
  pub shape HeadShape;
  pub ft Features;
  pub origin Vec3;            // the head frame's origin in model space
  pub positions List[Vec3];   // model space
  pub uvs List[Vec2];
  pub quads List[u32];        // the grid's quads, counterclockwise from outside
  pub tris List[u32];         // the crown's fan
  pub rows usize;
  pub cols usize;             // HEAD_COLS + 1 a row: the seam column twice
  pub bottom List[u32];       // the bottom row, columns 0 to HEAD_COLS (the seam column twice)
  pub bottomAngles List[f32]; // their angles round the neck
  pub neckAxis Vec3;          // the neck's axis at the bottom row, model space
  pub jawWeight List[f32];    // per vertex: 0 the head, 1 the jaw
  pub headWeight List[f32];   // per vertex: the head's share against the neck's
  pub eyeRows List[usize];    // the rows of the upper and the lower margins (for the record)
  pub mouthRow usize;
}

// The record of a blended person's head (blends.cone): the base's grid (its rows, columns and the rows of the
// lids and the mouth), the person's own shape and features, its frame's origin where the blend put it. The
// grid's points are the person's mesh's; the record keeps none.
pub fn buildHeadRecord(base &Head, m &Measures, origin Vec3) Head {
  let s = headShapeOf(m);
  let ft = featuresOf(&s);
  var bottom = List[u32].empty();
  var i = 0usize;
  while i < base.bottom.len() { bottom.push(*base.bottom[i]); i = i + 1usize; }
  var angles = List[f32].empty();
  i = 0usize;
  while i < base.bottomAngles.len() { angles.push(*base.bottomAngles[i]); i = i + 1usize; }
  var eyeRows = List[usize].empty();
  i = 0usize;
  while i < base.eyeRows.len() { eyeRows.push(*base.eyeRows[i]); i = i + 1usize; }
  new Head(s, ft, origin, List[Vec3].empty(), List[Vec2].empty(), List[u32].empty(), List[u32].empty(), base.rows, base.cols,
    bottom, angles, base.neckAxis, List[f32].empty(), List[f32].empty(), eyeRows, base.mouthRow);
}

// The head of a body of measures 'm', the bottom row at model height 'seamY'
pub fn buildHead(m &Measures, seamY f32) Head {
  let s = headShapeOf(m);
  let ft = featuresOf(&s);
  let h = m.height;
  // the eyes 0.58 of the head's length below the crown; the frame's centre over the skull's middle
  let origin = new Vec3(0., h - 0.58 * m.headLength, 0.010);
  let neckR = m.neckGirth / 6.2831853;
  let neckZ = 0.012;
  let ySeam = seamY - origin.y;
  // the rows: the crown by latitude, the face by height, under the jaw by latitude from above the chin, the neck by height
  let centre = new Vec3(0., 0.004, 0.010);
  let yTop = 0.044 * s.sF;
  var rays = List[RowRay].empty();
  let nA = 14usize;
  let latB = asin(clampf((yTop + 0.007) / 0.100, -0.9, 0.9));
  var i = 0usize;
  while i < nA {
    let lat = 1.48 - (1.48 - latB) * f32.from(i) / f32.from(nA);
    rays.push(new RowRay(0u32, lat, centre));
    i = i + 1usize;
  }
  var levels = levelRows(yTop, ySeam, 68usize, &ft);
  // the lid margins' rows and the two between them, and the mouth's row, exactly
  let up = snapRow(&mut levels, ft.lidHU);
  let lo = snapRow(&mut levels, 0. - ft.lidHL);
  if lo > up + 1usize {
    var k = up + 1usize;
    while k < lo {
      levels.set(k, ft.lidHU - (ft.lidHU + ft.lidHL) * f32.from(k - up) / f32.from(lo - up));
      k = k + 1usize;
    }
  }
  let mrow = snapRow(&mut levels, ft.yg);
  // the face's rows and on down the neck: below the chin the rays leave from the neck's axis, and the
  // first row below the chin's lowest point meets the throat, so one band of quads is the jaw's underside
  i = 0usize;
  while i < levels.len() {
    let y = *levels[i];
    let az = 0.004 + (neckZ - 0.004) * smoothstep(ft.menton, ft.menton - 0.03, y);
    rays.push(new RowRay(1u32, y, new Vec3(0., 0., az)));
    i = i + 1usize;
  }
  let angles = columnAngles(HEAD_COLS);
  let nr = rays.len();
  let nc = HEAD_COLS + 1usize;
  var pos = List[Vec3].empty();
  var uvs = List[Vec2].empty();
  let cR = new Vec3(s.ipd * 0.5, 0., ft.eyeZ);
  let cL = new Vec3(0. - s.ipd * 0.5, 0., ft.eyeZ);
  var r = 0usize;
  while r < nr {
    let ry = *rays[r];
    var c = 0usize;
    while c < nc {
      let th = *angles[c];
      let hd = new Vec3(sin(th), 0., 0. - cos(th));
      var o = new Vec3(0., 0., 0.);
      var d = hd;
      if ry.kind == 0u32 {
        o = ry.centre;
        d = hd * cos(ry.value) + new Vec3(0., sin(ry.value), 0.);
      } else {
        o = new Vec3(0., ry.value, ry.centre.z);
      }
      // the lids: a face row's height drawn onto the lid's edge, the point found again at that height
      if ry.kind == 1u32 {
        var y = ry.value;
        // the column's x where its ray meets the face, roughly: the eyes are near the front
        let t0 = rayExit(o, d, &s, &ft, neckR, neckZ);
        let p0 = o + d * t0;
        if p0.z < -0.035 {
          if p0.x > 0. { y = lidWarp(y, cR.y, p0.x - cR.x, &ft); } else { y = lidWarp(y, cL.y, cL.x - p0.x, &ft); }
        }
        o = new Vec3(0., y, ry.centre.z);
        // round the chin's lowest point and under the jaw a level ray would graze the jaw's lower edge (it meets it
        // or misses it from one column to the next: a dotted line along the jaw), so there the rays leave from higher
        // up and slope down, to cross the jaw's underside instead of skimming it; level again above and below
        let lift = 0.026 * smoothstep(ft.menton + 0.024, ft.menton + 0.006, y) * (1. - smoothstep(ft.menton - 0.030, ft.menton - 0.070, y));
        if lift > 0. {
          o = new Vec3(0., y + lift, ry.centre.z);
          d = (hd * 0.060 + new Vec3(0., 0. - lift, 0.)).normalize();
        }
      }
      let t = rayExit(o, d, &s, &ft, neckR, neckZ);
      pos.push(o + d * t);
      uvs.push(new Vec2(f32.from(c) / f32.from(HEAD_COLS), 1. - 0.5 * f32.from(r + 1usize) / f32.from(nr + 1usize)));
      c = c + 1usize;
    }
    r = r + 1usize;
  }
  // THE SMOOTH BRUSH: the forms meet in creases a sculptor would smooth away (under the eyes, where the cheek meets
  // the jaw, the jaw the neck). The grid's points are moved along the surface's normal only, towards the mean of their
  // four neighbours (Taubin's two steps, lambda then mu, so the head does not shrink), and the rows are not slid
  // along the face; the lids' and the mouth's rows are held, the lips and the nose's tip mostly
  smoothHead(&mut pos, nr, nc, &ft, cR, cL, 24);
  // the lids and the mouth, cut in
  var k = 0usize;
  while k < pos.len() {
    let ry = *rays[k / nc];
    var p = *pos[k];
    if ry.kind == 1u32 and p.z < -0.035 {
      p = eyeOp(p, cR, 1., &ft);
      p = eyeOp(p, cL, -1., &ft);
      p = mouthOp(p, ry.value, &ft);
      pos.set(k, p);
    }
    k = k + 1usize;
  }
  // the quads (counterclockwise from outside: down a column, then along the row towards the being's right,
  // which from the front is towards -x... the winding is checked against the outward direction below)
  var quads = List[u32].empty();
  r = 0usize;
  while r + 1usize < nr {
    var c = 0usize;
    while c + 1usize < nc {
      let a = u32.from(r * nc + c);
      let b = u32.from(r * nc + c + 1usize);
      let cc = u32.from((r + 1usize) * nc + c + 1usize);
      let dd = u32.from((r + 1usize) * nc + c);
      quads.push(a); quads.push(dd); quads.push(cc); quads.push(b);
      c = c + 1usize;
    }
    r = r + 1usize;
  }
  // the crown's pole, and its fan
  let poleAt = centre + new Vec3(0., rayExit(centre, new Vec3(0., 1., 0.), &s, &ft, neckR, neckZ), 0.);
  let pole = u32.from(pos.len());
  pos.push(poleAt);
  uvs.push(new Vec2(0.5, 1.));
  var tris = List[u32].empty();
  var c = 0usize;
  while c + 1usize < nc {
    tris.push(pole); tris.push(u32.from(c)); tris.push(u32.from(c + 1usize));
    c = c + 1usize;
  }
  // the winding: the first face quad's normal must point away from the centre
  {
    let q0 = (nr / 2usize) * nc + nc / 2usize;
    let a = *pos[q0];
    let b = *pos[q0 + nc];
    let cc = *pos[q0 + nc + 1usize];
    let n = (b - a).cross(cc - a);
    if n.dot(a - new Vec3(0., a.y, 0.)) < 0. {
      var k = 0usize;
      while k + 3usize < quads.len() {
        let t = *quads[k + 1usize];
        quads.set(k + 1usize, *quads[k + 3usize]);
        quads.set(k + 3usize, t);
        k = k + 4usize;
      }
      k = 0usize;
      while k + 2usize < tris.len() {
        let t = *tris[k + 1usize];
        tris.set(k + 1usize, *tris[k + 2usize]);
        tris.set(k + 2usize, t);
        k = k + 3usize;
      }
    }
  }
  // the weights: the jaw (a plane through the mouth's line and the hinge, after the test head) and the head
  // against the neck down the throat
  let pivot = new Vec3(0., -0.024 * s.sF, 0.008);
  var jw = List[f32].empty();
  var hw = List[f32].empty();
  var v = 0usize;
  while v < pos.len() {
    let p = *pos[v];
    let dy = pivot.y - ft.yg;
    let dz = pivot.z - ft.lipZ;
    let len = (dy * dy + dz * dz).sqrt();
    let n = new Vec3(0., dz / len, 0. - dy / len);
    // which side of the plane a point is on is judged by its row's height, not its own (the smooth brush moves points
    // a little along the lips' curve), and a point standing in front of the lips' line as on it: the lips stand
    // proud of it, and the plane tilting back through them put the lower lip's top on the head while the mouth's row
    // went with the jaw, a sheet of lip stretched across the open mouth
    let rowY = if v < nr * nc and (*rays[v / nc]).kind == 1u32 { (*rays[v / nc]).value; } else { p.y; };
    let sd = n.dot(new Vec3(0., rowY - ft.yg, maxf(p.z, ft.lipZ) - ft.lipZ));
    // (sharp between the lips, broad over the cheeks, so an open jaw stretches the cheek smoothly, not along a fold)
    let width = 0.0009 + 0.018 * smoothstep(0.012, 0.036, absf(p.x));
    let jt = smoothstep(-1., 1., (0. - sd) / width);
    let low = 1. - smoothstep(ft.menton - 0.004, ft.menton - 0.045, p.y);
    let back = 1. - smoothstep(0.03, 0.06, p.z - pivot.z);
    jw.push(jt * low * back);
    hw.push(smoothstep(ySeam, ft.menton + 0.01, p.y));
    v = v + 1usize;
  }
  // into model space
  var mp = List[Vec3].empty();
  v = 0usize;
  while v < pos.len() { mp.push(*pos[v] + origin); v = v + 1usize; }
  var bottom = List[u32].empty();
  c = 0usize;
  while c < nc { bottom.push(u32.from((nr - 1usize) * nc + c)); c = c + 1usize; }
  var eyeRows = List[usize].empty();
  eyeRows.push(nA + up);
  eyeRows.push(nA + lo);
  new Head(s, ft, origin, mp, uvs, quads, tris, nr, nc, bottom, angles, new Vec3(0., seamY, origin.z + neckZ), jw, hw, eyeRows,
    nA + mrow);
}
