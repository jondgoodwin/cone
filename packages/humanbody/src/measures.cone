// A person as numbers: the measures a body is shaped to, and the cast of six.
//
// THE SOURCE. Every breadth, depth, girth and landmark height is from the 2012 Anthropometric Survey of U.S.
// Army Personnel (ANSUR II; Gordon, Blackwell, Bradtmiller et al., NATICK/TR-15/007, 2014), its public
// working databases of 4,082 men and 1,986 women, measured as its Measurer's Handbook (NATICK/TR-11/017)
// defines. It is the largest modern survey that measures the trunk's breadths and depths and not only its
// girths. Each of the six is the MEDIAN, measure by measure, of the 40 subjects nearest a target of stature
// percentile and body-mass-index percentile (and age, for the older man) in the survey, in standard
// deviations; the targets are with each person in 'cast'. The average man and woman are the 50th and 50th.
// Two adjustments: the survey measures the biceps and forearm FLEXED, and a relaxed arm is taken as 0.92 and
// 0.96 of them (own estimate); and the jaw's breadth (bigonial), which the survey does not measure, is 0.84
// of the cheek breadth (own, from the usual ratio). An Army sample is leaner at the hip than the civilian
// population (women's hip breadth 354 mm against about 380 mm): the cast keeps the survey's numbers.
//
// The LANDMARK HEIGHTS, as fractions of the stature, are the survey's means for each sex (crotch, buttock,
// trochanter, waist at the navel, chest at the nipples, armpit, acromion, the root of the neck). Segment
// LENGTHS are not measures here: they are Drillis and Contini's fractions of the height (bonepose's
// humanoid), so a person walks and falls with the skeleton walkgait and ragdollrig expect.
//
// Every number is in metres. A person is 'measures', a look (skin, eyes) and what they wear; the body is
// shaped to the measures (sculpt.cone) and the six are blends of one mesh (blends.cone).

pub const MALE = 0u32;
pub const FEMALE = 1u32;

pub struct Measures {
  pub sex u32;
  pub height f32;
  pub biacromial f32;        // between the acromions, the shoulders' bony points
  pub bideltoid f32;         // across the deltoids, the widest of the shoulders
  pub chestBreadth f32;      // at the nipples (the bust for a woman), arms down
  pub chestDepth f32;
  pub waistBreadth f32;      // at the navel
  pub waistDepth f32;
  pub hipBreadth f32;        // the widest of the hips and seat, standing
  pub buttockDepth f32;
  pub neckGirth f32;
  pub thighGirth f32;        // at the gluteal fold
  pub calfGirth f32;
  pub armGirth f32;          // the upper arm, relaxed
  pub forearmGirth f32;
  pub wristGirth f32;
  pub headLength f32;        // glabella to the back of the head
  pub headBreadth f32;
  pub faceLength f32;        // the root of the nose (sellion) to the chin (menton)
  pub cheekBreadth f32;      // bizygomatic
  pub jawBreadth f32;        // bigonial
  pub bust f32;              // a woman's breasts: 0 none to 1 full (a man's chest is its muscles)
  pub muscle f32;            // 0 soft, 0.5 ordinary, 1 an athlete's
  pub belly f32;             // 0 flat to 1 a round belly
  pub age f32;               // years
  // landmark heights, fractions of the height (the survey's means for the sex)
  pub crotchAt f32;
  pub buttockAt f32;
  pub trochanterAt f32;
  pub waistAt f32;
  pub chestAt f32;
  pub armpitAt f32;
  pub acromionAt f32;
  pub neckAt f32;            // the root of the neck in front (suprasternale)
  // the face's own shape, each 0 to 1, 0.5 the sex's usual (the survey measures none of these: they are a
  // face's character, set by hand)
  pub brow f32;              // the brow ridge's weight
  pub nose f32;              // the nose's length and how far it stands out
  pub noseWidth f32;
  pub lips f32;              // their fullness
  pub chin f32;              // how far forward and square the chin is
  pub cheekbones f32;
  pub jaw f32;               // the jaw's angle: soft and round to square and strong
}

// One subject of measures, in millimetres as the survey prints them; the shape's own numbers (bust,
// muscle, belly) and the age are given beside them
fn fromMillimetres(sex u32, mm &Array[f32], bust f32, muscle f32, belly f32, age f32) Measures {
  imm k = 0.001;
  imm male = sex == MALE;
  new Measures(sex, mm[0] * k, mm[1] * k, mm[2] * k, mm[3] * k, mm[4] * k, mm[5] * k, mm[6] * k, mm[7] * k, mm[8] * k,
    mm[9] * k, mm[10] * k, mm[11] * k, mm[12] * k * 0.92, mm[13] * k * 0.96, mm[14] * k, mm[15] * k, mm[16] * k,
    mm[17] * k, mm[18] * k, mm[18] * k * 0.84, bust, muscle, belly, age,
    if male { 0.4815; } else { 0.4802; }, if male { 0.5054; } else { 0.5118; }, if male { 0.5128; } else { 0.5190; },
    if male { 0.6014; } else { 0.6017; }, if male { 0.7351; } else { 0.7194; }, if male { 0.7567; } else { 0.7607; },
    if male { 0.8203; } else { 0.8198; }, if male { 0.8191; } else { 0.8164; },
    0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5);
}

// The same measures with the face's shape set
fn withFace(m Measures, brow f32, nose f32, noseWidth f32, lips f32, chin f32, cheekbones f32, jaw f32) Measures {
  mut out = m;
  out.brow = brow; out.nose = nose; out.noseWidth = noseWidth; out.lips = lips; out.chin = chin;
  out.cheekbones = cheekbones; out.jaw = jaw;
  out;
}

// The order of the millimetre tables below: stature, biacromial, bideltoid, chest breadth, chest depth,
// waist breadth, waist depth, hip breadth, buttock depth, neck, thigh, calf, biceps (flexed), forearm
// (flexed), wrist girths, head length, head breadth, menton-sellion, bizygomatic

// The average man: the 40 nearest the 50th percentile of stature and of body mass index
pub fn averageMan() Measures {
  imm mm = [1754., 418., 512., 291., 252., 329., 241., 343., 246., 395., 630., 390., 356., 310., 176., 200., 153., 120., 142.];
  fromMillimetres(MALE, &mm, 0., 0.5, 0.35, 30.);
}

// The average woman: the same, for the women
pub fn averageWoman() Measures {
  imm mm = [1626., 365., 451., 270., 246., 303., 208., 352., 231., 330., 606., 369., 306., 260., 154., 189., 150., 114., 133.];
  fromMillimetres(FEMALE, &mm, 0.6, 0.4, 0.3, 28.);
}

// The look of a person: skin and eyes, as sRGB bytes (the albedo of the skin under even light)
pub struct Look {
  pub skin Vec3;             // sRGB 0 to 255
  pub lips Vec3;
  pub brows Vec3;            // the brows and the close-cropped hair's shade
  pub iris Vec3;
  pub hairCover f32;         // how much the close-cropped hair darkens the scalp, 0 bald to 1
}

// What a person wears (outfits.cone)
pub const OUTFIT_SHIRT_TROUSERS = 0u32;
pub const OUTFIT_TUNIC_TROUSERS = 1u32;
pub const OUTFIT_DRESS = 2u32;
pub const OUTFIT_SHIRT_SKIRT = 3u32;

pub struct Person {
  pub name String;
  pub measures Measures;
  pub look Look;
  pub outfit u32;
  pub cloth Vec3;            // the main garment's colour, sRGB
  pub cloth2 Vec3;           // the second's (trousers, skirt)
  pub boots Vec3;
  pub cape bool;             // the main avatar's draped cape
}

fn rgb(r f32, g f32, b f32) Vec3 { new Vec3(r, g, b); }

fn person(name &str, m Measures, look Look, outfit u32, c1 Vec3, c2 Vec3, boots Vec3, cape bool) Person {
  new Person(String.from(name), m, look, outfit, c1, c2, boots, cape);
}

// THE CAST: six people. The survey targets (stature percentile, BMI percentile) are in each comment.
pub fn cast() List[Person] {
  mut out = List[Person].empty();

  // THE MAIN AVATAR (Jon's brief: a man in his thirties, strikingly handsome and stylish, a black cape; RDR2-ish
  // realism, slightly idealised): the 40 men nearest stature P80 and BMI P50 at age 33, 1.807 m, IDEALISED by
  // hand: the waist 8 per cent narrower and 10 per cent shallower than theirs (an athlete's, not a soldier's
  // average), muscle 0.8, no belly; a strong brow, a straight nose, a square chin and jaw, high cheekbones.
  // Olive-light skin, dark brown eyes, close-cropped dark hair
  imm v = [1807., 423., 522., 296., 256., 305., 214., 350., 250., 400., 643., 398., 368., 318., 178., 203., 154., 122., 145.];
  out.push(person("Main avatar", withFace(fromMillimetres(MALE, &v, 0., 0.8, 0., 33.), 0.8, 0.55, 0.45, 0.45, 0.75, 0.75, 0.9),
    new Look(rgb(222., 178., 148.), rgb(184., 116., 104.), rgb(38., 28., 22.), rgb(66., 44., 30.), 0.85),
    OUTFIT_TUNIC_TROUSERS, rgb(96., 24., 32.), rgb(44., 42., 46.), rgb(40., 27., 20.), true));

  // A tall slim man (stature P95, BMI P20): 1.864 m; light skin, blue eyes
  imm a = [1864., 428., 503., 292., 242., 312., 218., 347., 232., 388., 601., 386., 347., 307., 179., 204., 154., 126., 141.];
  out.push(person("Tall slim man", withFace(fromMillimetres(MALE, &a, 0., 0.45, 0.1, 26.), 0.4, 0.7, 0.4, 0.4, 0.5, 0.5, 0.45),
    new Look(rgb(236., 196., 176.), rgb(196., 120., 112.), rgb(120., 86., 60.), rgb(80., 120., 160.), 0.5),
    OUTFIT_SHIRT_TROUSERS, rgb(70., 92., 120.), rgb(78., 70., 60.), rgb(70., 48., 34.), false));

  // A stocky older man (stature P35, BMI P92, age near 50; the survey has few older): 1.731 m; weathered tan
  // skin, brown eyes; his face and skin are given 60 years
  imm b = [1731., 422., 540., 305., 283., 357., 282., 359., 272., 430., 656., 414., 381., 328., 185., 202., 157., 124., 146.];
  out.push(person("Stocky older man", withFace(fromMillimetres(MALE, &b, 0., 0.5, 0.9, 60.), 0.6, 0.65, 0.7, 0.4, 0.45, 0.4, 0.6),
    new Look(rgb(198., 150., 116.), rgb(168., 104., 92.), rgb(150., 146., 140.), rgb(92., 62., 40.), 0.35),
    OUTFIT_SHIRT_TROUSERS, rgb(150., 140., 118.), rgb(64., 66., 76.), rgb(52., 38., 30.), false));

  // The average man (P50, P50): 1.754 m; olive skin, hazel eyes
  out.push(person("Average man", averageMan(),
    new Look(rgb(214., 168., 130.), rgb(176., 110., 98.), rgb(60., 44., 34.), rgb(110., 96., 56.), 0.6),
    OUTFIT_SHIRT_TROUSERS, rgb(168., 70., 52.), rgb(96., 82., 66.), rgb(60., 42., 30.), false));

  // A petite woman (stature P5, BMI P35): 1.530 m; deep brown skin, dark eyes
  imm c = [1530., 348., 428., 258., 231., 276., 196., 336., 216., 316., 582., 350., 287., 250., 147., 184., 146., 111., 132.];
  out.push(person("Petite woman", withFace(fromMillimetres(FEMALE, &c, 0.5, 0.35, 0.2, 24.), 0.2, 0.35, 0.65, 0.75, 0.35, 0.6, 0.3),
    new Look(rgb(120., 78., 56.), rgb(110., 62., 58.), rgb(28., 20., 16.), rgb(52., 34., 24.), 0.7),
    OUTFIT_DRESS, rgb(196., 150., 52.), rgb(196., 150., 52.), rgb(64., 40., 30.), false));

  // A tall athletic woman (stature P95, BMI P55): 1.734 m; medium brown skin, grey-green eyes
  imm d = [1734., 388., 467., 278., 246., 311., 216., 371., 242., 340., 652., 390., 314., 276., 162., 197., 152., 117., 137.];
  out.push(person("Tall athletic woman", withFace(fromMillimetres(FEMALE, &d, 0.45, 0.85, 0.1, 26.), 0.3, 0.5, 0.45, 0.55, 0.55, 0.7, 0.45),
    new Look(rgb(168., 118., 84.), rgb(150., 92., 84.), rgb(40., 28., 20.), rgb(96., 112., 92.), 0.65),
    OUTFIT_SHIRT_TROUSERS, rgb(60., 110., 96.), rgb(70., 62., 54.), rgb(58., 40., 30.), false));

  // The average woman (P50, P50): 1.626 m; fair skin with a warm tone, brown eyes
  out.push(person("Average woman", averageWoman(),
    new Look(rgb(232., 186., 160.), rgb(198., 112., 110.), rgb(92., 60., 40.), rgb(100., 70., 46.), 0.55),
    OUTFIT_SHIRT_SKIRT, rgb(226., 222., 206.), rgb(112., 46., 62.), rgb(70., 46., 34.), false));
  out;
}

// A measure by number, for the gains (forms.cone) and the blends (blends.cone): the breadths, depths and
// girths in order
pub const MEASURE_COUNT = 15usize;

pub fn measureAt(m &Measures, i usize) f32 {
  if i == 0usize { return m.biacromial; }
  if i == 1usize { return m.bideltoid; }
  if i == 2usize { return m.chestBreadth; }
  if i == 3usize { return m.chestDepth; }
  if i == 4usize { return m.waistBreadth; }
  if i == 5usize { return m.waistDepth; }
  if i == 6usize { return m.hipBreadth; }
  if i == 7usize { return m.buttockDepth; }
  if i == 8usize { return m.neckGirth; }
  if i == 9usize { return m.thighGirth; }
  if i == 10usize { return m.calfGirth; }
  if i == 11usize { return m.armGirth; }
  if i == 12usize { return m.forearmGirth; }
  if i == 13usize { return m.wristGirth; }
  m.headBreadth;
}

pub fn setMeasure(m &mut Measures, i usize, v f32) {
  if i == 0usize { m.biacromial = v; return; }
  if i == 1usize { m.bideltoid = v; return; }
  if i == 2usize { m.chestBreadth = v; return; }
  if i == 3usize { m.chestDepth = v; return; }
  if i == 4usize { m.waistBreadth = v; return; }
  if i == 5usize { m.waistDepth = v; return; }
  if i == 6usize { m.hipBreadth = v; return; }
  if i == 7usize { m.buttockDepth = v; return; }
  if i == 8usize { m.neckGirth = v; return; }
  if i == 9usize { m.thighGirth = v; return; }
  if i == 10usize { m.calfGirth = v; return; }
  if i == 11usize { m.armGirth = v; return; }
  if i == 12usize { m.forearmGirth = v; return; }
  if i == 13usize { m.wristGirth = v; return; }
  m.headBreadth = v;
}

pub fn measureName(i usize) String {
  imm names = ["biacromial", "bideltoid", "chest breadth", "chest depth", "waist breadth", "waist depth", "hip breadth",
    "buttock depth", "neck girth", "thigh girth", "calf girth", "arm girth", "forearm girth", "wrist girth", "head breadth"];
  String.from(names[i]);
}
