// The face rig on the body: facerig's FACS units as morph targets of the whole mesh, the jaw and the eyes
// as bones, and the parts that are not skin (the eyeballs, the teeth, the tongue, the mouth's inside).
//
// facerig builds a unit's morph target from rules that act near named LANDMARKS, so any mesh with a spec
// moves. The spec here is read off the head: the eyes' centres and the lids' edges are the head's own numbers
// (head.cone places them), the rest (brows, nose, cheeks, lips, chin, the jaw's angle, the mouth's corners)
// are the head's grid points nearest where those features are on this face. Landmarks are in model space,
// as the mesh is, so the spec's frame is the model's and the face bones hang off the head bone at its place.
//
// The targets are built for each person from their own mesh (a person's face is theirs), but because every
// person has the same vertices, a target's vertex numbers are the same for everyone: what a smile moves on
// one face it moves on any.

pub struct FaceParts {
  pub ears Mesh;          // both ears, the head's (drawn in the skin)
  pub earsSkin Skin;
  pub eyes Mesh;          // both eyeballs, skinned to the eye bones
  pub teeth Mesh;         // upper (the head) and lower (the jaw)
  pub tongue Mesh;        // the jaw
  pub cavity Mesh;        // the mouth's dark inside, the head
  pub eyesSkin Skin;
  pub teethSkin Skin;
  pub tongueSkin Skin;
  pub cavitySkin Skin;
}

pub struct BodyFace {
  pub spec FaceSpec;
  pub units List[UnitDef];
  pub targets FaceTargets;
  pub bones FaceBones;
  pub parts FaceParts;
}

// The head's grid point nearest (x, y) of the head frame, on the face's front; model space
fn nearFront(body &Body, x f32, y f32) Vec3 {
  let o = body.head.origin;
  var best = 1000000.;
  var at = o + new Vec3(x, y, -0.09);
  var v = body.headStart;
  while v < body.mesh.positions.len() {
    let p = *body.mesh.positions[v] - o;
    if p.z < -0.03 {
      let d = (p.x - x) * (p.x - x) + (p.y - y) * (p.y - y);
      if d < best { best = d; at = *body.mesh.positions[v]; }
    }
    v = v + 1usize;
  }
  at;
}

fn addPair(spec &mut FaceSpec, body &Body, name &str, x f32, y f32) {
  var r = String.from(name);
  r.append("R");
  var l = String.from(name);
  l.append("L");
  spec.add(r.view(), nearFront(body, x, y));
  spec.add(l.view(), nearFront(body, 0. - x, y));
}

// The face's spec, read off the body's head
pub fn faceSpecOf(body &Body) FaceSpec {
  let hd = &body.head;
  let s = &hd.shape;
  let ft = &hd.ft;
  let o = hd.origin;
  var spec = FaceSpec.empty();
  var side = 1.;
  while side > -2. {
    let c = *body.points[if side > 0. { POINT_EYE_R; } else { POINT_EYE_L; }];
    let sfx = if side > 0. { "R"; } else { "L"; };
    var nm = String.from("eyeCenter");
    nm.append(sfx);
    spec.add(nm.view(), c);
    nm = String.from("lidUpper");
    nm.append(sfx);
    spec.add(nm.view(), new Vec3(c.x, c.y + ft.lidHU, c.z - (ft.shell * ft.shell - ft.lidHU * ft.lidHU).sqrt()));
    nm = String.from("lidLower");
    nm.append(sfx);
    spec.add(nm.view(), new Vec3(c.x, c.y - ft.lidHL, c.z - (ft.shell * ft.shell - ft.lidHL * ft.lidHL).sqrt()));
    side = side - 2.;
  }
  let f = s.sF;
  let tipY = noseTipY(s);
  addPair(&mut spec, body, "browInner", 0.014, 0.0245 * f);
  addPair(&mut spec, body, "browMid", 0.031, 0.029 * f);
  addPair(&mut spec, body, "browOuter", 0.050, 0.024 * f);
  addPair(&mut spec, body, "noseBridge", 0.005, -0.006 * f);
  addPair(&mut spec, body, "noseWing", 0.0115 + 0.003 * s.noseWidth, tipY - 0.006);
  addPair(&mut spec, body, "cheek", 0.046, -0.036 * f);
  addPair(&mut spec, body, "lipUpper", 0.011, ft.yg + 0.0050);
  addPair(&mut spec, body, "lipLower", 0.012, ft.yg - 0.0070);
  addPair(&mut spec, body, "chinCenter", 0.006, ft.menton + 0.014);
  addPair(&mut spec, body, "jawAngle", s.jaw - 0.006, -0.090 * f);
  spec.add("glabella", nearFront(body, 0., 0.020 * f));
  spec.add("noseTip", nearFront(body, 0., tipY));
  let upperPad = nearFront(body, 0., ft.yg + 0.0050);
  spec.add("lipUpper", upperPad);
  spec.add("lipLower", nearFront(body, 0., ft.yg - 0.0070));
  spec.add("lipContact", new Vec3(o.x, (*body.points[POINT_MOUTH]).y, upperPad.z));
  spec.add("philtrum", nearFront(body, 0., ft.yg + 0.013));
  spec.add("chinTip", nearFront(body, 0., ft.menton + 0.003));
  spec.add("mouthCornerR", nearFront(body, ft.mouthHW + 0.0010, ft.yg));
  spec.add("mouthCornerL", nearFront(body, 0. - ft.mouthHW - 0.0010, ft.yg));
  spec.scale = s.ipd;
  spec.eyeRadius = s.eyeR;
  spec.upperLidEdge = asin(ft.lidHU / ft.shell);
  spec.lowerLidEdge = asin(ft.lidHL / ft.shell);
  spec.closingLine = -0.10;
  spec.jawPivot = *body.points[POINT_JAW];
  // the jaw's opening at AU26 = 1: about 17 degrees (a wide 'ah' is some 10 to 12; facerig's default of 26 is a yawn)
  spec.jawOpenMax = 0.30;
  spec.scale = (*body.points[POINT_EYE_R] - *body.points[POINT_EYE_L]).length();
  spec;
}

fn ellipsoidMesh(r Vec3, c Vec3, seg i32) Mesh {
  var m = Mesh.sphere(1., seg);
  m.transform(Mat4.fromTrs(c, Quat.identity(), r));
  m;
}

// An eyeball with its pole along -z (a cornea's bulge in front), its uv a planar projection along z (paintEye's)
fn eyeball(radius f32, seg i32) Mesh {
  var m = Mesh.empty();
  let n = seg;
  var i = 0;
  while i <= n {
    let phi = pi * f32.from(i) / f32.from(n);
    var j = 0;
    while j <= n {
      let psi = 2. * pi * f32.from(j) / f32.from(n);
      let sx = sin(phi) * cos(psi);
      let sy = sin(phi) * sin(psi);
      let sz = 0. - cos(phi);
      let bulge = 0.0009 * (1. - smoothstep(0.35, 0.62, phi));
      let r = radius + bulge;
      m.positions.push(new Vec3(sx * r, sy * r, sz * r));
      m.normals.push(new Vec3(sx, sy, sz));
      m.uvs.push(new Vec2(0.5 + 0.5 * sx, 0.5 + 0.5 * sy));
      j = j + 1;
    }
    i = i + 1;
  }
  i = 0;
  while i < n {
    var j = 0;
    while j < n {
      let a = u32.from(i * (n + 1) + j);
      let b = u32.from(i * (n + 1) + j + 1);
      let c = u32.from((i + 1) * (n + 1) + j + 1);
      let d = u32.from((i + 1) * (n + 1) + j);
      m.indices.push(a); m.indices.push(b); m.indices.push(c);
      m.indices.push(a); m.indices.push(c); m.indices.push(d);
      j = j + 1;
    }
    i = i + 1;
  }
  m;
}

fn rigidSkin(m &Mesh, bone usize) Skin {
  var s = Skin.empty();
  var v = 0usize;
  while v < m.positions.len() { s.push(u32.from(bone), 0u32, 0u32, 0u32, 1., 0., 0., 0.); v = v + 1usize; }
  s;
}

// The eyeballs, teeth, tongue and mouth's inside for the body's head, in model space
fn faceParts(body &Body) FaceParts {
  let hd = &body.head;
  let s = &hd.shape;
  let ft = &hd.ft;
  var eyes = Mesh.empty();
  var eyesSkin = Skin.empty();
  var side = 1.;
  while side > -2. {
    // (half a millimetre inside the head's eyeball, so the smoothed skin round the orbit never lets it show through)
    var e = eyeball(s.eyeR - 0.0005, 32);
    e.transform(Mat4.fromTranslation(*body.points[if side > 0. { POINT_EYE_R; } else { POINT_EYE_L; }]));
    let bone = if side > 0. { EYE_R; } else { EYE_L; };
    var v = 0usize;
    while v < e.positions.len() { eyesSkin.push(u32.from(bone), 0u32, 0u32, 0u32, 1., 0., 0., 0.); v = v + 1usize; }
    eyes.append(&e);
    side = side - 2.;
  }
  // the teeth: six blocks above and below the mouth's line, behind the lips, on the dental arch (placed from
  // the mouth's point, which blends with the mesh)
  let mo = *body.points[POINT_MOUTH];
  let o = new Vec3(mo.x, mo.y - ft.yg, mo.z - ft.lipZ);
  var teeth = Mesh.empty();
  var teethSkin = Skin.empty();
  let xs = [-0.0185, -0.0122, -0.0042, 0.0042, 0.0122, 0.0185];
  let halfW = [0.0048, 0.0035, 0.0041, 0.0041, 0.0035, 0.0048];
  var t = 0usize;
  while t < 6usize {
    let ax = absf(xs[t]);
    let zc = ft.lipZ + 0.0175 + (ax / 0.019) * (ax / 0.019) * 0.0072;
    let tu = ellipsoidMesh(new Vec3(halfW[t], 0.0050, 0.0040), o + new Vec3(xs[t], ft.yg + 0.0040, zc), 10);
    var v = 0usize;
    while v < tu.positions.len() { teethSkin.push(u32.from(HEAD), 0u32, 0u32, 0u32, 1., 0., 0., 0.); v = v + 1usize; }
    teeth.append(&tu);
    let tl = ellipsoidMesh(new Vec3(halfW[t] * 0.92, 0.0044, 0.0038), o + new Vec3(xs[t], ft.yg - 0.0040, zc + 0.0034), 10);
    v = 0usize;
    while v < tl.positions.len() { teethSkin.push(u32.from(JAW), 0u32, 0u32, 0u32, 1., 0., 0., 0.); v = v + 1usize; }
    teeth.append(&tl);
    t = t + 1usize;
  }
  // the tongue lies low in the jaw, its top well under the lower teeth's edges, so an open mouth shows the teeth and
  // the dark behind them and the tongue only as a shadowed floor
  let tongue = ellipsoidMesh(new Vec3(0.0140, 0.0045, 0.0180), o + new Vec3(0., ft.yg - 0.0125, ft.lipZ + 0.050), 14);
  let cavity = ellipsoidMesh(new Vec3(0.0280, 0.0200, 0.0230), o + new Vec3(0., ft.yg - 0.0040, ft.lipZ + 0.046), 18);
  let tongueSkin = rigidSkin(&tongue, JAW);
  let cavitySkin = rigidSkin(&cavity, HEAD);
  var ears = Mesh.empty();
  side = 1.;
  while side > -2. {
    let e = earMesh(body, side);
    ears.append(&e);
    side = side - 2.;
  }
  let earsSkin = rigidSkin(&ears, HEAD);
  new FaceParts(ears, earsSkin, eyes, teeth, tongue, cavity, eyesSkin, teethSkin, tongueSkin, cavitySkin);
}

// An ear's field in its own frame (x out from the head, y up, z back): the flat shell of the auricle, the rolled rim
// of the helix round its top and back, the bowl of the concha before the canal, the lobe
fn earDistance(p Vec3) f32 {
  var d = ellipsoid(p - new Vec3(0.004, 0., 0.), new Vec3(0.0060, 0.0300, 0.0170));
  // the helix: a rim of short capsules along the ear's outline from the front top round the back to the lobe
  var a = 0.;
  var prev = new Vec3(0.0065, 0.022, -0.010);
  while a <= 1.0 {
    let ang = 0.15 + a * 2.6;
    let q = new Vec3(0.0068 - 0.0020 * a, 0.0265 * cos(ang), 0.0150 * sin(ang) - 0.002);
    d = softUnion(d, taperedCapsule(p, prev, q, 0.0032, 0.0032), 0.0015);
    prev = q;
    a = a + 0.125;
  }
  // the concha, a bowl in the outer face before the canal
  d = smoothSubtract(d, ellipsoid(p - new Vec3(0.0105, -0.004, -0.001), new Vec3(0.0060, 0.0105, 0.0080)), 0.002);
  // the lobe
  d = softUnion(d, ellipsoid(p - new Vec3(0.004, -0.026, 0.002), new Vec3(0.0045, 0.0080, 0.0068)), 0.002);
  d;
}

// An ear: a sphere's points pushed out from the ear's middle to its surface (a first exit along each ray), placed on the
// side of the head, leaning back
fn earMesh(body &Body, side f32) Mesh {
  let hd = &body.head;
  let s = &hd.shape;
  let o = hd.origin;
  let at = o + new Vec3(side * (0.5 * body.measures.headBreadth - 0.006), -0.012 * s.sF, 0.012 * s.sL);
  let lean = Quat.angleAxis(0.26, new Vec3(1., 0., 0.));
  var m = Mesh.sphere(1., 28);
  let centre = new Vec3(0.003, -0.001, 0.);
  var v = 0usize;
  while v < m.positions.len() {
    let dir = (*m.positions[v]).normalize();
    var t = 0.;
    var prevIn = earDistance(centre) <= 0.;
    var found = 0.04;
    while t < 0.04 {
      let inside = earDistance(centre + dir * t) <= 0.;
      if prevIn and !inside { found = t; t = 1.; } else { prevIn = inside; t = t + 0.0004; }
    }
    let onEar = centre + dir * found;
    // the ear's frame: x out of the head on this side, y up, z back; leaning back
    let lp = lean * new Vec3(onEar.x * side, onEar.y, onEar.z);
    m.positions.set(v, at + lp);
    v = v + 1usize;
  }
  // the left ear is the right one mirrored: its triangles turn the other way
  if side < 0. {
    var k = 0usize;
    while k + 2usize < m.indices.len() {
      let tt = *m.indices[k + 1usize];
      m.indices.set(k + 1usize, *m.indices[k + 2usize]);
      m.indices.set(k + 2usize, tt);
      k = k + 3usize;
    }
  }
  m.computeSmoothNormals();
  // a plain patch of the skin's texture
  v = 0usize;
  while v < m.uvs.len() { m.uvs.set(v, new Vec2(0.5, 0.47)); v = v + 1usize; }
  m;
}

// The face of a body: its spec, the unit table, the targets built on its mesh, and its bones added to the
// skeleton (the jaw and the eyes, bones 19 to 21: body.cone's JAW, EYE_L and EYE_R)
pub fn buildFace(body &mut Body) BodyFace {
  let spec = faceSpecOf(body);
  // facerig's lids turn a region 0.45 face-scales tall about the eyeball, sized for its test head; on these faces the
  // brow sits closer above the lid, and a closing lid dragged the brow's inner end down into a kink. Every turning
  // rule (only the lids turn) is kept to 0.6 of that height
  var units = standardUnits();
  var u = 0usize;
  while u < units.len() {
    var k = 0usize;
    while k < units[u].influences.len() {
      if units[u].influences[k].kind == INFL_TURN {
        let r = units[u].influences[k].radii;
        units[u].influences[k].radii = new Vec3(r.x, r.y * 0.6, r.z);
      }
      k = k + 1usize;
    }
    u = u + 1usize;
  }
  let targets = buildTargets(&body.mesh, &spec, &units);
  let models = restModels(&body.skeleton);
  let headAt = (*models[HEAD]).translation;
  let bones = attachFace(&mut body.skeleton, HEAD, &spec, new Vec3(0., 0., 0.) - headAt);
  let parts = faceParts(body);
  new BodyFace(spec, units, targets, bones, parts);
}

// How far each action unit's target may move these faces at full value, as a share of facerig's rule. facerig's
// rules are sized so that a unit at 1 reads at a glance on its small test head; on a person at game scale they
// are a caricature (a full smile pulled the corners half a face-scale out and up). These are set against the
// face plate (Gray's) and photographs of moderate expressions: the mouth's units most, the brows and lids less,
// the lids' closing and the gaze's channels not at all (a blink must shut the eye)
pub fn naturalStrength(au u32) f32 {
  if au == AU_LIP_CORNER_PULLER { return 0.35; }
  if au == AU_CHEEK_RAISER or au == AU_DIMPLER or au == AU_LIP_STRETCHER or au == AU_LIP_CORNER_DEPRESSOR { return 0.45; }
  if au == AU_UPPER_LIP_RAISER or au == AU_LOWER_LIP_DEPRESSOR or au == AU_NOSE_WRINKLER { return 0.45; }
  if au == AU_LIP_PUCKER or au == AU_LIP_FUNNELER or au == AU_LIP_TIGHTENER or au == AU_LIP_PRESSOR or au == AU_LIP_SUCK { return 0.5; }
  if au == AU_CHIN_RAISER or au == AU_CHEEK_BLOW { return 0.5; }
  if au == AU_LIPS_PART { return 0.6; }
  if au == AU_INNER_BROW_RAISER or au == AU_OUTER_BROW_RAISER or au == AU_BROW_LOWERER { return 0.55; }
  if au == AU_UPPER_LID_RAISER or au == AU_LID_TIGHTENER { return 0.6; }
  1.;
}

// The face's targets as render's morph targets, each at its unit's natural strength
pub fn morphTargetsOf(face &BodyFace, vertexCount usize) MorphTargets {
  var mt = MorphTargets.empty(vertexCount);
  let noTan = List[Vec3].empty();
  // each target's unit (the first unit that uses it)
  var strength = List[f32].empty();
  var t = 0usize;
  while t < face.targets.count() { strength.push(1.); t = t + 1usize; }
  var set = List[bool].empty();
  t = 0usize;
  while t < face.targets.count() { set.push(false); t = t + 1usize; }
  var u = 0usize;
  while u < face.targets.unitTarget.len() and u < face.units.len() {
    let ti = *face.targets.unitTarget[u];
    if ti >= 0i32 and not *set[usize.from(ti)] {
      strength.set(usize.from(ti), naturalStrength(face.units[u].au));
      set.set(usize.from(ti), true);
    }
    u = u + 1usize;
  }
  t = 0usize;
  while t < face.targets.count() {
    let k = *strength[t];
    var dp = face.targets.positionsOf(t);
    var dn = face.targets.normalsOf(t);
    var i = 0usize;
    while i < dp.len() { dp.set(i, *dp[i] * k); dn.set(i, *dn[i] * k); i = i + 1usize; }
    mt.addSparse(&face.targets.indicesOf(t), &dp, &dn, &noTan);
    t = t + 1usize;
  }
  mt;
}
