// The face rig on the body: facerig's FACS units as morph targets of the whole mesh, the jaw and the eyes
// as bones, and the parts that are not skin (the eyeballs, the teeth, the tongue, the mouth's inside).
//
// facerig builds a unit's morph target from rules that act near named LANDMARKS, so any mesh with a spec
// moves. The spec here is read off the head: the eyes' centres and the lids' edges are the head's own numbers
// (head.cone places them), the rest (brows, nose, cheeks, lips, chin, the jaw's angle, the mouth's corners)
// are the head's grid points nearest where those features are on this face. Landmarks are in model space,
// as the mesh is, so the spec's frame is the model's and the face bones hang off the head bone at its place.
//
// The targets are built for each person from their own mesh (a person's face is theirs), but because every
// person has the same vertices, a target's vertex numbers are the same for everyone: what a smile moves on
// one face it moves on any.

pub struct FaceParts {
  pub ears Mesh;          // both ears, the head's (drawn in the skin)
  pub earsSkin Skin;
  pub eyes Mesh;          // both eyeballs, skinned to the eye bones
  pub teeth Mesh;         // upper (the head) and lower (the jaw)
  pub tongue Mesh;        // the jaw
  pub cavity Mesh;        // the mouth's dark inside, the head
  pub eyesSkin Skin;
  pub teethSkin Skin;
  pub tongueSkin Skin;
  pub cavitySkin Skin;
}

pub struct BodyFace {
  pub spec FaceSpec;
  pub units List[UnitDef];
  pub targets FaceTargets;
  pub bones FaceBones;
  pub parts FaceParts;
}

// The head's grid point nearest (x, y) of the head frame, on the face's front; model space
fn nearFront(body &Body, x f32, y f32) Vec3 {
  imm o = body.head.origin;
  mut best = 1000000.;
  mut at = o + new Vec3(x, y, -0.09);
  mut v = body.headStart;
  while v < body.mesh.positions.len() {
    imm p = *body.mesh.positions[v] - o;
    if p.z < -0.03 {
      imm d = (p.x - x) * (p.x - x) + (p.y - y) * (p.y - y);
      if d < best { best = d; at = *body.mesh.positions[v]; }
    }
    v = v + 1usize;
  }
  at;
}

fn addPair(spec &mut FaceSpec, body &Body, name &str, x f32, y f32) {
  mut r = String.from(name);
  r.append("R");
  mut l = String.from(name);
  l.append("L");
  spec.add(r.view(), nearFront(body, x, y));
  spec.add(l.view(), nearFront(body, 0. - x, y));
}

// The face's spec, read off the body's head
pub fn faceSpecOf(body &Body) FaceSpec {
  imm hd = &body.head;
  imm s = &hd.shape;
  imm ft = &hd.ft;
  imm o = hd.origin;
  mut spec = FaceSpec.empty();
  mut side = 1.;
  while side > -2. {
    imm c = *body.points[if side > 0. { POINT_EYE_R; } else { POINT_EYE_L; }];
    imm sfx = if side > 0. { "R"; } else { "L"; };
    mut nm = String.from("eyeCenter");
    nm.append(sfx);
    spec.add(nm.view(), c);
    nm = String.from("lidUpper");
    nm.append(sfx);
    spec.add(nm.view(), new Vec3(c.x, c.y + ft.lidHU, c.z - (ft.shell * ft.shell - ft.lidHU * ft.lidHU).sqrt()));
    nm = String.from("lidLower");
    nm.append(sfx);
    spec.add(nm.view(), new Vec3(c.x, c.y - ft.lidHL, c.z - (ft.shell * ft.shell - ft.lidHL * ft.lidHL).sqrt()));
    side = side - 2.;
  }
  imm f = s.sF;
  imm tipY = noseTipY(s);
  addPair(&mut spec, body, "browInner", 0.014, 0.0245 * f);
  addPair(&mut spec, body, "browMid", 0.031, 0.029 * f);
  addPair(&mut spec, body, "browOuter", 0.050, 0.024 * f);
  addPair(&mut spec, body, "noseBridge", 0.005, -0.006 * f);
  addPair(&mut spec, body, "noseWing", 0.0115 + 0.003 * s.noseWidth, tipY - 0.006);
  addPair(&mut spec, body, "cheek", 0.046, -0.036 * f);
  addPair(&mut spec, body, "lipUpper", 0.011, ft.yg + 0.0050);
  addPair(&mut spec, body, "lipLower", 0.012, ft.yg - 0.0070);
  addPair(&mut spec, body, "chinCenter", 0.006, ft.menton + 0.014);
  addPair(&mut spec, body, "jawAngle", s.jaw - 0.006, -0.090 * f);
  spec.add("glabella", nearFront(body, 0., 0.020 * f));
  spec.add("noseTip", nearFront(body, 0., tipY));
  imm upperPad = nearFront(body, 0., ft.yg + 0.0050);
  spec.add("lipUpper", upperPad);
  spec.add("lipLower", nearFront(body, 0., ft.yg - 0.0070));
  spec.add("lipContact", new Vec3(o.x, (*body.points[POINT_MOUTH]).y, upperPad.z));
  spec.add("philtrum", nearFront(body, 0., ft.yg + 0.013));
  spec.add("chinTip", nearFront(body, 0., ft.menton + 0.003));
  spec.add("mouthCornerR", nearFront(body, ft.mouthHW + 0.0010, ft.yg));
  spec.add("mouthCornerL", nearFront(body, 0. - ft.mouthHW - 0.0010, ft.yg));
  spec.scale = s.ipd;
  spec.eyeRadius = s.eyeR;
  spec.upperLidEdge = asin(ft.lidHU / ft.shell);
  spec.lowerLidEdge = asin(ft.lidHL / ft.shell);
  spec.closingLine = -0.10;
  spec.jawPivot = *body.points[POINT_JAW];
  spec.scale = (*body.points[POINT_EYE_R] - *body.points[POINT_EYE_L]).length();
  spec;
}

fn ellipsoidMesh(r Vec3, c Vec3, seg i32) Mesh {
  mut m = Mesh.sphere(1., seg);
  m.transform(Mat4.fromTrs(c, Quat.identity(), r));
  m;
}

// An eyeball with its pole along -z (a cornea's bulge in front), its uv a planar projection along z (paintEye's)
fn eyeball(radius f32, seg i32) Mesh {
  mut m = Mesh.empty();
  imm n = seg;
  mut i = 0;
  while i <= n {
    imm phi = pi * f32.from(i) / f32.from(n);
    mut j = 0;
    while j <= n {
      imm psi = 2. * pi * f32.from(j) / f32.from(n);
      imm sx = sin(phi) * cos(psi);
      imm sy = sin(phi) * sin(psi);
      imm sz = 0. - cos(phi);
      imm bulge = 0.0009 * (1. - smoothstep(0.35, 0.62, phi));
      imm r = radius + bulge;
      m.positions.push(new Vec3(sx * r, sy * r, sz * r));
      m.normals.push(new Vec3(sx, sy, sz));
      m.uvs.push(new Vec2(0.5 + 0.5 * sx, 0.5 + 0.5 * sy));
      j = j + 1;
    }
    i = i + 1;
  }
  i = 0;
  while i < n {
    mut j = 0;
    while j < n {
      imm a = u32.from(i * (n + 1) + j);
      imm b = u32.from(i * (n + 1) + j + 1);
      imm c = u32.from((i + 1) * (n + 1) + j + 1);
      imm d = u32.from((i + 1) * (n + 1) + j);
      m.indices.push(a); m.indices.push(b); m.indices.push(c);
      m.indices.push(a); m.indices.push(c); m.indices.push(d);
      j = j + 1;
    }
    i = i + 1;
  }
  m;
}

fn rigidSkin(m &Mesh, bone usize) Skin {
  mut s = Skin.empty();
  mut v = 0usize;
  while v < m.positions.len() { s.push(u32.from(bone), 0u32, 0u32, 0u32, 1., 0., 0., 0.); v = v + 1usize; }
  s;
}

// The eyeballs, teeth, tongue and mouth's inside for the body's head, in model space
fn faceParts(body &Body) FaceParts {
  imm hd = &body.head;
  imm s = &hd.shape;
  imm ft = &hd.ft;
  mut eyes = Mesh.empty();
  mut eyesSkin = Skin.empty();
  mut side = 1.;
  while side > -2. {
    mut e = eyeball(s.eyeR, 32);
    e.transform(Mat4.fromTranslation(*body.points[if side > 0. { POINT_EYE_R; } else { POINT_EYE_L; }]));
    imm bone = if side > 0. { EYE_R; } else { EYE_L; };
    mut v = 0usize;
    while v < e.positions.len() { eyesSkin.push(u32.from(bone), 0u32, 0u32, 0u32, 1., 0., 0., 0.); v = v + 1usize; }
    eyes.append(&e);
    side = side - 2.;
  }
  // the teeth: six blocks above and below the mouth's line, behind the lips, on the dental arch (placed from
  // the mouth's point, which blends with the mesh)
  imm mo = *body.points[POINT_MOUTH];
  imm o = new Vec3(mo.x, mo.y - ft.yg, mo.z - ft.lipZ);
  mut teeth = Mesh.empty();
  mut teethSkin = Skin.empty();
  imm xs = [-0.0185, -0.0122, -0.0042, 0.0042, 0.0122, 0.0185];
  imm halfW = [0.0048, 0.0035, 0.0041, 0.0041, 0.0035, 0.0048];
  mut t = 0usize;
  while t < 6usize {
    imm ax = absf(xs[t]);
    imm zc = ft.lipZ + 0.0175 + (ax / 0.019) * (ax / 0.019) * 0.0072;
    imm tu = ellipsoidMesh(new Vec3(halfW[t], 0.0050, 0.0040), o + new Vec3(xs[t], ft.yg + 0.0040, zc), 10);
    mut v = 0usize;
    while v < tu.positions.len() { teethSkin.push(u32.from(HEAD), 0u32, 0u32, 0u32, 1., 0., 0., 0.); v = v + 1usize; }
    teeth.append(&tu);
    imm tl = ellipsoidMesh(new Vec3(halfW[t] * 0.92, 0.0044, 0.0038), o + new Vec3(xs[t], ft.yg - 0.0040, zc + 0.0034), 10);
    v = 0usize;
    while v < tl.positions.len() { teethSkin.push(u32.from(JAW), 0u32, 0u32, 0u32, 1., 0., 0., 0.); v = v + 1usize; }
    teeth.append(&tl);
    t = t + 1usize;
  }
  imm tongue = ellipsoidMesh(new Vec3(0.0145, 0.0050, 0.0185), o + new Vec3(0., ft.yg - 0.0085, ft.lipZ + 0.047), 14);
  imm cavity = ellipsoidMesh(new Vec3(0.0280, 0.0200, 0.0230), o + new Vec3(0., ft.yg - 0.0040, ft.lipZ + 0.046), 18);
  imm tongueSkin = rigidSkin(&tongue, JAW);
  imm cavitySkin = rigidSkin(&cavity, HEAD);
  mut ears = Mesh.empty();
  side = 1.;
  while side > -2. {
    imm e = earMesh(body, side);
    ears.append(&e);
    side = side - 2.;
  }
  imm earsSkin = rigidSkin(&ears, HEAD);
  new FaceParts(ears, earsSkin, eyes, teeth, tongue, cavity, eyesSkin, teethSkin, tongueSkin, cavitySkin);
}

// An ear's field in its own frame (x out from the head, y up, z back): the flat shell of the auricle, the rolled rim
// of the helix round its top and back, the bowl of the concha before the canal, the lobe
fn earDistance(p Vec3) f32 {
  mut d = ellipsoid(p - new Vec3(0.004, 0., 0.), new Vec3(0.0060, 0.0300, 0.0170));
  // the helix: a rim of short capsules along the ear's outline from the front top round the back to the lobe
  mut a = 0.;
  mut prev = new Vec3(0.0065, 0.022, -0.010);
  while a <= 1.0 {
    imm ang = 0.15 + a * 2.6;
    imm q = new Vec3(0.0068 - 0.0020 * a, 0.0265 * cos(ang), 0.0150 * sin(ang) - 0.002);
    d = softUnion(d, taperedCapsule(p, prev, q, 0.0032, 0.0032), 0.0015);
    prev = q;
    a = a + 0.125;
  }
  // the concha, a bowl in the outer face before the canal
  d = smoothSubtract(d, ellipsoid(p - new Vec3(0.0105, -0.004, -0.001), new Vec3(0.0060, 0.0105, 0.0080)), 0.002);
  // the lobe
  d = softUnion(d, ellipsoid(p - new Vec3(0.004, -0.026, 0.002), new Vec3(0.0045, 0.0080, 0.0068)), 0.002);
  d;
}

// An ear: a sphere's points pushed out from the ear's middle to its surface (a first exit along each ray), placed on the
// side of the head, leaning back
fn earMesh(body &Body, side f32) Mesh {
  imm hd = &body.head;
  imm s = &hd.shape;
  imm o = hd.origin;
  imm at = o + new Vec3(side * (0.5 * body.measures.headBreadth - 0.006), -0.012 * s.sF, 0.012 * s.sL);
  imm lean = Quat.angleAxis(0.26, new Vec3(1., 0., 0.));
  mut m = Mesh.sphere(1., 28);
  imm centre = new Vec3(0.003, -0.001, 0.);
  mut v = 0usize;
  while v < m.positions.len() {
    imm dir = (*m.positions[v]).normalize();
    mut t = 0.;
    mut prevIn = earDistance(centre) <= 0.;
    mut found = 0.04;
    while t < 0.04 {
      imm inside = earDistance(centre + dir * t) <= 0.;
      if prevIn and !inside { found = t; t = 1.; } else { prevIn = inside; t = t + 0.0004; }
    }
    imm onEar = centre + dir * found;
    // the ear's frame: x out of the head on this side, y up, z back; leaning back
    imm lp = lean * new Vec3(onEar.x * side, onEar.y, onEar.z);
    m.positions.set(v, at + lp);
    v = v + 1usize;
  }
  // the left ear is the right one mirrored: its triangles turn the other way
  if side < 0. {
    mut k = 0usize;
    while k + 2usize < m.indices.len() {
      imm tt = *m.indices[k + 1usize];
      m.indices.set(k + 1usize, *m.indices[k + 2usize]);
      m.indices.set(k + 2usize, tt);
      k = k + 3usize;
    }
  }
  m.computeSmoothNormals();
  // a plain patch of the skin's texture
  v = 0usize;
  while v < m.uvs.len() { m.uvs.set(v, new Vec2(0.5, 0.47)); v = v + 1usize; }
  m;
}

// The face of a body: its spec, the unit table, the targets built on its mesh, and its bones added to the
// skeleton (the jaw and the eyes, bones 19 to 21: body.cone's JAW, EYE_L and EYE_R)
pub fn buildFace(body &mut Body) BodyFace {
  imm spec = faceSpecOf(body);
  imm units = standardUnits();
  imm targets = buildTargets(&body.mesh, &spec, &units);
  imm models = restModels(&body.skeleton);
  imm headAt = (*models[HEAD]).translation;
  imm bones = attachFace(&mut body.skeleton, HEAD, &spec, new Vec3(0., 0., 0.) - headAt);
  imm parts = faceParts(body);
  new BodyFace(spec, units, targets, bones, parts);
}

// The face's targets as render's morph targets
pub fn morphTargetsOf(face &BodyFace, vertexCount usize) MorphTargets {
  mut mt = MorphTargets.empty(vertexCount);
  imm noTan = List[Vec3].empty();
  mut t = 0usize;
  while t < face.targets.count() {
    mt.addSparse(&face.targets.indicesOf(t), &face.targets.positionsOf(t), &face.targets.normalsOf(t), &noTan);
    t = t + 1usize;
  }
  mt;
}
