// ======== Wavefront .obj ========

// A mesh as .obj text: a 'v' line per position, a 'vt' per uv and a 'vn' per
// normal when it has them, then an 'f' line per triangle naming each corner's
// position, uv and normal, 'f 1/1/1 2/2/2 3/3/3' (numbered from 1; 'f 1//1'
// without uvs, 'f 1/1' without normals, 'f 1' with neither). A mesh with
// material groups gets a 'usemtl material<slot>' line before each group's
// triangles. Numbers are written with six decimal places.
pub fn meshObjText overload objText(m: &Mesh) String {
  var s = String.empty();
  let n = m.positions.len();
  let hasUv = n > 0usize && m.uvs.len() == n;
  let hasNormal = n > 0usize && m.normals.len() == n;
  var i = 0usize;
  while i < n {
    let p = *m.positions[i];
    s.append("v ");
    appendVec3(&mut s, p);
    s.appendByte('\n');
    i = i + 1usize;
  }
  if hasUv {
    i = 0usize;
    while i < n {
      let t = *m.uvs[i];
      s.append("vt ");
      appendFixed(&mut s, t.x);
      s.appendByte(' ');
      appendFixed(&mut s, t.y);
      s.appendByte('\n');
      i = i + 1usize;
    }
  }
  if hasNormal {
    i = 0usize;
    while i < n {
      s.append("vn ");
      appendVec3(&mut s, *m.normals[i]);
      s.appendByte('\n');
      i = i + 1usize;
    }
  }
  if m.groups.len() == 0usize {
    objFaces(&mut s, m, 0usize, m.indices.len(), hasUv, hasNormal);
  } else {
    var g = 0usize;
    while g < m.groups.len() {
      let grp = *m.groups[g];
      s.append("usemtl material");
      s.appendUInt(u64.from(grp.material));
      s.appendByte('\n');
      objFaces(&mut s, m, usize.from(grp.start), usize.from(grp.start) + usize.from(grp.count), hasUv, hasNormal);
      g = g + 1usize;
    }
  }
  s
}

// The 'f' lines for the triangles among indices 'from' to 'to'
fn objFaces(s: &mut String, m: &Mesh, from: usize, to: usize, hasUv: bool, hasNormal: bool) {
  var t = from;
  while t + 3usize <= to && t + 3usize <= m.indices.len() {
    s.append("f");
    var k = 0usize;
    while k < 3usize {
      let idx = u64.from(*m.indices[t + k]) + 1u64;
      s.appendByte(' ');
      s.appendUInt(idx);
      if hasUv || hasNormal {
        s.appendByte('/');
        if hasUv { s.appendUInt(idx); }
        if hasNormal {
          s.appendByte('/');
          s.appendUInt(idx);
        }
      }
      k = k + 1usize;
    }
    s.appendByte('\n');
    t = t + 3usize;
  }
}

// A polygon mesh as .obj text: a 'v' line per vertex, then an 'f' line per
// face with all its corners, 'f 1 3 4 2'. With a corner "uv" channel, a 'vt'
// line per corner of each face, in face order, and 'f 1/1 3/2 4/3 2/4'.
pub fn polyObjText overload objText(m: &PolyMesh) String {
  var s = String.empty();
  var i = 0usize;
  while i < m.positions.len() {
    s.append("v ");
    appendVec3(&mut s, *m.positions[i]);
    s.appendByte('\n');
    i = i + 1usize;
  }
  let uvCh = m.findVec2Channel(CornerDomain, "uv");
  let hasUv = uvCh != NoIndex;
  if hasUv {
    var f = 0usize;
    while f < m.fHalfedge.len() {
      let hs = m.faceHalfedges(u32.from(f));
      var k = 0usize;
      while k < hs.len() {
        let t = m.vec2(uvCh, *hs[k]);
        s.append("vt ");
        appendFixed(&mut s, t.x);
        s.appendByte(' ');
        appendFixed(&mut s, t.y);
        s.appendByte('\n');
        k = k + 1usize;
      }
      f = f + 1usize;
    }
  }
  var corner = 0u64;
  var f = 0usize;
  while f < m.fHalfedge.len() {
    let vs = m.faceVertices(u32.from(f));
    s.append("f");
    var k = 0usize;
    while k < vs.len() {
      s.appendByte(' ');
      s.appendUInt(u64.from(*vs[k]) + 1u64);
      if hasUv {
        corner = corner + 1u64;
        s.appendByte('/');
        s.appendUInt(corner);
      }
      k = k + 1usize;
    }
    s.appendByte('\n');
    f = f + 1usize;
  }
  s
}

// Write a mesh's .obj text to the file at 'path', replacing it; false if the
// file could not be written
pub fn meshWriteObj overload writeObj(m: &Mesh, path: &Path) bool {
  let text = objText(m);
  writeFile(path, text.view())
}
pub fn polyWriteObj overload writeObj(m: &PolyMesh, path: &Path) bool {
  let text = objText(m);
  writeFile(path, text.view())
}

// ---- reading ----

// A polygon mesh from .obj text: every 'v' line a vertex (x y z; a fourth
// number or colours after it are ignored), every 'f' line a face of its
// corners' position numbers (from 1; a negative number counts back from the
// last vertex read; anything after a '/' in a corner, its uv and normal, is
// ignored). Other lines ('vt', 'vn', 'g', 'o', 'usemtl', 's', comments) are
// skipped. The faces are built by 'PolyMesh.fromPolygons', which reports a
// face it refuses in 'problems'; a corner naming no vertex refuses its face
// here, reported the same way. It keeps no uvs or groups.
pub fn polyFromObjText(text: &Array[u8], problems: &mut List[String]) PolyMesh {
  var pos = List[Vec3].empty();
  var counts = List[u32].empty();
  var idx = List[u32].empty();
  var corners = List[u32].empty();
  var at = 0usize;
  var line = 1u64;
  while at < text.len {
    var e = at;
    while e < text.len && text[e] != 10u8 { e = e + 1usize; }
    let s = skipBlanks(text, at, e);
    if s + 1usize < e && text[s] == 118u8 && isBlank(text[s + 1usize]) {
      var p = s + 1usize;
      var xyz = Array[f64, 3]() <- fill 0.0;
      var k = 0usize;
      var ok = true;
      while k < 3usize {
        p = skipBlanks(text, p, e);
        let q = tokenEnd(text, p, e);
        if q == p { ok = false; }
        xyz[k] = parseObjNumber(text, p, q);
        p = q;
        k = k + 1usize;
      }
      if !ok { problems.push(objProblem(line, "a 'v' line with fewer than three numbers")); }
      pos.push(Vec3(f32.from(xyz[0usize]), f32.from(xyz[1usize]), f32.from(xyz[2usize])));
    } else if s + 1usize < e && text[s] == 102u8 && isBlank(text[s + 1usize]) {
      corners.clear();
      var p = s + 1usize;
      var bad = false;
      while p < e {
        p = skipBlanks(text, p, e);
        if p >= e { break; }
        let q = tokenEnd(text, p, e);
        var slash = p;
        while slash < q && text[slash] != 47u8 { slash = slash + 1usize; }
        let n = parseObjNumber(text, p, slash);
        var v = 0.0;
        if n < 0.0 { v = f64.from(pos.len()) + n; } else { v = n - 1.0; }
        if v < 0.0 || v >= f64.from(pos.len()) { bad = true; } else { corners.push(u32.from(v)); }
        p = q;
      }
      if bad || corners.len() < 3usize {
        problems.push(objProblem(line, "a face naming a vertex not yet read, or with fewer than three corners"));
      } else {
        counts.push(u32.from(corners.len()));
        var k = 0usize;
        while k < corners.len() { idx.push(*corners[k]); k = k + 1usize; }
      }
    }
    at = e + 1usize;
    line = line + 1u64;
  }
  PolyMesh.fromPolygons(pos.view(), counts.view(), idx.view(), problems)
}

// The .obj file at 'path' as a polygon mesh (see 'polyFromObjText'); a file that
// cannot be read gives an empty mesh and says so in 'problems'
pub fn readPolyObj(path: &Path, problems: &mut List[String]) PolyMesh {
  var cpath = String.from(path.view());
  let f = libc.fopen(cpath.cstr(), "rb");
  if !f {
    var msg = String.from("cannot open ");
    msg.append(path.view());
    problems.push(msg);
    return PolyMesh.empty();
  }
  var text = String.empty();
  var buf = Array[u8, 65536]() <- fill 0u8;
  var n = libc.fread(&mut buf[0], 1usize, 65536usize, f);
  while n > 0usize {
    text.appendBytes(&buf[..<n]);
    n = libc.fread(&mut buf[0], 1usize, 65536usize, f);
  }
  libc.fclose(f);
  polyFromObjText(text.view(), problems)
}

fn objProblem(line: u64, what: &str) String {
  var s = String.from("line ");
  s.appendUInt(line);
  s.append(": ");
  s.append(what);
  s
}

fn isBlank(c: u8) bool { c == 32u8 || c == 9u8 || c == 13u8 }

fn skipBlanks(d: &Array[u8], from: usize, to: usize) usize {
  var i = from;
  while i < to && isBlank(d[i]) { i = i + 1usize; }
  i
}

fn tokenEnd(d: &Array[u8], from: usize, to: usize) usize {
  var i = from;
  while i < to && !isBlank(d[i]) { i = i + 1usize; }
  i
}

// A decimal number, with an optional sign, fraction and exponent, from d[lo, hi);
// what is not a number reads as 0
fn parseObjNumber(d: &Array[u8], lo: usize, hi: usize) f64 {
  var i = lo;
  var neg = false;
  if i < hi && (d[i] == 45u8 || d[i] == 43u8) { neg = d[i] == 45u8; i = i + 1usize; }
  var v = 0.0;
  while i < hi && d[i] >= 48u8 && d[i] <= 57u8 { v = v * 10.0 + f64.from(d[i] - 48u8); i = i + 1usize; }
  if i < hi && d[i] == 46u8 {
    i = i + 1usize;
    var scale = 0.1;
    while i < hi && d[i] >= 48u8 && d[i] <= 57u8 { v = v + scale * f64.from(d[i] - 48u8); scale = scale * 0.1; i = i + 1usize; }
  }
  if i < hi && (d[i] == 101u8 || d[i] == 69u8) {
    i = i + 1usize;
    var eneg = false;
    if i < hi && (d[i] == 45u8 || d[i] == 43u8) { eneg = d[i] == 45u8; i = i + 1usize; }
    var e = 0.0;
    while i < hi && d[i] >= 48u8 && d[i] <= 57u8 { e = e * 10.0 + f64.from(d[i] - 48u8); i = i + 1usize; }
    v = v * libc.pow(10.0, if eneg { 0.0 - e } else { e });
  }
  if neg { 0.0 - v } else { v }
}

// The whole of 'text' into the file at 'path'
fn writeFile(path: &Path, text: &Array[u8]) bool {
  var cpath = String.from(path.view());
  let f = libc.fopen(cpath.cstr(), "wb");
  if !f { return false; }
  var wrote = 0usize;
  if text.len > 0usize { wrote = libc.fwrite(&text[0], 1usize, text.len, f); }
  let closed = libc.fclose(f);
  wrote == text.len && closed == 0
}

// "x y z", each with six decimal places
fn appendVec3(s: &mut String, p: Vec3) {
  appendFixed(s, p.x);
  s.appendByte(' ');
  appendFixed(s, p.y);
  s.appendByte(' ');
  appendFixed(s, p.z);
}

// A number with six decimal places, rounded, as C's '%f' writes it: '0.100000',
// '-2.500000'; a value that rounds to zero has no sign. NaN and infinity are
// written 'nan', 'inf' and '-inf', which no .obj reader accepts.
fn appendFixed(s: &mut String, value: f32) {
  let v = f64.from(value);
  if v != v { s.append("nan"); return; }
  let mag = if v < 0.0 {-v} else {v};
  if mag - mag != 0.0 {
    if v < 0.0 { s.append("-inf"); } else { s.append("inf"); }
    return;
  }
  if mag < 9000000000000.0 {
    let n = u64.from(mag * 1000000.0 + 0.5);
    if v < 0.0 && n > 0u64 { s.appendByte('-'); }
    s.appendUInt(n / 1000000u64);
    s.appendByte('.');
    let frac = n % 1000000u64;
    var pad = 100000u64;
    while pad > 1u64 && frac < pad {
      s.appendByte('0');
      pad = pad / 10u64;
    }
    s.appendUInt(frac);
  } else {
    // Past what a u64 of millionths holds: the leading digits, then zeros
    // (an f32 has no more than 8 significant digits)
    var m = mag;
    var zeros = 0usize;
    while m >= 9000000000000.0 {
      m = m / 10.0;
      zeros = zeros + 1usize;
    }
    if v < 0.0 { s.appendByte('-'); }
    s.appendUInt(u64.from(m));
    while zeros > 0usize {
      s.appendByte('0');
      zeros = zeros - 1usize;
    }
    s.append(".000000");
  }
}
