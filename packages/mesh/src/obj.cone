// ======== Wavefront .obj ========

// A mesh as .obj text: a 'v' line per position, a 'vt' per uv and a 'vn' per
// normal when it has them, then an 'f' line per triangle naming each corner's
// position, uv and normal, 'f 1/1/1 2/2/2 3/3/3' (numbered from 1; 'f 1//1'
// without uvs, 'f 1/1' without normals, 'f 1' with neither). A mesh with
// material groups gets a 'usemtl material<slot>' line before each group's
// triangles. Numbers are written with six decimal places.
pub fn meshObjText overload objText(m &Mesh) String {
  mut s = String.empty();
  imm n = m.positions.len();
  imm hasUv = n > 0usize and m.uvs.len() == n;
  imm hasNormal = n > 0usize and m.normals.len() == n;
  mut i = 0usize;
  while i < n {
    imm p = *m.positions[i];
    s.append("v ");
    appendVec3(&mut s, p);
    s.appendByte('\n');
    i = i + 1usize;
  }
  if hasUv {
    i = 0usize;
    while i < n {
      imm t = *m.uvs[i];
      s.append("vt ");
      appendFixed(&mut s, t.x);
      s.appendByte(' ');
      appendFixed(&mut s, t.y);
      s.appendByte('\n');
      i = i + 1usize;
    }
  }
  if hasNormal {
    i = 0usize;
    while i < n {
      s.append("vn ");
      appendVec3(&mut s, *m.normals[i]);
      s.appendByte('\n');
      i = i + 1usize;
    }
  }
  if m.groups.len() == 0usize {
    objFaces(&mut s, m, 0usize, m.indices.len(), hasUv, hasNormal);
  } else {
    mut g = 0usize;
    while g < m.groups.len() {
      imm grp = *m.groups[g];
      s.append("usemtl material");
      s.appendUInt(u64.from(grp.material));
      s.appendByte('\n');
      objFaces(&mut s, m, usize.from(grp.start), usize.from(grp.start) + usize.from(grp.count), hasUv, hasNormal);
      g = g + 1usize;
    }
  }
  s;
}

// The 'f' lines for the triangles among indices 'from' to 'to'
fn objFaces(s &mut String, m &Mesh, from usize, to usize, hasUv bool, hasNormal bool) {
  mut t = from;
  while t + 3usize <= to and t + 3usize <= m.indices.len() {
    s.append("f");
    mut k = 0usize;
    while k < 3usize {
      imm idx = u64.from(*m.indices[t + k]) + 1u64;
      s.appendByte(' ');
      s.appendUInt(idx);
      if hasUv or hasNormal {
        s.appendByte('/');
        if hasUv { s.appendUInt(idx); }
        if hasNormal {
          s.appendByte('/');
          s.appendUInt(idx);
        }
      }
      k = k + 1usize;
    }
    s.appendByte('\n');
    t = t + 3usize;
  }
}

// A polygon mesh as .obj text: a 'v' line per vertex, then an 'f' line per
// face with all its corners, 'f 1 3 4 2'. With a corner "uv" channel, a 'vt'
// line per corner of each face, in face order, and 'f 1/1 3/2 4/3 2/4'.
pub fn polyObjText overload objText(m &PolyMesh) String {
  mut s = String.empty();
  mut i = 0usize;
  while i < m.positions.len() {
    s.append("v ");
    appendVec3(&mut s, *m.positions[i]);
    s.appendByte('\n');
    i = i + 1usize;
  }
  imm uvCh = m.findVec2Channel(CornerDomain, "uv");
  imm hasUv = uvCh != NoIndex;
  if hasUv {
    mut f = 0usize;
    while f < m.fHalfedge.len() {
      imm hs = m.faceHalfedges(u32.from(f));
      mut k = 0usize;
      while k < hs.len() {
        imm t = m.vec2(uvCh, *hs[k]);
        s.append("vt ");
        appendFixed(&mut s, t.x);
        s.appendByte(' ');
        appendFixed(&mut s, t.y);
        s.appendByte('\n');
        k = k + 1usize;
      }
      f = f + 1usize;
    }
  }
  mut corner = 0u64;
  mut f = 0usize;
  while f < m.fHalfedge.len() {
    imm vs = m.faceVertices(u32.from(f));
    s.append("f");
    mut k = 0usize;
    while k < vs.len() {
      s.appendByte(' ');
      s.appendUInt(u64.from(*vs[k]) + 1u64);
      if hasUv {
        corner = corner + 1u64;
        s.appendByte('/');
        s.appendUInt(corner);
      }
      k = k + 1usize;
    }
    s.appendByte('\n');
    f = f + 1usize;
  }
  s;
}

// Write a mesh's .obj text to the file at 'path', replacing it; false if the
// file could not be written
pub fn meshWriteObj overload writeObj(m &Mesh, path &Path) bool {
  imm text = objText(m);
  writeFile(path, text.view());
}
pub fn polyWriteObj overload writeObj(m &PolyMesh, path &Path) bool {
  imm text = objText(m);
  writeFile(path, text.view());
}

// ---- reading ----

// A polygon mesh from .obj text: every 'v' line a vertex (x y z; a fourth
// number or colours after it are ignored), every 'f' line a face of its
// corners' position numbers (from 1; a negative number counts back from the
// last vertex read; anything after a '/' in a corner, its uv and normal, is
// ignored). Other lines ('vt', 'vn', 'g', 'o', 'usemtl', 's', comments) are
// skipped. The faces are built by 'PolyMesh.fromPolygons', which reports a
// face it refuses in 'problems'; a corner naming no vertex refuses its face
// here, reported the same way. It keeps no uvs or groups.
pub fn polyFromObjText(text &Array[u8], problems &mut List[String]) PolyMesh {
  mut pos = List[Vec3].empty();
  mut counts = List[u32].empty();
  mut idx = List[u32].empty();
  mut corners = List[u32].empty();
  mut at = 0usize;
  mut line = 1u64;
  while at < text.len {
    mut e = at;
    while e < text.len and text[e] != 10u8 { e = e + 1usize; }
    imm s = skipBlanks(text, at, e);
    if s + 1usize < e and text[s] == 118u8 and isBlank(text[s + 1usize]) {
      mut p = s + 1usize;
      mut xyz = new Array[f64, 3] <- fill 0d;
      mut k = 0usize;
      mut ok = true;
      while k < 3usize {
        p = skipBlanks(text, p, e);
        imm q = tokenEnd(text, p, e);
        if q == p { ok = false; }
        xyz[k] = parseObjNumber(text, p, q);
        p = q;
        k = k + 1usize;
      }
      if not ok { problems.push(objProblem(line, "a 'v' line with fewer than three numbers")); }
      pos.push(new Vec3(f32.from(xyz[0usize]), f32.from(xyz[1usize]), f32.from(xyz[2usize])));
    } elif s + 1usize < e and text[s] == 102u8 and isBlank(text[s + 1usize]) {
      corners.clear();
      mut p = s + 1usize;
      mut bad = false;
      while p < e {
        p = skipBlanks(text, p, e);
        if p >= e { break; }
        imm q = tokenEnd(text, p, e);
        mut slash = p;
        while slash < q and text[slash] != 47u8 { slash = slash + 1usize; }
        imm n = parseObjNumber(text, p, slash);
        mut v = 0d;
        if n < 0d { v = f64.from(pos.len()) + n; } else { v = n - 1d; }
        if v < 0d or v >= f64.from(pos.len()) { bad = true; } else { corners.push(u32.from(v)); }
        p = q;
      }
      if bad or corners.len() < 3usize {
        problems.push(objProblem(line, "a face naming a vertex not yet read, or with fewer than three corners"));
      } else {
        counts.push(u32.from(corners.len()));
        mut k = 0usize;
        while k < corners.len() { idx.push(*corners[k]); k = k + 1usize; }
      }
    }
    at = e + 1usize;
    line = line + 1u64;
  }
  PolyMesh.fromPolygons(pos.view(), counts.view(), idx.view(), problems);
}

// The .obj file at 'path' as a polygon mesh (see 'polyFromObjText'); a file that
// cannot be read gives an empty mesh and says so in 'problems'
pub fn readPolyObj(path &Path, problems &mut List[String]) PolyMesh {
  mut cpath = String.from(path.view());
  imm f = libc.fopen(cpath.cstr(), "rb");
  if !f {
    mut msg = String.from("cannot open ");
    msg.append(path.view());
    problems.push(msg);
    return PolyMesh.empty();
  }
  mut text = String.empty();
  mut buf = new Array[u8, 65536] <- fill 0u8;
  mut n = libc.fread(&mut buf[0], 1usize, 65536usize, f);
  while n > 0usize {
    text.appendBytes(&buf[..<n]);
    n = libc.fread(&mut buf[0], 1usize, 65536usize, f);
  }
  libc.fclose(f);
  polyFromObjText(text.view(), problems);
}

fn objProblem(line u64, what &str) String {
  mut s = String.from("line ");
  s.appendUInt(line);
  s.append(": ");
  s.append(what);
  s;
}

fn isBlank(c u8) bool { c == 32u8 or c == 9u8 or c == 13u8; }

fn skipBlanks(d &Array[u8], from usize, to usize) usize {
  mut i = from;
  while i < to and isBlank(d[i]) { i = i + 1usize; }
  i;
}

fn tokenEnd(d &Array[u8], from usize, to usize) usize {
  mut i = from;
  while i < to and not isBlank(d[i]) { i = i + 1usize; }
  i;
}

// A decimal number, with an optional sign, fraction and exponent, from d[lo, hi);
// what is not a number reads as 0
fn parseObjNumber(d &Array[u8], lo usize, hi usize) f64 {
  mut i = lo;
  mut neg = false;
  if i < hi and (d[i] == 45u8 or d[i] == 43u8) { neg = d[i] == 45u8; i = i + 1usize; }
  mut v = 0d;
  while i < hi and d[i] >= 48u8 and d[i] <= 57u8 { v = v * 10d + f64.from(d[i] - 48u8); i = i + 1usize; }
  if i < hi and d[i] == 46u8 {
    i = i + 1usize;
    mut scale = 0.1d;
    while i < hi and d[i] >= 48u8 and d[i] <= 57u8 { v = v + scale * f64.from(d[i] - 48u8); scale = scale * 0.1d; i = i + 1usize; }
  }
  if i < hi and (d[i] == 101u8 or d[i] == 69u8) {
    i = i + 1usize;
    mut eneg = false;
    if i < hi and (d[i] == 45u8 or d[i] == 43u8) { eneg = d[i] == 45u8; i = i + 1usize; }
    mut e = 0d;
    while i < hi and d[i] >= 48u8 and d[i] <= 57u8 { e = e * 10d + f64.from(d[i] - 48u8); i = i + 1usize; }
    v = v * libc.pow(10d, if eneg { 0d - e; } else { e; });
  }
  if neg { 0d - v; } else { v; };
}

// The whole of 'text' into the file at 'path'
fn writeFile(path &Path, text &Array[u8]) bool {
  mut cpath = String.from(path.view());
  imm f = libc.fopen(cpath.cstr(), "wb");
  if !f { return false; }
  mut wrote = 0usize;
  if text.len > 0usize { wrote = libc.fwrite(&text[0], 1usize, text.len, f); }
  imm closed = libc.fclose(f);
  wrote == text.len and closed == 0;
}

// "x y z", each with six decimal places
fn appendVec3(s &mut String, p Vec3) {
  appendFixed(s, p.x);
  s.appendByte(' ');
  appendFixed(s, p.y);
  s.appendByte(' ');
  appendFixed(s, p.z);
}

// A number with six decimal places, rounded, as C's '%f' writes it: '0.100000',
// '-2.500000'; a value that rounds to zero has no sign. NaN and infinity are
// written 'nan', 'inf' and '-inf', which no .obj reader accepts.
fn appendFixed(s &mut String, value f32) {
  imm v = f64.from(value);
  if v != v { s.append("nan"); return; }
  imm mag = if v < 0d {-v;} else {v;};
  if mag - mag != 0d {
    if v < 0d { s.append("-inf"); } else { s.append("inf"); }
    return;
  }
  if mag < 9000000000000d {
    imm n = u64.from(mag * 1000000d + 0.5d);
    if v < 0d and n > 0u64 { s.appendByte('-'); }
    s.appendUInt(n / 1000000u64);
    s.appendByte('.');
    imm frac = n % 1000000u64;
    mut pad = 100000u64;
    while pad > 1u64 and frac < pad {
      s.appendByte('0');
      pad = pad / 10u64;
    }
    s.appendUInt(frac);
  } else {
    // Past what a u64 of millionths holds: the leading digits, then zeros
    // (an f32 has no more than 8 significant digits)
    mut m = mag;
    mut zeros = 0usize;
    while m >= 9000000000000d {
      m = m / 10d;
      zeros = zeros + 1usize;
    }
    if v < 0d { s.appendByte('-'); }
    s.appendUInt(u64.from(m));
    while zeros > 0usize {
      s.appendByte('0');
      zeros = zeros - 1usize;
    }
    s.append(".000000");
  }
}
