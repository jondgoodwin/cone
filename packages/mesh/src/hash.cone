// ======== A mesh's bits hashed ========
//
// For pinning a mesh made by a deterministic process (sdfmesh's surface
// nets, sculpt's operators) and comparing it across runs, builds and
// machines.

// A hash of a mesh's bits, for pinning a mesh and comparing it across runs,
// builds and machines: its vertex and index counts, then every position's
// and normal's coordinates as their f32 bits, then every index, each word
// folded in by noise's PCG hash, h = pcg(h ^ word), in that order. Two
// meshes with the same hash have, almost surely, the same bits
pub fn meshHash(m &Mesh) u32 {
  mut h = noise.pcg(u32.from(m.positions.len()));
  h = noise.pcg(h ^ u32.from(m.indices.len()));
  mut i = 0usize;
  while i < m.positions.len() {
    imm p = *m.positions[i];
    h = noise.pcg(h ^ (p.x as u32));
    h = noise.pcg(h ^ (p.y as u32));
    h = noise.pcg(h ^ (p.z as u32));
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.normals.len() {
    imm n = *m.normals[i];
    h = noise.pcg(h ^ (n.x as u32));
    h = noise.pcg(h ^ (n.y as u32));
    h = noise.pcg(h ^ (n.z as u32));
    i = i + 1usize;
  }
  i = 0usize;
  while i < m.indices.len() {
    h = noise.pcg(h ^ *m.indices[i]);
    i = i + 1usize;
  }
  h;
}
