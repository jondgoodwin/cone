// ======== PolyMesh: the editable half-edge mesh ========

// A named list of values of one type, one per element of a domain, and its
// fill: the value an element is given when it has none of its own, set when
// the channel is made (0 by default; 1 for a weight, so a missing weight
// still means full effect; white for paint). It has that one meaning: the
// elements present when the channel is made get it, and joining meshes gives
// it to the elements of a mesh that lacked the channel, so each part behaves
// as it did alone. It is not a way to start every element at some value: to
// do that, make the channel at the fill and set the values. Operators that
// make new elements (a new side, a new edge inside a face) give them their
// own values, 0 or derived, as each says.
pub struct Channel[T] {
  pub name: String;
  pub domain: u32;
  pub values: List[T];
  pub fill: T;
}

// A mesh of polygons of any size, with the half-edge links between them (the
// conventions are at the top of mesh.cone). Every list is public, for
// reading; change it through the methods, or 'validate' after changing it
// directly.
pub struct PolyMesh {
  pub positions: List[Vec3];     // per vertex
  pub vHalfedge: List[u32];      // per vertex: a half-edge leaving it
  pub hNext: List[u32];          // per half-edge: the next around its face or hole
  pub hPrev: List[u32];          // per half-edge: the previous
  pub hVertex: List[u32];        // per half-edge: the vertex it points to
  pub hFace: List[u32];          // per half-edge: its face, NoIndex on the boundary
  pub fHalfedge: List[u32];      // per face: the half-edge ending at its first vertex
  pub floats: List[Channel[f32]];
  pub vec2s: List[Channel[Vec2]];
  pub vec3s: List[Channel[Vec3]];

  // A mesh with nothing in it
  pub fn empty() PolyMesh {
    PolyMesh(List[Vec3].empty(), List[u32].empty(), List[u32].empty(), List[u32].empty(),
      List[u32].empty(), List[u32].empty(), List[u32].empty(),
      List[Channel[f32]].empty(), List[Channel[Vec2]].empty(), List[Channel[Vec3]].empty())
  }

  // A copy: the same positions, links and channels, sharing nothing with this one
  pub fn copy(self: &) PolyMesh {
    PolyMesh(listCopy[Vec3](&positions), listCopy[u32](&vHalfedge), listCopy[u32](&hNext), listCopy[u32](&hPrev),
      listCopy[u32](&hVertex), listCopy[u32](&hFace), listCopy[u32](&fHalfedge),
      channelsCopy[f32](&floats), channelsCopy[Vec2](&vec2s), channelsCopy[Vec3](&vec3s))
  }

  // Build from polygons: the positions, and each face as its vertices' numbers
  // in order, counterclockwise seen from the side it faces. The faces are
  // given flat, as USD, Alembic and OpenSubdiv give them: 'counts' holds each
  // face's number of corners, and 'indices' all the faces' vertex numbers one
  // after another. A face that cannot be added is left out, with a line saying
  // why added to 'problems': fewer than 3 corners, a vertex that does not
  // exist or appears twice in it, or an edge another face already runs along
  // the same way (a third face on an edge, or two faces facing opposite
  // ways). Faces meeting at only a vertex are added; 'validate' reports that
  // vertex as not manifold.
  pub fn fromPolygons(positions: &Array[Vec3], counts: &Array[u32], indices: &Array[u32], problems: &mut List[String]) PolyMesh {
    var m = PolyMesh.empty();
    let nv = positions.len;
    var outHead = List[u32].withCapacity(nv);    // per vertex: the last half-edge made leaving it
    var outNext = List[u32].empty();             // per half-edge: the one made before it leaving its vertex
    var v = 0usize;
    while v < nv {
      m.positions.push(positions[v]);
      m.vHalfedge.push(NoIndex);
      outHead.push(NoIndex);
      v = v + 1usize;
    }
    var need = 0usize;
    var f = 0usize;
    while f < counts.len {
      need = need + usize.from(counts[f]);
      f = f + 1usize;
    }
    if need != indices.len {
      var s = String.from("the faces' sizes add up to ");
      s.appendUInt(u64.from(need));
      s.append(" corners, but ");
      s.appendUInt(u64.from(indices.len));
      s.append(" vertex numbers were given");
      problems.push(s);
      return m;
    }

    var hs = List[u32].empty();
    var start = 0usize;
    f = 0usize;
    while f < counts.len {
      let n = usize.from(counts[f]);
      if m.faceFits(f, &indices[start..<start + n], nv, &outHead, &outNext, problems) {
        // Each corner's half-edge from it to the next corner, made with its
        // twin when the edge is new
        hs.clear();
        var i = 0usize;
        while i < n {
          let a = indices[start + i];
          let b = indices[start + (i + 1usize) % n];
          var h = findHalfedge(&m.hVertex, &outHead, &outNext, a, b);
          if h == NoIndex {
            h = u32.from(m.hVertex.len());
            m.hVertex.push(b);
            m.hVertex.push(a);
            m.hFace.push(NoIndex);
            m.hFace.push(NoIndex);
            m.hNext.push(NoIndex);
            m.hNext.push(NoIndex);
            m.hPrev.push(NoIndex);
            m.hPrev.push(NoIndex);
            outNext.push(*outHead[usize.from(a)]);
            outNext.push(*outHead[usize.from(b)]);
            outHead.set(usize.from(a), h);
            outHead.set(usize.from(b), h + 1u32);
          }
          hs.push(h);
          i = i + 1usize;
        }
        let face = u32.from(m.fHalfedge.len());
        i = 0usize;
        while i < n {
          let h = *hs[i];
          let hn = *hs[(i + 1usize) % n];
          m.hFace.set(usize.from(h), face);
          m.hNext.set(usize.from(h), hn);
          m.hPrev.set(usize.from(hn), h);
          i = i + 1usize;
        }
        // The half-edge ending at the first vertex: the last corner's
        m.fHalfedge.push(*hs[n - 1usize]);
      }
      start = start + n;
      f = f + 1usize;
    }
    m.linkBoundary();
    m
  }

  // Whether a face, the vertices 'vs', can be added to the mesh being built;
  // if not, a line saying why goes to 'problems'
  fn faceFits(self: &, f: usize, vs: &Array[u32], nv: usize, outHead: &List[u32], outNext: &List[u32],
      problems: &mut List[String]) bool {
    let n = vs.len;
    if n < 3usize {
      problems.push(faceProblem(f, "has fewer than 3 corners"));
      return false;
    }
    var i = 0usize;
    while i < n {
      if usize.from(vs[i]) >= nv {
        var s = faceProblem(f, "names vertex ");
        s.appendUInt(u64.from(vs[i]));
        s.append(", which does not exist");
        problems.push(s);
        return false;
      }
      var j = i + 1usize;
      while j < n {
        if vs[i] == vs[j] {
          var s = faceProblem(f, "has vertex ");
          s.appendUInt(u64.from(vs[i]));
          s.append(" twice");
          problems.push(s);
          return false;
        }
        j = j + 1usize;
      }
      i = i + 1usize;
    }
    i = 0usize;
    while i < n {
      let a = vs[i];
      let b = vs[(i + 1usize) % n];
      let h = findHalfedge(&hVertex, outHead, outNext, a, b);
      if h != NoIndex && *hFace[usize.from(h)] != NoIndex {
        var s = faceProblem(f, "runs from vertex ");
        s.appendUInt(u64.from(a));
        s.append(" to ");
        s.appendUInt(u64.from(b));
        s.append(", as another face already does");
        problems.push(s);
        return false;
      }
      i = i + 1usize;
    }
    true
  }

  // Link the boundary half-edges into loops, and give each vertex its
  // half-edge. A boundary half-edge ending at v is followed by the boundary
  // half-edge leaving v that is reached by turning about v through faces from
  // its twin, so each fan of faces about a vertex closes on itself.
  fn linkBoundary(self: &mut) {
    let nh = hVertex.len();
    var h = 0usize;
    while h < nh {
      if *hFace[h] == NoIndex {
        var g = twinOf(u32.from(h));
        var steps = 0usize;
        var going = true;
        while going && steps < nh {
          let t = twinOf(*hPrev[usize.from(g)]);
          if *hFace[usize.from(t)] == NoIndex {
            hNext.set(h, t);
            hPrev.set(usize.from(t), u32.from(h));
            going = false;
          } else {
            g = t;
          }
          steps = steps + 1usize;
        }
      }
      h = h + 1usize;
    }
    // Each vertex: the first half-edge leaving it, or a boundary one if any
    h = 0usize;
    while h < nh {
      let from = usize.from(*hVertex[usize.from(twinOf(u32.from(h)))]);
      let cur = *vHalfedge[from];
      if cur == NoIndex || (*hFace[h] == NoIndex && *hFace[usize.from(cur)] != NoIndex) {
        vHalfedge.set(from, u32.from(h));
      }
      h = h + 1usize;
    }
  }

  // -------- counts --------

  pub fn vertexCount(self: &) usize {positions.len()}
  pub fn halfedgeCount(self: &) usize {hVertex.len()}
  pub fn edgeCount(self: &) usize {hVertex.len() / 2usize}
  pub fn faceCount(self: &) usize {fHalfedge.len()}

  // -------- stepping between elements --------

  pub fn next(self: &, h: u32) u32 {*hNext[usize.from(h)]}
  pub fn prev(self: &, h: u32) u32 {*hPrev[usize.from(h)]}
  pub fn twin(self: &, h: u32) u32 {twinOf(h)}
  pub fn toVertex(self: &, h: u32) u32 {*hVertex[usize.from(h)]}
  pub fn fromVertex(self: &, h: u32) u32 {*hVertex[usize.from(twinOf(h))]}
  pub fn face(self: &, h: u32) u32 {*hFace[usize.from(h)]}
  pub fn edge(self: &, h: u32) u32 {h / 2u32}
  // Half-edge 0 or 1 of edge e
  pub fn edgeHalfedge(self: &, e: u32, side: u32) u32 {2u32 * e + side}
  pub fn faceHalfedge(self: &, f: u32) u32 {*fHalfedge[usize.from(f)]}
  pub fn vertexHalfedge(self: &, v: u32) u32 {*vHalfedge[usize.from(v)]}

  pub fn isBoundaryHalfedge(self: &, h: u32) bool {*hFace[usize.from(h)] == NoIndex}
  pub fn isBoundaryEdge(self: &, e: u32) bool {
    *hFace[usize.from(2u32 * e)] == NoIndex || *hFace[usize.from(2u32 * e + 1u32)] == NoIndex
  }
  // On the boundary: a vertex's half-edge is a boundary one when it can be
  pub fn isBoundaryVertex(self: &, v: u32) bool {
    let h = *vHalfedge[usize.from(v)];
    h != NoIndex && *hFace[usize.from(h)] == NoIndex
  }
  pub fn isIsolated(self: &, v: u32) bool {*vHalfedge[usize.from(v)] == NoIndex}

  // A face's half-edges in order, starting with the one ending at its first
  // vertex: its corners
  pub fn faceHalfedges(self: &, f: u32) List[u32] {
    var out = List[u32].empty();
    let h0 = *fHalfedge[usize.from(f)];
    var h = h0;
    var going = true;
    while going {
      out.push(h);
      h = *hNext[usize.from(h)];
      going = h != h0 && out.len() <= hNext.len();
    }
    out
  }

  // A face's vertices in order, from its first
  pub fn faceVertices(self: &, f: u32) List[u32] {
    let hs = self.faceHalfedges(f);
    var out = List[u32].withCapacity(hs.len());
    var i = 0usize;
    while i < hs.len() {
      out.push(*hVertex[usize.from(*hs[i])]);
      i = i + 1usize;
    }
    out
  }

  // How many corners a face has
  pub fn faceDegree(self: &, f: u32) usize {
    let hs = self.faceHalfedges(f);
    hs.len()
  }

  // The half-edges leaving a vertex, counterclockwise seen from outside,
  // starting with its own (a boundary one when it is on the boundary): its
  // one-ring. An isolated vertex has none.
  pub fn vertexOutgoing(self: &, v: u32) List[u32] {
    var out = List[u32].empty();
    let h0 = *vHalfedge[usize.from(v)];
    if h0 == NoIndex { return out; }
    var h = h0;
    var going = true;
    while going {
      out.push(h);
      h = twinOf(*hPrev[usize.from(h)]);
      going = h != h0 && out.len() <= hNext.len();
    }
    out
  }

  // The vertices joined to a vertex by an edge, in the order of its one-ring
  pub fn vertexNeighbors(self: &, v: u32) List[u32] {
    let hs = self.vertexOutgoing(v);
    var out = List[u32].withCapacity(hs.len());
    var i = 0usize;
    while i < hs.len() {
      out.push(*hVertex[usize.from(*hs[i])]);
      i = i + 1usize;
    }
    out
  }

  // How many edges a vertex is on
  pub fn valence(self: &, v: u32) usize {
    let hs = self.vertexOutgoing(v);
    hs.len()
  }

  // -------- geometry --------

  // A face's corner positions, in order
  pub fn facePositions(self: &, f: u32) List[Vec3] {
    let hs = self.faceHalfedges(f);
    var out = List[Vec3].withCapacity(hs.len());
    var i = 0usize;
    while i < hs.len() {
      out.push(*positions[usize.from(*hVertex[usize.from(*hs[i])])]);
      i = i + 1usize;
    }
    out
  }

  // A face's unit normal, by Newell's method: the best-fit plane's, so a
  // polygon that is not quite flat, or not convex, still gets the right one
  pub fn faceNormal(self: &, f: u32) Vec3 {
    let pts = self.facePositions(f);
    unitOrZero(newellNormal(&pts))
  }

  // The mean of a face's corners
  pub fn faceCentroid(self: &, f: u32) Vec3 {
    let pts = self.facePositions(f);
    var sum = Vec3(0., 0., 0.);
    var i = 0usize;
    while i < pts.len() {
      sum = sum + *pts[i];
      i = i + 1usize;
    }
    if pts.len() > 0usize { sum * (1. / f32.from(pts.len())) } else { sum }
  }

  // Every vertex's unit normal: its faces' normals, each weighted by the
  // face's angle at the vertex (the angle of the polygon, not of any triangle
  // cut from it). An isolated vertex gets (0, 0, 0).
  pub fn vertexNormals(self: &) List[Vec3] {
    let nv = positions.len();
    var acc = List[Vec3].withCapacity(nv);
    var v = 0usize;
    while v < nv {
      acc.push(Vec3(0., 0., 0.));
      v = v + 1usize;
    }
    var f = 0usize;
    while f < fHalfedge.len() {
      let fnormal = self.faceNormal(u32.from(f));
      let hs = self.faceHalfedges(u32.from(f));
      var i = 0usize;
      while i < hs.len() {
        let h = *hs[i];
        let c = usize.from(*hVertex[usize.from(h)]);
        let after = *positions[usize.from(*hVertex[usize.from(*hNext[usize.from(h)])])];
        let before = *positions[usize.from(self.fromVertex(h))];
        let w = cornerAngle(*positions[c], after, before);
        acc.set(c, *acc[c] + fnormal * w);
        i = i + 1usize;
      }
      f = f + 1usize;
    }
    var out = List[Vec3].withCapacity(nv);
    v = 0usize;
    while v < nv {
      out.push(unitOrZero(*acc[v]));
      v = v + 1usize;
    }
    out
  }

  // The smallest box holding every vertex
  pub fn bounds(self: &) Aabb3 {Aabb3.fromPoints(positions.view())}

  // -------- attribute channels --------

  // How many elements a domain has. A corner channel has a slot for every
  // half-edge, boundary ones included.
  pub fn domainSize(self: &, domain: u32) usize {
    if domain == VertexDomain { positions.len() }
    else if domain == EdgeDomain { hVertex.len() / 2usize }
    else if domain == FaceDomain { fHalfedge.len() }
    else { hVertex.len() }
  }

  // A channel of f32 values for a domain, found by name or else made with
  // every value 'fill', which it keeps as its fill; its number, for 'float'
  // and 'setFloat'. A channel found keeps the fill it was made with.
  // Channels are sized to the mesh as it is when they are made.
  pub fn addFloatChannel(self: &mut, domain: u32, name: &str, fill: f32) u32 {
    let found = self.findFloatChannel(domain, name);
    if found != NoIndex { return found; }
    let n = self.domainSize(domain);
    var values = List[f32].withCapacity(n);
    var i = 0usize;
    while i < n { values.push(fill); i = i + 1usize; }
    floats.push(Channel[f32](String.from(name), domain, values, fill));
    u32.from(floats.len() - 1usize)
  }
  pub fn findFloatChannel(self: &, domain: u32, name: &str) u32 {
    var i = 0usize;
    while i < floats.len() {
      if floats[i].domain == domain && floats[i].name.equals(name) { return u32.from(i); }
      i = i + 1usize;
    }
    NoIndex
  }
  pub fn float(self: &, channel: u32, element: u32) f32 {*floats[usize.from(channel)].values[usize.from(element)]}
  pub fn setFloat(self: &mut, channel: u32, element: u32, value: f32) {
    let c = &mut floats[usize.from(channel)];
    c.values.set(usize.from(element), value);
  }

  // The same for Vec2 values (uvs)
  pub fn addVec2Channel(self: &mut, domain: u32, name: &str, fill: Vec2) u32 {
    let found = self.findVec2Channel(domain, name);
    if found != NoIndex { return found; }
    let n = self.domainSize(domain);
    var values = List[Vec2].withCapacity(n);
    var i = 0usize;
    while i < n { values.push(fill); i = i + 1usize; }
    vec2s.push(Channel[Vec2](String.from(name), domain, values, fill));
    u32.from(vec2s.len() - 1usize)
  }
  pub fn findVec2Channel(self: &, domain: u32, name: &str) u32 {
    var i = 0usize;
    while i < vec2s.len() {
      if vec2s[i].domain == domain && vec2s[i].name.equals(name) { return u32.from(i); }
      i = i + 1usize;
    }
    NoIndex
  }
  pub fn vec2(self: &, channel: u32, element: u32) Vec2 {*vec2s[usize.from(channel)].values[usize.from(element)]}
  pub fn setVec2(self: &mut, channel: u32, element: u32, value: Vec2) {
    let c = &mut vec2s[usize.from(channel)];
    c.values.set(usize.from(element), value);
  }

  // The same for Vec3 values (colors, rest positions, displacements)
  pub fn addVec3Channel(self: &mut, domain: u32, name: &str, fill: Vec3) u32 {
    let found = self.findVec3Channel(domain, name);
    if found != NoIndex { return found; }
    let n = self.domainSize(domain);
    var values = List[Vec3].withCapacity(n);
    var i = 0usize;
    while i < n { values.push(fill); i = i + 1usize; }
    vec3s.push(Channel[Vec3](String.from(name), domain, values, fill));
    u32.from(vec3s.len() - 1usize)
  }
  pub fn findVec3Channel(self: &, domain: u32, name: &str) u32 {
    var i = 0usize;
    while i < vec3s.len() {
      if vec3s[i].domain == domain && vec3s[i].name.equals(name) { return u32.from(i); }
      i = i + 1usize;
    }
    NoIndex
  }
  pub fn vec3(self: &, channel: u32, element: u32) Vec3 {*vec3s[usize.from(channel)].values[usize.from(element)]}
  pub fn setVec3(self: &mut, channel: u32, element: u32, value: Vec3) {
    let c = &mut vec3s[usize.from(channel)];
    c.values.set(usize.from(element), value);
  }

  // Set a corner channel of Vec2 values from values given face by face,
  // corner by corner, in the order the faces' vertices were given (USD's
  // "face-varying" order): how uvs arrive from a file
  pub fn setCornerVec2s(self: &mut, channel: u32, values: &Array[Vec2]) {
    var k = 0usize;
    var f = 0usize;
    while f < fHalfedge.len() {
      let hs = self.faceHalfedges(u32.from(f));
      var i = 0usize;
      while i < hs.len() && k < values.len {
        self.setVec2(channel, *hs[i], values[k]);
        k = k + 1usize;
        i = i + 1usize;
      }
      f = f + 1usize;
    }
  }

  // -------- checking --------

  // Check every invariant of the half-edge structure, and list what fails,
  // one line each; an empty list means the mesh is sound. It checks: the
  // lists' lengths agree; every link names an element that exists; next and
  // prev undo each other; a half-edge's next stays in its face (or hole) and
  // starts where it ends; no edge joins a vertex to itself; every face has at
  // least 3 corners and its half-edge is its own; each vertex's half-edge
  // leaves it, and is a boundary one if the vertex is on the boundary; each
  // vertex is manifold (the faces about it make one fan, so turning about it
  // from its half-edge meets every edge on it); every channel has a value per
  // element.
  pub fn validate(self: &) List[String] {
    var out = List[String].empty();
    let nh = hVertex.len();
    let nv = positions.len();
    let nf = fHalfedge.len();
    if hNext.len() != nh || hPrev.len() != nh || hFace.len() != nh || nh % 2usize != 0usize {
      out.push(String.from("the half-edge lists differ in length, or are odd"));
      return out;
    }
    if vHalfedge.len() != nv {
      out.push(String.from("the vertex lists differ in length"));
      return out;
    }

    // Every link in range, before any is followed
    var h = 0usize;
    while h < nh {
      if usize.from(*hNext[h]) >= nh { out.push(elementProblem("half-edge ", h, ": its next does not exist")); }
      if usize.from(*hPrev[h]) >= nh { out.push(elementProblem("half-edge ", h, ": its prev does not exist")); }
      if usize.from(*hVertex[h]) >= nv { out.push(elementProblem("half-edge ", h, ": its vertex does not exist")); }
      if *hFace[h] != NoIndex && usize.from(*hFace[h]) >= nf {
        out.push(elementProblem("half-edge ", h, ": its face does not exist"));
      }
      h = h + 1usize;
    }
    var f = 0usize;
    while f < nf {
      if usize.from(*fHalfedge[f]) >= nh { out.push(elementProblem("face ", f, ": its half-edge does not exist")); }
      f = f + 1usize;
    }
    var v = 0usize;
    while v < nv {
      let vh = *vHalfedge[v];
      if vh != NoIndex && usize.from(vh) >= nh { out.push(elementProblem("vertex ", v, ": its half-edge does not exist")); }
      v = v + 1usize;
    }
    if out.len() > 0usize { return out; }

    // Each half-edge's links
    var leaving = List[u32].withCapacity(nv);      // per vertex: half-edges leaving it
    var onBoundary = List[bool].withCapacity(nv);  // per vertex: a boundary one leaves it
    v = 0usize;
    while v < nv {
      leaving.push(0u32);
      onBoundary.push(false);
      v = v + 1usize;
    }
    h = 0usize;
    while h < nh {
      let hn = usize.from(*hNext[h]);
      if usize.from(*hPrev[hn]) != h { out.push(elementProblem("half-edge ", h, ": its next's prev is not it")); }
      if *hFace[hn] != *hFace[h] { out.push(elementProblem("half-edge ", h, ": its next is in another face")); }
      if *hVertex[usize.from(twinOf(u32.from(hn)))] != *hVertex[h] {
        out.push(elementProblem("half-edge ", h, ": its next does not start where it ends"));
      }
      let from = usize.from(*hVertex[usize.from(twinOf(u32.from(h)))]);
      if h % 2usize == 0usize && usize.from(*hVertex[h]) == from {
        out.push(elementProblem("edge ", h / 2usize, ": joins a vertex to itself"));
      }
      leaving.set(from, *leaving[from] + 1u32);
      if *hFace[h] == NoIndex { onBoundary.set(from, true); }
      h = h + 1usize;
    }

    // Each face
    f = 0usize;
    while f < nf {
      let h0 = *fHalfedge[f];
      if *hFace[usize.from(h0)] != u32.from(f) {
        out.push(elementProblem("face ", f, ": its half-edge is another face's"));
      } else {
        var count = 0usize;
        var hh = h0;
        var going = true;
        while going {
          count = count + 1usize;
          hh = *hNext[usize.from(hh)];
          going = hh != h0 && count <= nh;
        }
        if count > nh { out.push(elementProblem("face ", f, ": its half-edges do not come back around")); }
        else if count < 3usize { out.push(elementProblem("face ", f, ": has fewer than 3 corners")); }
      }
      f = f + 1usize;
    }

    // Each vertex
    v = 0usize;
    while v < nv {
      let vh = *vHalfedge[v];
      if vh == NoIndex {
        if *leaving[v] > 0u32 { out.push(elementProblem("vertex ", v, ": is on edges but has no half-edge")); }
      } else if usize.from(*hVertex[usize.from(twinOf(vh))]) != v {
        out.push(elementProblem("vertex ", v, ": its half-edge does not leave it"));
      } else {
        if *onBoundary[v] && *hFace[usize.from(vh)] != NoIndex {
          out.push(elementProblem("vertex ", v, ": is on the boundary, but its half-edge is not"));
        }
        var ring = 0u32;
        var hh = vh;
        var going = true;
        while going {
          ring = ring + 1u32;
          hh = twinOf(*hPrev[usize.from(hh)]);
          going = hh != vh && usize.from(ring) <= nh;
        }
        if ring != *leaving[v] {
          out.push(elementProblem("vertex ", v, ": is not manifold (its faces are not one fan)"));
        }
      }
      v = v + 1usize;
    }

    // Each channel
    var c = 0usize;
    while c < floats.len() {
      self.checkChannel(&mut out, floats[c].name.view(), floats[c].domain, floats[c].values.len());
      c = c + 1usize;
    }
    c = 0usize;
    while c < vec2s.len() {
      self.checkChannel(&mut out, vec2s[c].name.view(), vec2s[c].domain, vec2s[c].values.len());
      c = c + 1usize;
    }
    c = 0usize;
    while c < vec3s.len() {
      self.checkChannel(&mut out, vec3s[c].name.view(), vec3s[c].domain, vec3s[c].values.len());
      c = c + 1usize;
    }
    out
  }

  fn checkChannel(self: &, out: &mut List[String], name: &str, domain: u32, len: usize) {
    let want = self.domainSize(domain);
    if len != want {
      var s = String.from("channel ");
      s.append(name);
      s.append(": has ");
      s.appendUInt(u64.from(len));
      s.append(" values for ");
      s.appendUInt(u64.from(want));
      s.append(" elements");
      out.push(s);
    }
  }

  // -------- to triangles --------

  // The mesh as triangles, one way. Each face is cut into triangles: a
  // triangle as it is; a convex polygon as a fan from its first corner (0, 1,
  // 2), (0, 2, 3), ...; any other by ear clipping ('triangulatePolygon',
  // polygon.cone) in its best-fit plane, the plane of its Newell
  // normal. An n-cornered face gives n - 2 triangles, counterclockwise about
  // the face's normal as the face is.
  //
  // With 'smooth' false, every corner is its own vertex with its face's
  // normal (flat shading). With 'smooth' true, corners at one vertex share a
  // vertex whose normal is 'vertexNormals''s, unless their uvs differ: a uv
  // seam splits the vertex, one copy per distinct uv. The uvs are the corner
  // channel of Vec2 named "uv", when there is one; without one, no uvs.
  pub fn triangulate(self: &, smooth: bool) Mesh {
    var out = Mesh.empty();
    let uvCh = self.findVec2Channel(CornerDomain, "uv");
    let hasUv = uvCh != NoIndex;
    let nv = positions.len();
    // Smooth: the vertices made for each mesh vertex, chained
    var vFirst = List[u32].withCapacity(nv);
    var oNext = List[u32].empty();
    var vnormals = List[Vec3].empty();
    if smooth {
      vnormals = self.vertexNormals();
      var v = 0usize;
      while v < nv { vFirst.push(NoIndex); v = v + 1usize; }
    }
    var made = List[u32].empty();      // each corner of the face: its vertex in 'out'
    var tris = List[u32].empty();
    var f = 0usize;
    while f < fHalfedge.len() {
      let hs = self.faceHalfedges(u32.from(f));
      let fnormal = self.faceNormal(u32.from(f));
      made.clear();
      var i = 0usize;
      while i < hs.len() {
        let h = *hs[i];
        let v = *hVertex[usize.from(h)];
        let uv = if hasUv {self.vec2(uvCh, h)} else {Vec2(0., 0.)};
        var found = NoIndex;
        if smooth {
          var o = *vFirst[usize.from(v)];
          while o != NoIndex && found == NoIndex {
            if !hasUv || sameVec2(*out.uvs[usize.from(o)], uv) { found = o; }
            o = *oNext[usize.from(o)];
          }
        }
        if found == NoIndex {
          found = u32.from(out.positions.len());
          out.positions.push(*positions[usize.from(v)]);
          if smooth { out.normals.push(*vnormals[usize.from(v)]); } else { out.normals.push(fnormal); }
          if hasUv { out.uvs.push(uv); }
          if smooth {
            oNext.push(*vFirst[usize.from(v)]);
            vFirst.set(usize.from(v), found);
          } else {
            oNext.push(NoIndex);
          }
        }
        made.push(found);
        i = i + 1usize;
      }
      tris.clear();
      self.cutFace(u32.from(f), &mut tris);
      i = 0usize;
      while i < tris.len() {
        out.indices.push(*made[usize.from(*tris[i])]);
        i = i + 1usize;
      }
      f = f + 1usize;
    }
    out
  }

  // Cut face f into triangles, as corner numbers of the face (0 its first),
  // three to a triangle
  pub fn cutFace(self: &, f: u32, tris: &mut List[u32]) {
    let pts = self.facePositions(f);
    let n = pts.len();
    if n < 3usize { return; }
    if n == 3usize {
      tris.push(0u32); tris.push(1u32); tris.push(2u32);
      return;
    }
    // Into the best-fit plane: u and w across it, u x w its normal
    let nrm = unitOrZero(newellNormal(&pts));
    let u = if nrm.x.abs() > nrm.z.abs() {unitOrZero(Vec3(-nrm.y, nrm.x, 0.))}
      else {unitOrZero(Vec3(0., -nrm.z, nrm.y))};
    let w = nrm.cross(u);
    let origin = *pts[0usize];
    var flat = List[Vec2].withCapacity(n);
    var i = 0usize;
    while i < n {
      let d = *pts[i] - origin;
      flat.push(Vec2(d.dot(u), d.dot(w)));
      i = i + 1usize;
    }
    // Convex: every corner turns left
    var convex = true;
    i = 0usize;
    while i < n {
      let a = *flat[(i + n - 1usize) % n];
      let b = *flat[i];
      let c = *flat[(i + 1usize) % n];
      if (b - a).cross(c - b) <= 0. { convex = false; }
      i = i + 1usize;
    }
    if convex {
      i = 1usize;
      while i + 1usize < n {
        tris.push(0u32); tris.push(u32.from(i)); tris.push(u32.from(i + 1usize));
        i = i + 1usize;
      }
    } else {
      let cut = triangulatePolygon(flat.view());
      i = 0usize;
      while i < cut.len() {
        tris.push(*cut[i]);
        i = i + 1usize;
      }
    }
  }

  // A cube centred at the origin, reaching 'size' along each axis each way, as
  // a cage of six quads: 8 vertices, 12 edges, 24 half-edges, closed. Vertex
  // x + 2y + 4z, each of x, y, z 0 for -size and 1 for +size, so vertex 0 is
  // (-size, -size, -size) and 7 (size, size, size). The faces, each
  // counterclockwise seen from outside: back (0, 2, 3, 1), front (4, 5, 7,
  // 6), left (0, 4, 6, 2), right (1, 3, 7, 5), bottom (0, 1, 5, 4), top (2,
  // 6, 7, 3).
  pub fn cube(size: f32) PolyMesh {
    var pts = List[Vec3].withCapacity(8usize);
    var v = 0u32;
    while v < 8u32 {
      let x = if (v & 1u32) != 0u32 {size} else {-size};
      let y = if (v & 2u32) != 0u32 {size} else {-size};
      let z = if (v & 4u32) != 0u32 {size} else {-size};
      pts.push(Vec3(x, y, z));
      v = v + 1u32;
    }
    let counts: Array[u32, 6] = [4u32, 4u32, 4u32, 4u32, 4u32, 4u32];
    var problems = List[String].empty();
    PolyMesh.fromPolygons(pts.view(), &counts, &cageFaces, &mut problems)
  }
}

fn listCopy[T](l: &List[T]) List[T] where T is Copy {
  var out = List[T].withCapacity(l.len());
  var i = 0usize;
  while i < l.len() { out.push(*l[i]); i = i + 1usize; }
  out
}

fn channelsCopy[T](cs: &List[Channel[T]]) List[Channel[T]] where T is Copy {
  var out = List[Channel[T]].withCapacity(cs.len());
  var i = 0usize;
  while i < cs.len() {
    out.push(Channel[T](String.from(cs[i].name.view()), cs[i].domain, listCopy[T](&cs[i].values), cs[i].fill));
    i = i + 1usize;
  }
  out
}
