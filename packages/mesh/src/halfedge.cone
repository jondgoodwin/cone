// ======== PolyMesh's helpers ========
//
// The cube cage's faces, and the module functions that building and
// validating a PolyMesh use. (The building steps that read or change the
// mesh itself, 'faceFits' and 'linkBoundary', are PolyMesh's private methods,
// in polymesh.cone.)

imm cageFaces Array[u32, 24] = [0u32, 2u32, 3u32, 1u32,  4u32, 5u32, 7u32, 6u32,  0u32, 4u32, 6u32, 2u32,
  1u32, 3u32, 7u32, 5u32,  0u32, 1u32, 5u32, 4u32,  2u32, 6u32, 7u32, 3u32];

// A half-edge's twin: the other of its pair
fn twinOf(h u32) u32 {h ^ 1u32;}

fn fabs32(a f32) f32 {if a < 0. {-a;} else {a;};}

// Two uvs exactly equal: a seam is where corners' uvs differ at all
fn sameVec2(a Vec2, b Vec2) bool {a.x == b.x and a.y == b.y;}

// The half-edge from a to b, or NoIndex, while building: each vertex's
// half-edges leaving it are chained through 'outNext' from 'outHead'
fn findHalfedge(hVertex &List[u32], outHead &List[u32], outNext &List[u32], a u32, b u32) u32 {
  mut h = *outHead[usize.from(a)];
  while h != NoIndex {
    if *hVertex[usize.from(h)] == b { return h; }
    h = *outNext[usize.from(h)];
  }
  NoIndex;
}

// "face 3: ..." begun, for a problem line
fn faceProblem(f usize, what &str) String {
  mut s = String.from("face ");
  s.appendUInt(u64.from(f));
  s.append(": ");
  s.append(what);
  s;
}

// "half-edge 5: ...", "vertex 2: ...", and so on
fn elementProblem(kind &str, n usize, what &str) String {
  mut s = String.from(kind);
  s.appendUInt(u64.from(n));
  s.append(what);
  s;
}
