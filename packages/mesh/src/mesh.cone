// The mesh package: surfaces made of polygons, in the two forms the industry
// keeps them in. A program reaches it with 'import mesh', and gets:
//
// - Mesh, indexed triangles: what a GPU draws and a collision engine reads.
//   Each kind of per-vertex data is its own list (structure of arrays):
//   positions, normals, texture coordinates (uvs), colors and tangents, the
//   last three optional; and 32-bit indices, three to a triangle. Material
//   groups cut the indices into ranges, each drawn with its own material
//   slot. It is three.js's BufferGeometry, Bevy's Mesh, glTF's primitive.
// - PolyMesh, an editable half-edge mesh of polygons of any size: what
//   sculpting operators work on, with every neighbour one step away. It is
//   index-based and kept as lists (the pmp-library's SurfaceMesh and
//   OpenMesh's layout), with named attribute channels per vertex, edge, face
//   or corner. 'triangulate' makes a Mesh of it, one way.
// - Generators: a UV sphere, a plane and a cube as Mesh; a cube cage as
//   PolyMesh, which is what subdivision starts from.
// - Wavefront .obj text and files, of a Mesh and of a PolyMesh, for viewing
//   in Blender or any modeller.
//
// Its conventions are geomath's, which are the industry's: right-handed space,
// y up, f32. A triangle or polygon faces the side from which its corners run
// counterclockwise (OpenGL's, Vulkan's usual, glTF's and .obj's front face),
// and every generator winds its faces so, seen from outside. A texture
// coordinate's u runs across the image and v up it, 0 to 1.
//
// The half-edge conventions, the pmp-library's and OpenMesh's:
//
// - Every edge is two half-edges, made together: half-edge 2e runs one way
//   along edge e and 2e + 1 the other, so a half-edge's twin is its number
//   with the lowest bit flipped, and is not stored.
// - A half-edge records the vertex it points TO ('toVertex'); the one it
//   leaves is its twin's. It records the next and previous half-edge around
//   its face, and its face.
// - The boundary is half-edges with no face (face 'NoIndex'), linked by next
//   and prev into loops around each hole, so walking 'next' works the same on
//   either side of the boundary.
// - Each face records one of its half-edges; each vertex one half-edge
//   leaving it, and a boundary one when it is on the boundary, so whether a
//   vertex is on the boundary is one look. A vertex on no edge records
//   'NoIndex'.
// - Around a vertex, the half-edges leaving it are visited counterclockwise
//   seen from outside: from one leaving it, the next is the twin of the one
//   before it in its face (pmp's ccw_rotated_halfedge).
// - A corner of a face is the half-edge that ends at the corner's vertex, so a
//   corner's number is a half-edge's, and a per-corner channel holds a value
//   for every half-edge (a boundary one's is unused).
//
// A mesh the build refuses is reported, not stopped: 'fromPolygons' leaves
// out a face it cannot add and says why, and 'validate' checks every
// invariant above and lists what fails.
//
// The package is one file, since a package a program finds on the search path
// (rather than one Congo builds) is compiled from its src/<name>.cone alone.

mod mesh;

import libc;
import geomath use *;
import collections use *;

// No element: a boundary half-edge's face, an isolated vertex's half-edge,
// a channel not found
pub const NoIndex = 0xFFFFFFFFu32;

// What an attribute channel holds a value for
pub const VertexDomain = 0u32;   // each vertex
pub const EdgeDomain = 1u32;     // each edge (crease sharpness, seams)
pub const FaceDomain = 2u32;     // each face (material slot, smoothing group)
pub const CornerDomain = 3u32;   // each corner of a face, by half-edge (uvs)

// ======== Mesh: indexed triangles ========

// A range of a Mesh's indices drawn with one material: 'count' indices from
// 'start', a whole number of triangles, with the material in slot 'material'
// (three.js's group, glTF's primitive)
pub struct Group {
  pub start u32;
  pub count u32;
  pub material u32;
}

// Triangles over vertices. Every list of vertex data that is not empty has
// one value per position. 'indices' holds three per triangle, each triangle
// facing the side from which it runs counterclockwise. 'groups' is empty when
// the whole mesh is one material, slot 0.
pub struct Mesh {
  pub positions List[Vec3];
  pub normals List[Vec3];     // unit length, or empty
  pub uvs List[Vec2];         // texture coordinates, or empty
  pub colors List[Color];     // or empty
  pub tangents List[Vec4];    // xyz along u, w the handedness (1 or -1), or empty
  pub indices List[u32];
  pub groups List[Group];

  // A mesh with nothing in it
  pub fn empty() Mesh {
    Mesh[List[Vec3].empty(), List[Vec3].empty(), List[Vec2].empty(), List[Color].empty(),
      List[Vec4].empty(), List[u32].empty(), List[Group].empty()];
  }

  pub fn vertexCount(self &) usize {positions.len();}
  pub fn triangleCount(self &) usize {indices.len() / 3usize;}

  // The smallest box holding every position; empty when there are none
  pub fn bounds(self &) Aabb3 {Aabb3.fromPoints(positions.view());}

  // Add a material group: 'count' indices from 'start', in slot 'material'
  pub fn addGroup(self &mut, start u32, count u32, material u32) {
    groups.push(Group[start, count, material]);
  }

  // The unit normal of triangle t, by the right-hand rule on its corners;
  // (0, 0, 0) when it has no area
  pub fn triangleNormal(self &, t usize) Vec3 {
    imm a = *positions[usize[*indices[3usize * t]]];
    imm b = *positions[usize[*indices[3usize * t + 1usize]]];
    imm c = *positions[usize[*indices[3usize * t + 2usize]]];
    unitOrZero((b - a).cross(c - a));
  }

  // Flat shading: every triangle gets three vertices of its own, each with
  // the triangle's normal. The vertices are split, so no two triangles share
  // one, and the indices become 0, 1, 2, ... (the vertex count is three per
  // triangle). Uvs, colors and tangents are carried to the split vertices;
  // the groups still cover the same triangles.
  pub fn computeFlatNormals(self &mut) {
    imm nt = indices.len() / 3usize;
    imm hasUv = uvs.len() > 0usize;
    imm hasColor = colors.len() > 0usize;
    imm hasTangent = tangents.len() > 0usize;
    mut np = List[Vec3].withCapacity(3usize * nt);
    mut nn = List[Vec3].withCapacity(3usize * nt);
    mut nu = List[Vec2].empty();
    mut nc = List[Color].empty();
    mut ng = List[Vec4].empty();
    mut ni = List[u32].withCapacity(3usize * nt);
    mut t = 0usize;
    while t < nt {
      imm normal = self.triangleNormal(t);
      mut k = 0usize;
      while k < 3usize {
        imm v = usize[*indices[3usize * t + k]];
        np.push(*positions[v]);
        nn.push(normal);
        if hasUv { nu.push(*uvs[v]); }
        if hasColor { nc.push(*colors[v]); }
        if hasTangent { ng.push(*tangents[v]); }
        ni.push(u32[3usize * t + k]);
        k = k + 1usize;
      }
      t = t + 1usize;
    }
    positions = np;
    normals = nn;
    uvs = nu;
    colors = nc;
    tangents = ng;
    indices = ni;
  }

  // Smooth shading: each vertex's normal is the sum of the normals of the
  // triangles using it, each weighted by the triangle's angle at that vertex,
  // made unit length (Thurmer and Wuthrich's angle weighting, Blender's and
  // the pmp-library's). Angle weighting, unlike weighting by area, does not
  // change with how a polygon was cut into triangles. Vertices are not
  // merged: two vertices at one place (a uv seam) keep their own normals,
  // each from its own triangles. A vertex no triangle uses gets (0, 0, 0).
  pub fn computeSmoothNormals(self &mut) {
    imm n = positions.len();
    mut acc = List[Vec3].withCapacity(n);
    mut v = 0usize;
    while v < n {
      acc.push(Vec3[0., 0., 0.]);
      v = v + 1usize;
    }
    imm nt = indices.len() / 3usize;
    mut t = 0usize;
    while t < nt {
      imm normal = self.triangleNormal(t);
      mut k = 0usize;
      while k < 3usize {
        imm i0 = usize[*indices[3usize * t + k]];
        imm i1 = usize[*indices[3usize * t + (k + 1usize) % 3usize]];
        imm i2 = usize[*indices[3usize * t + (k + 2usize) % 3usize]];
        imm p = *positions[i0];
        imm w = cornerAngle(p, *positions[i1], *positions[i2]);
        acc.set(i0, *acc[i0] + normal * w);
        k = k + 1usize;
      }
      t = t + 1usize;
    }
    mut out = List[Vec3].withCapacity(n);
    v = 0usize;
    while v < n {
      out.push(unitOrZero(*acc[v]));
      v = v + 1usize;
    }
    normals = out;
  }

  // Add another mesh's vertices and triangles to this one's; its indices are
  // moved past this mesh's vertices. A list of vertex data only one of the two
  // has is filled for the other: normals (0, 0, 0), uvs (0, 0), colors white,
  // tangents (1, 0, 0, 1). When either has groups, both get them, the one
  // without becoming a single group in slot 0.
  pub fn append(self &mut, o &Mesh) {
    imm n0 = positions.len();
    imm n1 = o.positions.len();
    imm base = u32[n0];
    imm istart = u32[indices.len()];
    appendStream[Vec3](&mut normals, n0, &o.normals, n1, Vec3[0., 0., 0.]);
    appendStream[Vec2](&mut uvs, n0, &o.uvs, n1, Vec2[0., 0.]);
    appendStream[Color](&mut colors, n0, &o.colors, n1, Color[1., 1., 1., 1.]);
    appendStream[Vec4](&mut tangents, n0, &o.tangents, n1, Vec4[1., 0., 0., 1.]);
    mut i = 0usize;
    while i < n1 {
      positions.push(*o.positions[i]);
      i = i + 1usize;
    }
    if groups.len() > 0usize or o.groups.len() > 0usize {
      if groups.len() == 0usize and istart > 0u32 {
        groups.push(Group[0u32, istart, 0u32]);
      }
      if o.groups.len() == 0usize {
        if o.indices.len() > 0usize {
          groups.push(Group[istart, u32[o.indices.len()], 0u32]);
        }
      } else {
        mut g = 0usize;
        while g < o.groups.len() {
          imm og = *o.groups[g];
          groups.push(Group[og.start + istart, og.count, og.material]);
          g = g + 1usize;
        }
      }
    }
    i = 0usize;
    while i < o.indices.len() {
      indices.push(*o.indices[i] + base);
      i = i + 1usize;
    }
  }

  // Carry the mesh by a placement: positions as points, normals by the
  // normal matrix (the inverse transpose, so a stretch does not lean them)
  // made unit again, tangents' directions as vectors with their handedness
  // kept. A placement that mirrors (its determinant is negative) would turn
  // every triangle inside out, so each triangle's winding is reversed too,
  // as glTF does.
  pub fn transform(self &mut, m Mat4) {
    imm nm = Mat3.normalMatrix(m);
    mut i = 0usize;
    while i < positions.len() {
      positions.set(i, m * *positions[i]);
      i = i + 1usize;
    }
    i = 0usize;
    while i < normals.len() {
      normals.set(i, unitOrZero(nm * *normals[i]));
      i = i + 1usize;
    }
    i = 0usize;
    while i < tangents.len() {
      imm t = *tangents[i];
      tangents.set(i, unitOrZero(m.transformVector(t.xyz())).extend(t.w));
      i = i + 1usize;
    }
    if m.determinant() < 0. {
      mut t = 0usize;
      while t + 2usize < indices.len() {
        indices.swap(t + 1usize, t + 2usize);
        t = t + 3usize;
      }
    }
  }

  // The same, by a translation, rotation and scale
  pub fn transformBy(self &mut, t Transform3) {self.transform(t.toMat4());}

  // A sphere of 'radius' centred at the origin, by longitude and latitude:
  // 'nsegments' slices around and as many from pole to pole. The normals point
  // outwards. The top pole's uv is (0, 1), and u runs once around each circle
  // of latitude, which ends in a repeat of its first vertex at u = 1, so the
  // texture's edges meet. A pole, n - 1 circles of n + 1 vertices, a pole:
  // (n + 1)(n - 1) + 2 vertices; n triangles at each pole and 2n for each of
  // the n - 2 bands between circles, 2n(n - 1) triangles. Fewer than 3
  // segments gives an empty mesh. (Pegasus3D's sphere, with its joining of
  // the circles and its vertex count corrected.)
  pub fn sphere(radius f32, nsegments i32) Mesh {
    mut s = Mesh.empty();
    imm n = nsegments;
    if n <= 2 { return s; }
    imm nverts = (n + 1) * (n - 1) + 2;
    s.positions.reserve(usize[nverts]);
    s.normals.reserve(usize[nverts]);
    s.uvs.reserve(usize[nverts]);
    s.indices.reserve(usize[6 * n * (n - 1)]);

    // Top pole vertex
    s.positions.push(Vec3[0., radius, 0.]);
    s.normals.push(Vec3[0., 1., 0.]);
    s.uvs.push(Vec2[0., 1.]);

    // Each circle of latitude, top to bottom, and each vertex around it:
    // circle i's vertex j is vertex (i - 1)(n + 1) + j + 1
    imm stride = n + 1;
    mut i = 1;
    while i < n {
      imm mang = pi * f32[i] / f32[n];
      mut j = 0;
      while j < n {
        imm nang = 2. * pi * f32[j] / f32[n];
        imm x = -cos(nang) * sin(mang);
        imm y = cos(mang);
        imm z = sin(nang) * sin(mang);
        s.normals.push(Vec3[x, y, z]);
        s.positions.push(Vec3[x * radius, y * radius, z * radius]);
        s.uvs.push(Vec2[f32[j] / f32[n], f32[n - i] / f32[n]]);

        // Two triangles per segment; one where the circle meets the pole
        if i == 1 {
          s.indices.push(0u32);
          s.indices.push(u32[j + 1]);
          s.indices.push(u32[j + 2]);
        } else {
          imm v0 = (i - 2) * stride + j + 1;
          imm v1 = (i - 2) * stride + j + 2;
          imm v2 = (i - 1) * stride + j + 2;
          imm v3 = (i - 1) * stride + j + 1;
          s.indices.push(u32[v0]);
          s.indices.push(u32[v3]);
          s.indices.push(u32[v2]);
          s.indices.push(u32[v0]);
          s.indices.push(u32[v2]);
          s.indices.push(u32[v1]);
        }
        j = j + 1;
      }
      // The circle's first vertex again, at u = 1
      imm x = -sin(mang);
      imm y = cos(mang);
      s.normals.push(Vec3[x, y, 0.]);
      s.positions.push(Vec3[x * radius, y * radius, 0.]);
      s.uvs.push(Vec2[1., f32[n - i] / f32[n]]);
      i = i + 1;
    }

    // Bottom pole vertex
    s.positions.push(Vec3[0., -radius, 0.]);
    s.normals.push(Vec3[0., -1., 0.]);
    s.uvs.push(Vec2[0., 0.]);

    // The bottom circle joined to it
    imm pole = (n - 1) * stride + 1;
    mut j = 0;
    while j < n {
      s.indices.push(u32[(n - 2) * stride + j + 1]);
      s.indices.push(u32[pole]);
      s.indices.push(u32[(n - 2) * stride + j + 2]);
      j = j + 1;
    }
    s;
  }

  // A flat square in y = 0 from -1 to 1 in x and z, facing up (+y), cut into
  // 'nsegments' by 'nsegments' squares of two triangles: (n + 1)^2 vertices,
  // row by row along x from z = -1. The uv (0, 0) is the corner at (-1, 0, 1),
  // and 'uvrepeat' is how many times the texture repeats across it. Fewer than
  // 1 segment gives an empty mesh.
  pub fn plane(nsegments i32, uvrepeat f32) Mesh {
    mut s = Mesh.empty();
    imm n = nsegments;
    if n < 1 { return s; }
    imm nverts = (n + 1) * (n + 1);
    s.positions.reserve(usize[nverts]);
    s.normals.reserve(usize[nverts]);
    s.uvs.reserve(usize[nverts]);
    s.indices.reserve(usize[6 * n * n]);

    mut segz = 0;
    while segz <= n {
      mut segx = 0;
      while segx <= n {
        imm x = 2. * f32[segx] / f32[n] - 1.;
        imm z = 2. * f32[segz] / f32[n] - 1.;
        s.positions.push(Vec3[x, 0., z]);
        s.normals.push(Vec3[0., 1., 0.]);
        s.uvs.push(Vec2[uvrepeat * f32[segx] / f32[n], uvrepeat * (1. - f32[segz] / f32[n])]);

        // Two triangles per square
        if segx > 0 and segz > 0 {
          imm v0 = (segz - 1) * (n + 1) + segx - 1;
          imm v1 = (segz - 1) * (n + 1) + segx;
          imm v2 = segz * (n + 1) + segx;
          imm v3 = segz * (n + 1) + segx - 1;
          s.indices.push(u32[v0]);
          s.indices.push(u32[v3]);
          s.indices.push(u32[v2]);
          s.indices.push(u32[v0]);
          s.indices.push(u32[v2]);
          s.indices.push(u32[v1]);
        }
        segx = segx + 1;
      }
      segz = segz + 1;
    }
    s;
  }

  // A cube centred at the origin, reaching 'size' along each axis each way:
  // four vertices for each face (top, bottom, back, front, left, right, in
  // Pegasus3D's order), so each face has its own normal and its own uvs, and
  // two triangles each. Each face's uvs run from (0, 0) at its lower left to
  // (1, 1) at its upper right, seen from outside (the top seen with -z up,
  // the bottom with +z up).
  pub fn cube(size f32) Mesh {
    mut s = Mesh.empty();
    s.positions.reserve(24usize);
    s.normals.reserve(24usize);
    s.uvs.reserve(24usize);
    mut v = 0usize;
    while v < 24usize {
      imm f = 3usize * (v / 4usize);
      imm p = Vec3[cubePositions[3usize * v], cubePositions[3usize * v + 1usize],
        cubePositions[3usize * v + 2usize]];
      imm right = Vec3[cubeRights[f], cubeRights[f + 1usize], cubeRights[f + 2usize]];
      imm up = Vec3[cubeUps[f], cubeUps[f + 1usize], cubeUps[f + 2usize]];
      s.positions.push(p * size);
      s.normals.push(right.cross(up));
      s.uvs.push(Vec2[(p.dot(right) + 1.) * 0.5, (p.dot(up) + 1.) * 0.5]);
      v = v + 1usize;
    }
    s.indices.reserve(36usize);
    mut i = 0usize;
    while i < 36usize {
      s.indices.push(cubeIndices[i]);
      i = i + 1usize;
    }
    s;
  }
}

// Pegasus3D's cube: the four corners of each face (top, bottom, back, front,
// left, right)
imm cubePositions [72; f32] = [
  -1f, 1f, -1f,  1f, 1f, -1f,  1f, 1f, 1f,  -1f, 1f, 1f,
  -1f, -1f, -1f,  1f, -1f, -1f,  1f, -1f, 1f,  -1f, -1f, 1f,
  -1f, 1f, -1f,  1f, 1f, -1f,  1f, -1f, -1f,  -1f, -1f, -1f,
  -1f, 1f, 1f,  1f, 1f, 1f,  1f, -1f, 1f,  -1f, -1f, 1f,
  -1f, -1f, -1f,  -1f, 1f, -1f,  -1f, 1f, 1f,  -1f, -1f, 1f,
  1f, -1f, -1f,  1f, 1f, -1f,  1f, 1f, 1f,  1f, -1f, 1f];
// Two triangles for each face, counterclockwise seen from outside.
// (Pegasus3D's ran (0, 1, 2), (0, 2, 3) on every face, which is clockwise on
// the top, front and left ones.)
imm cubeIndices [36; u32] = [0u32, 2u32, 1u32, 0u32, 3u32, 2u32, 4u32, 5u32, 6u32, 4u32, 6u32, 7u32,
  8u32, 9u32, 10u32, 8u32, 10u32, 11u32, 12u32, 14u32, 13u32, 12u32, 15u32, 14u32,
  16u32, 18u32, 17u32, 16u32, 19u32, 18u32, 20u32, 21u32, 22u32, 20u32, 22u32, 23u32];
// Each face's directions across and up it, seen from outside: their cross
// product is its outward normal
imm cubeRights [18; f32] = [1f, 0f, 0f,  1f, 0f, 0f,  -1f, 0f, 0f,  1f, 0f, 0f,  0f, 0f, 1f,  0f, 0f, -1f];
imm cubeUps [18; f32] = [0f, 0f, -1f,  0f, 0f, 1f,  0f, 1f, 0f,  0f, 1f, 0f,  0f, 1f, 0f,  0f, 1f, 0f];

// Extend 'dst', which holds data for 'n0' vertices or none, by 'src''s data
// for 'n1' more, filling for whichever lacks it; nothing when both lack it
fn appendStream[T](dst &mut List[T], n0 usize, src &List[T], n1 usize, fill T) {
  if dst.len() == 0usize and src.len() == 0usize { return; }
  while dst.len() < n0 { dst.push(fill); }
  mut i = 0usize;
  while i < n1 {
    if i < src.len() { dst.push(*src[i]); } else { dst.push(fill); }
    i = i + 1usize;
  }
}

// The vector made unit length, or (0, 0, 0) if it has none
fn unitOrZero(v Vec3) Vec3 {
  imm len = v.length();
  if len > 0. { v * (1. / len); } else { Vec3[0., 0., 0.]; };
}

// The angle at corner p of the triangle p, a, b, in radians; 0 when an edge
// has no length
fn cornerAngle(p Vec3, a Vec3, b Vec3) f32 {
  imm e1 = a - p;
  imm e2 = b - p;
  imm l = e1.length() * e2.length();
  if l <= 0. { return 0.; }
  mut c = e1.dot(e2) / l;
  if c > 1. { c = 1.; }
  if c < -1. { c = -1.; }
  acos(c);
}

// The normal of a polygon by Newell's method, of length twice its area
// (unnormalized): exact for a flat polygon, convex or not, and the best-fit
// plane's normal for one that is not quite flat
fn newellNormal(pts &List[Vec3]) Vec3 {
  mut nx f32 = 0.;
  mut ny f32 = 0.;
  mut nz f32 = 0.;
  imm n = pts.len();
  mut i = 0usize;
  while i < n {
    imm a = *pts[i];
    imm b = *pts[(i + 1usize) % n];
    nx = nx + (a.y - b.y) * (a.z + b.z);
    ny = ny + (a.z - b.z) * (a.x + b.x);
    nz = nz + (a.x - b.x) * (a.y + b.y);
    i = i + 1usize;
  }
  Vec3[nx, ny, nz];
}

// ======== PolyMesh: the editable half-edge mesh ========

// A named list of values of one type, one per element of a domain
pub struct Channel[T] {
  pub name String;
  pub domain u32;
  pub values List[T];
}

// A mesh of polygons of any size, with the half-edge links between them (the
// conventions are at the top of this file). Every list is public, for
// reading; change it through the methods, or 'validate' after changing it
// directly.
pub struct PolyMesh {
  pub positions List[Vec3];     // per vertex
  pub vHalfedge List[u32];      // per vertex: a half-edge leaving it
  pub hNext List[u32];          // per half-edge: the next around its face or hole
  pub hPrev List[u32];          // per half-edge: the previous
  pub hVertex List[u32];        // per half-edge: the vertex it points to
  pub hFace List[u32];          // per half-edge: its face, NoIndex on the boundary
  pub fHalfedge List[u32];      // per face: the half-edge ending at its first vertex
  pub floats List[Channel[f32]];
  pub vec2s List[Channel[Vec2]];
  pub vec3s List[Channel[Vec3]];

  // A mesh with nothing in it
  pub fn empty() PolyMesh {
    PolyMesh[List[Vec3].empty(), List[u32].empty(), List[u32].empty(), List[u32].empty(),
      List[u32].empty(), List[u32].empty(), List[u32].empty(),
      List[Channel[f32]].empty(), List[Channel[Vec2]].empty(), List[Channel[Vec3]].empty()];
  }

  // Build from polygons: the positions, and each face as its vertices' numbers
  // in order, counterclockwise seen from the side it faces. The faces are
  // given flat, as USD, Alembic and OpenSubdiv give them: 'counts' holds each
  // face's number of corners, and 'indices' all the faces' vertex numbers one
  // after another. A face that cannot be added is left out, with a line saying
  // why added to 'problems': fewer than 3 corners, a vertex that does not
  // exist or appears twice in it, or an edge another face already runs along
  // the same way (a third face on an edge, or two faces facing opposite
  // ways). Faces meeting at only a vertex are added; 'validate' reports that
  // vertex as not manifold.
  pub fn fromPolygons(positions &[]Vec3, counts &[]u32, indices &[]u32, problems &mut List[String]) PolyMesh {
    mut m = PolyMesh.empty();
    imm nv = positions.len;
    mut outHead = List[u32].withCapacity(nv);    // per vertex: the last half-edge made leaving it
    mut outNext = List[u32].empty();             // per half-edge: the one made before it leaving its vertex
    mut v = 0usize;
    while v < nv {
      m.positions.push(positions[v]);
      m.vHalfedge.push(NoIndex);
      outHead.push(NoIndex);
      v = v + 1usize;
    }
    mut need = 0usize;
    mut f = 0usize;
    while f < counts.len {
      need = need + usize[counts[f]];
      f = f + 1usize;
    }
    if need != indices.len {
      mut s = String.from("the faces' sizes add up to ");
      s.appendUInt(u64[need]);
      s.append(" corners, but ");
      s.appendUInt(u64[indices.len]);
      s.append(" vertex numbers were given");
      problems.push(s);
      return m;
    }

    mut hs = List[u32].empty();
    mut start = 0usize;
    f = 0usize;
    while f < counts.len {
      imm n = usize[counts[f]];
      if faceFits(&m, f, &indices[start..start + n], nv, &outHead, &outNext, problems) {
        // Each corner's half-edge from it to the next corner, made with its
        // twin when the edge is new
        hs.clear();
        mut i = 0usize;
        while i < n {
          imm a = indices[start + i];
          imm b = indices[start + (i + 1usize) % n];
          mut h = findHalfedge(&m.hVertex, &outHead, &outNext, a, b);
          if h == NoIndex {
            h = u32[m.hVertex.len()];
            m.hVertex.push(b);
            m.hVertex.push(a);
            m.hFace.push(NoIndex);
            m.hFace.push(NoIndex);
            m.hNext.push(NoIndex);
            m.hNext.push(NoIndex);
            m.hPrev.push(NoIndex);
            m.hPrev.push(NoIndex);
            outNext.push(*outHead[usize[a]]);
            outNext.push(*outHead[usize[b]]);
            outHead.set(usize[a], h);
            outHead.set(usize[b], h + 1u32);
          }
          hs.push(h);
          i = i + 1usize;
        }
        imm face = u32[m.fHalfedge.len()];
        i = 0usize;
        while i < n {
          imm h = *hs[i];
          imm hn = *hs[(i + 1usize) % n];
          m.hFace.set(usize[h], face);
          m.hNext.set(usize[h], hn);
          m.hPrev.set(usize[hn], h);
          i = i + 1usize;
        }
        // The half-edge ending at the first vertex: the last corner's
        m.fHalfedge.push(*hs[n - 1usize]);
      }
      start = start + n;
      f = f + 1usize;
    }
    linkBoundary(&mut m);
    m;
  }

  // -------- counts --------

  pub fn vertexCount(self &) usize {positions.len();}
  pub fn halfedgeCount(self &) usize {hVertex.len();}
  pub fn edgeCount(self &) usize {hVertex.len() / 2usize;}
  pub fn faceCount(self &) usize {fHalfedge.len();}

  // -------- stepping between elements --------

  pub fn next(self &, h u32) u32 {*hNext[usize[h]];}
  pub fn prev(self &, h u32) u32 {*hPrev[usize[h]];}
  pub fn twin(self &, h u32) u32 {twinOf(h);}
  pub fn toVertex(self &, h u32) u32 {*hVertex[usize[h]];}
  pub fn fromVertex(self &, h u32) u32 {*hVertex[usize[twinOf(h)]];}
  pub fn face(self &, h u32) u32 {*hFace[usize[h]];}
  pub fn edge(self &, h u32) u32 {h / 2u32;}
  // Half-edge 0 or 1 of edge e
  pub fn edgeHalfedge(self &, e u32, side u32) u32 {2u32 * e + side;}
  pub fn faceHalfedge(self &, f u32) u32 {*fHalfedge[usize[f]];}
  pub fn vertexHalfedge(self &, v u32) u32 {*vHalfedge[usize[v]];}

  pub fn isBoundaryHalfedge(self &, h u32) Bool {*hFace[usize[h]] == NoIndex;}
  pub fn isBoundaryEdge(self &, e u32) Bool {
    *hFace[usize[2u32 * e]] == NoIndex or *hFace[usize[2u32 * e + 1u32]] == NoIndex;
  }
  // On the boundary: a vertex's half-edge is a boundary one when it can be
  pub fn isBoundaryVertex(self &, v u32) Bool {
    imm h = *vHalfedge[usize[v]];
    h != NoIndex and *hFace[usize[h]] == NoIndex;
  }
  pub fn isIsolated(self &, v u32) Bool {*vHalfedge[usize[v]] == NoIndex;}

  // A face's half-edges in order, starting with the one ending at its first
  // vertex: its corners
  pub fn faceHalfedges(self &, f u32) List[u32] {
    mut out = List[u32].empty();
    imm h0 = *fHalfedge[usize[f]];
    mut h = h0;
    mut going = true;
    while going {
      out.push(h);
      h = *hNext[usize[h]];
      going = h != h0 and out.len() <= hNext.len();
    }
    out;
  }

  // A face's vertices in order, from its first
  pub fn faceVertices(self &, f u32) List[u32] {
    imm hs = self.faceHalfedges(f);
    mut out = List[u32].withCapacity(hs.len());
    mut i = 0usize;
    while i < hs.len() {
      out.push(*hVertex[usize[*hs[i]]]);
      i = i + 1usize;
    }
    out;
  }

  // How many corners a face has
  pub fn faceDegree(self &, f u32) usize {
    imm hs = self.faceHalfedges(f);
    hs.len();
  }

  // The half-edges leaving a vertex, counterclockwise seen from outside,
  // starting with its own (a boundary one when it is on the boundary): its
  // one-ring. An isolated vertex has none.
  pub fn vertexOutgoing(self &, v u32) List[u32] {
    mut out = List[u32].empty();
    imm h0 = *vHalfedge[usize[v]];
    if h0 == NoIndex { return out; }
    mut h = h0;
    mut going = true;
    while going {
      out.push(h);
      h = twinOf(*hPrev[usize[h]]);
      going = h != h0 and out.len() <= hNext.len();
    }
    out;
  }

  // The vertices joined to a vertex by an edge, in the order of its one-ring
  pub fn vertexNeighbors(self &, v u32) List[u32] {
    imm hs = self.vertexOutgoing(v);
    mut out = List[u32].withCapacity(hs.len());
    mut i = 0usize;
    while i < hs.len() {
      out.push(*hVertex[usize[*hs[i]]]);
      i = i + 1usize;
    }
    out;
  }

  // How many edges a vertex is on
  pub fn valence(self &, v u32) usize {
    imm hs = self.vertexOutgoing(v);
    hs.len();
  }

  // -------- geometry --------

  // A face's corner positions, in order
  pub fn facePositions(self &, f u32) List[Vec3] {
    imm hs = self.faceHalfedges(f);
    mut out = List[Vec3].withCapacity(hs.len());
    mut i = 0usize;
    while i < hs.len() {
      out.push(*positions[usize[*hVertex[usize[*hs[i]]]]]);
      i = i + 1usize;
    }
    out;
  }

  // A face's unit normal, by Newell's method: the best-fit plane's, so a
  // polygon that is not quite flat, or not convex, still gets the right one
  pub fn faceNormal(self &, f u32) Vec3 {
    imm pts = self.facePositions(f);
    unitOrZero(newellNormal(&pts));
  }

  // The mean of a face's corners
  pub fn faceCentroid(self &, f u32) Vec3 {
    imm pts = self.facePositions(f);
    mut sum = Vec3[0., 0., 0.];
    mut i = 0usize;
    while i < pts.len() {
      sum = sum + *pts[i];
      i = i + 1usize;
    }
    if pts.len() > 0usize { sum * (1. / f32[pts.len()]); } else { sum; };
  }

  // Every vertex's unit normal: its faces' normals, each weighted by the
  // face's angle at the vertex (the angle of the polygon, not of any triangle
  // cut from it). An isolated vertex gets (0, 0, 0).
  pub fn vertexNormals(self &) List[Vec3] {
    imm nv = positions.len();
    mut acc = List[Vec3].withCapacity(nv);
    mut v = 0usize;
    while v < nv {
      acc.push(Vec3[0., 0., 0.]);
      v = v + 1usize;
    }
    mut f = 0usize;
    while f < fHalfedge.len() {
      imm fnormal = self.faceNormal(u32[f]);
      imm hs = self.faceHalfedges(u32[f]);
      mut i = 0usize;
      while i < hs.len() {
        imm h = *hs[i];
        imm c = usize[*hVertex[usize[h]]];
        imm after = *positions[usize[*hVertex[usize[*hNext[usize[h]]]]]];
        imm before = *positions[usize[self.fromVertex(h)]];
        imm w = cornerAngle(*positions[c], after, before);
        acc.set(c, *acc[c] + fnormal * w);
        i = i + 1usize;
      }
      f = f + 1usize;
    }
    mut out = List[Vec3].withCapacity(nv);
    v = 0usize;
    while v < nv {
      out.push(unitOrZero(*acc[v]));
      v = v + 1usize;
    }
    out;
  }

  // The smallest box holding every vertex
  pub fn bounds(self &) Aabb3 {Aabb3.fromPoints(positions.view());}

  // -------- attribute channels --------

  // How many elements a domain has. A corner channel has a slot for every
  // half-edge, boundary ones included.
  pub fn domainSize(self &, domain u32) usize {
    if domain == VertexDomain { positions.len(); }
    elif domain == EdgeDomain { hVertex.len() / 2usize; }
    elif domain == FaceDomain { fHalfedge.len(); }
    else { hVertex.len(); };
  }

  // A channel of f32 values for a domain, found by name or else made with
  // every value 'fill'; its number, for 'float' and 'setFloat'. Channels are
  // sized to the mesh as it is when they are made.
  pub fn addFloatChannel(self &mut, domain u32, name &[]u8, fill f32) u32 {
    imm found = self.findFloatChannel(domain, name);
    if found != NoIndex { return found; }
    imm n = self.domainSize(domain);
    mut values = List[f32].withCapacity(n);
    mut i = 0usize;
    while i < n { values.push(fill); i = i + 1usize; }
    floats.push(Channel[f32][String.from(name), domain, values]);
    u32[floats.len() - 1usize];
  }
  pub fn findFloatChannel(self &, domain u32, name &[]u8) u32 {
    mut i = 0usize;
    while i < floats.len() {
      if floats[i].domain == domain and floats[i].name.equals(name) { return u32[i]; }
      i = i + 1usize;
    }
    NoIndex;
  }
  pub fn float(self &, channel u32, element u32) f32 {*floats[usize[channel]].values[usize[element]];}
  pub fn setFloat(self &mut, channel u32, element u32, value f32) {
    imm c = &mut floats[usize[channel]];
    c.values.set(usize[element], value);
  }

  // The same for Vec2 values (uvs)
  pub fn addVec2Channel(self &mut, domain u32, name &[]u8, fill Vec2) u32 {
    imm found = self.findVec2Channel(domain, name);
    if found != NoIndex { return found; }
    imm n = self.domainSize(domain);
    mut values = List[Vec2].withCapacity(n);
    mut i = 0usize;
    while i < n { values.push(fill); i = i + 1usize; }
    vec2s.push(Channel[Vec2][String.from(name), domain, values]);
    u32[vec2s.len() - 1usize];
  }
  pub fn findVec2Channel(self &, domain u32, name &[]u8) u32 {
    mut i = 0usize;
    while i < vec2s.len() {
      if vec2s[i].domain == domain and vec2s[i].name.equals(name) { return u32[i]; }
      i = i + 1usize;
    }
    NoIndex;
  }
  pub fn vec2(self &, channel u32, element u32) Vec2 {*vec2s[usize[channel]].values[usize[element]];}
  pub fn setVec2(self &mut, channel u32, element u32, value Vec2) {
    imm c = &mut vec2s[usize[channel]];
    c.values.set(usize[element], value);
  }

  // The same for Vec3 values (colors, rest positions, displacements)
  pub fn addVec3Channel(self &mut, domain u32, name &[]u8, fill Vec3) u32 {
    imm found = self.findVec3Channel(domain, name);
    if found != NoIndex { return found; }
    imm n = self.domainSize(domain);
    mut values = List[Vec3].withCapacity(n);
    mut i = 0usize;
    while i < n { values.push(fill); i = i + 1usize; }
    vec3s.push(Channel[Vec3][String.from(name), domain, values]);
    u32[vec3s.len() - 1usize];
  }
  pub fn findVec3Channel(self &, domain u32, name &[]u8) u32 {
    mut i = 0usize;
    while i < vec3s.len() {
      if vec3s[i].domain == domain and vec3s[i].name.equals(name) { return u32[i]; }
      i = i + 1usize;
    }
    NoIndex;
  }
  pub fn vec3(self &, channel u32, element u32) Vec3 {*vec3s[usize[channel]].values[usize[element]];}
  pub fn setVec3(self &mut, channel u32, element u32, value Vec3) {
    imm c = &mut vec3s[usize[channel]];
    c.values.set(usize[element], value);
  }

  // Set a corner channel of Vec2 values from values given face by face,
  // corner by corner, in the order the faces' vertices were given (USD's
  // "face-varying" order): how uvs arrive from a file
  pub fn setCornerVec2s(self &mut, channel u32, values &[]Vec2) {
    mut k = 0usize;
    mut f = 0usize;
    while f < fHalfedge.len() {
      imm hs = self.faceHalfedges(u32[f]);
      mut i = 0usize;
      while i < hs.len() and k < values.len {
        self.setVec2(channel, *hs[i], values[k]);
        k = k + 1usize;
        i = i + 1usize;
      }
      f = f + 1usize;
    }
  }

  // -------- checking --------

  // Check every invariant of the half-edge structure, and list what fails,
  // one line each; an empty list means the mesh is sound. It checks: the
  // lists' lengths agree; every link names an element that exists; next and
  // prev undo each other; a half-edge's next stays in its face (or hole) and
  // starts where it ends; no edge joins a vertex to itself; every face has at
  // least 3 corners and its half-edge is its own; each vertex's half-edge
  // leaves it, and is a boundary one if the vertex is on the boundary; each
  // vertex is manifold (the faces about it make one fan, so turning about it
  // from its half-edge meets every edge on it); every channel has a value per
  // element.
  pub fn validate(self &) List[String] {
    mut out = List[String].empty();
    imm nh = hVertex.len();
    imm nv = positions.len();
    imm nf = fHalfedge.len();
    if hNext.len() != nh or hPrev.len() != nh or hFace.len() != nh or nh % 2usize != 0usize {
      out.push(String.from("the half-edge lists differ in length, or are odd"));
      return out;
    }
    if vHalfedge.len() != nv {
      out.push(String.from("the vertex lists differ in length"));
      return out;
    }

    // Every link in range, before any is followed
    mut h = 0usize;
    while h < nh {
      if usize[*hNext[h]] >= nh { out.push(elementProblem("half-edge ", h, ": its next does not exist")); }
      if usize[*hPrev[h]] >= nh { out.push(elementProblem("half-edge ", h, ": its prev does not exist")); }
      if usize[*hVertex[h]] >= nv { out.push(elementProblem("half-edge ", h, ": its vertex does not exist")); }
      if *hFace[h] != NoIndex and usize[*hFace[h]] >= nf {
        out.push(elementProblem("half-edge ", h, ": its face does not exist"));
      }
      h = h + 1usize;
    }
    mut f = 0usize;
    while f < nf {
      if usize[*fHalfedge[f]] >= nh { out.push(elementProblem("face ", f, ": its half-edge does not exist")); }
      f = f + 1usize;
    }
    mut v = 0usize;
    while v < nv {
      imm vh = *vHalfedge[v];
      if vh != NoIndex and usize[vh] >= nh { out.push(elementProblem("vertex ", v, ": its half-edge does not exist")); }
      v = v + 1usize;
    }
    if out.len() > 0usize { return out; }

    // Each half-edge's links
    mut leaving = List[u32].withCapacity(nv);      // per vertex: half-edges leaving it
    mut onBoundary = List[Bool].withCapacity(nv);  // per vertex: a boundary one leaves it
    v = 0usize;
    while v < nv {
      leaving.push(0u32);
      onBoundary.push(false);
      v = v + 1usize;
    }
    h = 0usize;
    while h < nh {
      imm hn = usize[*hNext[h]];
      if usize[*hPrev[hn]] != h { out.push(elementProblem("half-edge ", h, ": its next's prev is not it")); }
      if *hFace[hn] != *hFace[h] { out.push(elementProblem("half-edge ", h, ": its next is in another face")); }
      if *hVertex[usize[twinOf(u32[hn])]] != *hVertex[h] {
        out.push(elementProblem("half-edge ", h, ": its next does not start where it ends"));
      }
      imm from = usize[*hVertex[usize[twinOf(u32[h])]]];
      if h % 2usize == 0usize and usize[*hVertex[h]] == from {
        out.push(elementProblem("edge ", h / 2usize, ": joins a vertex to itself"));
      }
      leaving.set(from, *leaving[from] + 1u32);
      if *hFace[h] == NoIndex { onBoundary.set(from, true); }
      h = h + 1usize;
    }

    // Each face
    f = 0usize;
    while f < nf {
      imm h0 = *fHalfedge[f];
      if *hFace[usize[h0]] != u32[f] {
        out.push(elementProblem("face ", f, ": its half-edge is another face's"));
      } else {
        mut count = 0usize;
        mut hh = h0;
        mut going = true;
        while going {
          count = count + 1usize;
          hh = *hNext[usize[hh]];
          going = hh != h0 and count <= nh;
        }
        if count > nh { out.push(elementProblem("face ", f, ": its half-edges do not come back around")); }
        elif count < 3usize { out.push(elementProblem("face ", f, ": has fewer than 3 corners")); }
      }
      f = f + 1usize;
    }

    // Each vertex
    v = 0usize;
    while v < nv {
      imm vh = *vHalfedge[v];
      if vh == NoIndex {
        if *leaving[v] > 0u32 { out.push(elementProblem("vertex ", v, ": is on edges but has no half-edge")); }
      } elif usize[*hVertex[usize[twinOf(vh)]]] != v {
        out.push(elementProblem("vertex ", v, ": its half-edge does not leave it"));
      } else {
        if *onBoundary[v] and *hFace[usize[vh]] != NoIndex {
          out.push(elementProblem("vertex ", v, ": is on the boundary, but its half-edge is not"));
        }
        mut ring = 0u32;
        mut hh = vh;
        mut going = true;
        while going {
          ring = ring + 1u32;
          hh = twinOf(*hPrev[usize[hh]]);
          going = hh != vh and usize[ring] <= nh;
        }
        if ring != *leaving[v] {
          out.push(elementProblem("vertex ", v, ": is not manifold (its faces are not one fan)"));
        }
      }
      v = v + 1usize;
    }

    // Each channel
    mut c = 0usize;
    while c < floats.len() {
      self.checkChannel(&mut out, floats[c].name.view(), floats[c].domain, floats[c].values.len());
      c = c + 1usize;
    }
    c = 0usize;
    while c < vec2s.len() {
      self.checkChannel(&mut out, vec2s[c].name.view(), vec2s[c].domain, vec2s[c].values.len());
      c = c + 1usize;
    }
    c = 0usize;
    while c < vec3s.len() {
      self.checkChannel(&mut out, vec3s[c].name.view(), vec3s[c].domain, vec3s[c].values.len());
      c = c + 1usize;
    }
    out;
  }

  fn checkChannel(self &, out &mut List[String], name &[]u8, domain u32, len usize) {
    imm want = self.domainSize(domain);
    if len != want {
      mut s = String.from("channel ");
      s.append(name);
      s.append(": has ");
      s.appendUInt(u64[len]);
      s.append(" values for ");
      s.appendUInt(u64[want]);
      s.append(" elements");
      out.push(s);
    }
  }

  // -------- to triangles --------

  // The mesh as triangles, one way. Each face is cut into triangles: a
  // triangle as it is; a convex polygon as a fan from its first corner (0, 1,
  // 2), (0, 2, 3), ...; any other by ear clipping (geomath's
  // 'triangulatePolygon') in its best-fit plane, the plane of its Newell
  // normal. An n-cornered face gives n - 2 triangles, counterclockwise about
  // the face's normal as the face is.
  //
  // With 'smooth' false, every corner is its own vertex with its face's
  // normal (flat shading). With 'smooth' true, corners at one vertex share a
  // vertex whose normal is 'vertexNormals''s, unless their uvs differ: a uv
  // seam splits the vertex, one copy per distinct uv. The uvs are the corner
  // channel of Vec2 named "uv", when there is one; without one, no uvs.
  pub fn triangulate(self &, smooth Bool) Mesh {
    mut out = Mesh.empty();
    imm uvCh = self.findVec2Channel(CornerDomain, "uv");
    imm hasUv = uvCh != NoIndex;
    imm nv = positions.len();
    // Smooth: the vertices made for each mesh vertex, chained
    mut vFirst = List[u32].withCapacity(nv);
    mut oNext = List[u32].empty();
    mut vnormals = List[Vec3].empty();
    if smooth {
      vnormals = self.vertexNormals();
      mut v = 0usize;
      while v < nv { vFirst.push(NoIndex); v = v + 1usize; }
    }
    mut made = List[u32].empty();      // each corner of the face: its vertex in 'out'
    mut tris = List[u32].empty();
    mut f = 0usize;
    while f < fHalfedge.len() {
      imm hs = self.faceHalfedges(u32[f]);
      imm fnormal = self.faceNormal(u32[f]);
      made.clear();
      mut i = 0usize;
      while i < hs.len() {
        imm h = *hs[i];
        imm v = *hVertex[usize[h]];
        imm uv = if hasUv {self.vec2(uvCh, h);} else {Vec2[0., 0.];};
        mut found = NoIndex;
        if smooth {
          mut o = *vFirst[usize[v]];
          while o != NoIndex and found == NoIndex {
            if !hasUv or sameVec2(*out.uvs[usize[o]], uv) { found = o; }
            o = *oNext[usize[o]];
          }
        }
        if found == NoIndex {
          found = u32[out.positions.len()];
          out.positions.push(*positions[usize[v]]);
          if smooth { out.normals.push(*vnormals[usize[v]]); } else { out.normals.push(fnormal); }
          if hasUv { out.uvs.push(uv); }
          if smooth {
            oNext.push(*vFirst[usize[v]]);
            vFirst.set(usize[v], found);
          } else {
            oNext.push(NoIndex);
          }
        }
        made.push(found);
        i = i + 1usize;
      }
      tris.clear();
      self.cutFace(u32[f], &mut tris);
      i = 0usize;
      while i < tris.len() {
        out.indices.push(*made[usize[*tris[i]]]);
        i = i + 1usize;
      }
      f = f + 1usize;
    }
    out;
  }

  // Cut face f into triangles, as corner numbers of the face (0 its first),
  // three to a triangle
  pub fn cutFace(self &, f u32, tris &mut List[u32]) {
    imm pts = self.facePositions(f);
    imm n = pts.len();
    if n < 3usize { return; }
    if n == 3usize {
      tris.push(0u32); tris.push(1u32); tris.push(2u32);
      return;
    }
    // Into the best-fit plane: u and w across it, u x w its normal
    imm nrm = unitOrZero(newellNormal(&pts));
    imm u = if fabs32(nrm.x) > fabs32(nrm.z) {unitOrZero(Vec3[-nrm.y, nrm.x, 0.]);}
      else {unitOrZero(Vec3[0., -nrm.z, nrm.y]);};
    imm w = nrm.cross(u);
    imm origin = *pts[0usize];
    mut flat = List[Vec2].withCapacity(n);
    mut i = 0usize;
    while i < n {
      imm d = *pts[i] - origin;
      flat.push(Vec2[d.dot(u), d.dot(w)]);
      i = i + 1usize;
    }
    // Convex: every corner turns left
    mut convex = true;
    i = 0usize;
    while i < n {
      imm a = *flat[(i + n - 1usize) % n];
      imm b = *flat[i];
      imm c = *flat[(i + 1usize) % n];
      if (b - a).cross(c - b) <= 0. { convex = false; }
      i = i + 1usize;
    }
    if convex {
      i = 1usize;
      while i + 1usize < n {
        tris.push(0u32); tris.push(u32[i]); tris.push(u32[i + 1usize]);
        i = i + 1usize;
      }
    } else {
      imm cut = triangulatePolygon(flat.view());
      i = 0usize;
      while i < cut.len() {
        tris.push(*cut[i]);
        i = i + 1usize;
      }
    }
  }

  // A cube centred at the origin, reaching 'size' along each axis each way, as
  // a cage of six quads: 8 vertices, 12 edges, 24 half-edges, closed. Vertex
  // x + 2y + 4z, each of x, y, z 0 for -size and 1 for +size, so vertex 0 is
  // (-size, -size, -size) and 7 (size, size, size). The faces, each
  // counterclockwise seen from outside: back (0, 2, 3, 1), front (4, 5, 7,
  // 6), left (0, 4, 6, 2), right (1, 3, 7, 5), bottom (0, 1, 5, 4), top (2,
  // 6, 7, 3).
  pub fn cube(size f32) PolyMesh {
    mut pts = List[Vec3].withCapacity(8usize);
    mut v = 0u32;
    while v < 8u32 {
      imm x = if (v & 1u32) != 0u32 {size;} else {-size;};
      imm y = if (v & 2u32) != 0u32 {size;} else {-size;};
      imm z = if (v & 4u32) != 0u32 {size;} else {-size;};
      pts.push(Vec3[x, y, z]);
      v = v + 1u32;
    }
    imm counts [6; u32] = [4u32, 4u32, 4u32, 4u32, 4u32, 4u32];
    mut problems = List[String].empty();
    PolyMesh.fromPolygons(pts.view(), &counts, &cageFaces, &mut problems);
  }
}

imm cageFaces [24; u32] = [0u32, 2u32, 3u32, 1u32,  4u32, 5u32, 7u32, 6u32,  0u32, 4u32, 6u32, 2u32,
  1u32, 3u32, 7u32, 5u32,  0u32, 1u32, 5u32, 4u32,  2u32, 6u32, 7u32, 3u32];

// Whether a face, the vertices 'vs', can be added to the mesh being built;
// if not, a line saying why goes to 'problems'. (A module function, not a
// method: a private method is refused when called on another PolyMesh from
// within PolyMesh's own methods.)
fn faceFits(m &PolyMesh, f usize, vs &[]u32, nv usize, outHead &List[u32], outNext &List[u32],
    problems &mut List[String]) Bool {
  imm n = vs.len;
  if n < 3usize {
    problems.push(faceProblem(f, "has fewer than 3 corners"));
    return false;
  }
  mut i = 0usize;
  while i < n {
    if usize[vs[i]] >= nv {
      mut s = faceProblem(f, "names vertex ");
      s.appendUInt(u64[vs[i]]);
      s.append(", which does not exist");
      problems.push(s);
      return false;
    }
    mut j = i + 1usize;
    while j < n {
      if vs[i] == vs[j] {
        mut s = faceProblem(f, "has vertex ");
        s.appendUInt(u64[vs[i]]);
        s.append(" twice");
        problems.push(s);
        return false;
      }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < n {
    imm a = vs[i];
    imm b = vs[(i + 1usize) % n];
    imm h = findHalfedge(&m.hVertex, outHead, outNext, a, b);
    if h != NoIndex and *m.hFace[usize[h]] != NoIndex {
      mut s = faceProblem(f, "runs from vertex ");
      s.appendUInt(u64[a]);
      s.append(" to ");
      s.appendUInt(u64[b]);
      s.append(", as another face already does");
      problems.push(s);
      return false;
    }
    i = i + 1usize;
  }
  true;
}

// Link the boundary half-edges into loops, and give each vertex its
// half-edge. A boundary half-edge ending at v is followed by the boundary
// half-edge leaving v that is reached by turning about v through faces from
// its twin, so each fan of faces about a vertex closes on itself.
fn linkBoundary(m &mut PolyMesh) {
  imm nh = m.hVertex.len();
  mut h = 0usize;
  while h < nh {
    if *m.hFace[h] == NoIndex {
      mut g = twinOf(u32[h]);
      mut steps = 0usize;
      mut going = true;
      while going and steps < nh {
        imm t = twinOf(*m.hPrev[usize[g]]);
        if *m.hFace[usize[t]] == NoIndex {
          m.hNext.set(h, t);
          m.hPrev.set(usize[t], u32[h]);
          going = false;
        } else {
          g = t;
        }
        steps = steps + 1usize;
      }
    }
    h = h + 1usize;
  }
  // Each vertex: the first half-edge leaving it, or a boundary one if any
  h = 0usize;
  while h < nh {
    imm from = usize[*m.hVertex[usize[twinOf(u32[h])]]];
    imm cur = *m.vHalfedge[from];
    if cur == NoIndex or (*m.hFace[h] == NoIndex and *m.hFace[usize[cur]] != NoIndex) {
      m.vHalfedge.set(from, u32[h]);
    }
    h = h + 1usize;
  }
}

// A half-edge's twin: the other of its pair
fn twinOf(h u32) u32 {h ^ 1u32;}

fn fabs32(a f32) f32 {if a < 0. {-a;} else {a;};}

// Two uvs exactly equal: a seam is where corners' uvs differ at all
fn sameVec2(a Vec2, b Vec2) Bool {a.x == b.x and a.y == b.y;}

// The half-edge from a to b, or NoIndex, while building: each vertex's
// half-edges leaving it are chained through 'outNext' from 'outHead'
fn findHalfedge(hVertex &List[u32], outHead &List[u32], outNext &List[u32], a u32, b u32) u32 {
  mut h = *outHead[usize[a]];
  while h != NoIndex {
    if *hVertex[usize[h]] == b { return h; }
    h = *outNext[usize[h]];
  }
  NoIndex;
}

// "face 3: ..." begun, for a problem line
fn faceProblem(f usize, what &[]u8) String {
  mut s = String.from("face ");
  s.appendUInt(u64[f]);
  s.append(": ");
  s.append(what);
  s;
}

// "half-edge 5: ...", "vertex 2: ...", and so on
fn elementProblem(kind &[]u8, n usize, what &[]u8) String {
  mut s = String.from(kind);
  s.appendUInt(u64[n]);
  s.append(what);
  s;
}

// ======== Wavefront .obj ========

// A mesh as .obj text: a 'v' line per position, a 'vt' per uv and a 'vn' per
// normal when it has them, then an 'f' line per triangle naming each corner's
// position, uv and normal, 'f 1/1/1 2/2/2 3/3/3' (numbered from 1; 'f 1//1'
// without uvs, 'f 1/1' without normals, 'f 1' with neither). A mesh with
// material groups gets a 'usemtl material<slot>' line before each group's
// triangles. Numbers are written with six decimal places.
pub fn meshObjText overload objText(m &Mesh) String {
  mut s = String.empty();
  imm n = m.positions.len();
  imm hasUv = n > 0usize and m.uvs.len() == n;
  imm hasNormal = n > 0usize and m.normals.len() == n;
  mut i = 0usize;
  while i < n {
    imm p = *m.positions[i];
    s.append("v ");
    appendVec3(&mut s, p);
    s.appendByte('\n');
    i = i + 1usize;
  }
  if hasUv {
    i = 0usize;
    while i < n {
      imm t = *m.uvs[i];
      s.append("vt ");
      appendFixed(&mut s, t.x);
      s.appendByte(' ');
      appendFixed(&mut s, t.y);
      s.appendByte('\n');
      i = i + 1usize;
    }
  }
  if hasNormal {
    i = 0usize;
    while i < n {
      s.append("vn ");
      appendVec3(&mut s, *m.normals[i]);
      s.appendByte('\n');
      i = i + 1usize;
    }
  }
  if m.groups.len() == 0usize {
    objFaces(&mut s, m, 0usize, m.indices.len(), hasUv, hasNormal);
  } else {
    mut g = 0usize;
    while g < m.groups.len() {
      imm grp = *m.groups[g];
      s.append("usemtl material");
      s.appendUInt(u64[grp.material]);
      s.appendByte('\n');
      objFaces(&mut s, m, usize[grp.start], usize[grp.start] + usize[grp.count], hasUv, hasNormal);
      g = g + 1usize;
    }
  }
  s;
}

// The 'f' lines for the triangles among indices 'from' to 'to'
fn objFaces(s &mut String, m &Mesh, from usize, to usize, hasUv Bool, hasNormal Bool) {
  mut t = from;
  while t + 3usize <= to and t + 3usize <= m.indices.len() {
    s.append("f");
    mut k = 0usize;
    while k < 3usize {
      imm idx = u64[*m.indices[t + k]] + 1u64;
      s.appendByte(' ');
      s.appendUInt(idx);
      if hasUv or hasNormal {
        s.appendByte('/');
        if hasUv { s.appendUInt(idx); }
        if hasNormal {
          s.appendByte('/');
          s.appendUInt(idx);
        }
      }
      k = k + 1usize;
    }
    s.appendByte('\n');
    t = t + 3usize;
  }
}

// A polygon mesh as .obj text: a 'v' line per vertex, then an 'f' line per
// face with all its corners, 'f 1 3 4 2'. With a corner "uv" channel, a 'vt'
// line per corner of each face, in face order, and 'f 1/1 3/2 4/3 2/4'.
pub fn polyObjText overload objText(m &PolyMesh) String {
  mut s = String.empty();
  mut i = 0usize;
  while i < m.positions.len() {
    s.append("v ");
    appendVec3(&mut s, *m.positions[i]);
    s.appendByte('\n');
    i = i + 1usize;
  }
  imm uvCh = m.findVec2Channel(CornerDomain, "uv");
  imm hasUv = uvCh != NoIndex;
  if hasUv {
    mut f = 0usize;
    while f < m.fHalfedge.len() {
      imm hs = m.faceHalfedges(u32[f]);
      mut k = 0usize;
      while k < hs.len() {
        imm t = m.vec2(uvCh, *hs[k]);
        s.append("vt ");
        appendFixed(&mut s, t.x);
        s.appendByte(' ');
        appendFixed(&mut s, t.y);
        s.appendByte('\n');
        k = k + 1usize;
      }
      f = f + 1usize;
    }
  }
  mut corner = 0u64;
  mut f = 0usize;
  while f < m.fHalfedge.len() {
    imm vs = m.faceVertices(u32[f]);
    s.append("f");
    mut k = 0usize;
    while k < vs.len() {
      s.appendByte(' ');
      s.appendUInt(u64[*vs[k]] + 1u64);
      if hasUv {
        corner = corner + 1u64;
        s.appendByte('/');
        s.appendUInt(corner);
      }
      k = k + 1usize;
    }
    s.appendByte('\n');
    f = f + 1usize;
  }
  s;
}

// Write a mesh's .obj text to the file at 'path', replacing it; false if the
// file could not be written
pub fn meshWriteObj overload writeObj(m &Mesh, path &[]u8) Bool {
  imm text = objText(m);
  writeFile(path, text.view());
}
pub fn polyWriteObj overload writeObj(m &PolyMesh, path &[]u8) Bool {
  imm text = objText(m);
  writeFile(path, text.view());
}

// The whole of 'text' into the file at 'path'
fn writeFile(path &[]u8, text &[]u8) Bool {
  mut cpath = String.from(path);
  imm f = libc.fopen(cpath.cstr(), &"wb" as *u8);
  if !f { return false; }
  mut wrote = 0usize;
  if text.len > 0usize { wrote = libc.fwrite(&text[0], 1usize, text.len, f); }
  imm closed = libc.fclose(f);
  wrote == text.len and closed == 0;
}

// "x y z", each with six decimal places
fn appendVec3(s &mut String, p Vec3) {
  appendFixed(s, p.x);
  s.appendByte(' ');
  appendFixed(s, p.y);
  s.appendByte(' ');
  appendFixed(s, p.z);
}

// A number with six decimal places, rounded, as C's '%f' writes it: '0.100000',
// '-2.500000'; a value that rounds to zero has no sign. NaN and infinity are
// written 'nan', 'inf' and '-inf', which no .obj reader accepts.
fn appendFixed(s &mut String, value f32) {
  imm v = f64[value];
  if v != v { s.append("nan"); return; }
  imm mag = if v < 0d {-v;} else {v;};
  if mag - mag != 0d {
    if v < 0d { s.append("-inf"); } else { s.append("inf"); }
    return;
  }
  if mag < 9000000000000d {
    imm n = u64[mag * 1000000d + 0.5d];
    if v < 0d and n > 0u64 { s.appendByte('-'); }
    s.appendUInt(n / 1000000u64);
    s.appendByte('.');
    imm frac = n % 1000000u64;
    mut pad = 100000u64;
    while pad > 1u64 and frac < pad {
      s.appendByte('0');
      pad = pad / 10u64;
    }
    s.appendUInt(frac);
  } else {
    // Past what a u64 of millionths holds: the leading digits, then zeros
    // (an f32 has no more than 8 significant digits)
    mut m = mag;
    mut zeros = 0usize;
    while m >= 9000000000000d {
      m = m / 10d;
      zeros = zeros + 1usize;
    }
    if v < 0d { s.appendByte('-'); }
    s.appendUInt(u64[m]);
    while zeros > 0usize {
      s.appendByte('0');
      zeros = zeros - 1usize;
    }
    s.append(".000000");
  }
}
