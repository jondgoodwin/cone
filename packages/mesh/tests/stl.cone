// STL files, checked with the testing package against numbers worked out by
// hand; only a failure prints, so stl.out holds the summary alone.
//
// The cube: vertices v = x + 2y + 4z at (x, y, z) in {0, 1}, twelve outward
// triangles, two a face, in the order -z, +z, -y, +y, -x, +x:
//   (0 2 1) (1 2 3)  (4 5 6) (5 7 6)  (0 1 4) (1 5 4)
//   (2 6 3) (3 6 7)  (0 4 2) (2 4 6)  (1 3 5) (3 7 5)
// each checked once against the right-hand rule (a face's two triangles'
// normals are the face's). The file's twelve triangles name 36 corners at 8
// positions: welded, 8 vertices, 12 triangles. The vertices are numbered by
// the first corner that names them, so the cube above is numbered 0, 2, 1, 3,
// 4, 5, 6, 7 by that order: the mesh read back has its original's vertex k
// where the cube's vertex 0 2 1 3 4 5 6 7 [k] is, and 'cube()' below builds
// that numbering, so a write and a read give the same bits (meshHash equal,
// indices equal).
//
// - Binary: 84 + 50 x 12 = 684 bytes; the count word at byte 80 is 12; the
//   first triangle's stored normal is (0, 0, -1) (triangle 0 2 1).
// - The same bytes with "solid" written over the header's first five are
//   still binary (684 = 84 + 50 x 12).
// - ASCII: 'vertex x y z' lines, 36, welded to the same 8 and 12.
// - Welded by position, -0 and 0 equal: a triangle (0 0 0) (1 0 0) (0 1 0)
//   and another (-0 0 0) (0 0 1) (0 1 0) share (0 0 0) and (0 1 0): 4 vertices.
// - Refused: 10 bytes (too short, not "solid"); a binary count of 5 with 84
//   bytes; ASCII with 4 vertex lines; a binary triangle with an infinite
//   coordinate (11 triangles read, one problem).

mod stl;

import testing use *;
import libc;
import collections use *;
import geomath use *;
import mesh use *;
import path use Path;

// The cube's triangles by the cube's own vertex numbers
fn cubeTriangles() List[u32] {
  let t = [0u32, 2u32, 1u32, 1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 5u32, 7u32, 6u32,
    0u32, 1u32, 4u32, 1u32, 5u32, 4u32, 2u32, 6u32, 3u32, 3u32, 6u32, 7u32,
    0u32, 4u32, 2u32, 2u32, 4u32, 6u32, 1u32, 3u32, 5u32, 3u32, 7u32, 5u32];
  var out = List[u32]();
  var i = 0usize;
  while i < 36usize { out.push(t[i]); i = i + 1usize; }
  out
}

fn cornerOf(v: u32) Vec3 {
  Vec3(f32.from(v & 1u32), f32.from((v >> 1u32) & 1u32), f32.from((v >> 2u32) & 1u32))
}

// The cube with its vertices numbered by first use
fn cube() Mesh {
  var m = Mesh();
  let tris = cubeTriangles();
  var number = Array[u32, 8]() <- fill 99u32;
  var i = 0usize;
  while i < 36usize {
    let v = *tris[i];
    if number[usize.from(v)] == 99u32 {
      number[usize.from(v)] = u32.from(m.positions.len());
      m.positions.push(cornerOf(v));
    }
    m.indices.push(number[usize.from(v)]);
    i = i + 1usize;
  }
  m
}

fn appendVertex(s: &mut String, p: Vec3) {
  s.append("vertex ");
  s.appendInt(i64.from(p.x));
  s.append(" ");
  s.appendInt(i64.from(p.y));
  s.append(" ");
  s.appendInt(i64.from(p.z));
  s.append("\n");
}

fn same(a: &Mesh, b: &Mesh, label: &Array[u8]) {
  expectInt(i64.from(a.positions.len()), i64.from(b.positions.len()), label);
  expectInt(i64.from(a.indices.len()), i64.from(b.indices.len()), label);
  expectUInt(u64.from(meshHash(a)), u64.from(meshHash(b)), label);
  var i = 0usize;
  var ok = a.indices.len() == b.indices.len();
  while ok && i < a.indices.len() {
    if *a.indices[i] != *b.indices[i] { ok = false; }
    i = i + 1usize;
  }
  expect(ok, label);
}

fn roundTrip() {
  let m = cube();
  expectInt(i64.from(m.positions.len()), 8, "the cube has 8 vertices");
  expectInt(i64.from(m.indices.len()), 36, "the cube has 12 triangles");
  let bytes = stlBytes(&m);
  expectInt(i64.from(bytes.len()), 684, "binary: 84 + 50 x 12 bytes");
  expectInt(i64.from(bytes[80usize]), 12, "binary: the count word");
  expectInt(i64.from(bytes[81usize]), 0, "binary: the count word's high bytes");
  // The first triangle (0 2 1) has the normal (0, 0, -1): its z is -1.0 = 0xBF800000, little-endian at 84 + 8
  expectInt(i64.from(bytes[84usize + 11usize]), 0xBF, "binary: the first normal's z, high byte");
  expectInt(i64.from(bytes[84usize + 10usize]), 0x80, "binary: the first normal's z, next byte");
  var problems = List[String]();
  let back = meshFromStl(bytes.view(), &mut problems);
  expectInt(i64.from(problems.len()), 0, "binary: no problems");
  same(&m, &back, "binary: the cube comes back as it went");
  // "solid" over the header: still binary, by its length
  var tricky = List[u8]();
  var i = 0usize;
  while i < bytes.len() {
    tricky.push(*bytes[i]);
    i = i + 1usize;
  }
  tricky.set(0usize, 115u8);
  tricky.set(1usize, 111u8);
  tricky.set(2usize, 108u8);
  tricky.set(3usize, 105u8);
  tricky.set(4usize, 100u8);
  let again = meshFromStl(tricky.view(), &mut problems);
  same(&m, &again, "a binary file whose header says solid is still binary");
  // Through a file
  expect(writeStl(&m, "cube-w77.stl"), "the file is written");
  let named = Path.from("cube-w77.stl");
  let fromFile = readStl(&named, &mut problems);
  libc.remove("cube-w77.stl");
  same(&m, &fromFile, "a file written and read is the same mesh");
  expectInt(i64.from(problems.len()), 0, "the file round trip has no problems");
  expectBool(writeStl(&m, "no such folder/cube.stl"), false, "a file that cannot be made");
  let missing = Path.from("no such folder/cube.stl");
  let none = readStl(&missing, &mut problems);
  expectInt(i64.from(none.indices.len()), 0, "a file that cannot be opened is an empty mesh");
  expectInt(i64.from(problems.len()), 1, "and is said so once");
}

fn ascii() {
  var s = String.from("solid cube\n");
  let tris = cubeTriangles();
  var t = 0usize;
  while t < 12usize {
    s.append("facet normal 0 0 0\nouter loop\n");
    var k = 0usize;
    while k < 3usize {
      appendVertex(&mut s, cornerOf(*tris[3usize * t + k]));
      k = k + 1usize;
    }
    s.append("endloop\nendfacet\n");
    t = t + 1usize;
  }
  s.append("endsolid cube\n");
  var problems = List[String]();
  let m = meshFromStl(s.view(), &mut problems);
  expectInt(i64.from(problems.len()), 0, "ASCII: no problems");
  expectInt(i64.from(m.positions.len()), 8, "ASCII: 36 corners weld to 8 vertices");
  expectInt(i64.from(m.indices.len() / 3usize), 12, "ASCII: 12 triangles");
  same(&m, &cube(), "ASCII: the same mesh as the binary cube's");
}

fn welding() {
  // Two triangles sharing (0, 0, 0) and (0, 1, 0), one writing the first as -0
  var s = String.from("solid two\n");
  s.append("vertex 0 0 0\nvertex 1 0 0\nvertex 0 1 0\n");
  s.append("vertex -0 0 0\nvertex 0 0 1\nvertex 0 1 0\n");
  s.append("endsolid\n");
  var problems = List[String]();
  let m = meshFromStl(s.view(), &mut problems);
  expectInt(i64.from(m.positions.len()), 4, "-0 and 0 weld: 4 vertices");
  expectInt(i64.from(m.indices.len()), 6, "two triangles");
  expectInt(i64.from(*m.indices[3usize]), 0, "the second triangle's first corner is vertex 0");
  expectInt(i64.from(*m.indices[4usize]), 3, "its second corner is the new vertex 3");
  expectInt(i64.from(*m.indices[5usize]), 2, "its third corner is vertex 2");
}

fn refused() {
  var problems = List[String]();
  var small = List[u8]();
  var i = 0usize;
  while i < 10usize { small.push(7u8); i = i + 1usize; }
  let a = meshFromStl(small.view(), &mut problems);
  expectInt(i64.from(a.indices.len()), 0, "10 bytes: an empty mesh");
  expectInt(i64.from(problems.len()), 1, "10 bytes: one problem");
  // Count 5, only the 84 bytes
  var head = List[u8]();
  i = 0usize;
  while i < 84usize { head.push(0u8); i = i + 1usize; }
  head.set(80usize, 5u8);
  let b = meshFromStl(head.view(), &mut problems);
  expectInt(i64.from(b.indices.len()), 0, "a count past the bytes: an empty mesh");
  expectInt(i64.from(problems.len()), 2, "a count past the bytes: a problem");
  let c = meshFromStl("solid x\nvertex 0 0 0\nvertex 1 0 0\nvertex 0 1 0\nvertex 1 1 1\nendsolid\n", &mut problems);
  expectInt(i64.from(c.indices.len()), 0, "4 vertex lines: an empty mesh");
  expectInt(i64.from(problems.len()), 3, "4 vertex lines: a problem");
  // An infinite coordinate in the last of 12 triangles
  let good = stlBytes(&cube());
  var bad = List[u8]();
  i = 0usize;
  while i < good.len() { bad.push(*good[i]); i = i + 1usize; }
  // Triangle 11's second corner x: 84 + 50 x 11 + 12 + 12 = 658; +inf is 00 00 80 7F
  bad.set(658usize, 0u8);
  bad.set(659usize, 0u8);
  bad.set(660usize, 128u8);
  bad.set(661usize, 127u8);
  let d = meshFromStl(bad.view(), &mut problems);
  expectInt(i64.from(d.indices.len() / 3usize), 11, "an infinite coordinate leaves its triangle out");
  expectInt(i64.from(problems.len()), 4, "and is one problem");
}

fn main() i32 {
  roundTrip();
  ascii();
  welding();
  refused();
  done()
}
