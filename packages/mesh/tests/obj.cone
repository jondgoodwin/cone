// Wavefront .obj text and files, checked with the testing package against
// text written out by hand; only a failure prints, so obj.out holds the
// summary alone.
//
// Numbers have six decimal places, as C's '%f' writes them: 0.1 as an f32 is
// 0.100000001490116..., which rounds to '0.100000'; -0 has no sign. Indices
// count from 1, and a corner names its position, uv and normal by the same
// number, since a Mesh's vertex carries all three.

mod obj;

import testing use *;
import libc;
import collections use *;
import geomath use *;
import mesh use *;
import path use Path;

// What a file holds, read back with the C library
fn fileText(name cstr) String {
  mut out = String.empty();
  mut buf = new Array[u8, 4096] <- fill 0u8;
  imm f = libc.fopen(name, "rb");
  if f {
    imm n = libc.fread(&mut buf[0], 1usize, 4096usize, f);
    libc.fclose(f);
    out.appendBytes(&buf[..n]);
  }
  out;
}

fn tri() Mesh {
  mut m = Mesh.empty();
  m.positions.push(new Vec3(0., 0., 0.));
  m.positions.push(new Vec3(1., 0., 0.));
  m.positions.push(new Vec3(0., 1., 0.));
  m.indices.push(0u32);
  m.indices.push(1u32);
  m.indices.push(2u32);
  m;
}

fn triangle() {
  mut m = tri();
  m.normals.push(new Vec3(0., 0., 1.));
  m.normals.push(new Vec3(0., 0., 1.));
  m.normals.push(new Vec3(0., 0., 1.));
  m.uvs.push(new Vec2(0., 0.));
  m.uvs.push(new Vec2(1., 0.));
  m.uvs.push(new Vec2(0., 1.));
  imm text = objText(&m);
  expectStr(text.view(),
    "v 0.000000 0.000000 0.000000\nv 1.000000 0.000000 0.000000\nv 0.000000 1.000000 0.000000\nvt 0.000000 0.000000\nvt 1.000000 0.000000\nvt 0.000000 1.000000\nvn 0.000000 0.000000 1.000000\nvn 0.000000 0.000000 1.000000\nvn 0.000000 0.000000 1.000000\nf 1/1/1 2/2/2 3/3/3\n",
    "a triangle with uvs and normals");

  // The same file, written and read back
  expect(writeObj(&m, "triangle.obj"), "the file is written");
  mut buf = new Array[u8, 1024] <- fill 0u8;
  imm f = libc.fopen("triangle.obj", "rb");
  mut n = 0usize;
  if f {
    n = libc.fread(&mut buf[0], 1usize, 1024usize, f);
    libc.fclose(f);
  }
  expectStr(&buf[0usize..n], text.view(), "the file holds the text");
  expectBool(writeObj(&m, "no such folder/triangle.obj"), false, "a file that cannot be made");

  // A Path in a variable is lent, not given away: it is as it was after the call
  imm named = Path.from("triangle-path.obj");
  expect(writeObj(&m, &named), "a Path variable names the file");
  expectStr(named.view(), "triangle-path.obj", "and is unchanged by the write");
  imm back = fileText("triangle-path.obj");
  expectStr(back.view(), text.view(), "the file holds the text");
  libc.remove("triangle-path.obj");
  imm missing = Path.from("no such folder/triangle-path.obj");
  expectBool(writeObj(&m, &missing), false, "a Path to a file that cannot be made");
  expectStr(missing.view(), "no such folder/triangle-path.obj", "and is unchanged by the failure");
}

fn numbers() {
  mut m = Mesh.empty();
  m.positions.push(new Vec3(-0.5, 0.1, 1234.5));
  m.positions.push(new Vec3(0.25, -0., 2.));
  m.positions.push(new Vec3(0., 0.0000004, -3.0000006));
  m.indices.push(0u32);
  m.indices.push(1u32);
  m.indices.push(2u32);
  imm text = objText(&m);
  expectStr(text.view(),
    "v -0.500000 0.100000 1234.500000\nv 0.250000 0.000000 2.000000\nv 0.000000 0.000000 -3.000001\nf 1 2 3\n",
    "positions alone, and how numbers are written");
}

fn partial() {
  mut n = tri();
  n.normals.push(new Vec3(0., 0., 1.));
  n.normals.push(new Vec3(0., 0., 1.));
  n.normals.push(new Vec3(0., 0., 1.));
  imm nt = objText(&n);
  expectStr(nt.view(),
    "v 0.000000 0.000000 0.000000\nv 1.000000 0.000000 0.000000\nv 0.000000 1.000000 0.000000\nvn 0.000000 0.000000 1.000000\nvn 0.000000 0.000000 1.000000\nvn 0.000000 0.000000 1.000000\nf 1//1 2//2 3//3\n",
    "normals without uvs");
  mut u = tri();
  u.uvs.push(new Vec2(0., 0.));
  u.uvs.push(new Vec2(1., 0.));
  u.uvs.push(new Vec2(0., 1.));
  imm ut = objText(&u);
  expectStr(ut.view(),
    "v 0.000000 0.000000 0.000000\nv 1.000000 0.000000 0.000000\nv 0.000000 1.000000 0.000000\nvt 0.000000 0.000000\nvt 1.000000 0.000000\nvt 0.000000 1.000000\nf 1/1 2/2 3/3\n",
    "uvs without normals");
}

fn groups() {
  mut m = Mesh.empty();
  m.positions.push(new Vec3(0., 0., 0.));
  m.positions.push(new Vec3(1., 0., 0.));
  m.positions.push(new Vec3(1., 1., 0.));
  m.positions.push(new Vec3(0., 1., 0.));
  m.indices.push(0u32); m.indices.push(1u32); m.indices.push(2u32);
  m.indices.push(0u32); m.indices.push(2u32); m.indices.push(3u32);
  m.addGroup(0u32, 3u32, 2u32);
  m.addGroup(3u32, 3u32, 5u32);
  imm text = objText(&m);
  expectStr(text.view(),
    "v 0.000000 0.000000 0.000000\nv 1.000000 0.000000 0.000000\nv 1.000000 1.000000 0.000000\nv 0.000000 1.000000 0.000000\nusemtl material2\nf 1 2 3\nusemtl material5\nf 1 3 4\n",
    "material groups");
}

fn polygons() {
  // Two quads side by side, (0, 1, 4, 3) and (1, 2, 5, 4)
  imm pts Array[Vec3, 6] = [new Vec3(0., 0., 0.), new Vec3(1., 0., 0.), new Vec3(2., 0., 0.), new Vec3(0., 1., 0.),
    new Vec3(1., 1., 0.), new Vec3(2., 1., 0.)];
  imm counts Array[u32, 2] = [4u32, 4u32];
  imm idx Array[u32, 8] = [0u32, 1u32, 4u32, 3u32, 1u32, 2u32, 5u32, 4u32];
  mut built = List[String].empty();
  mut p = PolyMesh.fromPolygons(&pts, &counts, &idx, &mut built);
  imm plain = objText(&p);
  expectStr(plain.view(),
    "v 0.000000 0.000000 0.000000\nv 1.000000 0.000000 0.000000\nv 2.000000 0.000000 0.000000\nv 0.000000 1.000000 0.000000\nv 1.000000 1.000000 0.000000\nv 2.000000 1.000000 0.000000\nf 1 2 5 4\nf 2 3 6 5\n",
    "polygons as n-gons");

  imm ch = p.addVec2Channel(CornerDomain, "uv", new Vec2(0., 0.));
  imm uvs Array[Vec2, 8] = [new Vec2(0., 0.), new Vec2(0.5, 0.), new Vec2(0.5, 1.), new Vec2(0., 1.),
    new Vec2(0.5, 0.), new Vec2(1., 0.), new Vec2(1., 1.), new Vec2(0.5, 1.)];
  p.setCornerVec2s(ch, &uvs);
  imm withUv = objText(&p);
  expectStr(withUv.view(),
    "v 0.000000 0.000000 0.000000\nv 1.000000 0.000000 0.000000\nv 2.000000 0.000000 0.000000\nv 0.000000 1.000000 0.000000\nv 1.000000 1.000000 0.000000\nv 2.000000 1.000000 0.000000\nvt 0.000000 0.000000\nvt 0.500000 0.000000\nvt 0.500000 1.000000\nvt 0.000000 1.000000\nvt 0.500000 0.000000\nvt 1.000000 0.000000\nvt 1.000000 1.000000\nvt 0.500000 1.000000\nf 1/1 2/2 5/3 4/4\nf 2/5 3/6 6/7 5/8\n",
    "polygons with corner uvs");

  // A PolyMesh is written by a literal and by a Path variable alike
  expect(writeObj(&p, "polygons-literal.obj"), "a polygon mesh written to a literal's path");
  imm fromLiteral = fileText("polygons-literal.obj");
  expectStr(fromLiteral.view(), withUv.view(), "the file holds the polygons' text");
  libc.remove("polygons-literal.obj");
  imm named = Path.from("polygons-path.obj");
  expect(writeObj(&p, &named), "a polygon mesh written to a Path variable's file");
  expectStr(named.view(), "polygons-path.obj", "and the Path is unchanged by the write");
  imm fromPath = fileText("polygons-path.obj");
  expectStr(fromPath.view(), withUv.view(), "the file holds the polygons' text");
  libc.remove("polygons-path.obj");
}

fn main() i32 {
  triangle();
  numbers();
  partial();
  groups();
  polygons();
  done();
}
