// PolyMesh.triangulate and the normals of a Mesh, checked with the testing
// package against values worked out by hand; only a failure prints, so
// triangulate.out holds the summary alone.
//
// Counts: a face of n corners gives n - 2 triangles. A convex face is a fan
// from its first corner, so a quad's corners 0, 1, 2, 3 give (0, 1, 2),
// (0, 2, 3), and a regular heptagon (0, 1, 2), (0, 2, 3), ... (0, 5, 6).
//
// The L-shaped hexagon (2,1) (1,1) (1,2) (0,2) (0,0) (2,0), counterclockwise
// about +z, area 3 (a 2 by 2 square less a 1 by 1 one), is not convex: its
// corner at (1,1) turns right. A fan from its first corner would be wrong:
// its first triangle, (2,1) (1,1) (1,2), runs clockwise, signed area
// (1/2)((-1,0) x (-1,1)) = -1/2. Ear clipping gives 4 triangles, each
// counterclockwise (positive signed area), their areas summing to 3.
//
// The cube cage of size 1 (faces back (0, 2, 3, 1), front (4, 5, 7, 6), left
// (0, 4, 6, 2), right (1, 3, 7, 5), bottom (0, 1, 5, 4), top (2, 6, 7, 3)):
// - flat: every corner its own vertex, 24, numbered face by face, each with
//   its face's normal: vertex 0 is the back face's first corner, cage vertex
//   0, normal (0, 0, -1); 4 the front's first, normal (0, 0, 1); 8 the
//   left's first, (-1, 0, 0); 20 the top's first, cage vertex 2, (0, 1, 0).
//   The back face's triangles are (0, 1, 2), (0, 2, 3).
// - smooth: one vertex per cage vertex, 8, made in the order the faces first
//   reach them: back 0, 2, 3, 1 are 0 to 3, front 4, 5, 7, 6 are 4 to 7. So
//   the left face (0, 4, 6, 2) is vertices 0, 4, 7, 1: triangles (0, 4, 7),
//   (0, 7, 1). Three square faces meet at right angles at each corner, so
//   each vertex normal is the corner's direction over its length: vertex 0
//   (cage 0) (-d, -d, -d), vertex 3 (cage 1) (d, -d, -d), d = 1/sqrt 3 =
//   0.5773503.
// - Mesh.computeSmoothNormals on the smooth one, by angle: cage vertex 1 is
//   in one triangle of the back face (angle 90), two of the right (45 each)
//   and one of the bottom (90): each face 90 in all, so again (d, -d, -d).
//   Weighting by area would count the right face twice and lean it.
// - Mesh.computeFlatNormals on it: 36 vertices, indices 0 to 35, vertex 0
//   the back face's first triangle's (0, 0, -1), vertex 35 the top face's
//   last triangle's (0, 1, 0).
// - with uvs (0,0) (1,0) (1,1) (0,1) on every face's corners in order, smooth
//   splits each cage vertex once per distinct uv at it: vertex 0 has (0,0) on
//   all three of its faces, and 7 (1,1) on all three; each of the other six
//   has three different uvs. 1 + 6 * 3 + 1 = 20 vertices. The left face's
//   corners: cage 0 (0,0) is vertex 0 again; cage 4 at (1,0), cage 6 at
//   (1,1) and cage 2 at (0,1) are new, 8, 9, 10: triangles (0, 8, 9), (0, 9,
//   10). Flat, still 24.
//
// A strip of two unit quads, (0, 1, 4, 3) and (1, 2, 5, 4) over the points
// (0,0) (1,0) (2,0) (0,1) (1,1) (2,1), uvs (x/2, y): the shared edge's uvs
// agree, so smooth gives 6 vertices, the second face's corners 1, 4 (new),
// 5 (new), 2: triangles (1, 4, 5), (1, 5, 2); flat gives 8.

mod triangulate;

import testing use *;
import collections use *;
import geomath use *;
import mesh use *;

imm near = 0.00001d;
imm d f32 = 0.5773503;

fn point(got Vec3, x f32, y f32, z f32, label &[]u8) {
  expectFloat(got.x, x, near, label);
  expectFloat(got.y, y, near, label);
  expectFloat(got.z, z, near, label);
}

fn uv(got Vec2, u f32, v f32, label &[]u8) {
  expectFloat(got.x, u, near, label);
  expectFloat(got.y, v, near, label);
}

fn triangle(m &Mesh, t usize, a u32, b u32, c u32, label &[]u8) {
  expectInt(i64[*m.indices[3usize * t]], i64[a], label);
  expectInt(i64[*m.indices[3usize * t + 1usize]], i64[b], label);
  expectInt(i64[*m.indices[3usize * t + 2usize]], i64[c], label);
}

fn noProblems(m &PolyMesh, built &List[String], label &[]u8) {
  imm found = m.validate();
  expectInt(i64[built.len() + found.len()], 0, label);
}

fn quad() {
  imm pts [4; Vec3] = [Vec3[0., 0., 0.], Vec3[1., 0., 0.], Vec3[1., 1., 0.], Vec3[0., 1., 0.]];
  imm counts [1; u32] = [4u32];
  imm idx [4; u32] = [0u32, 1u32, 2u32, 3u32];
  mut built = List[String].empty();
  imm p = PolyMesh.fromPolygons(&pts, &counts, &idx, &mut built);
  noProblems(&p, &built, "a quad builds");
  imm m = p.triangulate(false);
  requireInt(i64[m.triangleCount()], 2, "a quad is 2 triangles");
  expectInt(i64[m.vertexCount()], 4, "a quad's 4 corners");
  triangle(&m, 0usize, 0u32, 1u32, 2u32, "a quad's first triangle");
  triangle(&m, 1usize, 0u32, 2u32, 3u32, "a quad's second triangle");
  point(*m.positions[2usize], 1., 1., 0., "a quad's third corner");
  point(*m.normals[3usize], 0., 0., 1., "a quad's normal");
  expectInt(i64[m.uvs.len()], 0, "no uv channel, no uvs");
}

fn heptagon() {
  mut pts = List[Vec3].empty();
  mut idx = List[u32].empty();
  mut k = 0u32;
  while k < 7u32 {
    imm a = 2. * pi * f32[k] / 7.;
    pts.push(Vec3[cos(a), sin(a), 0.]);
    idx.push(k);
    k = k + 1u32;
  }
  imm counts [1; u32] = [7u32];
  mut built = List[String].empty();
  imm p = PolyMesh.fromPolygons(pts.view(), &counts, idx.view(), &mut built);
  noProblems(&p, &built, "a heptagon builds");
  imm m = p.triangulate(false);
  requireInt(i64[m.triangleCount()], 5, "a heptagon is 7 - 2 triangles");
  expectInt(i64[m.vertexCount()], 7, "a heptagon's corners");
  triangle(&m, 0usize, 0u32, 1u32, 2u32, "the fan's first");
  triangle(&m, 4usize, 0u32, 5u32, 6u32, "the fan's last");
  imm s = p.triangulate(true);
  expectInt(i64[s.vertexCount()], 7, "smooth: the same 7");
  point(*s.normals[4usize], 0., 0., 1., "a flat face's smooth normal is its own");
}

fn lshape() {
  imm pts [6; Vec3] = [Vec3[2., 1., 2.], Vec3[1., 1., 2.], Vec3[1., 2., 2.], Vec3[0., 2., 2.],
    Vec3[0., 0., 2.], Vec3[2., 0., 2.]];
  imm counts [1; u32] = [6u32];
  imm idx [6; u32] = [0u32, 1u32, 2u32, 3u32, 4u32, 5u32];
  mut built = List[String].empty();
  imm p = PolyMesh.fromPolygons(&pts, &counts, &idx, &mut built);
  noProblems(&p, &built, "an L builds");
  point(p.faceNormal(0u32), 0., 0., 1., "the L faces +z");
  imm m = p.triangulate(false);
  requireInt(i64[m.triangleCount()], 4, "an L hexagon is 6 - 2 triangles");
  mut total f32 = 0.;
  mut ccw = 0;
  mut t = 0usize;
  while t < 4usize {
    imm a = *m.positions[usize[*m.indices[3usize * t]]];
    imm b = *m.positions[usize[*m.indices[3usize * t + 1usize]]];
    imm c = *m.positions[usize[*m.indices[3usize * t + 2usize]]];
    imm area = 0.5 * (b - a).cross(c - a).z;
    if area > 0. { ccw = ccw + 1; }
    total = total + area;
    t = t + 1usize;
  }
  expectInt(i64[ccw], 4, "every triangle counterclockwise");
  expectFloat(total, 3., near, "the triangles cover the L's area");
  imm b = m.bounds();
  point(b.min, 0., 0., 2., "the L's bounds, min");
  point(b.max, 2., 2., 2., "the L's bounds, max");
}

fn cube() {
  imm cage = PolyMesh.cube(1.);
  imm flat = cage.triangulate(false);
  requireInt(i64[flat.vertexCount()], 24, "flat cube: a vertex per corner");
  expectInt(i64[flat.triangleCount()], 12, "flat cube: 12 triangles");
  expectInt(i64[flat.normals.len()], 24, "flat cube: 24 normals");
  point(*flat.positions[0usize], -1., -1., -1., "flat: vertex 0");
  point(*flat.positions[1usize], -1., 1., -1., "flat: vertex 1 is cage 2");
  point(*flat.normals[0usize], 0., 0., -1., "flat: the back face's normal");
  point(*flat.normals[4usize], 0., 0., 1., "flat: the front face's normal");
  point(*flat.normals[8usize], -1., 0., 0., "flat: the left face's normal");
  point(*flat.normals[20usize], 0., 1., 0., "flat: the top face's normal");
  triangle(&flat, 0usize, 0u32, 1u32, 2u32, "flat: back's first triangle");
  triangle(&flat, 1usize, 0u32, 2u32, 3u32, "flat: back's second triangle");
  triangle(&flat, 2usize, 4u32, 5u32, 6u32, "flat: front's first triangle");

  mut smooth = cage.triangulate(true);
  requireInt(i64[smooth.vertexCount()], 8, "smooth cube: a vertex per cage vertex");
  expectInt(i64[smooth.triangleCount()], 12, "smooth cube: 12 triangles");
  point(*smooth.normals[0usize], -d, -d, -d, "smooth: cage vertex 0's normal");
  point(*smooth.normals[3usize], d, -d, -d, "smooth: cage vertex 1's normal");
  point(*smooth.positions[7usize], -1., 1., 1., "smooth: vertex 7 is cage 6");
  triangle(&smooth, 4usize, 0u32, 4u32, 7u32, "smooth: left's first triangle");
  triangle(&smooth, 5usize, 0u32, 7u32, 1u32, "smooth: left's second triangle");

  smooth.computeSmoothNormals();
  point(*smooth.normals[3usize], d, -d, -d, "angle-weighted: cage vertex 1");
  point(*smooth.normals[0usize], -d, -d, -d, "angle-weighted: cage vertex 0");

  smooth.computeFlatNormals();
  expectInt(i64[smooth.vertexCount()], 36, "split: 3 vertices a triangle");
  expectInt(i64[smooth.normals.len()], 36, "split: a normal each");
  expectInt(i64[*smooth.indices[35usize]], 35, "split: indices in order");
  point(*smooth.normals[0usize], 0., 0., -1., "split: back face's normal");
  point(*smooth.normals[35usize], 0., 1., 0., "split: top face's normal");
}

fn seams() {
  mut cage = PolyMesh.cube(1.);
  imm ch = cage.addVec2Channel(CornerDomain, "uv", Vec2[0., 0.]);
  mut uvs = List[Vec2].empty();
  mut f = 0;
  while f < 6 {
    uvs.push(Vec2[0., 0.]);
    uvs.push(Vec2[1., 0.]);
    uvs.push(Vec2[1., 1.]);
    uvs.push(Vec2[0., 1.]);
    f = f + 1;
  }
  cage.setCornerVec2s(ch, uvs.view());
  imm smooth = cage.triangulate(true);
  requireInt(i64[smooth.vertexCount()], 20, "uv seams split the smooth cube's vertices");
  expectInt(i64[smooth.uvs.len()], 20, "a uv per vertex");
  expectInt(i64[smooth.normals.len()], 20, "a normal per vertex");
  uv(*smooth.uvs[1usize], 1., 0., "vertex 1's uv");
  triangle(&smooth, 4usize, 0u32, 8u32, 9u32, "the left face, first");
  triangle(&smooth, 5usize, 0u32, 9u32, 10u32, "the left face, second");
  point(*smooth.positions[8usize], -1., -1., 1., "vertex 8 is cage 4 again");
  point(*smooth.normals[8usize], -d, -d, d, "a split vertex keeps the smooth normal");
  imm flat = cage.triangulate(false);
  expectInt(i64[flat.vertexCount()], 24, "flat, with uvs");

  // Two quads whose uvs agree along the edge they share
  imm pts [6; Vec3] = [Vec3[0., 0., 0.], Vec3[1., 0., 0.], Vec3[2., 0., 0.], Vec3[0., 1., 0.],
    Vec3[1., 1., 0.], Vec3[2., 1., 0.]];
  imm counts [2; u32] = [4u32, 4u32];
  imm idx [8; u32] = [0u32, 1u32, 4u32, 3u32, 1u32, 2u32, 5u32, 4u32];
  mut built = List[String].empty();
  mut strip = PolyMesh.fromPolygons(&pts, &counts, &idx, &mut built);
  noProblems(&strip, &built, "a strip builds");
  imm sch = strip.addVec2Channel(CornerDomain, "uv", Vec2[0., 0.]);
  imm suv [8; Vec2] = [Vec2[0., 0.], Vec2[0.5, 0.], Vec2[0.5, 1.], Vec2[0., 1.],
    Vec2[0.5, 0.], Vec2[1., 0.], Vec2[1., 1.], Vec2[0.5, 1.]];
  strip.setCornerVec2s(sch, &suv);
  imm s = strip.triangulate(true);
  requireInt(i64[s.vertexCount()], 6, "a strip with no seam shares its edge");
  triangle(&s, 2usize, 1u32, 4u32, 5u32, "the second quad, first");
  triangle(&s, 3usize, 1u32, 5u32, 2u32, "the second quad, second");
  uv(*s.uvs[5usize], 1., 1., "the far corner's uv");
  imm sf = strip.triangulate(false);
  expectInt(i64[sf.vertexCount()], 8, "flat, the strip's 8 corners");
}

fn main() i32 {
  quad();
  heptagon();
  lshape();
  cube();
  seams();
  done();
}
