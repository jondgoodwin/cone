// cage: a cube cage as a half-edge PolyMesh (what subdivision will start
// from), checked, cut into triangles, and written as cage.obj in the current
// folder for viewing in Blender (File > Import > Wavefront (.obj)).
//
//   congo run packages/mesh/examples/cage.cone

mod cage;

import stdio use *;
import collections use *;
import geomath use *;
import mesh use *;

fn main() i32 {
  imm cage = PolyMesh.cube(1.);
  print <- "Cage: "; print <- cage.vertexCount(); print <- " vertices, ";
  print <- cage.edgeCount(); print <- " edges, "; print <- cage.faceCount(); print <- " faces, ";
  print <- cage.halfedgeCount(); print <- " half-edges\n";

  imm problems = cage.validate();
  if problems.len() == 0usize {
    print <- "It validates\n";
  } else {
    mut i = 0usize;
    while i < problems.len() {
      printStr(problems[i].view());
      print <- "\n";
      i = i + 1usize;
    }
    return 1;
  }

  imm flat = cage.triangulate(false);
  imm smooth = cage.triangulate(true);
  print <- "Triangulated flat: "; print <- flat.vertexCount(); print <- " vertices, ";
  print <- flat.triangleCount(); print <- " triangles\n";
  print <- "Triangulated smooth: "; print <- smooth.vertexCount(); print <- " vertices, ";
  print <- smooth.triangleCount(); print <- " triangles\n";

  imm b = smooth.bounds();
  print <- "Bounds: ("; print <- b.min.x; print <- ", "; print <- b.min.y; print <- ", "; print <- b.min.z;
  print <- ") to ("; print <- b.max.x; print <- ", "; print <- b.max.y; print <- ", "; print <- b.max.z;
  print <- ")\n";

  if writeObj(&cage, "cage.obj") {
    print <- "Wrote cage.obj\n";
  } else {
    print <- "Could not write cage.obj\n";
    return 1;
  }
  0;
}
