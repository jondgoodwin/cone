// The pbrmaterial package's bake: its periodic noise, its per-texel
// functions and the texture set they make. Only a failure prints.
//
// - A FractalLayer repeats every 1 in u and v (to 1e-5: the point u + 1 has
//   fewer bits below the point than u), each kind, warped and not; fBm lies
//   in [-1, 1] and ridged in [0, 1].
// - The bake is the per-texel function: every texel of 'bakeHeight' is
//   'heightTexel' of its coordinates, bit for bit, and a second bake gives the
//   same bytes.
// - Seams: the height function just past the tile's right and top edges is
//   its value at the left and bottom; and in every map, the step from the last
//   column to the first (and the last row to the first) is no bigger than the
//   biggest step between neighbours inside the tile.
// - Normals: every float normal is unit length; every 8-bit one decodes to
//   within 0.01 of unit length; each leans away from the uphill side; a flat
//   field gives (0, 0, 1), occlusion 1 and convexity 0.
// - Convexity and occlusion against a hand-made field: a bump is convex and
//   fully open on top, a pit concave and occluded.
// - The sRGB curve: 0, 1 and 0.5 encoded as IEC 61966-2-1 gives them, and
//   decode undoes encode.
// - Weathering: no amount is no mask; edge wear gathers on convex texels
//   and grime on concave ones.
// - The maps of one 64 x 64 surface, pinned by their FNV-1a hashes.

mod bake;

import testing use *;
import libc;
import geomath use *;
import collections use *;
import pbrmaterial use *;

const SIZE = 64;

// A test surface: ridged plates with fBm detail, steel-grey paint over metal,
// worn on its edges and grimy in its creases
fn testSurface() ProceduralSurface {
  let height = HeightParams(FractalLayer.ridged(4, 4, 0.5, 11u32).warped(0.4), FractalLayer.fbm(16, 3, 0.5, 12u32),
    0.15, 0.1, 1.2, 0.03);
  let surface = SurfaceParams(Color(0.05, 0.06, 0.07, 1.), Color(0.30, 0.32, 0.35, 1.),
    FractalLayer.fbm(8, 4, 0.5, 13u32), 0.25, 0.7, 0.45, 0.1, 0.);
  let wear = WeatheringParams(1., 0.06, 0.03, FractalLayer.fbm(16, 3, 0.5, 14u32), 0.05,
    Color(0.6, 0.6, 0.62, 1.), 0.25, 1.);
  let grime = WeatheringParams(0.9, 0.12, 0.06, FractalLayer.fbm(8, 3, 0.5, 15u32), 0.05,
    Color(0.03, 0.025, 0.02, 1.), 0.9, 0.);
  ProceduralSurface(height, surface, 0.06, 6, 0.02, wear, grime)
}

// The largest step between neighbouring texels of channel 'c' inside the
// map, and across its wrap (last column to first, last row to first)
fn steps(m: &TexelMap, c: i32, inside: &mut i32, across: &mut i32) {
  var a = 0;
  var b = 0;
  var y = 0;
  while y < m.height {
    var x = 0;
    while x < m.width {
      let here = i32.from(m.at(x, y, c));
      let right = i32.from(m.at((x + 1) % m.width, y, c));
      let up = i32.from(m.at(x, (y + 1) % m.height, c));
      var dx = here - right;
      if dx < 0 { dx = 0 - dx; }
      var dy = here - up;
      if dy < 0 { dy = 0 - dy; }
      if x == m.width - 1 { if dx > b { b = dx; } } else if dx > a { a = dx; }
      if y == m.height - 1 { if dy > b { b = dy; } } else if dy > a { a = dy; }
      x = x + 1;
    }
    y = y + 1;
  }
  *inside = a;
  *across = b;
}

fn checkSeams(m: &TexelMap, name: &Array[u8]) {
  var c = 0;
  while c < m.channels {
    var inside = 0;
    var across = 0;
    steps(m, c, &mut inside, &mut across);
    expect(across <= inside, name);
    c = c + 1;
  }
}

fn main() i32 {
  // ---- Periodic fractal noise ----
  let layers = [FractalLayer.fbm(4, 5, 0.5, 3u32), FractalLayer.ridged(3, 4, 0.6, 4u32),
    FractalLayer.billow(5, 3, 0.5, 5u32), FractalLayer.fbm(4, 4, 0.5, 6u32).warped(0.7)];
  var worstWrap = 0.0;
  var fbmIn = true;
  var ridgedIn = true;
  var l = 0usize;
  while l < 4usize {
    let layer = layers[l];
    var j = 0;
    while j < 16 {
      let u = f32.from(j) * 0.0625 + 0.013;
      let v = f32.from((j * 7) % 16) * 0.0625 + 0.029;
      let a = layer.at(u, v);
      let du = libc.fabs(f64.from(layer.at(u + 1., v) - a));
      let dv = libc.fabs(f64.from(layer.at(u, v + 1.) - a));
      if du > worstWrap { worstWrap = du; }
      if dv > worstWrap { worstWrap = dv; }
      if l == 0usize && (a < -1. || a > 1.) { fbmIn = false; }
      if l == 1usize && (a < 0. || a > 1.) { ridgedIn = false; }
      j = j + 1;
    }
    l = l + 1usize;
  }
  expect(worstWrap < 0.00001, "every layer repeats every 1 in u and in v");
  expect(fbmIn, "fbm lies in [-1, 1]");
  expect(ridgedIn, "ridged lies in [0, 1]");

  // ---- The bake is the per-texel function ----
  let surface = testSurface();
  let set = bakeTextureSet(&surface, SIZE);
  var same = true;
  var y = 0;
  while y < SIZE {
    var x = 0;
    while x < SIZE {
      let h = heightTexel(&surface.height, x, y, SIZE);
      if (h as u32) != (set.height.at(x, y) as u32) { same = false; }
      x = x + 1;
    }
    y = y + 1;
  }
  expect(same, "each texel of the height map is heightTexel of its coordinates, bit for bit");
  let again = bakeTextureSet(&surface, SIZE);
  expectUInt(mapHash(&again.baseColor), mapHash(&set.baseColor), "a second bake gives the same base colour");
  expectUInt(mapHash(&again.normal), mapHash(&set.normal), "and the same normals");

  // ---- Seams ----
  var seam = 0.0;
  var k = 0;
  while k < SIZE {
    let right = libc.fabs(f64.from(heightTexel(&surface.height, SIZE, k, SIZE) - heightTexel(&surface.height, 0, k, SIZE)));
    let top = libc.fabs(f64.from(heightTexel(&surface.height, k, SIZE, SIZE) - heightTexel(&surface.height, k, 0, SIZE)));
    if right > seam { seam = right; }
    if top > seam { seam = top; }
    k = k + 1;
  }
  expect(seam < 0.00001, "the height just past the right and top edges is the left and bottom's");
  checkSeams(&set.baseColor, "base colour: no step across the wrap bigger than inside");
  checkSeams(&set.orm, "ORM: no step across the wrap bigger than inside");
  checkSeams(&set.normal, "normal: no step across the wrap bigger than inside");
  checkSeams(&set.heightMap, "height: no step across the wrap bigger than inside");

  // ---- Normals ----
  var worstUnit = 0.0;
  var worstByte = 0.0;
  var leans = true;
  y = 0;
  while y < SIZE {
    var x = 0;
    while x < SIZE {
      let n = normalTexel(&set.height, x, y, surface.height.depth);
      let e = libc.fabs(f64.from(n.length()) - 1.0);
      if e > worstUnit { worstUnit = e; }
      let qx = byteUnit(set.normal.at(x, y, 0)) * 2. - 1.;
      let qy = byteUnit(set.normal.at(x, y, 1)) * 2. - 1.;
      let qz = byteUnit(set.normal.at(x, y, 2)) * 2. - 1.;
      let eb = libc.fabs(f64.from(libc.sqrtf(qx * qx + qy * qy + qz * qz)) - 1.0);
      if eb > worstByte { worstByte = eb; }
      let slope = set.height.at(x + 1, y) - set.height.at(x - 1, y);
      if (slope > 0. && n.x > 0.) || (slope < 0. && n.x < 0.) { leans = false; }
      x = x + 1;
    }
    y = y + 1;
  }
  expect(worstUnit < 0.000001, "every float normal is unit length");
  expect(worstByte < 0.01, "every 8-bit normal decodes to within 0.01 of unit length");
  expect(leans, "each normal leans away from the uphill side");

  var flat = ScalarMap.zeros(8);
  let fn0 = normalTexel(&flat, 3, 3, 0.05);
  expectFloat(f64.from(fn0.x), 0.0, 0.0, "a flat field's normal is (0, 0, 1): x");
  expectFloat(f64.from(fn0.y), 0.0, 0.0, "y");
  expectFloat(f64.from(fn0.z), 1.0, 0.0, "z");
  expectFloat(f64.from(occlusionTexel(&flat, 3, 3, 0.25, 4, 0.05)), 1.0, 0.0, "a flat field is open");
  expectFloat(f64.from(convexityTexel(&flat, 3, 3, 0.125, 0.05)), 0.0, 0.0, "and neither convex nor concave");

  // ---- Convexity and occlusion against a hand-made field ----
  var bump = ScalarMap.zeros(16);
  bump.set(8, 8, 1.);
  var pit = ScalarMap.zeros(16);
  y = 0;
  while y < 16 {
    var x = 0;
    while x < 16 {
      pit.set(x, y, 1.);
      x = x + 1;
    }
    y = y + 1;
  }
  pit.set(8, 8, 0.);
  expect(convexityTexel(&bump, 8, 8, 0.0625, 0.05) > 0., "a bump is convex");
  expect(convexityTexel(&pit, 8, 8, 0.0625, 0.05) < 0., "a pit is concave");
  expectFloat(f64.from(occlusionTexel(&bump, 8, 8, 0.25, 4, 0.05)), 1.0, 0.0, "a bump's top is open");
  expect(occlusionTexel(&pit, 8, 8, 0.25, 4, 0.05) < 1., "a pit's floor is occluded");
  // One step of 1/16 of the tile (one texel): along the axes the rim, 0.05
  // above, a tangent of 0.05 x 16 = 0.8; along the diagonals the bilinear
  // blend at (8 + d, 8 + d), d = 0.7071, which is 1 - (1 - d)^2 of the rim
  let d = 0.70710678;
  let ta = 0.8;
  let td = (1.0 - (1.0 - d) * (1.0 - d)) * 0.8;
  let open = 1.0 - (4.0 * ta / libc.sqrt(1.0 + ta * ta) + 4.0 * td / libc.sqrt(1.0 + td * td)) / 8.0;
  expectFloat(f64.from(occlusionTexel(&pit, 8, 8, 0.0625, 1, 0.05)), open, 0.00001,
    "the pit's openness is 1 less the mean sine of the rim's elevation");

  // ---- The sRGB curve ----
  expectFloat(f64.from(srgbEncode(0.)), 0.0, 0.0, "sRGB of 0 is 0");
  expectFloat(f64.from(srgbEncode(1.)), 1.0, 0.0, "sRGB of 1 is 1");
  expectFloat(f64.from(srgbEncode(0.5)), 0.735357, 0.000001, "sRGB of 0.5 is 0.735357");
  expectFloat(f64.from(srgbDecode(srgbEncode(0.2))), 0.2, 0.000001, "decode undoes encode");

  // ---- Weathering ----
  let none = WeatheringParams.none();
  expectFloat(f64.from(weatheringMask(&none, 5., 0.3, 0.3)), 0.0, 0.0, "no amount, no mask");
  var wearOnConvex = 0.0;
  var wearOnConcave = 0.0;
  var grimeOnConvex = 0.0;
  var grimeOnConcave = 0.0;
  var convexCount = 0.0;
  var concaveCount = 0.0;
  y = 0;
  while y < SIZE {
    var x = 0;
    while x < SIZE {
      let c = convexityTexel(&set.height, x, y, surface.convexityRadius, surface.height.depth);
      let w = f64.from(set.wearMask.at(x, y, 0));
      let g = f64.from(set.grimeMask.at(x, y, 0));
      if c > 0.03 {
        wearOnConvex = wearOnConvex + w;
        grimeOnConvex = grimeOnConvex + g;
        convexCount = convexCount + 1.0;
      } else if c < -0.03 {
        wearOnConcave = wearOnConcave + w;
        grimeOnConcave = grimeOnConcave + g;
        concaveCount = concaveCount + 1.0;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  expect(convexCount > 0.0 && concaveCount > 0.0, "the test surface has convex and concave texels");
  expect(wearOnConvex / convexCount > wearOnConcave / concaveCount, "edge wear gathers on convex texels");
  expect(grimeOnConcave / concaveCount > grimeOnConvex / convexCount, "grime gathers on concave texels");

  // ---- The maps, pinned ----
  expectUInt(mapHash(&set.baseColor), 2688242806316949393u64, "base colour hash");
  expectUInt(mapHash(&set.orm), 4785266580049760213u64, "ORM hash");
  expectUInt(mapHash(&set.normal), 462987576560406999u64, "normal hash");
  expectUInt(mapHash(&set.heightMap), 3127703471588091859u64, "height hash");
  expectUInt(mapHash(&set.wearMask), 14670370643135959687u64, "wear hash");
  expectUInt(mapHash(&set.grimeMask), 7794801270977148139u64, "grime hash");
  expectUInt(scalarMapHash(&set.height), 12296221076600457794u64, "height field hash (f32 bits)");
  done()
}
