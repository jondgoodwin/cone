// spheres: three procedural materials baked on the CPU by the pbrmaterial
// package and drawn by render's physically based material on three spheres
// over a ground, under a low sun. Each material is a ProceduralSurface (its
// parameters are this example's, not the library's): worn painted metal
// (ridged, warped plates, the paint worn to bare steel on their edges, grime
// in the creases), weathered stone (billowed lumps, dark in the cracks) and
// hammered copper (dents, green patina in the hollows). The ground is the
// stone again, its tile repeated four times each way, so a seam would show.
// Each tile is baked into a texture set (base colour, ORM, normal map) and
// uploaded: the base colour as sRGB, the ORM and normal maps as linear.
//
//   congo run packages/pbrmaterial/examples/spheres.cone
//   congo run packages/pbrmaterial/examples/spheres.cone -- --frames 120 --screenshot spheres.bmp
//   congo run packages/pbrmaterial/examples/spheres.cone -- --maps out --frames 1
//
// '--size N' bakes tiles N texels square (512 by default). '--maps DIR'
// writes every map of every material into the folder DIR as BMPs (it must
// exist). '--frames N' draws N frames and stops; otherwise it runs until the
// window is closed (Escape). Time is the frame's number over 60, so a run of N
// frames is the same every time. At frame CHECK_FRAME (or the last, if sooner)
// it reads the frame back, then draws the next frame with the normal maps
// left off and reads that back too, and checks that the normal maps add
// detail: the sum of the differences between neighbouring pixels over each
// sphere's middle is greater with them. '--screenshot FILE' writes the first
// frame to FILE, the second to FILE without its '.bmp' and with
// '-nonormal.bmp'. It prints the bake times, the checks, and exits 0 only if
// every check passed, no Vulkan call failed and the validation layer said
// nothing.
//
// It needs a display, a GPU driver with Vulkan 1.3, SDL3.lib on LIB to link
// (Congo copies SDL3.dll from beside it to beside the program); with the
// Vulkan SDK, validation is on. GPU_POWER_PREFERENCE=low-power picks an
// integrated GPU where there are two.

mod spheres;

import stdio use *;
import libc;
import sdl;
import collections use *;
import geomath use *;
import mesh use *;
import gpu use *;
import render use *;
import window use *;
import pbrmaterial use *;

const CHECK_FRAME = 90;
const SPACING f32 = 2.5;

// ---- The example's materials ----

// Painted steel plates: ridged, warped noise for the plates' raised fields,
// fine fBm for the paint's unevenness; the paint a dark blue-grey, worn to
// bare steel where the plates' edges stand out, grime in the creases
fn paintedMetal() ProceduralSurface {
  imm height = new HeightParams(FractalLayer.ridged(3, 5, 0.5, 101u32).warped(0.35), FractalLayer.fbm(24, 3, 0.5, 102u32),
    0.05, -1.0, 2.2, 0.025);
  imm surface = new SurfaceParams(new Color(0.035, 0.05, 0.07, 1.), new Color(0.11, 0.15, 0.19, 1.),
    FractalLayer.fbm(6, 4, 0.5, 103u32), 0.3, 0.75, 0.5, 0.1, 0.);
  imm wear = new WeatheringParams(1., 0.1, 0.03, FractalLayer.fbm(32, 3, 0.6, 104u32), 0.06,
    new Color(0.55, 0.56, 0.57, 1.), 0.3, 1.);
  imm grime = new WeatheringParams(0.85, 0.3, 0.1, FractalLayer.fbm(10, 3, 0.5, 105u32), 0.1,
    new Color(0.025, 0.02, 0.015, 1.), 0.95, 0.);
  new ProceduralSurface(height, surface, 0.04, 6, 0.02, wear, grime);
}

// Stone: billowed lumps with fine grain, grey-brown, rough, dark and
// rougher still in the cracks between the lumps; no wear
fn weatheredStone() ProceduralSurface {
  imm height = new HeightParams(FractalLayer.billow(5, 5, 0.55, 201u32).warped(0.5), FractalLayer.fbm(32, 3, 0.5, 202u32),
    0.2, 0.75, 0.9, 0.035);
  imm surface = new SurfaceParams(new Color(0.12, 0.11, 0.10, 1.), new Color(0.36, 0.33, 0.29, 1.),
    FractalLayer.fbm(4, 5, 0.5, 203u32), 0.35, 0.9, 0.7, 0.08, 0.);
  imm grime = new WeatheringParams(0.9, 0.3, 0.08, FractalLayer.fbm(8, 3, 0.5, 205u32), 0.1,
    new Color(0.02, 0.025, 0.015, 1.), 1., 0.);
  new ProceduralSurface(height, surface, 0.05, 6, 0.015, WeatheringParams.none(), grime);
}

// Hammered copper: billowed dents, polished copper, green patina (no longer
// metal, rough) gathered in the dents' hollows
fn hammeredCopper() ProceduralSurface {
  imm height = new HeightParams(FractalLayer.billow(10, 2, 0.4, 301u32), FractalLayer.fbm(40, 2, 0.5, 302u32),
    0.08, 0.6, 0.6, 0.02);
  imm surface = new SurfaceParams(new Color(0.80, 0.42, 0.30, 1.), new Color(0.95, 0.60, 0.48, 1.),
    FractalLayer.fbm(5, 4, 0.5, 303u32), 0.15, 0.32, 0.22, 0.06, 1.);
  imm grime = new WeatheringParams(1., 0.1, 0.05, FractalLayer.fbm(12, 3, 0.5, 305u32), 0.12,
    new Color(0.10, 0.32, 0.24, 1.), 0.85, 0.);
  new ProceduralSurface(height, surface, 0.05, 6, 0.01, WeatheringParams.none(), grime);
}

// ---- Arguments ----

fn parseCount(s *u8) i32 {
  if (s as usize) == 0usize or *s == 0u8 { return -1; }
  mut n = 0;
  mut i = 0usize;
  while *(s + i) != 0u8 {
    imm c = *(s + i);
    if c < '0' or c > '9' { return -1; }
    n = n * 10 + i32.from(c - '0');
    i = i + 1usize;
  }
  n;
}

fn cstrEquals(a *u8, b &Array[u8]) bool {
  mut i = 0usize;
  while i < b.len {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len) == 0u8;
}

fn cstrString(s *u8) String {
  mut out = String.empty();
  mut i = 0usize;
  while *(s + i) != 0u8 {
    out.appendByte(*(s + i));
    i = i + 1usize;
  }
  out;
}

fn onOff(on bool) &Array[u8] {
  if on { return "on"; }
  "off";
}

// ---- Maps to images ----

// A texel map as render's Image (gray made RGB, for a BMP)
fn toImage(m &TexelMap) Image {
  imm n = usize.from(m.width * m.height);
  mut img = new Image(m.width, m.height, 3, List[u8].withCapacity(n * 3usize));
  mut i = 0usize;
  while i < n {
    if m.channels == 1 {
      imm g = *m.pixels[i];
      img.pixels.push(g);
      img.pixels.push(g);
      img.pixels.push(g);
    } else {
      imm at = i * usize.from(m.channels);
      img.pixels.push(*m.pixels[at]);
      img.pixels.push(*m.pixels[at + 1usize]);
      img.pixels.push(*m.pixels[at + 2usize]);
    }
    i = i + 1usize;
  }
  img;
}

fn saveMap(dir &String, material &Array[u8], map &Array[u8], m &TexelMap) bool {
  mut path = dir.copy();
  path <- "/";
  path <- material;
  path <- "-";
  path <- map;
  path <- ".bmp";
  imm img = toImage(m);
  imm ok = img.save(path.view());
  print <- "  "; printStr(path.view());
  if ok { print <- "\n"; } else { print <- " could NOT be written\n"; }
  ok;
}

fn saveSet(dir &String, name &Array[u8], set &TextureSet) bool {
  mut ok = saveMap(dir, name, "basecolor", &set.baseColor);
  ok = saveMap(dir, name, "orm", &set.orm) and ok;
  ok = saveMap(dir, name, "normal", &set.normal) and ok;
  ok = saveMap(dir, name, "height", &set.heightMap) and ok;
  ok = saveMap(dir, name, "wear", &set.wearMask) and ok;
  ok = saveMap(dir, name, "grime", &set.grimeMask) and ok;
  ok;
}

// A material's textures in the renderer, and the material, with and without
// its normal map
struct Uploaded {
  full MaterialHandle;
  noNormal MaterialHandle;
}

fn upload(renderer &mut Renderer, device &mut Device, set &TextureSet) Uploaded {
  imm baseImg = toImage(&set.baseColor);
  imm ormImg = toImage(&set.orm);
  imm normalImg = toImage(&set.normal);
  imm base = renderer.addTexture(device, &baseImg);
  imm orm = renderer.addLinearTexture(device, &ormImg);
  imm normal = renderer.addNormalTexture(device, &normalImg);
  imm full = PbrMaterial.textured(base, orm, normal);
  imm flat = PbrMaterial.textured(base, orm, TextureHandle.none());
  new Uploaded(renderer.addPbrMaterial(device, &full), renderer.addPbrMaterial(device, &flat));
}

// ---- The check ----

fn pixelOf(viewProjection Mat4, p Vec3, w u32, h u32, x &mut i32, y &mut i32) {
  imm clip = viewProjection * new Vec4(p.x, p.y, p.z, 1.);
  *x = i32.from((clip.x / clip.w + 1.) * 0.5 * f32.from(w));
  *y = i32.from((1. - clip.y / clip.w) * 0.5 * f32.from(h));
}

fn luma(p *u8, w u32, x i32, y i32) i64 {
  imm at = (usize.from(y) * usize.from(w) + usize.from(x)) * 4usize;
  i64.from(*(p + at)) + i64.from(*(p + at + 1usize)) + i64.from(*(p + at + 2usize));
}

// The detail in a square 'r' pixels either side of ('cx', 'cy'): the sum of
// the absolute differences between each pixel and its right and lower
// neighbours
fn detail(p *u8, w u32, h u32, cx i32, cy i32, r i32) i64 {
  mut sum = 0i64;
  mut y = cy - r;
  while y < cy + r {
    mut x = cx - r;
    while x < cx + r {
      if x >= 0 and y >= 0 and x + 1 < i32.from(w) and y + 1 < i32.from(h) {
        imm here = luma(p, w, x, y);
        mut a = here - luma(p, w, x + 1, y);
        if a < 0i64 { a = 0i64 - a; }
        mut b = here - luma(p, w, x, y + 1);
        if b < 0i64 { b = 0i64 - b; }
        sum = sum + a + b;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  sum;
}

fn shotName(base &String, suffix &Array[u8]) String {
  mut s = String.empty();
  if base.endsWith(".bmp") { s = base.sub(0usize, base.len() - 4usize); } else { s = base.copy(); }
  s <- suffix;
  s <- ".bmp";
  s;
}

// ---- The demo ----

fn main(argc i32, argv **u8) i32 {
  mut maxFrames = 0;
  mut size = 512;
  mut screenshot = String.empty();
  mut mapsDir = String.empty();
  mut a = 1;
  while a < argc {
    imm arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--frames") and a + 1 < argc {
      maxFrames = parseCount(*(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(arg, "--size") and a + 1 < argc {
      size = parseCount(*(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(arg, "--screenshot") and a + 1 < argc {
      screenshot = cstrString(*(argv + usize.from(a + 1)));
      a = a + 1;
    } elif cstrEquals(arg, "--maps") and a + 1 < argc {
      mapsDir = cstrString(*(argv + usize.from(a + 1)));
      a = a + 1;
    } else {
      print <- "Unknown argument; use --frames N, --size N, --screenshot FILE and --maps DIR\n";
      return 2;
    }
    a = a + 1;
  }
  if maxFrames < 0 or size < 8 {
    print <- "--frames wants a whole number, --size one of 8 or more\n";
    return 2;
  }
  mut checkFrame = CHECK_FRAME;
  if maxFrames > 0 and maxFrames - 2 < checkFrame { checkFrame = maxFrames - 2; }
  if checkFrame < 0 { checkFrame = 0; }

  // The bakes, on the CPU
  imm frequency = f64.from(sdl.GetPerformanceFrequency());
  imm metal = paintedMetal();
  imm stone = weatheredStone();
  imm copper = hammeredCopper();
  imm t0 = sdl.GetPerformanceCounter();
  imm metalSet = bakeTextureSet(&metal, size);
  imm t1 = sdl.GetPerformanceCounter();
  imm stoneSet = bakeTextureSet(&stone, size);
  imm t2 = sdl.GetPerformanceCounter();
  imm copperSet = bakeTextureSet(&copper, size);
  imm t3 = sdl.GetPerformanceCounter();
  print <- "Baked "; print <- size; print <- " x "; print <- size; print <- " tiles on the CPU: painted metal ";
  print <- f64.from(t1 - t0) / frequency * 1000.; print <- " ms, stone "; print <- f64.from(t2 - t1) / frequency * 1000.;
  print <- " ms, copper "; print <- f64.from(t3 - t2) / frequency * 1000.; print <- " ms\n";
  print <- "Map hashes (base colour, ORM, normal): metal "; print <- mapHash(&metalSet.baseColor); print <- " ";
  print <- mapHash(&metalSet.orm); print <- " "; print <- mapHash(&metalSet.normal); print <- "\n";
  mut mapsWritten = true;
  if mapsDir.len() > 0usize {
    print <- "Maps:\n";
    mapsWritten = saveSet(&mapsDir, "metal", &metalSet) and mapsWritten;
    mapsWritten = saveSet(&mapsDir, "stone", &stoneSet) and mapsWritten;
    mapsWritten = saveSet(&mapsDir, "copper", &copperSet) and mapsWritten;
  }

  // The meshes: a sphere whose uvs go twice round its equator and once
  // from pole to pole, so the tile's texels are square at the equator; a
  // ground 16 across, the tile four times each way
  mut ballMesh = Mesh.sphere(1., 96);
  mut i = 0usize;
  while i < ballMesh.uvs.len() {
    imm uv = *ballMesh.uvs[i];
    ballMesh.uvs.set(i, new Vec2(uv.x * 2., uv.y));
    i = i + 1usize;
  }
  imm groundMesh = Mesh.plane(8, 4.);

  // The window and the GPU
  mut win = Window.openVulkan("Cone: pbrmaterial's baked textures");
  if !win.isOpen() {
    print <- "No window could be opened\n";
    return 1;
  }
  mut instance = Instance.create("spheres");
  if !instance.isValid() {
    print <- "No Vulkan 1.3 instance could be made\n";
    return 1;
  }
  mut surface = instance.createSurface(win.sdlHandle());
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm powerEnv = libc.getenv("GPU_POWER_PREFERENCE");
  if (powerEnv as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(powerEnv), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&surface, preference);
  if !adapter.isValid() {
    print <- "No GPU can draw to the window\n";
    return 1;
  }
  print <- "Adapter: "; printStr(adapter.name.view()); print <- "\n";
  print <- "Validation layer: "; printStr(onOff(instance.validation)); print <- "\n";
  mut device = adapter.requestDevice();
  imm winSize = win.size();
  mut swapchain = device.createSwapChain(&surface, u32.from(winSize.w), u32.from(winSize.h), TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut renderer = Renderer.create(&mut device, TEXTURE_FORMAT_RGBA16_FLOAT, TEXTURE_FORMAT_DEPTH32_FLOAT);
  mut post = Post.create(&mut device, swapchain.format, u32.from(winSize.w), u32.from(winSize.h));
  if !renderer.isValid() or !post.isValid() {
    print <- "The renderer could not be made\n";
    return 1;
  }

  // A low sun from the right and a little behind the camera, so the relief
  // casts its shading across the spheres
  imm sky = Sky.dusk(radians(18.), radians(65.));
  renderer.setSky(&mut device, &sky);
  imm light = sky.sunLight(new Color(3.2, 2.7, 2.2, 1.), new Color(0.05, 0.05, 0.06, 1.));
  renderer.environmentStrength = 1.6;

  imm ball = renderer.addMesh(&mut device, &ballMesh);
  imm ground = renderer.addMesh(&mut device, &groundMesh);
  imm metalM = upload(&mut renderer, &mut device, &metalSet);
  imm stoneM = upload(&mut renderer, &mut device, &stoneSet);
  imm copperM = upload(&mut renderer, &mut device, &copperSet);

  mut camera = Camera.make();
  camera.fov = radians(38.);
  camera.near = 0.2;
  camera.far = 100.;
  camera.lookAt(new Vec3(0., 2.0, 7.4), new Vec3(0., 0.9, 0.), new Vec3(0., 1., 0.));

  mut list = DrawList.empty();
  mut frames = 0;
  mut unshown = 0;
  mut checked = 0;               // 0 not yet, 1 the full frame read, 2 both read
  mut checksPassed = true;
  mut shotsWritten = true;
  mut fullDetail = new Array[i64, 3] <- fill 0i64;
  while win.running and (maxFrames == 0 or frames < maxFrames) {
    mut event = sdl.Event.empty();
    while win.pollEvent(&mut event) {}
    if win.resized {
      imm s = win.size();
      swapchain.resize(u32.from(s.w), u32.from(s.h));
      win.resized = false;
    }
    imm frame = swapchain.getCurrentTexture(&mut device);
    if !frame.ok() {
      sdl.Delay(10u32);
    } else {
      imm w = frame.texture.width;
      imm h = frame.texture.height;
      imm t = f32.from(frames) / 60.;
      post.resize(&mut device, w, h);
      // The spheres turn slowly about the vertical; the second frame of the
      // check is drawn at the first's time, without the normal maps
      imm noNormals = checked == 1;
      mut turnTime = t;
      if noNormals { turnTime = f32.from(checkFrame) / 60.; }
      imm turn = Quat.angleAxis(turnTime * 0.25, new Vec3(0., 1., 0.));
      imm one = new Vec3(1., 1., 1.);
      list.clear();
      list.add(ball, if noNormals { metalM.noNormal; } else { metalM.full; }, Mat4.fromTrs(new Vec3(0. - SPACING, 1., 0.), turn, one));
      list.add(ball, if noNormals { stoneM.noNormal; } else { stoneM.full; }, Mat4.fromTrs(new Vec3(0., 1., 0.), turn, one));
      list.add(ball, if noNormals { copperM.noNormal; } else { copperM.full; }, Mat4.fromTrs(new Vec3(SPACING, 1., 0.), turn, one));
      list.add(ground, if noNormals { stoneM.noNormal; } else { stoneM.full; }, Mat4.fromScale(new Vec3(8., 1., 8.)));

      mut encoder = device.createCommandEncoder();
      renderer.render(&mut device, &mut encoder, &post.hdr, &frame.depth, &camera, &light, &list);
      post.apply(&mut encoder, &frame.texture);
      imm bgra = frame.texture.format == TEXTURE_FORMAT_BGRA8_UNORM_SRGB
        or frame.texture.format == TEXTURE_FORMAT_BGRA8_UNORM;
      imm readNow = (frames >= checkFrame and checked == 0) or checked == 1;
      if readNow {
        mut readback = device.createBuffer(u64.from(w) * u64.from(h) * 4u64, BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);
        encoder.copyTextureToBuffer(&frame.texture, &readback);
        device.queue.submit(encoder.finish());
        if !swapchain.present(&mut device) { unshown = unshown + 1; }
        device.waitIdle();
        imm p = readback.mappedRange();
        imm viewProjection = camera.projectionMatrix(f32.from(w) / f32.from(h)) * camera.viewMatrix();
        imm r = i32.from(h / 16u32);
        imm names Array[&Array[u8], 3] = ["painted metal", "stone", "copper"];
        mut k = 0;
        while k < 3 {
          mut cx = 0;
          mut cy = 0;
          pixelOf(viewProjection, new Vec3(SPACING * f32.from(k - 1), 1., 0.), w, h, &mut cx, &mut cy);
          imm d = detail(p, w, h, cx, cy, r);
          if checked == 0 {
            fullDetail[usize.from(k)] = d;
          } else {
            imm withMaps = fullDetail[usize.from(k)];
            imm ok = withMaps > d;
            print <- "  "; printStr(names[usize.from(k)]); print <- ": detail "; print <- withMaps;
            print <- " with its normal map, "; print <- d; print <- " without";
            if ok { print <- ": more with\n"; } else { print <- ": NOT more with\n"; }
            if !ok { checksPassed = false; }
          }
          k = k + 1;
        }
        if screenshot.len() > 0usize {
          mut name = screenshot.copy();
          if checked == 1 { name = shotName(&screenshot, "-nonormal"); }
          imm shot = Image.fromTexels(p, i32.from(w), i32.from(h), bgra);
          imm written = shot.save(name.view());
          print <- "Screenshot: "; printStr(name.view());
          if written { print <- "\n"; } else { print <- " could NOT be written\n"; }
          if !written { shotsWritten = false; }
        }
        if checked == 0 {
          print <- "Frame "; print <- frames; print <- " ("; print <- u64.from(w); print <- " x "; print <- u64.from(h);
          print <- "), "; print <- u64.from(renderer.drawCalls); print <- " draws; the detail over each sphere's middle:\n";
        }
        checked = checked + 1;
      } else {
        device.queue.submit(encoder.finish());
        if !swapchain.present(&mut device) { unshown = unshown + 1; }
      }
      frames = frames + 1;
    }
  }
  device.waitIdle();

  print <- "Frames drawn: "; print <- frames; print <- "; out of date when presented: "; print <- unshown; print <- "\n";
  print <- "Vulkan failures: "; print <- u64.from(failures());
  print <- "; validation messages: "; print <- u64.from(validationMessages()); print <- "\n";
  if checked < 2 and maxFrames != 1 { print <- "The frames were not checked\n"; }
  if !checksPassed or !shotsWritten or !mapsWritten {
    print <- "FAILED\n";
    return 1;
  }
  if failures() != 0u32 or validationMessages() != 0u32 { return 1; }
  print <- "OK\n";
  0;
}
