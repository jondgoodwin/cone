// 'mul' (Karatsuba from 64 limbs up) against a small O(n^2) schoolbook reference written here on
// 32-bit digits, on random operands from a fixed seed, with limb counts either side of the
// threshold (64), balanced and not, including all-ones and zero runs (which reach the carries
// of the middle product).

mod karatsuba;

import testing use *;
import collections use *;
import bigint use BigUint;
import random;

fn draw(rng: &mut random.Rng, limbCount: usize, runs: bool) BigUint {
  var l = List[u64]();
  var i = 0usize;
  while i < limbCount {
    let kind = if runs { rng.below(5u64) } else { 9u64 };
    if kind == 0u64 { l.push(0xFFFFFFFFFFFFFFFFu64); }
    else if kind == 1u64 { l.push(0u64); }
    else { l.push(rng.next()); }
    i = i + 1usize;
  }
  BigUint.fromLimbs(l)
}

fn digits(x: &BigUint) List[u64] {
  let v = x.limbView();
  var d = List[u64]();
  var i = 0usize;
  while i < v.len() {
    d.push(v[i] & 0xFFFFFFFFu64);
    d.push(v[i] >> 32u64);
    i = i + 1usize;
  }
  d
}

// The reference product: 32-bit digits, every partial sum within a u64
fn reference(a: &BigUint, b: &BigUint) BigUint {
  let x = digits(a);
  let y = digits(b);
  var out = List[u64]();
  out.resize(x.len() + y.len() + 1usize, 0u64);
  var i = 0usize;
  while i < x.len() {
    var carry = 0u64;
    var j = 0usize;
    while j < y.len() {
      let t = *out[i + j] + *x[i] * *y[j] + carry;
      out.set(i + j, t & 0xFFFFFFFFu64);
      carry = t >> 32u64;
      j = j + 1usize;
    }
    out.set(i + y.len(), carry);
    i = i + 1usize;
  }
  var l = List[u64]();
  i = 0usize;
  while i + 1usize < out.len() {
    l.push(*out[i] | (*out[i + 1usize] << 32u64));
    i = i + 2usize;
  }
  BigUint.fromLimbs(l)
}

fn agree(a: &BigUint, b: &BigUint) bool {
  let r = reference(a, b);
  a.mul(b).cmp(&r) == 0i32 && b.mul(a).cmp(&r) == 0i32
}

fn main() i32 {
  var rng = random.Rng.fromSeed(31337u64);
  var bad = 0i32;
  let sizes = [1usize, 5usize, 31usize, 63usize, 64usize, 65usize, 96usize, 127usize, 128usize, 129usize, 200usize, 257usize];
  var i = 0usize;
  while i < 12usize {
    var j = 0usize;
    while j < 12usize {
      let a = draw(&mut rng, sizes[i], (i + j) % 2usize == 0usize);
      let b = draw(&mut rng, sizes[j], (i + j) % 3usize == 0usize);
      if !agree(&a, &b) { bad = bad + 1i32; }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  expectInt(i64.from(bad), 0i64, "144 size pairs");

  // All ones squared: (2^k - 1)^2, the worst carries
  var ones = List[u64]();
  var n = 0usize;
  while n < 200usize { ones.push(0xFFFFFFFFFFFFFFFFu64); n = n + 1usize; }
  let m = BigUint.fromLimbs(ones);
  expect(agree(&m, &m), "all-ones squared");
  expect(agree(&m, &BigUint.zero()), "times zero");
  expect(agree(&m, &BigUint.one()), "times one");
  done()
}
