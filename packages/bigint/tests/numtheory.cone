// pow, modPow (Montgomery for odd moduli, plain for even), gcd and modInverse: known values from
// Python's integers (not this package), and identities against u64 arithmetic.

mod numtheory;

import testing use *;
import collections use *;
import bigint use BigUint, BigInt, BigUintError;

fn big(t: &str) BigUint {
  match BigUint.parse(t) {
    case let Ok(n) { n }
    case is Err { BigUint.zero() }
  }
}

fn sgn(t: &str) BigInt {
  match BigInt.parse(t) {
    case let Ok(n) { n }
    case is Err { BigInt.zero() }
  }
}

fn text(n: &BigUint) String {
  var s = String();
  s <- *n;
  s
}

fn stext(n: &BigInt) String {
  var s = String();
  s <- *n;
  s
}

fn unwrap(r: Result[BigUint, BigUintError]) BigUint {
  match r {
    case let Ok(n) { n }
    case is Err { BigUint.zero() }
  }
}

fn sunwrap(r: Result[BigInt, BigUintError]) BigInt {
  match r {
    case let Ok(n) { n }
    case is Err { BigInt.zero() }
  }
}

fn small(x: &BigInt) i64 {
  match x.toI64() {
    case let Some(v) { v }
    case is None { 999i64 }
  }
}

fn eqs(a: &str, b: &str) bool {
  let x: &Array[u8] = a;
  let y: &Array[u8] = b;
  if x.len() != y.len() { return false; }
  var i = 0usize;
  while i < x.len() { if x[i] != y[i] { return false; } i = i + 1usize; }
  true
}

fn word(x: &BigUint) u64 {
  match x.toU64() {
    case let Some(v) { v }
    case is None { 0u64 }
  }
}

// (a * b) % m on u64 for m below 2^32
fn mulmod(a: u64, b: u64, m: u64) u64 { (a % m) * (b % m) % m }

fn powmod64(b: u64, e: u64, m: u64) u64 {
  var r = 1u64 % m;
  var base = b % m;
  var k = e;
  while k > 0u64 {
    if (k & 1u64) == 1u64 { r = mulmod(r, base, m); }
    base = mulmod(base, base, m);
    k = k >> 1u64;
  }
  r
}

fn gcd64(a: u64, b: u64) u64 {
  var x = a;
  var y = b;
  while y != 0u64 { let t = x % y; x = y; y = t; }
  x
}

fn remOfProd(a: &BigUint, b: &BigUint, m: &BigUint) BigUint {
  match a.mul(b).divmod(m) {
    case let Ok(qr) { qr.rem.clone() }
    case is Err { BigUint.zero() }
  }
}

fn main() i32 {
  expectStr(text(&BigUint.fromU64(3u64).pow(200u32)).view(), "265613988875874769338781322035779626829233452653394495974574961739092490901302182994384699044001", "3^200");
  expectStr(text(&BigUint.zero().pow(0u32)).view(), "1", "0^0 is 1");
  expectStr(text(&BigUint.zero().pow(5u32)).view(), "0", "0^5");
  expectStr(text(&big("123456789012345678901234567890").pow(1u32)).view(), "123456789012345678901234567890", "x^1");
  expectStr(stext(&BigInt.fromI64(-3i64).pow(5u32)).view(), "-243", "(-3)^5");
  expectStr(stext(&BigInt.fromI64(-2i64).pow(64u32)).view(), "18446744073709551616", "(-2)^64");
  expectStr(stext(&BigInt.fromI64(0i64).pow(3u32)).view(), "0", "0^3 is not negative");
  let b4 = big("");
  let e4 = big("");
  let m4 = big("");
  expectStr(text(&unwrap(b4.modPow(&e4, &m4))).view(), "", "4096-bit modPow, odd modulus (Montgomery)");
  expectStr(text(&unwrap(m4.add(&BigUint.fromU64(5u64)).modPow(&BigUint.fromU64(65537u64), &m4))).view(), "", "base above the modulus, e = 65537");
  expectStr(text(&unwrap(big("").modPow(&big(""), &big("")))).view(), "", "1024-bit modPow, even modulus");
  expectStr(text(&unwrap(BigUint.fromU64(3u64).modPow(&BigUint.fromU64(1000u64), &BigUint.one().shiftLeft(100usize)))).view(), "551974362378181658252953541409", "3^1000 mod 2^100");
  expectStr(text(&unwrap(b4.modPow(&BigUint.zero(), &m4))).view(), "1", "x^0 mod m");
  expectStr(text(&unwrap(b4.modPow(&e4, &BigUint.one()))).view(), "0", "mod 1");
  expectStr(text(&unwrap(BigUint.zero().modPow(&e4, &m4))).view(), "0", "0^e mod m");
  match b4.modPow(&e4, &BigUint.zero()) {
    case is Err { expect(true, "modPow by zero is refused"); }
    case is Ok { expect(false, "modPow by zero is refused"); }
  }
  expectStr(text(&unwrap(big("2").modPow(&big("1000000000000000000000000000000"), &big("170141183460469231731687303715884105727")))).view(), "4294967296", "modPow small case");
  expectStr(text(&unwrap(big("12345678901234567890123").modPow(&big("1606938044258990275541962092341162602522202993782792835301383"), &big("6864797660130609714981900799081393217269435300143305409394463459185543183397656052122559640661454554977296311391480858037121987999716643812574028291115057151")))).view(), "4017265626930613998450981855649857531762782637691808486008892043396257643686463452150096424950365517302540909560942965451288241448370954808095998370908010904", "modPow small case");
  expectStr(text(&unwrap(big("7").modPow(&big("3"), &big("18446744073709551629")))).view(), "343", "modPow small case");
  expectStr(text(&unwrap(big("99").modPow(&big("18446744073709551616"), &big("18446744073709551557")))).view(), "6516334424841167945", "modPow small case");
  expectStr(text(&unwrap(big("5").modPow(&big("18446744073709551615"), &big("18446744073709551615")))).view(), "17560474039518003440", "modPow small case");
  expectStr(stext(&sunwrap(sgn("-1115982052932607395390625648037990070285935733101808080449532779078015912359929034134810981").modPow(&sgn("707287088466032749127625993601"), &sgn("60452459035924760245268826465202627737059899009780893649808481536615381181239")))).view(), "-32438954295281245871021600030673825059825976622373738445502281386921282181310", "BigInt modPow, negative base, odd exponent");
  expectStr(stext(&sunwrap(sgn("-1115982052932607395390625648037990070285935733101808080449532779078015912359929034134810981").modPow(&sgn("707287088466032749127625993602"), &sgn("60452459035924760245268826465202627737059899009780893649808481536615381181239")))).view(), "10530242487083676265009016605696631688350227140788939672246389600151313984225", "BigInt modPow, negative base, even exponent");
  match BigInt.fromI64(3i64).modPow(&BigInt.fromI64(-1i64), &BigInt.fromI64(7i64)) {
    case let Err(x) { expect(x.kind == bigint.BigUintErrorKind.NegativeExponent, "negative exponent is refused"); }
    case is Ok { expect(false, "negative exponent is refused"); }
  }
  // modPow, gcd and modInverse against u64 arithmetic, odd and even moduli below 2^32
  var seed = 88172645463325252u64;
  var bad = 0i32;
  var round = 0i32;
  while round < 400i32 {
    seed = seed * 6364136223846793005u64 + 1442695040888963407u64;
    let m = ((seed >> 20u64) % 4294967290u64) + 2u64;
    seed = seed * 6364136223846793005u64 + 1442695040888963407u64;
    let b = seed >> 11u64;
    seed = seed * 6364136223846793005u64 + 1442695040888963407u64;
    let e = (seed >> 40u64) + 1u64;
    let got = unwrap(BigUint.fromU64(b).modPow(&BigUint.fromU64(e), &BigUint.fromU64(m)));
    if got.cmp(&BigUint.fromU64(powmod64(b, e, m))) != 0i32 { bad = bad + 1i32; }
    let g = BigUint.fromU64(b).gcd(&BigUint.fromU64(m));
    if g.cmp(&BigUint.fromU64(gcd64(b, m))) != 0i32 { bad = bad + 1i32; }
    match BigUint.fromU64(b).modInverse(&BigUint.fromU64(m)) {
      case let Some(x) {
        if gcd64(b, m) != 1u64 { bad = bad + 1i32; }
        else if mulmod(b, word(&x), m) != 1u64 || x.cmp(&BigUint.fromU64(m)) >= 0i32 { bad = bad + 1i32; }
      }
      case is None { if gcd64(b, m) == 1u64 { bad = bad + 1i32; } }
    }
    round = round + 1i32;
  }
  expectInt(i64.from(bad), 0i64, "400 rounds of modPow, gcd and modInverse against u64");
  expectStr(text(&big("1302771543063561170699830698101805276159225842563764783757509").mul(&big("6426961639747072175377983175048924926555132597591035349737260662151213148988487188979417919153832179903546179420898047376767122026197668375067990232617745039127290383373047805864536553957867054815600927832576591816980886228588365407326073220368871687548841748186512102118")).gcd(&big("1302771543063561170699830698101805276159225842563764783757509").mul(&big("3466522276422358205371320692440936214014847316457790630697968527872372693207990646212558688897366908017306041190516658217446752109744518735855370838756847934441903586364077596677246229595905076199416479995774804")))).view(), "2605543086127122341399661396203610552318451685127529567515018", "gcd of big multiples");
  expectStr(text(&BigUint.zero().gcd(&BigUint.zero())).view(), "0", "gcd(0, 0)");
  expectStr(text(&BigUint.zero().gcd(&big("12"))).view(), "12", "gcd(0, 12)");
  expectStr(stext(&BigInt.fromI64(-12i64).gcd(&BigInt.fromI64(18i64))).view(), "6", "signed gcd is positive");
  let n2 = big("");
  let a2 = big("");
  match a2.modInverse(&n2) {
    case let Some(x) {
      expectStr(text(&x).view(), "", "2048-bit modInverse");
      expectStr(text(&remOfProd(&a2, &x, &n2)).view(), "1", "a * inverse = 1 mod n");
    }
    case is None { expect(false, "2048-bit modInverse exists"); }
  }
  match BigUint.fromU64(6u64).modInverse(&BigUint.fromU64(9u64)) {
    case is None { expect(true, "6 has no inverse mod 9"); }
    case is Some { expect(false, "6 has no inverse mod 9"); }
  }
  match BigUint.fromU64(3u64).modInverse(&BigUint.fromU64(10u64)) {
    case let Some(x) { expectStr(text(&x).view(), "7", "3^-1 mod 10 (even modulus)"); }
    case is None { expect(false, "3^-1 mod 10"); }
  }
  match BigUint.fromU64(5u64).modInverse(&BigUint.zero()) {
    case is None { expect(true, "no inverse mod 0"); }
    case is Some { expect(false, "no inverse mod 0"); }
  }
  match BigInt.fromI64(-3i64).modInverse(&BigInt.fromI64(7i64)) {
    case let Some(x) { expectStr(stext(&x).view(), "2", "(-3)^-1 mod 7"); }
    case is None { expect(false, "(-3)^-1 mod 7"); }
  }
  match BigInt.fromI64(3i64).modInverse(&BigInt.fromI64(-7i64)) {
    case let Some(x) { expectStr(stext(&x).view(), "5", "3^-1 mod -7 uses |m|"); }
    case is None { expect(false, "3^-1 mod -7"); }
  }
  done()
}
