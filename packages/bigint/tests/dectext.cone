// toText divides and conquers by powers of 10 above a few dozen limbs: it must agree with the
// word-at-a-time path (toTextBase) and with Python on 2000!, on 10^k and 10^k - 1 around every
// split width, and round-trip through parse.

mod dectext;

import testing use *;
import collections use *;
import bigint use BigUint, BigInt, BigUintError;

fn big(t: &str) BigUint {
  match BigUint.parse(t) {
    case let Ok(n) { n }
    case is Err { BigUint.zero() }
  }
}

fn sgn(t: &str) BigInt {
  match BigInt.parse(t) {
    case let Ok(n) { n }
    case is Err { BigInt.zero() }
  }
}

fn text(n: &BigUint) String {
  var s = String();
  s <- *n;
  s
}

fn stext(n: &BigInt) String {
  var s = String();
  s <- *n;
  s
}

fn unwrap(r: Result[BigUint, BigUintError]) BigUint {
  match r {
    case let Ok(n) { n }
    case is Err { BigUint.zero() }
  }
}

fn sunwrap(r: Result[BigInt, BigUintError]) BigInt {
  match r {
    case let Ok(n) { n }
    case is Err { BigInt.zero() }
  }
}

fn small(x: &BigInt) i64 {
  match x.toI64() {
    case let Some(v) { v }
    case is None { 999i64 }
  }
}

fn eqs(a: &str, b: &str) bool {
  let x: &Array[u8] = a;
  let y: &Array[u8] = b;
  if x.len() != y.len() { return false; }
  var i = 0usize;
  while i < x.len() { if x[i] != y[i] { return false; } i = i + 1usize; }
  true
}

fn word(x: &BigUint) u64 {
  match x.toU64() {
    case let Some(v) { v }
    case is None { 0u64 }
  }
}

fn viaBase(n: &BigUint) String {
  var s = String();
  n.toTextBase(&uni s.textOut(), 10u32);
  s
}

fn factorial(n: u64) BigUint {
  var f = BigUint.one();
  var i = 2u64;
  while i <= n { f = f.mulSmall(i); i = i + 1u64; }
  f
}

fn digitSum(s: &str) u64 {
  let b: &Array[u8] = s;
  var t = 0u64;
  var i = 0usize;
  while i < b.len() { t = t + u64.from(b[i]) - 48u64; i = i + 1usize; }
  t
}

fn main() i32 {
  let f = text(&factorial(2000u64));
  expectUInt(u64.from(f.len()), 5736u64, "2000! digits");
  expectUInt(digitSum(f.view()), 23382u64, "2000! digit sum");
  expectStr(f.view(), "", "2000!");
  // 10^k and 10^k - 1 for widths near every split (19 * 2^j) and a spread of sizes
  var bad = 0i32;
  var k = 150usize;
  while k < 2500usize {
    let p = BigUint.fromU64(10u64).pow(u32.from(k));
    let q = unwrap(p.sub(&BigUint.one()));
    if !eqs(text(&p).view(), viaBase(&p).view()) { bad = bad + 1i32; }
    if !eqs(text(&q).view(), viaBase(&q).view()) { bad = bad + 1i32; }
    match BigUint.parse(text(&q).view()) {
      case let Ok(r) { if r.cmp(&q) != 0i32 { bad = bad + 1i32; } }
      case is Err { bad = bad + 1i32; }
    }
    k = k + 97usize;
  }
  expectInt(i64.from(bad), 0i64, "10^k and 10^k-1 against the word path and parse");
  expectUInt(u64.from(text(&BigUint.fromU64(10u64).pow(722u32)).len()), 723u64, "10^722 has 723 digits");
  expectUInt(u64.from(text(&BigUint.fromU64(10u64).pow(1520u32)).len()), 1521u64, "10^1520 has 1521 digits");
  // numbers whose halves have leading zeros: 10^(19*2^j) + 1 and 10^(19*2^j) * 7 + 3
  var j = 5u32;
  while j < 8u32 {
    let w = BigUint.fromU64(10u64).pow(19u32 << j);
    let v = w.add(&BigUint.one());
    let u = w.mulSmall(7u64).add(&BigUint.fromU64(3u64));
    if !eqs(text(&v).view(), viaBase(&v).view()) { bad = bad + 1i32; }
    if !eqs(text(&u).view(), viaBase(&u).view()) { bad = bad + 1i32; }
    j = j + 1u32;
  }
  expectInt(i64.from(bad), 0i64, "numbers with zero halves");
  expectStr(stext(&BigInt.fromParts(true, factorial(500u64))).view(), "-", "negative 500! text");
  done()
}
