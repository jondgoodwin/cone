// Finds the Karatsuba threshold: for each limb count n, the nanoseconds of one n x n multiplication
// by schoolbook and by Karatsuba with thresholds 8, 16, 32 and 64. Direction only: a loaded machine
// or a debug build moves the numbers.
//
//   congo run --release examples/thresholdbench.cone

mod thresholdbench;

import stdio use *;
import collections use *;
import time use Instant;
import random;
import bigint use BigUint;

fn operand(limbCount: usize, seed: u64) BigUint {
  var state = seed;
  var l = List[u64]();
  var i = 0usize;
  while i < limbCount {
    l.push(random.splitMix64(&mut state));
    i = i + 1usize;
  }
  BigUint.fromLimbs(l)
}

// threshold 0 means schoolbook
fn nsFor(a: &BigUint, b: &BigUint, threshold: usize, reps: i64) i64 {
  var p = if threshold == 0usize { a.mulSchoolbook(b) } else { a.mulKaratsuba(b, threshold) };
  let start = Instant.now();
  var r = 0i64;
  while r < reps {
    p = if threshold == 0usize { a.mulSchoolbook(b) } else { a.mulKaratsuba(b, threshold) };
    r = r + 1i64;
  }
  start.elapsed().nanos() / reps
}

fn row(n: usize) {
  let a = operand(n, 1u64);
  let b = operand(n, 2u64);
  let reps = 4000000i64 / i64.from(n * n) + 3i64;
  printStr("limbs ");
  printInt(i64.from(n));
  printStr("  school ");
  printInt(nsFor(&a, &b, 0usize, reps));
  printStr("  k8 ");
  printInt(nsFor(&a, &b, 8usize, reps));
  printStr("  k16 ");
  printInt(nsFor(&a, &b, 16usize, reps));
  printStr("  k32 ");
  printInt(nsFor(&a, &b, 32usize, reps));
  printStr("  k64 ");
  printInt(nsFor(&a, &b, 64usize, reps));
  printStr("\n");
}

fn main() i32 {
  row(16usize); row(24usize); row(32usize); row(40usize); row(48usize); row(64usize);
  row(96usize); row(128usize); row(256usize); row(512usize);
  0i32
}
