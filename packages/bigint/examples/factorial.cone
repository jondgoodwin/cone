// 25!, which does not fit a u64, and 2^200 - 1 in decimal and hex.
//
//   congo run examples/factorial.cone

mod factorial;

import stdio use *;
import collections use *;
import bigint;

fn main() i32 {
  var f = bigint.BigUint.one();
  var i = 2u64;
  while i <= 25u64 { f = f.mulSmall(i); i = i + 1u64; }
  var s = String();
  s <- f;
  printStr(s.view());
  printStr("\n");

  let big = bigint.BigUint.one().shiftLeft(200usize);
  match big.sub(&bigint.BigUint.one()) {
    case let Ok(m) {
      var t = String();
      t <- m;
      printStr(t.view());
      printStr("\n");
      var h = String();
      m.toTextBase(&uni h.textOut(), 16u32);
      printStr(h.view());
      printStr("\n");
    }
    case let Err(e) {
      var msg = String();
      msg <- e;
      printStr(msg.view());
      return 1i32;
    }
  }
  0i32
}
