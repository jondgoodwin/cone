// Options CSV cannot work with are a program error, and a panic naming the option:
// .err pins the panic's line. A quote of LF, to a writer.

mod optionswriter;

import stdio use *;
import collections use *;
import csv;

fn main() i32 {
  var o = csv.WriteOptions.standard();
  o.quote = '\n';
  printStr("writing with the quote LF\n");
  var w = csv.Writer(o);
  printStr("not reached\n");
  0i32
}
