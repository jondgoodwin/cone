// Reading a table, printing its columns padded, and writing it back with quoting.
//
//   congo run examples/tour.cone

mod tour;

import stdio use *;
import collections use String;
import format use pad;
import csv;

fn main() i32 {
  var r = csv.reader("name,size,note\r\nbolt,12,\"M12, zinc\"\r\nnut,7,\"say \"\"hi\"\"\"\r\n");
  while true {
    match r.next() {
      case let Ok(o) {
        match o {
          case let Some(rec) {
            var line = String();
            var i = 0usize;
            while i < rec.len() {
              match rec.get(i) {
                case let Some(f) { line <- pad(f, 10usize); }
                case is None { }
              }
              i = i + 1usize;
            }
            printStr(line.view());
            printStr("|\n");
          }
          case is None { break; }
        }
      }
      case let Err(e) {
        let m = String() <- e;
        printStr(m.view());
        return 1i32;
      }
    }
  }
  var w = csv.Writer(csv.WriteOptions.standard());
  w.field("total");
  w.field("a, b");
  w.endRecord();
  match w.finish() {
    case let Ok(t) { printStr(t.view()); }
    case let Err(e) {
      let m = String() <- e;
      printStr(m.view());
      return 1i32;
    }
  }
  0i32
}
