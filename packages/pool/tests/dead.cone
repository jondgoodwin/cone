// 'pool[r]' of a reference whose value has been removed is a program error:
// the pool prints what was wrong to stderr and ends the program through the
// C library's 'abort', after writing out what was printed before. 'congo
// test' compares stdout, so this test's output is only the line printed
// before the index. Its .exit is the status the Microsoft C library's 'abort'
// ends a program with, 0xC0000409 (stderr, unchecked here, says: pool:
// pool[r] of a reference whose value has been removed). 'pool.get(r)' is the
// form that answers None instead.

mod dead;

import stdio use *;
import pool use *;

struct Pt { pub x i64; pub y i64; }

fn main() i32 {
  mut p = Pool[Pt].empty();
  imm r = p.add(Pt[1, 2]);
  p.remove(r);
  printStr("reading a removed value through pool[r]\n");
  printInt(p[r].x);
  printStr("not reached\n");
  0i32;
}
