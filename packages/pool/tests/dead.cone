// 'pool[r]' of a reference whose value has been removed is a program error,
// and a panic, after writing out what was printed before: this test's .out is
// only the line printed before the index. Its .exit is a panic's, the status
// the Microsoft C library's 'abort' ends a program with, 0xC0000409, and its
// .err the panic's line, naming the line of the index below: 'pool[r]'
// reports its caller's location, as 'panic' does.
// 'pool.get(r)' is the form that answers None instead.

mod dead;

import stdio use *;
import pool use *;

struct Pt { pub x i64; pub y i64; }

fn main() i32 {
  mut p = Pool[Pt].empty();
  imm r = p.add(Pt[1, 2]);
  p.remove(r);
  printStr("reading a removed value through pool[r]\n");
  printInt(p[r].x);
  printStr("not reached\n");
  0i32;
}
