// A pool gets its block of slots from the region it points to, grows it there
// and gives it back there. The region here is a counting one, three functions
// that call the C library and tally what they were asked: allocations,
// resizes, releases of a block, and the bytes handed out and not yet given
// back. A pool is made in it by passing it as the construction's last
// argument, 'new Pool[i64](region)'. Every expected count is worked out by
// hand from the growth rules:
// - a slot of Pool[i64] is a generation, a free-list link and the value: 16
//   bytes. The block starts at 4 slots, from a resize of nothing, then
//   doubles: ten values make 4, 8 and 16 slots, three resizes, the last block
//   256 bytes. 'new Pool[i64](10, r)' makes room for exactly ten (160 bytes)
//   at once, and an eleventh doubles it to twenty (320);
// - a slot of Pool[Spawner] is 8 bytes of generation and link and a 24-byte
//   value: 32. A value whose 'final' adds twenty more while it is dying in a
//   full block of four makes three larger blocks by allocating and copying,
//   not resizing, since the dying value must stay where it is: 8, 16 and 32
//   slots, 256, 512 and 1024 bytes. The three blocks it left, of 128, 256 and
//   512, go back to the region when its final has returned.

mod regions;

import testing use *;
import pool use *;
import libc;

struct Counting {
  header: MemRegion;
  allocs: usize;
  resizes: usize;
  releases: usize;
  live: isize;
}

fn countAlloc(r: *MemRegion, bytes: usize, align: usize) *u8 {
  let c = r as *Counting;
  (*c).allocs = (*c).allocs + 1usize;
  (*c).live = (*c).live + isize.from(bytes);
  libc.malloc(bytes)
}

fn countResize(r: *MemRegion, block: *u8, oldBytes: usize, newBytes: usize, align: usize) *u8 {
  let c = r as *Counting;
  (*c).resizes = (*c).resizes + 1usize;
  (*c).live = (*c).live + isize.from(newBytes) - isize.from(oldBytes);
  libc.realloc(block, newBytes)
}

fn countRelease(r: *MemRegion, block: *u8, bytes: usize) {
  if block as usize == 0usize { return; }
  let c = r as *Counting;
  (*c).releases = (*c).releases + 1usize;
  (*c).live = (*c).live - isize.from(bytes);
  libc.free(block);
}

fn newCounting() Counting {
  new Counting(new MemRegion(&countAlloc, &countResize, &countRelease), 0usize, 0usize, 0usize, 0isize)
}

fn regionOf(c: &mut Counting) *MemRegion { (c as *Counting) as *MemRegion }

fn tally(c: &Counting, allocs: u64, resizes: u64, releases: u64, live: i64, label: &Array[u8]) {
  let ok = u64.from(c.allocs) == allocs && u64.from(c.resizes) == resizes
    && u64.from(c.releases) == releases && i64.from(c.live) == live;
  expect(ok, label);
}

fn grows() {
  var c = newCounting();
  {
    var p = new Pool[i64](regionOf(&mut c));
    tally(&c, 0, 0, 0, 0, "an empty pool in a region asks it for nothing");
    var last = Ref[i64].none();
    var i = 0i64;
    while i < 10i64 { last = p.add(i * 3i64); i = i + 1i64; }
    tally(&c, 0, 3, 0, 256, "ten values: blocks of 4, 8 and 16 slots, the last 256 bytes");
    expectInt(*p[last], 27, "the last value survived the moves");
    expectUInt(u64.from(p.len()), 10, "all ten are there");
  }
  tally(&c, 0, 3, 1, 0, "its death gave the block back");
}

fn capacity() {
  var c = newCounting();
  {
    var p = new Pool[i64](10usize, regionOf(&mut c));
    tally(&c, 0, 1, 0, 160, "a starting size makes the block at once, room for exactly ten");
    expectUInt(u64.from(p.capacity()), 10, "ten slots");
    var i = 0i64;
    while i < 10i64 { p.add(i); i = i + 1i64; }
    tally(&c, 0, 1, 0, 160, "ten values fit");
    p.add(10i64);
    tally(&c, 0, 2, 0, 320, "the eleventh doubles the block");
  }
  tally(&c, 0, 2, 1, 0, "its death gave the block back");
}

var @threadlocal log = 0i64;
var @threadlocal spawned = 0i64;

// Its death notes n (or counts it, if it is of the spawned kind, n = 2), then
// adds 'count' of the spawned kind, to the pool it reaches through 'home'
struct Spawner {
  pub n: i64;
  pub home: *u8;
  pub count: i64;
  fn final(self: &uni) {
    if n == 2i64 { spawned = spawned + 1i64; } else { log = log * 10i64 + n; }
    let p = (home as *Pool[Spawner]) as &mut Pool[Spawner];
    var k = 0i64;
    while k < count {
      p.add(new Spawner(2, home, 0));
      k = k + 1i64;
    }
  }
}

fn spawner(p: &mut Pool[Spawner], n: i64, count: i64) Ref[Spawner] {
  let home = (p as *Pool[Spawner]) as *u8;
  p.add(new Spawner(n, home, count))
}

fn growsWhileDying() {
  var c = newCounting();
  {
    var p = new Pool[Spawner](regionOf(&mut c));
    let a = spawner(&mut p, 1, 20);
    spawner(&mut p, 3, 0);
    spawner(&mut p, 3, 0);
    spawner(&mut p, 3, 0);
    tally(&c, 0, 1, 0, 128, "four values: one block of four slots, 128 bytes");
    p.remove(a);
    expectInt(log, 1, "one death");
    expectUInt(u64.from(p.len()), 23, "three left and twenty added");
    expectUInt(u64.from(p.capacity()), 32, "grown three times meanwhile");
    tally(&c, 3, 1, 3, 1024, "three blocks allocated and copied meanwhile, the three before them given back after");
  }
  tally(&c, 3, 1, 4, 0, "the pool's death gave back its block");
  expectInt(spawned, 20, "the twenty added all died with it");
}

fn sizes() {
  expectUInt(u64.from(mem.sizeof[Pool[i64]]()), 56, "a Pool is seven words and its region");
}

fn main() i32 {
  grows();
  capacity();
  growsWhileDying();
  sizes();
  done()
}
