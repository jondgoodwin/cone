// The one line each error of this package gives a person is pinned here, with
// the number fields at their widest, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import json;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

// A NumberError as the package hands one out, not narrowed to its variant
fn number(e: json.NumberError) String { String() <- e }

fn main() i32 {
  let a = json.JsonError(json.ErrorKind.UnexpectedByte, 5usize, 1u32, 9u32, String.from("expected a value"));
  says(String() <- a, "json: line 1, column 9: expected a value", "position");
  let b = json.JsonError(json.ErrorKind.UnexpectedByte, 5usize, 4000000000u32, 4294967295u32, String.from("x"));
  says(String() <- b, "json: line 4000000000, column 4294967295: x", "widest position");
  says(String() <- json.JsonError.shape("the tree is not an array"), "json: the tree is not an array", "shape, no position");
  says(number(json.NumberError.NotANumber), "the value is not a number", "NotANumber");
  says(number(json.NumberError.NotInteger), "the number is not a whole number", "NotInteger");
  says(number(json.NumberError.OutOfRange), "the number is outside the range of the type asked for", "OutOfRange");
  done()
}
