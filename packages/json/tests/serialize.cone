// JSON through core's serialization: toJson and fromJson over structs of numbers, strings and nested
// structs, and over List, Dict[String, V] and Deque, both ways; then malformed text and values of the
// wrong kind, which give a DataError, and fromJsonAt which says where in the text.

mod serialize;

import testing use *;
import collections use *;
import arena use *;
import json;

struct Pt { pub x: i32; pub y: i32; }
struct Nums { pub a: i8; pub b: u16; pub c: i64; pub d: u64; pub f: f32; pub g: f64; pub ok: bool; }
struct Line { pub name: String; pub from: Pt; pub to: Pt; }
struct Poly { pub label: String; pub pts: List[Pt]; pub tags: List[String]; }
struct Bag { pub counts: Dict[String, i64]; pub q: Deque[i32]; }
struct Grid { pub rows: List[List[i32]]; }

fn text(r: Result[String, json.JsonError]) String {
  match r {
    case let Ok(s) { s }
    case let Err(e) { String() <- e }
  }
}

fn dataText[T](r: Result[T, DataError]) String {
  match r {
    case is Ok { String.from("ok") }
    case let Err(e) { String() <- e }
  }
}

fn main() i32 {
  // Numbers, a bool, and the order of fields
  let n = Nums(-3i8, 7u16, -9000000000i64, 18000000000000000000u64, 1.5f32, -0.25, true);
  let nt = text(json.toJson(&n));
  expectStr(nt.view(), "{\"a\":-3,\"b\":7,\"c\":-9000000000,\"d\":18000000000000000000,\"f\":1.5,\"g\":-0.25,\"ok\":true}", "numbers written");
  match json.fromJson[Nums](nt.view()) {
    case let Ok(m) {
      expectInt(i64.from(m.a), -3i64, "a back");
      expectInt(i64.from(m.b), 7i64, "b back");
      expectInt(m.c, -9000000000i64, "c back");
      expectUInt(m.d, 18000000000000000000u64, "d back");
      expectFloat(f64.from(m.f), 1.5, 0.0, "f back");
      expectFloat(m.g, -0.25, 0.0, "g back");
      expect(m.ok, "ok back");
    }
    case let Err(e) { expectStr((String() <- e).view(), "<numbers>", "numbers read"); }
  }

  // Nested structs and strings, with escapes
  let line = Line(String.from("a \"b\"\n"), Pt(1, 2), Pt(-3, 4));
  let lt = text(json.toJson(&line));
  expectStr(lt.view(), "{\"name\":\"a \\\"b\\\"\\n\",\"from\":{\"x\":1,\"y\":2},\"to\":{\"x\":-3,\"y\":4}}", "nested written");
  match json.fromJson[Line](lt.view()) {
    case let Ok(m) {
      expectStr(m.name.view(), "a \"b\"\n", "name back");
      expectInt(i64.from(m.to.x), -3i64, "to.x back");
      expectInt(i64.from(m.from.y), 2i64, "from.y back");
    }
    case let Err(e) { expectStr((String() <- e).view(), "<line>", "line read"); }
  }

  // Members in another order, an unknown member (an object and an array nested in it) skipped
  match json.fromJson[Pt]("{\"zz\":{\"a\":[1,{\"b\":2}],\"c\":null},\"y\":5,\"x\":4,\"w\":[]}") {
    case let Ok(m) {
      expectInt(i64.from(m.x), 4i64, "reordered x");
      expectInt(i64.from(m.y), 5i64, "reordered y");
    }
    case let Err(e) { expectStr((String() <- e).view(), "<reorder>", "reordered read"); }
  }

  // A List of structs and a List of Strings, and the empty ones
  var poly = Poly(String.from("tri"), List[Pt](), List[String]());
  poly.pts.push(Pt(0, 0)); poly.pts.push(Pt(1, 0)); poly.pts.push(Pt(0, 1));
  poly.tags.push(String.from("a")); poly.tags.push(String.from("b"));
  let pt = text(json.toJson(&poly));
  expectStr(pt.view(), "{\"label\":\"tri\",\"pts\":[{\"x\":0,\"y\":0},{\"x\":1,\"y\":0},{\"x\":0,\"y\":1}],\"tags\":[\"a\",\"b\"]}", "list written");
  var arena = Arena();
  match json.fromJson[Poly](pt.view(), arena.region) {
    case let Ok(m) {
      expectUInt(u64.from(m.pts.len()), 3u64, "three points");
      expectInt(i64.from(m.pts[2usize].y), 1i64, "last point y");
      expectStr(m.tags[1usize].view(), "b", "second tag");
      expectStr(m.label.view(), "tri", "label in the arena");
    }
    case let Err(e) { expectStr((String() <- e).view(), "<poly>", "poly read"); }
  }
  expect(arena.blockCount() > 0usize, "the values were made in the arena's region");
  let empty = Poly(String(), List[Pt](), List[String]());
  expectStr(text(json.toJson(&empty)).view(), "{\"label\":\"\",\"pts\":[],\"tags\":[]}", "empty lists written");
  match json.fromJson[Poly]("{\"label\":\"\",\"pts\":[],\"tags\":[]}") {
    case let Ok(m) { expectUInt(u64.from(m.pts.len()), 0u64, "empty list back"); }
    case let Err(e) { expectStr((String() <- e).view(), "<empty>", "empty read"); }
  }

  // A Dict[String, V] and a Deque, and a List of Lists
  var bag = Bag(Dict[String, i64](), Deque[i32]());
  bag.counts.insert(String.from("one"), 1i64);
  bag.q.push(1); bag.q.push(2); bag.q.pushFront(0);
  let bt = text(json.toJson(&bag));
  expectStr(bt.view(), "{\"counts\":{\"one\":1},\"q\":[0,1,2]}", "dict and deque written");
  bag.counts.insert(String.from("two"), 2i64);
  let bt2 = text(json.toJson(&bag));
  match json.fromJson[Bag](bt2.view()) {
    case let Ok(m) {
      expectUInt(u64.from(m.counts.len()), 2u64, "two entries back");
      match m.counts.get("two") {
        case let Some(v) { expectInt(*v, 2i64, "entry two"); }
        case is None { expect(false, "entry two is there"); }
      }
      expectUInt(u64.from(m.q.len()), 3u64, "deque length back");
      expectInt(i64.from(*m.q.get(0usize).unwrap()), 0i64, "deque front back");
      expectInt(i64.from(*m.q.get(2usize).unwrap()), 2i64, "deque back back");
    }
    case let Err(e) { expectStr((String() <- e).view(), "<bag>", "bag read"); }
  }
  var grid = Grid(List[List[i32]]());
  var r0 = List[i32](); r0.push(1); r0.push(2);
  var r1 = List[i32]();
  grid.rows.push(r0); grid.rows.push(r1);
  expectStr(text(json.toJson(&grid)).view(), "{\"rows\":[[1,2],[]]}", "list of lists written");
  match json.fromJson[Grid]("{\"rows\":[[1,2],[],[3]]}") {
    case let Ok(m) {
      expectUInt(u64.from(m.rows.len()), 3u64, "three rows back");
      expectInt(i64.from(m.rows[2usize][0usize]), 3i64, "row two");
    }
    case let Err(e) { expectStr((String() <- e).view(), "<grid>", "grid read"); }
  }

  // A List at the top, and a lone number
  var top = List[i32]();
  top.push(7); top.push(8);
  expectStr(text(json.toJson(&top)).view(), "[7,8]", "a list at the top");
  match json.fromJson[List[i32]]("  [ 7 , 8 ]  ") {
    case let Ok(m) { expectInt(i64.from(m[1usize]), 8i64, "top list back"); }
    case let Err(e) { expectStr((String() <- e).view(), "<top>", "top list read"); }
  }
  expectStr(text(json.toJson(&42i32)).view(), "42", "a number at the top");

  // The pretty form passes through WriteOptions
  let pretty = text(json.toJsonWith(&Pt(1, 2), &json.WriteOptions(2usize, false)));
  expectStr(pretty.view(), "{\n  \"x\": 1,\n  \"y\": 2\n}", "indented");

  // Wrong kinds and missing members: a DataError naming the member
  expectStr(dataText(json.fromJson[Pt]("{\"x\":1}")).view(), "the member is missing (y)", "missing member");
  expectStr(dataText(json.fromJson[Line]("{\"name\":\"n\",\"from\":{\"x\":1},\"to\":{\"x\":1,\"y\":1}}")).view(), "from: the member is missing (y)", "missing nested member");
  expectStr(dataText(json.fromJson[Pt]("{\"x\":1.5,\"y\":1}")).view(), "x: expected a whole number", "a fraction for an integer");
  expectStr(dataText(json.fromJson[Pt]("{\"x\":\"1\",\"y\":1}")).view(), "x: expected a number", "text for a number");
  expectStr(dataText(json.fromJson[Pt]("{\"x\":99999999999,\"y\":1}")).view(), "x: the number does not fit the type", "too big for i32");
  expectStr(dataText(json.fromJson[Pt]("{\"x\":1e3,\"y\":1}")).view(), "ok", "1e3 is a whole number");
  expectStr(dataText(json.fromJson[Pt]("[1,2]")).view(), "expected an object", "an array for a struct");
  expectStr(dataText(json.fromJson[Poly]("{\"label\":\"x\",\"pts\":{},\"tags\":[]}")).view(), "pts: expected an array", "an object for a list");
  expectStr(dataText(json.fromJson[Poly]("{\"label\":\"x\",\"pts\":[],\"tags\":[1]}")).view(), "tags: expected a string", "a number for a string");
  expectStr(dataText(json.fromJson[Nums]("{\"a\":300,\"b\":1,\"c\":1,\"d\":1,\"f\":1,\"g\":1,\"ok\":true}")).view(), "a: the number does not fit the type", "300 for an i8");
  expectStr(dataText(json.fromJson[Nums]("{\"a\":1,\"b\":-1,\"c\":1,\"d\":1,\"f\":1,\"g\":1,\"ok\":true}")).view(), "b: the number does not fit the type", "-1 for a u16");
  expectStr(dataText(json.fromJson[Nums]("{\"a\":1,\"b\":1,\"c\":1,\"d\":1,\"f\":1,\"g\":1,\"ok\":1}")).view(), "ok: expected true or false", "a number for a bool");

  // Malformed text: Syntax, and fromJsonAt gives the offset, line and column
  expectStr(dataText(json.fromJson[Pt]("{\"x\":1,")).view(), "the text ends before the JSON value does", "text that ends");
  expectStr(dataText(json.fromJson[Pt]("{\"x\":1,\"y\":2} x")).view(), "text after the JSON value", "trailing text");
  expectStr(dataText(json.fromJson[Pt]("")).view(), "the text ends before the JSON value does", "empty text");
  var why = json.JsonError.none();
  let r1 = json.fromJsonAt[Pt]("{\"x\":1,\n \"y\":oops}", heapRegion(), &mut why);
  expect(r1 is Err, "malformed text is an error");
  expectUInt(u64.from(why.offset), 14u64, "offset of the bad byte");
  expectUInt(u64.from(why.line), 2u64, "its line");
  expectUInt(u64.from(why.column), 6u64, "its column");
  let r2 = json.fromJsonAt[Pt]("{\"x\":1,\"y\":\"s\"}", heapRegion(), &mut why);
  expect(r2 is Err, "a wrong kind is an error");
  expectUInt(u64.from(why.offset), 13u64, "offset of the wrong value");
  expectStr(why.reason.view(), "expected a number", "its reason");
  let r3 = json.fromJsonAt[Pt]("{\"x\":1}", heapRegion(), &mut why);
  expect(r3 is Err, "a missing member is an error");
  expectStr(why.reason.view(), "the member is missing (y)", "its reason, with the member");
  let r4 = json.fromJsonAt[Pt]("{\"x\":1,\"y\":2}   {", heapRegion(), &mut why);
  expect(r4 is Err, "trailing text is an error");
  expectUInt(u64.from(why.offset), 16u64, "offset of the trailing text");

  // A map whose key is not text cannot be written as JSON
  var odd = Dict[i32, i32]();
  odd.insert(1, 2);
  expectStr(text(json.toJson(&odd)).view(), "json: a map's key is not text: JSON names a member with a string", "a key that is not text");
  done()
}
