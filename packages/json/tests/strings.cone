// Strings: every escape decoded, '\u' escapes of every width including
// surrogate pairs (the ends of the pair range too), raw UTF-8 passed through,
// keys with escapes, a NUL; then written: controls as short escapes or
// '\u00XX', quote and backslash escaped, '/' and DEL and U+2028 left alone, and
// ASCII-only output with surrogate pairs; text that is not UTF-8 refused on the
// way out; and a string of all 128 ASCII characters round-tripping. Bytes are
// compared in hex, so an escape in this file's own literals is never what is
// being tested.

mod strings;

import testing use *;
import collections use *;
import json;

fn hexOf(s: &Array[u8]) String {
  var h = String.empty();
  var i = 0usize;
  while i < s.len {
    h.appendHex(u64.from(s[i]), 2usize);
    i = i + 1usize;
  }
  h
}

// The hex of the string the text holds (a text that is one string)
fn decoded(text: &str) String {
  match json.parse(text) {
    case let Ok(doc) {
      match doc.asText() {
        case let Some(s) { return hexOf(s); }
        case is None { return String.from("<not text>"); }
      }
    }
    case let Err(e) { return e.message(); }
  }
  String.empty()
}

fn reads(text: &str, hex: &str) {
  let got = decoded(text);
  expectStr(got.view(), hex, text);
}

// Written compact, the text a string value becomes
fn written(s: &str) String {
  let j = json.Json.fromText(s);
  match j.toText() {
    case let Ok(t) { t.copy() }
    case let Err(e) { e.message() }
  }
}

fn writtenAscii(s: &str) String {
  let j = json.Json.fromText(s);
  var w = json.Writer(json.WriteOptions(0usize, true));
  w.value(&j);
  match w.finish() {
    case let Ok(t) { t.copy() }
    case let Err(e) { e.message() }
  }
}

fn main() i32 {
  // -------- the short escapes --------
  reads("\"\\\"\"", "22");
  reads("\"\\\\\"", "5c");
  reads("\"\\/\"", "2f");
  reads("\"\\b\"", "08");
  reads("\"\\f\"", "0c");
  reads("\"\\n\"", "0a");
  reads("\"\\r\"", "0d");
  reads("\"\\t\"", "09");
  reads("\"a\\nb\\tc\"", "610a620963");
  reads("\"\"", "");
  reads("\"\\\\\\\\\"", "5c5c");
  reads("\"\\\\n\"", "5c6e");

  // -------- \u escapes --------
  reads("\"\\u0041\"", "41");
  reads("\"\\u0000\"", "00");
  reads("\"a\\u0000b\"", "610062");
  reads("\"\\u001f\"", "1f");
  reads("\"\\u007f\"", "7f");
  reads("\"\\u0080\"", "c280");
  reads("\"\\u00e9\"", "c3a9");
  reads("\"\\u00E9\"", "c3a9");
  reads("\"\\u07ff\"", "dfbf");
  reads("\"\\u0800\"", "e0a080");
  reads("\"\\u20AC\"", "e282ac");
  reads("\"\\ud7ff\"", "ed9fbf");
  reads("\"\\ue000\"", "ee8080");
  reads("\"\\uffff\"", "efbfbf");
  reads("\"\\ufffe\"", "efbfbe");
  reads("\"\\u2028\\u2029\"", "e280a8e280a9");
  // A pair: the clef, the grinning face, the first and the last beyond the BMP
  reads("\"\\uD834\\uDD1E\"", "f09d849e");
  reads("\"\\ud83d\\ude00\"", "f09f9880");
  reads("\"\\uD800\\uDC00\"", "f0908080");
  reads("\"\\uDBFF\\uDFFF\"", "f48fbfbf");
  reads("\"x\\uD83D\\uDE00y\\uD83D\\uDE00\"", "78f09f988079f09f9880");
  // Two escapes that are not a pair
  reads("\"\\u00e9\\u00e9\"", "c3a9c3a9");

  // -------- raw UTF-8 passes through --------
  reads("\"\xC3\xA9\xE2\x82\xAC\xF0\x9F\x98\x80\"", "c3a9e282acf09f9880");
  reads("\"\xEF\xBF\xBD\"", "efbfbd");
  reads("\"\x7F\"", "7f");
  reads("\"\xE2\x80\xA8\"", "e280a8");

  // -------- keys with escapes --------
  match json.parse("{\"\\u0061b\":1,\"c\\nd\":2,\"\\ud83d\\ude00\":3,\"\":4}") {
    case let Ok(doc) {
      expectInt(doc.i64Or("ab", -1i64), 1i64, "a key with a \\u escape");
      expectInt(doc.i64Or("c\nd", -1i64), 2i64, "a key with \\n");
      expectInt(doc.i64Or("\xF0\x9F\x98\x80", -1i64), 3i64, "a key that is a surrogate pair");
      expectInt(doc.i64Or("", -1i64), 4i64, "the empty key");
    }
    case let Err(e) { expect(false, "keys"); }
  }

  // -------- writing --------
  expectStr(written("hello").view(), "\"hello\"", "plain");
  expectStr(written("").view(), "\"\"", "empty");
  expectStr(written("a\"b").view(), "\"a\\\"b\"", "a quote");
  expectStr(written("a\\b").view(), "\"a\\\\b\"", "a backslash");
  expectStr(written("a/b").view(), "\"a/b\"", "a slash is left alone");
  expectStr(written("\x08\x0C\n\r\t").view(), "\"\\b\\f\\n\\r\\t\"", "the short escapes");
  expectStr(written("\x01\x02\x1F").view(), "\"\\u0001\\u0002\\u001f\"", "the other controls");
  expectStr(written("a\x00z").view(), "\"a\\u0000z\"", "a NUL");
  expectStr(written("\x7F").view(), "\"\x7F\"", "DEL is left alone");
  expectStr(written("\xE2\x80\xA8").view(), "\"\xE2\x80\xA8\"", "U+2028 is left alone");
  expectStr(written("\xC3\xA9\xE2\x82\xAC\xF0\x9F\x98\x80").view(), "\"\xC3\xA9\xE2\x82\xAC\xF0\x9F\x98\x80\"", "UTF-8 is written as it is");
  // ASCII-only output
  expectStr(writtenAscii("hello").view(), "\"hello\"", "ascii plain");
  expectStr(writtenAscii("\xC3\xA9").view(), "\"\\u00e9\"", "ascii: e acute");
  expectStr(writtenAscii("\xE2\x82\xAC").view(), "\"\\u20ac\"", "ascii: euro");
  expectStr(writtenAscii("\xF0\x9F\x98\x80").view(), "\"\\ud83d\\ude00\"", "ascii: a pair");
  expectStr(writtenAscii("\xF0\x9D\x84\x9E").view(), "\"\\ud834\\udd1e\"", "ascii: the clef");
  expectStr(writtenAscii("\xF4\x8F\xBF\xBF").view(), "\"\\udbff\\udfff\"", "ascii: the last character");
  expectStr(writtenAscii("\xC2\x80\x7F").view(), "\"\\u0080\x7F\"", "ascii: U+0080 escaped, DEL not");

  // -------- text that is not UTF-8 is not written --------
  var bad = String.from("ab");
  bad.appendByte(0xFFu8);
  expectStr(written(bad.view()).view(), "json: a string is not valid UTF-8 at its byte 2", "invalid UTF-8 is refused on writing");
  var cut = String.empty();
  cut.appendByte(0xE2u8);
  cut.appendByte(0x82u8);
  let cutJson = json.Json.fromText(cut.view());
  match cutJson.toText() {
    case is Ok { expect(false, "a cut-off character is refused"); }
    case let Err(e) {
      expect(e.kind is WriteValue, "a cut-off character is a WriteValue error");
      expectUInt(u64.from(e.line), 0u64, "a writing error has no line");
    }
  }
  var badKey = json.Json.newObject();
  badKey.set(bad.view(), json.Json.Null);
  expect(badKey.toText() is Err, "a key that is not UTF-8 is refused");
  expect(json.Json.fromText("\xED\xA0\x80").toText() is Err, "an encoded surrogate is refused");
  expect(json.Json.fromText("\xC0\x80").toText() is Err, "an overlong form is refused");

  // -------- all of ASCII, and more, round trips --------
  var all = String.empty();
  var b = 0u8;
  while b < 128u8 {
    all.appendByte(b);
    b = b + 1u8;
  }
  all.append("\xC3\xA9\xE2\x82\xAC\xF0\x9F\x98\x80\xF4\x8F\xBF\xBF");
  let text = written(all.view());
  match json.parse(text.view()) {
    case let Ok(doc) {
      match doc.asText() {
        case let Some(s) { expectStr(hexOf(s).view(), hexOf(all.view()).view(), "all of ASCII round trips"); }
        case is None { expect(false, "all of ASCII"); }
      }
    }
    case let Err(e) { expectStr(e.message().view(), "<parsed>", "all of ASCII"); }
  }
  let asciiText = writtenAscii(all.view());
  expect(!asciiText.view().contains("\xC3"), "ascii output has no byte past 127");
  match json.parse(asciiText.view()) {
    case let Ok(doc) {
      match doc.asText() {
        case let Some(s) { expectStr(hexOf(s).view(), hexOf(all.view()).view(), "all of ASCII round trips through \\u escapes"); }
        case is None { expect(false, "all of ASCII, escaped"); }
      }
    }
    case let Err(e) { expectStr(e.message().view(), "<parsed>", "all of ASCII, escaped"); }
  }

  done()
}
