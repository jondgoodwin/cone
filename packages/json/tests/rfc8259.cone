// RFC 8259's own examples: section 13's two documents (an object and an array
// of objects), the scalar values that section 2 allows alone, the string
// examples of section 7 (the escaped reverse solidus, the G clef as a
// surrogate pair), and the number forms of section 6. Each is read, asked for
// what it holds, and written back compact and indented; the written text is
// read again and must be the same tree.

mod rfc8259;

import testing use *;
import collections use *;
import json;

// The tree text holds, or null, the failure counted
fn parsed(text: &str, label: &str) json.Json {
  var doc: json.Json = json.Json.Null;
  match json.parse(text) {
    case var Ok(ok) { doc <=> ok; }
    case let Error(e) {
      let m = e.message();
      expectStr(m.view(), "<parsed>", label);
    }
  }
  doc
}

fn compact(j: &json.Json) String {
  match j.toText() {
    case var Ok(t) {
      var s = String.empty();
      s <=> t;
      s
    }
    case let Error(e) { e.message() }
  }
}

// Whether two trees are the same: kind, text, elements and members in order
fn same(a: &json.Json, b: &json.Json) bool {
  match a {
    case is Null { b.isNull() }
    case let Bool(x) { match b.asBool() { case let Some(y) { *x == y } case is None { false } } }
    case let Number(x) {
      match b.numberText() { case let Some(y) { x.view() == y } case is None { false } }
    }
    case let Text(x) { match b.asText() { case let Some(y) { x.view() == y } case is None { false } } }
    case let Array(x) {
      if b.len() != x.len() || !b.isArray() { return false; }
      var i = 0usize;
      while i < x.len() {
        match b.at(i) {
          case let Some(y) { if !same(x[i], y) { return false; } }
          case is None { return false; }
        }
        i = i + 1usize;
      }
      true
    }
    case let Object(x) {
      if b.len() != x.len() || !b.isObject() { return false; }
      var i = 0usize;
      while i < x.len() {
        match b.keyAt(i) {
          case let Some(k) { if k != x[i].key.view() { return false; } }
          case is None { return false; }
        }
        match b.valueAt(i) {
          case let Some(y) { if !same(&x[i].value, y) { return false; } }
          case is None { return false; }
        }
        i = i + 1usize;
      }
      true
    }
  }
}

// Written compact and indented and read back, a tree is the same
fn roundTrips(j: &json.Json, label: &str) {
  let c = compact(j);
  let again = parsed(c.view(), label);
  expect(same(j, &again), label);
  match j.toPretty(2usize) {
    case let Ok(p) {
      let back = parsed(p.view(), label);
      expect(same(j, &back), label);
    }
    case let Error(e) { expect(false, label); }
  }
}

fn text(j: &json.Json, key: &str) String {
  match j.getText(key) {
    case let Some(s) { String.from(s) }
    case is None { String.from("<none>") }
  }
}

fn main() i32 {
  // Section 13, the first example
  let image = parsed("{\n  \"Image\": {\n      \"Width\":  800,\n      \"Height\": 600,\n      \"Title\":  \"View from 15th Floor\",\n      \"Thumbnail\": {\n          \"Url\":    \"http://www.example.com/image/481989943\",\n          \"Height\": 125,\n          \"Width\":  100\n      },\n      \"Animated\" : false,\n      \"IDs\": [116, 943, 234, 38793]\n    }\n}\n", "image");
  expect(image.isObject(), "image is an object");
  expectUInt(u64.from(image.len()), 1u64, "one member");
  match image.get("Image") {
    case let Some(im) {
      expectInt(im.i64Or("Width", -1i64), 800i64, "width");
      expectInt(im.i64Or("Height", -1i64), 600i64, "height");
      expectStr(text(im, "Title").view(), "View from 15th Floor", "title");
      expectBool(im.boolOr("Animated", true), false, "animated");
      match im.get("Thumbnail") {
        case let Some(th) {
          expectStr(text(th, "Url").view(), "http://www.example.com/image/481989943", "thumbnail url");
          expectInt(th.i64Or("Height", -1i64), 125i64, "thumbnail height");
          expectInt(th.i64Or("Width", -1i64), 100i64, "thumbnail width");
        }
        case is None { expect(false, "thumbnail"); }
      }
      match im.get("IDs") {
        case let Some(ids) {
          expectUInt(u64.from(ids.len()), 4u64, "four ids");
          match ids.at(3usize) {
            case let Some(last) {
              match last.asI64() {
                case let Ok(n) { expectInt(n, 38793i64, "last id"); }
                case is Error { expect(false, "last id"); }
              }
            }
            case is None { expect(false, "last id"); }
          }
          expect(ids.at(4usize) is None, "no fifth id");
        }
        case is None { expect(false, "ids"); }
      }
    }
    case is None { expect(false, "Image"); }
  }
  roundTrips(&image, "image round trip");

  // Section 13, the second: an array of two objects
  let places = parsed("[\n  {\n    \"precision\": \"zip\",\n    \"Latitude\":  37.7668,\n    \"Longitude\": -122.3959,\n    \"Address\":   \"\",\n    \"City\":      \"SAN FRANCISCO\",\n    \"State\":     \"CA\",\n    \"Zip\":       \"94107\",\n    \"Country\":   \"US\"\n  },\n  {\n    \"precision\": \"zip\",\n    \"Latitude\":  37.371991,\n    \"Longitude\": -122.026020,\n    \"Address\":   \"\",\n    \"City\":      \"SUNNYVALE\",\n    \"State\":     \"CA\",\n    \"Zip\":       \"94085\",\n    \"Country\":   \"US\"\n  }\n]\n", "places");
  expectUInt(u64.from(places.len()), 2u64, "two places");
  match places.at(0usize) {
    case let Some(p) {
      expectStr(text(p, "City").view(), "SAN FRANCISCO", "first city");
      expectFloat(p.f64Or("Latitude", 0.0), 37.7668, 0.0000000001, "first latitude");
      expectFloat(p.f64Or("Longitude", 0.0), -122.3959, 0.0000000001, "first longitude");
      expectStr(text(p, "Address").view(), "", "empty address");
      expectUInt(u64.from(p.len()), 8u64, "eight members");
    }
    case is None { expect(false, "first place"); }
  }
  match places.at(1usize) {
    case let Some(p) {
      // The number's text is kept as written, the trailing zero too
      match p.get("Longitude") {
        case let Some(n) {
          match n.numberText() {
            case let Some(t) { expectStr(t, "-122.026020", "longitude text as written"); }
            case is None { expect(false, "longitude text"); }
          }
        }
        case is None { expect(false, "longitude"); }
      }
      expectFloat(p.f64Or("Longitude", 0.0), -122.02602, 0.0000000001, "second longitude");
      expectStr(text(p, "Zip").view(), "94085", "zip");
    }
    case is None { expect(false, "second place"); }
  }
  roundTrips(&places, "places round trip");

  // Section 2: any value alone is a JSON text
  let hello = parsed("\"Hello world!\"", "string alone");
  match hello.asText() {
    case let Some(s) { expectStr(s, "Hello world!", "string alone"); }
    case is None { expect(false, "string alone is text"); }
  }
  let answer = parsed("42", "number alone");
  match answer.asI64() {
    case let Ok(n) { expectInt(n, 42i64, "number alone"); }
    case is Error { expect(false, "number alone"); }
  }
  let yes = parsed("true", "true alone");
  match yes.asBool() {
    case let Some(b) { expectBool(b, true, "true alone"); }
    case is None { expect(false, "true alone"); }
  }
  expect(parsed("false", "false").isBool(), "false is a bool");
  expect(parsed("null", "null").isNull(), "null is null");
  expect(parsed("  \t\r\n null \n\t ", "white space").isNull(), "white space around a value");
  expect(parsed("[]", "empty array").isArray(), "empty array");
  expect(parsed("{}", "empty object").isObject(), "empty object");
  expectStr(compact(&hello).view(), "\"Hello world!\"", "write a string alone");
  expectStr(compact(&answer).view(), "42", "write a number alone");

  // Section 7: "\u005C" is a reverse solidus, "\uD834\uDD1E" the G clef U+1D11E
  let solidus = parsed("\"\\u005C\"", "solidus");
  match solidus.asText() {
    case let Some(s) { expectStr(s, "\\", "\\u005C is a backslash"); }
    case is None { expect(false, "solidus"); }
  }
  let clef = parsed("\"\\uD834\\uDD1E\"", "clef");
  match clef.asText() {
    case let Some(s) {
      // U+1D11E in UTF-8 is F0 9D 84 9E
      expectUInt(u64.from(s.len), 4u64, "clef is four bytes");
      expectUInt(u64.from(s[0usize]), 0xF0u64, "clef byte 0");
      expectUInt(u64.from(s[1usize]), 0x9Du64, "clef byte 1");
      expectUInt(u64.from(s[2usize]), 0x84u64, "clef byte 2");
      expectUInt(u64.from(s[3usize]), 0x9Eu64, "clef byte 3");
    }
    case is None { expect(false, "clef"); }
  }
  // The same character raw, in UTF-8, is the same tree
  let raw = parsed("\"\xF0\x9D\x84\x9E\"", "clef raw");
  expect(same(&clef, &raw), "the clef escaped and raw read alike");

  // Section 6: the number grammar (see numbers.cone for the values)
  expectStr(compact(&parsed("[0,-0,1,-1,1.5,-1.5,1e2,1E2,1e+2,1e-2,1.5e10,0.5E-10,123456789012345678901234567890]", "numbers")).view(),
    "[0,-0,1,-1,1.5,-1.5,1e2,1E2,1e+2,1e-2,1.5e10,0.5E-10,123456789012345678901234567890]", "numbers are written as read");

  // Members keep their order, and all of a repeated name stay
  let dup = parsed("{\"b\":1,\"a\":2,\"b\":3}", "duplicate names");
  expectUInt(u64.from(dup.len()), 3u64, "duplicates are kept");
  expectInt(dup.i64Or("b", -1i64), 1i64, "get answers the first of a name");
  expectStr(compact(&dup).view(), "{\"b\":1,\"a\":2,\"b\":3}", "duplicates written in order");

  // A byte-order mark in front is passed over
  let bom = parsed("\xEF\xBB\xBF[1]", "bom");
  expect(bom.isArray(), "a leading byte-order mark is passed over");

  done()
}
