// Collections write as JSON wherever their elements are Serialize (row 333c): a List[i32], a List[Pt], a
// List[List[f64]], a Deque[i32] and a Dict[String, i64] through toJson with no declaration from anyone but the
// element's author, and a declared record holding a List[i32] and a Dict[String, Pt]; and each reads back through
// fromJson where its elements read.

mod collserial;

import testing use *;
import collections use *;
import json;

struct Pt is Serialize, Deserialize[Pt] { pub x: i32; pub y: i32; }
struct Rec is Serialize, Deserialize[Rec] { pub name: String; pub nums: List[i32]; pub pts: Dict[String, Pt]; }

fn text(r: Result[String, json.JsonError]) String {
  match r {
    case let Ok(s) { s }
    case let Err(e) { String() <- e }
  }
}

fn main() i32 {
  var a = List[i32]();
  a.push(1);
  a.push(-2);
  expectStr(text(json.toJson(&a)).view(), "[1,-2]", "List[i32]");

  var b = List[Pt]();
  b.push(Pt(3, 4));
  expectStr(text(json.toJson(&b)).view(), "[{\"x\":3,\"y\":4}]", "List[Pt]");

  var inner = List[f64]();
  inner.push(0.5);
  var c = List[List[f64]]();
  c.push(inner);
  c.push(List[f64]());
  expectStr(text(json.toJson(&c)).view(), "[[0.5],[]]", "List[List[f64]]");

  var d = Deque[i32]();
  d.push(7);
  d.pushFront(8);
  expectStr(text(json.toJson(&d)).view(), "[8,7]", "Deque front to back");

  var e = Dict[String, i64]();
  e.insert(String.from("a"), 9i64);
  expectStr(text(json.toJson(&e)).view(), "{\"a\":9}", "Dict[String, i64]");

  var pts = Dict[String, Pt]();
  pts.insert(String.from("o"), Pt(0, 1));
  var nums = List[i32]();
  nums.push(5);
  let rec = Rec(String.from("r"), nums, pts);
  expectStr(text(json.toJson(&rec)).view(), "{\"name\":\"r\",\"nums\":[5],\"pts\":{\"o\":{\"x\":0,\"y\":1}}}", "a record with a List and a Dict field");

  // Reading back
  match json.fromJson[List[i32]]("[1,-2]") {
    case let Ok(l) { expectInt(i64.from(l.len()), 2i64, "List[i32] len"); expectInt(i64.from(l[1]), -2i64, "List[i32] [1]"); }
    case let Err(x) { expectStr((String() <- x).view(), "<list i32>", "List[i32] read"); }
  }
  match json.fromJson[List[Pt]]("[{\"x\":3,\"y\":4},{\"x\":5,\"y\":6}]") {
    case let Ok(l) { expectInt(i64.from(l.len()), 2i64, "List[Pt] len"); expectInt(i64.from(l[1].y), 6i64, "List[Pt] [1].y"); }
    case let Err(x) { expectStr((String() <- x).view(), "<list pt>", "List[Pt] read"); }
  }
  match json.fromJson[List[List[f64]]]("[[0.5],[],[1.5,2.5]]") {
    case let Ok(l) {
      expectInt(i64.from(l.len()), 3i64, "List[List[f64]] len");
      expectInt(i64.from(l[2].len()), 2i64, "List[List[f64]] inner len");
      expectFloat(l[2][1], 2.5, 0.0, "List[List[f64]] [2][1]");
    }
    case let Err(x) { expectStr((String() <- x).view(), "<nested list>", "List[List[f64]] read"); }
  }
  match json.fromJson[Deque[i32]]("[8,7]") {
    case let Ok(q) { expectInt(i64.from(q.len()), 2i64, "Deque[i32] len"); }
    case let Err(x) { expectStr((String() <- x).view(), "<deque>", "Deque[i32] read"); }
  }
  match json.fromJson[Dict[String, i64]]("{\"a\":9,\"b\":-1}") {
    case let Ok(m) {
      expectInt(i64.from(m.len()), 2i64, "Dict len");
      match m.get("b") {
        case let Some(v) { expectInt(*v, -1i64, "Dict b"); }
        case is None { expect(false, "Dict b missing"); }
      }
    }
    case let Err(x) { expectStr((String() <- x).view(), "<dict>", "Dict[String, i64] read"); }
  }
  match json.fromJson[Rec](text(json.toJson(&rec)).view()) {
    case let Ok(r2) {
      expectStr(r2.name.view(), "r", "Rec name back");
      expectInt(i64.from(r2.nums[0]), 5i64, "Rec nums back");
      expectInt(i64.from(r2.pts.len()), 1i64, "Rec pts back");
    }
    case let Err(x) { expectStr((String() <- x).view(), "<rec>", "Rec read"); }
  }

  done()
}
