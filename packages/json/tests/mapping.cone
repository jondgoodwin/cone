// Mapping a struct to JSON and back by hand (the same code as
// examples/mapping.cone), against documents that are whole, that lack an
// optional member, that carry members the mapping does not know, and that are
// wrong in each way a member can be: missing, the wrong kind, not whole, too
// large, an array holding the wrong kind, a nested object missing a member, a
// document that is not an object. The complaint names the member.

mod mapping;

import testing use *;
import collections use *;
import json;

struct Address {
  pub street String;
  pub zip String;
}

struct Person {
  pub name String;
  pub age i64;
  pub email Option[String];
  pub tags List[String];
  pub address Address;
}

fn within(path &str, e &json.JsonError) json.JsonError {
  mut m = String.from(path);
  m.append(": ");
  m.append(e.reason.view());
  json.JsonError.shape(m.view());
}

fn addressFrom(j &json.Json) Result[Address, json.JsonError] {
  mut street = String.empty();
  mut zip = String.empty();
  match j.requireText("street") {
    case mut s Ok { street <=> s; }
    case imm e Error { return Error[Address, json.JsonError](e.copy()); }
  }
  match j.requireText("zip") {
    case mut z Ok { zip <=> z; }
    case imm e Error { return Error[Address, json.JsonError](e.copy()); }
  }
  Ok[Address, json.JsonError](new Address(street, zip));
}

fn personFrom(j &json.Json) Result[Person, json.JsonError] {
  mut name = String.empty();
  match j.requireText("name") {
    case mut n Ok { name <=> n; }
    case imm e Error { return Error[Person, json.JsonError](e.copy()); }
  }
  mut age = 0i64;
  match j.requireI64("age") {
    case imm n Ok { age = n; }
    case imm e Error { return Error[Person, json.JsonError](e.copy()); }
  }
  mut email Option[String] = None;
  match j.getText("email") {
    case imm s Some { email = Some[String](String.from(s)); }
    case is None { }
  }
  mut tags = List[String].empty();
  match j.get("tags") {
    case imm t Some {
      if not t.isArray() {
        return Error[Person, json.JsonError](json.JsonError.shape("the member \"tags\" is not an array"));
      }
      mut i = 0usize;
      while i < t.len() {
        match t.at(i) {
          case imm v Some {
            match v.asText() {
              case imm s Some { tags.push(String.from(s)); }
              case is None {
                mut m = String.from("tags[");
                m.appendUInt(u64.from(i));
                m.append("] is not a string");
                return Error[Person, json.JsonError](json.JsonError.shape(m.view()));
              }
            }
          }
          case is None { }
        }
        i = i + 1usize;
      }
    }
    case is None { }
  }
  mut address = new Address(String.empty(), String.empty());
  match j.require("address") {
    case imm a Ok {
      match addressFrom(a) {
        case mut ok Ok { address <=> ok; }
        case imm e Error { return Error[Person, json.JsonError](within("address", &e)); }
      }
    }
    case imm e Error { return Error[Person, json.JsonError](e.copy()); }
  }
  Ok[Person, json.JsonError](new Person(name, age, email, tags, address));
}

fn personJson(p &Person) json.Json {
  mut address = json.Json.newObject();
  address.set("street", json.Json.fromText(p.address.street.view()));
  address.set("zip", json.Json.fromText(p.address.zip.view()));
  mut tags = json.Json.newArray();
  each t in p.tags { tags.push(json.Json.fromText(t.view())); }
  mut o = json.Json.newObject();
  o.set("name", json.Json.fromText(p.name.view()));
  o.set("age", json.Json.fromI64(p.age));
  match &p.email {
    case imm e Some { o.set("email", json.Json.fromText(e.view())); }
    case is None { }
  }
  o.set("tags", tags);
  o.set("address", address);
  o;
}

// The text mapped to a Person and written again, or the complaint
fn mapped(text &str) String {
  match json.parse(text) {
    case imm doc Ok {
      match personFrom(&doc) {
        case imm p Ok {
          match personJson(&p).toText() {
            case imm t Ok { t.copy(); }
            case imm e Error { e.message(); }
          }
        }
        case imm e Error { e.message(); }
      }
    }
    case imm e Error { e.message(); }
  }
}

fn main() i32 {
  imm whole = "{\"name\":\"Ada\",\"age\":36,\"email\":\"ada@example.com\",\"tags\":[\"math\",\"engines\"],\"address\":{\"street\":\"1 Byron Rd\",\"zip\":\"W1\"}}";
  expectStr(mapped(whole).view(), whole, "a whole document maps and maps back as it was");

  // The fields themselves
  match json.parse(whole) {
    case imm doc Ok {
      match personFrom(&doc) {
        case imm p Ok {
          expectStr(p.name.view(), "Ada", "name");
          expectInt(p.age, 36i64, "age");
          match &p.email {
            case imm e Some { expectStr(e.view(), "ada@example.com", "email"); }
            case is None { expect(false, "email"); }
          }
          expectUInt(u64.from(p.tags.len()), 2u64, "two tags");
          expectStr(p.tags[1usize].view(), "engines", "second tag");
          expectStr(p.address.zip.view(), "W1", "zip");
        }
        case imm e Error { expectStr(e.message().view(), "<mapped>", "whole"); }
      }
    }
    case imm e Error { expect(false, "whole parse"); }
  }

  // Optional members: missing, null, or the wrong kind are all no email
  imm noEmail = "{\"name\":\"Bo\",\"age\":0,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}";
  expectStr(mapped(noEmail).view(), noEmail, "a missing email stays missing");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":0,\"email\":null,\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), noEmail, "a null email is none, and tags default to empty");
  // Members the mapping does not know are left alone
  expectStr(mapped("{\"extra\":[1,2,{\"deep\":true}],\"name\":\"Bo\",\"age\":0,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\",\"floor\":3},\"more\":null}").view(), noEmail, "unknown members are ignored");
  // A number given in a form that is still a whole number
  expectStr(mapped("{\"name\":\"Bo\",\"age\":3.60e1,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(),
    "{\"name\":\"Bo\",\"age\":36,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}", "36 written as 3.60e1 is the whole number 36");

  // Each way a document can be wrong
  expectStr(mapped("{\"age\":1,\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "json: the member \"name\" is missing", "name missing");
  expectStr(mapped("{\"name\":5,\"age\":1,\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "json: the member \"name\" is not a string", "name a number");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":\"1\",\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "json: the member \"age\" is not a number", "age a string");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1.5,\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "json: the member \"age\" is not a whole number", "age with a fraction");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1e30,\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "json: the member \"age\" is beyond the range of the type asked for", "age too large");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":9223372036854775808,\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "json: the member \"age\" is beyond the range of the type asked for", "age one past i64");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":null,\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "json: the member \"age\" is not a number", "age null");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1,\"tags\":\"x\",\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "json: the member \"tags\" is not an array", "tags a string");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1,\"tags\":[\"a\",2],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "json: tags[1] is not a string", "a tag a number");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1}").view(), "json: the member \"address\" is missing", "address missing");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1,\"address\":{\"street\":\"s\"}}").view(), "json: address: the member \"zip\" is missing", "zip missing, named from the address");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1,\"address\":[]}").view(), "json: address: expected an object", "address an array");
  expectStr(mapped("[1,2]").view(), "json: expected an object", "the document an array");
  expectStr(mapped("\"Bo\"").view(), "json: expected an object", "the document a string");
  // And a text that is not JSON never reaches the mapping
  expectStr(mapped("{\"name\":\"Bo\",").view(), "json: line 1, column 14: the text ends inside an object: expected a key", "not JSON");

  done();
}
