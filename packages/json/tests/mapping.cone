// Mapping a struct to JSON and back through 'toJson' and 'fromJson' (the same types as examples/mapping.cone),
// against documents that are whole, that lack or null an Option member, that carry members the type does not
// have, and that are wrong in each way a member can be: missing, the wrong kind, not whole, too large, an
// array holding the wrong kind, a nested object missing a member, a document that is not an object. The
// complaint names the member, and its offset (not checked here) says where.

mod mapping;

import testing use *;
import collections use *;
import json;

struct Address is Serialize, Deserialize[Address] {
  pub street: String;
  pub zip: String;
}

struct Person is Serialize, Deserialize[Person] {
  pub name: String;
  pub age: i64;
  pub email: Option[String];
  pub tags: List[String];
  pub address: Address;
}

// The text mapped to a Person and written again, or the complaint (without its offset)
fn mapped(text: &str) String {
  match json.fromJson[Person](text) {
    case let Ok(p) {
      match json.toJson(&p) {
        case let Ok(t) { t.clone() }
        case let Err(e) { String() <- e }
      }
    }
    case let Err(e) {
      var plain = e;
      plain.offset = 0usize;
      String() <- plain
    }
  }
}

fn main() i32 {
  let whole = "{\"name\":\"Ada\",\"age\":36,\"email\":\"ada@example.com\",\"tags\":[\"math\",\"engines\"],\"address\":{\"street\":\"1 Byron Rd\",\"zip\":\"W1\"}}";
  expectStr(mapped(whole).view(), whole, "a whole document maps and maps back as it was");

  // The fields themselves
  match json.fromJson[Person](whole) {
    case let Ok(p) {
      expectStr(p.name.view(), "Ada", "name");
      expectInt(p.age, 36i64, "age");
      match &p.email {
        case let Some(e) { expectStr(e.view(), "ada@example.com", "email"); }
        case is None { expect(false, "email"); }
      }
      expectUInt(u64.from(p.tags.len()), 2u64, "two tags");
      expectStr(p.tags[1usize].view(), "engines", "second tag");
      expectStr(p.address.zip.view(), "W1", "zip");
    }
    case let Err(e) { let why = String() <- e; expectStr(why.view(), "<mapped>", "whole"); }
  }

  // An Option member missing, or null, is None, and is written as null
  let noEmail = "{\"name\":\"Bo\",\"age\":0,\"email\":null,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}";
  expectStr(mapped("{\"name\":\"Bo\",\"age\":0,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), noEmail, "a missing email is None");
  expectStr(mapped(noEmail).view(), noEmail, "a null email is None");
  // Members the type does not have are skipped
  expectStr(mapped("{\"extra\":[1,2,{\"deep\":true}],\"name\":\"Bo\",\"age\":0,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\",\"floor\":3},\"more\":null}").view(), noEmail, "unknown members are skipped");
  // A number given in a form that is still a whole number
  expectStr(mapped("{\"name\":\"Bo\",\"age\":3.60e1,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(),
    "{\"name\":\"Bo\",\"age\":36,\"email\":null,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}", "36 written as 3.60e1 is the whole number 36");

  // Each way a document can be wrong
  expectStr(mapped("{\"age\":1,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "the member is missing (name)", "name missing");
  expectStr(mapped("{\"name\":5,\"age\":1,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "name: expected a string", "name a number");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":\"1\",\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "age: expected a number", "age a string");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1.5,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "age: expected a whole number", "age with a fraction");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1e30,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "age: the number does not fit the type", "age too large");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":9223372036854775808,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "age: the number does not fit the type", "age one past i64");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":null,\"tags\":[],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "age: expected a number", "age null is a Type error");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1,\"tags\":\"x\",\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "tags: expected an array", "tags a string");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1,\"tags\":[\"a\",2],\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "tags: expected a string", "a tag a number");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1,\"tags\":[]}").view(), "the member is missing (address)", "address missing");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1,\"address\":{\"street\":\"s\",\"zip\":\"z\"}}").view(), "the member is missing (tags)", "tags missing: only an Option may be");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1,\"tags\":[],\"address\":{\"street\":\"s\"}}").view(), "address: the member is missing (zip)", "zip missing, named from the address");
  expectStr(mapped("{\"name\":\"Bo\",\"age\":1,\"tags\":[],\"address\":[]}").view(), "address: expected an object", "address an array");
  expectStr(mapped("[1,2]").view(), "expected an object", "the document an array");
  expectStr(mapped("\"Bo\"").view(), "expected an object", "the document a string");
  // And a text that is not JSON never reaches the mapping
  expectStr(mapped("{\"name\":\"Bo\",").view(), "the text ends before the JSON value does", "not JSON");

  done()
}
