// ======== Exact decimals: the slow path of number conversion ========
//
// A number's text is turned into an f64, and an f64 into the shortest text
// that reads back as the same f64, through an exact decimal: the digits of the
// value, a decimal point, and shifts by powers of two that move the point
// without losing a digit. This is the method of Go's 'strconv' (its 'decimal'
// type), written afresh here: slow, simple, and right for every input. The
// quick cases never come here (number.cone: up to 15 digits and a power of ten
// within 22 are one multiply or one divide, both exact).
//
// A Dec holds at most 800 digits. That is more than the 767 significant digits
// any f64 can need, and a digit dropped past it sets 'trunc', which only
// breaks the tie of a value exactly halfway between two f64s.

// The most digits a Dec holds
const decMaxDigits = 800usize;
// The most bits one shift moves: n * 10 + carry stays inside a u64
const decMaxShift = 60i32;

// The value 0.d1d2d3... times 10^dp, the digits 0 to 9 held most significant
// first, with no trailing zero (zero is no digits)
struct Dec {
  pub digits List[u8];
  pub dp i32;
  // Nonzero digits beyond the 800 were dropped
  pub trunc bool;
}

fn decNew() Dec { new Dec(List[u8].empty(), 0i32, false) }

// Trailing zeros off; an empty Dec is zero, and its point is at 0
fn decTrim(a &mut Dec) {
  while a.digits.len() > 0usize and *a.digits[a.digits.len() - 1usize] == 0u8 {
    a.digits.pop();
  }
  if a.digits.len() == 0usize { a.dp = 0i32; }
}

// The Dec holds v exactly
fn decAssign(a &mut Dec, v u64) {
  a.digits.clear();
  a.trunc = false;
  var rev = List[u8].empty();
  var x = v;
  while x > 0u64 {
    rev.push(u8.from(x % 10u64));
    x = x / 10u64;
  }
  var i = rev.len();
  while i > 0usize {
    i = i - 1usize;
    a.digits.push(*rev[i]);
  }
  a.dp = i32.from(a.digits.len());
  decTrim(a);
}

// Divide by 2^k, k from 1 to decMaxShift
fn decRightShift(a &mut Dec, k i32) {
  let kk = u64.from(k);
  let nd = a.digits.len();
  var r = 0usize;
  var n = 0u64;
  // Pick up enough leading digits to cover the first shift
  while (n >> kk) == 0u64 {
    if r >= nd {
      if n == 0u64 {
        a.digits.clear();
        a.dp = 0i32;
        return;
      }
      while (n >> kk) == 0u64 {
        n = n * 10u64;
        r = r + 1usize;
      }
      break;
    }
    n = n * 10u64 + u64.from(*a.digits[r]);
    r = r + 1usize;
  }
  a.dp = a.dp - (i32.from(r) - 1i32);
  let mask = (1u64 << kk) - 1u64;
  var out = List[u8].withCapacity(nd + 24usize);
  // Pick up a digit, put down a digit
  while r < nd {
    let dig = n >> kk;
    n = n & mask;
    out.push(u8.from(dig));
    n = n * 10u64 + u64.from(*a.digits[r]);
    r = r + 1usize;
  }
  // Put down the extra digits
  while n > 0u64 {
    let dig = n >> kk;
    n = n & mask;
    if out.len() < decMaxDigits { out.push(u8.from(dig)); }
    elif dig > 0u64 { a.trunc = true; }
    n = n * 10u64;
  }
  a.digits <=> out;
  decTrim(a);
}

// Multiply by 2^k, k from 1 to decMaxShift
fn decLeftShift(a &mut Dec, k i32) {
  let kk = u64.from(k);
  // The product's digits, least significant first
  var rev = List[u8].withCapacity(a.digits.len() + 24usize);
  var n = 0u64;
  var r = a.digits.len();
  while r > 0usize {
    r = r - 1usize;
    n = n + (u64.from(*a.digits[r]) << kk);
    let quo = n / 10u64;
    rev.push(u8.from(n - 10u64 * quo));
    n = quo;
  }
  while n > 0u64 {
    let quo = n / 10u64;
    rev.push(u8.from(n - 10u64 * quo));
    n = quo;
  }
  let total = rev.len();
  a.dp = a.dp + i32.from(total) - i32.from(a.digits.len());
  var out = List[u8].withCapacity(total);
  var i = total;
  while i > 0usize {
    i = i - 1usize;
    if out.len() < decMaxDigits { out.push(*rev[i]); }
    elif *rev[i] != 0u8 { a.trunc = true; }
  }
  a.digits <=> out;
  decTrim(a);
}

// Multiply by 2^k, k any sign
fn decShift(a &mut Dec, k i32) {
  if a.digits.len() == 0usize { return; }
  var left = k;
  if left > 0i32 {
    while left > decMaxShift {
      decLeftShift(a, decMaxShift);
      left = left - decMaxShift;
    }
    decLeftShift(a, left);
  }
  elif left < 0i32 {
    while left < -decMaxShift {
      decRightShift(a, decMaxShift);
      left = left + decMaxShift;
    }
    decRightShift(a, -left);
  }
}

// Whether rounding to nd digits goes up
fn decShouldRoundUp(a &Dec, nd i32) bool {
  if nd < 0i32 or usize.from(nd) >= a.digits.len() { return false; }
  let at = usize.from(nd);
  let digit = *a.digits[at];
  // Exactly halfway: to even, unless digits were dropped, which makes it a
  // little more than halfway
  if digit == 5u8 and at + 1usize == a.digits.len() {
    if a.trunc { return true; }
    return at > 0usize and (*a.digits[at - 1usize] % 2u8) != 0u8;
  }
  digit >= 5u8
}

fn decRoundDown(a &mut Dec, nd i32) {
  if nd < 0i32 or usize.from(nd) >= a.digits.len() { return; }
  a.digits.truncate(usize.from(nd));
  decTrim(a);
}

fn decRoundUp(a &mut Dec, nd i32) {
  if nd < 0i32 or usize.from(nd) >= a.digits.len() { return; }
  var i = usize.from(nd);
  while i > 0usize {
    i = i - 1usize;
    let c = *a.digits[i];
    if c < 9u8 {
      a.digits.set(i, c + 1u8);
      a.digits.truncate(i + 1usize);
      return;
    }
  }
  // All nines: a single 1, the point one place on
  a.digits.clear();
  a.digits.push(1u8);
  a.dp = a.dp + 1i32;
}

fn decRound(a &mut Dec, nd i32) {
  if nd < 0i32 or usize.from(nd) >= a.digits.len() { return; }
  if decShouldRoundUp(a, nd) { decRoundUp(a, nd); } else { decRoundDown(a, nd); }
}

// The integer part, rounded to nearest-even; beyond a u64, all ones
fn decRoundedInteger(a &Dec) u64 {
  if a.dp > 20i32 { return 0xFFFFFFFFFFFFFFFFu64; }
  let point = if a.dp > 0i32 {usize.from(a.dp)} else {0usize};
  var i = 0usize;
  var n = 0u64;
  while i < point and i < a.digits.len() {
    n = n * 10u64 + u64.from(*a.digits[i]);
    i = i + 1usize;
  }
  while i < point {
    n = n * 10u64;
    i = i + 1usize;
  }
  if decShouldRoundUp(a, a.dp) { n = n + 1u64; }
  n
}

// -------- Dec to f64 --------

// How far the point is moved to get below 1, by how many places it is out
fn decPowTab(i i32) i32 {
  if i == 0i32 { return 1i32; }
  if i == 1i32 { return 3i32; }
  if i == 2i32 { return 6i32; }
  if i == 3i32 { return 9i32; }
  if i == 4i32 { return 13i32; }
  if i == 5i32 { return 16i32; }
  if i == 6i32 { return 19i32; }
  if i == 7i32 { return 23i32; }
  26i32
}

// 2^k as an f64, k from -1074 to 1023: every step is exact
fn pow2(k i32) f64 {
  var x = 1.0;
  var i = k;
  while i > 0i32 {
    x = x * 2.0;
    i = i - 1i32;
  }
  while i < 0i32 {
    x = x * 0.5;
    i = i + 1i32;
  }
  x
}

// The f64 nearest the Dec, the even one on a tie; false when it is too large
// for an f64. The Dec is used up.
fn decToF64(a &mut Dec, out &mut f64) bool {
  *out = 0.0;
  if a.digits.len() == 0usize { return true; }
  if a.dp > 310i32 { return false; }
  if a.dp < -330i32 { return true; }
  // Scale by powers of two to [0.5, 1)
  var exp = 0i32;
  while a.dp > 0i32 {
    let n = if a.dp >= 9i32 {27i32} else {decPowTab(a.dp)};
    decShift(a, -n);
    exp = exp + n;
  }
  while a.dp < 0i32 or (a.dp == 0i32 and a.digits.len() > 0usize and *a.digits[0usize] < 5u8) {
    let n = if -a.dp >= 9i32 {27i32} else {decPowTab(-a.dp)};
    decShift(a, n);
    exp = exp - n;
  }
  // The range of an f64 is [1, 2), not [0.5, 1)
  exp = exp - 1i32;
  // The smallest exponent is -1022: a smaller value is denormal
  if exp < -1022i32 {
    let n = -1022i32 - exp;
    decShift(a, -n);
    exp = exp + n;
  }
  if exp + 1023i32 >= 2047i32 { return false; }
  // 53 bits
  decShift(a, 53i32);
  var mant = decRoundedInteger(a);
  // Rounding may have carried into a 54th bit
  if mant == (2u64 << 52u64) {
    mant = mant >> 1u64;
    exp = exp + 1i32;
    if exp + 1023i32 >= 2047i32 { return false; }
  }
  // Below 2^52 the value is denormal, and its exponent the smallest
  let scale = if (mant & (1u64 << 52u64)) == 0u64 {-1022i32} else {exp};
  *out = f64.from(mant) * pow2(scale - 52i32);
  true
}

// -------- f64 to the shortest Dec --------

// The Dec holds x's exact decimal, cut to the fewest digits that still read
// back as x. x is finite and positive.
fn decShortest(a &mut Dec, x f64) {
  let bits = x as u64;
  var mant = bits & ((1u64 << 52u64) - 1u64);
  var exp = i32.from((bits >> 52u64) & 0x7FFu64);
  if exp == 0i32 {
    exp = 1i32;
  }
  else {
    mant = mant | (1u64 << 52u64);
  }
  exp = exp - 1023i32;
  decAssign(a, mant);
  decShift(a, exp - 52i32);
  decRoundShortest(a, mant, exp);
}

// Cut a (the exact value of mant * 2^(exp-52)) to the fewest digits that lie
// between the halves to the neighbouring f64s
fn decRoundShortest(a &mut Dec, mant u64, exp i32) {
  if mant == 0u64 {
    a.digits.clear();
    a.dp = 0i32;
    return;
  }
  // Already shortest when 10^(dp-nd) is beyond the gap between f64s:
  // log2(10) > 3.32
  if exp > -1022i32 and 332i32 * (a.dp - i32.from(a.digits.len())) >= 100i32 * (exp - 52i32) {
    return;
  }
  // Halfway to the next f64 up
  var upper = decNew();
  decAssign(&mut upper, mant * 2u64 + 1u64);
  decShift(&mut upper, exp - 52i32 - 1i32);
  // Halfway to the next f64 down; below a power of two the gap halves
  var mantlo = mant - 1u64;
  var explo = exp;
  if not (mant > (1u64 << 52u64) or exp == -1022i32) {
    mantlo = mant * 2u64 - 1u64;
    explo = exp - 1i32;
  }
  var lower = decNew();
  decAssign(&mut lower, mantlo * 2u64 + 1u64);
  decShift(&mut lower, explo - 52i32 - 1i32);

  // The bounds are readable as x only when x's mantissa is even, since a tie
  // rounds to even
  let inclusive = mant % 2u64 == 0u64;

  // 0: the digits of a and upper agree so far; 1: they differ by one place,
  // then only nines in a against zeros in upper; 2: they differ by more
  var upperdelta = 0u8;
  var ui = 0i32;
  while true {
    let mi = ui - upper.dp + a.dp;
    if mi >= i32.from(a.digits.len()) { break; }
    let li = ui - upper.dp + lower.dp;
    var l = 0u8;
    if li >= 0i32 and usize.from(li) < lower.digits.len() { l = *lower.digits[usize.from(li)]; }
    var m = 0u8;
    if mi >= 0i32 { m = *a.digits[usize.from(mi)]; }
    var u = 0u8;
    if usize.from(ui) < upper.digits.len() { u = *upper.digits[usize.from(ui)]; }

    // Truncating is allowed once lower has a different digit, or is exactly
    // the result of truncating and inclusive
    let okdown = l != m or (inclusive and li + 1i32 == i32.from(lower.digits.len()));

    if upperdelta == 0u8 and m + 1u8 < u {
      upperdelta = 2u8;
    }
    elif upperdelta == 0u8 and m != u {
      upperdelta = 1u8;
    }
    elif upperdelta == 1u8 and (m != 9u8 or u != 0u8) {
      upperdelta = 2u8;
    }
    // Rounding up is allowed once upper has a different digit and is either
    // inclusive or farther than the rounded value
    let okup = upperdelta > 0u8 and (inclusive or upperdelta > 1u8 or usize.from(ui) + 1usize < upper.digits.len());

    if okdown and okup {
      decRound(a, mi + 1i32);
      return;
    }
    if okdown {
      decRoundDown(a, mi + 1i32);
      return;
    }
    if okup {
      decRoundUp(a, mi + 1i32);
      return;
    }
    ui = ui + 1i32;
  }
}
