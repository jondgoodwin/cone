// ======== Exact decimals: the digits of a number read from text ========
//
// A Dec holds the digits of a JSON number's text, a decimal point and a
// 'trunc' flag, for numberI64 and numberU64 to read exactly. Writing an f64
// takes its digits from core's FloatText.shortest, and reading text into an
// f64 is 'f64.parse' (core, with conestd's exact reader), so no arithmetic on
// a Dec remains here.
//
// A Dec holds at most 800 digits, and a digit dropped past it sets 'trunc'.

// The most digits a Dec holds
const decMaxDigits = 800usize;
// The value 0.d1d2d3... times 10^dp, the digits 0 to 9 held most significant
// first, with no trailing zero (zero is no digits)
struct Dec {
  pub digits: List[u8];
  pub dp: i32;
  // Nonzero digits beyond the 800 were dropped
  pub trunc: bool;
}

fn decNew() Dec { Dec(List[u8](), 0i32, false) }

// Trailing zeros off; an empty Dec is zero, and its point is at 0
fn decTrim(a: &mut Dec) {
  while a.digits.len() > 0usize && *a.digits[a.digits.len() - 1usize] == 0u8 {
    a.digits.pop();
  }
  if a.digits.len() == 0usize { a.dp = 0i32; }
}
