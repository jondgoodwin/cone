// ======== The streaming reader: one grammar, a pull of events ========
//
// A Reader walks a JSON text held in memory and answers one event at a time
// (the start or end of an array or object, a key, a string, a number, a
// literal), with no tree built and no recursion: where it is in the nesting is
// a list of bytes, so how deep the text goes costs memory, never the stack,
// and a depth limit refuses a hostile text early. The tree reader ('parse')
// is made of this one, so there is a single grammar.
//
// A key, a string or a number's text is held by the Reader, which 'text()'
// shows until the next call to 'next'.

// What the Reader found. 'Key', 'Text' and 'Number' leave their text in
// 'reader.text()'; a string's escapes are decoded, a number's text is as
// written. 'Done' is the end of the one value the text holds, after which
// only white space may follow; it is answered again if asked again.
pub enum Event {
  StartObject;
  EndObject;
  StartArray;
  EndArray;
  Key;
  Text;
  Number;
  True;
  False;
  Null;
  Done;
}

// What the Reader wants next
enum Want {
  NeedValue;
  NeedValueOrEnd;
  NeedKeyOrEnd;
  NeedKey;
  NeedCommaOrEnd;
  NeedEnd;
  Finished;
}

// Open containers on the stack
const inArray = 1u8;
const inObject = 2u8;

pub struct Reader['a] {
  src: &'a Array[u8];
  pos: usize;
  tokenStart: usize;
  maxDepth: usize;
  stack: List[u8];
  want: Want;
  buf: String;
  failed: bool;
  err: JsonError;

  // The text of the Key, Text or Number just read
  pub fn text(self: &) &str { self.buf.view() }

  // Where the last event's token starts, in bytes from the start of the text
  pub fn offset(self: &) usize { self.tokenStart }

  // The line (from 1) and column (in bytes, from 1) of the last event's token
  pub fn line(self: &) u32 { lineOf(self.src, self.tokenStart) }
  pub fn column(self: &) u32 { columnOf(self.src, self.tokenStart) }

  // How many arrays and objects are open
  pub fn depth(self: &) usize { self.stack.len() }

  // The next event, or why the text is not JSON. After a failure it answers
  // the same failure again.
  pub fn next(self: &mut) Result[Event, JsonError] {
    if self.failed { return Error[Event, JsonError](self.err.copy()); }
    let ev = self.step();
    if self.failed { return Error[Event, JsonError](self.err.copy()); }
    Ok[Event, JsonError](ev)
  }

  // Skips the value that comes next, all of it (an array or object with its
  // contents). None when it is skipped, or the failure.
  pub fn skipValue(self: &mut) Option[JsonError] {
    var levels = 0usize;
    while true {
      match self.next() {
        case let Ok(ev) {
          if ev == Event.StartObject || ev == Event.StartArray { levels = levels + 1usize; }
          else if ev == Event.EndObject || ev == Event.EndArray {
            // The end of the container the caller is in: no value to skip
            if levels == 0usize { return None; }
            levels = levels - 1usize;
          }
          else if ev == Event.Done {
            return None;
          }
          // A key is followed by its value, which is what is being skipped
          if levels == 0usize && ev != Event.Key { return None; }
        }
        case let Error(e) { return Some[JsonError](e.copy()); }
      }
    }
    None
  }

  fn fail(self: &mut,kind: ErrorKind, at: usize, reason: &str) {
    if self.failed { return; }
    self.failed = true;
    self.err = errorAt(self.src, at, kind, reason);
  }

  fn skipSpace(self: &mut) {
    while self.pos < self.src.len {
      let c = self.src[self.pos];
      if c != ' ' && c != '\t' && c != '\n' && c != '\r' { return; }
      self.pos = self.pos + 1usize;
    }
  }

  // After a complete value
  fn afterValue(self: &mut) {
    if self.stack.len() == 0usize { self.want = Want.NeedEnd; } else { self.want = Want.NeedCommaOrEnd; }
  }

  fn open(self: &mut,kind: u8) bool {
    if self.stack.len() >= self.maxDepth {
      var m = String.from("the text is nested deeper than ");
      m.appendUInt(u64.from(self.maxDepth));
      m.append(" levels");
      self.fail(ErrorKind.TooDeep, self.pos, m.view());
      return false;
    }
    self.stack.push(kind);
    true
  }

  fn step(self: &mut) Event {
    self.skipSpace();
    let n = self.src.len;
    self.tokenStart = self.pos;
    if self.want == Want.Finished { return Event.Done; }
    if self.want == Want.NeedEnd {
      if self.pos < n {
        self.fail(ErrorKind.TrailingText, self.pos, "unexpected text after the JSON value");
        return Event.Done;
      }
      self.want = Want.Finished;
      return Event.Done;
    }
    if self.want == Want.NeedCommaOrEnd {
      let top = *self.stack[self.stack.len() - 1usize];
      if self.pos >= n {
        if top == inArray { self.fail(ErrorKind.UnexpectedEnd, n, "the text ends inside an array: expected ',' or ']'"); }
        else { self.fail(ErrorKind.UnexpectedEnd, n, "the text ends inside an object: expected ',' or '}'"); }
        return Event.Done;
      }
      let c = self.src[self.pos];
      if c == ',' {
        self.pos = self.pos + 1usize;
        self.skipSpace();
        self.tokenStart = self.pos;
        if top == inArray { self.want = Want.NeedValue; } else { self.want = Want.NeedKey; }
      }
      else if top == inArray && c == ']' {
        self.pos = self.pos + 1usize;
        self.stack.pop();
        self.afterValue();
        return Event.EndArray;
      }
      else if top == inObject && c == '}' {
        self.pos = self.pos + 1usize;
        self.stack.pop();
        self.afterValue();
        return Event.EndObject;
      }
      else {
        if top == inArray { self.fail(ErrorKind.UnexpectedByte, self.pos, "expected ',' or ']' after an array's element"); }
        else { self.fail(ErrorKind.UnexpectedByte, self.pos, "expected ',' or '}' after an object's value"); }
        return Event.Done;
      }
    }
    if self.want == Want.NeedKeyOrEnd || self.want == Want.NeedKey {
      if self.pos >= n {
        self.fail(ErrorKind.UnexpectedEnd, n, "the text ends inside an object: expected a key");
        return Event.Done;
      }
      let c = self.src[self.pos];
      if c == '}' {
        if self.want == Want.NeedKey {
          self.fail(ErrorKind.UnexpectedByte, self.pos, "a ',' may not come just before '}'");
          return Event.Done;
        }
        self.pos = self.pos + 1usize;
        self.stack.pop();
        self.afterValue();
        return Event.EndObject;
      }
      if c != '"' {
        self.fail(ErrorKind.UnexpectedByte, self.pos, "expected a key: a string in double quotes");
        return Event.Done;
      }
      self.tokenStart = self.pos;
      if !self.readString() { return Event.Done; }
      self.skipSpace();
      if self.pos >= n {
        self.fail(ErrorKind.UnexpectedEnd, n, "the text ends after a key: expected ':'");
        return Event.Done;
      }
      if self.src[self.pos] != ':' {
        self.fail(ErrorKind.UnexpectedByte, self.pos, "expected ':' after the key");
        return Event.Done;
      }
      self.pos = self.pos + 1usize;
      self.want = Want.NeedValue;
      return Event.Key;
    }
    // A value (or, just inside an array, the array's end)
    if self.pos >= n {
      self.fail(ErrorKind.UnexpectedEnd, n, "the text ends where a value was expected");
      return Event.Done;
    }
    let c = self.src[self.pos];
    self.tokenStart = self.pos;
    if c == ']' {
      if self.want == Want.NeedValueOrEnd {
        self.pos = self.pos + 1usize;
        self.stack.pop();
        self.afterValue();
        return Event.EndArray;
      }
      if self.stack.len() > 0usize && *self.stack[self.stack.len() - 1usize] == inArray {
        self.fail(ErrorKind.UnexpectedByte, self.pos, "a ',' may not come just before ']'");
        return Event.Done;
      }
    }
    if c == '{' {
      if !self.open(inObject) { return Event.Done; }
      self.pos = self.pos + 1usize;
      self.want = Want.NeedKeyOrEnd;
      return Event.StartObject;
    }
    if c == '[' {
      if !self.open(inArray) { return Event.Done; }
      self.pos = self.pos + 1usize;
      self.want = Want.NeedValueOrEnd;
      return Event.StartArray;
    }
    if c == '"' {
      if !self.readString() { return Event.Done; }
      self.afterValue();
      return Event.Text;
    }
    if c == '-' || isDigit(c) {
      if !self.readNumber() { return Event.Done; }
      self.afterValue();
      return Event.Number;
    }
    if c == 't' || c == 'f' || c == 'n' {
      if c == 't' && startsAt(self.src, self.pos, "true") {
        self.pos = self.pos + 4usize;
        self.afterValue();
        return Event.True;
      }
      if c == 'f' && startsAt(self.src, self.pos, "false") {
        self.pos = self.pos + 5usize;
        self.afterValue();
        return Event.False;
      }
      if c == 'n' && startsAt(self.src, self.pos, "null") {
        self.pos = self.pos + 4usize;
        self.afterValue();
        return Event.Null;
      }
      self.fail(ErrorKind.UnexpectedByte, self.pos, "expected true, false or null");
      return Event.Done;
    }
    self.fail(ErrorKind.UnexpectedByte, self.pos, "expected a value: an object, an array, a string, a number, true, false or null");
    Event.Done
  }

  // At a number's first byte: its text into buf, past it
  fn readNumber(self: &mut) bool {
    let s = scanNumber(self.src, self.pos);
    if s.problem != numOk {
      if s.problem == numNoDigits { self.fail(ErrorKind.BadNumber, s.end, "a number needs a digit here"); }
      else if s.problem == numLeadingZero { self.fail(ErrorKind.BadNumber, s.end, "a number may not have a leading zero"); }
      else if s.problem == numNoFraction { self.fail(ErrorKind.BadNumber, s.end, "a fraction needs a digit after the '.'"); }
      else { self.fail(ErrorKind.BadNumber, s.end, "an exponent needs a digit"); }
      return false;
    }
    self.buf.clear();
    self.buf.appendBytes(&self.src[self.pos..<s.end]);
    self.pos = s.end;
    true
  }

  // At a string's opening quote: its text, escapes decoded, into buf, past
  // the closing quote
  fn readString(self: &mut) bool {
    let n = self.src.len;
    let opened = self.pos;
    self.buf.clear();
    self.pos = self.pos + 1usize;
    while true {
      // A run of bytes that need no care
      let start = self.pos;
      while self.pos < n {
        let b = self.src[self.pos];
        if b == '"' || b == '\\' || b < 0x20u8 || b >= 0x80u8 { break; }
        self.pos = self.pos + 1usize;
      }
      if self.pos > start { self.buf.appendBytes(&self.src[start..<self.pos]); }
      if self.pos >= n {
        self.fail(ErrorKind.UnexpectedEnd, n, "the text ends inside a string: it is not closed with '\"'");
        return false;
      }
      let c = self.src[self.pos];
      if c == '"' {
        self.pos = self.pos + 1usize;
        self.tokenStart = opened;
        return true;
      }
      if c < 0x20u8 {
        var m = String.from("a control character (U+00");
        m.appendHex(u64.from(c), 2usize);
        m.append(") in a string must be written as an escape");
        self.fail(ErrorKind.ControlChar, self.pos, m.view());
        return false;
      }
      if c >= 0x80u8 {
        let len = utf8Length(self.src, self.pos);
        if len == 0usize {
          self.fail(ErrorKind.BadUtf8, self.pos, "the text is not valid UTF-8");
          return false;
        }
        self.buf.appendBytes(&self.src[self.pos..<self.pos + len]);
        self.pos = self.pos + len;
      }
      else {
        if !self.readEscape() { return false; }
      }
    }
    false
  }

  // At a '\' inside a string: the character it names, appended to buf
  fn readEscape(self: &mut) bool {
    let n = self.src.len;
    let at = self.pos;
    if at + 1usize >= n {
      self.fail(ErrorKind.UnexpectedEnd, n, "the text ends inside an escape");
      return false;
    }
    let e = self.src[at + 1usize];
    self.pos = at + 2usize;
    if e == '"' { self.buf.appendByte('"'); }
    else if e == '\\' { self.buf.appendByte('\\'); }
    else if e == '/' { self.buf.appendByte('/'); }
    else if e == 'b' { self.buf.appendByte(8u8); }
    else if e == 'f' { self.buf.appendByte(12u8); }
    else if e == 'n' { self.buf.appendByte('\n'); }
    else if e == 'r' { self.buf.appendByte('\r'); }
    else if e == 't' { self.buf.appendByte('\t'); }
    else if e == 'u' {
      let hi = hex4(self.src, self.pos);
      if hi > 0xFFFFu32 {
        self.fail(ErrorKind.BadEscape, at, "'\\u' must be followed by 4 hex digits");
        return false;
      }
      self.pos = self.pos + 4usize;
      var cp = hi;
      if hi >= 0xD800u32 && hi <= 0xDBFFu32 {
        // A high surrogate begins a pair: '\u' and a low one must follow
        var lo = 0x10000u32;
        if self.pos + 1usize < n && self.src[self.pos] == '\\' && self.src[self.pos + 1usize] == 'u' {
          lo = hex4(self.src, self.pos + 2usize);
        }
        if lo < 0xDC00u32 || lo > 0xDFFFu32 {
          self.fail(ErrorKind.BadSurrogate, at, "a high surrogate '\\uD800' to '\\uDBFF' must be followed by a low one, '\\uDC00' to '\\uDFFF'");
          return false;
        }
        self.pos = self.pos + 6usize;
        cp = 0x10000u32 + ((hi - 0xD800u32) << 10u32) + (lo - 0xDC00u32);
      }
      else if hi >= 0xDC00u32 && hi <= 0xDFFFu32 {
        self.fail(ErrorKind.BadSurrogate, at, "a low surrogate '\\uDC00' to '\\uDFFF' must follow a high one");
        return false;
      }
      appendUtf8(&mut self.buf, cp);
    }
    else {
      self.fail(ErrorKind.BadEscape, at, "bad escape: the escapes are \\\" \\\\ \\/ \\b \\f \\n \\r \\t and \\uXXXX");
      return false;
    }
    true
  }
}

// A Reader over text, standard options. A leading UTF-8 byte-order mark is
// passed over.
pub fn reader(text: &'a Array[u8]) Reader['a] {
  let opts = Options.standard();
  readerWith(text, &opts)
}

pub fn readerWith(text: &'a Array[u8], opts: &'b Options) Reader['a] {
  var start = 0usize;
  if text.len >= 3usize && text[0usize] == 0xEFu8 && text[1usize] == 0xBBu8 && text[2usize] == 0xBFu8 {
    start = 3usize;
  }
  Reader(text, start, start, usize.from(opts.maxDepth), List[u8].empty(), Want.NeedValue, String.empty(), false, JsonError.none())
}

// -------- helpers --------

// Whether text holds want at pos
fn startsAt(text: &Array[u8], pos: usize, want: &Array[u8]) bool {
  pos + want.len <= text.len && &text[pos..<pos + want.len] == want
}

fn hexValue(c: u8) u32 {
  if isDigit(c) { return u32.from(c - '0'); }
  if c >= 'a' && c <= 'f' { return u32.from(c - 'a') + 10u32; }
  if c >= 'A' && c <= 'F' { return u32.from(c - 'A') + 10u32; }
  16u32
}

// The four hex digits at pos, or a value past 0xFFFF when they are not four
fn hex4(t: &Array[u8], pos: usize) u32 {
  if pos + 4usize > t.len { return 0x10000u32; }
  var v = 0u32;
  var i = 0usize;
  while i < 4usize {
    let d = hexValue(t[pos + i]);
    if d == 16u32 { return 0x10000u32; }
    v = v * 16u32 + d;
    i = i + 1usize;
  }
  v
}

// The length (1 to 4) of the well-formed UTF-8 character at pos, or 0 when
// the bytes there are not one: no overlong form, no surrogate, nothing beyond
// U+10FFFF, no cut-off character
fn utf8Length(t: &Array[u8], pos: usize) usize {
  let b = t[pos];
  if b < 0x80u8 { return 1usize; }
  var more = 0usize;
  var cp = 0u32;
  var least = 0u32;
  if b >= 0xC2u8 && b <= 0xDFu8 { more = 1usize; cp = u32.from(b & 0x1Fu8); least = 0x80u32; }
  else if b >= 0xE0u8 && b <= 0xEFu8 { more = 2usize; cp = u32.from(b & 0x0Fu8); least = 0x800u32; }
  else if b >= 0xF0u8 && b <= 0xF4u8 { more = 3usize; cp = u32.from(b & 0x07u8); least = 0x10000u32; }
  else { return 0usize; }
  if pos + more >= t.len { return 0usize; }
  var k = 1usize;
  while k <= more {
    let c = t[pos + k];
    if (c & 0xC0u8) != 0x80u8 { return 0usize; }
    cp = (cp << 6u32) | u32.from(c & 0x3Fu8);
    k = k + 1usize;
  }
  if cp < least || cp > 0x10FFFFu32 || (cp >= 0xD800u32 && cp <= 0xDFFFu32) { return 0usize; }
  more + 1usize
}

// A character, appended in UTF-8
fn appendUtf8(s: &mut String, cp: u32) {
  if cp < 0x80u32 {
    s.appendByte(u8.from(cp));
  }
  else if cp < 0x800u32 {
    s.appendByte(0xC0u8 | u8.from(cp >> 6u32));
    s.appendByte(0x80u8 | u8.from(cp & 0x3Fu32));
  }
  else if cp < 0x10000u32 {
    s.appendByte(0xE0u8 | u8.from(cp >> 12u32));
    s.appendByte(0x80u8 | u8.from((cp >> 6u32) & 0x3Fu32));
    s.appendByte(0x80u8 | u8.from(cp & 0x3Fu32));
  }
  else {
    s.appendByte(0xF0u8 | u8.from(cp >> 18u32));
    s.appendByte(0x80u8 | u8.from((cp >> 12u32) & 0x3Fu32));
    s.appendByte(0x80u8 | u8.from((cp >> 6u32) & 0x3Fu32));
    s.appendByte(0x80u8 | u8.from(cp & 0x3Fu32));
  }
}

// The line (from 1) of the byte at offset, a line ending at '\n'
fn lineOf(t: &Array[u8], offset: usize) u32 {
  var line = 1u32;
  var i = 0usize;
  while i < offset && i < t.len {
    if t[i] == '\n' { line = line + 1u32; }
    i = i + 1usize;
  }
  line
}

// The column (from 1, in bytes) of the byte at offset
fn columnOf(t: &Array[u8], offset: usize) u32 {
  var col = 1u32;
  var i = 0usize;
  while i < offset && i < t.len {
    if t[i] == '\n' { col = 1u32; } else { col = col + 1u32; }
    i = i + 1usize;
  }
  col
}

fn errorAt(t: &Array[u8], offset: usize, kind: ErrorKind, reason: &str) JsonError {
  JsonError(kind, offset, lineOf(t, offset), columnOf(t, offset), String.from(reason))
}
