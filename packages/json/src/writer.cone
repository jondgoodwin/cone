// ======== The writer: a text built value by value ========
//
// A Writer is told what to write, in order, and keeps the text and the state
// it needs to get the commas, colons, quotes and indentation right:
//
//   mut w = Writer(WriteOptions.standard());
//   w.beginObject();
//   w.key("name");  w.string("hello");
//   w.key("tags");  w.beginArray();  w.int(1i64);  w.boolean(true);  w.endArray();
//   w.endObject();
//   match w.finish() { case imm ok Ok { ... ok ... } case imm e Err { ... } }
//
// writes {"name":"hello","tags":[1,true]}. A call out of order (a value where
// a key belongs, an end with nothing open, a second top-level value) or a
// value JSON cannot hold (NaN, infinity, a number whose text is not a number,
// a string that is not UTF-8) does not stop the program: the Writer remembers
// the first such failure, writes nothing more, and 'finish' answers it.

// An open array or object
struct OpenFrame {
  pub isObject: bool;
  // Elements or members written so far
  pub count: usize;
  // A key was written and its value is owed
  pub owed: bool;
}

pub struct Writer {
  pub opts: WriteOptions;
  out: String;
  open: List[OpenFrame];
  wrote: bool;
  failed: bool;
  err: JsonError;

  pub fn init(self: &new, opts: WriteOptions) {
    *self = Writer(opts, String.empty(), List[OpenFrame].empty(), false, false, JsonError.none());
  }

  fn fail(self: &mut, kind: ErrorKind, reason: &str) {
    if self.failed { return; }
    self.failed = true;
    self.err = JsonError(kind, 0usize, 0u32, 0u32, String.from(reason));
  }

  // A new line and the indentation for depth levels, when indenting
  fn lineBreak(self: &mut, depth: usize) {
    if self.opts.indent == 0usize { return; }
    self.out.appendByte('\n');
    var n = depth * self.opts.indent;
    while n > 0usize {
      self.out.appendByte(' ');
      n = n - 1usize;
    }
  }

  // Before a value: the comma, the line break, and the check that a value
  // belongs here. False if not.
  fn beforeValue(self: &mut) bool {
    if self.failed { return false; }
    if self.open.len() == 0usize {
      if self.wrote {
        self.fail(ErrorKind.WriteOrder, "a second value at the top level: the text holds one value");
        return false;
      }
      self.wrote = true;
      return true;
    }
    let top = self.open.len() - 1usize;
    if self.open[top].isObject {
      if !self.open[top].owed {
        self.fail(ErrorKind.WriteOrder, "a value was written where an object's key belongs");
        return false;
      }
      self.open[top].owed = false;
      return true;
    }
    if self.open[top].count > 0usize { self.out.appendByte(','); }
    self.lineBreak(self.open.len());
    self.open[top].count = self.open[top].count + 1usize;
    true
  }

  pub fn beginObject(self: &mut) {
    if !self.beforeValue() { return; }
    self.out.appendByte('{');
    self.open.push(OpenFrame(true, 0usize, false));
  }

  pub fn beginArray(self: &mut) {
    if !self.beforeValue() { return; }
    self.out.appendByte('[');
    self.open.push(OpenFrame(false, 0usize, false));
  }

  pub fn endObject(self: &mut) { self.end(true); }

  pub fn endArray(self: &mut) { self.end(false); }

  fn end(self: &mut, isObject: bool) {
    if self.failed { return; }
    if self.open.len() == 0usize || self.open[self.open.len() - 1usize].isObject != isObject {
      if isObject { self.fail(ErrorKind.WriteOrder, "endObject with no object open"); }
      else { self.fail(ErrorKind.WriteOrder, "endArray with no array open"); }
      return;
    }
    let top = self.open.len() - 1usize;
    if self.open[top].owed {
      self.fail(ErrorKind.WriteOrder, "an object's key was written without its value");
      return;
    }
    let count = self.open[top].count;
    self.open.pop();
    if count > 0usize { self.lineBreak(self.open.len()); }
    if isObject { self.out.appendByte('}'); } else { self.out.appendByte(']'); }
  }

  // An object's next name
  pub fn key(self: &mut, name: &str) {
    if self.failed { return; }
    if self.open.len() == 0usize || !self.open[self.open.len() - 1usize].isObject {
      self.fail(ErrorKind.WriteOrder, "a key was written outside an object");
      return;
    }
    let top = self.open.len() - 1usize;
    if self.open[top].owed {
      self.fail(ErrorKind.WriteOrder, "a key was written where its predecessor's value is owed");
      return;
    }
    if self.open[top].count > 0usize { self.out.appendByte(','); }
    self.lineBreak(self.open.len());
    if !self.quoted(name) { return; }
    self.out.appendByte(':');
    if self.opts.indent > 0usize { self.out.appendByte(' '); }
    self.open[top].count = self.open[top].count + 1usize;
    self.open[top].owed = true;
  }

  // s as a string in quotes; false, having failed, when it is not UTF-8
  fn quoted(self: &mut, s: &Array[u8]) bool {
    match appendQuoted(&mut self.out, s, self.opts.asciiOnly) {
      case let Some(at) {
        var m = String.from("a string is not valid UTF-8 at its byte ");
        m.appendUInt(u64.from(at));
        self.fail(ErrorKind.WriteValue, m.view());
        false
      }
      case is None { true }
    }
  }

  pub fn string(self: &mut, s: &str) {
    if !self.beforeValue() { return; }
    self.quoted(s);
  }

  // A number given as its text, which must be RFC 8259's grammar
  pub fn number(self: &mut, text: &str) {
    if self.failed { return; }
    if !isNumberText(text) {
      self.fail(ErrorKind.WriteValue, "the number's text is not a JSON number");
      return;
    }
    if !self.beforeValue() { return; }
    self.out.append(text);
  }

  pub fn int(self: &mut, n: i64) {
    if !self.beforeValue() { return; }
    self.out.appendInt(n);
  }

  pub fn uint(self: &mut, n: u64) {
    if !self.beforeValue() { return; }
    self.out.appendUInt(n);
  }

  // x in the shortest text that reads back as x. NaN and infinity fail.
  pub fn float(self: &mut, x: f64) {
    if self.failed { return; }
    match formatF64(x) {
      case let Some(t) {
        if !self.beforeValue() { return; }
        self.out.append(t.view());
      }
      case is None {
        self.fail(ErrorKind.WriteValue, "NaN and infinity cannot be written in JSON");
      }
    }
  }

  pub fn boolean(self: &mut, b: bool) {
    if !self.beforeValue() { return; }
    if b { self.out.append("true"); } else { self.out.append("false"); }
  }

  pub fn nullValue(self: &mut) {
    if !self.beforeValue() { return; }
    self.out.append("null");
  }

  // A whole tree
  pub fn value(self: &mut, j: &Json) {
    if self.failed { return; }
    // A string is copied before it is handed to the Writer, which changes the
    // shape of its own String as it writes: a borrow of the tree's strings
    // would not be known to be a different String
    match j {
      case is Null { self.nullValue(); }
      case let Bool(b) { self.boolean(*b); }
      case let Number(n) {
        let c = n.copy();
        self.number(c.view());
      }
      case let Text(t) {
        let c = t.copy();
        self.string(c.view());
      }
      case let Array(a) {
        self.beginArray();
        each k in &*a { self.value(k); }
        self.endArray();
      }
      case let Object(o) {
        self.beginObject();
        each m in &*o {
          let c = m.key.copy();
          self.key(c.view());
          self.value(&m.value);
        }
        self.endObject();
      }
    }
  }

  // The text, once one value is written and complete; or the first failure. The writer is given up.
  pub fn finish(self) Result[String, JsonError] {
    var me = self;
    if !me.failed && me.open.len() > 0usize {
      me.fail(ErrorKind.WriteOrder, "finish with an array or object still open");
    }
    if !me.failed && !me.wrote {
      me.fail(ErrorKind.WriteOrder, "finish with no value written");
    }
    if me.failed { return Err[String, JsonError](me.err.copy()); }
    Ok[String, JsonError](me.(out))
  }
}

// s in double quotes, escaped, appended to out. None when it is written;
// Some(offset) of the first byte that is not well-formed UTF-8, with out
// holding whatever was written before it.
fn appendQuoted(out: &mut String, s: &Array[u8], ascii: bool) Option[usize] {
  out.appendByte('"');
  var i = 0usize;
  while i < s.len {
    let b = s[i];
    if b == '"' { out.append("\\\""); i = i + 1usize; }
    else if b == '\\' { out.append("\\\\"); i = i + 1usize; }
    else if b < 0x20u8 {
      if b == 8u8 { out.append("\\b"); }
      else if b == 12u8 { out.append("\\f"); }
      else if b == '\n' { out.append("\\n"); }
      else if b == '\r' { out.append("\\r"); }
      else if b == '\t' { out.append("\\t"); }
      else {
        out.append("\\u");
        out.appendHex(u64.from(b), 4usize);
      }
      i = i + 1usize;
    }
    else if b < 0x80u8 { out.appendByte(b); i = i + 1usize; }
    else {
      let len = utf8Length(s, i);
      if len == 0usize { return Some[usize](i); }
      if !ascii {
        out.appendBytes(&s[i..<i + len]);
      }
      else {
        let cp = utf8Decode(s, i, len);
        if cp >= 0x10000u32 {
          let v = cp - 0x10000u32;
          out.append("\\u");
          out.appendHex(u64.from(0xD800u32 + (v >> 10u32)), 4usize);
          out.append("\\u");
          out.appendHex(u64.from(0xDC00u32 + (v & 0x3FFu32)), 4usize);
        }
        else {
          out.append("\\u");
          out.appendHex(u64.from(cp), 4usize);
        }
      }
      i = i + len;
    }
  }
  out.appendByte('"');
  None
}

// The character of the len-byte UTF-8 sequence at pos, which is well-formed
fn utf8Decode(t: &Array[u8], pos: usize, len: usize) u32 {
  if len == 2usize { return (u32.from(t[pos] & 0x1Fu8) << 6u32) | u32.from(t[pos + 1usize] & 0x3Fu8); }
  if len == 3usize {
    return (u32.from(t[pos] & 0x0Fu8) << 12u32) | (u32.from(t[pos + 1usize] & 0x3Fu8) << 6u32) | u32.from(t[pos + 2usize] & 0x3Fu8);
  }
  (u32.from(t[pos] & 0x07u8) << 18u32) | (u32.from(t[pos + 1usize] & 0x3Fu8) << 12u32) | (u32.from(t[pos + 2usize] & 0x3Fu8) << 6u32) | u32.from(t[pos + 3usize] & 0x3Fu8)
}
