// Mapping a struct to JSON and back: a type says it is 'Serialize' and 'Deserialize', and 'toJson' and
// 'fromJson' do the rest from its fields, in order and by name. A member that is an Option is null or
// missing in the text and None in the value; every other member must be there, and a failure names it.
// Members the type does not have are skipped.
//
//   congo run examples/mapping.cone

mod mapping;

import stdio use *;
import collections use *;
import json;

struct Address is Serialize, Deserialize[Address] {
  pub street: String;
  pub zip: String;
}

struct Person is Serialize, Deserialize[Person] {
  pub name: String;
  pub age: i64;
  pub email: Option[String];
  pub tags: List[String];
  pub address: Address;
}

fn show(text: &str) {
  match json.fromJson[Person](text) {
    case let Ok(p) {
      printStr(p.name.view());
      printStr(" is ");
      printInt(p.age);
      printStr(", lives at ");
      printStr(p.address.street.view());
      printStr(" and has ");
      printInt(i64.from(p.tags.len()));
      printStr(" tags\n");
      match json.toJson(&p) {
        case let Ok(t) { printStr(t.view()); printStr("\n"); }
        case is Err { printStr("cannot write\n"); }
      }
    }
    case let Err(e) {
      let m = String() <- e;
      printStr(m.view());
      printStr("\n");
    }
  }
}

fn main() {
  show("{\"name\":\"Ada\",\"age\":36,\"tags\":[\"math\",\"engines\"],\"address\":{\"street\":\"1 Byron Rd\",\"zip\":\"W1\"},\"extra\":true}");
  show("{\"name\":\"Ada\",\"age\":36.5,\"tags\":[],\"address\":{\"street\":\"1 Byron Rd\",\"zip\":\"W1\"}}");
  show("{\"name\":\"Ada\",\"age\":36,\"tags\":[],\"address\":{\"street\":\"1 Byron Rd\"}}");
  show("{\"name\":\"Ada\",\"age\":}");
}
