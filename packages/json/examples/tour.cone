// Reading JSON, asking the tree what it holds, and writing it indented.
//
//   congo run examples/tour.cone

mod tour;

import stdio use *;
import json;

fn main() i32 {
  var doc json.Json = json.Json.Null;
  match json.parse("{\"name\": \"hello\", \"size\": 12, \"tags\": [\"a\", \"b\"]}") {
    case var ok Ok { doc <=> ok; }
    case let e Error {
      let m = e.message();
      printStr(m.view());
      return 1i32;
    }
  }
  match doc.getText("name") {
    case let n Some { printStr(n); printStr("\n"); }
    case is None { printStr("no name\n"); }
  }
  printInt(doc.i64Or("size", -1i64));
  printStr("\n");
  match doc.toPretty(2usize) {
    case let t Ok { printStr(t.view()); printStr("\n"); }
    case let e Error {
      let m = e.message();
      printStr(m.view());
      return 1i32;
    }
  }
  0i32
}
