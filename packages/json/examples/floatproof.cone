// The proof of core's FloatText, the shortest text that reads back as the
// same float: too slow for the default tests, so an example, run by hand:
//
//   congo run examples/floatproof.cone            (in packages/json)
//   congo run examples/floatproof.cone -- 4000000 1 lines.txt
//
// The arguments, each optional: the count of random f64 bit patterns
// (4000000), the step of the f32 sweep (1: every f32), and a file for the
// 'bits text' lines.
//
// Every text it makes must read back to the same bits through the C library's
// strtod (strtof for an f32), and no text one digit shorter may: the text's
// digits cut to one fewer, rounded down and rounded up, are both read back
// and must both differ. An f64's digits must also be json's ('formatF64', a
// second, independent shortest formatter, Go's method). The values: the edges
// named below, every power of two and of ten in range with its neighbours,
// the integers to 100000 and those over 1000, random bit patterns (denormals,
// NaNs and infinities among them), and every f32 whose bits are a multiple of
// the step. With a file it writes 'bits text' lines, one in eight of the f64s,
// for a third oracle, Python's repr (floatproof_repr.py, beside this file). It
// prints the counts and the first few failures, and exits 1 on any failure.

mod floatproof;

import stdio use *;
import collections use *;
import json;

extern fn strtod(s: *u8, end: *u8) f64;
extern fn strtof(s: *u8, end: *u8) f32;
extern fn fopen(name: *u8, mode: *u8) *u8;
extern fn fwrite(p: *u8, size: usize, count: usize, f: *u8) usize;
extern fn fclose(f: *u8) i32;

struct Stats {
  f64s: u64;
  f32s: u64;
  roundTrip: u64;      // read back as other bits
  notShortest: u64;    // one digit fewer also read back
  jsonDiffer: u64;     // json's digits differ
  tooLong: u64;        // over 24 bytes
  shown: u64;
  lines: *u8;          // the file of 'bits text' lines, or null
  lineCount: u64;
}

// xorshift64*
struct Rng {
  s: u64;
  fn next(self: &mut) u64 {
    s = s ^ (s >> 12u64);
    s = s ^ (s << 25u64);
    s = s ^ (s >> 27u64);
    s * 2685821657736338717u64
  }
}

// A float's text cut into its significant digits (no leading or trailing
// zero) and the decimal exponent X of the first (d.ddd * 10^X); none for zero
struct Sig {
  n: usize;
  x: i64;
  d: Array[u8, 40];
}

fn sigOf(t: &Array[u8]) Sig {
  var all = Array[u8, 40]() <- fill 0u8;
  var n = 0usize;
  var point = -1i64;
  var e = 0i64;
  var i = 0usize;
  if t.len > 0usize && t[0] == '-' {i = 1usize;}
  while i < t.len {
    let c = t[i];
    if c >= '0' && c <= '9' {
      all[n] = c - '0';
      n = n + 1usize;
    }
    else if c == '.' {
      point = i64.from(n);
    }
    else if c == 'e' {
      i = i + 1usize;
      var neg = false;
      if t[i] == '-' {neg = true; i = i + 1usize;}
      else if t[i] == '+' {i = i + 1usize;}
      while i < t.len {
        e = e * 10i64 + i64.from(t[i] - '0');
        i = i + 1usize;
      }
      if neg {e = 0i64 - e;}
    }
    i = i + 1usize;
  }
  if point < 0i64 {point = i64.from(n);}
  var lead = 0usize;
  while lead < n && all[lead] == 0u8 {lead = lead + 1usize;}
  var end = n;
  while end > lead && all[end - 1usize] == 0u8 {end = end - 1usize;}
  var sig = Sig(0usize, 0i64, Array[u8, 40]() <- fill 0u8);
  var k = lead;
  while k < end {
    sig.d[k - lead] = all[k];
    k = k + 1usize;
  }
  sig.n = end - lead;
  sig.x = point - 1i64 - i64.from(lead) + e;
  sig
}

fn sameSig(a: &Sig, b: &Sig) bool {
  if a.n != b.n || a.x != b.x {return false;}
  var i = 0usize;
  while i < a.n {
    if a.d[i] != b.d[i] {return false;}
    i = i + 1usize;
  }
  true
}

// Text into a NUL-ended buffer
struct CText {
  len: usize;
  b: Array[u8, 64];
  fn byte(self: &mut, c: u8) {
    b[len] = c;
    len = len + 1usize;
    b[len] = 0u8;
  }
  fn bytes(self: &mut, t: &Array[u8]) {
    var i = 0usize;
    while i < t.len {self.byte(t[i]); i = i + 1usize;}
  }
  fn int(self: &mut, v: i64) {
    var m = v;
    if v < 0i64 {self.byte('-'); m = 0i64 - v;}
    var digs = Array[u8, 24]() <- fill 0u8;
    var k = 0usize;
    var going = true;
    while going {
      digs[k] = u8.from(m % 10i64) + '0';
      k = k + 1usize;
      m = m / 10i64;
      going = m > 0i64;
    }
    while k > 0usize {k = k - 1usize; self.byte(digs[k]);}
  }
}

fn newCText() CText {CText(0usize, Array[u8, 64]() <- fill 0u8)}

// The two texts of one digit fewer than s: its first n-1 digits as an
// integer M, rounded down (M) or up (M + 1), times 10^(X - n + 2)
fn shorter(s: &Sig, up: bool, negative: bool) CText {
  var t = newCText();
  if negative {t.byte('-');}
  var m = 0i64;
  var i = 0usize;
  while i + 1usize < s.n {
    m = m * 10i64 + i64.from(s.d[i]);
    i = i + 1usize;
  }
  if up {m = m + 1i64;}
  t.int(m);
  t.byte('e');
  t.int(s.x - i64.from(s.n) + 2i64);
  t
}

fn fail(st: &mut Stats, what: &str, bits: u64, text: &Array[u8]) {
  if st.shown < 20u64 {
    print <- "FAIL ", what, " bits 0x";
    var s = String.empty();
    s.appendHex(bits, 16usize);
    print <- s.view(), " text ", text as &str, "\n";
  }
  st.shown = st.shown + 1u64;
}

fn check64(st: &mut Stats, bits: u64) {
  st.f64s = st.f64s + 1u64;
  let x = bits as f64;
  let ft = FloatText(x);
  let t: &Array[u8] = ft.text();
  var c = newCText();
  c.bytes(t);
  if t.len > 24usize {
    st.tooLong = st.tooLong + 1u64;
    fail(st, "too long", bits, t);
  }
  if st.lines != null && (st.f64s & 7u64) == 0u64 {
    var line = String.empty();
    line.appendHex(bits, 16usize);
    line <- " ";
    line <- ft.text();
    line <- "\n";
    let lb: &Array[u8] = line.view();
    fwrite(lb as *u8, 1usize, lb.len, st.lines);
    st.lineCount = st.lineCount + 1u64;
  }
  let back = strtod(&mut c.b as *u8, null);
  if x != x {
    if !(back != back) || t.len != 3usize {
      st.roundTrip = st.roundTrip + 1u64;
      fail(st, "nan", bits, t);
    }
    return;
  }
  if (back as u64) != bits {
    st.roundTrip = st.roundTrip + 1u64;
    fail(st, "round trip", bits, t);
    return;
  }
  if (bits & 0x7FF0000000000000u64) == 0x7FF0000000000000u64 {return;}
  let negative = (bits >> 63u64) != 0u64;
  let sig = sigOf(t);
  if sig.n >= 2usize {
    var dn = shorter(&sig, false, negative);
    var up = shorter(&sig, true, negative);
    if (strtod(&mut dn.b as *u8, null) as u64) == bits || (strtod(&mut up.b as *u8, null) as u64) == bits {
      st.notShortest = st.notShortest + 1u64;
      fail(st, "not shortest", bits, t);
    }
  }
  match json.formatF64(x) {
    case let Some(js) {
      let jsig = sigOf(js.view());
      if !sameSig(&sig, &jsig) {
        st.jsonDiffer = st.jsonDiffer + 1u64;
        fail(st, "json differs", bits, t);
        if st.shown <= 20u64 {print <- "  json ", js.view(), "\n";}
      }
    }
    case is None {}
  }
}

fn check32(st: &mut Stats, bits32: u64) {
  st.f32s = st.f32s + 1u64;
  let x = u32.from(bits32) as f32;
  let ft = FloatText.ofF32(x);
  let t: &Array[u8] = ft.text();
  var c = newCText();
  c.bytes(t);
  let back = strtof(&mut c.b as *u8, null);
  if x != x {
    if !(back != back) || t.len != 3usize {
      st.roundTrip = st.roundTrip + 1u64;
      fail(st, "f32 nan", bits32, t);
    }
    return;
  }
  if u64.from(back as u32) != bits32 {
    st.roundTrip = st.roundTrip + 1u64;
    fail(st, "f32 round trip", bits32, t);
    return;
  }
  if (bits32 & 0x7F800000u64) == 0x7F800000u64 {return;}
  let negative = (bits32 >> 31u64) != 0u64;
  let sig = sigOf(t);
  if sig.n >= 2usize {
    var dn = shorter(&sig, false, negative);
    var up = shorter(&sig, true, negative);
    if u64.from(strtof(&mut dn.b as *u8, null) as u32) == bits32 || u64.from(strtof(&mut up.b as *u8, null) as u32) == bits32 {
      st.notShortest = st.notShortest + 1u64;
      fail(st, "f32 not shortest", bits32, t);
    }
  }
}

fn argNumber(p: *u8) u64 {
  let ab: &Array[u8] = cstr.fromPtr(p).view();
  var v = 0u64;
  var i = 0usize;
  while i < ab.len {v = v * 10u64 + u64.from(ab[i] - '0'); i = i + 1usize;}
  v
}

// x and its two neighbours, both signs
fn checkAround(st: &mut Stats, x: f64) {
  let b = x as u64;
  check64(st, b);
  check64(st, b + 1u64);
  if b > 0u64 {check64(st, b - 1u64);}
  check64(st, b | 0x8000000000000000u64);
}

fn main(argc: i32, argv: **u8) i32 {
  var st = Stats(0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, null, 0u64);
  let count = if argc > 1i32 {argNumber(*(argv + 1usize))} else {4000000u64};
  let f32Step = if argc > 2i32 {argNumber(*(argv + 2usize))} else {1u64};
  if argc > 3i32 {
    st.lines = fopen(*(argv + 3usize), &"wb\0" as *u8);
  }

  // The edges
  check64(&mut st, 0u64);
  check64(&mut st, 0x8000000000000000u64);
  check64(&mut st, 1u64);                       // 5e-324, the least denormal
  check64(&mut st, 0x000FFFFFFFFFFFFFu64);      // the greatest denormal
  check64(&mut st, 0x0010000000000000u64);      // the least normal
  check64(&mut st, 0x7FEFFFFFFFFFFFFFu64);      // the greatest finite
  check64(&mut st, 0x7FF0000000000000u64);      // inf
  check64(&mut st, 0xFFF0000000000000u64);      // -inf
  check64(&mut st, 0x7FF8000000000000u64);      // nan
  check64(&mut st, 0xFFF8000000000001u64);      // a negative nan with a payload
  checkAround(&mut st, 9007199254740992.0);     // 2^53
  checkAround(&mut st, 0.1);
  checkAround(&mut st, 0.2);
  checkAround(&mut st, 0.3);
  checkAround(&mut st, 1e23);
  checkAround(&mut st, 5e-324);

  // Every power of two in range, and of ten, with their neighbours
  var e = 0u64;
  while e < 2047u64 {
    checkAround(&mut st, (e << 52u64) as f64);
    e = e + 1u64;
  }
  var p = 1.0;
  var k = 0i32;
  while k <= 308i32 {
    checkAround(&mut st, p);
    p = p * 10.0;
    k = k + 1i32;
  }
  k = -1i32;
  while k >= -323i32 {
    var t = newCText();
    t.bytes("1e");
    t.int(i64.from(k));
    checkAround(&mut st, strtod(&mut t.b as *u8, null));
    k = k - 1i32;
  }
  // Small integers and short decimals
  var n = 0u64;
  while n < 100000u64 {
    checkAround(&mut st, f64.from(n));
    checkAround(&mut st, f64.from(n) / 1000.0);
    n = n + 1u64;
  }

  // Random bit patterns, and random patterns with a narrow exponent
  var rng = Rng(0x9E3779B97F4A7C15u64);
  var r = 0u64;
  while r < count {
    let v = rng.next();
    check64(&mut st, v);
    r = r + 1u64;
  }
  r = 0u64;
  while r < count / 4u64 {
    let v = rng.next();
    check64(&mut st, (v & 0x800FFFFFFFFFFFFFu64) | ((1013u64 + (v >> 52u64) % 40u64) << 52u64));
    r = r + 1u64;
  }

  // f32: the sweep, then random patterns
  var b32 = 0u64;
  while b32 < 0x100000000u64 {
    check32(&mut st, b32);
    b32 = b32 + f32Step;
  }

  if st.lines != null {fclose(st.lines);}
  print <- "f64 checked ", st.f64s, ", f32 checked ", st.f32s, "\n";
  print <- "round trip failures ", st.roundTrip, ", not shortest ", st.notShortest,
    ", json differs ", st.jsonDiffer, ", over 24 bytes ", st.tooLong, "\n";
  if st.lines != null {print <- "lines written ", st.lineCount, "\n";}
  if st.roundTrip + st.notShortest + st.jsonDiffer + st.tooLong > 0u64 {return 1i32;}
  0i32
}
