// A client request whose body is fed by a stream: 'Client.upload(req, framing)' makes an Upload,
// 'Upload.sink()' is a stages.ChunkSink, and a pipeline (a FileSource, a gzip stage...) that ends in it
// becomes the request's body, so a large upload never sits whole in memory; 'Upload.stream()' awaits the
// response, as 'Client.stream' does. The sink is an actor shaped like ResponseSink (responsesink.cone): it
// posts each chunk to the service thread (the jobs below), which keeps them in the upload's StreamRec
// ('up', an UpState) and feeds them to the fetch (httpclient: sendUpload, pushBody, endBody).
//
// THE FETCH STARTS AT 'upload' (an UploadOpenJob), because the head goes out and the connection is
// chosen before any byte is accepted. The response's head, or a failure, that comes before 'stream' is
// asked waits in the record ('up.answer') for it; an Upload dropped without 'stream' cancels the fetch.
//
// OWNED CREDIT. The service thread pushes each chunk itself to the fetch, moved, with the source's home on
// it (iobuf IoHome, stages.chunkHome), one chunk at a time: the next goes when httpclient says (BodyRoom)
// that the connection has taken every chunk pushed so far. The chunk is not copied, and its death, when the
// connection is done with it (the send completed, a TLS write, an h2 frame cut, a fetch cancelled), sends
// the source 'giveBack'. So the connection's watermark is the credit: while the peer reads slowly the
// connection refuses, no BodyRoom comes, the chunks stay queued here as plain buffers and the source
// sends no more. What is held is the source's window of bytes. The fetch is dispatched later than the
// first chunks may come: the first chunk waits in httpclient's queue, and the chunks behind it here.
//
// LENGTH. The service counts the bytes against 'framing' as the chunks arrive: past a sized length, or
// short of it at the end, the fetch is cancelled and the source stopped Failed (httpclient and the cores
// panic on either). 'unsized' is chunked on HTTP/1.1 and plain DATA on HTTP/2 and HTTP/3.
//
// ENDINGS. The source is stopped once: Finished if the response comes before the body is all sent (an
// early 413, say: the response is delivered to 'stream', and a redirect that makes the next request a
// GET drops the body), or the fetch ended Done; Failed(the FetchError) if the fetch failed, was
// cancelled or timed out, or the length was wrong. The chunks held, and those still arriving, are given
// back. A streamed fetch is never retried, and a 307 or 308 is the response (httpclient's A STREAMED
// BODY).

// A response head that came before the upload's 'stream' was asked
struct UpHead {
  status: u16;
  version: Version;
  headers: Headers;
  url: String;
}

// What a stream record keeps of an upload; 'on' is false for any other stream
struct UpState {
  on: bool;
  src: Option[ChunkSource];       // the source feeding the sink
  home: Option[IoHome];           // the source's home: a chunk pushed carries it, and its death returns the credit
  chunks: Deque[IoBuf];           // chunks arrived, not yet pushed to the fetch
  got: u64;                       // bytes arrived
  sized: bool;
  length: u64;                    // a sized body's length
  room: bool;                     // the fetch's queue is empty: one piece may be pushed
  srcEnd: bool;                   // the source sent its end (either way)
  srcFailed: bool;                // ...Failed
  ended: bool;                    // the source's end(Finished) arrived and the length is right
  endSent: bool;                  // endBody was called
  settled: bool;                  // the source has been stopped (or will be on attach) and the chunks given back
  fin: bool;                      // ...Finished (else Failed)
  own: bool;                      // the service ended the fetch itself: 'failure' is why
  failure: httpclient.Failure;
  endKind: httpclient.EventKind;  // the fetch's final answer, if the fetch ended Failed, Cancelled or TimedOut
  head: Option[UpHead];           // the response's head, if it came before 'stream' was asked (the record's reader and group wait with it)
  err: Option[FetchError];        // ...or the fetch's failure, if that came first (no head)
  called: bool;                   // 'stream' was asked
  dropped: bool;                  // the Upload was dropped without asking

  fn idle() UpState {
    UpState(on: false, src: None[ChunkSource], home: None[IoHome], chunks: Deque[IoBuf](), got: 0u64,
      sized: false, length: 0u64, room: false, srcEnd: false, srcFailed: false, ended: false, endSent: false, settled: false, fin: false,
      own: false, failure: httpclient.Failure.none(), endKind: httpclient.EventKind.Done,
      head: None[UpHead], err: None[FetchError], called: false, dropped: false)
  }

  fn open(framing: BodyLength) UpState {
    var u = UpState.idle();
    u.on = true;
    u.room = true;
    u.sized = framing.isSized();
    u.length = framing.length;
    u
  }
}

// ---------------------------------------------------------------------------
// The service thread's work
// ---------------------------------------------------------------------------

// A chunk back to the source
fn upGive(s: &StreamRec, b: IoBuf) {
  match &s.up.src {
    case let &Some(u) {u.giveBack(b);}
    else {}
  }
}

// Every chunk held back to the source
fn upDrain(s: &mut StreamRec) {
  while true {
    match s.up.chunks.popFront() {
      case var Some(b) {upGive(s, b);}
      else {break;}
    }
  }
}

// Why the source is stopped Failed
fn upError(s: &StreamRec) FetchError {
  if s.up.own {return FetchError.failed(s.up.failure.clone());}
  endError(s.up.endKind, &s.up.failure)
}

// The source stopped for the settled ending
fn upStop(s: &StreamRec, u: &ChunkSource) {
  if s.up.fin {u.stop(Ending.Finished);}
  else {u.stop(Ending.Failed(AnyError.from(upError(s))));}
}

// The upload is over for the source: it is stopped (once; at its attach if it has none yet) and the
// chunks held go back. fin: Finished, else Failed with kind and failure (unless the service ended it)
fn upSettle(s: &mut StreamRec, fin: bool, kind: httpclient.EventKind, failure: httpclient.Failure) {
  if !s.up.on || s.up.settled {return;}
  s.up.settled = true;
  s.up.fin = fin;
  s.up.endKind = kind;
  if !s.up.own {s.up.failure = failure;}
  // (a source that has sent its end and is Finished with needs no stop; a failure is told even then, as a
  // sized sink does, so the first reason is on record)
  if !(s.up.srcEnd && fin) && !s.up.srcFailed {
    match &s.up.src {
      case let &Some(u) {upStop(s, u);}
      else {}
    }
  }
  upDrain(s);
}

// The fetch cannot go on: it is cancelled for the failure, and the source stopped
fn upFailOwn(rec: &mut ClientRec, lp: &mut Loop, s: &mut StreamRec, failure: httpclient.Failure) {
  if !s.up.on || s.up.settled {return;}
  s.up.own = true;
  s.up.failure = failure;
  rec.client.cancel(lp, s.fetch);
  upSettle(s, false, httpclient.EventKind.Failed, httpclient.Failure.none());
}

fn upLengthFailure(text: &str) httpclient.Failure {
  httpclient.Failure.make(httpclient.Stage.Limit, 0u32, ErrorKind.Malformed, text)
}

// Push the next piece of the chunks held while the fetch has room, and end the body once the source
// has ended and every byte is pushed
fn upPump(rec: &mut ClientRec, lp: &mut Loop, s: &mut StreamRec) {
  if !s.up.on || s.up.settled {return;}
  while s.up.chunks.len() > 0usize {
    // a chunk with bytes waits for room; an empty one goes back at once
    if s.up.chunks[0usize].len() > 0usize && !s.up.room {break;}
    match s.up.chunks.popFront() {
      case var Some(b) {
        if b.len() == 0usize {
          upGive(s, b);
        } else {
          // The chunk itself goes to the fetch, moved, wearing the source's home: its death returns the credit
          match &s.up.home {
            case let &Some(h) {b.setHome(h);}
            else {}
          }
          rec.client.pushBody(lp, s.fetch, b);
          s.up.room = false;
        }
      }
      else {break;}
    }
  }
  if s.up.ended && !s.up.endSent && s.up.chunks.len() == 0usize {
    s.up.endSent = true;
    rec.client.endBody(lp, s.fetch);
  }
}

// The fetch's queue is empty: every piece pushed was taken by the connection
fn upRoom(rec: &mut ClientRec, lp: &mut Loop, s: &mut StreamRec) {
  if !s.up.on || s.up.settled {return;}
  s.up.room = true;
  upPump(rec, lp, s);
}

// The live upload of stream id sid, with its client, or null
struct UpLoc {
  rec: *ClientRec;
  s: *StreamRec;
}

fn upLocate(sv: &mut Service, client: u64, sid: u64) UpLoc {
  let k = sv.findClient(client);
  if k >= sv.clients.bound() {return UpLoc(null, null);}
  let rec = sv.clientAt(k);
  let slot = (*rec).ups.getCopy(&sid) || 0xFFFFFFFFu32;
  if slot == 0xFFFFFFFFu32 {return UpLoc(null, null);}
  let s = streamOf(rec as &ClientRec, slot, sid);
  if s as usize == 0usize {return UpLoc(null, null);}
  UpLoc(rec, s)
}

// ---------------------------------------------------------------------------
// The sink
// ---------------------------------------------------------------------------

actor UploadSink is ChunkSink {
  client: u64;
  id: u64;
  up: Option[ChunkSource];       // kept past 'end': a chunk that finds its upload gone goes back through it

  pub fn init(self: &new, client: u64, id: u64) {
    *self = Self(client: client, id: id, up: None[ChunkSource]);
  }

  pub async fn attach(self, source: ChunkSource) {
    up = Some[ChunkSource](source.clone());
    post[UploadAttachJob](UploadAttachJob(client, id, source));
  }

  pub async fn accept(self, c: IoBuf) {
    post[UploadChunkJob](UploadChunkJob(client, id, c, selfactor.clone()));
  }

  pub async fn end(self, how: Ending) {
    post[UploadEndJob](UploadEndJob(client, id, how));
  }

  // The sink dropped with no source ever attached: nothing will come
  fn final(self: &uni) {
    match &up {
      case let &Some(u) {}
      else {post[UploadGoneJob](UploadGoneJob(client, id));}
    }
  }

  // A chunk the service thread could not take (its upload is over): back to the source
  pub async fn home(self, c: IoBuf) {
    match &up {
      case let &Some(u) {u.giveBack(c);}
      else {}
    }
  }
}

// ---------------------------------------------------------------------------
// The handle
// ---------------------------------------------------------------------------

// A request being sent with a streamed body (Client.upload): plain data naming a record the service
// thread owns, which moves. 'sink' is the body's end of a pipeline; 'stream' awaits the response.
// Dropped without 'stream', the upload is cancelled
pub struct Upload is Move {
  client: u64;
  id: u64;
  snk: UploadSink;
  asked: Atomic[u8];

  // The sink a pipeline ends in: the request's body. Any number of handles; one source is attached
  pub fn sink(self: &) ChunkSink {
    let k: ChunkSink = snk.clone();
    k
  }

  // The response, answered when its head arrives (or the fetch fails first), with a BodyStream as
  // Client.stream's. Asked once; a response that came before it is waiting. A response that comes
  // before the body is all sent (an early 413, say) is delivered here, and the source is stopped Finished
  pub fn stream(self: &, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[BodyStream, FetchError]] {
    if asked.load() != 0u8 {die("actorhttp: stream was asked of this upload already", file, line);}
    asked.store(1u8);
    awaitable[UploadStreamJob, Result[BodyStream, FetchError]](UploadStreamJob(client, id))
  }

  fn final(self: &uni) {
    if asked.load() == 0u8 {post[UploadDropJob](UploadDropJob(client, id));}
  }
}

// ---------------------------------------------------------------------------
// The jobs
// ---------------------------------------------------------------------------

// An upload begun: its record added and its fetch started, the head going out as a connection is chosen
struct UploadOpenJob {
  pub id: u64;
  pub sid: u64;
  pub req: httpclient.Request;
  pub reader: ReaderSink[Result[Option[String], FetchError]];
  pub group: CancelGroup;
  pub framing: BodyLength;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let id, sid, req, reader, group, framing = self.(id, sid, req, reader, group, framing);
    let k = sv.findClient(id);
    if k >= sv.clients.bound() {
      reader.end(Ending.Failed(AnyError.from(FetchError.cancelled())));
      return;
    }
    let rec = sv.clients.borrowMutAt(u32.from(k)).unwrap();
    var st = openingStream(sid);
    st.bodyReader = Some[ReaderSink[Result[Option[String], FetchError]]](reader);
    st.group = Some[CancelGroup](group);
    st.up = UpState.open(framing);
    let sh = rec.streams.add(st);
    let sslot = usize.from(sh.index);
    rec.refs = rec.refs + 1u32;
    rec.ups.insert(sid, u32.from(sslot));
    let fetch = rec.client.sendUpload(lp, req, httpclient.Sink.Here(tokenOf(sh, streamBit)), framing);
    (rec.streams.borrowMutAt(u32.from(sslot)).unwrap()).fetch = fetch;
  }
}

// The sink was given its source
struct UploadAttachJob {
  pub client: u64;
  pub sid: u64;
  pub up: ChunkSource;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let client, sid, up = self.(client, sid, up);
    let loc = upLocate(sv, client, sid);
    if loc.s as usize == 0usize {
      up.stop(Ending.Failed(AnyError.from(FetchError.cancelled())));
      return;
    }
    let s = loc.s as &mut StreamRec;
    if s.up.settled {
      if !(s.up.srcEnd && s.up.fin) && !s.up.srcFailed {upStop(s, &up);}
      return;
    }
    s.up.home = Some[IoHome](chunkHome(up.clone()));
    s.up.src = Some[ChunkSource](up);
  }
}

// A chunk of the body
struct UploadChunkJob {
  pub client: u64;
  pub sid: u64;
  pub buf: IoBuf;
  pub home: UploadSink;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let client, sid, buf, home = self.(client, sid, buf, home);
    let loc = upLocate(sv, client, sid);
    if loc.s as usize == 0usize {
      home.home(buf);
      return;
    }
    let rec = loc.rec as &mut ClientRec;
    let s = loc.s as &mut StreamRec;
    if s.up.settled || s.up.ended {
      home.home(buf);
      return;
    }
    s.up.got = s.up.got + u64.from(buf.len());
    if s.up.sized && s.up.got > s.up.length {
      home.home(buf);
      upFailOwn(rec, lp, s, upLengthFailure("the body is longer than the length declared to upload"));
      return;
    }
    s.up.chunks.push(buf);
    upPump(rec, lp, s);
  }
}

// The stream is over
struct UploadEndJob {
  pub client: u64;
  pub sid: u64;
  pub how: Ending;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let client, sid, how = self.(client, sid, how);
    let loc = upLocate(sv, client, sid);
    if loc.s as usize == 0usize {return;}
    let rec = loc.rec as &mut ClientRec;
    let s = loc.s as &mut StreamRec;
    s.up.srcEnd = true;
    if s.up.settled || s.up.ended {return;}
    match how {
      case is Finished {
        if s.up.sized && s.up.got != s.up.length {
          upFailOwn(rec, lp, s, upLengthFailure("the body is shorter than the length declared to upload"));
        } else {
          s.up.ended = true;
          upPump(rec, lp, s);
        }
      }
      else {
        // the pipeline failed: the request is cut short (the source is not told what it said)
        s.up.srcFailed = true;
        upFailOwn(rec, lp, s, upLengthFailure("the upload's source ended Failed"));
      }
    }
  }
}

// The sink actor was dropped and no source had been attached to it
struct UploadGoneJob {
  pub client: u64;
  pub sid: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let loc = upLocate(sv, client, sid);
    if loc.s as usize == 0usize {return;}
    let s = loc.s as &mut StreamRec;
    if s.up.settled || s.up.ended || s.up.got != 0u64 {return;}
    match &s.up.src {
      case let &Some(u) {return;}
      else {}
    }
    upFailOwn(loc.rec as &mut ClientRec, lp, s, upLengthFailure("the upload's sink was dropped with no source attached"));
  }
}

// 'stream' was asked: the answer waits in the record if the head (or the failure) came, else the reply
// is kept for it
struct UploadStreamJob {
  pub client: u64;
  pub sid: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[BodyStream, FetchError]]) {
    let loc = upLocate(sv, client, sid);
    if loc.s as usize == 0usize {
      rp.answer(Err[BodyStream, FetchError](FetchError.cancelled()));
      return;
    }
    let rec = loc.rec as &mut ClientRec;
    let s = loc.s as &mut StreamRec;
    s.up.called = true;
    let slot = rec.ups.getCopy(&sid) || 0u32;
    var err: Option[FetchError] = None;
    err <-> s.up.err;
    var head: Option[UpHead] = None;
    head <-> s.up.head;
    match err {
      case var Some(x) {
        // the fetch ended before its head: nothing more is kept
        rp.answer(Err[BodyStream, FetchError](x));
        freeStream(rec, usize.from(slot));
        unrefClient(rec, lp);
        return;
      }
      else {}
    }
    match head {
      case var Some(h) {
        match upBody(rec, s, slot, h) {
          case var Some(bs) {rp.answer(Ok[BodyStream, FetchError](bs));}
          else {rp.answer(Err[BodyStream, FetchError](FetchError.cancelled()));}
        }
      }
      else {
        s.openBody = Some[actors.ReplyOf[Result[BodyStream, FetchError]]](rp);
      }
    }
  }
}

// The BodyStream for a head that waited: made of the record's reader and group
fn upBody(rec: &ClientRec, s: &mut StreamRec, slot: u32, h: UpHead) Option[BodyStream] {
  var reader = None[ReaderSink[Result[Option[String], FetchError]]];
  reader <-> s.bodyReader;
  var group = None[CancelGroup];
  group <-> s.group;
  let status, version, headers, url = h.(status, version, headers, url);
  match reader {
    case let Some(rd) {
      match group {
        case let Some(g) {
          return Some[BodyStream](BodyStream(rd, g, status, version, headers, url,
            Atomic[u8].of(bodyUnchosen), rec.id, slot, s.id));
        }
        else {}
      }
    }
    else {}
  }
  None[BodyStream]
}

// The Upload was dropped without 'stream'
struct UploadDropJob {
  pub client: u64;
  pub sid: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let loc = upLocate(sv, client, sid);
    if loc.s as usize == 0usize {return;}
    let rec = loc.rec as &mut ClientRec;
    let s = loc.s as &mut StreamRec;
    if s.up.called {return;}
    s.up.dropped = true;
    let slot = rec.ups.getCopy(&sid) || 0u32;
    var err: Option[FetchError] = None;
    err <-> s.up.err;
    var head: Option[UpHead] = None;
    head <-> s.up.head;
    if err is Some {
      // the fetch ended before its head: nothing more is kept
      freeStream(rec, usize.from(slot));
      unrefClient(rec, lp);
      return;
    }
    match head {
      case var Some(h) {
        // the head came: the BodyStream made and dropped unchosen, which cancels the fetch and lets go of its body
        let dropped = upBody(rec, s, slot, h);
      }
      else {
        rec.client.cancel(lp, s.fetch);
      }
    }
  }
}
