// The service thread's side of a server: what it keeps for each listening
// Server and each request (an ExRec), how the driver's events become
// exchanges delivered to actors, and the jobs the Server and Exchange handles
// post (actorhttp.cone's header, A SERVER, says how the pieces fit).

// ---------------------------------------------------------------------------
// Records
// ---------------------------------------------------------------------------

// A request's stage on the service thread
const exReading = 0u32;     // its head is in; its body is being read
const exReady = 1u32;       // whole, waiting for an actor to take it
const exOut = 2u32;         // an actor has it (or the server answered it itself)
const exDead = 3u32;        // it ended while it waited; its slot is freed when the queue reaches it

// Body bytes an actor asked to write, and where they stand
struct PendingWrite {
  data: String;
  sent: usize;                    // ...how many the connection has taken
  reply: Option[actors.ReplyOf[Result[usize, ServerError]]];    // the actor awaiting them, until they are sent
}

// A request whole and waiting for an actor: its slot, and the request
struct ReadyEx {
  slot: usize;
  request: Request;
}

// One request and its response, on the service thread (the request itself is
// read into the server's 'reading', and goes to the actor that takes it)
struct ExRec {
  used: bool;
  id: u64;
  req: httpconn.ReqId;
  qreq: httpclient.H3Req;      // ...or its request on the HTTP/3 plug-in
  onH3: bool;                  // it came over HTTP/3
  stage: u32;
  rejected: bool;              // the server answered it itself (413, 503, 500)
  isHead: bool;                // a HEAD request: its response has no body bytes
  bodyless: bool;              // the response has no body bytes
  responded: bool;             // the response's head has gone to the driver
  chunked: bool;               // its body is of unknown length
  sized: bool;
  length: u64;
  written: u64;                // body bytes the connection has taken
  finishing: bool;             // 'finish' was asked: finish the body once the writes are done
  finished: bool;              // the driver has been told the body is whole
  finishReply: Option[actors.ReplyOf[Result[u64, ServerError]]];   // the actor awaiting 'finish'
  writes: List[PendingWrite];
  wi: usize;                   // the first write not complete
  handle: bool;                // an Exchange names it
  over: bool;                  // the driver's final answer has come
  ok: bool;                    // ...and was Done
  sinkOpen: bool;              // a bodySink was taken and its 'end' has not come (responsesink.cone)
  sinkFailed: bool;            // its pipeline was stopped or the body failed: chunks arriving go straight back
  sinkEnded: bool;             // its 'end(Finished)' has come: finish the body once the chunks are sent
  sinkUp: Option[ChunkSource]; // the source feeding it
  sinkChunks: Deque[IoBuf];    // chunks arrived, not yet taken by the connection (a refused one waits at the front)
  sinkHome: Option[IoHome];    // the source's home: a chunk sent carries it, and its death returns the credit
  sinkIn: u64;                 // body bytes the sink has been given, for the declared length
  sinkGone: bool;              // the sink actor was dropped and no source was ever attached to it: no body will come
  // The request's body as a stream (ServerConfig.streamBodies; requestbody.cone). 'inMode' says the exchange is
  // one. Its body goes to 'inSink' from 'inLend' as a response body does to a client's sink (lend.cone); until
  // the handler's choice ('inAwait') it is staged and 'inKept' keeps its end. 'inDiscard': nobody wants the rest,
  // the bytes are released as they arrive. 'inRefused': the pool refused a staging buffer
  inMode: bool;
  inAwait: bool;
  inContinue: bool;            // an 'Expect: 100-continue' not yet answered
  inEnded: bool;               // the body's end has come
  inDiscard: bool;
  inRefused: bool;
  inSink: Option[ChunkSink];
  inKept: Option[Ending];
  inLend: BodyLend;
}

// The record of request req (or qreq, over HTTP/3), its head just read
fn readingEx(req: httpconn.ReqId, qreq: httpclient.H3Req, onH3: bool, isHead: bool) ExRec {
  ExRec(used: true, id: newId(), req: req, qreq: qreq, onH3: onH3, stage: exReading, rejected: false, isHead: isHead, bodyless: false,
    responded: false, chunked: false, sized: false, length: 0u64, written: 0u64, finishing: false,
    finished: false, finishReply: None, writes: List[PendingWrite](), wi: 0usize, handle: false,
    over: false, ok: false, sinkOpen: false, sinkFailed: false, sinkEnded: false, sinkUp: None[ChunkSource],
    sinkChunks: Deque[IoBuf](), sinkHome: None[IoHome], sinkIn: 0u64, sinkGone: false,
    inMode: false, inAwait: false, inContinue: false, inEnded: false, inDiscard: false, inRefused: false,
    inSink: None[ChunkSink], inKept: None[Ending], inLend: newLend())
}

// A server's exchanges, in a pool of its own
alias Exchanges = GenPool[ExRec];

// A listening server the service owns: its own driver (so its bounds are its
// own), its listener, its requests, those waiting for an actor and the actors
// waiting for one
struct SrvRec {
  id: u64;
  refs: u32;
  closing: bool;              // no longer listening
  aborted: bool;              // its connections have been reset, being closed and idle
  secure: bool;
  maxBody: usize;
  maxPending: usize;
  streamBodies: bool;         // requests are delivered at their heads (requestbody.cone)
  drv: httpconn.Driver;
  listener: httpconn.ListenerId;
  exs: Exchanges;
  byReq: Dict[u64, usize];    // a request's key (its number on the driver, or h3Key's) to its slot
  reading: Dict[u64, Request];   // a request's key to the request being read in
  ready: Deque[ReadyEx];      // the requests whole and waiting for an actor
  waiters: Deque[actors.ReplyOf[Result[Exchange, ServerError]]];  // the 'next's waiting
  live: usize;                // requests whose final answer has not come
  h3: Uni[httpclient.Http3];  // its HTTP/3 plug-in (httpclient.NoHttp3 when it offers none)
  h3on: bool;
  h3listener: u64;
  altSvc: String;             // the Alt-Svc its TCP responses carry, or empty
  qkeys: Dict[QKey, u64];     // an HTTP/3 request to its key
  nextKey: u64;
  closeWaiters: Deque[actors.ReplyOf[bool]];  // the 'closed's waiting
}

// An HTTP/3 request's ids, as a key
struct QKey is Hash {
  conn: u64;
  req: u64;

  pub fn `==`(self, o: QKey) bool {conn == o.conn && req == o.req}
}

// The bit an HTTP/3 request's key has, which no driver's request number has
// (a number is its generation, 16 bits, above its index's 32)
const h3Key = 0x8000000000000000u64;

// A request's event from either driver, in one shape: a request's head, its
// body's bytes, its end, room to write, its final answer
const sRequest = 0u32;
const sData = 1u32;
const sEnd = 2u32;
const sWritable = 3u32;
const sDone = 4u32;
const sOver = 5u32;         // a final answer other than Done
const sOther = 6u32;        // nothing for the server

struct SrvEv {
  kind: u32;
  key: u64;
  req: httpconn.ReqId;
  qreq: httpclient.H3Req;
  peer: SocketAddr;
  head: RequestHead;
  framing: BodyLength;
  buf: IoBuf;
  why: httpclient.Failure;   // a final answer's failure from the driver, with a detail when it names why a body ended early
}

// The layers of a TLS listener's connections: a server session each, from one context
struct TlsMaker {
  server: tls.Server;

  pub fn make(self: &mut) Uni[httpconn.Layer] {Uni[tls.Stream](server.stream())}
}

// A reply kept in an Option answered in place, and let go
fn answerKeptIn[R](kept: &mut Option[actors.ReplyOf[R]], v: R) {
  var taken: Option[actors.ReplyOf[R]] = None;
  taken <-> *kept;
  match taken {
    case let Some(r) {r.answer(v);}
    else {}
  }
}


// The slot of the request whose key is key, or the number of slots when it is none
fn slotOfKey(srv: &SrvRec, key: u64) usize { srv.byReq.getCopy(&key) || srv.exs.bound() }

fn freeEx(srv: &mut SrvRec, slot: usize) {
  srv.exs.removeAt(u32.from(slot));
}

// ---------------------------------------------------------------------------
// What the driver says
// ---------------------------------------------------------------------------

fn pumpServer(srv: &mut SrvRec, lp: &mut Loop) {
  var evs = List[httpconn.Event]();
  srv.drv.pump(lp, &uni evs);
  each e in evs.drain() {
    onServerEvent(srv, lp, e);
  }
  if !srv.h3on {return;}
  var hs = List[httpclient.H3Event]();
  srv.h3.turn(lp);
  srv.h3.takeEvents(&mut hs);
  each e in hs.drain() {
    onH3ServerEvent(srv, lp, e);
  }
}

// An event of the server's driver, taken by value, in the shape both
// drivers' take
fn onServerEvent(srv: &mut SrvRec, lp: &mut Loop, e: httpconn.Event) {
  let k = e.kind;
  var kind = sOther;
  if k == httpconn.EventKind.Request {kind = sRequest;}
  else if k == httpconn.EventKind.Data {kind = sData;}
  else if k == httpconn.EventKind.End {kind = sEnd;}
  else if k == httpconn.EventKind.Writable {kind = sWritable;}
  else if k == httpconn.EventKind.Done {kind = sDone;}
  else if e.isTerminal() {kind = sOver;}
  if kind == sOther {return;}
  let why = if kind == sDone || kind == sOver {httpclient.Failure.fromConn(&e.failure)} else {httpclient.Failure.none()};
  let req, conn, framing, head, buf = e.(req, conn, body, request, buf);
  let peer = if kind == sRequest {srv.drv.peer(conn)} else {SocketAddr.localhost(0u16)};
  onSrvEv(srv, lp, SrvEv(kind, req.number(), req, httpclient.H3Req.none(), peer, head, framing, buf, why));
}

// An event of the server's HTTP/3 plug-in, the same way: each request has a
// key of its own (h3Key's bit and a count) from its head to its final answer
fn onH3ServerEvent(srv: &mut SrvRec, lp: &mut Loop, e: httpclient.H3Event) {
  let k = e.kind;
  var kind = sOther;
  if k == httpclient.H3Kind.Request {kind = sRequest;}
  else if k == httpclient.H3Kind.Data {kind = sData;}
  else if k == httpclient.H3Kind.End {kind = sEnd;}
  else if k == httpclient.H3Kind.Writable {kind = sWritable;}
  else if k == httpclient.H3Kind.Done {kind = sDone;}
  else if e.isTerminal() {kind = sOver;}
  if kind == sOther {return;}
  let q = e.req;
  let qk = QKey(q.conn, q.req);
  var key = 0u64;
  if kind == sRequest {
    key = h3Key | srv.nextKey;
    srv.nextKey = srv.nextKey + 1u64;
    let previous = srv.qkeys.insert(qk, key);
  } else {
    match srv.qkeys.getCopy(&qk) {
      case let Some(v) {key = v;}
      case is None[u64] {
        // A request the server never took: its body's credit back
        if kind == sData {srv.h3.release(q, e.buf.len());}
        return;
      }
    }
  }
  if kind == sDone || kind == sOver {let gone = srv.qkeys.remove(&qk);}
  let peer = if kind == sRequest {srv.h3.peer(e.conn)} else {SocketAddr.localhost(0u16)};
  let framing, head, buf = e.(body, request, buf);
  onSrvEv(srv, lp, SrvEv(kind, key, httpconn.ReqId.none(), q, peer, head, framing, buf, httpclient.Failure.none()));
}

// A request's event, from either driver: a request's head goes whole into
// the request being read
fn onSrvEv(srv: &mut SrvRec, lp: &mut Loop, e: SrvEv) {
  let k = e.kind;
  let key = e.key;
  if k == sRequest {
    let req, qreq, peer, framing, head = e.(req, qreq, peer, framing, head);
    let onH3 = !qreq.isNone();
    let slot = usize.from(srv.exs.add(readingEx(req, qreq, onH3, head.method == Method.Head)).index);
    let x = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
    srv.byReq.insert(key, slot);
    srv.live = srv.live + 1usize;
    if srv.closing {
      x.rejected = true;
      x.stage = exOut;
      answerText(srv, slot, 503u16, "the server is closing", true);
    } else if srv.streamBodies {
      // Delivered at its head: its body is staged until the handler chooses (requestbody.cone). maxBody and the
      // 413 are the gathered path's; a 100 Continue waits for the handler's first read
      x.inMode = true;
      x.inAwait = true;
      x.inContinue = head.headers.hasToken("Expect", "100-continue");
      readyEx(srv, slot, Request(head, String(), peer, srv.secure));
    } else if framing.isSized() && framing.length > u64.from(srv.maxBody) {
      x.rejected = true;
      x.stage = exOut;
      answerText(srv, slot, 413u16, "the request body is too large", true);
    } else {
      if head.headers.hasToken("Expect", "100-continue") {sendContinue(srv, slot);}
      srv.reading.insert(key, Request(head, String(), peer, srv.secure));
    }
  } else if k == sData && srv.streamBodies {
    onStreamedData(srv, lp, e);
  } else if k == sData {
    let n = e.buf.len();
    let slot = slotOfKey(srv, key);
    if slot < srv.exs.bound() {
      let x = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
      if x.stage == exReading && !x.rejected {
        var over = false;
        match srv.reading.getMut(&key) {
          case let Some(r) {
            over = !streams.gather(&mut r.body, e.buf.view(), srv.maxBody);
          }
          else {}
        }
        if over {
          srv.reading.remove(&key);
          x.rejected = true;
          x.stage = exOut;
          answerText(srv, slot, 413u16, "the request body is too large", true);
        }
      }
    }
    if e.qreq.isNone() {srv.drv.release(e.req, n);} else {srv.h3.release(e.qreq, n);}
  } else if k == sEnd && srv.streamBodies {
    let slot = slotOfKey(srv, key);
    if slot < srv.exs.bound() {
      let x = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
      x.inEnded = true;
      if x.inMode && !x.rejected && !x.inDiscard {
        if x.inAwait {x.inKept = Some[Ending](Ending.Finished);}
        else {inFinish(x, Ending.Finished);}
      }
    }
  } else if k == sEnd {
    let slot = slotOfKey(srv, key);
    // The request read whole: taken out of 'reading' by value
    match srv.reading.remove(&key) {
      case var Some(r) {
        if slot < srv.exs.bound() {readyEx(srv, slot, r);}
      }
      else {}
    }
  } else if k == sWritable {
    let slot = slotOfKey(srv, key);
    if slot < srv.exs.bound() {
      pumpWrites(srv, lp, slot);
    }
  } else if k == sDone || k == sOver {
    let slot = slotOfKey(srv, key);
    if slot < srv.exs.bound() {endEx(srv, slot, k == sDone, &e.why);}
    srv.byReq.remove(&key);
    srv.reading.remove(&key);
  }
}

// ---------------------------------------------------------------------------
// A response, to whichever driver carries its request
// ---------------------------------------------------------------------------

// Its head: a TCP one says where HTTP/3 is, when the server offers it and
// the program wrote no Alt-Svc of its own
fn srvRespond(srv: &mut SrvRec, slot: usize, head: ResponseHead, framing: BodyLength) {
  let r = routeOf(srv, slot);
  if r.onH3 {
    srv.h3.respond(r.qreq, head, framing);
    return;
  }
  var h = head;
  if srv.altSvc.len() > 0usize && !h.headers.has("Alt-Svc") {
    let a = srv.altSvc.clone();
    h.headers.add("Alt-Svc", a.view());
  }
  srv.drv.respond(r.req, h, framing);
}

// Body bytes, moved in: None when taken, or the buffer back when the connection refuses it (Writable comes
// when there is room)
fn srvSendBuf(srv: &mut SrvRec, slot: usize, b: IoBuf) Option[IoBuf] {
  let r = routeOf(srv, slot);
  if r.onH3 {srv.h3.sendData(r.qreq, b)} else {srv.drv.sendData(r.req, b)}
}

// Body bytes: whether they were taken (else Writable comes when there is room)
fn srvSend(srv: &mut SrvRec, slot: usize, b: IoBuf) bool {
  let r = routeOf(srv, slot);
  if r.onH3 {
    match srv.h3.sendData(r.qreq, b) {
      case is None[IoBuf] {return true;}
      else {return false;}
    }
  }
  match srv.drv.sendData(r.req, b) {
    case is None[IoBuf] {true}
    else {false}
  }
}

fn srvFinish(srv: &mut SrvRec, slot: usize) {
  let r = routeOf(srv, slot);
  if r.onH3 {srv.h3.finish(r.qreq);} else {srv.drv.finish(r.req);}
  stopUpload(srv, slot);
}

// A streamed request's body nobody wants (dropped unread, never taken, cut by a limit) while its response is
// whole: over HTTP/2 the stream is reset with NO_ERROR (RFC 9113 section 8.1), over HTTP/3 the client is asked
// to stop with STOP_SENDING H3_NO_ERROR (RFC 9114 section 4.1), so it stops sending. It is called at the
// response's end and at the drop, and does its work at whichever comes second. A handler still holding the
// body (it reads it, it is staged for it) is not affected: its reads end with End, on HTTP/1.1 too (the
// connection keeps reading it). On HTTP/1.1 the driver reads the dropped body out instead, up to 256 KiB,
// and keeps the connection if it ends inside that
fn stopUpload(srv: &mut SrvRec, slot: usize) {
  let r = routeOf(srv, slot);
  {
    let x = srv.exs.borrowAt(u32.from(slot)).unwrap();
    if !x.inMode || !x.inDiscard || x.inEnded || !x.finished || x.over {return;}
  }
  if r.onH3 {srv.h3.stopBody(r.qreq);} else {srv.drv.stopBody(r.req);}
}

fn srvCancel(srv: &mut SrvRec, lp: &mut Loop, slot: usize) {
  let r = routeOf(srv, slot);
  if r.onH3 {srv.h3.cancel(lp, r.qreq);} else {srv.drv.cancel(lp, r.req);}
}

// 100 Continue, for a request that asked for it
fn sendContinue(srv: &mut SrvRec, slot: usize) {
  let r = routeOf(srv, slot);
  if r.onH3 {srv.h3.sendInterim(r.qreq, ResponseHead.make(100u16));} else {srv.drv.sendContinue(r.req);}
}

// Where a request's calls go, copied out of its record so that no borrow of the record is held across them
struct Route {
  onH3: bool;
  qreq: httpclient.H3Req;
  req: httpconn.ReqId;
}

fn routeOf(srv: &SrvRec, slot: usize) Route {
  let x = srv.exs.borrowAt(u32.from(slot)).unwrap();
  Route(x.onH3, x.qreq, x.req)
}
// A request whose head and whole body are in: to the actor waiting for one,
// else into the queue (503 if that is full)
fn readyEx(srv: &mut SrvRec, slot: usize, r: Request) {
  match srv.waiters.popFront() {
    case var Some(rp) {deliverEx(srv, slot, rp, r);}
    else {
      if srv.ready.len() >= srv.maxPending {
        {
          let x = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
          x.rejected = true;
          x.inAwait = false;
          x.stage = exOut;
        }
        answerText(srv, slot, 503u16, "the server is busy", false);
      } else {
        srv.exs.borrowMutAt(u32.from(slot)).unwrap().stage = exReady;
        srv.ready.push(ReadyEx(slot, r));
      }
    }
  }
}

// An actor has the request: its Exchange is the answer to the reply
fn deliverEx(srv: &mut SrvRec, slot: usize, rp: actors.ReplyOf[Result[Exchange, ServerError]], r: Request) {
  let x = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
  x.stage = exOut;
  x.handle = true;
  let ex = Exchange(srv.id, u32.from(slot), x.id, 0u32, false, 0u64, 0u64, false, x.inMode, false, r);
  rp.answer(Ok[Exchange, ServerError](ex));
}

// The server answers a request itself, with text
fn answerText(srv: &mut SrvRec, slot: usize, status: u16, text: &str, closeAfter: bool) {
  var h = ResponseHead.make(status);
  h.headers.add("Content-Type", "text/plain; charset=utf-8");
  let onH3, isHead = {
    let x = srv.exs.borrowAt(u32.from(slot)).unwrap();
    (x.onH3, x.isHead)
  };
  // HTTP/3 has no Connection field: its stream ends the exchange, the connection carries on
  if closeAfter && !onH3 {h.headers.add("Connection", "close");}
  let n = text.len;
  var b = IoBuf();
  if !isHead && n > 0usize {
    // A pool that refuses the text's buffer (iobuf's tryMake) leaves it out:
    // the status, which is the answer, goes with no body
    b = match IoBuf.tryMake(n) {
      case var Some(got) {got}
      else {IoBuf()}
    };
  }
  let have = b.capacity() > 0usize;
  let len = if have {n} else {0usize};
  srvRespond(srv, slot, h, BodyLength.sized(u64.from(len)));
  {
    let x = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
    x.responded = true;
    x.finished = true;
    x.finishing = true;
  }
  if have {
    b.append(text as &Array[u8]);
    let taken = srvSend(srv, slot, b);
    srvFinish(srv, slot);
  }
}

// The request's final answer has come
fn endEx(srv: &mut SrvRec, slot: usize, done: bool, why: &httpclient.Failure) {
  let x = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
  x.over = true;
  x.ok = done;
  if srv.live > 0usize {srv.live = srv.live - 1usize;}
  // Writes still to go, and a finish still waiting, are answered
  while x.wi < x.writes.len() {
    let w = &mut x.writes[x.wi];
    x.wi = x.wi + 1usize;
    answerKeptIn[Result[usize, ServerError]](&mut w.reply, Err[usize, ServerError](ServerError.closed()));
  }
  x.writes.clear();
  x.wi = 0usize;
  // A sink still open: its source is stopped, and the chunks it held go back
  if x.sinkOpen {
    sinkStop(x, Ending.Failed(AnyError.from(ServerError.closed())));
  }
  if done {
    answerKeptIn[Result[u64, ServerError]](&mut x.finishReply, Ok[u64, ServerError](x.written));
  } else {
    answerKeptIn[Result[u64, ServerError]](&mut x.finishReply, Err[u64, ServerError](ServerError.closed()));
  }
  let inMode = x.inMode;
  if inMode {inTerminal(srv, slot, why);}
  let y = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
  if y.stage == exReady {
    y.stage = exDead;
  } else if !y.handle && !y.inAwait {
    freeEx(srv, slot);
  }
}

// ---------------------------------------------------------------------------
// A request's body as a stream (requestbody.cone is the handle's side)
// ---------------------------------------------------------------------------

// Credit for n body bytes back to the request's connection or stream
fn inRelease(srv: &mut SrvRec, slot: usize, n: usize) {
  if n == 0usize {return;}
  let r = routeOf(srv, slot);
  if r.onH3 {srv.h3.release(r.qreq, n);} else {srv.drv.release(r.req, n);}
}

// The body's end, or its failure: what is staged goes first, in order, whatever the window (no more bytes are
// coming, and the staged bytes are bounded by the connection's credit), then the sink's one end
fn inFinish(x: &mut ExRec, how: Ending) {
  while !stagingEmpty(&x.inLend) {sendStaged(&mut x.inLend, &x.inSink);}
  var held = None[ChunkSink];
  held <-> x.inSink;
  match held {
    case let Some(sk) {sk.end(how);}
    else {}
  }
}

// Nobody wants the rest of the body: what is staged is let go and its credit released, and the bytes still to
// come are released as they arrive (onStreamedData)
fn inDiscarded(srv: &mut SrvRec, slot: usize) {
  let n = {
    let x = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
    x.inAwait = false;
    x.inDiscard = true;
    x.inKept = None[Ending];
    lendDiscard(&mut x.inLend)
  };
  inRelease(srv, slot, n);
}

// A piece of a streamed request's body: to the sink, with the lent record (lend.cone), or staged while the
// handler has not chosen or the sink's window is full. Its credit is released when the sink gives the buffer
// back, never here; a body nobody wants is released at once
fn onStreamedData(srv: &mut SrvRec, lp: &mut Loop, e: SrvEv) {
  let n = e.buf.len();
  let slot = slotOfKey(srv, e.key);
  if slot >= srv.exs.bound() {
    if e.qreq.isNone() {srv.drv.release(e.req, n);} else {srv.h3.release(e.qreq, n);}
    return;
  }
  if n == 0usize {return;}
  let x = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
  if !x.inMode || x.rejected || x.inDiscard || x.inRefused || (!x.inAwait && !(x.inSink is Some)) {
    inRelease(srv, slot, n);
    return;
  }
  let buf = e.(buf);
  if x.inAwait || !(stagingEmpty(&x.inLend) && hasRoom(&x.inLend, buf.capacity())) {
    if !stagePiece(&mut x.inLend, &buf) {
      x.inRefused = true;
      srvCancel(srv, lp, slot);
    }
  } else {
    deliver(&mut x.inLend, &x.inSink, buf);
  }
}

// The request's final answer has come: a sink still open gets its end (the peer left, or the pool refused
// a staging buffer); one that is yet to be chosen is told when it is
fn inTerminal(srv: &mut SrvRec, slot: usize, why: &httpclient.Failure) {
  let x = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
  if x.inEnded || x.inDiscard {return;}
  let how = if x.inRefused {Ending.Failed(AnyError.from(FetchError.failed(overloadedFailure())))}
    else if why.error.detail.len() > 0usize {Ending.Failed(AnyError.from(FetchError.failed(why.clone())))}
    else {Ending.Failed(AnyError.from(FetchError.failed(
      httpclient.Failure.make(httpclient.Stage.Closed, 0u32, ErrorKind.Closed, "the request ended before its body did"))))};
  x.inEnded = true;
  if x.inAwait {
    x.inKept = Some[Ending](how);
  } else {
    inFinish(x, how);
  }
}

// Write as much of x's pending body as its connection takes now, and finish
// the body when it has all gone and 'finish' was asked
fn pumpWrites(srv: &mut SrvRec, lp: &mut Loop, slot: usize) {
  let k = u32.from(slot);
  let sinkWay = {
    let x0 = srv.exs.borrowAt(k).unwrap();
    if x0.over {return;}
    x0.sinkOpen || x0.sinkFailed
  };
  if sinkWay {
    pumpSink(srv, lp, slot);
    return;
  }
  while true {
    if !{let x1 = srv.exs.borrowAt(k).unwrap(); x1.wi < x1.writes.len()} {break;}
    // The write is looked up afresh each time round: the driver's call may be
    // taken to change lists, so no borrow of one is kept across it
    while true {
      let sent, total = {
        let x2 = srv.exs.borrowAt(k).unwrap();
        (x2.writes[x2.wi].sent, x2.writes[x2.wi].data.len())
      };
      if sent >= total {break;}
      let left = total - sent;
      let n = if left < sendChunk {left} else {sendChunk};
      // A pool that refuses the buffer (iobuf's tryMake) ends the exchange: its
      // connection is closed, and the writes still waiting are answered closed
      var b = match IoBuf.tryMake(n) {
        case var Some(got) {got}
        else {
          srvCancel(srv, lp, slot);
          return;
        }
      };
      {
        // As bytes: a piece may end inside a UTF-8 character, which a 'str' slice refuses
        let x3 = srv.exs.borrowAt(k).unwrap();
        let all = x3.writes[x3.wi].data.view() as &Array[u8];
        b.append(&all[sent ..< sent + n]);
      }
      // Refused: Writable comes when there is room
      if !srvSend(srv, slot, b) {return;}
      {
        let x4 = srv.exs.borrowMutAt(k).unwrap();
        x4.writes[x4.wi].sent = sent + n;
        x4.written = x4.written + u64.from(n);
      }
    }
    let x5 = srv.exs.borrowMutAt(k).unwrap();
    let w = &mut x5.writes[x5.wi];
    let sentAll = w.data.len();
    answerKeptIn[Result[usize, ServerError]](&mut w.reply, Ok[usize, ServerError](sentAll));
    w.data = String();
    x5.wi = x5.wi + 1usize;
  }
  let fin = {
    let x6 = srv.exs.borrowMutAt(k).unwrap();
    x6.writes.clear();
    x6.wi = 0usize;
    if x6.finishing && !x6.finished {
      x6.finished = true;
      (true, x6.sized && x6.written != x6.length)
    } else {
      (false, false)
    }
  };
  if fin.0 {
    if fin.1 {
      // A write was made and never awaited, so never sent: the body is short
      // of its length, which only the connection's end can say
      srvCancel(srv, lp, slot);
    } else {
      srvFinish(srv, slot);
    }
  }
}
// Stop listening, refuse what waits, and let the exchanges taken go on
fn closeServer(srv: &mut SrvRec, lp: &mut Loop) {
  if srv.closing {return;}
  srv.closing = true;
  srv.drv.stopListening(lp, srv.listener);
  if srv.h3on {srv.h3.stopListening(lp, srv.h3listener);}
  while true {
    match srv.waiters.popFront() {
      case var Some(rp) {
        rp.answer(Err[Exchange, ServerError](ServerError.closed()));
      }
      else {break;}
    }
  }
  while true {
    let slot = match srv.ready.popFront() {
      case var Some(rd) {rd.(slot)}
      else {break;}
    };
    let x = srv.exs.borrowMutAt(u32.from(slot)).unwrap();
    if x.stage == exReady {
      x.stage = exOut;
      x.rejected = true;
      x.inAwait = false;
      answerText(srv, slot, 503u16, "the server is closing", true);
    } else if x.stage == exDead {
      freeEx(srv, slot);
    }
  }
  // Closed: the listener is shut, and what waited is answered
  while true {
    match srv.closeWaiters.popFront() {
      case var Some(rp) {rp.answer(true);}
      else {break;}
    }
  }
}

// ---------------------------------------------------------------------------
// The jobs
// ---------------------------------------------------------------------------

// A server made on the service thread, for the reply the 'await' gives
struct ListenJob {
  pub addr: SocketAddr;
  pub cfg: ServerConfig;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[Server, ServerError]]) {
    let addr, cfg = self.(addr, cfg);
    let conn, maxBody, maxPending, tcfg, http2, http3, streamBodies = cfg.(conn, maxBody, maxPending, tlsConfig, http2, http3, bodiesStreamed);
    var h3on = false;
    match http3 {
      case let Some(mk) {h3on = true;}
      else {}
    }
    var drv = httpconn.Driver.make(conn);
    var res: Result[httpconn.ListenerId, IoError] = Err[httpconn.ListenerId, IoError](IoError.cancelled());
    var secure = false;
    // HTTP/3's certificate and key: the TLS config's
    var h3tls: Option[tls.ServerConfig] = None;
    match tcfg {
      case let Some(given) {
        var t = given;
        if h3on {h3tls = Some[tls.ServerConfig](tls.ServerConfig.make(&t.certFile, &t.keyFile));}
        t.alpn = serverAlpn(&t.alpn, http2);
        match tls.Server.make(t) {
          case let Ok(s) {
            secure = true;
            res = drv.listenWith(lp, addr, Uni[TlsMaker](TlsMaker(s)), httpconn.Sink.Here(0u64));
          }
          case let Err(x) {
            rp.answer(Err[Server, ServerError](
              ServerError.failed(x.osError, (String() <- x).view())));
            return;
          }
        }
      }
      else {res = drv.listen(lp, addr, httpconn.Sink.Here(0u64));}
    }
    match res {
      case let Ok(l) {
        var bound = addr;
        match drv.localAddr(lp, l) {
          case let Ok(a) {bound = a;}
          case let Err(e) {}
        }
        // HTTP/3 beside it: UDP on the same address and port
        var h3 = httpclient.http3From(http3, &tls.ClientConfig.make());
        var h3listener = 0u64;
        var altSvc = String();
        if h3on {
          var why = String();
          var code = 0u32;
          match &h3tls {
            case let &Some(ht) {
              match h3.listen(lp, bound, ht, 0u64) {
                case let Ok(hl) {h3listener = hl;}
                case let Err(f) {
                  why = String() <- f;
                  code = f.code;
                }
              }
            }
            else {why = String.from("HTTP/3 needs TLS: ServerConfig.secure");}
          }
          if why.len() > 0usize {
            drv.stopListening(lp, l);
            drv.abortAll(lp);
            rp.answer(Err[Server, ServerError](ServerError.failed(code, why.view())));
            return;
          }
          altSvc = String.from("h3=\":");
          altSvc.appendUInt(u64.from(bound.port()));
          altSvc.append("\"; ma=86400");
        }
        let id = newId();
        sv.srvs.add(SrvRec(id, 1u32, false, false, secure, maxBody, maxPending, streamBodies, drv, l,
          Exchanges(16usize), Dict[u64, usize](), Dict[u64, Request](),
          Deque[ReadyEx](), Deque[actors.ReplyOf[Result[Exchange, ServerError]]](), 0usize, h3, h3on, h3listener, altSvc,
          Dict[QKey, u64](), 1u64, Deque[actors.ReplyOf[bool]]()));
        rp.answer(Ok[Server, ServerError](Server(id, bound, secure, h3on)));
      }
      case let Err(e) {
        rp.answer(Err[Server, ServerError](
          ServerError.failed(e.code, "could not listen")));
      }
    }
  }
}

// A handle to a server made (true) or dropped (false); the last one's going closes it
struct SrvRefJob {
  pub id: u64;
  pub add: bool;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findSrv(id);
    if k >= sv.srvs.bound() {return;}
    let srv = (sv.srvs.rawAt(u32.from(k)) as &mut SrvRec);
    if add {
      srv.refs = srv.refs + 1u32;
      return;
    }
    srv.refs = srv.refs - 1u32;
    if srv.refs == 0u32 {closeServer(srv, lp);}
  }
}

// A server closed by its program
struct SrvCloseJob {
  pub id: u64;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findSrv(id);
    if k >= sv.srvs.bound() {return;}
    closeServer((sv.srvs.rawAt(u32.from(k)) as &mut SrvRec), lp);
  }
}

// An actor waits for a server to be closed, the 'await' giving the reply it goes back in
struct ClosedJob {
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[bool]) {
    let k = sv.findSrv(self.id);
    if k >= sv.srvs.bound() {
      rp.answer(true);
      return;
    }
    let srv = (sv.srvs.rawAt(u32.from(k)) as &mut SrvRec);
    if srv.closing {
      rp.answer(true);
      return;
    }
    srv.closeWaiters.push(rp);
  }
}

// An actor asks how many requests wait for an actor
struct WaitingJob {
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[u64]) {
    let k = sv.findSrv(self.id);
    var n = 0u64;
    if k < sv.srvs.bound() {
      n = u64.from((sv.srvs.borrowAt(u32.from(k)).unwrap()).ready.len());
    }
    rp.answer(n);
  }
}

// An actor asks for the next request, the 'await' giving the reply it goes back in
struct NextJob {
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[Exchange, ServerError]]) {
    let id = self.(id);
    let k = sv.findSrv(id);
    if k >= sv.srvs.bound() {
      rp.answer(Err[Exchange, ServerError](ServerError.closed()));
      return;
    }
    let srv = (sv.srvs.rawAt(u32.from(k)) as &mut SrvRec);
    if srv.closing {
      rp.answer(Err[Exchange, ServerError](ServerError.closed()));
      return;
    }
    // The first request waiting that is still alive
    while true {
      match srv.ready.popFront() {
        case var Some(rd) {
          let slot, r = rd.(slot, request);
          if (srv.exs.borrowAt(u32.from(slot)).unwrap()).stage == exDead {
            freeEx(srv, slot);
          } else {
            deliverEx(srv, slot, rp, r);
            return;
          }
        }
        else {break;}
      }
    }
    srv.waiters.push(rp);
  }
}

// Where a handle's exchange is: its server's cell (the cell is only good until the next call that can change the
// servers) and whether the exchange is live
struct Located {
  k: u32;
  ok: bool;
}

// Whether the slot holds the live exchange id: a record that is not in use, was reused (another id) or died
// before an actor took it is none
fn exLive(srv: &SrvRec, slot: u32, id: u64) bool {
  if !srv.exs.isLive(slot) {return false;}
  let x = srv.exs.borrowAt(slot).unwrap();
  x.used && x.id == id && x.stage != exDead
}

fn locate(sv: &Service, sid: u64, slot: u32, id: u64) Located {
  let k = sv.findSrv(sid);
  if k >= sv.srvs.bound() {return Located(0u32, false);}
  let srv = sv.srvs.borrowAt(u32.from(k)).unwrap();
  Located(u32.from(k), exLive(srv, slot, id))
}

// Begin an exchange's response: its head and the framing of its body
fn beginResponse(srv: &mut SrvRec, slot: usize, head: ResponseHead, framing: BodyLength) {
  let st = head.status;
  let k = u32.from(slot);
  {
    let x = srv.exs.borrowMutAt(k).unwrap();
    x.responded = true;
    x.sized = framing.isSized();
    x.length = framing.length;
    x.chunked = framing.isUnsized();
    x.bodyless = x.isHead || st == 204u16 || st == 304u16 || framing.isEmpty() ||
      (framing.isSized() && framing.length == 0u64);
  }
  srvRespond(srv, slot, head, framing);
  if srv.exs.borrowAt(k).unwrap().bodyless {
    srv.exs.borrowMutAt(k).unwrap().finished = true;
    stopUpload(srv, slot);
  }
}

// A whole response
struct RespondJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub head: ResponseHead;
  pub body: String;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let srv, slot, id, head, body = self.(srv, slot, id, head, body);
    let loc = locate(sv, srv, slot, id);
    if !loc.ok {return;}
    let s = (sv.srvs.rawAt(loc.k) as &mut SrvRec);
    {
      let x = s.exs.borrowAt(slot).unwrap();
      if x.over || x.responded {return;}
    }
    let st = head.status;
    let n = body.len();
    let framing = if st == 204u16 || st == 304u16 {BodyLength()} else {BodyLength.sized(u64.from(n))};
    beginResponse(s, usize.from(slot), head, framing);
    if !s.exs.borrowAt(slot).unwrap().bodyless {
      let w = PendingWrite(body, 0usize, None);
      {
        let x = s.exs.borrowMutAt(slot).unwrap();
        x.writes.push(w);
        x.finishing = true;
      }
      pumpWrites(s, lp, usize.from(slot));
    }
  }
}

// The head of a streamed response
struct StartJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub head: ResponseHead;
  pub framing: BodyLength;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let srv, slot, id, head, framing = self.(srv, slot, id, head, framing);
    let loc = locate(sv, srv, slot, id);
    if !loc.ok {return;}
    let s = (sv.srvs.rawAt(loc.k) as &mut SrvRec);
    {
      let x = s.exs.borrowAt(slot).unwrap();
      if x.over || x.responded {return;}
    }
    beginResponse(s, usize.from(slot), head, framing);
  }
}

// Body bytes, the 'await' giving the reply that says when they are sent
struct WriteJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub data: String;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[usize, ServerError]]) {
    let srv, slot, id, data = self.(srv, slot, id, data);
    let loc = locate(sv, srv, slot, id);
    if !loc.ok {
      rp.answer(Err[usize, ServerError](ServerError.closed()));
      return;
    }
    let s = (sv.srvs.rawAt(loc.k) as &mut SrvRec);
    {
      let x = s.exs.borrowAt(slot).unwrap();
      if x.bodyless && !x.over {
        rp.answer(Ok[usize, ServerError](0usize));
        return;
      }
      if x.over || !x.responded || x.finishing {
        rp.answer(Err[usize, ServerError](ServerError.closed()));
        return;
      }
    }
    let w = PendingWrite(data, 0usize, Some[actors.ReplyOf[Result[usize, ServerError]]](rp));
    s.exs.borrowMutAt(slot).unwrap().writes.push(w);
    pumpWrites(s, lp, usize.from(slot));
  }
}

// The body is whole; the 'await' gives the reply that says when it is sent
struct FinishJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[u64, ServerError]]) {
    let srv, slot, id = self.(srv, slot, id);
    let loc = locate(sv, srv, slot, id);
    if !loc.ok {
      rp.answer(Err[u64, ServerError](ServerError.closed()));
      return;
    }
    let s = (sv.srvs.rawAt(loc.k) as &mut SrvRec);
    {
      let x = s.exs.borrowMutAt(slot).unwrap();
      if x.over {
        if x.ok {
          rp.answer(Ok[u64, ServerError](x.written));
        } else {
          rp.answer(Err[u64, ServerError](ServerError.closed()));
        }
        return;
      }
      x.finishReply = Some[actors.ReplyOf[Result[u64, ServerError]]](rp);
      x.finishing = true;
    }
    pumpWrites(s, lp, usize.from(slot));
  }
}

// An Exchange dropped: an unanswered request is answered 500; an unsized body
// is ended; a sized body cut short resets the connection
struct DropExJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub discard: bool;       // a streamed request whose body was never taken: the rest is not wanted

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let loc = locate(sv, srv, slot, id);
    if !loc.ok {return;}
    let s = (sv.srvs.rawAt(loc.k) as &mut SrvRec);
    let sl = usize.from(slot);
    let doDiscard = {
      let x = s.exs.borrowMutAt(slot).unwrap();
      x.handle = false;
      discard && x.inAwait
    };
    if doDiscard {
      inDiscarded(s, sl);
      stopUpload(s, sl);
    }
    let x1 = s.exs.borrowAt(slot).unwrap();
    if x1.over {
      if !x1.inAwait {freeEx(s, sl);}
      return;
    }
    let responded = x1.responded;
    let finished = x1.finished;
    let finishing = x1.finishing;
    let sinkGone = x1.sinkGone;
    let sinkOpen = x1.sinkOpen;
    let sinkFailed = x1.sinkFailed;
    if !responded {
      answerText(s, sl, 500u16, "no response was made", false);
    } else if !finished && !finishing {
      // A sink taken keeps the body while it may still be given a source: it finishes the
      // body, or the exchange ends. A sink dropped without ever being given one
      // (sinkGone, from SinkGoneJob) has no body coming: the drop ends the body as
      // without a sink.
      if sinkGone {
        s.exs.borrowMutAt(slot).unwrap().sinkOpen = false;
        endBodyUnsunk(s, lp, sl);
      } else if !sinkOpen && !sinkFailed {
        endBodyUnsunk(s, lp, sl);
      }
    }
  }
}

// The Exchange is gone and its body not ended by the handler: an unsized one is finished, a sized one reset
fn endBodyUnsunk(s: &mut SrvRec, lp: &mut Loop, slot: usize) {
  let k = u32.from(slot);
  if s.exs.borrowAt(k).unwrap().chunked {
    s.exs.borrowMutAt(k).unwrap().finishing = true;
    pumpWrites(s, lp, slot);
  } else {
    srvCancel(s, lp, slot);
  }
}
