// The service thread's side of a server: what it keeps for each listening
// Server and each request (an ExRec), how the driver's events become
// exchanges delivered to actors, and the jobs the Server and Exchange handles
// post (actorhttp.cone's header, A SERVER, says how the pieces fit).

// ---------------------------------------------------------------------------
// Records
// ---------------------------------------------------------------------------

// A request's stage on the service thread
const exReading = 0u32;     // its head is in; its body is being read
const exReady = 1u32;       // whole, waiting for an actor to take it
const exOut = 2u32;         // an actor has it (or the server answered it itself)
const exDead = 3u32;        // it ended while it waited; its slot is freed when the queue reaches it

// Body bytes an actor asked to write, and where they stand
struct PendingWrite {
  data: String;
  sent: usize;                // ...how many the connection has taken
  reply: actors.Reply;
  hasReply: bool;
}

// One request and its response, on the service thread
struct ExRec {
  used: bool;
  id: u64;
  req: httpconn.ReqId;
  head: RequestHead;           // until an actor takes it
  body: String;
  peer: SocketAddr;
  stage: u32;
  rejected: bool;              // the server answered it itself (413, 503, 500)
  isHead: bool;                // a HEAD request: its response has no body bytes
  bodyless: bool;              // the response has no body bytes
  responded: bool;             // the response's head has gone to the driver
  chunked: bool;               // its body is of unknown length
  sized: bool;
  length: u64;
  written: u64;                // body bytes the connection has taken
  finishing: bool;             // 'finish' was asked: finish the body once the writes are done
  finished: bool;              // the driver has been told the body is whole
  finishReply: actors.Reply;
  hasFinishReply: bool;
  writes: List[PendingWrite];
  wi: usize;                   // the first write not complete
  handle: bool;                // an Exchange names it
  over: bool;                  // the driver's final answer has come
  ok: bool;                    // ...and was Done
}

fn blankEx() ExRec {
  ExRec(used: false, id: 0u64, req: httpconn.ReqId.none(), head: RequestHead.empty(), body: String.empty(),
    peer: SocketAddr.localhost(0u16), stage: exReading, rejected: false, isHead: false, bodyless: false,
    responded: false, chunked: false, sized: false, length: 0u64, written: 0u64, finishing: false,
    finished: false, finishReply: actors.Reply(), hasFinishReply: false, writes: List[PendingWrite].empty(),
    wi: 0usize, handle: false, over: false, ok: false)
}

// A listening server the service owns: its own driver (so its bounds are its
// own), its listener, its requests, those waiting for an actor and the actors
// waiting for one
struct SrvRec {
  id: u64;
  refs: u32;
  closing: bool;              // no longer listening
  aborted: bool;              // its connections have been reset, being closed and idle
  secure: bool;
  maxBody: usize;
  maxPending: usize;
  drv: httpconn.Driver;
  listener: httpconn.ListenerId;
  exs: Slots[ExRec];
  byReq: Dict[u64, usize];    // a request's number to its slot
  ready: List[usize];         // slots whose request is whole and waits, from rhead on
  rhead: usize;
  waiters: List[actors.Reply];   // the 'next's waiting, from whead on
  whead: usize;
  live: usize;                // requests whose final answer has not come
}

// The layers of a TLS listener's connections: a server session each, from one context
struct TlsMaker {
  server: tls.Server;
  pool: Pool;

  pub fn make(self: &mut) Uni[httpconn.Layer] {Uni[tls.Stream](server.stream(pool))}
}

fn answerTo[R](rp: &mut actors.Reply, v: R) {
  var r = actors.Reply();
  r <-> *rp;
  actors.answerNow[R](r, v);
}

// Where the live exchange is (its slot's record), or null: a record that is
// not in use, was reused (another id) or died before an actor took it names none
fn exOf(srv: &SrvRec, slot: u32, id: u64) *ExRec {
  let s = usize.from(slot);
  if s >= srv.exs.len() {return null;}
  let x = srv.exs.at(s);
  if (*x).used && (*x).id == id && (*x).stage != exDead {return x;}
  null
}

// The slot of the request the driver calls req, or the number of slots when it is none
fn slotOfReq(srv: &SrvRec, req: httpconn.ReqId) usize {
  let key = req.number();
  match srv.byReq.getCopy(&key) {
    case let Some(s) {s}
    case is None[usize] {srv.exs.len()}
  }
}

fn freeEx(srv: &mut SrvRec, slot: usize) {
  let x = srv.exs.at(slot) as &mut ExRec;
  *x = blankEx();
  srv.exs.put(slot);
}

// ---------------------------------------------------------------------------
// What the driver says
// ---------------------------------------------------------------------------

fn pumpServer(srv: &mut SrvRec, lp: &mut Loop, pool: Pool) {
  var evs = List[httpconn.Event].empty();
  srv.drv.pump(lp, &mut evs);
  var k = 0usize;
  while k < evs.len() {
    let e = &mut evs[k];
    k = k + 1usize;
    onServerEvent(srv, lp, pool, e);
  }
}

fn onServerEvent(srv: &mut SrvRec, lp: &mut Loop, pool: Pool, e: &mut httpconn.Event) {
  let k = e.kind;
  if k == httpconn.EventKind.Request {
    let slot = srv.exs.take(blankEx());
    let x = srv.exs.at(slot) as &mut ExRec;
    x.used = true;
    x.id = newId();
    x.req = e.req;
    x.stage = exReading;
    x.head <-> e.request;
    x.peer = srv.drv.peer(e.conn);
    x.isHead = x.head.method == Method.Head;
    let key = e.req.number();
    srv.byReq.insert(key, slot);
    srv.live = srv.live + 1usize;
    if srv.closing {
      x.rejected = true;
      x.stage = exOut;
      answerText(srv, pool, x, 503u16, "the server is closing", true);
    } elif e.body.isSized() && e.body.length > u64.from(srv.maxBody) {
      x.rejected = true;
      x.stage = exOut;
      answerText(srv, pool, x, 413u16, "the request body is too large", true);
    } elif x.head.headers.hasToken("Expect", "100-continue") {
      srv.drv.sendContinue(e.req);
    }
  } elif k == httpconn.EventKind.Data {
    let n = e.buf.len();
    let slot = slotOfReq(srv, e.req);
    if slot < srv.exs.len() {
      let x = srv.exs.at(slot) as &mut ExRec;
      if x.stage == exReading && !x.rejected {
        if x.body.len() + n > srv.maxBody {
          x.rejected = true;
          x.stage = exOut;
          answerText(srv, pool, x, 413u16, "the request body is too large", true);
        } else {
          x.body.appendBytes(e.buf.view());
        }
      }
    }
    srv.drv.release(e.req, n);
  } elif k == httpconn.EventKind.End {
    let slot = slotOfReq(srv, e.req);
    if slot < srv.exs.len() {
      let x = srv.exs.at(slot) as &ExRec;
      if x.stage == exReading && !x.rejected {readyEx(srv, pool, slot);}
    }
  } elif k == httpconn.EventKind.Writable {
    let slot = slotOfReq(srv, e.req);
    if slot < srv.exs.len() {
      let x = srv.exs.at(slot) as &mut ExRec;
      pumpWrites(srv, lp, pool, x);
    }
  } elif e.isTerminal() {
    let slot = slotOfReq(srv, e.req);
    if slot < srv.exs.len() {endEx(srv, slot, k == httpconn.EventKind.Done);}
    let key = e.req.number();
    srv.byReq.remove(&key);
  }
}

// A request whose head and whole body are in: to the actor waiting for one,
// else into the queue (503 if that is full)
fn readyEx(srv: &mut SrvRec, pool: Pool, slot: usize) {
  let x = srv.exs.at(slot) as &mut ExRec;
  if srv.whead < srv.waiters.len() {
    var rp = actors.Reply();
    let w = &mut srv.waiters[srv.whead];
    rp <-> *w;
    srv.whead = srv.whead + 1usize;
    if srv.whead == srv.waiters.len() {
      srv.waiters.clear();
      srv.whead = 0usize;
    }
    deliverEx(srv, slot, rp);
  } elif srv.ready.len() - srv.rhead >= srv.maxPending {
    x.rejected = true;
    x.stage = exOut;
    answerText(srv, pool, x, 503u16, "the server is busy", false);
  } else {
    x.stage = exReady;
    srv.ready.push(slot);
  }
}

// An actor has the request: its Exchange is the answer to the reply
fn deliverEx(srv: &mut SrvRec, slot: usize, rp: actors.Reply) {
  let x = srv.exs.at(slot) as &mut ExRec;
  x.stage = exOut;
  x.handle = true;
  var r = Request(RequestHead.empty(), String.empty(), x.peer, srv.secure);
  r.head <-> x.head;
  r.body <-> x.body;
  let ex = Exchange(srv.id, u32.from(slot), x.id, 0u32, false, 0u64, 0u64, false, r);
  actors.answerNow[Result[Exchange, ServerError]](rp, Ok[Exchange, ServerError](ex));
}

// The server answers a request itself, with text
fn answerText(srv: &mut SrvRec, pool: Pool, x: &mut ExRec, status: u16, text: &str, closeAfter: bool) {
  var h = ResponseHead.make(status);
  h.headers.add("Content-Type", "text/plain; charset=utf-8");
  if closeAfter {h.headers.add("Connection", "close");}
  let n = text.len;
  var b = IoBuf.empty();
  if !x.isHead && n > 0usize {
    match pool.take(n) {
      case var Some(s) {b <-> s;}
      case is None[IoBuf] {}
    }
  }
  let have = b.capacity() > 0usize;
  let len = if have {n} else {0usize};
  srv.drv.respond(x.req, h, BodyLength.sized(u64.from(len)));
  x.responded = true;
  x.finished = true;
  x.finishing = true;
  if have {
    b.append(text as &Array[u8]);
    srv.drv.sendData(x.req, b);
    srv.drv.finish(x.req);
  }
}

// The request's final answer has come
fn endEx(srv: &mut SrvRec, slot: usize, done: bool) {
  let x = srv.exs.at(slot) as &mut ExRec;
  x.over = true;
  x.ok = done;
  if srv.live > 0usize {srv.live = srv.live - 1usize;}
  // Writes still to go, and a finish still waiting, are answered
  while x.wi < x.writes.len() {
    let w = &mut x.writes[x.wi];
    x.wi = x.wi + 1usize;
    if w.hasReply {
      answerTo[Result[usize, ServerError]](&mut w.reply, Error[usize, ServerError](ServerError.closed()));
    }
  }
  x.writes.clear();
  x.wi = 0usize;
  if x.hasFinishReply {
    x.hasFinishReply = false;
    if done {
      answerTo[Result[u64, ServerError]](&mut x.finishReply, Ok[u64, ServerError](x.written));
    } else {
      answerTo[Result[u64, ServerError]](&mut x.finishReply, Error[u64, ServerError](ServerError.closed()));
    }
  }
  if x.stage == exReady {
    x.stage = exDead;
  } elif !x.handle {
    freeEx(srv, slot);
  }
}

// Write as much of x's pending body as its connection takes now, and finish
// the body when it has all gone and 'finish' was asked
fn pumpWrites(srv: &mut SrvRec, lp: &mut Loop, pool: Pool, x: &mut ExRec) {
  if x.over {return;}
  while x.wi < x.writes.len() {
    // The write is looked up afresh each time round: the driver's call may be
    // taken to change lists, so no borrow of one is kept across it
    while true {
      let sent = x.writes[x.wi].sent;
      let total = x.writes[x.wi].data.len();
      if sent >= total {break;}
      let left = total - sent;
      let n = if left < sendChunk {left} else {sendChunk};
      var b = IoBuf.empty();
      match pool.take(n) {
        case var Some(s) {b <-> s;}
        case is None[IoBuf] {}
      }
      if b.capacity() == 0usize {
        // The pool refused: the response cannot be sent, and ends
        srv.drv.cancel(lp, x.req);
        return;
      }
      {
        // As bytes: a piece may end inside a UTF-8 character, which a 'str' slice refuses
        let all = x.writes[x.wi].data.view() as &Array[u8];
        b.append(&all[sent ..< sent + n]);
      }
      var taken = false;
      match srv.drv.sendData(x.req, b) {
        case is None[IoBuf] {taken = true;}
        else {}      // refused: Writable comes when there is room
      }
      if !taken {return;}
      x.writes[x.wi].sent = sent + n;
      x.written = x.written + u64.from(n);
    }
    let w = &mut x.writes[x.wi];
    if w.hasReply {
      w.hasReply = false;
      answerTo[Result[usize, ServerError]](&mut w.reply, Ok[usize, ServerError](w.data.len()));
    }
    w.data = String.empty();
    x.wi = x.wi + 1usize;
  }
  x.writes.clear();
  x.wi = 0usize;
  if x.finishing && !x.finished {
    x.finished = true;
    if x.sized && x.written != x.length {
      // A write was made and never awaited, so never sent: the body is short
      // of its length, which only the connection's end can say
      srv.drv.cancel(lp, x.req);
    } else {
      srv.drv.finish(x.req);
    }
  }
}

// Stop listening, refuse what waits, and let the exchanges taken go on
fn closeServer(srv: &mut SrvRec, lp: &mut Loop, pool: Pool) {
  if srv.closing {return;}
  srv.closing = true;
  srv.drv.stopListening(lp, srv.listener);
  while srv.whead < srv.waiters.len() {
    let w = &mut srv.waiters[srv.whead];
    srv.whead = srv.whead + 1usize;
    answerTo[Result[Exchange, ServerError]](w, Error[Exchange, ServerError](ServerError.closed()));
  }
  srv.waiters.clear();
  srv.whead = 0usize;
  while srv.rhead < srv.ready.len() {
    let slot = *srv.ready[srv.rhead];
    srv.rhead = srv.rhead + 1usize;
    let x = srv.exs.at(slot) as &mut ExRec;
    if x.stage == exReady {
      x.stage = exOut;
      x.rejected = true;
      answerText(srv, pool, x, 503u16, "the server is closing", true);
    } elif x.stage == exDead {
      freeEx(srv, slot);
    }
  }
  srv.ready.clear();
  srv.rhead = 0usize;
}

// ---------------------------------------------------------------------------
// The jobs
// ---------------------------------------------------------------------------

// A server made on the service thread, for the reply that awaits it
struct ListenJob {
  pub addr: SocketAddr;
  pub cfg: ServerConfig;
  pub reply: actors.Reply;

  fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    var rp = actors.Reply();
    rp <-> reply;
    var c = ServerConfig.make();
    c <-> cfg;
    var tcfg: Option[tls.ServerConfig] = None;
    tcfg <-> c.tlsConfig;
    var drv = httpconn.Driver.make(c.conn, sv.pool);
    var res: Result[httpconn.ListenerId, IoError] = Error[httpconn.ListenerId, IoError](IoError.cancelled());
    var secure = false;
    match tcfg {
      case var Some(t) {
        match tls.Server.make(t) {
          case let Ok(s) {
            secure = true;
            res = drv.listenWith(lp, addr, Uni[TlsMaker](TlsMaker(s, sv.pool)), httpconn.Sink.Here(0u64));
          }
          case let Error(x) {
            answerTo[Result[Server, ServerError]](&mut rp, Error[Server, ServerError](
              ServerError.failed(x.osError, x.message().view())));
            return;
          }
        }
      }
      else {res = drv.listen(lp, addr, httpconn.Sink.Here(0u64));}
    }
    match res {
      case let Ok(l) {
        var bound = addr;
        match drv.localAddr(lp, l) {
          case let Ok(a) {bound = a;}
          case let Error(e) {}
        }
        let id = newId();
        let p = libc.malloc(mem.sizeof[SrvRec]()) as *SrvRec;
        if p as usize == 0usize {die("actorhttp: out of memory for a server");}
        mem.writeRaw[SrvRec](p, SrvRec(id, 1u32, false, false, secure, c.maxBody, c.maxPending, drv, l,
          Slots[ExRec].make(), Dict[u64, usize].empty(), List[usize].empty(), 0usize,
          List[actors.Reply].empty(), 0usize, 0usize));
        sv.srvs.push(p);
        answerTo[Result[Server, ServerError]](&mut rp, Ok[Server, ServerError](Server(id, bound, secure)));
      }
      case let Error(e) {
        answerTo[Result[Server, ServerError]](&mut rp, Error[Server, ServerError](
          ServerError.failed(e.code, "could not listen")));
      }
    }
  }
}

// A handle to a server made (true) or dropped (false); the last one's going closes it
struct SrvRefJob {
  pub id: u64;
  pub add: bool;

  fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findSrv(id);
    if k >= sv.srvs.len() {return;}
    let srv = sv.srvAt(k) as &mut SrvRec;
    if add {
      srv.refs = srv.refs + 1u32;
      return;
    }
    srv.refs = srv.refs - 1u32;
    if srv.refs == 0u32 {closeServer(srv, lp, sv.pool);}
  }
}

// A server closed by its program
struct SrvCloseJob {
  pub id: u64;

  fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findSrv(id);
    if k >= sv.srvs.len() {return;}
    closeServer(sv.srvAt(k) as &mut SrvRec, lp, sv.pool);
  }
}

// An actor asks for the next request
struct NextJob {
  pub id: u64;
  pub reply: actors.Reply;

  fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    var rp = actors.Reply();
    rp <-> reply;
    let k = sv.findSrv(id);
    if k >= sv.srvs.len() {
      answerTo[Result[Exchange, ServerError]](&mut rp, Error[Exchange, ServerError](ServerError.closed()));
      return;
    }
    let srv = sv.srvAt(k) as &mut SrvRec;
    if srv.closing {
      answerTo[Result[Exchange, ServerError]](&mut rp, Error[Exchange, ServerError](ServerError.closed()));
      return;
    }
    // The first request waiting that is still alive
    var slot = srv.exs.len();
    while srv.rhead < srv.ready.len() && slot == srv.exs.len() {
      let s = *srv.ready[srv.rhead];
      srv.rhead = srv.rhead + 1usize;
      let x = srv.exs.at(s) as &ExRec;
      if x.stage == exDead {
        freeEx(srv, s);
      } else {
        slot = s;
      }
    }
    if srv.rhead >= srv.ready.len() {
      srv.ready.clear();
      srv.rhead = 0usize;
    }
    if slot < srv.exs.len() {
      deliverEx(srv, slot, rp);
    } else {
      srv.waiters.push(rp);
    }
  }
}

// Where a handle's exchange is: its server and record, or null
struct Located {
  srv: *SrvRec;
  ex: *ExRec;
}

fn locate(sv: &Service, sid: u64, slot: u32, id: u64) Located {
  let k = sv.findSrv(sid);
  if k >= sv.srvs.len() {return Located(null, null);}
  let srv = sv.srvAt(k);
  Located(srv, exOf(srv as &SrvRec, slot, id))
}

// Begin an exchange's response: its head and the framing of its body
fn beginResponse(srv: &mut SrvRec, x: &mut ExRec, head: ResponseHead, framing: BodyLength) {
  let st = head.status;
  x.responded = true;
  x.sized = framing.isSized();
  x.length = framing.length;
  x.chunked = framing.isUnsized();
  x.bodyless = x.isHead || st == 204u16 || st == 304u16 || framing.isEmpty() ||
    (framing.isSized() && framing.length == 0u64);
  srv.drv.respond(x.req, head, framing);
  if x.bodyless {x.finished = true;}
}

// A whole response
struct RespondJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub head: ResponseHead;
  pub body: String;

  fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {return;}
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    if x.over || x.responded {return;}
    var h = ResponseHead.empty();
    h <-> head;
    let st = h.status;
    let n = body.len();
    let framing = if st == 204u16 || st == 304u16 {BodyLength.empty()} else {BodyLength.sized(u64.from(n))};
    beginResponse(s, x, h, framing);
    if !x.bodyless {
      var w = PendingWrite(String.empty(), 0usize, actors.Reply(), false);
      w.data <-> body;
      x.writes.push(w);
      x.finishing = true;
      pumpWrites(s, lp, sv.pool, x);
    }
  }
}

// The head of a streamed response
struct StartJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub head: ResponseHead;
  pub framing: BodyLength;

  fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {return;}
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    if x.over || x.responded {return;}
    var h = ResponseHead.empty();
    h <-> head;
    beginResponse(s, x, h, framing);
  }
}

// Body bytes
struct WriteJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub data: String;
  pub reply: actors.Reply;

  fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    var rp = actors.Reply();
    rp <-> reply;
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {
      answerTo[Result[usize, ServerError]](&mut rp, Error[usize, ServerError](ServerError.closed()));
      return;
    }
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    if x.bodyless && !x.over {
      answerTo[Result[usize, ServerError]](&mut rp, Ok[usize, ServerError](0usize));
      return;
    }
    if x.over || !x.responded || x.finishing {
      answerTo[Result[usize, ServerError]](&mut rp, Error[usize, ServerError](ServerError.closed()));
      return;
    }
    var w = PendingWrite(String.empty(), 0usize, actors.Reply(), true);
    w.data <-> data;
    w.reply <-> rp;
    x.writes.push(w);
    pumpWrites(s, lp, sv.pool, x);
  }
}

// The body is whole
struct FinishJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub reply: actors.Reply;

  fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    var rp = actors.Reply();
    rp <-> reply;
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {
      answerTo[Result[u64, ServerError]](&mut rp, Error[u64, ServerError](ServerError.closed()));
      return;
    }
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    if x.over {
      if x.ok {
        answerTo[Result[u64, ServerError]](&mut rp, Ok[u64, ServerError](x.written));
      } else {
        answerTo[Result[u64, ServerError]](&mut rp, Error[u64, ServerError](ServerError.closed()));
      }
      return;
    }
    x.finishReply <-> rp;
    x.hasFinishReply = true;
    x.finishing = true;
    pumpWrites(s, lp, sv.pool, x);
  }
}

// An Exchange dropped: an unanswered request is answered 500; an unsized body
// is ended; a sized body cut short resets the connection
struct DropExJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;

  fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {return;}
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    x.handle = false;
    if x.over {
      freeEx(s, usize.from(slot));
      return;
    }
    if !x.responded {
      answerText(s, sv.pool, x, 500u16, "no response was made", false);
    } elif !x.finished && !x.finishing {
      if x.chunked {
        x.finishing = true;
        pumpWrites(s, lp, sv.pool, x);
      } else {
        s.drv.cancel(lp, x.req);
      }
    }
  }
}
