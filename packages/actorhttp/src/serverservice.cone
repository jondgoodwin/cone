// The service thread's side of a server: what it keeps for each listening
// Server and each request (an ExRec), how the driver's events become
// exchanges delivered to actors, and the jobs the Server and Exchange handles
// post (actorhttp.cone's header, A SERVER, says how the pieces fit).

// ---------------------------------------------------------------------------
// Records
// ---------------------------------------------------------------------------

// A request's stage on the service thread
const exReading = 0u32;     // its head is in; its body is being read
const exReady = 1u32;       // whole, waiting for an actor to take it
const exOut = 2u32;         // an actor has it (or the server answered it itself)
const exDead = 3u32;        // it ended while it waited; its slot is freed when the queue reaches it

// Body bytes an actor asked to write, and where they stand
struct PendingWrite {
  data: String;
  sent: usize;                    // ...how many the connection has taken
  reply: Option[actors.Reply];    // the actor awaiting them, until they are sent
}

// A request whole and waiting for an actor: its slot, and the request
struct ReadyEx {
  slot: usize;
  request: Request;
}

// One request and its response, on the service thread (the request itself is
// read into the server's 'reading', and goes to the actor that takes it)
struct ExRec {
  used: bool;
  id: u64;
  req: httpconn.ReqId;
  qreq: httpclient.H3Req;      // ...or its request on the HTTP/3 plug-in
  onH3: bool;                  // it came over HTTP/3
  stage: u32;
  rejected: bool;              // the server answered it itself (413, 503, 500)
  isHead: bool;                // a HEAD request: its response has no body bytes
  bodyless: bool;              // the response has no body bytes
  responded: bool;             // the response's head has gone to the driver
  chunked: bool;               // its body is of unknown length
  sized: bool;
  length: u64;
  written: u64;                // body bytes the connection has taken
  finishing: bool;             // 'finish' was asked: finish the body once the writes are done
  finished: bool;              // the driver has been told the body is whole
  finishReply: Option[actors.Reply];   // the actor awaiting 'finish'
  writes: List[PendingWrite];
  wi: usize;                   // the first write not complete
  handle: bool;                // an Exchange names it
  over: bool;                  // the driver's final answer has come
  ok: bool;                    // ...and was Done
}

// The record of request req (or qreq, over HTTP/3), its head just read
fn readingEx(req: httpconn.ReqId, qreq: httpclient.H3Req, onH3: bool, isHead: bool) ExRec {
  ExRec(used: true, id: newId(), req: req, qreq: qreq, onH3: onH3, stage: exReading, rejected: false, isHead: isHead, bodyless: false,
    responded: false, chunked: false, sized: false, length: 0u64, written: 0u64, finishing: false,
    finished: false, finishReply: None, writes: List[PendingWrite].empty(), wi: 0usize, handle: false,
    over: false, ok: false)
}

// A listening server the service owns: its own driver (so its bounds are its
// own), its listener, its requests, those waiting for an actor and the actors
// waiting for one
struct SrvRec {
  id: u64;
  refs: u32;
  closing: bool;              // no longer listening
  aborted: bool;              // its connections have been reset, being closed and idle
  secure: bool;
  maxBody: usize;
  maxPending: usize;
  drv: httpconn.Driver;
  listener: httpconn.ListenerId;
  exs: SlotTable[ExRec];
  byReq: Dict[u64, usize];    // a request's key (its number on the driver, or h3Key's) to its slot
  reading: Dict[u64, Request];   // a request's key to the request being read in
  ready: Deque[ReadyEx];      // the requests whole and waiting for an actor
  waiters: Deque[actors.Reply];  // the 'next's waiting
  live: usize;                // requests whose final answer has not come
  h3: Uni[httpclient.Http3];  // its HTTP/3 plug-in (httpclient.NoHttp3 when it offers none)
  h3on: bool;
  h3listener: u64;
  altSvc: String;             // the Alt-Svc its TCP responses carry, or empty
  qkeys: Dict[QKey, u64];     // an HTTP/3 request to its key
  nextKey: u64;
  closeWaiters: Deque[actors.Reply];  // the 'closed's waiting
}

// An HTTP/3 request's ids, as a key
struct QKey is Hash {
  conn: u64;
  req: u64;

  pub fn `==`(self, o: QKey) bool {conn == o.conn && req == o.req}
}

// The bit an HTTP/3 request's key has, which no driver's request number has
// (a number is its generation, 16 bits, above its index's 32)
const h3Key = 0x8000000000000000u64;

// A request's event from either driver, in one shape: a request's head, its
// body's bytes, its end, room to write, its final answer
const sRequest = 0u32;
const sData = 1u32;
const sEnd = 2u32;
const sWritable = 3u32;
const sDone = 4u32;
const sOver = 5u32;         // a final answer other than Done
const sOther = 6u32;        // nothing for the server

struct SrvEv {
  kind: u32;
  key: u64;
  req: httpconn.ReqId;
  qreq: httpclient.H3Req;
  peer: SocketAddr;
  head: RequestHead;
  framing: BodyLength;
  buf: IoBuf;
}

// The layers of a TLS listener's connections: a server session each, from one context
struct TlsMaker {
  server: tls.Server;

  pub fn make(self: &mut) Uni[httpconn.Layer] {Uni[tls.Stream](server.stream())}
}

// A reply kept in an Option answered in place, and let go
fn answerKeptIn[R](kept: &mut Option[actors.Reply], v: R) {
  match kept {
    case var &mut Some(r) {actors.answerNowIn[R](r, v);}
    else {}
  }
  *kept = None;
}

// Where the live exchange is (its slot's record), or null: a record that is
// not in use, was reused (another id) or died before an actor took it names none
fn exOf(srv: &SrvRec, slot: u32, id: u64) *ExRec {
  let x = srv.exs.at(slot);
  if x as usize != 0usize && (*x).used && (*x).id == id && (*x).stage != exDead {return x;}
  null
}

// The slot of the request whose key is key, or the number of slots when it is none
fn slotOfKey(srv: &SrvRec, key: u64) usize { srv.byReq.getCopy(&key) || srv.exs.bound() }

fn freeEx(srv: &mut SrvRec, slot: usize) {
  srv.exs.removeAt(u32.from(slot));
}

// ---------------------------------------------------------------------------
// What the driver says
// ---------------------------------------------------------------------------

fn pumpServer(srv: &mut SrvRec, lp: &mut Loop) {
  var evs = List[httpconn.Event].empty();
  srv.drv.pump(lp, &uni evs);
  each e in evs.drain() {
    onServerEvent(srv, lp, e);
  }
  if !srv.h3on {return;}
  var hs = List[httpclient.H3Event].empty();
  srv.h3.turn(lp);
  srv.h3.takeEvents(&mut hs);
  each e in hs.drain() {
    onH3ServerEvent(srv, lp, e);
  }
}

// An event of the server's driver, taken by value, in the shape both
// drivers' take
fn onServerEvent(srv: &mut SrvRec, lp: &mut Loop, e: httpconn.Event) {
  let k = e.kind;
  var kind = sOther;
  if k == httpconn.EventKind.Request {kind = sRequest;}
  else if k == httpconn.EventKind.Data {kind = sData;}
  else if k == httpconn.EventKind.End {kind = sEnd;}
  else if k == httpconn.EventKind.Writable {kind = sWritable;}
  else if k == httpconn.EventKind.Done {kind = sDone;}
  else if e.isTerminal() {kind = sOver;}
  if kind == sOther {return;}
  let req, conn, framing, head, buf = e.(req, conn, body, request, buf);
  let peer = if kind == sRequest {srv.drv.peer(conn)} else {SocketAddr.localhost(0u16)};
  onSrvEv(srv, lp, SrvEv(kind, req.number(), req, httpclient.H3Req.none(), peer, head, framing, buf));
}

// An event of the server's HTTP/3 plug-in, the same way: each request has a
// key of its own (h3Key's bit and a count) from its head to its final answer
fn onH3ServerEvent(srv: &mut SrvRec, lp: &mut Loop, e: httpclient.H3Event) {
  let k = e.kind;
  var kind = sOther;
  if k == httpclient.H3Kind.Request {kind = sRequest;}
  else if k == httpclient.H3Kind.Data {kind = sData;}
  else if k == httpclient.H3Kind.End {kind = sEnd;}
  else if k == httpclient.H3Kind.Writable {kind = sWritable;}
  else if k == httpclient.H3Kind.Done {kind = sDone;}
  else if e.isTerminal() {kind = sOver;}
  if kind == sOther {return;}
  let q = e.req;
  let qk = QKey(q.conn, q.req);
  var key = 0u64;
  if kind == sRequest {
    key = h3Key | srv.nextKey;
    srv.nextKey = srv.nextKey + 1u64;
    let previous = srv.qkeys.insert(qk, key);
  } else {
    match srv.qkeys.getCopy(&qk) {
      case let Some(v) {key = v;}
      case is None[u64] {
        // A request the server never took: its body's credit back
        if kind == sData {srv.h3.release(q, e.buf.len());}
        return;
      }
    }
  }
  if kind == sDone || kind == sOver {let gone = srv.qkeys.remove(&qk);}
  let peer = if kind == sRequest {srv.h3.peer(e.conn)} else {SocketAddr.localhost(0u16)};
  let framing, head, buf = e.(body, request, buf);
  onSrvEv(srv, lp, SrvEv(kind, key, httpconn.ReqId.none(), q, peer, head, framing, buf));
}

// A request's event, from either driver: a request's head goes whole into
// the request being read
fn onSrvEv(srv: &mut SrvRec, lp: &mut Loop, e: SrvEv) {
  let k = e.kind;
  let key = e.key;
  if k == sRequest {
    let req, qreq, peer, framing, head = e.(req, qreq, peer, framing, head);
    let onH3 = !qreq.isNone();
    let slot = usize.from(srv.exs.add(readingEx(req, qreq, onH3, head.method == Method.Head)).index);
    let x = srv.exs.at(u32.from(slot)) as &mut ExRec;
    srv.byReq.insert(key, slot);
    srv.live = srv.live + 1usize;
    if srv.closing {
      x.rejected = true;
      x.stage = exOut;
      answerText(srv, x, 503u16, "the server is closing", true);
    } else if framing.isSized() && framing.length > u64.from(srv.maxBody) {
      x.rejected = true;
      x.stage = exOut;
      answerText(srv, x, 413u16, "the request body is too large", true);
    } else {
      if head.headers.hasToken("Expect", "100-continue") {sendContinue(srv, x);}
      srv.reading.insert(key, Request(head, String.empty(), peer, srv.secure));
    }
  } else if k == sData {
    let n = e.buf.len();
    let slot = slotOfKey(srv, key);
    if slot < srv.exs.bound() {
      let x = srv.exs.at(u32.from(slot)) as &mut ExRec;
      if x.stage == exReading && !x.rejected {
        var over = false;
        match srv.reading.getMut(&key) {
          case let Some(r) {
            if r.body.len() + n > srv.maxBody {over = true;} else {r.body.appendBytes(e.buf.view());}
          }
          else {}
        }
        if over {
          srv.reading.remove(&key);
          x.rejected = true;
          x.stage = exOut;
          answerText(srv, x, 413u16, "the request body is too large", true);
        }
      }
    }
    if e.qreq.isNone() {srv.drv.release(e.req, n);} else {srv.h3.release(e.qreq, n);}
  } else if k == sEnd {
    let slot = slotOfKey(srv, key);
    // The request read whole: taken out of 'reading' by value
    match srv.reading.remove(&key) {
      case var Some(r) {
        if slot < srv.exs.bound() {readyEx(srv, slot, r);}
      }
      else {}
    }
  } else if k == sWritable {
    let slot = slotOfKey(srv, key);
    if slot < srv.exs.bound() {
      let x = srv.exs.at(u32.from(slot)) as &mut ExRec;
      pumpWrites(srv, lp, x);
    }
  } else if k == sDone || k == sOver {
    let slot = slotOfKey(srv, key);
    if slot < srv.exs.bound() {endEx(srv, slot, k == sDone);}
    srv.byReq.remove(&key);
    srv.reading.remove(&key);
  }
}

// ---------------------------------------------------------------------------
// A response, to whichever driver carries its request
// ---------------------------------------------------------------------------

// Its head: a TCP one says where HTTP/3 is, when the server offers it and
// the program wrote no Alt-Svc of its own
fn srvRespond(srv: &mut SrvRec, x: &mut ExRec, head: ResponseHead, framing: BodyLength) {
  if x.onH3 {
    srv.h3.respond(x.qreq, head, framing);
    return;
  }
  var h = head;
  if srv.altSvc.len() > 0usize && !h.headers.has("Alt-Svc") {
    let a = srv.altSvc.copy();
    h.headers.add("Alt-Svc", a.view());
  }
  srv.drv.respond(x.req, h, framing);
}

// Body bytes: whether they were taken (else Writable comes when there is room)
fn srvSend(srv: &mut SrvRec, x: &mut ExRec, b: IoBuf) bool {
  if x.onH3 {
    match srv.h3.sendData(x.qreq, b) {
      case is None[IoBuf] {return true;}
      else {return false;}
    }
  }
  match srv.drv.sendData(x.req, b) {
    case is None[IoBuf] {true}
    else {false}
  }
}

fn srvFinish(srv: &mut SrvRec, x: &mut ExRec) {
  if x.onH3 {srv.h3.finish(x.qreq);} else {srv.drv.finish(x.req);}
}

fn srvCancel(srv: &mut SrvRec, lp: &mut Loop, x: &mut ExRec) {
  if x.onH3 {srv.h3.cancel(lp, x.qreq);} else {srv.drv.cancel(lp, x.req);}
}

// 100 Continue, for a request that asked for it
fn sendContinue(srv: &mut SrvRec, x: &mut ExRec) {
  if x.onH3 {srv.h3.sendInterim(x.qreq, ResponseHead.make(100u16));} else {srv.drv.sendContinue(x.req);}
}

// A request whose head and whole body are in: to the actor waiting for one,
// else into the queue (503 if that is full)
fn readyEx(srv: &mut SrvRec, slot: usize, r: Request) {
  let x = srv.exs.at(u32.from(slot)) as &mut ExRec;
  match srv.waiters.popFront() {
    case var Some(rp) {deliverEx(srv, slot, rp, r);}
    else {
      if srv.ready.len() >= srv.maxPending {
        x.rejected = true;
        x.stage = exOut;
        answerText(srv, x, 503u16, "the server is busy", false);
      } else {
        x.stage = exReady;
        srv.ready.push(ReadyEx(slot, r));
      }
    }
  }
}

// An actor has the request: its Exchange is the answer to the reply
fn deliverEx(srv: &mut SrvRec, slot: usize, rp: actors.Reply, r: Request) {
  let x = srv.exs.at(u32.from(slot)) as &mut ExRec;
  x.stage = exOut;
  x.handle = true;
  let ex = Exchange(srv.id, u32.from(slot), x.id, 0u32, false, 0u64, 0u64, false, r);
  actors.answerNow[Result[Exchange, ServerError]](rp, Ok[Exchange, ServerError](ex));
}

// The server answers a request itself, with text
fn answerText(srv: &mut SrvRec, x: &mut ExRec, status: u16, text: &str, closeAfter: bool) {
  var h = ResponseHead.make(status);
  h.headers.add("Content-Type", "text/plain; charset=utf-8");
  // HTTP/3 has no Connection field: its stream ends the exchange, the connection carries on
  if closeAfter && !x.onH3 {h.headers.add("Connection", "close");}
  let n = text.len;
  var b = IoBuf.empty();
  if !x.isHead && n > 0usize {
    b = IoBuf(n);
  }
  let have = b.capacity() > 0usize;
  let len = if have {n} else {0usize};
  srvRespond(srv, x, h, BodyLength.sized(u64.from(len)));
  x.responded = true;
  x.finished = true;
  x.finishing = true;
  if have {
    b.append(text as &Array[u8]);
    let taken = srvSend(srv, x, b);
    srvFinish(srv, x);
  }
}

// The request's final answer has come
fn endEx(srv: &mut SrvRec, slot: usize, done: bool) {
  let x = srv.exs.at(u32.from(slot)) as &mut ExRec;
  x.over = true;
  x.ok = done;
  if srv.live > 0usize {srv.live = srv.live - 1usize;}
  // Writes still to go, and a finish still waiting, are answered
  while x.wi < x.writes.len() {
    let w = &mut x.writes[x.wi];
    x.wi = x.wi + 1usize;
    answerKeptIn[Result[usize, ServerError]](&mut w.reply, Err[usize, ServerError](ServerError.closed()));
  }
  x.writes.clear();
  x.wi = 0usize;
  if done {
    answerKeptIn[Result[u64, ServerError]](&mut x.finishReply, Ok[u64, ServerError](x.written));
  } else {
    answerKeptIn[Result[u64, ServerError]](&mut x.finishReply, Err[u64, ServerError](ServerError.closed()));
  }
  if x.stage == exReady {
    x.stage = exDead;
  } else if !x.handle {
    freeEx(srv, slot);
  }
}

// Write as much of x's pending body as its connection takes now, and finish
// the body when it has all gone and 'finish' was asked
fn pumpWrites(srv: &mut SrvRec, lp: &mut Loop, x: &mut ExRec) {
  if x.over {return;}
  while x.wi < x.writes.len() {
    // The write is looked up afresh each time round: the driver's call may be
    // taken to change lists, so no borrow of one is kept across it
    while true {
      let sent = x.writes[x.wi].sent;
      let total = x.writes[x.wi].data.len();
      if sent >= total {break;}
      let left = total - sent;
      let n = if left < sendChunk {left} else {sendChunk};
      var b = IoBuf(n);
      {
        // As bytes: a piece may end inside a UTF-8 character, which a 'str' slice refuses
        let all = x.writes[x.wi].data.view() as &Array[u8];
        b.append(&all[sent ..< sent + n]);
      }
      // Refused: Writable comes when there is room
      if !srvSend(srv, x, b) {return;}
      x.writes[x.wi].sent = sent + n;
      x.written = x.written + u64.from(n);
    }
    let w = &mut x.writes[x.wi];
    let sentAll = w.data.len();
    answerKeptIn[Result[usize, ServerError]](&mut w.reply, Ok[usize, ServerError](sentAll));
    w.data = String.empty();
    x.wi = x.wi + 1usize;
  }
  x.writes.clear();
  x.wi = 0usize;
  if x.finishing && !x.finished {
    x.finished = true;
    if x.sized && x.written != x.length {
      // A write was made and never awaited, so never sent: the body is short
      // of its length, which only the connection's end can say
      srvCancel(srv, lp, x);
    } else {
      srvFinish(srv, x);
    }
  }
}

// Stop listening, refuse what waits, and let the exchanges taken go on
fn closeServer(srv: &mut SrvRec, lp: &mut Loop) {
  if srv.closing {return;}
  srv.closing = true;
  srv.drv.stopListening(lp, srv.listener);
  if srv.h3on {srv.h3.stopListening(lp, srv.h3listener);}
  while true {
    match srv.waiters.popFront() {
      case var Some(rp) {
        actors.answerNow[Result[Exchange, ServerError]](rp, Err[Exchange, ServerError](ServerError.closed()));
      }
      else {break;}
    }
  }
  while true {
    let slot = match srv.ready.popFront() {
      case var Some(rd) {rd.(slot)}
      else {break;}
    };
    let x = srv.exs.at(u32.from(slot)) as &mut ExRec;
    if x.stage == exReady {
      x.stage = exOut;
      x.rejected = true;
      answerText(srv, x, 503u16, "the server is closing", true);
    } else if x.stage == exDead {
      freeEx(srv, slot);
    }
  }
  // Closed: the listener is shut, and what waited is answered
  while true {
    match srv.closeWaiters.popFront() {
      case var Some(rp) {actors.answerNow[bool](rp, true);}
      else {break;}
    }
  }
}

// ---------------------------------------------------------------------------
// The jobs
// ---------------------------------------------------------------------------

// A server made on the service thread, for the reply the 'await' gives
struct ListenJob {
  pub addr: SocketAddr;
  pub cfg: ServerConfig;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.Reply) {
    let addr, cfg = self.(addr, cfg);
    let conn, maxBody, maxPending, tcfg, http2, http3 = cfg.(conn, maxBody, maxPending, tlsConfig, http2, http3);
    var h3on = false;
    match http3 {
      case let Some(mk) {h3on = true;}
      else {}
    }
    var drv = httpconn.Driver.make(conn);
    var res: Result[httpconn.ListenerId, IoError] = Err[httpconn.ListenerId, IoError](IoError.cancelled());
    var secure = false;
    // HTTP/3's certificate and key: the TLS config's
    var h3tls: Option[tls.ServerConfig] = None;
    match tcfg {
      case let Some(given) {
        var t = given;
        if h3on {h3tls = Some[tls.ServerConfig](tls.ServerConfig.make(&t.certFile, &t.keyFile));}
        t.alpn = serverAlpn(&t.alpn, http2);
        match tls.Server.make(t) {
          case let Ok(s) {
            secure = true;
            res = drv.listenWith(lp, addr, Uni[TlsMaker](TlsMaker(s)), httpconn.Sink.Here(0u64));
          }
          case let Err(x) {
            actors.answerNow[Result[Server, ServerError]](rp, Err[Server, ServerError](
              ServerError.failed(x.osError, x.message().view())));
            return;
          }
        }
      }
      else {res = drv.listen(lp, addr, httpconn.Sink.Here(0u64));}
    }
    match res {
      case let Ok(l) {
        var bound = addr;
        match drv.localAddr(lp, l) {
          case let Ok(a) {bound = a;}
          case let Err(e) {}
        }
        // HTTP/3 beside it: UDP on the same address and port
        var h3 = httpclient.http3From(http3, &tls.ClientConfig.make());
        var h3listener = 0u64;
        var altSvc = String.empty();
        if h3on {
          var why = String.empty();
          var code = 0u32;
          match &h3tls {
            case let &Some(ht) {
              match h3.listen(lp, bound, ht, 0u64) {
                case let Ok(hl) {h3listener = hl;}
                case let Err(f) {
                  why = f.message();
                  code = f.code;
                }
              }
            }
            else {why = String.from("HTTP/3 needs TLS: ServerConfig.secure");}
          }
          if why.len() > 0usize {
            drv.stopListening(lp, l);
            drv.abortAll(lp);
            actors.answerNow[Result[Server, ServerError]](rp, Err[Server, ServerError](ServerError.failed(code, why.view())));
            return;
          }
          altSvc = String.from("h3=\":");
          altSvc.appendUInt(u64.from(bound.port()));
          altSvc.append("\"; ma=86400");
        }
        let id = newId();
        sv.srvs.add(SrvRec(id, 1u32, false, false, secure, maxBody, maxPending, drv, l,
          SlotTable[ExRec].make(16u32), Dict[u64, usize].empty(), Dict[u64, Request].empty(),
          Deque[ReadyEx].empty(), Deque[actors.Reply].empty(), 0usize, h3, h3on, h3listener, altSvc,
          Dict[QKey, u64].empty(), 1u64, Deque[actors.Reply].empty()));
        actors.answerNow[Result[Server, ServerError]](rp, Ok[Server, ServerError](Server(id, bound, secure, h3on)));
      }
      case let Err(e) {
        actors.answerNow[Result[Server, ServerError]](rp, Err[Server, ServerError](
          ServerError.failed(e.code, "could not listen")));
      }
    }
  }
}

// A handle to a server made (true) or dropped (false); the last one's going closes it
struct SrvRefJob {
  pub id: u64;
  pub add: bool;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findSrv(id);
    if k >= sv.srvs.bound() {return;}
    let srv = sv.srvAt(k) as &mut SrvRec;
    if add {
      srv.refs = srv.refs + 1u32;
      return;
    }
    srv.refs = srv.refs - 1u32;
    if srv.refs == 0u32 {closeServer(srv, lp);}
  }
}

// A server closed by its program
struct SrvCloseJob {
  pub id: u64;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findSrv(id);
    if k >= sv.srvs.bound() {return;}
    closeServer(sv.srvAt(k) as &mut SrvRec, lp);
  }
}

// An actor waits for a server to be closed, the 'await' giving the reply it goes back in
struct ClosedJob {
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.Reply) {
    let k = sv.findSrv(self.id);
    if k >= sv.srvs.bound() {
      actors.answerNow[bool](rp, true);
      return;
    }
    let srv = sv.srvAt(k) as &mut SrvRec;
    if srv.closing {
      actors.answerNow[bool](rp, true);
      return;
    }
    srv.closeWaiters.push(rp);
  }
}

// An actor asks how many requests wait for an actor
struct WaitingJob {
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.Reply) {
    let k = sv.findSrv(self.id);
    var n = 0u64;
    if k < sv.srvs.bound() {
      n = u64.from((sv.srvAt(k) as &SrvRec).ready.len());
    }
    actors.answerNow[u64](rp, n);
  }
}

// An actor asks for the next request, the 'await' giving the reply it goes back in
struct NextJob {
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.Reply) {
    let id = self.(id);
    let k = sv.findSrv(id);
    if k >= sv.srvs.bound() {
      actors.answerNow[Result[Exchange, ServerError]](rp, Err[Exchange, ServerError](ServerError.closed()));
      return;
    }
    let srv = sv.srvAt(k) as &mut SrvRec;
    if srv.closing {
      actors.answerNow[Result[Exchange, ServerError]](rp, Err[Exchange, ServerError](ServerError.closed()));
      return;
    }
    // The first request waiting that is still alive
    while true {
      match srv.ready.popFront() {
        case var Some(rd) {
          let slot, r = rd.(slot, request);
          if (srv.exs.at(u32.from(slot)) as &ExRec).stage == exDead {
            freeEx(srv, slot);
          } else {
            deliverEx(srv, slot, rp, r);
            return;
          }
        }
        else {break;}
      }
    }
    srv.waiters.push(rp);
  }
}

// Where a handle's exchange is: its server and record, or null
struct Located {
  srv: *SrvRec;
  ex: *ExRec;
}

fn locate(sv: &Service, sid: u64, slot: u32, id: u64) Located {
  let k = sv.findSrv(sid);
  if k >= sv.srvs.bound() {return Located(null, null);}
  let srv = sv.srvAt(k);
  Located(srv, exOf(srv as &SrvRec, slot, id))
}

// Begin an exchange's response: its head and the framing of its body
fn beginResponse(srv: &mut SrvRec, x: &mut ExRec, head: ResponseHead, framing: BodyLength) {
  let st = head.status;
  x.responded = true;
  x.sized = framing.isSized();
  x.length = framing.length;
  x.chunked = framing.isUnsized();
  x.bodyless = x.isHead || st == 204u16 || st == 304u16 || framing.isEmpty() ||
    (framing.isSized() && framing.length == 0u64);
  srvRespond(srv, x, head, framing);
  if x.bodyless {x.finished = true;}
}

// A whole response
struct RespondJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub head: ResponseHead;
  pub body: String;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let srv, slot, id, head, body = self.(srv, slot, id, head, body);
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {return;}
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    if x.over || x.responded {return;}
    let st = head.status;
    let n = body.len();
    let framing = if st == 204u16 || st == 304u16 {BodyLength.empty()} else {BodyLength.sized(u64.from(n))};
    beginResponse(s, x, head, framing);
    if !x.bodyless {
      let w = PendingWrite(body, 0usize, None);
      x.writes.push(w);
      x.finishing = true;
      pumpWrites(s, lp, x);
    }
  }
}

// The head of a streamed response
struct StartJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub head: ResponseHead;
  pub framing: BodyLength;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let srv, slot, id, head, framing = self.(srv, slot, id, head, framing);
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {return;}
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    if x.over || x.responded {return;}
    beginResponse(s, x, head, framing);
  }
}

// Body bytes, the 'await' giving the reply that says when they are sent
struct WriteJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub data: String;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.Reply) {
    let srv, slot, id, data = self.(srv, slot, id, data);
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {
      actors.answerNow[Result[usize, ServerError]](rp, Err[usize, ServerError](ServerError.closed()));
      return;
    }
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    if x.bodyless && !x.over {
      actors.answerNow[Result[usize, ServerError]](rp, Ok[usize, ServerError](0usize));
      return;
    }
    if x.over || !x.responded || x.finishing {
      actors.answerNow[Result[usize, ServerError]](rp, Err[usize, ServerError](ServerError.closed()));
      return;
    }
    let w = PendingWrite(data, 0usize, Some[actors.Reply](rp));
    x.writes.push(w);
    pumpWrites(s, lp, x);
  }
}

// The body is whole; the 'await' gives the reply that says when it is sent
struct FinishJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.Reply) {
    let srv, slot, id = self.(srv, slot, id);
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {
      actors.answerNow[Result[u64, ServerError]](rp, Err[u64, ServerError](ServerError.closed()));
      return;
    }
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    if x.over {
      if x.ok {
        actors.answerNow[Result[u64, ServerError]](rp, Ok[u64, ServerError](x.written));
      } else {
        actors.answerNow[Result[u64, ServerError]](rp, Err[u64, ServerError](ServerError.closed()));
      }
      return;
    }
    x.finishReply = Some[actors.Reply](rp);
    x.finishing = true;
    pumpWrites(s, lp, x);
  }
}

// An Exchange dropped: an unanswered request is answered 500; an unsized body
// is ended; a sized body cut short resets the connection
struct DropExJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {return;}
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    x.handle = false;
    if x.over {
      freeEx(s, usize.from(slot));
      return;
    }
    if !x.responded {
      answerText(s, x, 500u16, "no response was made", false);
    } else if !x.finished && !x.finishing {
      if x.chunked {
        x.finishing = true;
        pumpWrites(s, lp, x);
      } else {
        srvCancel(s, lp, x);
      }
    }
  }
}
