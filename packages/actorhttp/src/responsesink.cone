// A server response fed by a stream: 'Exchange.bodySink()' (server.cone) makes a
// ResponseSink, a stages.ChunkSink, and a pipeline (a FileSource, a gzip
// stage...) that ends in it becomes the response's body, so a large or generated
// body never sits whole in memory. The sink is an actor shaped like BodySource: it
// posts each chunk to the service thread (the jobs below), which keeps them in the
// exchange's record (serverservice.cone, ExRec) and sends them as the connection
// takes them.
//
// OWNED CREDIT. The service thread gives the chunk itself to the connection (srvSendBuf), moved, with
// the source's home on it (iobuf IoHome, stages.chunkHome): the buffer is not copied, and when the connection
// is done with it, wherever that is (the kernel's send completing, a TLS write, an h2 frame cut, a reset),
// its death sends the source 'giveBack'. While the peer reads slowly the connection refuses the chunk, which
// stays queued here as a plain buffer (its credit not returned), the source is not given its buffer back
// and sends no more. What is held is the source's window of bytes. A chunk is sent whole, as it
// came; small chunks are not joined here, the cores join small buffers themselves. A sized body's length is counted on the service thread as the chunks
// arrive: past the length, or short of it at the end, the exchange is cancelled
// (srvCancel) and the source stopped Failed, because the cores panic on either.
//
// WHO ENDS THE BODY. The sink's 'end(Finished)' is 'finish'. 'end(Failed)' resets
// the exchange. Dropping the Exchange after 'bodySink' leaves the body to the sink
// (DropExJob does not finish or cut it): the handler wires the sink to a source and
// returns, so the drop usually comes before the source's 'attach' reaches the service.
// The peer resetting or the connection
// closing (endEx) stops the source with Failed(closed) and gives back every chunk
// held and every chunk still arriving. A body the protocol forbids (HEAD, 204, 304, a
// length of 0) is answered on 'attach' with stop(Finished), so the pipeline is not run.
// A sink that is held but never attached to a source ends nothing: the response waits,
// as any pipeline with no end does. A sink that is DROPPED (the actor's 'final') without
// a source ever attached can have none attach after it (its 'attach' is a message to
// it, ahead of its death, and its job to the service ahead of SinkGoneJob), so no body
// will come: with the Exchange dropped too, whichever of the two comes second ends the
// response as without a sink (an unsized body is finished, a sized one reset).

// Give back to the source an exchange's chunk that was queued
fn sinkGive(x: &ExRec, b: IoBuf) {
  match &x.sinkUp {
    case let &Some(u) {u.giveBack(b);}
    else {}
  }
}

// Give back every chunk held
fn sinkDrain(x: &mut ExRec) {
  while true {
    match x.sinkChunks.popFront() {
      case var Some(b) {sinkGive(x, b);}
      else {break;}
    }
  }
}

// The exchange's source is stopped with why (once), and the chunks held go back
fn sinkStop(x: &mut ExRec, why: Ending) {
  if x.sinkFailed {return;}
  x.sinkFailed = true;
  match &x.sinkUp {
    case let &Some(u) {u.stop(why);}
    else {}
  }
  sinkDrain(x);
}

// The body cannot go on: the exchange is cancelled and the source stopped
fn sinkFail(srv: &mut SrvRec, lp: &mut Loop, slot: usize, text: &str) {
  if srv.exs.borrowAt(u32.from(slot)).unwrap().sinkFailed {return;}
  srvCancel(srv, lp, slot);
  sinkStop(srv.exs.borrowMutAt(u32.from(slot)).unwrap(), Ending.Failed(AnyError.msg(text)));
}

// Send as much of the chunks held as the connection takes, and finish the body
// once the sink has ended and they are all sent
fn pumpSink(srv: &mut SrvRec, lp: &mut Loop, slot: usize) {
  let k = u32.from(slot);
  {
    let x0 = srv.exs.borrowAt(k).unwrap();
    if x0.over || x0.sinkFailed {return;}
  }
  while srv.exs.borrowAt(k).unwrap().sinkChunks.len() > 0usize {
    match srv.exs.borrowMutAt(k).unwrap().sinkChunks.popFront() {
      case var Some(b) {
        let n = b.len();
        if n == 0usize {
          // an empty chunk: it goes back
          sinkGive(srv.exs.borrowAt(k).unwrap(), b);
        } else {
          // The chunk itself goes to the connection, moved, wearing the source's home: its death, wherever
          // the connection is done with it, returns the credit
          {
            let x1 = srv.exs.borrowAt(k).unwrap();
            match &x1.sinkHome {
              case let &Some(h) {b.setHome(h);}
              else {}
            }
          }
          match srvSendBuf(srv, slot, b) {
            case is None[IoBuf] {
              let x2 = srv.exs.borrowMutAt(k).unwrap();
              x2.written = x2.written + u64.from(n);
            }
            case var Some(back) {
              // Refused (Writable comes when there is room): a plain chunk again, waiting at the front, so that
              // its credit is not returned now
              back.clearHome();
              srv.exs.borrowMutAt(k).unwrap().sinkChunks.pushFront(back);
              return;
            }
          }
        }
      }
      else {break;}
    }
  }
  let fin = {
    let x3 = srv.exs.borrowMutAt(k).unwrap();
    if x3.sinkEnded && !x3.finished {
      x3.finished = true;
      x3.sinkOpen = false;
      true
    } else {false}
  };
  if fin {srvFinish(srv, slot);}
}
// ---------------------------------------------------------------------------
// The sink
// ---------------------------------------------------------------------------

actor ResponseSink is ChunkSink {
  srv: u64;
  slot: u32;
  id: u64;
  up: Option[ChunkSource];       // kept past 'end' (the source holds nothing of this sink after it): a chunk that finds its exchange gone goes back through it

  bodyless: bool;                // the response has no body bytes: the source is stopped Finished at once, and nothing goes to the service

  pub fn init(self: &new, srv: u64, slot: u32, id: u64, bodyless: bool) {
    *self = Self(srv: srv, slot: slot, id: id, up: None[ChunkSource], bodyless: bodyless);
  }

  pub async fn attach(self, source: ChunkSource) {
    up = Some[ChunkSource](source.clone());
    if bodyless {
      source.stop(Ending.Finished);
      return;
    }
    post[SinkAttachJob](SinkAttachJob(srv, slot, id, source));
  }

  pub async fn accept(self, c: IoBuf) {
    if bodyless {
      self.home(c);
      return;
    }
    post[SinkChunkJob](SinkChunkJob(srv, slot, id, c, selfactor.clone()));
  }

  pub async fn end(self, how: Ending) {
    if bodyless {return;}
    post[SinkEndJob](SinkEndJob(srv, slot, id, how));
  }

  // The sink dropped with no source ever attached: the service is told
  fn final(self: &uni) {
    if bodyless {return;}
    match &up {
      case let &Some(u) {}
      else {post[SinkGoneJob](SinkGoneJob(srv, slot, id));}
    }
  }

  // A chunk the service thread could not take (its exchange is gone): back to the source
  pub async fn home(self, c: IoBuf) {
    match &up {
      case let &Some(u) {u.giveBack(c);}
      else {}
    }
  }
}

// ---------------------------------------------------------------------------
// The jobs
// ---------------------------------------------------------------------------

// A sink taken (Exchange.bodySink): the exchange's body is the sink's from now
struct SinkOpenJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let loc = locate(sv, self.srv, self.slot, self.id);
    if !loc.ok {return;}
    let x = (sv.srvs.rawAt(loc.k) as &mut SrvRec).exs.borrowMutAt(self.slot).unwrap();
    x.sinkOpen = true;
    // the exchange ended already: the source, once attached, is stopped
    if x.over {x.sinkFailed = true;}
  }
}

// The sink actor was dropped and no source had been attached to it
struct SinkGoneJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let loc = locate(sv, self.srv, self.slot, self.id);
    if !loc.ok {return;}
    let s = (sv.srvs.rawAt(loc.k) as &mut SrvRec);
    let x = s.exs.borrowMutAt(self.slot).unwrap();
    if x.over || x.finished || x.finishing || !x.sinkOpen || x.sinkFailed || x.sinkEnded || x.sinkIn != 0u64 {return;}
    match &x.sinkUp {
      case let &Some(u) {return;}
      else {}
    }
    x.sinkGone = true;
    // the Exchange is dropped already: no body will come
    if !x.handle {
      x.sinkOpen = false;
      endBodyUnsunk(s, lp, usize.from(self.slot));
    }
  }
}

// The sink was given its source
struct SinkAttachJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub up: ChunkSource;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let srv, slot, id, up = self.(srv, slot, id, up);
    let loc = locate(sv, srv, slot, id);
    if !loc.ok {
      up.stop(Ending.Failed(AnyError.from(ServerError.closed())));
      return;
    }
    let x = (sv.srvs.rawAt(loc.k) as &mut SrvRec).exs.borrowMutAt(slot).unwrap();
    if x.sinkFailed {
      up.stop(Ending.Failed(AnyError.from(ServerError.closed())));
      return;
    }
    x.sinkHome = Some[IoHome](chunkHome(up.clone()));
    x.sinkUp = Some[ChunkSource](up);
  }
}

// A chunk of the body
struct SinkChunkJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub buf: IoBuf;
  pub home: ResponseSink;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let srv, slot, id, buf, home = self.(srv, slot, id, buf, home);
    let loc = locate(sv, srv, slot, id);
    if !loc.ok {
      home.home(buf);
      return;
    }
    let s = (sv.srvs.rawAt(loc.k) as &mut SrvRec);
    let sl = usize.from(slot);
    let x = s.exs.borrowMutAt(slot).unwrap();
    if !x.sinkOpen || x.sinkFailed || x.over {
      home.home(buf);
      return;
    }
    x.sinkIn = x.sinkIn + u64.from(buf.len());
    if x.sized && x.sinkIn > x.length {
      home.home(buf);
      sinkFail(s, lp, sl, "the body is longer than the length declared to start");
      return;
    }
    x.sinkChunks.push(buf);
    pumpSink(s, lp, sl);
  }
}

// The stream is over
struct SinkEndJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub how: Ending;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let srv, slot, id, how = self.(srv, slot, id, how);
    let loc = locate(sv, srv, slot, id);
    if !loc.ok {return;}
    let s = (sv.srvs.rawAt(loc.k) as &mut SrvRec);
    let sl = usize.from(slot);
    let x = s.exs.borrowMutAt(slot).unwrap();
    if !x.sinkOpen {return;}
    match how {
      case is Finished {
        if x.sinkFailed {
          x.sinkOpen = false;
        } else if x.sized && x.sinkIn != x.length {
          sinkFail(s, lp, sl, "the body is shorter than the length declared to start");
        } else {
          x.sinkEnded = true;
          pumpSink(s, lp, sl);
        }
      }
      else {
        // the pipeline failed: the response is cut short
        if x.sinkFailed {
          x.sinkOpen = false;
        } else {
          x.sinkFailed = true;
          sinkDrain(x);
          if !s.exs.borrowAt(slot).unwrap().finished {srvCancel(s, lp, sl);}
        }
      }
    }
  }
}
