// The service thread's side of the package: what it keeps for every client
// and connection, the jobs that start an exchange, and the loop that drives
// them all (actorhttp.cone's header says how the pieces fit).

// ---------------------------------------------------------------------------
// Records
// ---------------------------------------------------------------------------

// The pools of this package, named for what each holds (the pool kind is spelled here and nowhere else)
alias EntryId = Handle;                // a pool's handle for one entry (the token helpers below take one)
alias Streams = GenPool[StreamRec];   // a client's streamed responses
alias Clients = GenPool[ClientRec];
alias Srvs = GenPool[SrvRec];

// A sink's token for a stream's fetch: this bit and the stream's slot. A
// whole fetch's token is its wait slot alone
const streamBit = 0x100000000u64;

// THE TOKEN. The layer above's own part of a sink token is forty bits (httpconn/driver.cone), used so: the cell
// index in bits 0 to 31, the stream or connection bit at 32 (above), and the low SEVEN bits of the cell's
// generation in bits 33 to 39. A lookup through a token (byToken) finds the cell's entry only if the cell is live
// and those seven bits are its generation's: a token whose entry is gone, and whose cell is free or has been
// reused, reaches nothing. The pool's full Handle stays wherever the service keeps one. WRAP ODDS: a cell's
// generation goes up by one each time it is freed, so a stale token names a reused cell again only if the cell has
// been reused a multiple of 128 times since (128, 256, ...) and is live at that moment. Never for fewer than 128
// reuses of that one cell; after that, 1 in 128 of the moments it is live.
const tokGenShift = 33u64;
const tokGenMask = 0x7Fu64;

// (pub for tests/tokens.cone, not an API) The token for the entry h, with a flag bit (streamBit, connBit, or 0)
pub fn tokenOf(h: EntryId, flag: u64) u64 {
  flag | ((u64.from(h.gen) & tokGenMask) << tokGenShift) | u64.from(h.index)
}

// The cell index a token names
pub fn tokCell(t: u64) u32 { u32.from(t & 0xFFFFFFFFu64) }

// The live entry a token names, or null (the cell is free, or was reused since: its generation's low bits differ)
pub fn byToken[T](pool: &GenPool[T], t: u64) EntryId {
  let i = tokCell(t);
  let h = pool.slotAt(i);
  if h.isNone() || (u64.from(h.gen) & tokGenMask) != ((t >> tokGenShift) & tokGenMask) {
    return EntryId.none();
  }
  h
}

// WHY DROPPING A STALE EVENT IS SAFE. A token's entry leaves its table only when its owner has finished with it:
// a stream's record goes when the stream ends. So an event whose token no longer reaches a live entry belongs to something
// already answered and released: nothing is left waiting on it (no reply unanswered), and
// the entry now in that cell, if any, is another one's and must not be touched. A Data event's buffer drops with the
// event; the stream it flowed to is gone, so no credit is owed for it.

// A client the service owns: its handles counted, its fetches awaited
struct ClientRec {
  id: u64;
  refs: u32;
  dying: bool;                   // no handle is left: it is ended, and goes when its connections have
  maxBody: usize;
  client: httpclient.Client;
  streams: Streams;     // the responses actors read as they arrive; each holds a count of 'refs'
  ups: Dict[u64, u32];               // an upload's stream id: its slot in 'streams' (upload.cone: its sink knows the id alone)
}

// Everything the service thread keeps: its clients (their streams) and its
// servers. A service hosted on aio's I/O thread (aio.Hosted: turn, complete,
// wakeAt, end). The connections a program makes itself are ManualConn actors
// (manualconn.cone), not the service's
struct Service {
  clients: Clients;
  srvs: Srvs;       // the servers listening, each with a driver of its own

  fn make() Service {
    Service(clients: Clients(4usize), srvs: Srvs(4usize))
  }


  // Where the live server id is in its cells, or their number
  fn findSrv(self: &, id: u64) usize {
    var k = 0usize;
    while k < srvs.bound() {
      if srvs.isLive(u32.from(k)) && srvs.borrowAt(u32.from(k)).unwrap().id == id {return k;}
      k = k + 1usize;
    }
    srvs.bound()
  }

  // Where the live client id is in its cells, or their number
  // The client record in cell k (transitional raw access, see GenPool.rawAt); panics if the cell is not live
  fn clientAt(self: &, k: usize) *ClientRec {clients.rawAt(u32.from(k))}

  fn findClient(self: &, id: u64) usize {
    var k = 0usize;
    while k < clients.bound() {
      if clients.isLive(u32.from(k)) {
        let p = clients.borrowAt(u32.from(k)).unwrap();
        if p.id == id && !p.dying {return k;}
      }
      k = k + 1usize;
    }
    clients.bound()
  }

  // Its turn on aio's I/O thread (aio.Hosted), after the jobs queued for it
  // have run: drive everything started, each event to what awaits it, and let
  // the servers and clients that are over leave
  pub fn turn(self: &mut, lp: &mut Loop) {
    var k = 0usize;
    while k < clients.bound() {
      if clients.isLive(u32.from(k)) {
        pumpClient((self.clients.rawAt(u32.from(k)) as &mut ClientRec), lp);
      }
      k = k + 1usize;
    }
    var s = 0usize;
    while s < srvs.bound() {
      if srvs.isLive(u32.from(s)) {
        pumpServer((self.srvs.rawAt(u32.from(s)) as &mut SrvRec), lp);
      }
      s = s + 1usize;
    }
    self.sweepServers(lp);
    self.sweep();
  }

  // The latest the I/O thread may wait in its poll before the next turn: the
  // earliest any client or driver wants (aio.Hosted)
  pub fn wakeAt(self: &) Instant {
    var limit = forever();
    var k = 0usize;
    while k < clients.bound() {
      if clients.isLive(u32.from(k)) {
        let w = (self.clients.borrowAt(u32.from(k)).unwrap()).client.wakeAt();
        if w < limit {limit = w;}
      }
      k = k + 1usize;
    }
    var s = 0usize;
    while s < srvs.bound() {
      if srvs.isLive(u32.from(s)) {
        let srec = self.srvs.borrowAt(u32.from(s)).unwrap();
        let sw = srec.drv.wakeAt();
        if sw < limit {limit = sw;}
        let hw = srec.h3.wakeAt();
        if hw < limit {limit = hw;}
      }
      s = s + 1usize;
    }
    limit
  }

  // A completion the I/O thread's poll returned, offered to the clients and
  // drivers in turn: true if one of them took it as its own (aio.Hosted)
  pub fn complete(self: &mut, lp: &mut Loop, c: &mut Completion) bool {
    var k = 0usize;
    while k < clients.bound() {
      if clients.isLive(u32.from(k)) {
        let rec = (self.clients.rawAt(u32.from(k)) as &mut ClientRec);
        if rec.client.complete(lp, c) {return true;}
      }
      k = k + 1usize;
    }
    var s = 0usize;
    while s < srvs.bound() {
      if srvs.isLive(u32.from(s)) {
        if (self.srvs.rawAt(u32.from(s)) as &mut SrvRec).drv.complete(lp, c) {return true;}
        if (self.srvs.rawAt(u32.from(s)) as &mut SrvRec).h3.complete(lp, c) {return true;}
      }
      s = s + 1usize;
    }
    false
  }

  // Its end, the Loop still alive (aio.Hosted; the package's header, THE
  // PROGRAM'S END): every client, server and connection reset now, so that
  // nothing of the service is left on the Loop; the events that makes are
  // never pumped, and every exchange still awaited is abandoned when the
  // service is dropped, its reply with it
  pub fn end(self: &mut, lp: &mut Loop) {
    var k = 0usize;
    while k < clients.bound() {
      if clients.isLive(u32.from(k)) {
        ((self.clients.rawAt(u32.from(k)) as &mut ClientRec)).client.abortAll(lp);
      }
      k = k + 1usize;
    }
    var s = 0usize;
    while s < srvs.bound() {
      if srvs.isLive(u32.from(s)) {
        (self.srvs.rawAt(u32.from(s)) as &mut SrvRec).drv.abortAll(lp);
        (self.srvs.rawAt(u32.from(s)) as &mut SrvRec).h3.end(lp);
      }
      s = s + 1usize;
    }
  }

  // Servers that are closed, with nothing left to answer, leave: their
  // connections (idle ones kept alive) are reset first
  fn sweepServers(self: &mut, lp: &mut Loop) {
    var k = 0usize;
    while k < srvs.bound() {
      if srvs.isLive(u32.from(k)) {
        let srec = (self.srvs.rawAt(u32.from(k)) as &mut SrvRec);
        if srec.closing && srec.live == 0usize {
          if !srec.aborted {
            srec.aborted = true;
            srec.drv.abortAll(lp);
            (self.srvs.rawAt(u32.from(k)) as &mut SrvRec).h3.abortAll(lp);
          }
          let srec2 = (self.srvs.rawAt(u32.from(k)) as &mut SrvRec);
          if srec2.drv.live() == 0u32 && srec2.h3.live() == 0usize {
            srvs.removeAt(u32.from(k));
          }
        }
      }
      k = k + 1usize;
    }
  }

  // Clients whose handles are gone and whose work is over leave
  fn sweep(self: &mut) {
    var k = 0usize;
    while k < clients.bound() {
      if clients.isLive(u32.from(k)) {
        let rec = self.clients.borrowAt(u32.from(k)).unwrap();
        if rec.dying && rec.client.live() == 0u32 {
          let ds = rec.client.driverStats();
          if ds.connects == ds.closed && rec.client.http3Live() == 0usize {
            clients.removeAt(u32.from(k));
          }
        }
      }
      k = k + 1usize;
    }
  }
}

// ---------------------------------------------------------------------------
// Answers
// ---------------------------------------------------------------------------

// The body bytes sent in a piece
const sendChunk = 16384usize;

// The failure of an exchange whose buffer the pool refused
fn overloadedFailure() httpclient.Failure {
  httpclient.Failure.make(httpclient.Stage.Limit, 0u32, ErrorKind.Overloaded,
    "the buffer pool is full (iobuf maxBytes): no buffer for the request body")
}

// The failure of an exchange that went over its body limit
fn limitFailure() httpclient.Failure {
  httpclient.Failure.make(httpclient.Stage.Limit, 0u32, ErrorKind.TooLarge,
    "the body is longer than the limit it was fetched with")
}

// ---------------------------------------------------------------------------
// Fetches
// ---------------------------------------------------------------------------

// A client's events for this turn, each to the fetch awaiting it
fn pumpClient(rec: &mut ClientRec, lp: &mut Loop) {
  var evs = List[httpclient.Event]();
  rec.client.pump(lp, &uni evs);
  each e in evs.drain() {
    if (e.token & streamBit) != 0u64 {
      // an event of a stream already freed (its cell free or reused) reaches nothing
      if !byToken(&rec.streams, e.token).isNone() {
        let sslot = usize.from(tokCell(e.token));
        onStreamEvent(rec, lp, e, sslot);
      }
    }
    // no whole-body fetch runs on the service: the client actor runs them (clientactor.cone)
  }
}

// ---------------------------------------------------------------------------
// The jobs: fetches
// ---------------------------------------------------------------------------

// A client made on the service thread, for the handle already named by id
struct CreateClientJob {
  pub id: u64;
  pub cfg: httpclient.Config;
  pub maxBody: usize;
  pub refs: u32;      // the handles there are when the record is made (it is made when a call first needs it)

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let id, cfg, maxBody, refs = self.(id, cfg, maxBody, refs);
    sv.clients.add(ClientRec(id, refs, false, maxBody, httpclient.Client.make(cfg),
      Streams(16usize), Dict[u64, u32]()));
  }
}

// A handle to a client made (true) or dropped (false); the last one's going
// ends the client: every fetch of it answered Cancelled, its connections reset
struct RefJob {
  pub id: u64;
  pub add: bool;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findClient(id);
    if k >= sv.clients.bound() {return;}
    let rec = (sv.clients.rawAt(u32.from(k)) as &mut ClientRec);
    if add {
      rec.refs = rec.refs + 1u32;
      return;
    }
    unrefClient(rec, lp);
  }
}
