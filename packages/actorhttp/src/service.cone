// The service thread's side of the package: what it keeps for every client
// and connection, the jobs that start an exchange, and the loop that drives
// them all (actorhttp.cone's header says how the pieces fit).

// ---------------------------------------------------------------------------
// Records
// ---------------------------------------------------------------------------

// An exchange awaited: the reply its answer goes back in, the response being
// gathered (empty to begin with), and what it needs to end it. It is made
// whole when the exchange starts, and taken out of its table whole when the
// exchange ends, its reply answered with its response
struct Wait {
  reply: actors.Reply;
  resp: httpclient.Response;
  tooBig: bool;                  // the body passed the limit, and the exchange was cancelled for it
  limit: usize;                  // the most body bytes it takes
  fetch: httpclient.FetchId;     // a client's fetch
  req: httpconn.ReqId;           // a connection's request
  body: String;                  // a connection's request body still to send
  sent: usize;                   // ...and how much of it has gone
  conn: usize;                   // a connection's request: its connection's slot
  bodyDone: bool;                // its body has been finished
}

// A wait for reply, its response not begun, taking at most limit body bytes
fn waitFor(rp: actors.Reply, limit: usize) Wait {
  Wait(reply: rp, resp: httpclient.Response.blank(), tooBig: false, limit: limit,
    fetch: httpclient.FetchId.none(), req: httpconn.ReqId.none(), body: String.empty(), sent: 0usize,
    conn: 0usize, bodyDone: false)
}

// A sink's token for a stream's fetch: this bit and the stream's slot. A
// whole fetch's token is its wait slot alone
const streamBit = 0x100000000u64;

// A client the service owns: its handles counted, its fetches awaited
struct ClientRec {
  id: u64;
  refs: u32;
  dying: bool;                   // no handle is left: it is ended, and goes when its connections have
  maxBody: usize;
  client: httpclient.Client;
  waits: SlotTable[Wait];
  streams: SlotTable[StreamRec];     // the responses actors read as they arrive; each holds a count of 'refs'
}

// A connection the service owns, which a Conn names
struct ConnRec {
  used: bool;
  id: u64;
  conn: httpconn.ConnId;
  connecting: bool;              // its connect's reply is still to be answered
  open: bool;
  closed: bool;
  dropped: bool;                 // its Conn handle has gone
  busy: u32;                     // exchanges in flight on it
  reply: actors.Reply;
}


// A sink's token for a connection's own events (Connected, Closed): this bit
// and the connection's slot. A request's token is its exchange slot alone
const connBit = 0x100000000u64;

// Everything the service thread keeps: its clients, its driver for the
// connections a program makes itself, and what is awaited on those. A service
// hosted on aio's I/O thread (aio.Hosted: turn, complete, wakeAt, end)
struct Service {
  clients: SlotTable[ClientRec];
  drv: httpconn.Driver;
  conns: SlotTable[ConnRec];
  xwaits: SlotTable[Wait];
  srvs: SlotTable[SrvRec];       // the servers listening, each with a driver of its own

  fn make() Service {
    Service(clients: SlotTable[ClientRec].make(4u32),
      drv: httpconn.Driver.make(httpconn.Config.make()), conns: SlotTable[ConnRec].make(16u32),
      xwaits: SlotTable[Wait].make(16u32), srvs: SlotTable[SrvRec].make(4u32))
  }

  // The record in cell k, or null if that cell is free
  fn clientAt(self: &, k: usize) *ClientRec {clients.at(u32.from(k))}

  fn srvAt(self: &, k: usize) *SrvRec {srvs.at(u32.from(k))}

  // Where the live server id is in its cells, or their number
  fn findSrv(self: &, id: u64) usize {
    var k = 0usize;
    while k < srvs.bound() {
      let p = self.srvAt(k);
      if p as usize != 0usize && (*p).id == id {return k;}
      k = k + 1usize;
    }
    srvs.bound()
  }

  // Where the live client id is in its cells, or their number
  fn findClient(self: &, id: u64) usize {
    var k = 0usize;
    while k < clients.bound() {
      let p = self.clientAt(k);
      if p as usize != 0usize && (*p).id == id && !(*p).dying {return k;}
      k = k + 1usize;
    }
    clients.bound()
  }

  // Where the connection id is in its cells, or their number
  fn findConn(self: &, id: u64) usize {
    var k = 0usize;
    while k < conns.bound() {
      let p = conns.at(u32.from(k));
      if p as usize != 0usize && (*p).used && (*p).id == id {return k;}
      k = k + 1usize;
    }
    conns.bound()
  }

  // Its turn on aio's I/O thread (aio.Hosted), after the jobs queued for it
  // have run: drive everything started, each event to what awaits it, and let
  // the servers and clients that are over leave
  pub fn turn(self: &mut, lp: &mut Loop) {
    var k = 0usize;
    while k < clients.bound() {
      if clients.isLive(u32.from(k)) {
        pumpClient(self.clientAt(k) as &mut ClientRec, lp);
      }
      k = k + 1usize;
    }
    self.pumpConns(lp);
    var s = 0usize;
    while s < srvs.bound() {
      if srvs.isLive(u32.from(s)) {
        pumpServer(self.srvAt(s) as &mut SrvRec, lp);
      }
      s = s + 1usize;
    }
    self.sweepServers(lp);
    self.sweep();
  }

  // The latest the I/O thread may wait in its poll before the next turn: the
  // earliest any client or driver wants (aio.Hosted)
  pub fn wakeAt(self: &) Instant {
    var limit = drv.wakeAt();
    var k = 0usize;
    while k < clients.bound() {
      if clients.isLive(u32.from(k)) {
        let w = (self.clientAt(k) as &ClientRec).client.wakeAt();
        if w < limit {limit = w;}
      }
      k = k + 1usize;
    }
    var s = 0usize;
    while s < srvs.bound() {
      if srvs.isLive(u32.from(s)) {
        let sw = (self.srvAt(s) as &SrvRec).drv.wakeAt();
        if sw < limit {limit = sw;}
      }
      s = s + 1usize;
    }
    limit
  }

  // A completion the I/O thread's poll returned, offered to the clients and
  // drivers in turn: true if one of them took it as its own (aio.Hosted)
  pub fn complete(self: &mut, lp: &mut Loop, c: &mut Completion) bool {
    var k = 0usize;
    while k < clients.bound() {
      if clients.isLive(u32.from(k)) {
        let rec = self.clientAt(k) as &mut ClientRec;
        if rec.client.complete(lp, c) {return true;}
      }
      k = k + 1usize;
    }
    var s = 0usize;
    while s < srvs.bound() {
      if srvs.isLive(u32.from(s)) {
        let srec = self.srvAt(s) as &mut SrvRec;
        if srec.drv.complete(lp, c) {return true;}
      }
      s = s + 1usize;
    }
    drv.complete(lp, c)
  }

  // Its end, the Loop still alive (aio.Hosted; the package's header, THE
  // PROGRAM'S END): every client, server and connection reset now, so that
  // nothing of the service is left on the Loop; the events that makes are
  // never pumped, and every exchange still awaited is abandoned when the
  // service is dropped, its reply with it
  pub fn end(self: &mut, lp: &mut Loop) {
    var k = 0usize;
    while k < clients.bound() {
      if clients.isLive(u32.from(k)) {
        (self.clientAt(k) as &mut ClientRec).client.abortAll(lp);
      }
      k = k + 1usize;
    }
    var s = 0usize;
    while s < srvs.bound() {
      if srvs.isLive(u32.from(s)) {
        (self.srvAt(s) as &mut SrvRec).drv.abortAll(lp);
      }
      s = s + 1usize;
    }
    drv.abortAll(lp);
  }

  // Servers that are closed, with nothing left to answer, leave: their
  // connections (idle ones kept alive) are reset first
  fn sweepServers(self: &mut, lp: &mut Loop) {
    var k = 0usize;
    while k < srvs.bound() {
      if srvs.isLive(u32.from(k)) {
        let srec = self.srvAt(k) as &mut SrvRec;
        if srec.closing && srec.live == 0usize {
          if !srec.aborted {
            srec.aborted = true;
            srec.drv.abortAll(lp);
          }
          if srec.drv.live() == 0u32 && srec.drv.held() == 0usize {
            srvs.removeAt(u32.from(k));
          }
        }
      }
      k = k + 1usize;
    }
  }

  // Clients whose handles are gone and whose work is over leave
  fn sweep(self: &mut) {
    var k = 0usize;
    while k < clients.bound() {
      if clients.isLive(u32.from(k)) {
        let rec = self.clientAt(k) as &ClientRec;
        if rec.dying && rec.client.live() == 0u32 && rec.client.held() == 0usize {
          let ds = rec.client.driverStats();
          if ds.connects == ds.closed {
            clients.removeAt(u32.from(k));
          }
        }
      }
      k = k + 1usize;
    }
  }

  // The driver's events for this turn, each to the connection or exchange
  // awaiting it
  fn pumpConns(self: &mut, lp: &mut Loop) {
    var evs = List[httpconn.Event].empty();
    drv.pump(lp, &uni evs);
    each e in evs.drain() {
      if (e.token & connBit) != 0u64 {
        self.onConnEvent(lp, &e);
      } else {
        self.onExchangeEvent(lp, e);
      }
    }
  }

  // A connection's own event: it connected, or it is over
  fn onConnEvent(self: &mut, lp: &mut Loop, e: &httpconn.Event) {
    let slot = usize.from(e.token & 0xFFFFFFFFu64);
    let c = conns.at(u32.from(slot)) as &mut ConnRec;
    let k = e.kind;
    if k == httpconn.EventKind.Connected {
      c.open = true;
      if c.connecting {
        c.connecting = false;
        answerConn(c, Ok[Conn, FetchError](Conn(c.id)));
      }
    } else if k == httpconn.EventKind.Closed {
      c.open = false;
      c.closed = true;
      if c.connecting {
        c.connecting = false;
        answerConn(c, Error[Conn, FetchError](FetchError.failed(httpclient.Failure.fromConn(&e.failure))));
      }
      if c.dropped {self.freeConn(slot);}
    }
  }

  // Connection slot k is free again
  fn freeConn(self: &mut, k: usize) {
    conns.removeAt(u32.from(k));
  }

  // An event of an exchange on a connection, taken by value: its head's
  // fields go whole into the response gathered
  fn onExchangeEvent(self: &mut, lp: &mut Loop, e: httpconn.Event) {
    let slot = usize.from(e.token);
    let w = xwaits.at(u32.from(slot)) as &mut Wait;
    let k = e.kind;
    if k == httpconn.EventKind.Response {
      let status, headers = e.(response).(status, headers);
      w.resp.status = status;
      w.resp.headers = headers;
    } else if k == httpconn.EventKind.Data {
      let n = e.buf.len();
      if w.resp.body.len() + n > w.limit {
        if !w.tooBig {
          w.tooBig = true;
          drv.cancel(lp, w.req);
        }
      } else {
        w.resp.body.appendBytes(e.buf.view());
      }
      drv.release(e.req, n);
    } else if k == httpconn.EventKind.Writable {
      self.sendBody(lp, slot);
    } else if e.isTerminal() {
      let c = conns.at(u32.from(w.conn)) as &mut ConnRec;
      if c.busy > 0u32 {c.busy = c.busy - 1u32;}
      let timing = httpclient.Timing(e.timing.submitted, e.timing.started, e.timing.firstByte,
        e.timing.ended, 1u32, 0u32, false);
      // The wait is over: taken out whole, its reply answered with what it gathered
      match xwaits.take(xwaits.slotAt(u32.from(slot))) {
        case var Some(over) {
          let reply, var resp, tooBig = over.(reply, resp, tooBig);
          resp.timing = timing;
          var v: Result[httpclient.Response, FetchError] = Error[httpclient.Response, FetchError](FetchError.cancelled());
          if k == httpconn.EventKind.Done {
            resp.outcome = httpclient.EventKind.Done;
            v = Ok[httpclient.Response, FetchError](resp);
          } else if k == httpconn.EventKind.Failed {
            v = Error[httpclient.Response, FetchError](FetchError.failed(httpclient.Failure.fromConn(&e.failure)));
          } else if k == httpconn.EventKind.TimedOut {
            v = Error[httpclient.Response, FetchError](FetchError.timedOut());
          } else if tooBig {
            v = Error[httpclient.Response, FetchError](FetchError.failed(limitFailure()));
          }
          actors.answerNow[Result[httpclient.Response, FetchError]](reply, v);
        }
        else {}
      }
    }
  }

  // As much of exchange slot's body as its connection takes now
  fn sendBody(self: &mut, lp: &mut Loop, slot: usize) {
    let w = xwaits.at(u32.from(slot)) as &mut Wait;
    if w.bodyDone {return;}
    while w.sent < w.body.len() {
      let left = w.body.len() - w.sent;
      let n = if left < sendChunk {left} else {sendChunk};
      var b = IoBuf(n);
      // As bytes: a piece may end inside a UTF-8 character, which a 'str' slice refuses
      let all = w.body.view() as &Array[u8];
      b.append(&all[w.sent ..< w.sent + n]);
      match drv.sendData(w.req, b) {
        case is None[IoBuf] {w.sent = w.sent + n;}
        else {return;}      // refused: Writable comes when there is room
      }
    }
    w.bodyDone = true;
    drv.finish(w.req);
  }
}

// ---------------------------------------------------------------------------
// Answers
// ---------------------------------------------------------------------------

// The body bytes sent in a piece
const sendChunk = 16384usize;

// A connect's reply carries v back to the actor awaiting it, answered in
// place: the reply is spent after, as the connection lives on
fn answerConn(c: &mut ConnRec, v: Result[Conn, FetchError]) {
  actors.answerNowIn[Result[Conn, FetchError]](&mut c.reply, v);
}

// The failure of an exchange that went over its body limit
fn limitFailure() httpclient.Failure {
  httpclient.Failure.make(httpclient.Stage.Limit, 0u32, ErrorKind.TooLarge,
    "the body is longer than the limit it was fetched with")
}

// ---------------------------------------------------------------------------
// Fetches
// ---------------------------------------------------------------------------

// A client's events for this turn, each to the fetch awaiting it
fn pumpClient(rec: &mut ClientRec, lp: &mut Loop) {
  var evs = List[httpclient.Event].empty();
  rec.client.pump(lp, &uni evs);
  each e in evs.drain() {
    if (e.token & streamBit) != 0u64 {
      let sslot = usize.from(e.token & 0xFFFFFFFFu64);
      onStreamEvent(rec, lp, e, sslot);
    } else {
      onFetchEvent(rec, lp, e);
    }
  }
}

// An event of a whole fetch, taken by value: its head's fields go whole into
// the response gathered
fn onFetchEvent(rec: &mut ClientRec, lp: &mut Loop, e: httpclient.Event) {
  let slot = usize.from(e.token);
  let w = rec.waits.at(u32.from(slot)) as &mut Wait;
  let k = e.kind;
  if k == httpclient.EventKind.Response {
    let response, url = e.(response, url);
    let status, headers = response.(status, headers);
    w.resp.status = status;
    w.resp.headers = headers;
    w.resp.url = url;
  } else if k == httpclient.EventKind.Data {
    let n = e.buf.len();
    if w.resp.body.len() + n > w.limit {
      if !w.tooBig {
        w.tooBig = true;
        rec.client.cancel(lp, w.fetch);
      }
    } else {
      w.resp.body.appendBytes(e.buf.view());
    }
    rec.client.release(e.id, n);
  } else if e.isTerminal() {
    // The wait is over: taken out whole, its reply answered with what it gathered
    match rec.waits.take(rec.waits.slotAt(u32.from(slot))) {
      case var Some(over) {
        let reply, var resp, tooBig = over.(reply, resp, tooBig);
        resp.outcome = k;
        resp.timing = e.timing;
        var v: Result[httpclient.Response, FetchError] = Error[httpclient.Response, FetchError](FetchError.cancelled());
        if k == httpclient.EventKind.Done {
          v = Ok[httpclient.Response, FetchError](resp);
        } else if k == httpclient.EventKind.Failed {
          v = Error[httpclient.Response, FetchError](FetchError.failed(e.failure.copy()));
        } else if k == httpclient.EventKind.TimedOut {
          v = Error[httpclient.Response, FetchError](FetchError.timedOut());
        } else if tooBig {
          v = Error[httpclient.Response, FetchError](FetchError.failed(limitFailure()));
        }
        actors.answerNow[Result[httpclient.Response, FetchError]](reply, v);
      }
      else {}
    }
  }
}

// ---------------------------------------------------------------------------
// The jobs: fetches
// ---------------------------------------------------------------------------

// A client made on the service thread, for the handle already named by id
struct CreateClientJob {
  pub id: u64;
  pub cfg: httpclient.Config;
  pub maxBody: usize;

  pub fn run(self, lp: &mut Loop, sv: &mut Service) {
    let id, cfg, maxBody = self.(id, cfg, maxBody);
    sv.clients.add(ClientRec(id, 1u32, false, maxBody, httpclient.Client.make(cfg),
      SlotTable[Wait].make(16u32), SlotTable[StreamRec].make(16u32)));
  }
}

// A handle to a client made (true) or dropped (false); the last one's going
// ends the client: every fetch of it answered Cancelled, its connections reset
struct RefJob {
  pub id: u64;
  pub add: bool;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findClient(id);
    if k >= sv.clients.bound() {return;}
    let rec = sv.clientAt(k) as &mut ClientRec;
    if add {
      rec.refs = rec.refs + 1u32;
      return;
    }
    unrefClient(rec, lp);
  }
}

// A fetch: the request; its response goes back in the reply the 'await' gives
struct FetchJob {
  pub id: u64;
  pub req: httpclient.Request;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.Reply) {
    let id, req = self.(id, req);
    let k = sv.findClient(id);
    if k >= sv.clients.bound() {
      actors.answerNow[Result[httpclient.Response, FetchError]](rp,
        Error[httpclient.Response, FetchError](FetchError.cancelled()));
      return;
    }
    let rec = sv.clientAt(k) as &mut ClientRec;
    let slot = usize.from(rec.waits.add(waitFor(rp, rec.maxBody)).index);
    let fetch = rec.client.send(lp, req, httpclient.Sink.Here(u64.from(slot)));
    (rec.waits.at(u32.from(slot)) as &mut Wait).fetch = fetch;
  }
}

// ---------------------------------------------------------------------------
// The jobs: connections
// ---------------------------------------------------------------------------

// A connection made, plain or through TLS, for the reply that awaits it
struct ConnectJob {
  pub host: String;
  pub port: u16;
  pub secure: bool;
  pub cfg: tls.ClientConfig;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.Reply) {
    let host, port, secure, cfg = self.(host, port, secure, cfg);
    let slot = usize.from(sv.conns.add(ConnRec(used: true, id: newId(), conn: httpconn.ConnId.none(),
      connecting: true, open: false, closed: false, dropped: false, busy: 0u32, reply: rp)).index);
    let c = sv.conns.at(u32.from(slot)) as &mut ConnRec;
    let sink = httpconn.Sink.Here(connBit | u64.from(slot));
    // The driver is handed a copy of the host: it holds Strings, and nothing
    // shows the job's is none of them
    let name = host.copy();
    if !secure {
      c.conn = sv.drv.connect(lp, name.view(), port, sink);
      return;
    }
    match tls.Client.make(cfg) {
      case let Ok(t) {
        c.conn = sv.drv.connectWith(lp, name.view(), port, Uni[tls.Stream](t.stream(name.view())), sink);
      }
      case let Error(x) {
        c.connecting = false;
        answerConn(c, Error[Conn, FetchError](FetchError.failed(
          httpclient.Failure.make(httpclient.Stage.Tls, x.osError, ErrorKind.Unsupported, x.message().view()))));
        sv.freeConn(slot);
      }
    }
  }
}

// A request on a connection: its head and whole body, and its limits; its
// response goes back in the reply the 'await' gives
struct ExchangeJob {
  pub id: u64;
  pub head: RequestHead;
  pub body: String;
  pub group: Option[CancelGroup];
  pub deadline: Instant;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.Reply) {
    let id, head, body, group, deadline = self.(id, head, body, group, deadline);
    let k = sv.findConn(id);
    if k >= sv.conns.bound() {
      actors.answerNow[Result[httpclient.Response, FetchError]](rp, Error[httpclient.Response, FetchError](FetchError.failed(
        httpclient.Failure.make(httpclient.Stage.Closed, 0u32, ErrorKind.Closed, "the connection names nothing"))));
      return;
    }
    let c = sv.conns.at(u32.from(k)) as &mut ConnRec;
    let slot = usize.from(sv.xwaits.add(waitFor(rp, defaultMaxBody)).index);
    let w = sv.xwaits.at(u32.from(slot)) as &mut Wait;
    w.conn = k;
    w.body = body;
    c.busy = c.busy + 1u32;
    let length = if w.body.len() > 0usize {BodyLength.sized(u64.from(w.body.len()))} else {BodyLength.empty()};
    let sink = httpconn.Sink.Here(u64.from(slot));
    match group {
      case let Some(g) {w.req = sv.drv.requestIn(lp, c.conn, head, length, sink, g, deadline);}
      else {
        if deadline < forever() {
          w.req = sv.drv.requestBy(lp, c.conn, head, length, sink, deadline);
        } else {
          w.req = sv.drv.request(lp, c.conn, head, length, sink);
        }
      }
    }
  }
}

// A Conn dropped: its connection closed (aborted, if exchanges are in flight)
struct DropConnJob {
  pub id: u64;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findConn(id);
    if k >= sv.conns.bound() {return;}
    let c = sv.conns.at(u32.from(k)) as &mut ConnRec;
    c.dropped = true;
    if c.closed {
      sv.freeConn(k);
    } else if c.busy > 0u32 {
      sv.drv.abort(lp, c.conn);
    } else {
      sv.drv.close(lp, c.conn);
    }
  }
}
