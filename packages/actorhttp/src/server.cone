// The server's side the actors hold: the handle of a listening Server, the
// Exchange each request becomes, and what they are made of (the package's
// header, A SERVER). What the service thread keeps for them is in
// serverservice.cone.

// ---------------------------------------------------------------------------
// Errors
// ---------------------------------------------------------------------------

// How a server call ended without its answer
pub enum ServerErrorKind {
  Failed,        // the listen or the TLS setup was refused: 'message' says why
  Closed;        // the server was closed, or the exchange is over (its peer left, or its response was whole)
}

// Why a server call has no answer. A peer that left is not a panic: a write
// to it answers Closed
pub struct ServerError {
  cause: ServerErrorKind;
  pub code: u32;           // Failed: the system's error number when it gave one, else 0
  text: String;

  pub fn failed(code: u32, text: &str) ServerError {ServerError(ServerErrorKind.Failed, code, String.from(text))}
  pub fn closed() ServerError {ServerError(ServerErrorKind.Closed, 0u32, String.empty())}

  pub fn kind(self: &) ServerErrorKind {cause}

  // The server or the exchange is over
  pub fn isClosed(self: &) bool {cause == ServerErrorKind.Closed}

  // 'could not listen: ... (Windows error ...)', or 'closed'
  pub fn message(self: &) String {
    if cause == ServerErrorKind.Closed {return String.from("closed");}
    var out = String.from(text.view());
    if code != 0u32 {
      out.append(" (Windows error ");
      out.appendUInt(u64.from(code));
      out.append(": ");
      out.append(IoError(code).message().view());
      out.append(")");
    }
    out
  }
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

// A server's bounds and settings (the package's header, A SERVER)
pub struct ServerConfig {
  pub conn: httpconn.Config;                // its driver's: protocol bounds and timeouts, buffers, maxConnections
  pub maxBody: usize;                       // the most request body bytes it takes (past it, 413)
  pub maxPending: usize;                    // the most requests that wait for an actor to take them (past it, 503)
  pub tlsConfig: Option[tls.ServerConfig];  // Some: every connection is TLS

  // The defaults: plain HTTP, httpconn's bounds, bodies up to 1 MiB, 1024 requests waiting
  pub fn make() ServerConfig {
    ServerConfig(httpconn.Config.make(), defaultMaxRequestBody, 1024usize, None)
  }

  // The same through TLS, with a certificate chain and a key (tls.ServerConfig's)
  pub fn secure(self, cfg: tls.ServerConfig) ServerConfig {
    var c = self;
    c.tlsConfig = Some[tls.ServerConfig](cfg);
    c
  }
}

// The most request body bytes a server takes unless it is made with another limit
pub const defaultMaxRequestBody = 1048576usize;

// ---------------------------------------------------------------------------
// A request
// ---------------------------------------------------------------------------

// The request an Exchange holds: its head (method, target, header fields, the
// Host as 'authority'), its whole body, and where it came from
pub struct Request {
  pub head: RequestHead;
  pub body: String;
  pub peer: SocketAddr;        // the client's address
  pub secure: bool;            // it came through TLS

  // The target's path: everything before a '?'
  pub fn path(self: &) &str {
    let t = head.target.view() as &Array[u8];
    var i = 0usize;
    while i < t.len && t[i] != '?' {i = i + 1usize;}
    &t[0usize ..< i] as &str
  }

  // The target's query: everything after the '?', or "" if there is none
  pub fn query(self: &) &str {
    let t = head.target.view() as &Array[u8];
    var i = 0usize;
    while i < t.len && t[i] != '?' {i = i + 1usize;}
    if i >= t.len {return "";}
    &t[i + 1usize ..] as &str
  }

  // The method's token: 'GET', or an extension's spelling
  pub fn methodName(self: &) &str {head.methodName()}

  // The first value of a header field, as text, or "" when there is none
  pub fn header(self: &, name: &str) &Array[u8] {
    match head.headers.get(name) {
      case Some(v) {v}
      case is None[&Array[u8]] {"" as &Array[u8]}
    }
  }
}

// ---------------------------------------------------------------------------
// The Server
// ---------------------------------------------------------------------------

// A listening server, as an actor holds one (the package's header, A SERVER):
// plain data naming a listener that the service thread owns, which moves, and
// which 'clone' makes another handle to. The last handle's going closes the
// server: it stops listening and refuses what waits (the exchanges already
// taken go on)
pub struct Server is Move {
  id: u64;
  addr: SocketAddr;
  tlsOn: bool;

  // A Server naming nothing, which closes nothing
  pub fn none() Server {Server(0u64, SocketAddr.localhost(0u16), false)}

  pub fn isNone(self: &) bool {id == 0u64}

  // The address it listens on (its port, if it was asked for 0)
  pub fn localAddr(self: &) SocketAddr {addr}

  pub fn port(self: &) u16 {addr.port()}

  // Whether its connections are TLS
  pub fn isSecure(self: &) bool {tlsOn}

  // Another handle to the same server
  pub fn clone(self: &) Server {
    if id != 0u64 {
      post[SrvRefJob](SrvRefJob(id, true));
    }
    Server(id, addr, tlsOn)
  }

  // The next request, whole, as an Exchange to answer; or Closed when the
  // server is closed. Any number of actors may await 'next' at once: each
  // request goes to one of them, in the order they asked. A request waits in
  // the server (up to maxPending of them) until an actor asks for it
  pub fn next(self: &) actors.Awaitable[Result[Exchange, ServerError]] {
    awaitable[NextJob, Result[Exchange, ServerError]](NextJob(id, actors.Reply()))
  }

  // Stop listening now: every 'next' waiting is answered Closed, the requests
  // that no actor took are answered 503, and the exchanges taken go on. The
  // handles stay, and name a closed server
  pub fn close(self: &) {
    if id != 0u64 {
      post[SrvCloseJob](SrvCloseJob(id));
    }
  }

  fn final(self: &uni) {
    if id != 0u64 {
      post[SrvRefJob](SrvRefJob(id, false));
    }
  }
}

// A server listening at addr, plain or through TLS as cfg says: the Server
// when it is listening, or why it could not (the address in use, a
// certificate that could not be loaded). Asking for port 0 takes any free one
pub fn listen(addr: SocketAddr, cfg: ServerConfig) actors.Awaitable[Result[Server, ServerError]] {
  awaitable[ListenJob, Result[Server, ServerError]](ListenJob(addr, cfg, actors.Reply()))
}

// ---------------------------------------------------------------------------
// An Exchange
// ---------------------------------------------------------------------------

const phaseFresh = 0u32;        // no response begun
const phaseStreaming = 1u32;    // a response begun, its body to write
const phaseOver = 2u32;         // a response whole, or all of it asked for

// One request and the response to it, as the actor that took it holds it
// (the package's header, A SERVER): plain data that moves, naming an exchange
// the service thread keeps. The program answers it exactly once: 'respond' for
// a whole response; 'start' then 'write' and 'finish' for a streamed one (a
// body of unknown length goes chunked); 'startEvents' for server-sent events.
// A call the exchange's state does not allow (a second response, a write
// before 'start', more bytes than the declared length) is a program error: a
// panic at the line of the call. A peer that left is not: it answers Closed.
// Dropping an exchange that has begun no response answers 500; one streaming
// an unsized body ends it cleanly (a stream of events closes), a sized one
// short of its length resets the connection
pub struct Exchange is Move {
  srv: u64;
  slot: u32;
  id: u64;
  phase: u32;
  sized: bool;                   // the response body's length is declared
  length: u64;                   // ...and is this
  written: u64;                  // body bytes asked for so far
  bodyless: bool;                // the response has no body bytes (HEAD, 204, 304, a length of 0)
  pub request: Request;

  // A whole response: the head (status 200 to 599; the framing fields are the
  // core's to write) and the body, '' for none. Not awaited: the response is
  // written as the connection takes it
  pub fn respond(self: &mut, head: ResponseHead, body: String, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    checkResponseHead(&head, file, line);
    if phase != phaseFresh {die("actorhttp: this exchange has been answered already", file, line);}
    phase = phaseOver;
    written = u64.from(body.len());
    post[RespondJob](RespondJob(srv, slot, id, head, body));
  }

  // A whole response of text: the status, a Content-Type of text/plain
  pub fn text(self: &mut, status: u16, body: &str, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    var h = ResponseHead.make(status);
    h.headers.add("Content-Type", "text/plain; charset=utf-8");
    self.respond(h, String.from(body), file, line);
  }

  // Begin a streamed response: its head, and its body's length (sized: exactly
  // that many bytes, by 'write'; unsized: chunked; empty: none, the response
  // is whole). Then 'write' and 'finish'. Not awaited
  pub fn start(self: &mut, head: ResponseHead, framing: BodyLength, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    checkResponseHead(&head, file, line);
    if phase != phaseFresh {die("actorhttp: this exchange has been answered already", file, line);}
    sized = framing.isSized();
    length = framing.length;
    let st = head.status;
    let none = framing.isEmpty() || (framing.isSized() && framing.length == 0u64);
    bodyless = request.head.method == Method.Head || st == 204u16 || st == 304u16 || none;
    phase = if none {phaseOver} else {phaseStreaming};
    post[StartJob](StartJob(srv, slot, id, head, framing));
  }

  // Begin a stream of server-sent events: 200, 'Content-Type: text/event-stream',
  // 'Cache-Control: no-cache', chunked. Then 'sendEvent' and 'sendComment',
  // and 'finish' (or drop the Exchange) to end the stream
  pub fn startEvents(self: &mut, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    self.startEventsWith(ResponseHead.make(200u16), file, line);
  }

  // The same with a head of the program's: its Content-Type and Cache-Control
  // are set unless it has them
  pub fn startEventsWith(self: &mut, head: ResponseHead, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    var h = head;
    if !h.headers.has("Content-Type") {h.headers.add("Content-Type", "text/event-stream");}
    if !h.headers.has("Cache-Control") {h.headers.add("Cache-Control", "no-cache");}
    self.start(h, BodyLength.unsized(), file, line);
  }

  // Body bytes: answered with their count when the connection has taken them
  // all (so a program that awaits each write is slowed to its peer's speed),
  // or Closed when the peer has left. A response to a HEAD, or a 204 or 304,
  // takes none: the answer is 0
  pub fn write(self: &mut, data: String, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[usize, ServerError]] {
    if phase != phaseStreaming {die("actorhttp: write needs a response begun by 'start' and not yet finished", file, line);}
    if sized && written + u64.from(data.len()) > length {
      die("actorhttp: write past the length 'start' declared", file, line);
    }
    written = written + u64.from(data.len());
    awaitable[WriteJob, Result[usize, ServerError]](WriteJob(srv, slot, id, data, actors.Reply()))
  }

  // One server-sent event, written (a 'write' of its bytes)
  pub fn sendEvent(self: &mut, ev: &sse.Event, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[usize, ServerError]] {
    self.write(ev.encode(), file, line)
  }

  // A comment block, the heartbeat that keeps a quiet stream from idling out
  pub fn sendComment(self: &mut, text: &str, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[usize, ServerError]] {
    self.write(sse.comment(text), file, line)
  }

  // The body is whole: answered with the body's byte count once the response
  // has gone to the connection whole, or Closed if the peer left first
  pub fn finish(self: &mut, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[u64, ServerError]] {
    if phase != phaseStreaming {die("actorhttp: finish needs a response begun by 'start' and not yet finished", file, line);}
    if sized && written != length {die("actorhttp: finish short of the length 'start' declared", file, line);}
    phase = phaseOver;
    awaitable[FinishJob, Result[u64, ServerError]](FinishJob(srv, slot, id, actors.Reply()))
  }

  // Whether a response has been begun
  pub fn isAnswered(self: &) bool {phase != phaseFresh}

  fn final(self: &uni) {
    post[DropExJob](DropExJob(srv, slot, id));
  }
}

// What the core would panic at in a response head, found where the call is made
fn checkResponseHead(h: &ResponseHead, file: &Array[u8], line: u32) {
  if h.status < 200u16 || h.status > 599u16 {die("actorhttp: a response takes a final status, 200 to 599", file, line);}
  if h.headers.has("Content-Length") || h.headers.has("Transfer-Encoding") {
    die("actorhttp: framing fields are the core's to write; a body's length is said with a BodyLength", file, line);
  }
}
