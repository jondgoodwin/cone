// A request's body as a stream the handler reads (ServerConfig.streamBodies, 'Exchange.body()'): the handle
// (RequestBody), the source the sink it chooses gives its buffers back to (ReqSource), the sink 'readAll'
// uses (GatherSink), and the service thread's jobs for them. The request's record on the service thread
// (an ExRec's 'in...' fields, serverservice.cone) lends the connection's receive buffers to the sink as a
// client response body is lent (lend.cone): the credit of a buffer returns to the connection or stream
// when the sink gives it back, so a sink that is slow holds the peer back at its window and the server
// never holds more.
//
// THE CHOICE. The body is staged from the request's head (the peer stops at its credit window, nothing
// being given back) until the handler's first 'read', 'to' or 'readAll', which is the choice: the sink is
// attached, the staged bytes go to it in order, and the 'Expect: 100-continue' a client waits on is answered
// then (not before, so a handler that answers 413 without reading is never sent the body).
//
// NOT WANTED. A RequestBody dropped unchosen, or an Exchange dropped whose body was never taken, lets the
// rest go: what is staged is released and the bytes still to come are released as they arrive. HTTP/1.1
// closes the connection after the answer when the body is unfinished (the core's); an HTTP/2 or HTTP/3
// stream is left to run on, its tail read and dropped, until the client ends it (the core does not reset it
// when the response is whole).
//
// STOP. The sink answers its source's 'stop': the first reason is the sink's one end, the staged bytes go,
// and the request is cancelled on the wire (HTTP/1.1 closes, HTTP/2 RST_STREAM, HTTP/3 resets). The one
// exception is 'readAll' past its limit: the server answers 413 itself, as a gathered request over
// 'maxBody' gets, and discards the rest.

// How a body longer than 'readAll''s limit ends
fn bodyLimitError() FetchError {
  FetchError.failed(httpclient.Failure.make(httpclient.Stage.Limit, 0u32,
    ErrorKind.TooLarge, "the request body is longer than the limit readAll was given"))
}

// Whether a stop's reason is that one
fn isBodyLimit(why: &Ending) bool {
  match why {
    case let &Failed(e) {
      match e.downcastRef[FetchError]() {
        case let Some(fe) {
          fe.kind() == FetchErrorKind.Failed && fe.failure.stage == httpclient.Stage.Limit &&
            fe.failure.error.kind == ErrorKind.TooLarge
        }
        else {false}
      }
    }
    else {false}
  }
}

// A request's body being read, piece by piece or sent to a sink. Dropping it before the choice lets the
// rest of the body go
pub struct RequestBody is Move {
  reader: ReaderSink[Result[Option[String], FetchError]];
  choice: Atomic[u8];        // bodyUnchosen until 'read', 'to' or 'readAll' (stream.cone's constants)
  srv: u64;
  slot: u32;
  id: u64;

  fn make(srv: u64, slot: u32, id: u64) RequestBody {
    RequestBody(ReaderSink[Result[Option[String], FetchError]](&bodyChunk, &bodyEnd), Atomic[u8].of(bodyUnchosen), srv, slot, id)
  }

  // The next piece of the body (the bytes of one receive: any size), or None when the body is whole; or why it
  // ended otherwise. A piece is released to the connection as it is taken, so a handler that awaits slowly
  // slows the sender. The first read is the choice (and answers 'Expect: 100-continue')
  pub fn read(self: &) actors.Awaitable[Result[Option[String], FetchError]] {
    if choice.load() == bodyUnchosen {
      if choice.swap(bodyRead) == bodyUnchosen {
        post[ReqChoiceJob](ReqChoiceJob(srv, slot, id, Some[ChunkSink](reader.clone())));
      }
    }
    readSink[Result[Option[String], FetchError]](&reader)
  }

  // The body sent to a sink: the sink is told its source, then gets the body's pieces, then the one end. The
  // sink's buffers are the connection's own window; one that gives them back slowly slows the sender. A body
  // already chosen cannot be sent: the sink is ended Failed
  pub fn to(self, sink: ChunkSink) {
    if choice.swap(bodyTo) == bodyUnchosen {
      post[ReqChoiceJob](ReqChoiceJob(srv, slot, id, Some[ChunkSink](sink)));
    } else {
      sink.end(Ending.Failed(AnyError.msg("the body was chosen already, it cannot be sent to a sink")));
    }
  }

  // The whole body, as a String, unless it passes 'limit': then the server answers 413 itself (the answer a
  // gathered request over maxBody gets), discards the rest, and this is the Err (a Limit failure). The Err
  // is also what a peer that left, or a body already chosen, gives
  pub fn readAll(self, limit: usize) actors.Awaitable[Result[String, FetchError]] {
    let g = GatherSink(limit);
    if choice.swap(bodyTo) == bodyUnchosen {
      post[ReqChoiceJob](ReqChoiceJob(srv, slot, id, Some[ChunkSink](g.clone())));
    } else {
      g.end(Ending.Failed(AnyError.msg("the body was chosen already, it cannot be read whole")));
    }
    let h = g.clone();
    actors.Awaitable[Result[String, FetchError]].make(
      fn(rp: actors.ReplyOf[Result[String, FetchError]]) [h] {
        h.want(rp);
      })
  }

  fn final(self: &uni) {
    let c = choice.load();
    // a body unchosen, or being read, is no longer wanted; one sent 'to' a sink is the sink's
    if c != bodyTo {post[ReqDropJob](ReqDropJob(srv, slot, id));}
  }
}

// The source a request body's sink gives its buffers back to. A buffer given back releases to the connection
// what the record says was lent in it (known by its address); 'stop' ends the receive
actor ReqSource is ChunkSource {
  srv: u64;
  slot: u32;
  id: u64;

  pub fn init(self: &new, srv: u64, slot: u32, id: u64) {
    *self = Self(srv: srv, slot: slot, id: id);
  }

  pub async fn giveBack(self, b: IoBuf) {
    post[ReqReleaseJob](ReqReleaseJob(srv, slot, id, b));
  }

  // The first reason is the sink's one end; later stops, and one after the end, do nothing
  pub async fn stop(self, why: Ending) {
    post[ReqStopJob](ReqStopJob(srv, slot, id, Some[Ending](why)));
  }
}

// The sink 'readAll' uses: the pieces gathered up to the limit, each buffer given back as it is copied
actor GatherSink is ChunkSink {
  up: Option[ChunkSource];
  body: String;
  limit: usize;
  over: bool;                // a piece passed the limit and the source was stopped for it
  ended: Option[Ending];
  waiting: Option[actors.ReplyOf[Result[String, FetchError]]];

  pub fn init(self: &new, limit: usize) {
    *self = Self(up: None[ChunkSource], body: String(), limit: limit, over: false, ended: None[Ending],
      waiting: None[actors.ReplyOf[Result[String, FetchError]]]);
  }

  pub async fn attach(self, source: ChunkSource) {
    up = Some[ChunkSource](source);
  }

  pub async fn accept(self, c: IoBuf) {
    if !over && !streams.gather(&mut body, c.view(), limit) {
      over = true;
      match &up {
        case let &Some(u) {u.stop(Ending.Failed(AnyError.from(bodyLimitError())));}
        else {}
      }
    }
    match &up {
      case let &Some(u) {u.giveBack(c);}
      else {}
    }
  }

  pub async fn end(self, how: Ending) {
    up = None[ChunkSource];
    ended = Some[Ending](how);
    self.serve();
  }

  pub async fn want(self, rp: actors.ReplyOf[Result[String, FetchError]]) {
    if waiting is Some {
      rp.answer(Err[String, FetchError](FetchError.cancelled()));
      return;
    }
    waiting = Some[actors.ReplyOf[Result[String, FetchError]]](rp);
    self.serve();
  }

  fn serve(self) {
    if waiting is None {return;}
    var answer: Option[Result[String, FetchError]] = None;
    match &ended {
      case let &Some(how) {
        match how {
          case is Finished {
            var out = String();
            out <-> body;
            answer = Some[Result[String, FetchError]](Ok[String, FetchError](out));
          }
          case let &Failed(e) {
            answer = Some[Result[String, FetchError]](Err[String, FetchError](errorOfEnding(e)));
          }
        }
      }
      else {}
    }
    match answer {
      case let Some(v) {
        var taken: Option[actors.ReplyOf[Result[String, FetchError]]] = None;
        taken <-> waiting;
        match taken {
          case let Some(r) {r.answer(v);}
          else {}
        }
      }
      else {}
    }
  }
}

// ---------------------------------------------------------------------------
// The jobs
// ---------------------------------------------------------------------------

// A request's record freed once nothing is left to use it: the exchange is over, no Exchange names it, and no
// body is waiting on the handler's choice
fn inFreeIfDone(s: &mut SrvRec, x: &ExRec, slot: u32) {
  if x.over && !x.handle && !x.inAwait {freeEx(s, usize.from(slot));}
}

// The handler chose (a sink: its 'read' made the ReaderSink the sink, its 'to' gave one). The sink is told
// its source, gets the staged pieces in order (as its window allows; the rest follow as buffers come back),
// then the end if one was kept. A 100 Continue the client waits on is sent now
struct ReqChoiceJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub sink: Option[ChunkSink];

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    var sk = None[ChunkSink];
    sk <-> sink;
    let loc = locate(sv, srv, slot, id);
    match sk {
      case let Some(snk) {
        // the request is gone, or the body was chosen already or let go: the sink's one end says so
        if loc.ex as usize == 0usize || !(loc.ex as &ExRec).inAwait {
          snk.end(Ending.Failed(AnyError.from(FetchError.cancelled())));
          return;
        }
        let s = loc.srv as &mut SrvRec;
        let x = loc.ex as &mut ExRec;
        x.inAwait = false;
        x.inSink = Some[ChunkSink](snk.clone());
        snk.attach(ReqSource(srv, slot, id));
        if x.inContinue {
          x.inContinue = false;
          if !x.responded && !x.inEnded && !x.over {sendContinue(s, x);}
        }
        drainStaged(&mut x.inLend, &x.inSink);
        var how = None[Ending];
        how <-> x.inKept;
        match how {
          case let Some(h) {inFinish(x, h);}
          else {}
        }
        inFreeIfDone(s, x, slot);
      }
      else {}
    }
  }
}

// The RequestBody was dropped: unchosen, or while being read. The rest is not wanted
struct ReqDropJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {return;}
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    if x.inAwait {
      inDiscarded(s, x);
    } else {
      // the reader is gone with what it held: its buffers will not come back
      var gone = None[ChunkSink];
      gone <-> x.inSink;
      x.inDiscard = true;
      let n = lendDiscard(&mut x.inLend) + lendAbandon(&mut x.inLend);
      inRelease(s, x, n);
    }
    inFreeIfDone(s, x, slot);
  }
}

// A buffer given back to the request's source: the bytes the record says were lent in it are released to
// the connection or stream. The buffer is known by its address, which a sink that trims it leaves as it was;
// the job carries the buffer itself, which dies on this thread after the record is cleared
struct ReqReleaseJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub buf: IoBuf;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {return;}
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    let m = lendReturn(&mut x.inLend, buf.base() as usize);
    inRelease(s, x, m);
    drainStaged(&mut x.inLend, &x.inSink);
  }
}

// The sink stopped its source: the first reason is the sink's end, what is staged goes, and the request is
// ended on the wire. A stop after the end, or when the sink is not chosen, does nothing
struct ReqStopJob {
  pub srv: u64;
  pub slot: u32;
  pub id: u64;
  pub why: Option[Ending];

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    var w = None[Ending];
    w <-> why;
    let loc = locate(sv, srv, slot, id);
    if loc.ex as usize == 0usize {return;}
    let s = loc.srv as &mut SrvRec;
    let x = loc.ex as &mut ExRec;
    if !(x.inSink is Some) {return;}
    match w {
      case let Some(ww) {
        let limit = isBodyLimit(&ww);
        var held = None[ChunkSink];
        held <-> x.inSink;
        match held {
          case let Some(sk) {sk.end(ww);}
          else {}
        }
        x.inDiscard = true;
        let n = lendDiscard(&mut x.inLend);
        inRelease(s, x, n);
        if x.over {return;}
        if limit && !x.responded && !x.rejected {
          x.rejected = true;
          answerText(s, x, 413u16, "the request body is too large", true);
        } else {
          srvCancel(s, lp, x);
        }
      }
      else {}
    }
  }
}
