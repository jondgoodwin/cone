// The service thread's side of the streams: the record kept for each response
// an actor reads as it arrives, how a fetch's events feed it, and the jobs
// the stream handles post (actorhttp.cone's header, STREAMS).

// Events or chunks held for a reader before the connection is told to stop
// sending (the bytes behind them are not released until the queue has room)
const streamQueueHigh = 64usize;

// A response read as it arrives: its pieces waiting for the actor, and the
// actor waiting for a piece
struct StreamRec {
  used: bool;
  id: u64;
  asEvents: bool;                  // read as events (else as chunks of bytes)
  fetch: httpclient.FetchId;
  // The answer to 'stream', 'events' or 'streamTo', until the head arrives: the
  // one that is Some is the one this stream was opened for, and each is
  // typed by what it answers
  openBody: Option[actors.ReplyOf[Result[BodyStream, FetchError]]];
  openEvents: Option[actors.ReplyOf[Result[EventStream, FetchError]]];
  openHead: Option[actors.ReplyOf[Result[BodyHead, FetchError]]];
  status: u16;
  reader: sse.Reader;
  events: Deque[sse.Event];        // parsed events, waiting for the actor
  chunks: Deque[String];           // body pieces, waiting for the actor
  owed: usize;                     // body bytes taken from the client but not yet released
  ended: bool;                     // the fetch's final answer has come
  outcome: httpclient.EventKind;   // ...and what it was
  failure: Option[httpclient.Failure];   // ...why, when it Failed
  limited: bool;                   // an event passed the reader's limit and the fetch was cancelled for it
  readText: Option[actors.ReplyOf[Result[Option[String], FetchError]]];   // an actor awaiting the next piece of a body
  readEvent: Option[actors.ReplyOf[Result[Option[sse.Event], FetchError]]];  // ...or the next event
  gone: bool;                      // its handle has gone
  sink: Option[ChunkSink];         // the body goes to this sink (Client.streamTo), not to a reader
  lent: Dict[usize, usize];        // ...each buffer sent to it and not yet given back: its address, the bytes it held when sent.
                                   // Sound as a key because the release job carries the buffer and clears the record before the
                                   // buffer dies, so a block cannot be reissued while a record of it stands
}

// A stream opening, its fetch not yet sent: the caller puts its reply in the
// one open field that answers its type
fn openingStream(id: u64, asEvents: bool) StreamRec {
  StreamRec(used: true, id: id, asEvents: asEvents, fetch: httpclient.FetchId.none(),
    openBody: None, openEvents: None, openHead: None, status: 0u16, reader: sse.Reader.make(), events: Deque[sse.Event](),
    chunks: Deque[String](), owed: 0usize, ended: false, outcome: httpclient.EventKind.Done, failure: None,
    limited: false, readText: None, readEvent: None, gone: false, sink: None, lent: Dict[usize, usize]())
}

// A reply kept in a stream's record answered in place, and let go
fn answerKept[R](kept: &mut Option[actors.ReplyOf[R]], v: R) {
  var taken: Option[actors.ReplyOf[R]] = None;
  taken <-> *kept;
  match taken {
    case let Some(r) {r.answer(v);}
    else {}
  }
}

// Whether an actor is awaiting a piece
fn reading(s: &StreamRec) bool {
  s.readText is Some || s.readEvent is Some
}

// Where the live stream is (its slot's record), or null
fn streamOf(rec: &ClientRec, slot: u32, id: u64) *StreamRec {
  let x = rec.streams.at(slot);
  if x as usize != 0usize && (*x).used && (*x).id == id {return x;}
  null
}

fn freeStream(rec: &mut ClientRec, slot: usize) {
  rec.streams.removeAt(u32.from(slot));
}

// A handle to a client dropped: the last one's going ends the client, every
// fetch of it answered Cancelled, its connections reset
fn unrefClient(rec: &mut ClientRec, lp: &mut Loop) {
  rec.refs = rec.refs - 1u32;
  if rec.refs == 0u32 {
    rec.dying = true;
    rec.client.abortAll(lp);
  }
}

// How a stream's reads end once its pieces are all taken: None for a clean
// end, else the error
fn endOf[T](s: &StreamRec) Result[Option[T], FetchError] {
  let k = s.outcome;
  if s.limited {
    return Err[Option[T], FetchError](FetchError.failed(httpclient.Failure.make(httpclient.Stage.Limit, 0u32,
      ErrorKind.TooLarge, "an event is longer than the reader's limit")));
  }
  if k == httpclient.EventKind.Done {
    Ok[Option[T], FetchError](None)
  } else if k == httpclient.EventKind.Failed {
    match &s.failure {
      case let &Some(f) {Err[Option[T], FetchError](FetchError.failed(f.clone()))}
      else {Err[Option[T], FetchError](FetchError.cancelled())}
    }
  } else if k == httpclient.EventKind.TimedOut {
    Err[Option[T], FetchError](FetchError.timedOut())
  } else {
    Err[Option[T], FetchError](FetchError.cancelled())
  }
}

// The queue holds enough: the client is not told to send more yet
fn queued(s: &StreamRec) usize {
  if s.asEvents {s.events.len()} else {s.chunks.len()}
}

// Release the body bytes owed to the client, once the queue has room
fn releaseOwed(rec: &mut ClientRec, s: &mut StreamRec) {
  if s.owed > 0usize && !s.ended && queued(s) < streamQueueHigh {
    rec.client.release(s.fetch, s.owed);
    s.owed = 0usize;
  }
}

// An actor awaiting a piece gets the next, or the end
fn serveRead(rec: &mut ClientRec, s: &mut StreamRec) {
  if !reading(s) {return;}
  if s.asEvents {
    match s.events.popFront() {
      case var Some(ev) {
        answerKept[Result[Option[sse.Event], FetchError]](&mut s.readEvent,
          Ok[Option[sse.Event], FetchError](Some[sse.Event](ev)));
        releaseOwed(rec, s);
      }
      else {
        if s.ended {answerKept[Result[Option[sse.Event], FetchError]](&mut s.readEvent, endOf[sse.Event](s));}
      }
    }
  } else {
    match s.chunks.popFront() {
      case var Some(piece) {
        answerKept[Result[Option[String], FetchError]](&mut s.readText,
          Ok[Option[String], FetchError](Some[String](piece)));
        releaseOwed(rec, s);
      }
      else {
        if s.ended {answerKept[Result[Option[String], FetchError]](&mut s.readText, endOf[String](s));}
      }
    }
  }
}

// An event of a stream's fetch (its slot sslot), taken by value: the head's
// fields go whole into the stream the actor is given
fn onStreamEvent(rec: &mut ClientRec, lp: &mut Loop, e: httpclient.Event, sslot: usize) {
  let s = rec.streams.at(u32.from(sslot)) as &mut StreamRec;
  if s.sink is Some {
    onSinkEvent(rec, lp, e, sslot);
    return;
  }
  let k = e.kind;
  if k == httpclient.EventKind.Response {
    let response, url = e.(response, url);
    let status, version, headers = response.(status, version, headers);
    s.status = status;
    if s.asEvents {
      answerKept[Result[EventStream, FetchError]](&mut s.openEvents, Ok[EventStream, FetchError](
        EventStream(rec.id, u32.from(sslot), s.id, status, version, headers, url)));
    } else {
      answerKept[Result[BodyStream, FetchError]](&mut s.openBody, Ok[BodyStream, FetchError](
        BodyStream(rec.id, u32.from(sslot), s.id, status, version, headers, url)));
    }
  } else if k == httpclient.EventKind.Data {
    let n = e.buf.len();
    if s.gone || s.limited {
      rec.client.release(e.id, n);
    } else {
      if s.asEvents {
        // The reader hands its events on in a list of its own; they join the queue
        var got = List[sse.Event]();
        s.reader.feed(e.buf.view(), &mut got);
        each ev in got.drain() {s.events.push(ev);}
        if s.reader.overflowed() {
          s.limited = true;
          rec.client.cancel(lp, s.fetch);
        }
      } else {
        s.chunks.push(String.fromBytes(e.buf.view()));
      }
      s.owed = s.owed + n;
      serveRead(rec, s);
      releaseOwed(rec, s);
    }
  } else if e.isTerminal() {
    s.ended = true;
    s.outcome = k;
    s.owed = 0usize;
    if k == httpclient.EventKind.Failed {s.failure = Some[httpclient.Failure](e.failure.clone());}
    if s.openBody is Some || s.openEvents is Some {
      let err = if k == httpclient.EventKind.Failed {FetchError.failed(e.failure.clone())}
        else if k == httpclient.EventKind.TimedOut {FetchError.timedOut()}
        else {FetchError.cancelled()};
      if s.asEvents {
        answerKept[Result[EventStream, FetchError]](&mut s.openEvents, Err[EventStream, FetchError](err));
      } else {
        answerKept[Result[BodyStream, FetchError]](&mut s.openBody, Err[BodyStream, FetchError](err));
      }
    }
    serveRead(rec, s);
    if s.gone {freeStream(rec, sslot);}
  }
}

// How a fetch's final answer k, other than Done, is told to those waiting on it
fn endError(k: httpclient.EventKind, f: &httpclient.Failure) FetchError {
  if k == httpclient.EventKind.Failed {FetchError.failed(f.clone())}
  else if k == httpclient.EventKind.TimedOut {FetchError.timedOut()}
  else {FetchError.cancelled()}
}

// An event of a fetch whose body goes to a sink: the head answers the caller's
// 'await'; each piece is sent on as it is, the IoBuf moved and its bytes held
// from the client until the sink gives the buffer back; the final answer is the
// sink's one 'end' (and a failure before the head is the caller's Err too)
fn onSinkEvent(rec: &mut ClientRec, lp: &mut Loop, e: httpclient.Event, sslot: usize) {
  let s = rec.streams.at(u32.from(sslot)) as &mut StreamRec;
  let k = e.kind;
  if k == httpclient.EventKind.Response {
    let response, url = e.(response, url);
    let status, version, headers = response.(status, version, headers);
    s.status = status;
    answerKept[Result[BodyHead, FetchError]](&mut s.openHead,
      Ok[BodyHead, FetchError](BodyHead(status, version, headers, url)));
  } else if k == httpclient.EventKind.Data {
    let buf, kind = e.(buf, kind);
    let n = buf.len();
    if n == 0usize {return;}
    let at = buf.base() as usize;
    let before = s.lent.getCopy(&at) || 0usize;
    if before > 0usize {lentMergeCount.add(1u64);}
    s.lent.insert(at, before + n);
    match &s.sink {
      case let &Some(sk) {sk.accept(buf);}
      else {}
    }
  } else if e.isTerminal() {
    if s.openHead is Some {
      answerKept[Result[BodyHead, FetchError]](&mut s.openHead, Err[BodyHead, FetchError](endError(k, &e.failure)));
    }
    // the end is the last thing sent to the sink, so the record lets go of it with it
    var held = None[ChunkSink];
    held <-> s.sink;
    match held {
      case let Some(sk) {
        if k == httpclient.EventKind.Done {sk.end(Ending.Finished);}
        else {sk.end(Ending.Failed(AnyError.from(endError(k, &e.failure))));}
      }
      else {}
    }
    freeStream(rec, sslot);
    unrefClient(rec, lp);
  }
}

// ---------------------------------------------------------------------------
// The jobs
// ---------------------------------------------------------------------------

// A fetch whose response an actor reads as it comes, as chunks of bytes: the
// request; the head's arrival answers the reply the 'await' gives
struct StreamOpenJob {
  pub id: u64;
  pub req: httpclient.Request;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[BodyStream, FetchError]]) {
    let id, req = self.(id, req);
    let k = sv.findClient(id);
    if k >= sv.clients.bound() {
      rp.answer(Err[BodyStream, FetchError](FetchError.cancelled()));
      return;
    }
    let rec = sv.clientAt(k) as &mut ClientRec;
    var st = openingStream(newId(), false);
    st.openBody = Some[actors.ReplyOf[Result[BodyStream, FetchError]]](rp);
    let sslot = usize.from(rec.streams.add(st).index);
    rec.refs = rec.refs + 1u32;
    let fetch = rec.client.send(lp, req, httpclient.Sink.Here(streamBit | u64.from(sslot)));
    (rec.streams.at(u32.from(sslot)) as &mut StreamRec).fetch = fetch;
  }
}

// The same as server-sent events
struct EventOpenJob {
  pub id: u64;
  pub req: httpclient.Request;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[EventStream, FetchError]]) {
    let id, req = self.(id, req);
    let k = sv.findClient(id);
    if k >= sv.clients.bound() {
      rp.answer(Err[EventStream, FetchError](FetchError.cancelled()));
      return;
    }
    let rec = sv.clientAt(k) as &mut ClientRec;
    var st = openingStream(newId(), true);
    st.openEvents = Some[actors.ReplyOf[Result[EventStream, FetchError]]](rp);
    let sslot = usize.from(rec.streams.add(st).index);
    rec.refs = rec.refs + 1u32;
    let fetch = rec.client.send(lp, req, httpclient.Sink.Here(streamBit | u64.from(sslot)));
    (rec.streams.at(u32.from(sslot)) as &mut StreamRec).fetch = fetch;
  }
}

// The next piece of a body stream, for the reply the 'await' gives
struct StreamReadJob {
  pub client: u64;
  pub slot: u32;
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[Option[String], FetchError]]) {
    let client, slot, id = self.(client, slot, id);
    let k = sv.findClient(client);
    var s = null as *StreamRec;
    if k < sv.clients.bound() {
      s = streamOf(sv.clientAt(k) as &ClientRec, slot, id);
    }
    if s as usize == 0usize || reading(s as &StreamRec) {
      // No such stream; or one read at a time: a second is refused
      rp.answer(Err[Option[String], FetchError](FetchError.cancelled()));
      return;
    }
    let rec = sv.clientAt(k) as &mut ClientRec;
    let st = s as &mut StreamRec;
    st.readText = Some[actors.ReplyOf[Result[Option[String], FetchError]]](rp);
    serveRead(rec, st);
  }
}

// The next event of an event stream
struct EventReadJob {
  pub client: u64;
  pub slot: u32;
  pub id: u64;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[Option[sse.Event], FetchError]]) {
    let client, slot, id = self.(client, slot, id);
    let k = sv.findClient(client);
    var s = null as *StreamRec;
    if k < sv.clients.bound() {
      s = streamOf(sv.clientAt(k) as &ClientRec, slot, id);
    }
    if s as usize == 0usize || reading(s as &StreamRec) {
      rp.answer(Err[Option[sse.Event], FetchError](FetchError.cancelled()));
      return;
    }
    let rec = sv.clientAt(k) as &mut ClientRec;
    let st = s as &mut StreamRec;
    st.readEvent = Some[actors.ReplyOf[Result[Option[sse.Event], FetchError]]](rp);
    serveRead(rec, st);
  }
}

// A stream's handle dropped: the rest of the fetch is cancelled, and the
// client loses the hold the stream had on it
struct StreamDropJob {
  pub client: u64;
  pub slot: u32;
  pub id: u64;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findClient(client);
    if k >= sv.clients.bound() {return;}
    let rec = sv.clientAt(k) as &mut ClientRec;
    let s = streamOf(rec as &ClientRec, slot, id);
    if s as usize == 0usize {return;}
    let st = s as &mut StreamRec;
    st.gone = true;
    if st.ended {
      freeStream(rec, usize.from(slot));
    } else {
      rec.client.cancel(lp, st.fetch);
    }
    unrefClient(rec, lp);
  }
}

// A fetch whose body goes to a sink: the request and the sink; the head's
// arrival answers the reply the 'await' gives. The sink is told its source
// first (attach), then gets the chunks, then the one end
struct StreamToJob {
  pub id: u64;
  pub req: httpclient.Request;
  pub sink: ChunkSink;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[BodyHead, FetchError]]) {
    let id, req, sink = self.(id, req, sink);
    let k = sv.findClient(id);
    if k >= sv.clients.bound() {
      rp.answer(Err[BodyHead, FetchError](FetchError.cancelled()));
      sink.end(Ending.Failed(AnyError.from(FetchError.cancelled())));
      return;
    }
    let rec = sv.clientAt(k) as &mut ClientRec;
    var st = openingStream(newId(), false);
    st.openHead = Some[actors.ReplyOf[Result[BodyHead, FetchError]]](rp);
    st.sink = Some[ChunkSink](sink);
    let sid = st.id;
    let sslot = usize.from(rec.streams.add(st).index);
    rec.refs = rec.refs + 1u32;
    sink.attach(BodySource(rec.id, u32.from(sslot), sid));
    let fetch = rec.client.send(lp, req, httpclient.Sink.Here(streamBit | u64.from(sslot)));
    (rec.streams.at(u32.from(sslot)) as &mut StreamRec).fetch = fetch;
  }
}

// A buffer given back to a body source: the bytes the record says were lent in
// it are released to the client. The buffer is known by its address, which a
// sink that trims it (setLen) leaves as it was; a buffer the record does not
// hold (not this fetch's) releases nothing. The job carries the buffer itself:
// it dies when the job does, on this thread, after the record is cleared (and
// also when the job is dropped unrun), so its block is never reissued while a
// record of it stands
struct StreamReleaseJob {
  pub client: u64;
  pub slot: u32;
  pub id: u64;
  pub buf: IoBuf;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findClient(client);
    if k >= sv.clients.bound() {return;}
    let rec = sv.clientAt(k) as &mut ClientRec;
    let s = streamOf(rec as &ClientRec, slot, id);
    if s as usize == 0usize {return;}
    let st = s as &mut StreamRec;
    let at = buf.base() as usize;
    let m = st.lent.remove(&at) || 0usize;
    if m > 0usize {rec.client.release(st.fetch, m);}
  }
}

// A buffer came back in a cancelled group: the fetch is ended
struct StreamCancelJob {
  pub client: u64;
  pub slot: u32;
  pub id: u64;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findClient(client);
    if k >= sv.clients.bound() {return;}
    let rec = sv.clientAt(k) as &mut ClientRec;
    let s = streamOf(rec as &ClientRec, slot, id);
    if s as usize == 0usize {return;}
    rec.client.cancel(lp, (s as &StreamRec).fetch);
  }
}
