// The service thread's side of the streams: the record kept for each response
// an actor reads as it arrives, how a fetch's events feed its sink, and the
// jobs the stream calls post (actorhttp.cone's header, STREAMS). Every stream is
// a body sent to a sink: 'stream' to a stages.ReaderSink the BodyStream reads,
// 'events' to an SseParseStage feeding the reader the EventStream reads, 'streamTo' to the caller's.
// The reading queue, the credit rule and the cancel of a handle dropped are the
// sinks' and the cancel group's.

// A response going to a sink
struct StreamRec {
  used: bool;
  id: u64;
  fetch: httpclient.FetchId;
  // The answer to 'stream', 'events' or 'streamTo', until the head arrives: the
  // one that is Some is the one this stream was opened for, and each is
  // typed by what it answers
  openBody: Option[actors.ReplyOf[Result[BodyStream, FetchError]]];
  openEvents: Option[actors.ReplyOf[Result[EventStream, FetchError]]];
  openHead: Option[actors.ReplyOf[Result[BodyHead, FetchError]]];
  // What the handle answered to 'stream' or 'events' is made of, taken when the head arrives
  bodyReader: Option[ReaderSink[Result[Option[String], FetchError]]];
  eventReader: Option[ValueReader[sse.Event, Result[Option[sse.Event], FetchError]]];
  group: Option[CancelGroup];      // cancelled when the handle is dropped
  status: u16;
  sink: Option[ChunkSink];         // the body goes to this sink
  // The buffers lent to the sink and the bytes staged behind its window (lend.cone). A terminal event sends what is
  // still staged, in order, ahead of the end (the sink may never give a buffer back once its reader is gone, so the
  // end cannot wait on that). 'refused' says the pool would not give a staging buffer: the fetch is ending Overloaded
  lend: BodyLend;
  refused: bool;
  // A BodyStream's body waits for the caller's choice ('read' or 'to'): until then 'sink' is None, every piece
  // is staged (the peer stops at its credit window, since nothing is given back), and a terminal event is
  // kept in 'kept' for the choice. 'abandoned': the BodyStream was dropped unchosen, so the end frees the record
  awaiting: bool;
  kept: Option[Ending];
  abandoned: bool;
  // The reason a consumer stopped the stream (BodySource.stop): the end carries it if the fetch ends cancelled
  stopWhy: Option[Ending];
  // An upload's request body, fed by a sink (upload.cone); 'on' is false for every other stream
  up: UpState;
}

// A stream opening, its fetch not yet sent: the caller puts its reply in the
// one open field that answers its type
fn openingStream(id: u64) StreamRec {
  StreamRec(used: true, id: id, fetch: httpclient.FetchId.none(),
    openBody: None[actors.ReplyOf[Result[BodyStream, FetchError]]],
    openEvents: None[actors.ReplyOf[Result[EventStream, FetchError]]],
    openHead: None[actors.ReplyOf[Result[BodyHead, FetchError]]],
    bodyReader: None[ReaderSink[Result[Option[String], FetchError]]], eventReader: None[ValueReader[sse.Event, Result[Option[sse.Event], FetchError]]], group: None[CancelGroup],
    status: 0u16, sink: None[ChunkSink], lend: newLend(),
    refused: false, awaiting: false, kept: None[Ending], abandoned: false, stopWhy: None[Ending],
    up: UpState.idle())
}

// A reply kept in a stream's record answered in place, and let go
fn answerKept[R](kept: &mut Option[actors.ReplyOf[R]], v: R) {
  var taken: Option[actors.ReplyOf[R]] = None;
  taken <-> *kept;
  match taken {
    case let Some(r) {r.answer(v);}
    else {}
  }
}

// Where the live stream is (its slot's record), or null
fn streamOf(rec: &ClientRec, slot: u32, id: u64) *StreamRec {
  let x = rec.streams.at(slot);
  if x as usize != 0usize && (*x).used && (*x).id == id {return x;}
  null
}

fn freeStream(rec: &mut ClientRec, slot: usize) {
  let x = rec.streams.at(u32.from(slot));
  if x as usize != 0usize && (*x).up.on {
    let sid = (*x).id;
    let gone = rec.ups.remove(&sid);
  }
  rec.streams.removeAt(u32.from(slot));
}

// A handle to a client dropped: the last one's going ends the client, every
// fetch of it answered Cancelled, its connections reset
fn unrefClient(rec: &mut ClientRec, lp: &mut Loop) {
  rec.refs = rec.refs - 1u32;
  if rec.refs == 0u32 {
    rec.dying = true;
    rec.client.abortAll(lp);
  }
}

// How a fetch's final answer k, other than Done, is told to those waiting on it
fn endError(k: httpclient.EventKind, f: &httpclient.Failure) FetchError {
  if k == httpclient.EventKind.Failed {FetchError.failed(f.clone())}
  else if k == httpclient.EventKind.TimedOut {FetchError.timedOut()}
  else {FetchError.cancelled()}
}

// Why a stream's fetch ended otherwise than Done: its own failure if the service ended it (an upload whose
// body broke its length), else what the fetch's final answer says
fn terminalError(s: &StreamRec, k: httpclient.EventKind, f: &httpclient.Failure) FetchError {
  if s.up.on && s.up.own {return FetchError.failed(s.up.failure.clone());}
  endError(k, f)
}

// An event of a stream's fetch (its slot sslot), taken by value: the head answers
// the caller's 'await' (with the handle the stream's kind is read through); each
// piece is sent on as it is, the IoBuf moved and its bytes held from the client
// until the sink gives the buffer back; the final answer is the sink's one 'end'
// (and a failure before the head is the caller's Err too)
fn onStreamEvent(rec: &mut ClientRec, lp: &mut Loop, e: httpclient.Event, sslot: usize) {
  let s = rec.streams.borrowMutAt(u32.from(sslot)).unwrap();
  let k = e.kind;
  if k == httpclient.EventKind.BodyRoom {
    // an upload's connection has taken every piece pushed: the originals behind them go back, the next piece goes
    upRoom(rec, lp, s);
    return;
  }
  if k == httpclient.EventKind.BodyEnded {
    // a response came before the body was all sent: the source is stopped Finished
    upSettle(s, true, httpclient.EventKind.Done, httpclient.Failure.none());
    return;
  }
  if k == httpclient.EventKind.Response {
    let response, url = e.(response, url);
    let status, version, headers = response.(status, version, headers);
    s.status = status;
    if s.openBody is Some || s.up.on {
      var reader = None[ReaderSink[Result[Option[String], FetchError]]];
      reader <-> s.bodyReader;
      var group = None[CancelGroup];
      group <-> s.group;
      match reader {
        case let Some(rd) {
          match group {
            case let Some(g) {
              if s.openBody is Some {
                answerKept[Result[BodyStream, FetchError]](&mut s.openBody,
                  Ok[BodyStream, FetchError](BodyStream(rd, g, status, version, headers, url,
                    Atomic[u8].of(bodyUnchosen), rec.id, u32.from(sslot), s.id)));
              } else {
                // an upload whose 'stream' is not asked yet: its reader and group wait with the head
                s.bodyReader = Some[ReaderSink[Result[Option[String], FetchError]]](rd);
                s.group = Some[CancelGroup](g);
                s.up.head = Some[UpHead](UpHead(status, version, headers, url));
              }
              s.awaiting = true;
            }
            else {}
          }
        }
        else {}
      }
    } else if s.openEvents is Some {
      var reader = None[ValueReader[sse.Event, Result[Option[sse.Event], FetchError]]];
      reader <-> s.eventReader;
      var group = None[CancelGroup];
      group <-> s.group;
      match reader {
        case let Some(rd) {
          match group {
            case let Some(g) {
              answerKept[Result[EventStream, FetchError]](&mut s.openEvents,
                Ok[EventStream, FetchError](EventStream(rd, g, status, version, headers, url)));
            }
            else {}
          }
        }
        else {}
      }
    } else {
      answerKept[Result[BodyHead, FetchError]](&mut s.openHead,
        Ok[BodyHead, FetchError](BodyHead(status, version, headers, url)));
    }
  } else if k == httpclient.EventKind.Data {
    let buf, kind = e.(buf, kind);
    let n = buf.len();
    if n == 0usize {return;}
    if s.refused {return;}
    if !(s.sink is Some) {
      // the body waits for the caller's choice: staged, in order, sent nowhere. Nothing is given
      // back, so the peer stops at its credit window; the pool's refusal ends the fetch Overloaded
      if !stagePiece(&mut s.lend, &buf) {
        s.refused = true;
        rec.client.cancel(lp, s.fetch);
      }
      return;
    }
    // With room in the sink's window, and nothing staged before it, the piece
    // goes at once; else its bytes join the staging buffers (while anything is
    // staged, a piece joins it, so bytes stay in order) and its block dies
    if stagingEmpty(&s.lend) && hasRoom(&s.lend, buf.capacity()) {
      deliver(&mut s.lend, &s.sink, buf);
    } else if !stagePiece(&mut s.lend, &buf) {
      s.refused = true;
      rec.client.cancel(lp, s.fetch);
    }
  } else if e.isTerminal() {
    if s.up.on {
      // the upload's source is stopped (Finished if the fetch is Done) and the originals still held go back
      if k == httpclient.EventKind.Done {upSettle(s, true, k, httpclient.Failure.none());}
      else {upSettle(s, false, k, e.failure.clone());}
    }
    if s.openBody is Some {
      answerKept[Result[BodyStream, FetchError]](&mut s.openBody, Err[BodyStream, FetchError](terminalError(s, k, &e.failure)));
    }
    if s.openEvents is Some {
      answerKept[Result[EventStream, FetchError]](&mut s.openEvents, Err[EventStream, FetchError](endError(k, &e.failure)));
    }
    if s.openHead is Some {
      answerKept[Result[BodyHead, FetchError]](&mut s.openHead, Err[BodyHead, FetchError](endError(k, &e.failure)));
    }
    if s.up.on && !s.awaiting && !(s.sink is Some) {
      // an upload that ended before its head: 'stream' (asked now or later) is answered with the error,
      // which waits in the record (freed at once if the Upload is gone)
      if s.up.called || s.up.dropped {
        // (the reply was answered above, or nobody will ask)
        freeStream(rec, sslot);
        unrefClient(rec, lp);
      } else {
        s.up.err = Some[FetchError](terminalError(s, k, &e.failure));
      }
      return;
    }
    var stopWhy = None[Ending];
    stopWhy <-> s.stopWhy;
    let how = if s.refused {Ending.Failed(AnyError.from(FetchError.failed(overloadedFailure())))}
      else if k == httpclient.EventKind.Done {Ending.Finished}
      else {
        match stopWhy {
          case let Some(w) { w }
          case is None { Ending.Failed(AnyError.from(terminalError(s, k, &e.failure))) }
        }
      };
    if s.awaiting && !(s.sink is Some) {
      // the body is not yet chosen: the end is kept, with the staged pieces, for the choice
      // (or, if the BodyStream was dropped, the record is let go)
      if s.abandoned {
        freeStream(rec, sslot);
        unrefClient(rec, lp);
      } else {
        s.kept = Some[Ending](how);
      }
      return;
    }
    finishStream(rec, lp, s, sslot, how);
  }
}

// The end is the last thing sent to the sink, so the record lets go of it with it: what is
// still staged goes first, in order, whatever the window (no more bytes are coming, and the
// staged bytes are bounded by the connection's credit)
fn finishStream(rec: &mut ClientRec, lp: &mut Loop, s: &mut StreamRec, sslot: usize, how: Ending) {
  while !stagingEmpty(&s.lend) {sendStaged(&mut s.lend, &s.sink);}
  var held = None[ChunkSink];
  held <-> s.sink;
  match held {
    case let Some(sk) {sk.end(how);}
    else {}
  }
  freeStream(rec, sslot);
  unrefClient(rec, lp);
}

// ---------------------------------------------------------------------------
// The jobs
// ---------------------------------------------------------------------------

// A fetch whose response goes to a sink: the request and the sink; the head's
// arrival answers the reply the 'await' gives. The sink is told its source
// first (attach), then gets the chunks, then the one end
struct StreamToJob {
  pub id: u64;
  pub req: httpclient.Request;
  pub sink: ChunkSink;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[BodyHead, FetchError]]) {
    let id, req, sink = self.(id, req, sink);
    let k = sv.findClient(id);
    if k >= sv.clients.bound() {
      rp.answer(Err[BodyHead, FetchError](FetchError.cancelled()));
      sink.end(Ending.Failed(AnyError.from(FetchError.cancelled())));
      return;
    }
    let rec = sv.clients.borrowMutAt(u32.from(k)).unwrap();
    var st = openingStream(newId());
    st.openHead = Some[actors.ReplyOf[Result[BodyHead, FetchError]]](rp);
    st.sink = Some[ChunkSink](sink);
    startStream(rec, lp, st, req);
  }
}

// A stream's record added and its fetch sent: the sink is told its source first
fn startStream(rec: &mut ClientRec, lp: &mut Loop, st: StreamRec, req: httpclient.Request) {
  let sid = st.id;
  var sink = None[ChunkSink];
  match &st.sink {
    case let &Some(sk) {sink = Some[ChunkSink](sk.clone());}
    else {}
  }
  let sh = rec.streams.add(st);
  let sslot = usize.from(sh.index);
  rec.refs = rec.refs + 1u32;
  match sink {
    case let Some(sk) {sk.attach(BodySource(rec.id, u32.from(sslot), sid));}
    else {}
  }
  let fetch = rec.client.send(lp, req, httpclient.Sink.Here(tokenOf(sh, streamBit)));
  (rec.streams.borrowMutAt(u32.from(sslot)).unwrap()).fetch = fetch;
}

// A fetch whose response an actor reads as it comes, as chunks of bytes: the
// request, the ReaderSink the body goes to (and the same handle the BodyStream
// reads through) and the group a dropped BodyStream cancels; the head's arrival
// answers the reply the 'await' gives
struct StreamOpenJob {
  pub id: u64;
  pub req: httpclient.Request;
  pub reader: ReaderSink[Result[Option[String], FetchError]];
  pub group: CancelGroup;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[BodyStream, FetchError]]) {
    let id, req, reader, group = self.(id, req, reader, group);
    let k = sv.findClient(id);
    if k >= sv.clients.bound() {
      rp.answer(Err[BodyStream, FetchError](FetchError.cancelled()));
      reader.end(Ending.Failed(AnyError.from(FetchError.cancelled())));
      return;
    }
    let rec = sv.clients.borrowMutAt(u32.from(k)).unwrap();
    var st = openingStream(newId());
    st.openBody = Some[actors.ReplyOf[Result[BodyStream, FetchError]]](rp);
    // no sink yet: the body waits for the BodyStream's 'read' or 'to' (BodyChoiceJob)
    st.bodyReader = Some[ReaderSink[Result[Option[String], FetchError]]](reader);
    st.group = Some[CancelGroup](group);
    startStream(rec, lp, st, req);
  }
}

// The same as server-sent events
struct EventOpenJob {
  pub id: u64;
  pub req: httpclient.Request;
  pub stage: SseParseStage;
  pub reader: ValueReader[sse.Event, Result[Option[sse.Event], FetchError]];
  pub group: CancelGroup;

  pub fn run(self, lp: &mut Loop, sv: &mut Service, rp: actors.ReplyOf[Result[EventStream, FetchError]]) {
    let id, req, stage, reader, group = self.(id, req, stage, reader, group);
    let k = sv.findClient(id);
    if k >= sv.clients.bound() {
      rp.answer(Err[EventStream, FetchError](FetchError.cancelled()));
      stage.end(Ending.Failed(AnyError.from(FetchError.cancelled())));
      return;
    }
    let rec = sv.clients.borrowMutAt(u32.from(k)).unwrap();
    var st = openingStream(newId());
    st.openEvents = Some[actors.ReplyOf[Result[EventStream, FetchError]]](rp);
    st.sink = Some[ChunkSink](stage);
    st.eventReader = Some[ValueReader[sse.Event, Result[Option[sse.Event], FetchError]]](reader);
    st.group = Some[CancelGroup](group);
    startStream(rec, lp, st, req);
  }
}

// A buffer given back to a body source: the bytes the record says were lent in
// it are released to the client. The buffer is known by its address, which a
// sink that trims it (setLen) leaves as it was; a buffer the record does not
// hold (not this fetch's) releases nothing. The job carries the buffer itself:
// it dies when the job does, on this thread, after the record is cleared (and
// also when the job is dropped unrun), so its block is never reissued while a
// record of it stands
struct StreamReleaseJob {
  pub client: u64;
  pub slot: u32;
  pub id: u64;
  pub buf: IoBuf;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findClient(client);
    if k >= sv.clients.bound() {return;}
    let rec = sv.clients.borrowMutAt(u32.from(k)).unwrap();
    let s = streamOf(rec as &ClientRec, slot, id);
    if s as usize == 0usize {return;}
    let st = s as &mut StreamRec;
    // the record is cleared and the window reopens (lendReturn); the credit it names goes back to the client
    let m = lendReturn(&mut st.lend, buf.base() as usize);
    if m > 0usize {rec.client.release(st.fetch, m);}
    drainStaged(&mut st.lend, &st.sink);
  }
}

// A BodyStream's caller chose (a sink: its 'read' made the ReaderSink the sink, its 'to' gave
// one) or dropped it unchosen (no sink). The sink is told its source, gets the pieces staged so
// far in order (as its window allows; the rest follow as buffers come back), and then the end if
// one was kept. Dropped unchosen, the record is let go with the fetch's end, or now if it came
struct BodyChoiceJob {
  pub client: u64;
  pub slot: u32;
  pub id: u64;
  pub sink: Option[ChunkSink];

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    var sk = None[ChunkSink];
    sk <-> sink;
    let k = sv.findClient(client);
    var s = null as *StreamRec;
    if k < sv.clients.bound() {
      s = streamOf(sv.clients.borrowAt(u32.from(k)).unwrap(), slot, id);
    }
    if s as usize == 0usize {
      match sk {
        case let Some(x) {x.end(Ending.Failed(AnyError.from(FetchError.cancelled())));}
        else {}
      }
      return;
    }
    let rec = sv.clients.borrowMutAt(u32.from(k)).unwrap();
    let st = s as &mut StreamRec;
    match sk {
      case let Some(x) {
        st.awaiting = false;
        st.sink = Some[ChunkSink](x.clone());
        x.attach(BodySource(client, slot, id));
        drainStaged(&mut st.lend, &st.sink);
        var how = None[Ending];
        how <-> st.kept;
        match how {
          case let Some(h) {finishStream(rec, lp, st, usize.from(slot), h);}
          else {}
        }
      }
      else {
        st.abandoned = true;
        if st.kept is Some {
          freeStream(rec, usize.from(slot));
          unrefClient(rec, lp);
        }
      }
    }
  }
}

// A buffer came back in a cancelled group: the fetch is ended
struct StreamCancelJob {
  pub client: u64;
  pub slot: u32;
  pub id: u64;

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findClient(client);
    if k >= sv.clients.bound() {return;}
    let rec = sv.clients.borrowMutAt(u32.from(k)).unwrap();
    let s = streamOf(rec as &ClientRec, slot, id);
    if s as usize == 0usize {return;}
    rec.client.cancel(lp, (s as &StreamRec).fetch);
  }
}

// A consumer stopped the stream (BodySource.stop): the first reason is kept, for the
// end the cancelled fetch sends, and the fetch is ended. A stream that has ended
// has no record, so a stop after the end does nothing
struct StreamStopJob {
  pub client: u64;
  pub slot: u32;
  pub id: u64;
  pub why: Option[Ending];

  pub fn run(self: &mut, lp: &mut Loop, sv: &mut Service) {
    let k = sv.findClient(client);
    if k >= sv.clients.bound() {return;}
    let rec = sv.clients.borrowMutAt(u32.from(k)).unwrap();
    let s = streamOf(rec as &ClientRec, slot, id);
    if s as usize == 0usize {return;}
    let st = s as &mut StreamRec;
    if st.stopWhy is Some {return;}
    st.stopWhy <-> why;
    rec.client.cancel(lp, st.fetch);
  }
}
