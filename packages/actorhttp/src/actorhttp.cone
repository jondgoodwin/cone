// The actorhttp package: HTTP and HTTPS an actor awaits. A behaviour of an
// actor writes
//
//   imm r = await client.get("https://example.com/");
//
// and pauses there, as it would awaiting another actor's reply; the fetch is
// done by httpclient (its pools of connections, its retries and redirects,
// TLS under 'https') running on a thread of this package's, and when the
// response is whole, it comes back to the actor as a message, and the rest of
// the behaviour runs with it, perhaps on another worker. Nothing waits on the
// worker meanwhile: the actor handles its other messages. The same for one
// connection of httpconn's, where a program wants the connection itself.
//
//   mod weather;
//   import httpclient use Response;
//   import actors;
//   import actorhttp use Client, FetchError;
//
//   actor Weather {
//     client Client;
//
//     pub async fn show(self, url String) {
//       imm r = await client.get(url.view());      // pauses until the whole response is in
//       match r {
//         case imm ok Ok {...ok.status...  ok.body.view()...}
//         case imm e Err {...e.isTimedOut()  e.isCancelled()  e.failure.message()...}
//       }
//     }
//   }
//
//   ...  Weather(Client.standard()) ...
//
// (tests/manual.cone, the reference manual's example, is this and a server, run.)
//
// The other way round, an actor serves: it listens, awaits each request as an
// Exchange, and answers it, a whole response or a streamed one, including
// server-sent events; and a client reads a response as it arrives, in chunks
// or as events (A SERVER and STREAMS, below):
//
//   actor Front {
//     server Server;
//     pub async fn run(self) {
//       imm r = await actorhttp.listen(SocketAddr.localhost(8080u16), ServerConfig.make());
//       ...                                          // server = the Ok(server)
//       while true {
//         match await server.next() {
//           case mut ok Ok {imm h = Handler(ok); h.run();}   // an actor of its own for each request
//           case imm e Err {break;}                            // the server was closed
//         }
//       }
//     }
//   }
//   actor Handler {
//     ex Exchange;
//     pub async fn run(self) {
//       ex.startEvents();                              // 200, text/event-stream, chunked
//       imm w = await ex.sendEvent(&sse.Event.named("tick", "1"));   // Closed once the client has left
//       ...
//       imm f = await ex.finish();
//     }
//   }
//
// (tests/server.cone and tests/events.cone are these, run; examples/serve.cone is a server to try.)
//
// What there is:
//
//   Client.standard()  Client.make(cfg, maxBody)   a client of http:// and https:// servers   (A CLIENT)
//   c.clone()  Client.none()  c.isNone()           another handle to it; a handle naming nothing
//   c.get(url)                    a GET of a URL as text        Result[Response, FetchError]
//   c.send(request)               a Request                     Result[Response, FetchError]
//   c.getIn(url, lim)  c.sendIn(request, lim)     the same two, limited by lim, an IoLimits
//   actorhttp.connect(host, port)  actorhttp.connectSecure(host, port, tlsConfig)
//                                 a connection, plain or through TLS    Result[Conn, FetchError]
//   conn.request(head, body)  conn.requestIn(head, body, lim)    (A CONNECTION)
//                                 a request on it, body a String ("" for none)
//                                                               Result[Response, FetchError]
//   Conn.none()  conn.isNone()
//   FetchError: e.kind() (FetchErrorKind: Failed, Cancelled, TimedOut)  e.isCancelled()  e.isTimedOut()
//     e.failure (Failed: httpclient.Failure: its stage, code, HTTP error)  e.message()
//   defaultMaxBody                the most body bytes a client takes unless made with another limit
//   c.stream(request)  c.streamIn(request, lim)     a response read as it arrives, in chunks   (STREAMS)
//                                                               Result[BodyStream, FetchError]
//   c.events(request)  c.eventsIn(request, lim)     a response read as server-sent events      (STREAMS)
//                                                               Result[EventStream, FetchError]
//   bs.read()   BodyStream: bs.status bs.version bs.headers bs.url bs.isOk()    Result[Option[String], FetchError]
//   es.next()   EventStream: es.status es.version es.headers es.url es.isOk() es.isEventStream()
//                                                               Result[Option[sse.Event], FetchError]
//   actorhttp.listen(addr, cfg)                          a listening server                   (A SERVER)
//                                                               Result[Server, ServerError]
//   ServerConfig.make()  cfg.secure(tlsServerConfig)  cfg.offerHttp2()  cfg.maxBody cfg.maxPending cfg.conn
//   cfg.offerHttp3(maker)   HTTP/3 beside it, through a plug-in (h3driver's)       (HTTP/3)
//   server.next()  server.close()  server.closed()  server.clone()  server.port() localAddr() isSecure() offersHttp3()
//   Server.none()  server.isNone()          next(): the next request, an Exchange  Result[Exchange, ServerError]
//   ex.request (Request: head body peer secure; path() query() methodName() header(name))
//   ex.respond(head, body)  ex.text(status, text)                  a whole response (not awaited)
//   ex.start(head, length)  ex.startEvents()  ex.startEventsWith(head)   a streamed one (not awaited)
//   ex.write(bytes)  ex.sendEvent(event)  ex.sendComment(text)     Result[usize, ServerError]
//   ex.finish()                                                    Result[u64, ServerError]
//   ServerError: e.kind() (ServerErrorKind: Failed, Closed)  e.isClosed()  e.code  e.message()
//   defaultMaxRequestBody         the most request body bytes a server takes unless configured
//
// Each of the first four and the two of a connection makes an OPERATION, an
// actors.Awaitable[R], which does nothing until an 'await' in a behaviour
// starts it; the 'await''s value is its R. Made and never awaited, it is
// dropped, and nothing is done.
//
// WHAT THE SECOND HALF SEES. Each operation declares its own result, a Result:
// the whole response, or why there is none. 'await' adds nothing to it. The
// success is httpclient's Response (its status, the protocol that carried it
// -- 'version', Version.Http3, Http2 or Http11 -- header fields, body as bytes,
// the URL that answered after any redirects, and its Timing), the same value
// httpclient's fetchWhole gives; its outcome is Done. An HTTP error status
// (404, 500) is an answer, a Response, not an Err: the Err is the network
// or the client refusing (a name not found, a refused connection, a TLS
// handshake or a certificate refused, a protocol break, a body past the limit,
// a URL that does not parse), which carries httpclient's Failure for the
// caller to read, never a panic. A request the client or the connection
// cannot write at all (a method that is not a token, CONNECT, a Host or a
// framing field of the caller's) is a program error: a panic at the line of
// the call, as httpclient's and httpconn's are.
//
// A CLIENT. 'Client.make(cfg, maxBody)' takes an httpclient.Config (its pools
// per origin, retries, redirects and TLS settings are httpclient's) and the
// most body bytes a response may have; past it the exchange fails at
// Stage.Limit, as fetchWhole's does. The httpclient.Client it names lives in
// the package's service, on aio's I/O thread; the handle is plain data that moves, may be sent in a
// message to another actor, and 'clone' makes another that names the same
// client, its connection pools and limits shared: any number of actors fetch
// through one client at once. The last handle's going ends the client: every
// fetch it has in flight is answered Cancelled and its connections are reset.
// A Request (httpclient's) carries its intent, score and redirect limit; its
// deadline and group are limited by the 'In' forms' as below. Streaming a
// response's body to the actor as it arrives is not here: it comes whole.
// Over https
// the client offers HTTP/2 (httpclient's Config.http2, on by default), and a
// server that chooses it carries the client's fetches to it on one
// connection, a stream each; the caller's code is the same, and the
// response's 'version' says which protocol was used (httpclient's header,
// HTTP/2).
//
// A CONNECTION. 'connect(host, port)' makes one HTTP/1.1 connection of httpconn's
// Driver (the host looked up and connected within the driver's connectTimeout,
// 10 s) and answers a Conn when it is made; 'connectSecure' does so through a
// TLS client made from the tls.ClientConfig given, the host the name the
// server's certificate must hold (it speaks HTTP/2 when that config's 'alpn'
// offers "h2" and the server chooses it; what follows is HTTP/1.1's, and on
// HTTP/2 each request is a stream of its own, as httpconn's header says).
// The connection is made when the TCP connection is: a TLS handshake runs
// under the first request, and a certificate refused
// ends that request Failed at Stage.Tls (at Read or Closed instead, if the
// connection broke before the request was asked for). A Conn is plain data
// that moves, like Client. 'request' writes the head the caller made (a RequestHead, its
// authority the host: RequestHead.make("GET", "/", "example.com")) and the
// body, and answers the whole response. The connection carries one exchange
// at a time (HTTP/1.1 without pipelining), and one more may wait behind it;
// a third while those two stand is answered Failed at Stage.Limit. A request
// that was cancelled or timed out while on the wire resets the connection
// (HTTP/1.1's only way to stop it), and later requests on it fail at
// Stage.Closed. Dropping the Conn closes the connection politely, or resets
// it, the exchange in flight answered Cancelled, if there is one.
//
// CANCEL AND DEADLINES. An exchange is answered exactly once: the Response,
// or an Err that is Failed, Cancelled or TimedOut, as aio's operations are,
// httpclient's final answer mapped to it. What limits one is a IoLimits (aio's;
// the package's own type is no different), given to the 'In' form of the call:
// a cancel group (a value that is copied, sent to other actors or threads, and
// whose one 'cancel()' ends every exchange in it) and an absolute deadline,
// the tighter of it and the group's. A request's own deadline and group
// (httpclient.Request's, for 'sendIn') are kept beside it: the tighter deadline
// wins, and lim's group replaces the request's if it has one. From a group's
// cancel on, an exchange started in it is answered Cancelled at once; a deadline
// already past answers TimedOut at once. A cancel and a completion that race are
// settled by the layers beneath: the answer is whichever came first, never
// two. The exchange is one the service thread starts when the 'await' does, so
// a cancel from another actor or thread may arrive before it has started: the
// group's state, not the order of the calls, decides. A client or a Conn
// dropped while an exchange of it is in flight ends it Cancelled.
//
/// THE SERVICE THREAD is aio's I/O thread. The package's service -- every
// client's httpclient.Client, one httpconn.Driver for the connections made
// here, and a Driver for each server -- is a service HOSTED there (aio.cone's
// header, HOSTED SERVICES), made by the first job queued for it, on the Loop
// aio's own operations use; the I/O thread is the one thread that touches
// them, as iocore asks. The actors' workers never wait on I/O. An 'await' on
// an operation hands it to the service through aio's QUEUE for it
// (Host.awaitable; a job nothing awaits, Host.post), which wakes the
// thread. Each pass the thread offers the service the Completions its poll
// returned (the clients and drivers take their own), runs the service's jobs,
// which start exchanges, and gives it its turn: every client and driver is
// pumped, each response's events gathered (the status and header fields, then
// the body's bytes, which it releases as it takes them so that the connection
// reads on) and, at the exchange's one final event, the answer is written into
// the reply the 'await' is waiting for, which goes to the actor's mailbox as
// any reply does: one push, and, if the actor was idle, its scheduling. The
// thread polls no later than the earliest instant a client or driver wants a
// turn. Nothing of the actor runs on the service thread. An exchange in flight
// holds a count of the actor that awaits it, in its reply's envelope, as a
// request to another actor does: the actor lives until the answer comes.
//
// This is httpclient and httpconn on aio's Loop and thread, not on aio's
// Sockets: their sockets are the drivers' own, on the same Loop.
//
// THE PROGRAM'S END. The package's finalizer, which finalAll() runs before
// aio's and the actors package's, waits until no actor is queued or running
// (an actor paused on a fetch is neither), then ends the service (aio's
// Host.end) and waits until it has, before the packages it uses (httpconn,
// httpclient, tls) are finalized: on the I/O thread the jobs queued for it are
// dropped unrun, every client, server and connection is reset with the Loop
// still alive, and the service is dropped. Their answers are not delivered:
// each paused behaviour is ABANDONED, as aio's are (aio.cone's header says
// how): its reply's envelope is dropped, an actor with nothing else holding it
// dies, and the values its paused behaviour held are finalized; the rest of
// the behaviour never runs. An exchange awaited after that is abandoned the
// same way at once. aio's own I/O ends after, in aio's finalizer.
//
// STREAMS. 'client.stream(request)' and 'client.events(request)' are answered
// when the response's HEAD arrives (not its body) with a handle that moves, a
// BodyStream or an EventStream, which carries the status, the header fields
// and the answering URL. An HTTP error status is an answer, as for 'get': the
// program reads 'isOk()' (a 2xx) and, for events, 'isEventStream()' (a 200 of
// Content-Type text/event-stream). Then 'bs.read()' awaits the next piece of
// the body (the bytes of one receive, any size) and 'es.next()' the next event;
// each answers Ok(Some(piece or event)), Ok(None) when the body is whole, or an
// Err, a FetchError (cancelled, timed out, or failed with httpclient's
// Failure), once the pieces already taken are read. The sse package's Reader
// runs on the service thread as the bytes arrive (its comments and unknown
// fields dropped, its limit of 1 MiB for one event a fetch failure at
// Stage.Limit) and the events wait there for the actor. The handle holds a
// count of its client, so a stream outlives the last Client handle that made
// it; dropping the handle cancels the rest of the fetch and lets the connection
// go. CREDIT (invariant I9): a piece is released to the connection as it is
// handed over (and not before more than 64 events or pieces wait), so a reader
// that awaits slowly slows the sender through TCP, and memory stays bounded.
// 'events' asks for 'Accept: text/event-stream' and 'Cache-Control: no-cache'
// unless the request has them; a 'Last-Event-ID' is a field the request
// carries, as any, and reconnecting after the stream breaks is the program's
// (the event's 'id' and the stream's retry time are in each event). The 'In'
// forms limit the whole stream: the deadline ends it TimedOut wherever it is,
// and httpclient's bodyTimeout (30 s, httpclient.Config.conn.protocol) still
// ends one that sends nothing for that long, so a server of events sends a
// comment now and then (Exchange.sendComment).
//
// A SERVER. 'actorhttp.listen(addr, cfg)' answers a Server when it is
// listening (port 0 takes any free port, 'server.port()' says which), or why it
// could not: a ServerError of kind Failed (the address in use, a certificate or
// key that could not be loaded). The listener, its connections and its
// requests live on the service thread, in an httpconn.Driver of the server's
// own, so ServerConfig's 'conn' (httpconn.Config: the protocol's bounds and
// timeouts, the buffers, maxConnections) is its own; 'cfg.secure(tls.ServerConfig)'
// makes every connection TLS, through the same httpconn layer the client uses
// (tls.Server's stream), with OpenSSL still TLS's only C dependency.
//
// A request is READ whole before an actor sees it: 'server.next()' answers an
// Exchange holding the Request (head, body up to cfg.maxBody, 1 MiB by default,
// the client's address, whether it came through TLS) once the head and the
// whole body are in. A request past the limit is answered 413 by the server at
// once (a declared Content-Length over it before a byte of the body is read; a
// chunked body when it passes it), 'Connection: close', and no actor sees it.
// An 'Expect: 100-continue' is answered 100 for a request within the limit. A
// request that has no actor to take it waits in the server, up to
// cfg.maxPending (1024); past it the server answers 503 at once, which is the
// BACKPRESSURE on arrivals (the actors' own: an actor that takes a request
// only when it has room awaits 'next' only then). Any number of actors may
// await 'next' at once, each request going to the one waiting longest. A
// request whose client left while it waited is dropped, never handed out. HOW
// A REQUEST REACHES AN ACTOR: by the Exchange, plain data that moves, in the
// answer to 'next', which the receiving actor passes to the actor that will
// answer it (an Exchange may be sent in a message or held in a field); this
// needs no generic actor, and is the shape of aio's 'accept'.
//
// The program ANSWERS an Exchange exactly once, by one of: 'respond(head, body)'
// or 'text(status, body)', a whole response with its Content-Length; 'start(head,
// length)' then 'write' (any number) and 'finish', a streamed one, its body
// sized (BodyLength.sized(n): exactly n bytes) or not (BodyLength.unsized():
// chunked); or 'startEvents()' then 'sendEvent' and 'sendComment' and 'finish',
// a stream of server-sent events (200, 'Content-Type: text/event-stream',
// 'Cache-Control: no-cache', chunked, each event one chunk written at once).
// 'respond' and 'start' are not awaited (they only queue the head; made and
// not awaited is still done); 'write' and 'finish' are Awaitables and so, as
// every Awaitable, do nothing unless awaited. A 'write' is answered, with the
// byte count, when the connection has taken ALL of its bytes (the core's
// watermark, 256 KiB queued, holds the rest back and the driver says when
// there is room): an actor that awaits each write is slowed to its peer's
// speed, the backpressure on a streaming response. 'finish' is answered, with
// the response's body byte count, when the response has gone to the connection
// whole. A peer that has left (the connection reset or closed) answers Closed
// to a write or a finish pending or later, which is how a stream of events
// learns its reader is gone; the response is then not an error to raise, and
// nothing more is sent. A call the Exchange's state forbids (a second answer,
// 'write' before 'start' or after 'finish', a status outside 200 to 599, a
// Content-Length or Transfer-Encoding field of the program's, more bytes than a
// sized body's length, 'finish' short of it) is a program error: a panic at
// the line of the call, as the client's are. A response to a HEAD request, or a
// 204 or 304, sends the head (with the Content-Length 'respond' computed) and no
// body: its writes answer 0. Dropping an Exchange without answering answers 500;
// dropping one that is streaming an unsized body ends the body cleanly (so a
// stream of events closes), a sized one short of its length resets the
// connection. The Date and Server fields are not added: the program writes the
// fields it wants. HTTP/1.1 keep-alive is the core's: a connection serves one
// request at a time and the next once the response is whole, until the client or
// 'Connection: close' ends it.
//
// HTTP/2. 'cfg.offerHttp2()' has a TLS server's ALPN take "h2" before
// "http/1.1": a client that offers h2 gets it, one that does not HTTP/1.1.
// Each stream of an HTTP/2 connection is a request of its own, many at once,
// delivered and answered exactly as above (the request's head says
// Version.Http2); a request past the limit is answered 413 on its stream, the
// connection carrying on. Without TLS, HTTP/2 is by prior knowledge alone
// ('cfg.conn.h2PriorKnowledge': every connection of the server speaks it).
//
// HTTP/3. 'cfg.offerHttp3(maker)' (TLS only: a plain server asked for it
// fails to listen) listens on UDP beside the TCP listener, at its own
// address and port, through the HTTP/3 plug-in 'maker' makes (h3driver's
// 'plugin': this package imports no QUIC, so a program that names none links
// none), with the TLS config's certificate and key, on the service thread
// with the server's driver. Its TCP responses carry 'Alt-Svc: h3=":<port>";
// ma=86400' unless the program wrote an Alt-Svc of its own, so a client that
// reads it (httpclient's, with a plug-in) comes back over HTTP/3. Each
// HTTP/3 request is delivered and answered exactly as above (its head says
// Version.Http3); a 413 or 503 goes on its stream, the connection carrying
// on. A client's calls are the same: a Client whose httpclient.Config names
// a plug-in fetches over HTTP/3 where httpclient's header says it does, and
// the Response's 'version' says so.
//
// 'server.close()' (and the last handle's going) asks the service thread to
// stop listening, which it does shortly after the call returns: then it answers
// every 'next' waiting Closed and every request still waiting for an actor 503,
// and lets the exchanges already taken finish; the server's idle connections
// are then reset. 'await server.closed()' completes once that is done (the
// listener shut, so a connect is refused). A Server handle, as a Client, is plain data that moves and
// 'clone's.
//
// On Windows and Linux, as httpclient and httpconn are. Not here: a request's
// body streamed to the actor (a request is delivered whole, up to maxBody), a
// request's body streamed from a client actor (a request carries its body
// whole), a client's 'stream' and 'events' reconnecting, SSE's Last-Event-ID
// resuming on the server (the program reads the field and chooses), WebSocket
// and other Upgrades, HTTP/3 without TLS, routing (the program matches 'request.path()'),
// an 'In' form of 'next', a Conn made with its driver's other settings
// (maxWaiting and the rest are httpconn.Config's defaults), a client's
// reprioritize and closeIdle, a connect with an 'In' form, and httpclient and
// httpconn running on aio's own sockets.

mod actorhttp;

import slots use SlotTable;
import collections use List, Deque, String, Dict, Error;
import iobuf use IoBuf;
import time use Instant, Duration;
import iocore use Loop, Completion, SocketAddr, CancelGroup, IoError, forever;
import http use *;
import httpconn;
import httpclient;
import tls;
import sse;
import aio use IoLimits;
import actors;

fn @initpure init() {
  nextId = Atomic[u64].of(0u64);
  svcHost = aio.host[Service](&makeService);
}

// A panic, reported at the line calling 'die'
fn die(msg: &str, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Never {
  panic(msg, file, line)
}

// ---------------------------------------------------------------------------
// How an awaited exchange ends
// ---------------------------------------------------------------------------

// How an exchange that did not finish ended
pub enum FetchErrorKind {
  Failed,        // the network, the server or the client's limits refused it: 'failure' says why
  Cancelled,     // its cancel group was cancelled, or the handle it was on was dropped
  TimedOut      // its deadline passed
}

// Why an awaited exchange has no response. A failure is not a panic: a
// cancel and a deadline are errors of a kind of their own, as iocore's
// IoError makes them
pub struct FetchError is Error {
  pub failure: httpclient.Failure;   // Failed: the stage, the system's code, the HTTP error; else none
  cause: FetchErrorKind;

  pub fn failed(f: httpclient.Failure) FetchError {FetchError(f, FetchErrorKind.Failed)}
  pub fn cancelled() FetchError {FetchError(httpclient.Failure.none(), FetchErrorKind.Cancelled)}
  pub fn timedOut() FetchError {FetchError(httpclient.Failure.none(), FetchErrorKind.TimedOut)}

  // How it came to be
  pub fn kind(self: &) FetchErrorKind {cause}

  // Ended by a cancel
  pub fn isCancelled(self: &) bool {cause == FetchErrorKind.Cancelled}

  // Ended by its deadline
  pub fn isTimedOut(self: &) bool {cause == FetchErrorKind.TimedOut}

  // 'connect: closed: the connection could not be made (...)', or 'cancelled',
  // or 'deadline passed'
  pub fn message(self: &) String {
    if cause == FetchErrorKind.Cancelled {return String.from("cancelled");}
    if cause == FetchErrorKind.TimedOut {return String.from("deadline passed");}
    failure.message()
  }
}

// ---------------------------------------------------------------------------
// The service, hosted on aio's I/O thread, and its queue
// ---------------------------------------------------------------------------

// The service: hosted on aio's I/O thread (aio's HOSTED SERVICES), made
// there by the first job queued for it. Set in 'init'; nothing but its block
// is made, and no thread started, until a handle or an exchange queues a job
let svcHost: aio.Host[Service];

// The ids handles carry: never 0
let nextId: Atomic[u64];

fn newId() u64 {nextId.add(1u64) + 1u64}

// The service, made on aio's I/O thread
fn makeService() Service {Service.make()}

// The package's finalizer, run by finalAll() before aio's and the actors
// package's: once no actor is queued or running, the service ends, and every
// behaviour still paused on it is abandoned (the package's header, THE
// PROGRAM'S END). It ends here, not in aio's finalizer, so that it ends before
// the packages it uses (httpconn, httpclient, tls) are finalized
fn final() {
  actors.waitQuiet();
  svcHost.end();
}

// ---------------------------------------------------------------------------
// Awaitables
// ---------------------------------------------------------------------------

// The operation awaited: its job, made now, queued for the service by the
// 'await', which hands the job's 'run(self, lp &mut Loop, sv &mut Service,
// rp actors.Reply)' the reply its answer goes back in
fn awaitable[J, R](body: J) actors.Awaitable[R] {
  svcHost.awaitable[J, R](body)
}

// A job nothing awaits: it is queued at once
fn post[J](body: J) {
  svcHost.post[J](body);
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

// What a client takes a body up to unless it is made with another limit
pub const defaultMaxBody = 16777216usize;

// A client of HTTP and HTTPS servers, as an actor holds one (the package's
// header, A CLIENT): plain data naming a httpclient.Client that the service
// thread owns, which moves, and which 'clone' makes another handle to. The
// last handle's going ends the client
pub struct Client is Move {
  id: u64;

  // A client with httpclient's defaults, whose bodies are read up to defaultMaxBody
  pub fn standard() Client {Client.make(httpclient.Config.make(), defaultMaxBody)}

  // A client with cfg's pools, limits and TLS, whose response bodies are
  // read up to maxBody bytes (past it the exchange fails at Stage.Limit)
  pub fn make(cfg: httpclient.Config, maxBody: usize) Client {
    let id = newId();
    post[CreateClientJob](CreateClientJob(id, cfg, maxBody));
    Client(id)
  }

  // A Client naming nothing, which ends nothing
  pub fn none() Client {Client(0u64)}

  pub fn isNone(self: &) bool {id == 0u64}

  // Another handle to the same client, its pools and its limits
  pub fn clone(self: &) Client {
    if id != 0u64 {
      post[RefJob](RefJob(id, true));
    }
    Client(id)
  }

  // A GET of a URL written as text, answered with the whole response
  pub fn get(self: &, url: &str) actors.Awaitable[Result[httpclient.Response, FetchError]] {
    self.sendIn(httpclient.Request.get(url), IoLimits.none())
  }

  // A GET ended if lim says so (the package's header, CANCEL AND DEADLINES)
  pub fn getIn(self: &, url: &str, lim: IoLimits) actors.Awaitable[Result[httpclient.Response, FetchError]] {
    self.sendIn(httpclient.Request.get(url), lim)
  }

  // A request, answered with the whole response. A request the client
  // writes the framing of, or whose method is not a token, or CONNECT, is a
  // program error: a panic at the caller's line
  pub fn send(self: &, req: httpclient.Request, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[httpclient.Response, FetchError]] {
    self.sendIn(req, IoLimits.none(), file, line)
  }

  // A request ended if lim says so, and its own deadline and group too: the
  // tighter deadline, and lim's group if it has one
  pub fn sendIn(self: &, req: httpclient.Request, lim: IoLimits, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[httpclient.Response, FetchError]] {
    checkRequest(&req, file, line);
    var r = req;
    match lim.group {
      case let Some(g) {r.group = Some[CancelGroup](g);}
      else {}
    }
    if lim.deadline < r.deadline {r.deadline = lim.deadline;}
    awaitable[FetchJob, Result[httpclient.Response, FetchError]](FetchJob(id, r))
  }

  // A request whose response the actor reads as it arrives, body chunk by
  // chunk (the package's header, STREAMS): answered when the response's head
  // arrives, with a BodyStream whose 'read' awaits each piece
  pub fn stream(self: &, req: httpclient.Request, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[BodyStream, FetchError]] {
    self.streamIn(req, IoLimits.none(), file, line)
  }

  // The same, the whole fetch ended if lim says so, and the request's own deadline and group too
  pub fn streamIn(self: &, req: httpclient.Request, lim: IoLimits, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[BodyStream, FetchError]] {
    let r = limitedRequest(req, lim, file, line);
    awaitable[StreamOpenJob, Result[BodyStream, FetchError]](StreamOpenJob(id, r, false))
  }

  // A request whose response is read as server-sent events (STREAMS): it asks
  // for 'Accept: text/event-stream' and 'Cache-Control: no-cache' unless the
  // request has them, and is answered when the head arrives with an
  // EventStream whose 'next' awaits each event. It is no GET only: any method
  pub fn events(self: &, req: httpclient.Request, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[EventStream, FetchError]] {
    self.eventsIn(req, IoLimits.none(), file, line)
  }

  // The same, the whole stream ended if lim says so, and the request's own deadline and group too
  pub fn eventsIn(self: &, req: httpclient.Request, lim: IoLimits, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[EventStream, FetchError]] {
    var r = limitedRequest(req, lim, file, line);
    if !r.headers.has("Accept") {r.headers.add("Accept", "text/event-stream");}
    if !r.headers.has("Cache-Control") {r.headers.add("Cache-Control", "no-cache");}
    awaitable[StreamOpenJob, Result[EventStream, FetchError]](StreamOpenJob(id, r, true))
  }

  fn final(self: &uni) {
    if id != 0u64 {
      post[RefJob](RefJob(id, false));
    }
  }
}

// A request checked, with lim's group and deadline put on it: the tighter deadline, lim's group if it has one
fn limitedRequest(req: httpclient.Request, lim: IoLimits, file: &Array[u8], line: u32) httpclient.Request {
  checkRequest(&req, file, line);
  var r = req;
  match lim.group {
    case let Some(g) {r.group = Some[CancelGroup](g);}
    else {}
  }
  if lim.deadline < r.deadline {r.deadline = lim.deadline;}
  r
}

// What httpconn would panic at in a request's head, found where the call is made
fn checkHead(h: &RequestHead, file: &Array[u8], line: u32) {
  if !isToken(h.methodName()) {die("actorhttp: the request's method is not a token", file, line);}
  if h.method == Method.Connect {die("actorhttp: CONNECT is not supported", file, line);}
  if !isVisible(h.target.view()) {die("actorhttp: the request's target is empty or holds a space or a control character", file, line);}
  if !isVisible(h.authority.view()) {die("actorhttp: a request needs an authority, written as Host, without spaces", file, line);}
  if h.headers.has("Host") {die("actorhttp: Host is written from the head's authority, not its fields", file, line);}
  if h.headers.has("Content-Length") || h.headers.has("Transfer-Encoding") {
    die("actorhttp: framing fields are the core's to write; a body's length is its String's", file, line);
  }
}

fn isVisible(s: &Array[u8]) bool {
  if s.len == 0usize {return false;}
  var i = 0usize;
  while i < s.len {
    if s[i] <= 0x20u8 || s[i] >= 0x7Fu8 {return false;}
    i = i + 1usize;
  }
  true
}

// What the client would panic at, found where the call is made
fn checkRequest(r: &httpclient.Request, file: &Array[u8], line: u32) {
  if !isToken(r.methodName()) {die("actorhttp: the request's method is not a token", file, line);}
  if r.method == Method.Connect {die("actorhttp: CONNECT is not supported", file, line);}
  if r.headers.has("Host") {die("actorhttp: Host is written from the request's URL, not its fields", file, line);}
  if r.headers.has("Content-Length") || r.headers.has("Transfer-Encoding") {
    die("actorhttp: framing fields are the client's to write, from the request's body", file, line);
  }
}

// ---------------------------------------------------------------------------
// Connections
// ---------------------------------------------------------------------------

// One HTTP/1.1 connection an actor holds (the package's header, A CONNECTION):
// plain data naming a connection the service thread's httpconn Driver owns,
// which moves. Dropping it closes the connection politely, or resets it if an
// exchange is still in flight on it, which then ends Cancelled
pub struct Conn is Move {
  id: u64;

  // A Conn naming nothing, which closes nothing
  pub fn none() Conn {Conn(0u64)}

  pub fn isNone(self: &) bool {id == 0u64}

  // A request with its whole body ('' for none), on this connection: the
  // response, whole. The head is the caller's to make, its authority the
  // host (RequestHead.make("GET", "/", "example.com")); one request is on
  // the wire at a time, and a second waits for it
  pub fn request(self: &, head: RequestHead, body: String, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[httpclient.Response, FetchError]] {
    self.requestIn(head, body, IoLimits.none(), file, line)
  }

  // A request ended if lim says so (the package's header, CANCEL AND DEADLINES)
  pub fn requestIn(self: &, head: RequestHead, body: String, lim: IoLimits, file: &Array[u8] = srcFile(), line: u32 = srcLine())
      actors.Awaitable[Result[httpclient.Response, FetchError]] {
    checkHead(&head, file, line);
    awaitable[ExchangeJob, Result[httpclient.Response, FetchError]](
      ExchangeJob(id, head, body, lim.group, lim.deadline))
  }

  fn final(self: &uni) {
    if id != 0u64 {
      post[DropConnJob](DropConnJob(id));
    }
  }
}

// A connection to host:port, plain. The host is looked up and connected by
// httpconn's driver, bounded by its connectTimeout (10 s)
pub fn connect(host: &str, port: u16) actors.Awaitable[Result[Conn, FetchError]] {
  awaitable[ConnectJob, Result[Conn, FetchError]](
    ConnectJob(String.from(host), port, false, tls.ClientConfig.make()))
}

// A connection to host:port through TLS, the server's certificate checked as
// cfg says (the host is the name it must hold)
pub fn connectSecure(host: &str, port: u16, cfg: tls.ClientConfig) actors.Awaitable[Result[Conn, FetchError]] {
  awaitable[ConnectJob, Result[Conn, FetchError]](
    ConnectJob(String.from(host), port, true, cfg))
}
