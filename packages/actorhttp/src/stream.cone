// The streams an actor reads: a response whose body arrives to the actor as
// it comes, as chunks of bytes (BodyStream) or as server-sent events
// (EventStream). The handles are plain data that move: each holds the sink its
// body goes to (a stages.ReaderSink, or a stages.ValueReader fed by this package's SseParseStage) and the
// cancel group of its fetch, which dropping the handle cancels. The service
// thread keeps the fetch and sends the pieces (streamservice.cone), and
// actorhttp.cone's header says how the pieces fit (STREAMS).

// How a stream's end, or a chunk of its body, is told to a reader
fn copyError(e: &FetchError) FetchError {
  let k = e.kind();
  if k == FetchErrorKind.Failed {FetchError.failed(e.failure.clone())}
  else if k == FetchErrorKind.TimedOut {FetchError.timedOut()}
  else {FetchError.cancelled()}
}

// The error an ending carries: the FetchError the service made, else a cancel
fn errorOfEnding(e: &AnyError) FetchError {
  match e.downcastRef[FetchError]() {
    case let Some(fe) {copyError(fe)}
    else {FetchError.cancelled()}
  }
}

fn bodyChunk(c: &IoBuf) Result[Option[String], FetchError] {
  Ok[Option[String], FetchError](Some[String](String.fromBytes(c.view())))
}

fn bodyEnd(how: &Ending) Result[Option[String], FetchError] {
  match how {
    case is Finished {Ok[Option[String], FetchError](None[String])}
    case let &Failed(e) {Err[Option[String], FetchError](errorOfEnding(e))}
  }
}

// A response being read, body chunk by chunk. The status and header fields
// are known when it is made; 'read' awaits the next piece of the body.
// Dropping it before the body has ended cancels the rest of the fetch
pub struct BodyStream is Move {
  reader: ReaderSink[Result[Option[String], FetchError]];
  group: CancelGroup;
  pub status: u16;
  pub version: Version;     // the protocol that carried it: Http11, or Http2
  pub headers: Headers;
  pub url: String;          // the URL that answered, after any redirects
  choice: Atomic[u8];       // bodyUnchosen until 'read' or 'to' is the caller's choice
  client: u64;              // where the stream's record is kept (streamservice.cone)
  slot: u32;
  sid: u64;

  // The next piece of the body (the bytes of one receive: any size), or None
  // when the body is whole; or why it ended otherwise. A piece is released to
  // the connection as it is taken, so a reader that awaits slowly slows the
  // sender, never fills memory
  pub fn read(self: &) actors.Awaitable[Result[Option[String], FetchError]] {
    // the first read is the choice: the reader is attached to the stream, which until now has
    // kept the body staged (streamservice.cone, BodyChoiceJob). Later reads cost one atomic load
    if choice.load() == bodyUnchosen {
      if choice.swap(bodyRead) == bodyUnchosen {
        post[BodyChoiceJob](BodyChoiceJob(client, slot, sid, Some[ChunkSink](reader.clone())));
      }
    }
    readSink[Result[Option[String], FetchError]](&reader)
  }

  // The body sent to a sink instead: the sink is told its source, then gets the body's pieces
  // (those that arrived while the caller was choosing first, in order), then the one end, as
  // for 'streamTo'. The head is already in hand, so the caller has looked at it before choosing.
  // The sink's buffers are the fetch's own window; a sink that gives them back slowly slows
  // the connection. A body already read from cannot be sent: the sink is ended Failed
  pub fn to(self, sink: ChunkSink) {
    if choice.swap(bodyTo) == bodyUnchosen {
      post[BodyChoiceJob](BodyChoiceJob(client, slot, sid, Some[ChunkSink](sink)));
    } else {
      choice.store(bodyRead);
      sink.end(Ending.Failed(AnyError.msg("the body was read from, it cannot be sent to a sink")));
    }
  }

  // The body read as server-sent events instead: this package's SseParseStage is attached as the
  // body's sink, and the EventStream (the same head, the same cancel group) awaits each event
  // as 'client.events' gives it. The head is already in hand, so the caller has looked at it
  // before choosing. A body already read from cannot be read as events: the stream's 'next'
  // answers a cancel. Dropping the EventStream cancels the rest of the fetch
  pub fn events(self) EventStream {
    let rd = eventReader();
    let sink = SseParseStage(rd.clone());
    if choice.swap(bodyTo) == bodyUnchosen {
      post[BodyChoiceJob](BodyChoiceJob(client, slot, sid, Some[ChunkSink](sink.clone())));
    } else {
      choice.store(bodyRead);
      sink.end(Ending.Failed(AnyError.msg("the body was read from, it cannot be read as events")));
    }
    EventStream(rd, group, status, version, headers.clone(), url.clone())
  }

  // Whether the status is a 2xx
  pub fn isOk(self: &) bool {status >= 200u16 && status < 300u16}

  fn final(self: &uni) {
    let c = choice.load();
    if c != bodyTo {group.cancel();}
    // never chosen: the service lets go of the body it kept
    if c == bodyUnchosen {post[BodyChoiceJob](BodyChoiceJob(client, slot, sid, None[ChunkSink]));}
  }
}

// What a BodyStream's caller has chosen: nothing yet, to 'read', or to send the body 'to' a sink
const bodyUnchosen = 0u8;
const bodyRead = 1u8;
const bodyTo = 2u8;

// A response read as server-sent events (the sse package's): the Reader runs
// in an SseParseStage actor as the body arrives, and 'next' awaits the next event
// from the stages.ValueReader that stage feeds
pub struct EventStream is Move {
  reader: ValueReader[sse.Event, Result[Option[sse.Event], FetchError]];
  group: CancelGroup;
  pub status: u16;
  pub version: Version;     // the protocol that carried it: Http11, or Http2
  pub headers: Headers;
  pub url: String;

  // The next event, or None when the stream has ended cleanly; or why it
  // ended otherwise (a deadline, a cancel, the connection breaking, an event
  // past the reader's limit). A comment (": ping") is no event; the stream's
  // 'id' is each event's, as the sse package's Reader keeps it
  pub fn next(self: &) actors.Awaitable[Result[Option[sse.Event], FetchError]] {
    readValue[sse.Event, Result[Option[sse.Event], FetchError]](&reader)
  }

  // Whether the status is a 2xx
  pub fn isOk(self: &) bool {status >= 200u16 && status < 300u16}

  // Whether the server said it is an event stream (a 200 with Content-Type text/event-stream)
  pub fn isEventStream(self: &) bool {
    if status != 200u16 {return false;}
    match headers.get("Content-Type") {
      case let Some(v) {
        let t = String.fromBytes(v);
        t.view().startsWith("text/event-stream")
      }
      case is None[&Array[u8]] {false}
    }
  }

  fn final(self: &uni) {
    group.cancel();
  }
}

// Events that may wait for a reader before the buffers behind them are given back (the
// bytes of a buffer are not released to the connection until fewer than this many
// events wait, parsed or sent and not yet read). The bound in bytes is the fetch's window
const eventQueueHigh = 64usize;

// How an event stream's reads end once its events are all taken
fn limitError() FetchError {
  FetchError.failed(httpclient.Failure.make(httpclient.Stage.Limit, 0u32,
    ErrorKind.TooLarge, "an event is longer than the reader's limit"))
}

fn eventValue(ev: sse.Event) Result[Option[sse.Event], FetchError] {
  Ok[Option[sse.Event], FetchError](Some[sse.Event](ev))
}

fn eventEnd(how: &Ending) Result[Option[sse.Event], FetchError] {
  match how {
    case is Finished {Ok[Option[sse.Event], FetchError](None[sse.Event])}
    case let &Failed(e) {Err[Option[sse.Event], FetchError](errorOfEnding(e))}
  }
}

// The sink an actor reads events through: it holds at most eventQueueHigh events, one
// unit of credit each, and a read takes one and grants the next
fn eventReader() ValueReader[sse.Event, Result[Option[sse.Event], FetchError]] {
  ValueReader[sse.Event, Result[Option[sse.Event], FetchError]](u32.from(eventQueueHigh), &eventValue, &eventEnd)
}

// A stage from bytes to events: the sse Reader runs over each chunk here, off the service
// thread, and the events go on to the ValueSink it was made with (an EventStream's reader)
// as that sink grants credit. A chunk's buffer is given back once the events waiting (parsed
// here, or sent and not yet credited) are fewer than eventQueueHigh, so a reader that awaits
// slowly slows the sender: what is held is at most the window of bytes (and the events
// parsed from them), however small the events
actor SseParseStage is ChunkSink, ValueSource {
  down: Option[ValueSink[sse.Event]];
  up: Option[ChunkSource];
  rd: sse.Reader;
  pending: Deque[sse.Event];                 // parsed events, waiting for credit
  held: Deque[IoBuf];                        // buffers whose bytes are not yet released
  window: u32;                               // the first credit down granted: what it may hold
  avail: u32;                                // credit down has granted and not yet been used
  ended: Option[Ending];                     // the end, until it has gone down
  limited: bool;                             // an event passed the reader's limit and the source was stopped for it

  pub fn init(self: &new, down: ValueSink[sse.Event]) {
    *self = Self(down: Some[ValueSink[sse.Event]](down), up: None[ChunkSource], rd: sse.Reader.make(),
      pending: Deque[sse.Event](), held: Deque[IoBuf](), window: 0u32, avail: 0u32,
      ended: None[Ending], limited: false);
    down.attach(selfactor);
  }

  pub async fn attach(self, source: ChunkSource) {
    up = Some[ChunkSource](source);
  }

  pub async fn accept(self, c: IoBuf) {
    if limited {
      self.giveOne(c);
      return;
    }
    var got = List[sse.Event]();
    rd.feed(c.view(), &mut got);
    each ev in got.drain() {pending.push(ev);}
    if rd.overflowed() {
      limited = true;
      match &up {
        case let &Some(u) {u.stop(Ending.Failed(AnyError.from(limitError())));}
        else {}
      }
    }
    held.push(c);
    self.pump();
  }

  pub async fn end(self, how: Ending) {
    up = None[ChunkSource];
    held = Deque[IoBuf]();
    ended = Some[Ending](how);
    self.pump();
  }

  // The reader has used n events: n more may be sent. Credit saturates at the first window
  pub async fn credit(self, n: u32) {
    if window == 0u32 {window = n;}
    avail = if avail + n > window {window} else {avail + n};
    self.pump();
  }

  // The reader wants no more: the fetch is stopped, and the end that follows carries why
  pub async fn stop(self, why: Ending) {
    match &up {
      case let &Some(u) {u.stop(why);}
      else {}
    }
  }

  // Send events while credit lasts, give buffers back while few events wait, and send the
  // end once every event has gone
  fn pump(self) {
    var more = true;
    while more && avail > 0u32 {
      match pending.popFront() {
        case let Some(ev) {
          match &down {
            case let &Some(d) {d.accept(ev); avail = avail - 1u32;}
            else {}
          }
        }
        else {more = false;}
      }
    }
    if pending.len() + usize.from(window - avail) < eventQueueHigh {
      more = true;
      while more {
        match held.popFront() {
          case let Some(b) {self.giveOne(b);}
          else {more = false;}
        }
      }
    }
    if pending.len() == 0usize {
      var e = None[Ending];
      e <-> ended;
      match e {
        case let Some(how) {
          var why = how;
          if limited {why = Ending.Failed(AnyError.from(limitError()));}
          match &down {
            case let &Some(d) {d.end(why);}
            else {}
          }
          down = None[ValueSink[sse.Event]];
        }
        else {}
      }
    }
  }

  fn giveOne(self, b: IoBuf) {
    match &up {
      case let &Some(u) {u.giveBack(b);}
      else {}
    }
  }
}

// The head of a response whose body is going to a sink (Client.streamTo): what
// BodyStream carries besides the handle. The body is not here: it goes to the
// sink as chunks, and ends there
pub struct BodyHead is Move {
  pub status: u16;
  pub version: Version;     // the protocol that carried it: Http11, or Http2
  pub headers: Headers;
  pub url: String;          // the URL that answered, after any redirects

  // Whether the status is a 2xx
  pub fn isOk(self: &) bool {status >= 200u16 && status < 300u16}
}

// The source end of a body sent to a sink (Client.streamTo): what the sink
// gives its buffers back to. The credit is the fetch's own window and no other:
// a buffer coming back releases its bytes to the client ('release', on the
// service thread), which is what lets the connection read on. The chunks
// themselves are sent from the service thread as the body arrives
// (streamservice.cone, onStreamEvent). A buffer given back in a cancelled group
// ends the fetch, so a consumer that quits stops the download
actor BodySource is ChunkSource {
  client: u64;
  slot: u32;
  id: u64;

  pub fn init(self: &new, client: u64, slot: u32, id: u64) {
    *self = Self(client: client, slot: slot, id: id);
  }

  // A chunk is finished with. The fetch gets back what its own record says it
  // lent in this buffer (known by its address), never the length the buffer
  // comes back with: a sink that trims a buffer cannot skew the credit. The
  // buffer itself goes in the job, and dies on the service thread after the
  // record is cleared, so its block cannot be reissued while a record of it stands
  pub async fn giveBack(self, b: IoBuf) {
    if actors.isCancelled() {
      post[StreamCancelJob](StreamCancelJob(client, slot, id));
    }
    post[StreamReleaseJob](StreamReleaseJob(client, slot, id, b));
  }

  // The consumer wants no more (ChunkSource.stop): the fetch is ended, and the sink's
  // one end follows carrying 'why'. After the end, or a second stop, nothing happens.
  pub async fn stop(self, why: Ending) {
    post[StreamStopJob](StreamStopJob(client, slot, id, Some[Ending](why)));
  }
}
