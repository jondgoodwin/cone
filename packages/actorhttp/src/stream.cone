// The streams an actor reads: a response whose body arrives to the actor as
// it comes, as chunks of bytes (BodyStream) or as server-sent events
// (EventStream). The handles are plain data that move; the service thread
// keeps what they name (streamservice.cone), and actorhttp.cone's header says
// how the pieces fit (STREAMS).

// A response being read, body chunk by chunk. The status and header fields
// are known when it is made; 'read' awaits the next piece of the body.
// Dropping it before the body has ended cancels the rest of the fetch
pub struct BodyStream is Move {
  client: u64;
  slot: u32;
  id: u64;
  pub status: u16;
  pub version: Version;     // the protocol that carried it: Http11, or Http2
  pub headers: Headers;
  pub url: String;          // the URL that answered, after any redirects

  // The next piece of the body (the bytes of one receive: any size), or None
  // when the body is whole; or why it ended otherwise. A piece is released to
  // the connection as it is taken, so a reader that awaits slowly slows the
  // sender, never fills memory
  pub fn read(self: &) actors.Awaitable[Result[Option[String], FetchError]] {
    awaitable[StreamReadJob, Result[Option[String], FetchError]](StreamReadJob(client, slot, id))
  }

  // Whether the status is a 2xx
  pub fn isOk(self: &) bool {status >= 200u16 && status < 300u16}

  fn final(self: &uni) {
    post[StreamDropJob](StreamDropJob(client, slot, id));
  }
}

// A response read as server-sent events (the sse package's): the Reader runs
// on the service thread as the body arrives, and 'next' awaits the next event
pub struct EventStream is Move {
  client: u64;
  slot: u32;
  id: u64;
  pub status: u16;
  pub version: Version;     // the protocol that carried it: Http11, or Http2
  pub headers: Headers;
  pub url: String;

  // The next event, or None when the stream has ended cleanly; or why it
  // ended otherwise (a deadline, a cancel, the connection breaking, an event
  // past the reader's limit). A comment (": ping") is no event; the stream's
  // 'id' is each event's, as the sse package's Reader keeps it
  pub fn next(self: &) actors.Awaitable[Result[Option[sse.Event], FetchError]] {
    awaitable[EventReadJob, Result[Option[sse.Event], FetchError]](EventReadJob(client, slot, id))
  }

  // Whether the status is a 2xx
  pub fn isOk(self: &) bool {status >= 200u16 && status < 300u16}

  // Whether the server said it is an event stream (a 200 with Content-Type text/event-stream)
  pub fn isEventStream(self: &) bool {
    if status != 200u16 {return false;}
    match headers.get("Content-Type") {
      case let Some(v) {
        let t = String.fromBytes(v);
        t.view().startsWith("text/event-stream")
      }
      case is None[&Array[u8]] {false}
    }
  }

  fn final(self: &uni) {
    post[StreamDropJob](StreamDropJob(client, slot, id));
  }
}

// The head of a response whose body is going to a sink (Client.streamTo): what
// BodyStream carries besides the handle. The body is not here: it goes to the
// sink as chunks, and ends there
pub struct BodyHead is Move {
  pub status: u16;
  pub version: Version;     // the protocol that carried it: Http11, or Http2
  pub headers: Headers;
  pub url: String;          // the URL that answered, after any redirects

  // Whether the status is a 2xx
  pub fn isOk(self: &) bool {status >= 200u16 && status < 300u16}
}

// The source end of a body sent to a sink (Client.streamTo): what the sink
// gives its buffers back to. The credit is the fetch's own window and no other:
// a buffer coming back releases its bytes to the client ('release', on the
// service thread), which is what lets the connection read on. The chunks
// themselves are sent from the service thread as the body arrives
// (streamservice.cone, onSinkEvent). A buffer given back in a cancelled group
// ends the fetch, so a consumer that quits stops the download
actor BodySource is ChunkSource {
  client: u64;
  slot: u32;
  id: u64;

  pub fn init(self: &new, client: u64, slot: u32, id: u64) {
    *self = Self(client: client, slot: slot, id: id);
  }

  // A chunk is finished with. The fetch gets back what its own record says it
  // lent in this buffer (known by its address), never the length the buffer
  // comes back with: a sink that trims a buffer cannot skew the credit. The
  // buffer itself goes in the job, and dies on the service thread after the
  // record is cleared, so its block cannot be reissued while a record of it stands
  pub async fn giveBack(self, b: IoBuf) {
    if actors.isCancelled() {
      post[StreamCancelJob](StreamCancelJob(client, slot, id));
    }
    post[StreamReleaseJob](StreamReleaseJob(client, slot, id, b));
  }
}
