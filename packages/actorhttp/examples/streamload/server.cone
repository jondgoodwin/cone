// streamload server: the server half of the streaming scenario (row 429, work item D2). An actorhttp
// server in a process of its own, so its memory is its own, answering the four traffic shapes of
// client.cone at once:
//
//   POST /small/N        reads the (small) body, answers N bytes of text
//   GET  /sse/N          N server-sent events (about 100 bytes each), flat out, then the stream ends
//   POST /up             reads the whole body as a stream (any size), answers "ok <bytes>"
//   GET  /down/BYTES     BYTES of body in 64 KiB pieces
//   GET  /_phase?name=X  the client's phase mark: prints "PHASE X <ms since start>" and answers ok
//   GET  /_quit          answers ok and ends the process
//
// Arguments: [port [workers [routed]]]: "routed" serves through a router's queue route (the routed server's
// connection actors) instead of the I/O thread's server. At the end it prints "IOTIMES user_ms U kernel_ms K wall_ms W":
// the I/O thread's own CPU (aio.ioThreadTimes), not all the CPU spent on I/O.
//
// Run by run.ps1; by hand: congo run --release packages/actorhttp/examples/streamload/server.cone -- <port>
// (port 0: it picks one; the line "LISTENING <port>" says which). Never a test: congo builds only the
// programs directly in examples/, and this one is in a folder of its own.

mod streamserver;

import stdio use *;
import thread;
import collections use List, String;
import time use Instant, Duration;
import iocore use SocketAddr;
import process;
import http use *;
import sse;
import actors;
import aio;
import actorhttp use Server, ServerConfig, Exchange, HttpRoutes;

let quit: Atomic[u64];
let started: Atomic[u64];

fn @initpure init() {
  quit = Atomic[u64].of(0u64);
  started = Atomic[u64].of(0u64);
}

fn nowMs() u64 { u64.from(Instant.now().nanos()) / 1000000u64 }

// the k-th '/'-separated number of a path ("/small/700": k 2 is 700)
fn field(p: &str, k: usize) u64 {
  let b = p as &Array[u8];
  var idx = 0usize;
  var i = 0usize;
  var v = 0u64;
  while i < b.len {
    let c = b[i];
    if c == 47u8 {
      idx = idx + 1usize;
    } else if idx == k && c >= 48u8 && c <= 57u8 {
      v = v * 10u64 + u64.from(c - 48u8);
    }
    i = i + 1usize;
  }
  v
}

fn filler(n: usize) String {
  var s = String();
  while s.len() < n { s.append("abcdefghijklmnopqrstuvwxyz0123456789 "); }
  var piece = List[u8].withCapacity(n);
  var i = 0usize;
  let b = s.view() as &Array[u8];
  while i < n { piece.push(b[i]); i = i + 1usize; }
  String.fromBytes(piece.view())
}

actor Handler {
  ex: Exchange;

  pub async fn run(self) {
    let path = String.from(ex.request.path());
    let p = path.view();
    let b = p as &Array[u8];
    let kind = if b.len > 1usize {b[1usize]} else {0u8};
    let kind2 = if b.len > 2usize {b[2usize]} else {0u8};
    let n2 = field(p, 2usize);
    if kind == 115u8 && kind2 == 109u8 {       // /small/N
      var rb = ex.body();
      let r = await rb.readAll(1048576usize);
      ex.respond(ResponseHead.make(200u16), filler(usize.from(n2)));
    } else if kind == 115u8 {                                         // /sse/N
      let count = n2;
      ex.startEvents();
      var i = 0u64;
      var going = true;
      while going && i < count {
        var text = String.from("event ");
        text.appendUInt(i);
        text.append(" 0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
        let e = sse.Event.message(text.view());
        let r = await ex.sendEvent(&e);
        match r {
          case is Ok {}
          case is Err { going = false; }
        }
        i = i + 1u64;
      }
      if going { let f = await ex.finish(); }
    } else if kind == 117u8 {                                         // /up
      var rb = ex.body();
      var total = 0u64;
      var going = true;
      while going {
        let n = await rb.read();
        match n {
          case let Ok(ok) {
            match ok {
              case let Some(piece) { total = total + u64.from(piece.len()); }
              case is None[String] { going = false; }
            }
          }
          case is Err { going = false; }
        }
      }
      var text = String.from("ok ");
      text.appendUInt(total);
      ex.respond(ResponseHead.make(200u16), text);
    } else if kind == 100u8 {                                         // /down/BYTES
      let total = n2;
      let piece = 65536usize;
      let one = filler(piece);
      ex.start(ResponseHead.make(200u16), BodyLength.sized(total));
      var at = 0u64;
      var going = true;
      while going && at < total {
        var w = one.clone();
        if total - at < u64.from(piece) { w = filler(usize.from(total - at)); }
        let r = await ex.write(w);
        match r {
          case is Ok { at = at + u64.from(piece); }
          case is Err { going = false; }
        }
      }
      if going { let f = await ex.finish(); }
    } else if kind == 95u8 && kind2 == 112u8 {   // /_phase?name=X
      printStr("PHASE ");
      printStr(ex.request.query());
      printStr(" ");
      printUInt(nowMs() - started.load());
      printStr("\n");
      ex.text(200u16, "ok\n");
    } else if kind == 95u8 {                                          // /_quit
      ex.text(200u16, "ok\n");
      quit.store(1u64);
    } else {
      ex.text(404u16, "not found\n");
    }
  }
}

actor Front {
  server: Server;

  pub async fn run(self, port: u16, routed: bool) {
    var cfg = ServerConfig.make().streamBodies();
    // routed: the connections are actors that route to the same queue ('server.next()' below), so the run measures the
    // routed server's path (row 562, S7) against the same load
    if routed {cfg = cfg.routes(HttpRoutes.make().queue("", "/"));}
    let r = await actorhttp.listen(SocketAddr.localhost(port), cfg);
    var res = r;
    match &mut res {
      case var &mut Ok(ok) {server <-> *ok;}
      case let &mut Err(e) {
        print <- e;
        printStr("\n");
        quit.store(2u64);
        return;
      }
    }
    printStr("LISTENING ");
    printUInt(u64.from(server.port()));
    printStr("\n");
    while true {
      let n = await server.next();
      match n {
        case var Ok(ok) {
          let h = Handler(ok);
          h.run();
        }
        case let Err(e) {break;}
      }
    }
  }
}

fn main() i32 {
  initAll();
  started.store(nowMs());
  let args = process.args();
  var port = 0u16;
  var workers = 4u32;
  if args.len() >= 2usize {
    match u64.parse(args[1usize].view()) {
      case let Ok(p) {port = u16.from(p);}
      case is Err {
        printStr("usage: server [port [workers]]\n");
        return 2i32;
      }
    }
  }
  if args.len() >= 3usize {
    match u64.parse(args[2usize].view()) {
      case let Ok(p) {workers = u32.from(p);}
      case is Err {}
    }
  }
  var routed = false;
  if args.len() >= 4usize && args[3usize].view() == "routed" {routed = true;}
  actors.configure(actors.Options(workers: workers));
  let front = Front(Server.none());
  front.run(port, routed);
  while quit.load() == 0u64 { thread.sleep(Duration.fromMillis(50i64)); }
  thread.sleep(Duration.fromMillis(200i64));
  finalAll();
  // the I/O thread's own CPU (not all the CPU spent on I/O: with the routed server the polling is in the workers' passes)
  let t = aio.ioThreadTimes();
  printStr("IOTIMES user_ms ");
  printUInt(t.userNs / 1000000u64);
  printStr(" kernel_ms ");
  printUInt(t.kernelNs / 1000000u64);
  printStr(" wall_ms ");
  printUInt(t.wallNs / 1000000u64);
  printStr("\n");
  if quit.load() == 2u64 { return 1i32; }
  0i32
}
