// No allocation per request on a kept-alive HTTP/1 connection of a routed server (S7, spec section 8). The silent
// failure it guards: the connection actor, the handler's Exchange or the response path allocates (a String, a
// message, a head) on every request, so a busy connection costs the allocator what a new one does.
// A raw client, in a process of its own (this program run again with "client"), holds one connection and sends
// 200 requests to warm it, then 5,000 more. The server's program counts its own malloc, calloc and realloc
// (as sconnalloc and aio's alloc test do), read by the handler at the start of request 200 and of request 5,200.
// The handler's own answer (head and body, 'ex.text') is measured alone beforehand and taken off.
// Checked: every reply is the same length; the server's allocations per request, beyond the handler's answer,
// are no more than today's 4.5.
// SPEC SECTION 8 ASKS FOR NONE ("no allocation per request on a kept-alive HTTP/1 connection"), AND IT IS NOT MET:
// today 4 allocations a request (debug build, Windows; the handler's own answer is 4 more). Row 604 took 8 away: the
// request head moves out and comes back to the core by the Exchange's drop message (a spare, refilled), the route is
// picked from views of the head, and the response head is filled straight into the connection's kept one. What is
// left is the three messages' payloads (handle, xRespond, xDrop: Cone malloc's region B) and, it seems, one IoBuf
// the response body is copied into (drainPends). httpconn alone allocates none (sconnalloc). The ceiling pins today's
// count so it cannot grow; lower it as the allocations go. (Dropping the spare's reuse, 'xDrop' not calling
// 'recycleRequest', makes it 6: the mutant check.)

mod keptalivealloc;

import stdio use *;
import libc;
import thread;
import sync use Channel, Sender, Receiver, Oneshot, OneshotSender, OneshotReceiver;
import collections use List, String;
import time use Instant, Duration;
import iocore use SocketAddr;
import iobuf use IoBuf;
import process;
import http use *;
import actors;
import aio;
import actorhttp use Server, ServerConfig, Exchange, HttpRoutes, HttpHandler;

var mallocs: Atomic[u64];
var atWarm: Atomic[u64];
var atEnd: Atomic[u64];

fn @initpure init() {
  mallocs = Atomic[u64].of(0u64);
  atWarm = Atomic[u64].of(0u64);
  atEnd = Atomic[u64].of(0u64);
}

#if #os == .windows {
  extern {
    fn @c("_malloc_base") winMalloc(size: usize) *u8;
    fn @c("_calloc_base") winCalloc(n: usize, size: usize) *u8;
    fn @c("_realloc_base") winRealloc(p: *u8, size: usize) *u8;
  }
} #else {
  extern {
    fn @c("__libc_malloc") lxMalloc(size: usize) *u8;
    fn @c("__libc_calloc") lxCalloc(n: usize, size: usize) *u8;
    fn @c("__libc_realloc") lxRealloc(p: *u8, size: usize) *u8;
  }
}

pub fn @c("malloc") countMalloc(size: usize) *u8 {
  mallocs.add(1u64);
  #if #os == .windows {winMalloc(size)} #else {lxMalloc(size)}
}

pub fn @c("calloc") countCalloc(n: usize, size: usize) *u8 {
  mallocs.add(1u64);
  #if #os == .windows {winCalloc(n, size)} #else {lxCalloc(n, size)}
}

pub fn @c("realloc") countRealloc(p: *u8, size: usize) *u8 {
  mallocs.add(1u64);
  #if #os == .windows {winRealloc(p, size)} #else {lxRealloc(p, size)}
}

fn say(s: &str, n: u64) {printStr(s); printStr(" "); printUInt(n); printStr("\n");}

actor Hello is HttpHandler {
  n: u64;
  fn init(self: &new) {*self = Self(n: 0u64);}

  pub async fn handle(self, var ex: Exchange) {
    // the count is read at the start of request 'warm' and again at the start of request 'warm + measured'
    if n == u64.from(warm) {atWarm.store(mallocs.load());}
    if n == u64.from(warm + measured) {atEnd.store(mallocs.load());}
    n = n + 1u64;
    ex.text(200u16, "hello");
  }
}

fn makeHello() HttpHandler {
  let h = Hello();
  let r: HttpHandler = h;
  r
}

actor Acceptor {
  server: Server;

  pub async fn open(self, cfg: ServerConfig, var ports: Sender[u16]) {
    let r = await actorhttp.listen(SocketAddr.localhost(0u16), cfg);
    var res = r;
    match &mut res {
      case var &mut Ok(ok) {server <-> *ok;}
      case let &mut Err(e) {printStr("listen failed: "); print <- e; printStr("\n"); libc.exit(1i32);}
    }
    ports.send(server.port());
  }

  pub async fn stop(self) {server.close();}
}

const warm = 200u32;
const measured = 5000u32;

actor Client {
  pub async fn run(self, port: u16, var done: Sender[u64]) {
    match await aio.connect(SocketAddr.localhost(port)) {
      case var Ok(s) {
        let req = "GET /x HTTP/1.1\r\nHost: h\r\n\r\n";
        var first = 0usize;
        var same = 0u64;
        var i = 0u32;
        while i < warm + measured + 1u32 {
          var b = IoBuf(req.len());
          b.append(req);
          let w = await s.write(b);
          var got = 0usize;
          var fin = false;
          var guard = 0u32;
          while !fin && guard < 50u32 {
            let r = await s.readIn(IoBuf(1024usize), aio.IoLimits.until(Instant.now() + Duration.fromSeconds(5i64)));
            match r {
              case let Ok(x) {
                got = got + x.len();
                if x.len() == 0usize || x.view()[x.len() - 1usize] == 0x6Fu8 {fin = true;}   // ends in "o" of hello
              }
              case let Err(e) {fin = true;}
            }
            guard = guard + 1u32;
          }
          if i == 0u32 {first = got;}
          if i >= warm && got == first && got > 0usize {same = same + 1u64;}
          i = i + 1u32;
        }
        done.send(same);
      }
      case let Err(e) {done.send(0u64);}
    }
  }
}

fn parsePort(s: &str) u16 {
  var v = 0u32;
  var i = 0usize;
  while i < s.len() {
    v = v * 10u32 + (u32.from(s[i]) - 0x30u32);
    i = i + 1usize;
  }
  u16.from(v)
}

// The client: one connection, 'warm + measured + 1' requests; prints how many replies of the measured ones matched the first
fn clientMain(port: u16) i32 {
  initAll();
  var dtx: Sender[u64];
  var drx: Receiver[u64];
  dtx, drx = Channel[u64].make();
  let cl = Client();
  cl.run(port, dtx.clone());
  let same = drx.recv() || 0u64;
  say("same", same);
  finalAll();
  0
}

fn main() i32 {
  let argv = process.args();
  if argv.len() > 2usize && argv[1usize].view() == "client" {return clientMain(parsePort(argv[2usize].view()));}
  initAll();
  // what the handler's own answer costs: the head and body that 'ex.text(200, "hello")' builds, alone (before any
  // server thread runs)
  var k = 0u32;
  let c0 = mallocs.load();
  while k < 1000u32 {
    var h = ResponseHead.make(200u16);
    h.headers.add("Content-Type", "text/plain; charset=utf-8");
    let body = String.from("hello");
    if body.len() != 5usize || h.status != 200u16 {libc.exit(1i32);}
    k = k + 1u32;
  }
  let perAnswer = (mallocs.load() - c0) / 1000u64;
  var ptx: Sender[u16];
  var prx: Receiver[u16];
  ptx, prx = Channel[u16].make();
  let cfg = ServerConfig.make().routes(HttpRoutes.make().handle("", "/", &makeHello));
  let acceptor = Acceptor(Server.none());
  acceptor.open(cfg, ptx.clone());
  let port = prx.recv() || 0u16;
  // the client is this program again, in a process of its own, so that its allocations are not counted
  var cmd = List[String]();
  match process.currentExe() {
    case let Ok(p) {cmd.push(String.from(p.view()));}
    case let Err(e) {printStr("no exe\n"); libc.exit(1i32);}
  }
  cmd.push(String.from("client"));
  var pt = String();
  pt.appendUInt(u64.from(port));
  cmd.push(pt);
  var sameOut = 0u64;
  match process.run(cmd.view(), process.Options(timeout: Duration.fromSeconds(120i64))) {
    case let Ok(o) {if o.success() && o.stdout.view().contains("same 5001") {sameOut = 1u64;}}
    case let Err(e) {printStr("client did not run\n");}
  }
  let used = atEnd.load() - atWarm.load();
  say("every reply matched the first", sameOut);
  // the server's own allocations, per request, in thousandths (the handler's answer taken off)
  let beyond = if used > perAnswer * u64.from(measured) {(used - perAnswer * u64.from(measured)) * 1000u64 / u64.from(measured)} else {0u64};
  say("measured", if atEnd.load() > 0u64 {1u64} else {0u64});
  say("server allocations per request no more than today's 4.5", if beyond <= 4500u64 {1u64} else {0u64});
  acceptor.stop();
  finalAll();
  0
}
