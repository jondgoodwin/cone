// A stale event driven through the Service: a connection record is freed and its cell reused by another; the first
// record's Closed event, carrying its old token, reaches nothing and leaves the new record untouched, while the new
// record's own event takes effect (service.cone, staleEventDropped; "WHY DROPPING A STALE EVENT IS SAFE").

mod stale;

import testing use *;
import actorhttp use *;

fn main() i32 {
  expect(staleEventDropped(), "a stale connection event is dropped and the cell's new record is untouched");
  done()
}
