// The client on actors (clientactor.cone), against a raw backend of this test's own (aio sockets, no HTTP library), so each
// connection's life is the test's to end. Checked:
// - a fetch whose connection dies after its request was read, with no answer, is sent again on a new connection and answered
//   exactly once (twenty times, each by a client of its own: the backend counts two connections each), and a POST there, which is
//   not safe to send again on a first-use connection, is answered Failed once and not sent again;
// - a client closed (its last handle dropped) while a fetch is in flight, one redirected and held, and one waiting for a
//   connection (maxPerOrigin 2): all three answered Cancelled, and no client actor and no connection actor is left alive.

mod clientactor;

import stdio use *;
import libc;
import thread;
import sync use Channel, Sender, Receiver;
import collections use List, String;
import time use Instant, Duration;
import testing use *;
import iobuf use *;
import iocore use SocketAddr;
import http use *;
import httpclient use Response, Request;
import actors;
import actorhttp use HttpClient, FetchError, liveClientActors, liveClientConnActors;
import aio use IoLimits;

let accepts: Atomic[u64];
let mode: Atomic[u64];       // 0: odd connections die unanswered, the rest answer; 1: /hold is held, /r redirects to it; 3: released

fn @initpure init() {
  accepts = Atomic[u64].of(0u64);
  mode = Atomic[u64].of(0u64);
}

const noBound = 0xFFFFFFFFFFFFFFFFusize;

// Whether the request text holds its blank line
fn whole(s: &String) bool {
  let b = s.view() as &Array[u8];
  var i = 0usize;
  while i + 3usize < b.len {
    if b[i] == 13u8 && b[i + 1usize] == 10u8 && b[i + 2usize] == 13u8 && b[i + 3usize] == 10u8 {return true;}
    i = i + 1usize;
  }
  false
}

// The request's path: between the first two spaces
fn pathOf(s: &String) String {
  let b = s.view() as &Array[u8];
  var i = 0usize;
  while i < b.len && b[i] != 32u8 {i = i + 1usize;}
  i = i + 1usize;
  var p = String();
  while i < b.len && b[i] != 32u8 {
    p.appendByte(b[i]);
    i = i + 1usize;
  }
  p
}

actor Backend {
  ls: aio.Socket;

  pub async fn open(self, ports: Sender[u16]) {
    let r = await aio.listen(SocketAddr.localhost(0u16));
    var res = r;
    match &mut res {
      case var &mut Ok(ok) {ls <-> *ok;}
      case let &mut Err(e) {printStr("listen failed\n"); libc.exit(1i32);}
    }
    var p = 0u16;
    match await ls.localAddr() {
      case let Ok(a) {p = a.port();}
      else {}
    }
    ports.send(p);
  }

  pub async fn serve(self) {
    while true {
      let r = await ls.acceptFromIn(IoLimits.none());
      match r {
        case let Ok(a) {
          let sock, peer = a.(sock, peer);
          let n = accepts.add(1u64) + 1u64;
          let c = BackendConn(sock, n);
          c.run();
        }
        case let Err(e) {break;}
      }
    }
  }
}

actor BackendConn {
  sock: aio.Socket;
  n: u64;

  pub async fn run(self) {
    while true {
      var req = String();
      while !whole(&req) {
        let r = await sock.readIn(IoBuf(4096usize), IoLimits.none());
        match r {
          case let Ok(b) {
            if b.len() == 0usize {return;}
            req.appendBytes(b.view());
          }
          case let Err(e) {return;}
        }
      }
      let path = pathOf(&req);
      let m = mode.load();
      var text = String.from("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok");
      if m == 0u64 {
        if n % 2u64 == 1u64 {
          // the connection dies with the request read and no answer
          var dead = aio.Socket.none();
          dead <-> sock;
          return;
        }
      } else {
        if path.view() == "/r" {
          text = String.from("HTTP/1.1 302 Found\r\nLocation: /hold\r\nContent-Length: 0\r\n\r\n");
        } else if m == 4u64 {
          // answered, and the connection kept open and idle
        } else {
          while mode.load() == 1u64 {
            let s = await aio.sleep(Duration.fromMillis(20i64));
          }
          return;
        }
      }
      var c = Chain.make(noBound);
      var b = IoBuf(text.len());
      b.append(text.view() as &Array[u8]);
      c.push(b);
      let w = await sock.writeIn(c, IoLimits.none());
      match w {
        case let Ok(k) {}
        case let Err(e) {return;}
      }
      if m == 0u64 {return;}
    }
  }
}

fn url(port: u16, path: &str) String {
  var u = String.from("http://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u
}

fn describe(r: &Result[Response, FetchError]) String {
  match r {
    case let &Ok(ok) {
      var s = String.from("ok ");
      s.appendUInt(u64.from(ok.status));
      s.append(" ");
      s.appendUInt(u64.from(ok.body.len()));
      s
    }
    case let &Err(e) {
      if e.isCancelled() {String.from("err cancelled")} else if e.isTimedOut() {String.from("err timedout")} else {String.from("err failed")}
    }
  }
}

actor Fetcher {
  client: HttpClient;

  pub async fn get(self, u: String, out: Sender[String]) {
    let r = await client.get(u.view());
    out.send(describe(&r));
  }

  pub async fn post(self, u: String, out: Sender[String]) {
    var req = Request.make("POST", u.view());
    req.body = String.from("data");
    let r = await client.send(req);
    out.send(describe(&r));
  }

  // The client handle let go
  pub async fn dropClient(self) {
    client = HttpClient.none();
  }
}

fn takeS(rx: &mut Receiver[String]) String {rx.recvTimeout(Duration.fromSeconds(20i64)) || String.from("(timeout)")}

// Both counters at 0 within seconds
fn gone() bool {
  let limit = Instant.now() + Duration.fromSeconds(10i64);
  while (liveClientActors() > 0u64 || liveClientConnActors() > 0u64) && Instant.now() < limit {
    thread.sleep(Duration.fromMillis(10i64));
  }
  liveClientActors() == 0u64 && liveClientConnActors() == 0u64
}

fn main() i32 {
  initAll();
  var ptx: Sender[u16];
  var prx: Receiver[u16];
  ptx, prx = Channel[u16].make();
  var otx: Sender[String];
  var orx: Receiver[String];
  otx, orx = Channel[String].make();
  let be = Backend(aio.Socket.none());
  be.open(ptx.clone());
  let port = prx.recv() || 0u16;
  require(port != 0u16, "the backend listens");
  be.serve();

  // A fetch whose connection dies mid-fetch: sent again, answered once
  var i = 0u32;
  var good = 0u32;
  while i < 20u32 {
    let f = Fetcher(HttpClient.standard());
    f.get(url(port, "/a"), otx.clone());
    if takeS(&mut orx).view() == "ok 200 2" {good = good + 1u32;}
    i = i + 1u32;
  }
  expectUInt(u64.from(good), 20u64, "twenty fetches, each on a connection that died once: each answered ok");
  expectUInt(accepts.load(), 40u64, "...each on two connections: sent again once, never twice");
  // (nothing more was answered: the next answer on the channel is the POST's)
  let p = Fetcher(HttpClient.standard());
  p.post(url(port, "/p"), otx.clone());
  expectStr(takeS(&mut orx).view(), "err failed", "a POST on a connection that died: answered Failed, once");
  expectUInt(accepts.load(), 41u64, "...and not sent again");
  p.dropClient();
  expect(gone(), "the clients and their connections are gone");

  // A client closed with a fetch in flight, one redirected and held, and one waiting
  mode.store(1u64);
  let a0 = accepts.load();
  var cfg = httpclient.Config.make();
  cfg.maxPerOrigin = 2u32;
  let h = Fetcher(HttpClient.make(cfg, actorhttp.defaultMaxBody));
  h.get(url(port, "/hold"), otx.clone());
  h.get(url(port, "/r"), otx.clone());
  h.get(url(port, "/hold"), otx.clone());
  thread.sleep(Duration.fromMillis(600i64));
  expectUInt(accepts.load() - a0, 2u64, "two connections: one fetch in flight, one redirected and held, a third waiting");
  expect(liveClientActors() > 0u64 && liveClientConnActors() > 0u64, "...a client actor and its connection actors are alive");
  h.dropClient();
  expectStr(takeS(&mut orx).view(), "err cancelled", "the closed client answers its first fetch Cancelled");
  expectStr(takeS(&mut orx).view(), "err cancelled", "...its second");
  expectStr(takeS(&mut orx).view(), "err cancelled", "...its third");
  expect(gone(), "no client actor and no connection actor outlives the closed client");
  mode.store(3u64);

  // A client closed with a connection kept open and idle: that connection goes too
  mode.store(4u64);
  let k = Fetcher(HttpClient.standard());
  k.get(url(port, "/idle"), otx.clone());
  expectStr(takeS(&mut orx).view(), "ok 200 2", "a fetch answered on a connection that is kept open");
  expect(liveClientConnActors() > 0u64, "...its connection actor is alive and idle");
  k.dropClient();
  expect(gone(), "the closed client's idle connection goes too");
  mode.store(3u64);
  done()
}
