// A sink token carries the low seven bits of its cell's generation (service.cone, "THE TOKEN"), and a lookup through
// a token reaches the entry only if the cell is live and those bits are its generation's. Checked on a pool of its own:
//
// 1. a live entry is found by its token, whatever flag bit (stream, connection, none) the token has;
// 2. once the entry is gone the token reaches nothing: its cell is free;
// 3. once the cell is reused, the old token reaches nothing and the new entry's token finds the new entry;
// 4. a stale token still reaches nothing after 127 reuses of its cell, and (the documented wrap) matches again at
//    the 128th, since seven bits are kept;
// 5. a token of another cell, or of no cell, reaches nothing.

mod tokens;

import testing use *;
import pools use GenPool, Handle;
import actorhttp use *;

fn found(h: Handle) bool { !h.isNone() }

fn main() i32 {
  var pool = GenPool[u32](16usize);
  let h1 = pool.add(11u32);
  let t1 = tokenOf(h1, 0u64);
  expect(found(byToken(&pool, t1)), "1: a live entry is found by its token");
  expect(found(byToken(&pool, tokenOf(h1, 0x100000000u64))), "1: and with the stream or connection bit set");
  expectUInt(u64.from(tokCell(t1)), u64.from(h1.index), "1: the token names the cell");
  expectUInt(u64.from(*pool.borrow(byToken(&pool, t1)).unwrap()), 11u64, "1: and the entry");

  _ = pool.remove(h1);
  expect(!found(byToken(&pool, t1)), "2: a freed entry's token reaches nothing");

  let h2 = pool.add(22u32);
  expectUInt(u64.from(h2.index), u64.from(h1.index), "3: the cell is reused");
  expect(!found(byToken(&pool, t1)), "3: the old token reaches nothing");
  expect(!found(byToken(&pool, tokenOf(h1, 0x100000000u64))), "3: with its flag bit too");
  expect(found(byToken(&pool, tokenOf(h2, 0u64))), "3: the new entry's token finds it");
  expectUInt(u64.from(*pool.borrow(byToken(&pool, tokenOf(h2, 0u64))).unwrap()), 22u64, "3: and it is the new entry");

  // 126 more reuses: 127 in all since t1
  var cur = h2;
  var k = 0;
  while k < 126 {
    _ = pool.remove(cur);
    cur = pool.add(33u32);
    k += 1;
  }
  expectUInt(u64.from(cur.index), u64.from(h1.index), "4: still the same cell");
  expect(!found(byToken(&pool, t1)), "4: after 127 reuses the stale token reaches nothing");
  _ = pool.remove(cur);
  cur = pool.add(44u32);
  expect(found(byToken(&pool, t1)), "4: at the 128th reuse seven bits wrap and the stale token matches (the documented odds)");
  expectUInt(u64.from(*pool.borrow(byToken(&pool, t1)).unwrap()), 44u64, "4: the entry it reaches is the cell's present one");

  expect(!found(byToken(&pool, tokenOf(Handle(h1.index + 1u32, h1.gen), 0u64))), "5: a token of another cell reaches nothing");
  expect(!found(byToken(&pool, tokenOf(Handle.none(), 0u64))), "5: a token of no cell reaches nothing");
  done()
}
