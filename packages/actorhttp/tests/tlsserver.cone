// A server through TLS (the package's header, A SERVER), on loopback, with the
// tls package's test certificates (tests/certs of the tls package: a test
// root, an intermediate and a server certificate for localhost and 127.0.0.1,
// made once with make-certs.sh and committed; nothing is installed on the
// machine). The server's actors answer a GET and a POST, and stream
// server-sent events, over the TLS the driver's layer gives each connection;
// the client is the package's own, which trusts the test root. Checked: the
// requests are marked secure and the server says it is; a client that does not
// trust the root is refused at the handshake (Stage.Tls), as is a plain
// client sent to the TLS port; and a server whose certificate cannot be loaded
// answers its listen with a Failure and no server.

mod tlsserver;

import stdio use *;
import fs;
import path use Path;
import sync use Channel, Sender, Receiver, Oneshot, OneshotSender, OneshotReceiver;
import collections use List, String;
import iocore use SocketAddr;
import http use *;
import httpclient use Response, Request;
import tls;
import sse;
import actors;
import actorhttp use Client, Server, ServerConfig, Exchange, FetchError, EventStream;

fn yes(b bool) &str {if b {"yes";} else {"NO";};}

// ---------------------------------------------------------------------------
// The server's side
// ---------------------------------------------------------------------------

actor Handler {
  ex Exchange;

  pub async do run(self) {
    imm path = String.from(ex.request.path());
    imm p = path.view();
    if p == "/events" {
      ex.startEvents();
      imm a = sse.Event.named("tls", "one");
      imm b = sse.Event.message("two");
      imm r1 = await ex.sendEvent(&a);
      imm r2 = await ex.sendEvent(&b);
      imm f = await ex.finish();
    } else {
      mut t = String.from(ex.request.methodName());
      t.append(" ");
      t.append(path.view());
      t.append(" ");
      if ex.request.secure {t.append("secure");} else {t.append("plain");}
      if ex.request.body.len() > 0usize {
        t.append(" ");
        t.append(ex.request.body.view());
      }
      ex.text(200u16, t.view());
    }
  }
}

actor Acceptor {
  server Server;

  pub async do open(self, cfg ServerConfig, ports Sender[u16], secure Sender[u64]) {
    imm r = await actorhttp.listen(SocketAddr.localhost(0u16), cfg);
    mut res = r;
    match &mut res {
      case mut ok &mut Ok {server <=> *ok;}
      case imm e &mut Error {
        printStr("listen failed, with a reason: ");
        printStr(yes(e.message().len() > 0usize and e.kind() == actorhttp.ServerErrorKind.Failed));
        printStr("\n");
      }
    }
    secure.send(if server.isSecure() {1u64;} else {0u64;});
    ports.send(server.port());
  }

  pub async do serve(self) {
    while true {
      imm n = await server.next();
      match n {
        case mut ok Ok {
          imm h = new Handler(ok);
          h.run();
        }
        case imm e Error {break;}
      }
    }
  }

  pub async do stop(self) {
    server.close();
  }
}

// ---------------------------------------------------------------------------
// The client's side
// ---------------------------------------------------------------------------

// The tls package's test certificates
fn certs(name &str) Path {
  mut p = String.from("../../../../../tls/tests/certs/");
  p.append(name);
  Path.fromString(p);
}

fn readText(name &str) String {
  mut out = String.empty();
  imm file = certs(name);
  match fs.readFile(&file) {
    case mut r Ok {out <=> r;}
    case imm e Error {}
  }
  out;
}

fn url(scheme &str, port u16, path &str) String {
  mut u = String.from(scheme);
  u.append("://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u;
}

// A client that trusts the test root (and asks no one else)
fn trusting() Client {
  mut cfg = httpclient.Config.make();
  cfg.tlsConfig.verify = tls.Verifier.roots(readText("ca.pem").view());
  cfg.tlsConfig.offline = true;
  Client.make(cfg, actorhttp.defaultMaxBody);
}

fn say(what &str, r Result[Response, FetchError]) {
  printStr(what);
  printStr(": ");
  match &r {
    case imm ok &Ok {
      printUInt(u64.from(ok.status));
      printStr(" ");
      printStr(ok.body.view());
      printStr("\n");
    }
    case imm e &Error {
      printStr("failed at ");
      printStr(httpclient.stageName(e.failure.stage));
      printStr("\n");
    }
  }
}

// Whether a fetch failed because the TLS was refused. The handshake's refusal
// ends the request at the TLS stage, unless the connection broke first (the
// peer's reset read, or it was already closed), which on a busy machine
// happens now and then
fn refusedTls(r Result[Response, FetchError]) bool {
  match &r {
    case imm e &Error {
      imm s = e.failure.stage;
      e.kind() == actorhttp.FetchErrorKind.Failed and (s == httpclient.Stage.Tls or s == httpclient.Stage.Read or
        s == httpclient.Stage.Closed);
    }
    else {false;}
  }
}

fn isOk(r Result[Response, FetchError]) bool {
  match &r {
    case imm ok &Ok {true;}
    else {false;}
  }
}

actor Prober {
  client Client;
  plain Client;

  pub async do run(self, port u16, done OneshotSender[u64]) {
    say("https get", await client.get(url("https", port, "/hello").view()));
    mut post = Request.make("POST", url("https", port, "/echo").view());
    post.body = String.from("over tls");
    say("https post", await client.send(post));
    say("https again", await client.get(url("https", port, "/again").view()));

    // Events over TLS
    imm r = await client.events(Request.get(url("https", port, "/events").view()));
    match r {
      case imm es Ok {
        printStr("events: status ");
        printUInt(u64.from(es.status));
        printStr(", event stream: ");
        printStr(yes(es.isEventStream()));
        printStr("\n");
        mut going = true;
        while going {
          imm n = await es.next();
          match n {
            case imm ok Ok {
              match ok {
                case imm ev Some {
                  printStr("  ");
                  printStr(ev.kind());
                  printStr(": ");
                  printStr(ev.data.view());
                  printStr("\n");
                }
                case is None[sse.Event] {going = false;}
              }
            }
            case imm er Error {
              printStr("  error\n");
              going = false;
            }
          }
        }
      }
      case imm e Error {printStr("events failed\n");}
    }

    // A client that does not trust the root, and one that does not speak TLS at all
    imm untrusting = await plain.get(url("https", port, "/hello").view());
    printStr("an untrusting client is refused at the handshake: ");
    printStr(yes(refusedTls(untrusting)));
    printStr("\n");
    imm unencrypted = await plain.get(url("http", port, "/hello").view());
    printStr("a plain client to the TLS port gets no answer: ");
    printStr(yes(not isOk(unencrypted)));
    printStr("\n");
    mut d = done;
    d.send(1u64);
  }
}

fn take[T](rx &mut Receiver[T], dflt T) T {
  match rx.recv() {
    case imm v Some {v;}
    else {dflt;}
  }
}

fn main() i32 {
  initAll();
  mut ptx Sender[u16];
  mut prx Receiver[u16];
  ptx, prx = Channel[u16].make();
  mut stx Sender[u64];
  mut srx Receiver[u64];
  stx, srx = Channel[u64].make();
  {
    // A TLS server
    imm certFile = certs("server.pem");
    imm keyFile = certs("server.key");
    imm cfg = ServerConfig.make().secure(tls.ServerConfig.make(&certFile, &keyFile));
    imm acceptor = new Acceptor(Server.none());
    acceptor.open(cfg, ptx.clone(), stx.clone());
    imm port = take[u16](&mut prx, 0u16);
    printStr("the server says it is secure: ");
    printStr(yes(take[u64](&mut srx, 0u64) == 1u64));
    printStr("\n");
    acceptor.serve();
    {
      mut tx OneshotSender[u64];
      mut rx OneshotReceiver[u64];
      tx, rx = Oneshot[u64].make();
      imm p = new Prober(trusting(), Client.standard());
      p.run(port, tx);
      rx.recv();
    }
    acceptor.stop();

    // A server whose key is not its certificate's
    imm badKey = certs("untrusted.key");
    imm bad = ServerConfig.make().secure(tls.ServerConfig.make(&certFile, &badKey));
    imm broken = new Acceptor(Server.none());
    broken.open(bad, ptx.clone(), stx.clone());
    imm bport = take[u16](&mut prx, 1u16);
    printStr("a server with the wrong key listens: ");
    printStr(yes(bport != 0u16 and bport != 1u16));
    printStr("\n");
  }
  finalAll();
  printStr("end\n");
  0i32;
}
