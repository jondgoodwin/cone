// Server-sent events both ways on loopback (the package's header, A SERVER and
// STREAMS): a Feed actor writes a stream of events from the server side, and a
// Reader actor reads them with the package's client, an EventStream. Checked:
// the first event reaches the reader while the response is still open (the
// rest is not sent until the reader has the first, so a response held back
// until it ended would never get there); every field of the events as they
// arrive, a comment between them dropped, the stream ending cleanly; a
// Last-Event-ID the client sent, and the Accept it asks for; a response that
// is no event stream ('isEventStream' says so) and an error status; a stream
// whose reader leaves (its EventStream dropped), which the server finds by a
// write answering Closed; the same body read as raw chunks (BodyStream); and
// a stream that stays silent, read under a deadline.

mod events;

import stdio use *;
import thread;
import sync use Channel, Sender, Receiver, Oneshot, OneshotSender, OneshotReceiver;
import collections use List, String;
import time use Instant, Duration;
import iocore use SocketAddr;
import http use *;
import httpclient use Request;
import sse;
import actors;
import actorhttp use Client, Server, ServerConfig, Exchange, FetchError, EventStream, BodyStream;
import aio use IoLimits;

fn say(s &str, n u64) {printStr(s); printStr(" "); printUInt(n); printStr("\n");}

fn yes(b bool) &str {if b {"yes";} else {"NO";};}

// ---------------------------------------------------------------------------
// The server's side
// ---------------------------------------------------------------------------

// Writes the events of "/events": the first at once, the rest when told
actor Feed {
  ex Exchange;

  pub async do start(self) {
    ex.startEvents();
    let e1 = sse.Event.named("hello", "first").withId("1");
    let r = await ex.sendEvent(&e1);
  }

  pub async do rest(self) {
    let e2 = sse.Event.message("two\nlines").withId("2");
    let r2 = await ex.sendEvent(&e2);
    let r3 = await ex.sendComment("ping");
    let e3 = sse.Event.named("done", "last").withId("3").withRetry(1000i64);
    let r4 = await ex.sendEvent(&e3);
    let f = await ex.finish();
  }
}

// Writes events every few milliseconds until its reader has gone
actor Endless {
  ex Exchange;

  pub async do run(self, left Sender[u64]) {
    ex.startEvents();
    var n = 0u64;
    var going = true;
    while going {
      var line = String.from("event ");
      line.appendUInt(n);
      let e = sse.Event.message(line.view());
      let w = await ex.sendEvent(&e);
      match w {
        case let ok Ok {n = n + 1u64;}
        case let er Error {going = false;}
      }
      thread.sleep(Duration.fromMillis(5i64));
    }
    left.send(n);
  }
}

// One event: the request's Last-Event-ID and Accept, as data
actor Resumer {
  ex Exchange;

  pub async do run(self) {
    var body = String.from("Last-Event-ID=");
    body.appendBytes(ex.request.header("last-event-id"));
    body.append(" Accept=");
    body.appendBytes(ex.request.header("accept"));
    ex.startEvents();
    let e = sse.Event.message(body.view()).withId("42");
    let w = await ex.sendEvent(&e);
    let f = await ex.finish();
  }
}

// A stream that says nothing
actor Silent {
  ex Exchange;

  pub async do run(self) {
    ex.startEvents();
  }
}

// Three chunks of a body: the first at once, the others when told
actor Chunker {
  ex Exchange;

  pub async do start(self) {
    ex.start(ResponseHead.make(200u16), BodyLength.unsized());
    let a = await ex.write(String.from("alpha "));
  }

  pub async do rest(self) {
    let b = await ex.write(String.from("beta "));
    let c = await ex.write(String.from("gamma"));
    let f = await ex.finish();
  }
}

actor Acceptor {
  server Server;
  feeds List[Feed];
  chunkers List[Chunker];
  silents List[Silent];
  left Sender[u64];

  pub async do open(self, ports Sender[u16]) {
    let r = await actorhttp.listen(SocketAddr.localhost(0u16), ServerConfig.make());
    var res = r;
    match &mut res {
      case var ok &mut Ok {server <=> *ok;}
      case let e &mut Error {printStr("listen failed: "); printStr(e.message().view()); printStr("\n");}
    }
    ports.send(server.port());
  }

  // The "/events" stream may go on
  pub async do release(self) {
    if feeds.len() > 0usize {feeds[0usize].rest();}
  }

  // The "/chunks" body may go on
  pub async do releaseChunks(self) {
    if chunkers.len() > 0usize {chunkers[0usize].rest();}
  }

  pub async do serve(self) {
    while true {
      let n = await server.next();
      match n {
        case var ok Ok {self.route(ok);}
        case let e Error {break;}
      }
    }
  }

  pub async do stop(self) {
    server.close();
  }

  fn route(self, ex Exchange) {
    let path = String.from(ex.request.path());
    let p = path.view();
    if p == "/events" {
      let f = new Feed(ex);
      f.start();
      feeds.push(f);
    } elif p == "/resume" {
      let r = new Resumer(ex);
      r.run();
    } elif p == "/endless" {
      let e = new Endless(ex);
      e.run(left.clone());
    } elif p == "/silent" {
      let s = new Silent(ex);
      s.run();
      silents.push(s);          // kept: an exchange dropped would end its stream
    } elif p == "/chunks" {
      let c = new Chunker(ex);
      c.start();
      chunkers.push(c);
    } elif p == "/plain" {
      var ex2 = ex;
      ex2.text(200u16, "just text");
    } else {
      var ex2 = ex;
      ex2.text(404u16, "not here");
    }
  }
}

// ---------------------------------------------------------------------------
// The client's side
// ---------------------------------------------------------------------------

fn url(port u16, path &str) String {
  var u = String.from("http://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u;
}

// 'name|data|id|retry', the data's line feeds as '/'
fn show(ev &sse.Event) {
  printStr("  ");
  printStr(ev.name.view());
  printStr("|");
  let d = ev.data.view() as &Array[u8];
  var k = 0usize;
  while k < d.len {
    if d[k] == '\n' {printStr("/");} else {printChar(u64.from(d[k]));}
    k = k + 1usize;
  }
  printStr("|");
  printStr(ev.id.view());
  printStr("|");
  printInt(ev.retry);
  printStr("\n");
}

fn why(e &FetchError) &str {
  if e.isTimedOut() {"timed out";} elif e.isCancelled() {"cancelled";} else {"failed";}
}

actor Reader {
  client Client;

  // "/events": every event, the stream ended cleanly
  pub async do ordered(self, port u16, acceptor Acceptor, done OneshotSender[u64]) {
    let r = await client.events(Request.get(url(port, "/events").view()));
    match r {
      case let es Ok {
        printStr("events: status ");
        printUInt(u64.from(es.status));
        printStr(", event stream: ");
        printStr(yes(es.isEventStream()));
        printStr("\n");
        var count = 0u64;
        var going = true;
        while going {
          let n = await es.next();
          match n {
            case let ok Ok {
              match ok {
                case let ev Some {
                  show(&ev);
                  count = count + 1u64;
                  if count == 1u64 {acceptor.release();}
                }
                case is None[sse.Event] {going = false;}
              }
            }
            case let er Error {
              printStr("  error: ");
              printStr(why(&er));
              printStr("\n");
              going = false;
            }
          }
        }
        say("events read:", count);
      }
      case let e Error {printStr("events failed\n");}
    }
    var d = done;
    d.send(1u64);
  }

  // "/resume": the Last-Event-ID the client sent comes back as data
  pub async do resume(self, port u16, done OneshotSender[u64]) {
    var req = Request.get(url(port, "/resume").view());
    req.headers.add("Last-Event-ID", "41");
    let r = await client.events(req);
    match r {
      case let es Ok {
        let n = await es.next();
        match n {
          case let ok Ok {
            match ok {
              case let ev Some {show(&ev);}
              case is None[sse.Event] {printStr("  no event\n");}
            }
          }
          case let er Error {printStr("  error\n");}
        }
      }
      case let e Error {printStr("resume failed\n");}
    }
    var d = done;
    d.send(1u64);
  }

  // Two paths that are no event stream
  pub async do notStreams(self, port u16, done OneshotSender[u64]) {
    let r = await client.events(Request.get(url(port, "/plain").view()));
    match r {
      case let es Ok {
        printStr("plain: status ");
        printUInt(u64.from(es.status));
        printStr(", event stream: ");
        printStr(yes(es.isEventStream()));
        printStr("\n");
        let n = await es.next();
        match n {
          case let ok Ok {
            match ok {
              case let ev Some {printStr("  an event?\n");}
              case is None[sse.Event] {printStr("  ended with no events\n");}
            }
          }
          case let er Error {printStr("  error\n");}
        }
      }
      case let e Error {printStr("plain failed\n");}
    }
    let r2 = await client.events(Request.get(url(port, "/other").view()));
    match r2 {
      case let es Ok {
        printStr("other: status ");
        printUInt(u64.from(es.status));
        printStr(", event stream: ");
        printStr(yes(es.isEventStream()));
        printStr(", ok: ");
        printStr(yes(es.isOk()));
        printStr("\n");
      }
      case let e Error {printStr("other failed\n");}
    }
    var d = done;
    d.send(1u64);
  }

  // Reads two events of "/endless" and goes: the EventStream is dropped
  pub async do leave(self, port u16, done OneshotSender[u64]) {
    {
      let r = await client.events(Request.get(url(port, "/endless").view()));
      match r {
        case let es Ok {
          var got = 0u64;
          while got < 2u64 {
            let n = await es.next();
            match n {
              case let ok Ok {got = got + 1u64;}
              case let er Error {got = 100u64;}
            }
          }
          say("endless: events read before leaving:", got);
        }
        case let e Error {printStr("endless failed\n");}
      }
    }
    var d = done;
    d.send(1u64);
  }

  // A body in chunks
  pub async do chunks(self, port u16, acceptor Acceptor, done OneshotSender[u64]) {
    let r = await client.stream(Request.get(url(port, "/chunks").view()));
    match r {
      case let bs Ok {
        printStr("chunks: status ");
        printUInt(u64.from(bs.status));
        printStr(", ok: ");
        printStr(yes(bs.isOk()));
        printStr("\n");
        var all = String.empty();
        var pieces = 0u64;
        var going = true;
        while going {
          let n = await bs.read();
          match n {
            case let ok Ok {
              match ok {
                case let piece Some {
                  all.append(piece.view());
                  pieces = pieces + 1u64;
                  if pieces == 1u64 {acceptor.releaseChunks();}
                }
                case is None[String] {going = false;}
              }
            }
            case let er Error {
              printStr("  error\n");
              going = false;
            }
          }
        }
        printStr("  body: ");
        printStr(all.view());
        printStr("\n");
        printStr("  arrived in several pieces: ");
        printStr(yes(pieces >= 2u64));
        printStr("\n");
      }
      case let e Error {printStr("chunks failed\n");}
    }
    var d = done;
    d.send(1u64);
  }

  // A stream that says nothing, read for a second
  pub async do silent(self, port u16, done OneshotSender[u64]) {
    let lim = IoLimits.until(Instant.now() + Duration.fromMillis(1000i64));
    let r = await client.eventsIn(Request.get(url(port, "/silent").view()), lim);
    match r {
      case let es Ok {
        printStr("silent: opened, ");
        let n = await es.next();
        match n {
          case let ok Ok {printStr("something arrived or it ended\n");}
          case let er Error {printStr(why(&er)); printStr("\n");}
        }
      }
      case let er Error {printStr("silent: "); printStr(why(&er)); printStr(" before it opened\n");}
    }
    var d = done;
    d.send(1u64);
  }
}

fn take[T](rx &mut Receiver[T], dflt T) T {
  match rx.recv() {
    case let v Some {v;}
    else {dflt;}
  }
}

fn main() i32 {
  initAll();
  var ptx Sender[u16];
  var prx Receiver[u16];
  ptx, prx = Channel[u16].make();
  var ltx Sender[u64];
  var lrx Receiver[u64];
  ltx, lrx = Channel[u64].make();
  {
    let acceptor = new Acceptor(Server.none(), List[Feed].empty(), List[Chunker].empty(), List[Silent].empty(), ltx.clone());
    acceptor.open(ptx.clone());
    let port = take[u16](&mut prx, 0u16);
    acceptor.serve();
    let reader = new Reader(Client.standard());
    var tx OneshotSender[u64];
    var rx OneshotReceiver[u64];

    tx, rx = Oneshot[u64].make();
    reader.ordered(port, acceptor, tx);
    rx.recv();

    tx, rx = Oneshot[u64].make();
    reader.resume(port, tx);
    rx.recv();

    tx, rx = Oneshot[u64].make();
    reader.notStreams(port, tx);
    rx.recv();

    tx, rx = Oneshot[u64].make();
    reader.chunks(port, acceptor, tx);
    rx.recv();

    tx, rx = Oneshot[u64].make();
    reader.silent(port, tx);
    rx.recv();

    tx, rx = Oneshot[u64].make();
    reader.leave(port, tx);
    rx.recv();
    // The server finds out by a write that answers Closed
    match lrx.recvTimeout(Duration.fromSeconds(10i64)) {
      case let n Some {printStr("endless: the server saw its reader leave: "); printStr(yes(n >= 2u64)); printStr("\n");}
      case is None[u64] {printStr("endless: the server never saw its reader leave\n");}
    }
    acceptor.stop();
  }
  finalAll();
  printStr("end\n");
  0i32;
}
