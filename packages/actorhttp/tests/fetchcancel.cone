// A whole-body fetch ended by its cancel group runs on the client actor (clientactor.cone, FetchWake): the group's cancel
// reaches the core as a Cancel, which answers the caller Cancelled, once, and has the exchange stopped. Against a raw backend of
// this test's own, so each stage the fetch can be in is held:
// - while it waits for a connection (maxPerOrigin 1, the connection held by another fetch with no group);
// - while it waits for the response's head (the request read, nothing answered);
// - during the body (the head and a few body bytes sent, the rest held).
// Each is answered Cancelled once; the connection that carried the cancelled exchange is closed by the client (the backend sees
// it end), the one that did not is left to its other fetch; and no client actor or connection actor is left alive.
// Also: a group cancelled while the fetch is queued in a client whose other fetch then finishes, and a group that outlives its
// fetch (cancelled after the answer) does nothing and holds no client actor.

mod fetchcancel;

import stdio use *;
import libc;
import thread;
import sync use Channel, Sender, Receiver;
import collections use List, String;
import time use Instant, Duration;
import testing use *;
import iobuf use *;
import iocore use SocketAddr, CancelGroup;
import http use *;
import httpclient use Response, Request;
import actors;
import actorhttp use HttpClient, FetchError, liveClientActors, liveClientConnActors;
import aio use IoLimits;

let accepts: Atomic[u64];
let ended: Atomic[u64];        // backend connections whose peer closed them
let mode: Atomic[u64];         // 0: hold; 3: release the held

fn @initpure init() {
  accepts = Atomic[u64].of(0u64);
  ended = Atomic[u64].of(0u64);
  mode = Atomic[u64].of(0u64);
}

const noBound = 0xFFFFFFFFFFFFFFFFusize;

fn whole(s: &String) bool {
  let b = s.view() as &Array[u8];
  var i = 0usize;
  while i + 3usize < b.len {
    if b[i] == 13u8 && b[i + 1usize] == 10u8 && b[i + 2usize] == 13u8 && b[i + 3usize] == 10u8 {return true;}
    i = i + 1usize;
  }
  false
}

fn pathOf(s: &String) String {
  let b = s.view() as &Array[u8];
  var i = 0usize;
  while i < b.len && b[i] != 32u8 {i = i + 1usize;}
  i = i + 1usize;
  var p = String();
  while i < b.len && b[i] != 32u8 {
    p.appendByte(b[i]);
    i = i + 1usize;
  }
  p
}

actor Backend {
  ls: aio.Socket;

  pub async fn open(self, ports: Sender[u16]) {
    let r = await aio.listen(SocketAddr.localhost(0u16));
    var res = r;
    match &mut res {
      case var &mut Ok(ok) {ls <-> *ok;}
      case let &mut Err(e) {printStr("listen failed\n"); libc.exit(1i32);}
    }
    var p = 0u16;
    match await ls.localAddr() {
      case let Ok(a) {p = a.port();}
      else {}
    }
    ports.send(p);
  }

  pub async fn serve(self) {
    while true {
      let r = await ls.acceptFromIn(IoLimits.none());
      match r {
        case let Ok(a) {
          let sock, peer = a.(sock, peer);
          accepts.add(1u64);
          let c = BackendConn(sock);
          c.run();
        }
        case let Err(e) {break;}
      }
    }
  }
}

actor BackendConn {
  sock: aio.Socket;

  // Reads the request; answers by its path (/head: nothing, /body: a head and ten body bytes of a hundred, /ok: a whole answer,
  // /hold: nothing, until released); then reads until the peer ends the connection
  pub async fn run(self) {
    var req = String();
    while !whole(&req) {
      let r = await sock.readIn(IoBuf(4096usize), IoLimits.none());
      match r {
        case let Ok(b) {
          if b.len() == 0usize {ended.add(1u64); return;}
          req.appendBytes(b.view());
        }
        case let Err(e) {ended.add(1u64); return;}
      }
    }
    let path = pathOf(&req);
    var text = String();
    if path.view() == "/body" {
      text = String.from("HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\n0123456789");
    } else if path.view() == "/ok" {
      text = String.from("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok");
    } else if path.view() == "/hold" {
      while mode.load() == 0u64 {
        let s = await aio.sleep(Duration.fromMillis(20i64));
      }
      text = String.from("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok");
    }
    if text.len() > 0usize {
      var c = Chain.make(noBound);
      var b = IoBuf(text.len());
      b.append(text.view() as &Array[u8]);
      c.push(b);
      let w = await sock.writeIn(c, IoLimits.none());
      match w {
        case let Ok(k) {}
        case let Err(e) {ended.add(1u64); return;}
      }
    }
    while true {
      let r = await sock.readIn(IoBuf(4096usize), IoLimits.none());
      match r {
        case let Ok(b) {if b.len() == 0usize {break;}}
        case let Err(e) {break;}
      }
    }
    ended.add(1u64);
  }
}

fn url(port: u16, path: &str) String {
  var u = String.from("http://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u
}

fn describe(r: &Result[Response, FetchError]) String {
  match r {
    case let &Ok(ok) {
      var s = String.from("ok ");
      s.appendUInt(u64.from(ok.status));
      s.append(" ");
      s.appendUInt(u64.from(ok.body.len()));
      s
    }
    case let &Err(e) {
      if e.isCancelled() {String.from("err cancelled")} else if e.isTimedOut() {String.from("err timedout")} else {String.from("err failed")}
    }
  }
}

actor Fetcher {
  client: HttpClient;

  pub async fn get(self, u: String, out: Sender[String]) {
    let r = await client.get(u.view());
    out.send(describe(&r));
  }

  pub async fn getIn(self, u: String, g: CancelGroup, out: Sender[String]) {
    let r = await client.getIn(u.view(), IoLimits.within(g));
    out.send(describe(&r));
  }

  pub async fn dropClient(self) {
    client = HttpClient.none();
  }
}

fn takeS(rx: &mut Receiver[String]) String {rx.recvTimeout(Duration.fromSeconds(20i64)) || String.from("(timeout)")}

fn gone() bool {
  let limit = Instant.now() + Duration.fromSeconds(10i64);
  while (liveClientActors() > 0u64 || liveClientConnActors() > 0u64) && Instant.now() < limit {
    thread.sleep(Duration.fromMillis(10i64));
  }
  liveClientActors() == 0u64 && liveClientConnActors() == 0u64
}

// Whether the backend's count of ended connections reaches n within seconds
fn endedReaches(n: u64) bool {
  let limit = Instant.now() + Duration.fromSeconds(10i64);
  while ended.load() < n && Instant.now() < limit {
    thread.sleep(Duration.fromMillis(10i64));
  }
  ended.load() >= n
}

fn main() i32 {
  initAll();
  var ptx: Sender[u16];
  var prx: Receiver[u16];
  ptx, prx = Channel[u16].make();
  var otx: Sender[String];
  var orx: Receiver[String];
  otx, orx = Channel[String].make();
  let be = Backend(aio.Socket.none());
  be.open(ptx.clone());
  let port = prx.recv() || 0u16;
  require(port != 0u16, "the backend listens");
  be.serve();

  // Cancelled while the response's head is awaited: answered Cancelled once, the connection ended by the client
  let f1 = Fetcher(HttpClient.standard());
  let g1 = CancelGroup.make();
  f1.getIn(url(port, "/head"), g1, otx.clone());
  thread.sleep(Duration.fromMillis(300i64));
  expectUInt(accepts.load(), 1u64, "the fetch is on a connection, its head awaited");
  g1.cancel();
  expectStr(takeS(&mut orx).view(), "err cancelled", "cancelled while its head is awaited: answered Cancelled");
  expect(endedReaches(1u64), "...and the connection that carried it is closed");
  f1.dropClient();
  expect(gone(), "...no client actor or connection actor is left");

  // Cancelled during the body
  let f2 = Fetcher(HttpClient.standard());
  let g2 = CancelGroup.make();
  f2.getIn(url(port, "/body"), g2, otx.clone());
  thread.sleep(Duration.fromMillis(300i64));
  expectUInt(accepts.load(), 2u64, "the second fetch is on a connection, part of its body in");
  g2.cancel();
  expectStr(takeS(&mut orx).view(), "err cancelled", "cancelled during the body: answered Cancelled");
  expect(endedReaches(2u64), "...and its connection is closed");
  f2.dropClient();
  expect(gone(), "...no client actor or connection actor is left");

  // Cancelled while it waits for a connection: the connection another fetch holds is not touched
  var cfg = httpclient.Config.make();
  cfg.maxPerOrigin = 1u32;
  let f3 = Fetcher(HttpClient.make(cfg, actorhttp.defaultMaxBody));
  f3.get(url(port, "/hold"), otx.clone());
  thread.sleep(Duration.fromMillis(300i64));
  expectUInt(accepts.load(), 3u64, "the first fetch holds the one connection");
  let g3 = CancelGroup.make();
  f3.getIn(url(port, "/ok"), g3, otx.clone());
  thread.sleep(Duration.fromMillis(300i64));
  expectUInt(accepts.load(), 3u64, "the second waits for a connection");
  g3.cancel();
  expectStr(takeS(&mut orx).view(), "err cancelled", "cancelled while it waits for a connection: answered Cancelled");
  expectUInt(ended.load(), 2u64, "...and the held connection is left alone");
  mode.store(3u64);
  expectStr(takeS(&mut orx).view(), "ok 200 2", "...so its fetch is answered when released");
  f3.dropClient();
  expect(gone(), "...no client actor or connection actor is left");

  // A group cancelled before the fetch starts: answered Cancelled at once; and cancelled after the fetch is answered: nothing
  let f4 = Fetcher(HttpClient.standard());
  let g4 = CancelGroup.make();
  g4.cancel();
  f4.getIn(url(port, "/ok"), g4, otx.clone());
  expectStr(takeS(&mut orx).view(), "err cancelled", "a group cancelled before the fetch: answered Cancelled");
  let g5 = CancelGroup.make();
  f4.getIn(url(port, "/ok"), g5, otx.clone());
  expectStr(takeS(&mut orx).view(), "ok 200 2", "a fetch finished before its group is cancelled: answered ok");
  g5.cancel();
  f4.dropClient();
  expect(gone(), "...the group, cancelled later, holds no client actor");
  done()
}
