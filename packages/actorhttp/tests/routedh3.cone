// A routed server given 'offerHttp3' that cannot serve it answers an error from 'listen' instead of ignoring the request:
// without TLS (HTTP/3 needs it), and with a plug-in that makes no acceptor (the routed server's endpoint is made from it;
// the working case is h3driver's routedh3 test, since only h3driver can name a real plug-in). The control: the same routes
// without 'offerHttp3' listen.

mod routedh3;

import stdio use *;
import sync use Channel, Sender, Receiver;
import collections use List, String;
import time use Instant, Duration;
import iocore use SocketAddr;
import http use *;
import tls;
import actors;
import httpclient;
import actorhttp use Server, ServerConfig, HttpRoutes, ServerError;
import testing use *;
import path use Path;

/// A plug-in maker whose plug-in makes no acceptor (httpclient's NoHttp3: the trait's default answers 'no HTTP/3 acceptor')
fn nothing(t: &tls.ClientConfig) Uni[httpclient.Http3] {
  Uni[httpclient.NoHttp3](httpclient.NoHttp3.make())
}

actor Lis {
  pub async fn go(self, cfg: ServerConfig, var out: Sender[String]) {
    let r = await actorhttp.listen(SocketAddr.localhost(0u16), cfg);
    var res = r;
    match &mut res {
      case var &mut Ok(ok) {
        ok.close();
        out.send(String.from("listening"));
      }
      case let &mut Err(e) {out.send(String() <- e);}
    }
  }
}

fn tryListen(cfg: ServerConfig) String {
  var tx: Sender[String];
  var rx: Receiver[String];
  tx, rx = Channel[String].make();
  Lis().go(cfg, tx);
  match rx.recvTimeout(Duration.fromMillis(5000i64)) {
    case let Some(s) {return s;}
    case is None[String] {}
  }
  String.from("no answer")
}

fn certs(name: &str) Path {
  var p = String.from("../../../../../tls/tests/certs/");
  p.append(name);
  Path.fromString(p)
}

fn main() i32 {
  let routes = HttpRoutes.make().queue("", "/");
  let ok = tryListen(ServerConfig.make().routes(routes));
  expectStr(ok.view(), "listening", "a routed server without offerHttp3 listens");
  let plain = tryListen(ServerConfig.make().routes(HttpRoutes.make().queue("", "/")).offerHttp3(&nothing));
  expectStr(plain.view(), "HTTP/3 needs TLS: ServerConfig.secure", "offerHttp3 without TLS answers an error");
  let certFile = certs("server.pem");
  let keyFile = certs("server.key");
  let noAcceptor = tryListen(ServerConfig.make().secure(tls.ServerConfig.make(&certFile, &keyFile))
    .routes(HttpRoutes.make().queue("", "/")).offerHttp3(&nothing));
  expect(noAcceptor.view().contains("no HTTP/3 acceptor"), "a plug-in with no acceptor answers an error");
  printStr("routedh3: ");
  printStr(noAcceptor.view());
  printStr("\n");
  printStr("routedh3: ");
  printStr(plain.view());
  printStr("\n");
  0i32
}
