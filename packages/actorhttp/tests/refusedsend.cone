// A response whose bytes the buffer pool refuses a buffer for fails that one request and the server goes on (iobuf, THE
// RESERVE: a client that asks and does not read fills the pool; a plain construction there would panic the process). The
// test actor takes each request from the queue route, takes every buffer of a class the try bank will give, and answers.
// HTTP/1.1 (plain TCP) and HTTP/2 (TLS), each: the handler's write answers closed, the client's fetch fails, the
// refusal is counted, and the server answers the next request. HTTP/2 also: a request in hand on the same connection is
// answered after (the stream was reset, not the connection). Then HTTP/1.1, a request dropped without an answer: the
// library's own 500 gets no buffer either.
// The receive buffers of both ends are 64 KiB, so taking the 16 KiB and 4 KiB classes leaves the receives alone.

mod refusedsend;

import stdio use *;
import libc;
import fs;
import sync use Channel, Sender, Receiver, Oneshot, OneshotSender, OneshotReceiver;
import collections use List, String;
import iobuf use IoBuf, stats;
import iocore use SocketAddr;
import http use *;
import httpclient;
import tls;
import actors;
import aio;
import time use Duration;
import path use Path;
import actorhttp use HttpClient, Server, ServerConfig, Exchange, FetchError, HttpRoutes;

const recvBytes = 65536usize;

fn yes(b: bool) &str {if b {"yes"} else {"NO"}}

fn certs(name: &str) Path {
  var p = String.from("../../../../../tls/tests/certs/");
  p.append(name);
  Path.fromString(p)
}

fn readText(name: &str) String {
  var out = String();
  let file = certs(name);
  match fs.readFile(&file) {
    case var Ok(r) {out <-> r;}
    case let Err(e) {}
  }
  out
}

fn url(secure: bool, port: u16, path: &str) String {
  var u = String.from(if secure {"https://127.0.0.1:"} else {"http://127.0.0.1:"});
  u.appendUInt(u64.from(port));
  u.append(path);
  u
}

fn client(h2: bool) HttpClient {
  var cfg = httpclient.Config.make();
  cfg.conn.recvSize = recvBytes;
  cfg.http2 = h2;
  cfg.maxRetries = 0u32;
  if h2 {
    cfg.tlsConfig.verify = tls.Verifier.roots(readText("ca.pem").view());
    cfg.tlsConfig.offline = true;
  }
  HttpClient.make(cfg, actorhttp.defaultMaxBody)
}

// Every buffer of a class the try bank will give, held
fn hoard(size: usize, held: &mut List[IoBuf]) {
  while true {
    match IoBuf.tryMake(size) {
      case var Some(b) {held.push(b);}
      else {break;}
    }
  }
}

fn piece() String {
  var s = String.withCapacity(1048576usize);
  var i = 0usize;
  while i < 1048576usize {
    s.appendByte(97u8);
    i = i + 1usize;
  }
  s
}

// The server's side: takes the requests of the queue route in turn
actor Taker {
  server: Server;

  pub async fn open(self, cfg: ServerConfig, var ports: Sender[u16]) {
    let r = await actorhttp.listen(SocketAddr.localhost(0u16), cfg);
    var res = r;
    match &mut res {
      case var &mut Ok(ok) {server <-> *ok;}
      case let &mut Err(e) {printStr("listen failed\n"); libc.exit(1i32);}
    }
    ports.send(server.port());
  }

  // /nap is kept until /fill has been answered; /fill is answered with the 16 KiB class taken; /drop is dropped with the
  // 4 KiB class taken; anything else is answered. Reports once /fill or /drop is done
  pub async fn serve(self, want: u32, var done: OneshotSender[u64]) {
    var kept = List[Exchange]();
    var held = List[IoBuf]();
    var left = want;
    var report = 0u64;
    // a buffer of each class used here stays in the try bank, so its slab has free blocks while the rest are taken
    var pins = List[IoBuf]();
    match IoBuf.tryMake(4096usize) {case var Some(b) {pins.push(b);} else {}}
    match IoBuf.tryMake(recvBytes) {case var Some(b) {pins.push(b);} else {}}
    while left > 0u32 {
      left = left - 1u32;
      match await server.next() {
        case var Ok(got) {
          var ex = got;
          let p = String.from(ex.request.path());
          if p.view() == "/nap" {
            kept.push(ex);
          } else if p.view() == "/fill" {
            hoard(16384usize, &mut held);
            ex.start(ResponseHead.make(200u16), BodyLength.unsized());
            let w = await ex.write(piece());
            held = List[IoBuf]();
            report = match w {
              case is Ok {0u64}
              case is Err {1u64}
            };
          } else if p.view() == "/drop" {
            hoard(4096usize, &mut held);
            // 'ex' dies here: no answer, so the library says 500
          } else {
            ex.text(200u16, "hello");
          }
          // the hoard of a '/drop' is let go once the connection has acted on it: the count of refusals answers after it
          if p.view() == "/drop" {
            var n = 0u64;
            var tries = 0u32;
            while n < 2u64 && tries < 500u32 {
              await aio.sleep(Duration.fromMillis(5i64));
              n = await server.refusedBuffers();
              tries = tries + 1u32;
            }
            held = List[IoBuf]();
            report = n;
          }
        }
        case let Err(e) {break;}
      }
    }
    while kept.len() > 0usize {
      var ex = kept.pop().unwrap();
      ex.text(200u16, "rested");
    }
    done.send(report);
  }

  pub async fn count(self, var done: OneshotSender[u64]) {done.send(await server.refusedBuffers());}

  pub async fn stop(self) {server.close();}
}

fn failed(r: &Result[httpclient.Response, FetchError]) bool {
  match r {
    case is Ok {false}
    case is Err {true}
  }
}

fn bodyIs(r: &Result[httpclient.Response, FetchError], want: &str) bool {
  match r {
    case let &Ok(x) {x.status == 200u16 && x.body.view() == want}
    case is Err {false}
  }
}

actor Fetch {
  client: HttpClient;

  pub async fn run(self, u: String, want: String, var done: OneshotSender[u64]) {
    let r = await client.get(u.view());
    let ok = if want.len() == 0usize {failed(&r)} else {bodyIs(&r, want.view())};
    done.send(if ok {1u64} else {0u64});
  }
}

fn fetch(c: &HttpClient, u: String, want: &str) OneshotReceiver[u64] {
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  Fetch(c.clone()).run(u, String.from(want), tx);
  rx
}

fn say(proto: &str, what: &str, ok: bool) {
  printStr(proto);
  printStr(": ");
  printStr(what);
  printStr(": ");
  printStr(yes(ok));
  printStr("\n");
}

fn serving(taker: &Taker, want: u32) OneshotReceiver[u64] {
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  taker.serve(want, tx);
  rx
}

fn counted(taker: &Taker) u64 {
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  taker.count(tx);
  rx.recv() || 0u64
}

fn start(secure: bool) (Taker, u16) {
  var ptx: Sender[u16];
  var prx: Receiver[u16];
  ptx, prx = Channel[u16].make();
  var cfg = ServerConfig.make().routes(HttpRoutes.make().queue("", "/"));
  cfg.conn.recvSize = recvBytes;
  if secure {
    let certFile = certs("server.pem");
    let keyFile = certs("server.key");
    cfg = cfg.secure(tls.ServerConfig.make(&certFile, &keyFile)).offerHttp2();
  }
  let taker = Taker(Server.none());
  taker.open(cfg, ptx.clone());
  let port = prx.recv() || 0u16;
  taker, port
}

fn http1() {
  var taker: Taker;
  var port: u16;
  taker, port = start(false);
  let c = client(false);
  let first = serving(&taker, 1u32);
  let hello = fetch(&c, url(false, port, "/hello"), "hello");
  say("HTTP/1.1", "a request is answered", (hello.recv() || 0u64) == 1u64);
  let one = first.recv() || 9u64;
  let second = serving(&taker, 1u32);
  let fill = fetch(&c, url(false, port, "/fill"), "");
  say("HTTP/1.1", "the write answers closed", (second.recv() || 0u64) == 1u64);
  say("HTTP/1.1", "the fetch fails", (fill.recv() || 0u64) == 1u64);
  say("HTTP/1.1", "one refusal counted", counted(&taker) == 1u64);
  let third = serving(&taker, 1u32);
  let again = fetch(&c, url(false, port, "/hello"), "hello");
  say("HTTP/1.1", "the next request is answered", (again.recv() || 0u64) == 1u64);
  let three = third.recv() || 9u64;
  let fourth = serving(&taker, 1u32);
  let dropped = fetch(&c, url(false, port, "/drop"), "");
  say("HTTP/1.1", "an unanswered request's 500 refused, counted", (fourth.recv() || 0u64) == 2u64);
  say("HTTP/1.1", "its fetch fails", (dropped.recv() || 0u64) == 1u64);
  let fifth = serving(&taker, 1u32);
  let after = fetch(&c, url(false, port, "/hello"), "hello");
  say("HTTP/1.1", "and the server still serves", (after.recv() || 0u64) == 1u64);
  let five = fifth.recv() || 9u64;
  taker.stop();
}

fn http2() {
  var taker: Taker;
  var port: u16;
  taker, port = start(true);
  let c = client(true);
  let first = serving(&taker, 1u32);
  let hello = fetch(&c, url(true, port, "/hello"), "hello");
  say("HTTP/2", "a request is answered", (hello.recv() || 0u64) == 1u64);
  let one = first.recv() || 9u64;
  // two requests on the one connection: /nap is held while /fill is refused
  let second = serving(&taker, 2u32);
  let nap = fetch(&c, url(true, port, "/nap"), "rested");
  let fill = fetch(&c, url(true, port, "/fill"), "");
  say("HTTP/2", "the write answers closed", (second.recv() || 0u64) == 1u64);
  say("HTTP/2", "the fetch fails", (fill.recv() || 0u64) == 1u64);
  say("HTTP/2", "the other request on the connection is answered", (nap.recv() || 0u64) == 1u64);
  say("HTTP/2", "one refusal counted", counted(&taker) == 1u64);
  say("HTTP/2", "the connection is still the one", actorhttp.liveConnActors() <= 1u64);
  let third = serving(&taker, 1u32);
  let again = fetch(&c, url(true, port, "/hello"), "hello");
  say("HTTP/2", "the next request is answered", (again.recv() || 0u64) == 1u64);
  let three = third.recv() || 9u64;
  taker.stop();
}

fn main() i32 {
  initAll();
  http1();
  http2();
  say("all", "the pool refused", stats().refused > 0u64);
  finalAll();
  0
}
