// The one line each error of this package gives a person is pinned here, with the
// number fields in play, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use String;
import actorhttp use *;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- FetchError.cancelled(), "cancelled", "cancelled");
  says(String() <- FetchError.timedOut(), "deadline passed", "timed out");
  says(String() <- ServerError.closed(), "closed", "closed");
  says(String() <- ServerError.failed(0u32, "could not listen"), "could not listen", "failed, no code");
  let os = String() <- ServerError.failed(5u32, "could not listen"); expect(os.view().startsWith("could not listen (") && os.view().endsWith(")"), "failed with an OS code");
  done()
}
