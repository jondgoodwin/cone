// A routed server whose handlers read the request body (ServerConfig.streamBodies): the request is routed at
// its head, and the handler takes the body through 'ex.body()': 'read' piece by piece (each piece releases
// its credit to the connection as it is taken), 'readAll(limit)' whole, with the server's own 413 past the
// limit. Checked: a 20,000-byte POST read in pieces (the bytes add up, every byte right); the same read
// whole; a body over readAll's limit (the Err is too-large, the client sees 413); a handler that answers
// without reading the body, and the next request on the same connection still works; a POST of 300,000
// bytes read slowly (each read awaits a nap), which arrives whole.

mod routedbody;

import stdio use *;
import libc;
import thread;
import sync use Channel, Sender, Receiver, Oneshot, OneshotSender, OneshotReceiver;
import collections use List, String;
import time use Instant, Duration;
import iocore use SocketAddr;
import http use *;
import httpclient use Response, Request;
import actors;
import aio;
import actorhttp use Client, Server, ServerConfig, Exchange, FetchError, HttpRoutes, HttpHandler;

fn say(s: &str, n: u64) {printStr(s); printStr(" "); printUInt(n); printStr("\n");}

// The byte at position i of the test's bodies
fn byteAt(i: usize) u8 {u8.from(i % 251usize)}

fn makeBody(n: usize) String {
  var b = String.withCapacity(n);
  var i = 0usize;
  while i < n {
    b.appendByte(byteAt(i));
    i = i + 1usize;
  }
  b
}

// Reads the body piece by piece, checks every byte, answers with the count
actor Reader is HttpHandler {
  nap: bool;

  fn init(self: &new) {*self = Self(nap: false);}

  pub async fn handle(self, var ex: Exchange) {
    var body = ex.body();
    var total = 0usize;
    var pieces = 0usize;
    var bad = 0usize;
    while true {
      let r = await body.read();
      match r {
        case let Ok(p) {
          match p {
            case let Some(s) {
              var k = 0usize;
              let v = s.view() as &Array[u8];
              while k < v.len {
                if v[k] != byteAt(total + k) {bad = bad + 1usize;}
                k = k + 1usize;
              }
              total = total + s.len();
              pieces = pieces + 1usize;
              if total > 100000usize {await aio.sleep(Duration.fromMillis(1i64));}
            }
            else {break;}
          }
        }
        case let Err(e) {
          ex.text(500u16, "read failed");
          return;
        }
      }
    }
    var t = String.from("read ");
    t.appendUInt(u64.from(total));
    t.append(" bytes, bad ");
    t.appendUInt(u64.from(bad));
    t.append(if pieces > 0usize {", in pieces"} else {", no pieces"});
    ex.text(200u16, t.view());
  }
}

fn makeReader() HttpHandler {
  let h = Reader();
  let r: HttpHandler = h;
  r
}

// Reads the whole body, up to 1,000 bytes
actor Whole is HttpHandler {
  n: u64;

  fn init(self: &new) {*self = Self(n: 0u64);}

  pub async fn handle(self, var ex: Exchange) {
    var body = ex.body();
    let r = await body.readAll(1000usize);
    match r {
      case let Ok(s) {
        var t = String.from("whole ");
        t.appendUInt(u64.from(s.len()));
        ex.text(200u16, t.view());
      }
      case let Err(e) {
        // e.isTooLarge(): the server has answered 413 itself
      }
    }
  }
}

fn makeWhole() HttpHandler {
  let h = Whole();
  let r: HttpHandler = h;
  r
}

// Answers at once, never reading the body
actor Skip is HttpHandler {
  n: u64;

  fn init(self: &new) {*self = Self(n: 0u64);}

  pub async fn handle(self, var ex: Exchange) {
    ex.text(200u16, "skipped");
  }
}

fn makeSkip() HttpHandler {
  let h = Skip();
  let r: HttpHandler = h;
  r
}

fn show(what: &str, r: Result[Response, FetchError]) {
  printStr(what);
  printStr(": ");
  match &r {
    case let &Ok(ok) {
      printUInt(u64.from(ok.status));
      if ok.body.len() > 0usize {
        printStr(" ");
        printStr(ok.body.view());
      }
      printStr("\n");
    }
    case let &Err(e) {printStr("failed: "); print <- e; printStr("\n");}
  }
}

fn post(port: u16, path: &str, n: usize) Request {
  var u = String.from("http://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  var r = Request.get(u.view());
  r.method = Method.Post;
  r.body = makeBody(n);
  r
}

actor Prober {
  client: Client;

  pub async fn run(self, port: u16, var done: OneshotSender[u64]) {
    show("read 20000", await client.send(post(port, "/read", 20000usize)));
    show("whole 500", await client.send(post(port, "/whole", 500usize)));
    show("whole 5000", await client.send(post(port, "/whole", 5000usize)));
    show("skip 20000", await client.send(post(port, "/skip", 20000usize)));
    show("after skip", await client.send(post(port, "/whole", 10usize)));
    show("read 300000", await client.send(post(port, "/read", 300000usize)));
    done.send(1u64);
  }
}

actor Acceptor {
  server: Server;

  pub async fn open(self, cfg: ServerConfig, var ports: Sender[u16]) {
    let r = await actorhttp.listen(SocketAddr.localhost(0u16), cfg);
    var res = r;
    match &mut res {
      case var &mut Ok(ok) {server <-> *ok;}
      case let &mut Err(e) {printStr("listen failed: "); print <- e; printStr("\n"); libc.exit(1i32);}
    }
    ports.send(server.port());
  }

  pub async fn stop(self) {server.close();}

  pub async fn waitClosed(self, var done: OneshotSender[u64]) {
    let closed = await server.closed();
    done.send(if closed {1u64} else {0u64});
  }
}

fn main() i32 {
  initAll();
  var ptx: Sender[u16];
  var prx: Receiver[u16];
  ptx, prx = Channel[u16].make();
  let router = HttpRoutes.make().handle("", "/read", &makeReader).handle("", "/whole", &makeWhole).handle("", "/skip", &makeSkip);
  let acceptor = Acceptor(Server.none());
  acceptor.open(ServerConfig.make().streamBodies().routes(router), ptx.clone());
  let port = prx.recv() || 0u16;
  {
    var tx: OneshotSender[u64];
    var rx: OneshotReceiver[u64];
    tx, rx = Oneshot[u64].make();
    let p = Prober(Client.standard());
    p.run(port, tx);
    rx.recv();
  }
  acceptor.stop();
  {
    var tx: OneshotSender[u64];
    var rx: OneshotReceiver[u64];
    tx, rx = Oneshot[u64].make();
    acceptor.waitClosed(tx);
    say("closed", rx.recv() || 99u64);
  }
  var waited = 0u32;
  while actorhttp.liveConnActors() > 0u64 && waited < 300u32 {
    thread.sleep(Duration.fromMillis(10i64));
    waited = waited + 1u32;
  }
  say("live connection actors", actorhttp.liveConnActors());
  finalAll();
  0
}
