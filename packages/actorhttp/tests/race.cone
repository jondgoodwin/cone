// A cancel racing a completion, through the client: however they fall, an
// awaited fetch is answered exactly once, with the whole response or with
// Cancelled, and never a second time or a panic.
//
// Racer makes 300 rounds against a loopback server on a thread of its own.
// Each round it makes a group and a fetch within it, which it has not started,
// and sends itself one message, 'stop', which cancels the group (the stop
// message is sent before the 'await' starts the fetch on odd rounds, and the
// two then run on other workers, the cancel arriving before, during or after
// the exchange). The fetch ends Done (the body is "hello") or Cancelled; a
// cancel that reset a connection leaves the client to open another for the
// next round. What is checked: every round was answered (the loop ran to its
// end, each await once), each answer was Done with the right body or
// Cancelled and none failed, and a last fetch with no group still works. Both
// outcomes happen on a quiet machine; the test does not require it, since
// which wins is the point of a race. The suite runs it once; run it
// repeatedly to hunt for a lost or doubled answer (a doubled reply would be a
// panic, a lost one a hang).

mod race;

import stdio use *;
import thread;
import time use Instant, Duration;
import sync use Channel, Sender, Receiver, Oneshot, OneshotSender, OneshotReceiver;
import collections use List, String;
import iobuf use IoBuf, Pool;
import iocore use Loop, SocketAddr, CancelGroup, forever;
import http use *;
import httpconn;
import httpclient use Request, Response, Config;
import actors;
import actorhttp use Client, FetchError;
import aio use IoLimits;

// ---------------------------------------------------------------------------
// The loopback server, on a thread of its own. What it answers is chosen by
// the request's path:
//   /hello             200 "hello" (and any path not below)
//   /echo              200, the method, a space, and the request's body
//   /nobody            204
//   /status/C          status C, body "status"
//   /redirect/N        302 to /redirect/N-1; /redirect/0 is 200 "landed"
//   /big/N             200, N bytes, byte i being i % 251, sent as taken
//   /conns             200, the number of connections it has accepted
//   /hang              nothing at all
// ---------------------------------------------------------------------------

let halt: Atomic[u32];

fn @initpure init() {
  halt = Atomic[u32].of(0u32);
  spun = Atomic[u64].of(0u64);
}

struct Srv {
  pub drv: httpconn.Driver;
  pub pool: Pool;
  pub accepted: u64;
  pub requests: u64;
  pub reqs: List[httpconn.ReqId];
  pub methods: List[Method];
  pub targets: List[String];
  pub bodies: List[String];
  pub streams: List[httpconn.ReqId];
  pub sent: List[u64];
  pub totals: List[u64];
}

struct Report {
  pub accepted: u64;
  pub requests: u64;
}

fn reply(sv: &mut Srv, req: httpconn.ReqId, head: bool, status: u16, body: &Array[u8]) {
  sv.drv.respond(req, ResponseHead.make(status), BodyLength.sized(u64.from(body.len)));
  if body.len > 0usize && !head {
    var b = sv.pool.mustTake(body.len);
    b.append(body);
    sv.drv.sendData(req, b);
    sv.drv.finish(req);
  }
}

fn number(s: &str) u64 {
  match collections.parseUInt(s) {
    case let Some(v) {v}
    case is None[u64] {0u64}
  }
}

fn dropStream(sv: &mut Srv, j: usize) {
  let last = sv.streams.len() - 1usize;
  sv.streams.swap(j, last);
  sv.sent.swap(j, last);
  sv.totals.swap(j, last);
  sv.streams.pop();
  sv.sent.pop();
  sv.totals.pop();
}

// Stream j's next pieces, as many as the connection takes now
fn pumpStream(sv: &mut Srv, j: usize) {
  let req = *sv.streams[j];
  while *sv.sent[j] < *sv.totals[j] {
    let at = *sv.sent[j];
    let left = *sv.totals[j] - at;
    let n = if left < 65536u64 {usize.from(left)} else {65536usize};
    var b = sv.pool.mustTake(n);
    let s = b.spare();
    var i = 0usize;
    while i < n {
      s[i] = u8.from((at + u64.from(i)) % 251u64);
      i = i + 1usize;
    }
    b.setLen(n);
    match sv.drv.sendData(req, b) {
      case is None[IoBuf] {sv.sent.set(j, at + u64.from(n));}
      else {return;}
    }
  }
  sv.drv.finish(req);
  dropStream(sv, j);
}

fn findStream(sv: &Srv, req: httpconn.ReqId) usize {
  var j = 0usize;
  while j < sv.streams.len() {
    if *sv.streams[j] == req {return j;}
    j = j + 1usize;
  }
  sv.streams.len()
}

fn findReq(sv: &Srv, req: httpconn.ReqId) usize {
  var k = 0usize;
  while k < sv.reqs.len() {
    if *sv.reqs[k] == req {return k;}
    k = k + 1usize;
  }
  sv.reqs.len()
}

fn forget(sv: &mut Srv, k: usize) {
  let last = sv.reqs.len() - 1usize;
  sv.reqs.swap(k, last);
  sv.methods.swap(k, last);
  sv.targets.swap(k, last);
  sv.bodies.swap(k, last);
  sv.reqs.pop();
  sv.methods.pop();
  sv.targets.pop();
  sv.bodies.pop();
}

// The answer to request k, read whole
fn answer(sv: &mut Srv, k: usize) {
  let req = *sv.reqs[k];
  let full = sv.targets[k].copy();
  let path = full.view();
  let head = *sv.methods[k] == Method.Head;
  if path == "/echo" {
    var b = String.from(methodToken(*sv.methods[k]));
    b.append(" ");
    b.append(sv.bodies[k].view());
    reply(sv, req, head, 200u16, b.view());
  } elif path == "/nobody" {
    reply(sv, req, head, 204u16, "");
  } elif path == "/conns" {
    var b = String.empty();
    b.appendUInt(sv.accepted);
    reply(sv, req, head, 200u16, b.view());
  } elif path.len > 10usize && &path[0usize ..< 10usize] == "/redirect/" {
    let n = number(&path[10usize ..]);
    if n == 0u64 {
      reply(sv, req, head, 200u16, "landed");
    } else {
      var loc = String.from("/redirect/");
      loc.appendUInt(n - 1u64);
      var h = ResponseHead.make(302u16);
      h.headers.add("Location", loc.view());
      sv.drv.respond(req, h, BodyLength.sized(5u64));
      var b = sv.pool.mustTake(5usize);
      b.append("moved");
      sv.drv.sendData(req, b);
      sv.drv.finish(req);
    }
  } elif path.len > 8usize && &path[0usize ..< 8usize] == "/status/" {
    reply(sv, req, head, u16.from(number(&path[8usize ..])), "status");
  } elif path.len > 5usize && &path[0usize ..< 5usize] == "/big/" {
    let n = number(&path[5usize ..]);
    sv.drv.respond(req, ResponseHead.make(200u16), BodyLength.sized(n));
    sv.streams.push(req);
    sv.sent.push(0u64);
    sv.totals.push(n);
    pumpStream(sv, sv.streams.len() - 1usize);
  } elif path == "/hang" {
  } else {
    reply(sv, req, head, 200u16, "hello");
  }
}

fn serveEvent(sv: &mut Srv, e: &mut httpconn.Event) {
  let kind = e.kind;
  if kind == httpconn.EventKind.Accepted {
    sv.accepted = sv.accepted + 1u64;
  } elif kind == httpconn.EventKind.Request {
    sv.requests = sv.requests + 1u64;
    sv.reqs.push(e.req);
    sv.methods.push(e.request.method);
    sv.targets.push(e.request.target.copy());
    sv.bodies.push(String.empty());
  } elif kind == httpconn.EventKind.Data {
    let k = findReq(sv, e.req);
    if k < sv.reqs.len() {(&mut sv.bodies[k]).appendBytes(e.buf.view());}
    sv.drv.release(e.req, e.buf.len());
  } elif kind == httpconn.EventKind.End {
    let k = findReq(sv, e.req);
    if k < sv.reqs.len() {answer(sv, k);}
  } elif kind == httpconn.EventKind.Writable {
    let j = findStream(sv, e.req);
    if j < sv.streams.len() {pumpStream(sv, j);}
  } elif e.isTerminal() {
    let k = findReq(sv, e.req);
    if k < sv.reqs.len() {forget(sv, k);}
    let j = findStream(sv, e.req);
    if j < sv.streams.len() {dropStream(sv, j);}
  }
}

fn url(port: u16, path: &str) String {
  var u = String.from("http://127.0.0.1:");
  u.appendUInt(u64.from(port));
  u.append(path);
  u
}

fn serve(portTx: Sender[u16]) Report {
  let pool = Pool.make();
  var lp = Loop.mustMake();
  var sv = Srv(drv: httpconn.Driver.make(httpconn.Config.make(), pool), pool: pool, accepted: 0u64,
    requests: 0u64, reqs: List[httpconn.ReqId].empty(), methods: List[Method].empty(),
    targets: List[String].empty(), bodies: List[String].empty(), streams: List[httpconn.ReqId].empty(),
    sent: List[u64].empty(), totals: List[u64].empty());
  var port = 0u16;
  match sv.drv.listen(&mut lp, SocketAddr.localhost(0u16), httpconn.Sink.Here(1u64)) {
    case let Ok(r) {
      match sv.drv.localAddr(&lp, r) {
        case let Ok(a) {port = a.port();}
        case let Error(e) {}
      }
    }
    case let Error(e) {}
  }
  portTx.send(port);
  var events = List[httpconn.Event].empty();
  while halt.load() == 0u32 {
    sv.drv.poll(&mut lp, Instant.now() + Duration.fromMillis(20i64), &mut events);
    var k = 0usize;
    while k < events.len() {
      serveEvent(&mut sv, &mut events[k]);
      k = k + 1usize;
    }
    events.clear();
  }
  sv.drv.abortAll(&mut lp);
  Report(sv.accepted, sv.requests)
}

const rounds = 300u64;

// What spinFor adds to, so that it is not optimised away
let spun: Atomic[u64];

// Wait a while, in a way the compiler leaves alone
fn spinFor(n: u64) {
  var k = 0u64;
  while k < n {
    spun.add(1u64);
    k = k + 1u64;
  }
}

actor Racer {
  client: Client;

  // Runs once the behaviour is paused on its fetch, after spinning a while
  pub async fn stop(self, g: CancelGroup, spin: u64) {
    spinFor(spin);
    g.cancel();
  }

  pub async fn run(self, port: u16, done: OneshotSender[u64]) {
    var answered = 0u64;
    var ok = 0u64;
    var cancelled = 0u64;
    var other = 0u64;
    var wrongBody = 0u64;
    var round = 0u64;
    while round < rounds {
      let g = CancelGroup.make();
      let r = client.getIn(url(port, "/hello").view(), IoLimits.within(g));
      selfactor.stop(g, (round * 911u64) % 40000u64);
      let a = await r;
      answered = answered + 1u64;
      match &a {
        case let &Ok(good) {
          if good.status == 200u16 && good.body.view() == "hello" {ok = ok + 1u64;} else {wrongBody = wrongBody + 1u64;}
        }
        case let &Error(e) {
          if e.isCancelled() {cancelled = cancelled + 1u64;} else {other = other + 1u64;}
        }
      }
      round = round + 1u64;
    }
    // One with no group still works after all that
    let last = await client.get(url(port, "/hello").view());
    var lastGood = false;
    match &last {
      case let &Ok(good) {lastGood = good.body.view() == "hello";}
      else {}
    }
    printStr("every round answered once: ");
    printStr(if answered == rounds {"yes"} else {"NO"});
    printStr("\n");
    printStr("every answer Done or Cancelled: ");
    printStr(if ok + cancelled == rounds && other == 0u64 && wrongBody == 0u64 {"yes"} else {"NO"});
    printStr("\n");
    printStr("a fetch with no group after them: ");
    printStr(if lastGood {"yes"} else {"NO"});
    printStr("\n");
    var d = done;
    d.send(1u64);
  }
}

fn main() i32 {
  initAll();
  var portTx: Sender[u16];
  var portRx: Receiver[u16];
  portTx, portRx = Channel[u16].make();
  let server = thread.start(portTx, &serve);
  var port = 0u16;
  match portRx.recv() {
    case let Some(p) {port = p;}
    case is None[u16] {}
  }
  var tx: OneshotSender[u64];
  var rx: OneshotReceiver[u64];
  tx, rx = Oneshot[u64].make();
  {
    let r = Racer(Client.standard());
    r.run(port, tx);
  }
  rx.recv();
  halt.store(1u32);
  let rep = server.join();
  finalAll();
  printStr("end\n");
  0i32
}
