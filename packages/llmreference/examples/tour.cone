// The reference side of a model's layers on the CPU: a seeded random Q6_K matrix, one row decoded and its dot
// product with an input taken by hand, the same row by the matvec twin, a Q8_0 copy of f32 values and how far
// it is from them, a half-precision conversion, RMSNorm and a softmax.
//
//   congo run examples/tour.cone

mod tour;

import stdio use *;
import libc;
import collections use String;
import random;
import llmreference use *;

fn main() i32 {
  mut rng = random.Rng.fromSeed(7u64);
  match syntheticMatrix(&mut rng, QTYPE_Q6_K, 4usize, 512usize) {          // 4 rows of 2 Q6_K super-blocks
    case imm m Some {
      imm x = syntheticFloats(&mut rng, 512usize, 1.0);
      mut y = zeroFloats(4usize);
      matvecCpu(&m, x.view(), y.viewMut());                                // y[r] = row r . x
      imm row = m.row(2usize);                                             // row 2, decoded
      mut hand = 0.0d;
      mut c = 0usize;
      while c < 512usize {
        hand = hand + f64.from(*row[c]) * f64.from(*x[c]);
        c = c + 1usize;
      }
      printUInt(u64.from(m.bytes.len())); printStr(" bytes hold 4 x 512 weights, "); printUInt(u64.from(m.stride())); printStr(" a row\n");
      printStr("row 2 . x = "); printFloat(f64.from(*y[2usize])); printStr(" by the twin, "); printFloat(hand); printStr(" by hand\n");
    }
    case is None { return 1i32; }
  }

  // Q8_0 of 64 f32 values, and how far the decoded copy is from them
  imm values = syntheticFloats(&mut rng, 64usize, 2.0);
  imm packed = encodeQ8_0(values.view());
  mut back = zeroFloats(64usize);
  dequantizeRow(QTYPE_Q8_0, packed.view(), 0usize, 64usize, back.viewMut());
  mut worst = 0.0d;
  mut i = 0usize;
  while i < 64usize {
    imm e = libc.fabs(f64.from(*back[i]) - f64.from(*values[i]));
    if e > worst { worst = e; }
    i = i + 1usize;
  }
  printUInt(u64.from(packed.len())); printStr(" bytes of Q8_0 for 64 values; the largest error is "); printFloat(worst); printStr("\n");

  // half precision
  mut hex = String.empty();
  hex.appendHex(u64.from(f32ToF16(0.1)), 4usize);
  printStr("0.1 as a half is 0x"); printStr(hex.view()); printStr(", which is "); printFloat(f64.from(f16ToF32(f32ToF16(0.1)))); printStr("\n");

  // RMSNorm of [3, 4] and a softmax of [1, 2, 3]
  mut n = zeroFloats(2usize);
  rmsnormCpu(&[3.0, 4.0], &[1.0, 1.0], 2usize, 1usize, 0.0, n.viewMut());
  printStr("rmsnorm [3, 4] = ["); printFloat(f64.from(*n[0usize])); printStr(", "); printFloat(f64.from(*n[1usize])); printStr("]\n");
  mut s = zeroFloats(3usize);
  softmaxCpu(&[1.0, 2.0, 3.0], 3usize, 1usize, s.viewMut());
  printStr("softmax [1, 2, 3] = ["); printFloat(f64.from(*s[0usize])); printStr(", "); printFloat(f64.from(*s[1usize])); printStr(", ");
  printFloat(f64.from(*s[2usize])); printStr("]\n");
  0i32;
}
