// ======== The CPU twins ========
//
// Each GPU kernel has a twin here: the same algorithm over the same layouts, written in Cone for the CPU. A twin
// is a REFERENCE, not an emulation of the GPU's rounding: where the GPU adds in f32, in an order of its own
// (a tree across a workgroup), a twin adds in f64 in column order and rounds once, so the difference between the
// two is the GPU's own error. The numbers that DEFINE a result (a dequantised weight, a RoPE angle, an f32 add)
// are computed in f32 exactly as the shader does. Transcendentals (exp, sin, cos, sqrt, pow) are libm's in f64,
// rounded once to f32.
//
// All slices are f32 with the layouts the GPU kernel documents (llmkernels.cone). Each twin answers false, and
// writes nothing, when its arguments do not fit its slices.

// The sum of w[c] * x[c] over c < cols, in f64 in column order (a product of two f32s is exact in f64)
fn dot64(w &Array[f32], x &Array[f32], x0 usize, cols usize) f64 {
  var acc = 0.0d;
  var c = 0usize;
  while c < cols {
    acc = acc + f64.from(w[c]) * f64.from(x[x0 + c]);
    c = c + 1usize;
  }
  acc
}

// y[r] = sum over c of W[r][c] x[c], for every row of the matrix. x holds at least m.cols values, y at least m.rows.
pub fn matvecCpu(m &QMatrix, x &Array[f32], y &mut Array[f32]) bool {
  if x.len < m.cols or y.len < m.rows { return false; }
  var row = zeroFloats(m.cols);
  var r = 0usize;
  while r < m.rows {
    dequantizeRow(m.qtype, m.bytes.view(), r * m.stride(), m.cols, row.viewMut());
    y[r] = f32.from(dot64(row.view(), x, 0usize, m.cols));
    r = r + 1usize;
  }
  true
}

// Y[b][r] = sum over c of W[r][c] X[b][c], X 'batch' rows of m.cols, Y 'batch' rows of m.rows
pub fn matmulCpu(m &QMatrix, x &Array[f32], batch usize, y &mut Array[f32]) bool {
  if x.len < batch * m.cols or y.len < batch * m.rows { return false; }
  var row = zeroFloats(m.cols);
  var r = 0usize;
  while r < m.rows {
    dequantizeRow(m.qtype, m.bytes.view(), r * m.stride(), m.cols, row.viewMut());
    var b = 0usize;
    while b < batch {
      y[b * m.rows + r] = f32.from(dot64(row.view(), x, b * m.cols, m.cols));
      b = b + 1usize;
    }
    r = r + 1usize;
  }
  true
}

// The sum of |w[c] x[c]| in f64, the size of the terms a sum is made of
fn absDot64(w &Array[f32], x &Array[f32], x0 usize, cols usize) f64 {
  var acc = 0.0d;
  var c = 0usize;
  while c < cols {
    acc = acc + libc.fabs(f64.from(w[c]) * f64.from(x[x0 + c]));
    c = c + 1usize;
  }
  acc
}

// For each row of the matrix, the sum of the absolute values of its products with x (what 'sumTolerance' scales)
pub fn matvecMagnitudeCpu(m &QMatrix, x &Array[f32], y &mut Array[f64]) bool {
  if x.len < m.cols or y.len < m.rows { return false; }
  var row = zeroFloats(m.cols);
  var r = 0usize;
  while r < m.rows {
    dequantizeRow(m.qtype, m.bytes.view(), r * m.stride(), m.cols, row.viewMut());
    y[r] = absDot64(row.view(), x, 0usize, m.cols);
    r = r + 1usize;
  }
  true
}

// The same for every output of a matmul, laid out as its Y
pub fn matmulMagnitudeCpu(m &QMatrix, x &Array[f32], batch usize, y &mut Array[f64]) bool {
  if x.len < batch * m.cols or y.len < batch * m.rows { return false; }
  var row = zeroFloats(m.cols);
  var r = 0usize;
  while r < m.rows {
    dequantizeRow(m.qtype, m.bytes.view(), r * m.stride(), m.cols, row.viewMut());
    var b = 0usize;
    while b < batch {
      y[b * m.rows + r] = absDot64(row.view(), x, b * m.cols, m.cols);
      b = b + 1usize;
    }
    r = r + 1usize;
  }
  true
}

// How far an f32 sum of n products (any order of adding) can be from the exact sum, given the sum of their
// absolute values: (n + 4) * 2^-24 * that. It is the standard bound (n - 1 additions and n multiplications, each
// off by at most 2^-24 of its result, and a result never exceeds the sum of the absolute terms) with room for
// the dequantisation's own two roundings. The GPU's sum obeys it in whatever order it adds, so a kernel's
// error against a twin that sums in f64 is within it.
pub fn sumTolerance(n usize, absSum f64) f64 {
  f64.from(n + 4usize) * 5.9604644775390625e-8d * absSum
}

// y = x / sqrt(mean(x^2) + eps) * w, for each of 'rows' rows of 'n'
pub fn rmsnormCpu(x &Array[f32], w &Array[f32], n usize, rows usize, eps f32, y &mut Array[f32]) bool {
  if n == 0usize or x.len < n * rows or w.len < n or y.len < n * rows { return false; }
  var r = 0usize;
  while r < rows {
    var ss = 0.0d;
    var i = 0usize;
    while i < n {
      let v = f64.from(x[r * n + i]);
      ss = ss + v * v;
      i = i + 1usize;
    }
    let scale = 1.0d / libc.sqrt(ss / f64.from(n) + f64.from(eps));
    i = 0usize;
    while i < n {
      y[r * n + i] = f32.from(f64.from(x[r * n + i]) * scale * f64.from(w[i]));
      i = i + 1usize;
    }
    r = r + 1usize;
  }
  true
}

// The ropeDim / 2 frequencies base^(-2 i / ropeDim), the table the RoPE kernel and its twin both take
pub fn ropeFrequencies(ropeDim usize, base f32) List[f32] {
  var out = List[f32].withCapacity(ropeDim / 2usize);
  var i = 0usize;
  while i < ropeDim / 2usize {
    out.push(f32.from(libc.pow(f64.from(base), 0.0d - 2.0d * f64.from(i) / f64.from(ropeDim))));
    i = i + 1usize;
  }
  out
}

// Rotate the first ropeDim dimensions of every head of every token of x, in place, by (pos0 + token) * freqs[pair]:
// mode 0 rotates the pairs (2 pair, 2 pair + 1), mode 1 the pairs (pair, pair + ropeDim / 2). x is
// [token][head][d]. The angle is the f32 product the shader forms; its cosine and sine are libm's in f64.
pub fn ropeCpu(x &mut Array[f32], freqs &Array[f32], tokens usize, nHeads usize, headDim usize, ropeDim usize,
    pos0 usize, mode u32) bool {
  let half = ropeDim / 2usize;
  if ropeDim % 2usize != 0usize or ropeDim > headDim or freqs.len < half or x.len < tokens * nHeads * headDim { return false; }
  if mode > 1u32 { return false; }
  var t = 0usize;
  while t < tokens {
    var h = 0usize;
    while h < nHeads {
      let basis = (t * nHeads + h) * headDim;
      var p = 0usize;
      while p < half {
        let angle = f64.from(f32.from(pos0 + t) * freqs[p]);
        let c = libc.cos(angle);
        let s = libc.sin(angle);
        var a = basis + p;
        var b = basis + p + half;
        if mode == 0u32 {
          a = basis + 2usize * p;
          b = a + 1usize;
        }
        let x0 = f64.from(x[a]);
        let x1 = f64.from(x[b]);
        x[a] = f32.from(x0 * c - x1 * s);
        x[b] = f32.from(x0 * s + x1 * c);
        p = p + 1usize;
      }
      h = h + 1usize;
    }
    t = t + 1usize;
  }
  true
}

// Softmax of each of 'rows' rows of 'n'
pub fn softmaxCpu(x &Array[f32], n usize, rows usize, y &mut Array[f32]) bool {
  if n == 0usize or x.len < n * rows or y.len < n * rows { return false; }
  var r = 0usize;
  while r < rows {
    var m = f64.from(x[r * n]);
    var i = 1usize;
    while i < n {
      if f64.from(x[r * n + i]) > m { m = f64.from(x[r * n + i]); }
      i = i + 1usize;
    }
    var sum = 0.0d;
    i = 0usize;
    while i < n {
      sum = sum + libc.exp(f64.from(x[r * n + i]) - m);
      i = i + 1usize;
    }
    i = 0usize;
    while i < n {
      y[r * n + i] = f32.from(libc.exp(f64.from(x[r * n + i]) - m) / sum);
      i = i + 1usize;
    }
    r = r + 1usize;
  }
  true
}

// Causal attention of nTokens new tokens (positions pos0 ..) over a KV cache that already holds their keys and
// values: the layouts and the grouped-query rule of attention.slang. 'scale' multiplies each q . k.
pub fn attentionCpu(q &Array[f32], kCache &Array[f32], vCache &Array[f32], nTokens usize, nHeads usize,
    nKvHeads usize, headDim usize, pos0 usize, maxSeq usize, scale f32, out &mut Array[f32]) bool {
  if nKvHeads == 0usize or nHeads % nKvHeads != 0usize or headDim == 0usize { return false; }
  if pos0 + nTokens > maxSeq { return false; }
  let kvDim = nKvHeads * headDim;
  if q.len < nTokens * nHeads * headDim or out.len < nTokens * nHeads * headDim { return false; }
  if kCache.len < maxSeq * kvDim or vCache.len < maxSeq * kvDim { return false; }
  var scores = List[f64].withCapacity(maxSeq);
  var t = 0usize;
  while t < nTokens {
    let seqLen = pos0 + t + 1usize;
    var h = 0usize;
    while h < nHeads {
      let kvh = h / (nHeads / nKvHeads);
      let qBase = (t * nHeads + h) * headDim;
      scores.clear();
      var m = -1.0e300d;
      var j = 0usize;
      while j < seqLen {
        var acc = 0.0d;
        var d = 0usize;
        while d < headDim {
          acc = acc + f64.from(q[qBase + d]) * f64.from(kCache[j * kvDim + kvh * headDim + d]);
          d = d + 1usize;
        }
        let s = acc * f64.from(scale);
        scores.push(s);
        if s > m { m = s; }
        j = j + 1usize;
      }
      var total = 0.0d;
      j = 0usize;
      while j < seqLen {
        let e = libc.exp(*scores[j] - m);
        scores.set(j, e);
        total = total + e;
        j = j + 1usize;
      }
      var d = 0usize;
      while d < headDim {
        var acc = 0.0d;
        j = 0usize;
        while j < seqLen {
          acc = acc + *scores[j] * f64.from(vCache[j * kvDim + kvh * headDim + d]);
          j = j + 1usize;
        }
        out[qBase + d] = f32.from(acc / total);
        d = d + 1usize;
      }
      h = h + 1usize;
    }
    t = t + 1usize;
  }
  true
}

// cache[(pos0 + t) * kvDim + i] = src[t * kvDim + i] for t < nTokens, i < kvDim
pub fn kvAppendCpu(src &Array[f32], cache &mut Array[f32], nTokens usize, kvDim usize, pos0 usize) bool {
  if src.len < nTokens * kvDim or cache.len < (pos0 + nTokens) * kvDim { return false; }
  var i = 0usize;
  while i < nTokens * kvDim {
    cache[pos0 * kvDim + i] = src[i];
    i = i + 1usize;
  }
  true
}

// x / (1 + e^-x)
pub fn siluValue(x f32) f32 {
  let v = f64.from(x);
  f32.from(v / (1.0d + libc.exp(0.0d - v)))
}

// tanh in f64 from exp (libc has no tanh here): (1 - e^-2|v|) / (1 + e^-2|v|), signed
fn tanh64(v f64) f64 {
  let a = if v < 0.0d { 0.0d - v } else { v };
  let t = libc.exp(-2.0d * a);
  let r = (1.0d - t) / (1.0d + t);
  if v < 0.0d { return 0.0d - r; }
  r
}

// 0.5 x (1 + tanh(sqrt(2 / pi) (x + 0.044715 x^3))), the tanh GELU ggml uses
pub fn geluValue(x f32) f32 {
  let v = f64.from(x);
  f32.from(0.5d * v * (1.0d + tanh64(0.79788456080286535588d * (v + 0.044715d * v * v * v))))
}

pub fn siluCpu(x &Array[f32], n usize, y &mut Array[f32]) bool {
  if x.len < n or y.len < n { return false; }
  var i = 0usize;
  while i < n { y[i] = siluValue(x[i]); i = i + 1usize; }
  true
}

pub fn geluCpu(x &Array[f32], n usize, y &mut Array[f32]) bool {
  if x.len < n or y.len < n { return false; }
  var i = 0usize;
  while i < n { y[i] = geluValue(x[i]); i = i + 1usize; }
  true
}

pub fn addCpu(a &Array[f32], b &Array[f32], n usize, y &mut Array[f32]) bool {
  if a.len < n or b.len < n or y.len < n { return false; }
  var i = 0usize;
  while i < n { y[i] = a[i] + b[i]; i = i + 1usize; }
  true
}

pub fn mulCpu(a &Array[f32], b &Array[f32], n usize, y &mut Array[f32]) bool {
  if a.len < n or b.len < n or y.len < n { return false; }
  var i = 0usize;
  while i < n { y[i] = a[i] * b[i]; i = i + 1usize; }
  true
}
