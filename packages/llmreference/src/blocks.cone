// ======== Weight blocks: the five tensor types, their sizes, and decoding them on the CPU ========
//
// The CPU side of the layouts llmcommon.slang reads on the GPU. The decoders here are written the way ggml's
// dequantize_row_* are (a loop over the blocks, each one's groups in turn), not the way the shader's one-element
// and 32-element functions are, so that the tests comparing the two cross-check the layout as well as the code.

// The tensor types by their GGUF (ggml_type) numbers, so a later gguf wiring shares them as they are
pub const QTYPE_F32 = 0u32;
pub const QTYPE_F16 = 1u32;
pub const QTYPE_Q8_0 = 8u32;
pub const QTYPE_Q4_K = 12u32;
pub const QTYPE_Q6_K = 14u32;

// Whether this is one of the five
pub fn isQType(qtype u32) bool {
  qtype == QTYPE_F32 or qtype == QTYPE_F16 or qtype == QTYPE_Q8_0 or qtype == QTYPE_Q4_K or qtype == QTYPE_Q6_K
}

// The elements in one block: 1 for F32 and F16 (they are not blocked), 32 for Q8_0, 256 for Q4_K and Q6_K.
// 0 for a type that is not one of the five.
pub fn blockElems(qtype u32) usize {
  if qtype == QTYPE_F32 or qtype == QTYPE_F16 { return 1usize; }
  if qtype == QTYPE_Q8_0 { return 32usize; }
  if qtype == QTYPE_Q4_K or qtype == QTYPE_Q6_K { return 256usize; }
  0usize
}

// The bytes in one block: 4 (F32), 2 (F16), 34 (Q8_0: a half and 32 bytes), 144 (Q4_K: two halves, 12 bytes of
// six-bit scales and minimums, 128 bytes of nibbles), 210 (Q6_K: 128 bytes of low nibbles, 64 of high bit
// pairs, 16 signed scales, a half). 0 for a type that is not one of the five.
pub fn blockBytes(qtype u32) usize {
  if qtype == QTYPE_F32 { return 4usize; }
  if qtype == QTYPE_F16 { return 2usize; }
  if qtype == QTYPE_Q8_0 { return 34usize; }
  if qtype == QTYPE_Q4_K { return 144usize; }
  if qtype == QTYPE_Q6_K { return 210usize; }
  0usize
}

// The bytes of one row of 'cols' elements, 0 if the type is not one of the five or 'cols' is not a whole
// number of its blocks
pub fn rowBytes(qtype u32, cols usize) usize {
  let be = blockElems(qtype);
  if be == 0usize or cols % be != 0usize { return 0usize; }
  cols / be * blockBytes(qtype)
}

// ---- Half-precision floats (IEEE 754 binary16), converted in integers ----

// The f32 a half-precision value (its 16 bits) stands for: exact for every finite half (the normal ones and
// the subnormal ones), infinities and NaNs kept
pub fn f16ToF32(h u16) f32 {
  let bits = u32.from(h);
  let sign = (bits >> 15u32) & 1u32;
  let exponent = (bits >> 10u32) & 31u32;
  let mantissa = bits & 1023u32;
  var out = 0u32;
  if exponent == 0u32 {
    if mantissa == 0u32 { return (sign << 31u32) as f32; }
    // subnormal: mantissa * 2^-24, exact in an f32
    let v = f32.from(mantissa) * (1.0 / 16777216.0);
    if sign == 1u32 { return 0.0 - v; }
    return v;
  }
  if exponent == 31u32 {
    out = (sign << 31u32) | 0x7f800000u32 | (mantissa << 13u32);
  } else {
    out = (sign << 31u32) | ((exponent + 112u32) << 23u32) | (mantissa << 13u32);
  }
  out as f32
}

// The half-precision value nearest to this f32 (ties to even): overflow to infinity, tiny values to a
// subnormal half or zero, NaN kept a NaN
pub fn f32ToF16(f f32) u16 {
  let bits = f as u32;
  let sign = (bits >> 16u32) & 0x8000u32;
  let e = i32.from((bits >> 23u32) & 255u32);
  let m = bits & 0x7fffffu32;
  if e == 255i32 {
    if m == 0u32 { return u16.from(sign | 0x7c00u32); }
    return u16.from(sign | 0x7e00u32 | (m >> 13u32));
  }
  let e16 = e - 127i32 + 15i32;
  if e16 >= 31i32 { return u16.from(sign | 0x7c00u32); }
  if e16 <= 0i32 {
    if e16 < -10i32 { return u16.from(sign); }
    let full = m | 0x800000u32;
    let shift = u32.from(14i32 - e16);
    var half = full >> shift;
    let rem = full & ((1u32 << shift) - 1u32);
    let mid = 1u32 << (shift - 1u32);
    if rem > mid or (rem == mid and (half & 1u32) == 1u32) { half = half + 1u32; }
    return u16.from(sign | half);
  }
  var half = (u32.from(e16) << 10u32) | (m >> 13u32);
  let rem = m & 0x1fffu32;
  if rem > 0x1000u32 or (rem == 0x1000u32 and (half & 1u32) == 1u32) { half = half + 1u32; }
  u16.from(sign | half)
}

// ---- Bytes in, bytes out ----

fn byteAt(b &Array[u8], i usize) u32 { u32.from(b[i]) }

fn halfAt(b &Array[u8], i usize) f32 { f16ToF32(u16.from(byteAt(b, i) | (byteAt(b, i + 1usize) << 8u32))) }

fn signedAt(b &Array[u8], i usize) i32 { i32.from(i8.from(b[i])) }

// A byte buffer as the 32-bit words a GPU storage buffer holds: little-endian, the last word padded with zeros
pub fn packWords(bytes &Array[u8]) List[u32] {
  var out = List[u32].withCapacity((bytes.len + 3usize) / 4usize);
  var i = 0usize;
  while i < bytes.len {
    var w = 0u32;
    var k = 0usize;
    while k < 4usize and i + k < bytes.len {
      w = w | (u32.from(bytes[i + k]) << u32.from(8usize * k));
      k = k + 1usize;
    }
    out.push(w);
    i = i + 4usize;
  }
  out
}

// Put a half's two bytes (little-endian) on the end of a byte list
fn pushHalf(out &mut List[u8], h u16) {
  out.push(u8.from(h & 255u16));
  out.push(u8.from(h >> 8u16));
}

fn pushF32(out &mut List[u8], f f32) {
  let bits = f as u32;
  out.push(u8.from(bits & 255u32));
  out.push(u8.from((bits >> 8u32) & 255u32));
  out.push(u8.from((bits >> 16u32) & 255u32));
  out.push(u8.from(bits >> 24u32));
}

// ---- Encoders (what the tests and a model writer need; the K-quants' are left out) ----

// F32 bytes of these values
pub fn encodeF32(values &Array[f32]) List[u8] {
  var out = List[u8].withCapacity(values.len * 4usize);
  var i = 0usize;
  while i < values.len { pushF32(&mut out, values[i]); i = i + 1usize; }
  out
}

// F16 bytes of these values, each rounded to the nearest half
pub fn encodeF16(values &Array[f32]) List[u8] {
  var out = List[u8].withCapacity(values.len * 2usize);
  var i = 0usize;
  while i < values.len { pushHalf(&mut out, f32ToF16(values[i])); i = i + 1usize; }
  out
}

// Q8_0 bytes of these values (a whole number of blocks of 32, else nothing): for each block the scale d =
// max|v| / 127 stored as a half, and each value divided by that half and rounded to the nearest integer, as
// ggml's quantize_row_q8_0_ref does
pub fn encodeQ8_0(values &Array[f32]) List[u8] {
  var out = List[u8].empty();
  if values.len % 32usize != 0usize { return out; }
  var b = 0usize;
  while b < values.len {
    var amax = 0.0;
    var i = 0usize;
    while i < 32usize {
      let a = libc.fabsf(values[b + i]);
      if a > amax { amax = a; }
      i = i + 1usize;
    }
    let dh = f32ToF16(amax / 127.0);
    pushHalf(&mut out, dh);
    let d = f16ToF32(dh);
    i = 0usize;
    while i < 32usize {
      var q = 0i32;
      if d != 0.0 {
        let r = roundHalfAway(values[b + i] / d);
        q = i32.from(r);
        if q > 127i32 { q = 127i32; }
        if q < -127i32 { q = -127i32; }
      }
      out.push(u8.from(q));
      i = i + 1usize;
    }
    b = b + 32usize;
  }
  out
}

// ggml's roundf: to the nearest integer, halves away from zero
fn roundHalfAway(x f32) f32 {
  if x >= 0.0 { return libc.floorf(x + 0.5); }
  0.0 - libc.floorf(0.5 - x)
}

// ---- Decoders ----

// Decode the row of 'cols' elements of type 'qtype' that starts at byte 'at' of 'bytes' into out[0 .. cols].
// Nothing is written if the type is unknown, 'cols' is not a whole number of blocks, or the row does not fit
// in 'bytes' or 'out'; the answer is whether it was decoded.
pub fn dequantizeRow(qtype u32, bytes &Array[u8], at usize, cols usize, out &mut Array[f32]) bool {
  let rb = rowBytes(qtype, cols);
  if rb == 0usize or at + rb > bytes.len or cols > out.len { return false; }
  if qtype == QTYPE_F32 {
    var i = 0usize;
    while i < cols {
      out[i] = (byteAt(bytes, at + 4usize * i) | (byteAt(bytes, at + 4usize * i + 1usize) << 8u32)
        | (byteAt(bytes, at + 4usize * i + 2usize) << 16u32) | (byteAt(bytes, at + 4usize * i + 3usize) << 24u32)) as f32;
      i = i + 1usize;
    }
    return true;
  }
  if qtype == QTYPE_F16 {
    var i = 0usize;
    while i < cols { out[i] = halfAt(bytes, at + 2usize * i); i = i + 1usize; }
    return true;
  }
  if qtype == QTYPE_Q8_0 {
    var blk = 0usize;
    while blk < cols / 32usize {
      let base = at + blk * 34usize;
      let d = halfAt(bytes, base);
      var l = 0usize;
      while l < 32usize {
        out[blk * 32usize + l] = d * f32.from(signedAt(bytes, base + 2usize + l));
        l = l + 1usize;
      }
      blk = blk + 1usize;
    }
    return true;
  }
  if qtype == QTYPE_Q4_K {
    var sb = 0usize;
    while sb < cols / 256usize {
      let base = at + sb * 144usize;
      let d = halfAt(bytes, base);
      let dmin = halfAt(bytes, base + 2usize);
      var o = sb * 256usize;
      var q = base + 16usize;
      var sj = 0usize;
      while sj < 8usize {
        // the 64 elements of two sub-blocks: 32 low nibbles under scale sj, then 32 high nibbles under sj + 1
        let d1 = d * f32.from(scaleK4(bytes, base + 4usize, sj));
        let m1 = dmin * f32.from(minK4(bytes, base + 4usize, sj));
        let d2 = d * f32.from(scaleK4(bytes, base + 4usize, sj + 1usize));
        let m2 = dmin * f32.from(minK4(bytes, base + 4usize, sj + 1usize));
        var l = 0usize;
        while l < 32usize {
          out[o + l] = d1 * f32.from(byteAt(bytes, q + l) & 15u32) - m1;
          out[o + 32usize + l] = d2 * f32.from(byteAt(bytes, q + l) >> 4u32) - m2;
          l = l + 1usize;
        }
        o = o + 64usize;
        q = q + 32usize;
        sj = sj + 2usize;
      }
      sb = sb + 1usize;
    }
    return true;
  }
  // QTYPE_Q6_K
  var sb = 0usize;
  while sb < cols / 256usize {
    let base = at + sb * 210usize;
    let d = halfAt(bytes, base + 208usize);
    var o = sb * 256usize;
    var ql = base;
    var qh = base + 128usize;
    var sc = base + 192usize;
    var half = 0usize;
    while half < 2usize {
      var l = 0usize;
      while l < 32usize {
        let sg = l / 16usize;
        let lo0 = byteAt(bytes, ql + l);
        let lo1 = byteAt(bytes, ql + l + 32usize);
        let h = byteAt(bytes, qh + l);
        let q1 = i32.from((lo0 & 15u32) | (((h >> 0u32) & 3u32) << 4u32)) - 32i32;
        let q2 = i32.from((lo1 & 15u32) | (((h >> 2u32) & 3u32) << 4u32)) - 32i32;
        let q3 = i32.from((lo0 >> 4u32) | (((h >> 4u32) & 3u32) << 4u32)) - 32i32;
        let q4 = i32.from((lo1 >> 4u32) | (((h >> 6u32) & 3u32) << 4u32)) - 32i32;
        out[o + l] = (d * f32.from(signedAt(bytes, sc + sg))) * f32.from(q1);
        out[o + l + 32usize] = (d * f32.from(signedAt(bytes, sc + sg + 2usize))) * f32.from(q2);
        out[o + l + 64usize] = (d * f32.from(signedAt(bytes, sc + sg + 4usize))) * f32.from(q3);
        out[o + l + 96usize] = (d * f32.from(signedAt(bytes, sc + sg + 6usize))) * f32.from(q4);
        l = l + 1usize;
      }
      o = o + 128usize;
      ql = ql + 64usize;
      qh = qh + 32usize;
      sc = sc + 8usize;
      half = half + 1usize;
    }
    sb = sb + 1usize;
  }
  true
}

// Q4_K's six-bit scale number j (0 to 7) from the 12 scale bytes at 'at' (ggml's get_scale_min_k4)
fn scaleK4(b &Array[u8], at usize, j usize) u32 {
  if j < 4usize { return byteAt(b, at + j) & 63u32; }
  (byteAt(b, at + j + 4usize) & 15u32) | ((byteAt(b, at + j - 4usize) >> 6u32) << 4u32)
}

// ...and its six-bit minimum number j
fn minK4(b &Array[u8], at usize, j usize) u32 {
  if j < 4usize { return byteAt(b, at + j + 4usize) & 63u32; }
  (byteAt(b, at + j + 4usize) >> 4u32) | ((byteAt(b, at + j) >> 6u32) << 4u32)
}

// ---- A weight matrix on the CPU ----

// A weight matrix as the tensor holds it: 'rows' rows of 'cols' elements of one type, each row a whole number
// of blocks, the rows one after another in 'bytes'. The GPU is given the same bytes as words.
pub struct QMatrix {
  pub qtype u32;
  pub rows usize;
  pub cols usize;
  pub bytes List[u8];

  // The matrix of these bytes, or None if the type is not one of the five, 'cols' is not a whole number of its
  // blocks, or 'bytes' is not exactly rows * the row's bytes
  pub fn make(qtype u32, rows usize, cols usize, bytes List[u8]) Option[QMatrix] {
    let rb = rowBytes(qtype, cols);
    if rb == 0usize or bytes.len() != rows * rb { return None; }
    Some[QMatrix](new QMatrix(qtype, rows, cols, bytes))
  }

  // Bytes from the start of one row to the next
  pub fn stride(self &) usize { rowBytes(qtype, cols) }

  // Row 'r' decoded to f32
  pub fn row(self &, r usize) List[f32] {
    var out = List[f32].withCapacity(cols);
    var i = 0usize;
    while i < cols { out.push(0.0); i = i + 1usize; }
    dequantizeRow(qtype, bytes.view(), r * rowBytes(qtype, cols), cols, out.viewMut());
    out
  }

  // The bytes as the words a GPU storage buffer holds
  pub fn words(self &) List[u32] { packWords(bytes.view()) }
}
