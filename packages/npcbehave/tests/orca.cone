// ORCA: two agents meeting head on, twenty crossing a circle, and a crowd
// round a pillar. The separation check is the independent one: every frame,
// the distance between every pair of centres against the sum of their radii,
// computed here from the positions alone.

mod orca;
import testing use *;
import stdio use *;
import collections use List;
import geomath use *;
import npcbehave use *;

// The least distance the pair p, p + v t comes to the origin for t in [0, horizon]
fn closestApproach(p: Vec2, v: Vec2, horizon: f32) f32 {
  let vv = v.lengthSquared();
  let t = if vv > 0. { clampf(-p.dot(v) / vv, 0., horizon) } else { 0. };
  (p + v * t).length()
}

fn headOn() {
  var w = OrcaWorld.make(2., 10., 5usize);
  let a = w.addAgent(new Vec2(0., 0.), 0.5, 2.);
  let b = w.addAgent(new Vec2(4., 0.), 0.5, 2.);
  // Each starts at rest and wants to cross to the other's place at 1 m/s
  var minGap = 1000.f;
  var swerve = 0.f;
  var t = 0.;
  while t < 12. {
    w.setPreferred(a, (new Vec2(10., 0.) - (*w.agents[a]).pos).normalize());
    w.setPreferred(b, (new Vec2(-6., 0.) - (*w.agents[b]).pos).normalize());
    w.step(0.05);
    let g = (*w.agents[a]).pos.distance((*w.agents[b]).pos) - 1.;
    if g < minGap { minGap = g; }
    let s = fabs2((*w.agents[a]).pos.y);
    if s > swerve { swerve = s; }
    t = t + 0.05;
  }
  expect(minGap >= 0., "head-on pair never touches");
  expect(swerve > 0.2, "they swerve sideways to pass");
  expect((*w.agents[a]).pos.x > 8. && (*w.agents[b]).pos.x < -4., "and get across");
  // Once clear and free, the new velocities of a pair do not collide within the horizon
  var w2 = OrcaWorld.make(2., 10., 5usize);
  let c = w2.addAgent(new Vec2(0., 0.), 0.5, 2.);
  let d = w2.addAgent(new Vec2(4., 0.), 0.5, 2.);
  var again = (*w2.agents[c]);
  w2.agents.set(c, new OrcaAgent(again.pos, new Vec2(1., 0.), new Vec2(1., 0.), 0.5, 2.));
  var other = (*w2.agents[d]);
  w2.agents.set(d, new OrcaAgent(other.pos, new Vec2(-1., 0.), new Vec2(-1., 0.), 0.5, 2.));
  w2.step(0.1);
  let relV = (*w2.agents[d]).vel - (*w2.agents[c]).vel;
  expect(closestApproach(new Vec2(4., 0.), relV, 2.) > 1. - 0.001, "moving pair: the new velocities do not collide within the horizon");
}

fn fabs2(x: f32) f32 { if x < 0. { -x } else { x } }

// Twenty agents on a circle of radius 10, each heading for the opposite point
fn crossing() {
  var w = OrcaWorld.make(5., 15., 10usize);
  let n = 20;
  let radius = 0.4f;
  let speed = 1.5f;
  var goals = List[Vec2].empty();
  var i = 0;
  while i < n {
    let ang = 2. * pi * f32.from(i) / f32.from(n);
    let p = new Vec2(cos(ang) * 10., sin(ang) * 10.);
    w.addAgent(p, radius, speed);
    // The opposite point, turned by -0.6 to +0.6 rad about the centre by
    // agent number (five patterns of 0.3 rad steps). Exactly antipodal goals send
    // all twenty through one point at one moment, and ORCA, which has no way to
    // slide round a neighbour, packs into a stationary clump there (measured
    // here: every agent stops within 15 s); turning the goals a little makes
    // the crowd swirl through instead
    goals.push(new Vec2(-p.x, -p.y).rotate(0.3 * (f32.from(i % 5) - 2.)));
    i = i + 1;
  }
  let dt = 0.05f;
  var minGap = 1000.f;
  var t = 0.;
  var arrived = false;
  while t < 60. && !arrived {
    var k = 0usize;
    while k < w.agents.len() {
      let a = *w.agents[k];
      let toGoal = *goals[k] - a.pos;
      let d = toGoal.length();
      let want = if d > 0.05 { toGoal * (clampf(d / 0.5, 0., 1.) * speed / d) } else { new Vec2(0., 0.) };
      w.setPreferred(k, want);
      k = k + 1usize;
    }
    w.step(dt);
    // Every pair, against the sum of the radii
    var p = 0usize;
    while p < w.agents.len() {
      var q = p + 1usize;
      while q < w.agents.len() {
        let gap = (*w.agents[p]).pos.distance((*w.agents[q]).pos) - ((*w.agents[p]).radius + (*w.agents[q]).radius);
        if gap < minGap { minGap = gap; }
        q = q + 1usize;
      }
      p = p + 1usize;
    }
    arrived = true;
    k = 0usize;
    while k < w.agents.len() {
      if (*w.agents[k]).pos.distance(*goals[k]) > 0.3 { arrived = false; }
      k = k + 1usize;
    }
    t = t + dt;
  }
  print <- "least gap between any two bodies (m): ", minGap, "\ntime to all arrive (s): ", t, "\n";
  expect(minGap >= 0., "no two agents ever overlap: distance never below the sum of radii");
  expect(arrived, "all twenty reach their goals");
  expect(t < 40., "in a reasonable time (the straight trip is 20 / 1.5 = 13 s)");
}

// Agents streaming past a pillar: none inside it, none overlapping
fn pillar() {
  var w = OrcaWorld.make(4., 12., 8usize);
  w.addObstacle(new Vec2(0., 0.), 2.);
  var goals = List[Vec2].empty();
  var i = 0;
  while i < 8 {
    let y = f32.from(i) * 0.9 - 3.15;
    w.addAgent(new Vec2(-12., y), 0.3, 1.5);
    goals.push(new Vec2(12., y));
    i = i + 1;
  }
  var minPillar = 1000.f;
  var minGap = 1000.f;
  var t = 0.;
  while t < 25. {
    var k = 0usize;
    while k < w.agents.len() {
      let a = *w.agents[k];
      let toGoal = *goals[k] - a.pos;
      let d = toGoal.length();
      w.setPreferred(k, if d > 0.05 { toGoal * (1.5 / d) } else { new Vec2(0., 0.) });
      k = k + 1usize;
    }
    w.step(0.05);
    k = 0usize;
    while k < w.agents.len() {
      let c = (*w.agents[k]).pos.length() - 2. - 0.3;
      if c < minPillar { minPillar = c; }
      var q = k + 1usize;
      while q < w.agents.len() {
        let gap = (*w.agents[k]).pos.distance((*w.agents[q]).pos) - 0.6;
        if gap < minGap { minGap = gap; }
        q = q + 1usize;
      }
      k = k + 1usize;
    }
    t = t + 0.05;
  }
  print <- "pillar: least clearance (m) ", minPillar, ", least gap ", minGap, "\n";
  expect(minPillar >= -0.02, "no agent goes into the pillar (to within a hundredth of a body)");
  expect(minGap >= 0., "and none touches another");
  var through = 0;
  var k = 0usize;
  while k < w.agents.len() {
    if (*w.agents[k]).pos.x > 11. { through = through + 1; }
    k = k + 1usize;
  }
  expectInt(i64.from(through), 8i64, "all eight get past");
}

fn main() i32 {
  headOn();
  crossing();
  pillar();
  done()
}
