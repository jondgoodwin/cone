// Each steering behaviour against its formula, worked out by hand (the
// numbers are in the comments), then whole runs: arrive stops, path following
// reaches the end of its corridor, and wander stays within its turning rate.

mod steering;
import testing use *;
import collections use List;
import geomath use *;
import npcbehave use *;

fn rt(x: f32) f32 { x.sqrt() }

fn v(got: Vec2, x: f32, y: f32, label: &Array[u8]) {
  expectFloat(got.x, x, 0.0001, label);
  expectFloat(got.y, y, 0.0001, label);
}

fn simpleOnes() {
  v(seek(new Vec2(0., 0.), new Vec2(0., 10.), 3.), 0., 3., "seek: full acceleration towards");
  // From (3, 4) away from the threat at the origin: direction (3, 4)/5, times 5
  v(flee(new Vec2(3., 4.), new Vec2(0., 0.), 5.), 3., 4., "flee: full acceleration away");

  // Arrive, target 10 away, slow radius 5, max speed 4, time to target 0.5:
  // outside the slow radius it wants speed 4 along x, and (4 - 0) / 0.5 = 8
  v(arrive(new Vec2(0., 0.), new Vec2(0., 0.), new Vec2(10., 0.), 100., 4., 0.1, 5., 0.5), 8., 0., "arrive: far, wants full speed");
  // 2.5 away: speed 4 * 2.5 / 5 = 2; at velocity 1 that is (2 - 1) / 0.5 = 2
  v(arrive(new Vec2(7.5, 0.), new Vec2(1., 0.), new Vec2(10., 0.), 100., 4., 0.1, 5., 0.5), 2., 0., "arrive: inside the slow radius");
  // Within the target radius it wants to stop: (0 - 1) / 0.5 = -2
  v(arrive(new Vec2(9.95, 0.), new Vec2(1., 0.), new Vec2(10., 0.), 100., 4., 0.1, 5., 0.5), -2., 0., "arrive: brakes inside the target radius");
  // Held to maxAccel
  v(arrive(new Vec2(0., 0.), new Vec2(0., 0.), new Vec2(10., 0.), 3., 4., 0.1, 5., 0.5), 3., 0., "arrive: held to maxAccel");

  // Pursue: from rest, the prediction is the maximum, 1 s: target (10, 0)
  // moving (0, 2) is expected at (10, 2); seek it at 2: (10, 2) / sqrt(104) * 2
  let k = 2. / rt(104.);
  v(pursue(new Vec2(0., 0.), new Vec2(0., 0.), 2., new Vec2(10., 0.), new Vec2(0., 2.), 1.), 10. * k, 2. * k, "pursue from rest");
  // At speed 20, 10 m away, the prediction is 10 / 20 = 0.5 s: (10, 1)
  let k2 = 2. / rt(101.);
  v(pursue(new Vec2(0., 0.), new Vec2(20., 0.), 2., new Vec2(10., 0.), new Vec2(0., 2.), 1.), 10. * k2, 1. * k2, "pursue with a short prediction");
  v(evade(new Vec2(0., 0.), new Vec2(20., 0.), 2., new Vec2(10., 0.), new Vec2(0., 2.), 1.), -10. * k2, -1. * k2, "evade is pursue reversed");
}

fn wanderTest() {
  var w = Wander.make(5u32);
  // After the first step the target's angle is (2 h - 1) * rate * dt, h the
  // hash of (seed, 1, 77); the target is offset ahead plus a unit circle at
  // that angle, and the acceleration is maxAccel towards it
  let angle = (unitHash(5u32, 1u32, 77u32) * 2. - 1.) * 2. * 0.5;
  let target = new Vec2(2., 0.) + new Vec2(cos(angle), sin(angle));
  let want = target.normalize() * 3.;
  v(w.accel(new Vec2(0., 0.), new Vec2(1., 0.), 3., 2., 1., 2., 0.5), want.x, want.y, "wander: seek the target on the circle");
  // Over many steps the angle never moves faster than rate * dt
  var maxStep = 0.f;
  var prev = w.angle;
  var i = 0;
  while i < 500 {
    w.accel(new Vec2(0., 0.), new Vec2(1., 0.), 3., 2., 1., 2., 0.1);
    let s = w.angle - prev;
    let a = if s < 0. { -s } else { s };
    if a > maxStep { maxStep = a; }
    prev = w.angle;
    i = i + 1;
  }
  expect(maxStep <= 2. * 0.1 + 0.00001, "wander turns at most rate * dt a step");
  expect(maxStep > 0.1, "wander does turn");
}

fn arriveRun() {
  var b = Body2.make(new Vec2(0., 0.), 0.5, 4., 6.);
  let target = new Vec2(10., 5.);
  var t = 0.;
  var maxSpeedSeen = 0.f;
  while t < 15. {
    b.integrate(arrive(b.pos, b.vel, target, b.maxAccel, b.maxSpeed, 0.1, 5., 0.4), 1. / 60.);
    if b.vel.length() > maxSpeedSeen { maxSpeedSeen = b.vel.length(); }
    t = t + 1. / 60.;
  }
  expect(b.pos.distance(target) < 0.15, "arrive: within 0.15 m of the target after 15 s");
  expect(b.vel.length() < 0.05, "arrive: at rest");
  expect(maxSpeedSeen <= 4.0001, "arrive: never faster than the limit");
  expect(maxSpeedSeen > 3., "arrive: did get up to speed");
}

fn pathTest() {
  var path = List[Vec2].empty();
  path.push(new Vec2(0., 0.));
  path.push(new Vec2(10., 0.));
  path.push(new Vec2(10., 10.));
  var f = PathFollower.make();
  // At (0, 1) at rest the nearest path point to the prediction is (0, 0); 2 m
  // on is (2, 0); seek it at 3: (2, -1) / sqrt(5) * 3
  let a = f.accel(new Vec2(0., 1.), new Vec2(0., 0.), path.view(), 3., 4., 0.5, 2., 0.3, 3.);
  v(a, 2. / rt(5.) * 3., -1. / rt(5.) * 3.,"path following: seek the point ahead on the path");

  var b = Body2.make(new Vec2(0., 2.), 0.5, 3., 5.);
  f.restart();
  var t = 0.;
  var farthest = 0.f;
  while t < 30. && !f.done {
    b.integrate(f.accel(b.pos, b.vel, path.view(), b.maxAccel, b.maxSpeed, 0.5, 1.5, 0.3, 3.), 1. / 60.);
    // Distance from the path's nearest segment
    let d0 = closestPointOnSegment(b.pos, *path[0usize], *path[1usize]).distance(b.pos);
    let d1 = closestPointOnSegment(b.pos, *path[1usize], *path[2usize]).distance(b.pos);
    let d = if d0 < d1 { d0 } else { d1 };
    if d > farthest { farthest = d; }
    t = t + 1. / 60.;
  }
  expect(f.done, "path following: reached the end");
  expect(b.pos.distance(new Vec2(10., 10.)) < 0.35, "path following: ends at the last point");
  expect(farthest < 2.5, "path following: stayed near the corridor round the corner");
}

fn avoidTest() {
  var obs = List[Circle].empty();
  obs.push(new Circle(new Vec2(6., 0.5), 1.));
  // Moving along x at 4 with radius 0.5; the circle is 6 ahead and 0.5 to the
  // left. Reach 1.5, so the ray enters at 6 - sqrt(2.25 - 0.25) = 4.585786;
  // with a look-ahead of 10 the push is 5 * (1 - 0.4585786) = 2.707107, to the right
  v(avoidObstacles(new Vec2(0., 0.), new Vec2(4., 0.), 0.5, 5., 10., obs.view()), 0., -2.707107, "avoid: swerve right of a circle on the left");
  var obs2 = List[Circle].empty();
  obs2.push(new Circle(new Vec2(6., -0.5), 1.));
  v(avoidObstacles(new Vec2(0., 0.), new Vec2(4., 0.), 0.5, 5., 10., obs2.view()), 0., 2.707107, "avoid: swerve left of a circle on the right");
  var obs3 = List[Circle].empty();
  obs3.push(new Circle(new Vec2(6., 3.), 1.));
  v(avoidObstacles(new Vec2(0., 0.), new Vec2(4., 0.), 0.5, 5., 10., obs3.view()), 0., 0., "avoid: a circle off to the side is ignored");
  var obs4 = List[Circle].empty();
  obs4.push(new Circle(new Vec2(-6., 0.), 1.));
  v(avoidObstacles(new Vec2(0., 0.), new Vec2(4., 0.), 0.5, 5., 10., obs4.view()), 0., 0., "avoid: a circle behind is ignored");
  v(avoidObstacles(new Vec2(0., 0.), new Vec2(4., 0.), 0.5, 5., 4., obs.view()), 0., 0., "avoid: beyond the look-ahead is ignored");

  // A run: walk straight at a pillar with avoidance and seek, never touch it
  var b = Body2.make(new Vec2(0., 0.1), 0.4, 3., 8.);
  b.vel = new Vec2(3., 0.);
  var pillar = List[Circle].empty();
  pillar.push(new Circle(new Vec2(10., 0.), 1.5));
  let goal = new Vec2(25., 0.);
  var closest = 1000.f;
  var t = 0.;
  while t < 12. {
    var blend = SteeringBlend.make();
    blend.add(0u32, 1., avoidObstacles(b.pos, b.vel, b.radius, b.maxAccel, 6., pillar.view()));
    blend.add(1u32, 1., seek(b.pos, goal, b.maxAccel));
    b.integrate(blend.prioritized(b.maxAccel, 0.01), 1. / 60.);
    let d = b.pos.distance(new Vec2(10., 0.)) - 1.5 - b.radius;
    if d < closest { closest = d; }
    t = t + 1. / 60.;
  }
  expect(closest > 0., "avoid: a walker aimed at a pillar goes round it");
  expect(b.pos.x > 20., "avoid: and goes on towards the goal");
}

fn groupTest() {
  var crowd = List[Body2].empty();
  crowd.push(Body2.make(new Vec2(0., 0.), 0.5, 3., 10.));
  crowd.push(Body2.make(new Vec2(2., 0.), 0.5, 3., 10.));
  // The other at 2 m: strength 4 / 4 = 1, pushing away along -x
  v(separation(0usize, crowd.view(), 5., 4., 10.), -1., 0., "separation: inverse square");
  // At 1 m the strength 4 is held to maxAccel 3
  crowd.set(1usize, Body2.make(new Vec2(1., 0.), 0.5, 3., 10.));
  v(separation(0usize, crowd.view(), 5., 4., 3.), -3., 0., "separation: held to maxAccel");
  v(separation(0usize, crowd.view(), 0.5, 4., 3.), 0., 0., "separation: nothing outside the radius");

  var a = Body2.make(new Vec2(0., 0.), 0.5, 3., 10.);
  var b = Body2.make(new Vec2(4., 0.), 0.5, 3., 10.);
  var c = Body2.make(new Vec2(0., 4.), 0.5, 3., 10.);
  b.vel = new Vec2(2., 0.);
  c.vel = new Vec2(0., 2.);
  var three = List[Body2].empty();
  three.push(a);
  three.push(b);
  three.push(c);
  // The mean velocity (1, 1), at rest now, in 0.5 s: (2, 2)
  v(alignment(0usize, three.view(), 10., 0.5, 100.), 2., 2., "alignment");
  // The centre of the others is (2, 2); seek at 3: 3 / sqrt(2) each way
  let s = 3. / rt(2.);
  v(cohesion(0usize, three.view(), 10., 3.), s, s, "cohesion");
}

fn blendTest() {
  var bl = SteeringBlend.make();
  bl.add(0u32, 2., new Vec2(1., 0.));
  bl.add(1u32, 0.5, new Vec2(0., 1.));
  v(bl.weighted(10.), 2., 0.5, "weighted blend: the sum of weight * acceleration");
  v(bl.weighted(1.), 2. / rt(4.25), 0.5 / rt(4.25), "weighted blend: held to maxAccel");

  var p = SteeringBlend.make();
  p.add(1u32, 1., new Vec2(1., 0.));
  p.add(0u32, 1., new Vec2(0., 0.));
  v(p.prioritized(5., 0.1), 1., 0., "priority blend: silent priority 0 lets priority 1 through");
  p.add(0u32, 1., new Vec2(0., 3.));
  v(p.prioritized(2., 0.1), 0., 2., "priority blend: priority 0 overrides, held to maxAccel");
  var q = SteeringBlend.make();
  v(q.prioritized(2., 0.1), 0., 0., "priority blend: nothing at all");
}

fn main() i32 {
  simpleOnes();
  wanderTest();
  arriveRun();
  pathTest();
  avoidTest();
  groupTest();
  blendTest();
  done()
}
