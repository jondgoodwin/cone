// Shared small things: tick results, the hash random numbers, the moving body.

// What a node of a behaviour tree, or a leaf action, answers when ticked
pub const SUCCESS = 0u32;
pub const FAILURE = 1u32;
pub const RUNNING = 2u32;

// The ground-plane position of a 3-D point: (x, z)
pub fn ground(v Vec3) Vec2 inline { new Vec2(v.x, v.z) }

// A ground-plane position at height y
pub fn lift(v Vec2, y f32) Vec3 inline { new Vec3(v.x, y, v.y) }

pub fn clampf(v f32, lo f32, hi f32) f32 inline {
  if v < lo { lo } elif v > hi { hi } else { v }
}

// The vector shortened to 'maxLen' if it is longer; its direction kept
pub fn truncate(v Vec2, maxLen f32) Vec2 {
  let l2 = v.lengthSquared();
  if l2 > maxLen * maxLen && l2 > 0. { v * (maxLen / l2.sqrt()) } else { v }
}

// A hash of (seed, a) to [0, 1): the PCG mix noise uses, chained (the same
// construction as boidflock's)
pub fn unitHash(seed u32, a u32, b u32) f32 {
  f32.from(pcg(seed ^ pcg(a ^ pcg(b))) >> 8u32) * 0.000000059604644775390625
}

fn pcg(v u32) u32 {
  let state = v * 747796405u + 2891336453u;
  let word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  (word >> 22u) ^ word
}

// A point mass on the ground plane: what steering accelerates and ORCA
// avoids with
pub struct Body2 {
  pub pos Vec2;
  pub vel Vec2;
  pub radius f32;      // its body, for avoidance
  pub maxSpeed f32;    // m/s
  pub maxAccel f32;    // m/s2

  pub fn make(pos Vec2, radius f32, maxSpeed f32, maxAccel f32) Body2 {
    new Body2(pos, new Vec2(0., 0.), radius, maxSpeed, maxAccel)
  }

  // Semi-implicit Euler: the velocity changes first, held to the speed
  // limit, and the position moves by the new velocity. The acceleration is
  // held to maxAccel
  pub fn integrate(self &mut, accel Vec2, dt f32) {
    vel = truncate(vel + truncate(accel, maxAccel) * dt, maxSpeed);
    pos = pos + vel * dt;
  }

  // The unit vector it moves along, or (1, 0) at rest
  pub fn heading(self) Vec2 { vel.normalize() }
}
