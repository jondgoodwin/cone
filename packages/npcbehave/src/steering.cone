// Steering: each function answers an acceleration (m/s2, a Vec2 on the ground
// plane, at most maxAccel long) for a character at 'pos' moving at 'vel'.
// The formulas are Reynolds's (GDC 1999) and Millington's (AI for Games, 3rd
// ed., ch. 3); each says which. The caller adds the acceleration to its Body2
// ('Body2.integrate'), or blends several first (SteeringBlend).

// -------- seek and flee (Millington 3.1.1): full acceleration towards or away --------

pub fn seek(pos: Vec2, target: Vec2, maxAccel: f32) Vec2 {
  (target - pos).normalize() * maxAccel
}

pub fn flee(pos: Vec2, threat: Vec2, maxAccel: f32) Vec2 {
  (pos - threat).normalize() * maxAccel
}

// -------- arrive (Millington 3.1.4) --------
//
// Outside 'slowRadius' the character wants full speed towards the target;
// inside it, a speed that falls in proportion to the distance, so it comes
// to rest at the target. The acceleration brings the velocity to the wanted
// one in 'timeToTarget' seconds. Inside 'targetRadius' the wanted velocity is
// zero. (Millington returns no steering there and lets the character coast;
// this one brakes, so arriving means stopping.)
pub fn arrive(pos: Vec2, vel: Vec2, target: Vec2, maxAccel: f32, maxSpeed: f32,
              targetRadius: f32, slowRadius: f32, timeToTarget: f32) Vec2 {
  let d = target - pos;
  let dist = d.length();
  var speed = maxSpeed;
  if dist < targetRadius { speed = 0.; }
  else if dist < slowRadius { speed = maxSpeed * dist / slowRadius; }
  let want = if dist > 0.000001 { d * (speed / dist) } else { Vec2(0., 0.) };
  truncate((want - vel) * (1. / timeToTarget), maxAccel)
}

// -------- pursue and evade (Millington 3.2.1) --------
//
// Seek, or flee, the place the target will be: its position plus its velocity
// times a prediction time of distance / our speed, capped at maxPrediction.
pub fn predictedPosition(pos: Vec2, speed: f32, targetPos: Vec2, targetVel: Vec2, maxPrediction: f32) Vec2 {
  let dist = (targetPos - pos).length();
  var t = maxPrediction;
  if speed > dist / maxPrediction { t = dist / speed; }
  targetPos + targetVel * t
}

pub fn pursue(pos: Vec2, vel: Vec2, maxAccel: f32, targetPos: Vec2, targetVel: Vec2, maxPrediction: f32) Vec2 {
  seek(pos, predictedPosition(pos, vel.length(), targetPos, targetVel, maxPrediction), maxAccel)
}

pub fn evade(pos: Vec2, vel: Vec2, maxAccel: f32, threatPos: Vec2, threatVel: Vec2, maxPrediction: f32) Vec2 {
  flee(pos, predictedPosition(pos, vel.length(), threatPos, threatVel, maxPrediction), maxAccel)
}

// -------- wander (Reynolds 1999; Millington 3.2.2's "delegated" wander) --------
//
// A target on a circle of radius 'radius' whose centre is 'offset' ahead of
// the character; the target's angle on the circle wanders by a random amount
// of up to 'rate' radians a second. Seek the target. 'heading' is the way
// the character faces (its velocity's direction, or its last when still).
pub struct Wander {
  pub angle: f32;       // the target's angle on the circle, radians
  pub seed: u32;
  pub steps: u32;

  pub fn make(seed: u32) Wander { Wander(0., seed, 0u32) }

  pub fn accel(self: &mut, pos: Vec2, heading: Vec2, maxAccel: f32, offset: f32, radius: f32, rate: f32, dt: f32) Vec2 {
    steps = steps + 1u32;
    angle = angle + (unitHash(seed, steps, 77u32) * 2. - 1.) * rate * dt;
    let target = pos + heading * offset + Vec2.fromAngle(angle) * radius;
    seek(pos, target, maxAccel)
  }
}

// -------- path following (Reynolds 1999: predictive; Millington 3.2.6) --------
//
// The corridor is a list of points (a navmesh's smoothed path). Predict where
// the character will be in 'predictTime' seconds, find the nearest point on
// the path to that, and seek a point 'ahead' metres further along it, so the
// character is pulled back to the path and then along it. The nearest point
// is searched only from the segment last used to two ahead of it, so a path
// that doubles back is not short-cut. Near the end it arrives instead. 'done'
// becomes true once the character is within 'arriveRadius' of the last point.
pub struct PathFollower {
  pub seg: usize;       // the segment last found nearest
  pub done: bool;

  pub fn make() PathFollower { PathFollower(0usize, false) }

  pub fn restart(self: &mut) { seg = 0usize; done = false; }

  pub fn accel(self: &mut, pos: Vec2, vel: Vec2, path: &Array[Vec2], maxAccel: f32, maxSpeed: f32,
               predictTime: f32, ahead: f32, arriveRadius: f32, slowRadius: f32) Vec2 {
    let n = path.len();
    if n == 0usize { done = true; return Vec2(0., 0.); }
    let last = path[n - 1usize];
    if n == 1usize || pos.distance(last) < arriveRadius {
      if pos.distance(last) < arriveRadius { done = true; }
      return arrive(pos, vel, last, maxAccel, maxSpeed, arriveRadius, slowRadius, 0.2);
    }
    let predicted = pos + vel * predictTime;
    var bestSeg = seg;
    var bestT = 0.f;
    var bestD = 1000000000.f;
    var i = seg;
    let hi = if seg + 3usize < n - 1usize { seg + 3usize } else { n - 1usize };
    while i < hi {
      let a = path[i];
      let b = path[i + 1usize];
      let ab = b - a;
      let len2 = ab.lengthSquared();
      let t = if len2 > 0. { clampf((predicted - a).dot(ab) / len2, 0., 1.) } else { 0. };
      let d = predicted.distance(a + ab * t);
      if d < bestD { bestD = d; bestSeg = i; bestT = t; }
      i = i + 1usize;
    }
    seg = bestSeg;
    // Walk 'ahead' metres on from the nearest point
    var s = bestSeg;
    let segA = path[s];
    let segB = path[s + 1usize];
    var cur = segA + (segB - segA) * bestT;
    var left = ahead;
    var reachedEnd = false;
    while left > 0. && !reachedEnd {
      let next = path[s + 1usize];
      let d = cur.distance(next);
      if d >= left {
        cur = cur + (next - cur).normalize() * left;
        left = 0.;
      } else {
        left = left - d;
        cur = next;
        if s + 2usize < n { s = s + 1usize; } else { reachedEnd = true; }
      }
    }
    if reachedEnd { return arrive(pos, vel, last, maxAccel, maxSpeed, arriveRadius, slowRadius, 0.2); }
    seek(pos, cur, maxAccel)
  }
}

// -------- obstacle avoidance against circles (Reynolds 1999; Millington 3.3) --------
//
// A ray from the character along its velocity, 'lookahead' metres long. Of
// the circles (grown by the character's own radius) the ray enters, the one it
// enters soonest is the threat. The acceleration is sideways, away from the
// circle's centre, and grows from 0 at the ray's end to maxAccel at the
// circle. A character at rest, or with nothing ahead, has none.
pub fn avoidObstacles(pos: Vec2, vel: Vec2, radius: f32, maxAccel: f32, lookahead: f32, obstacles: &Array[Circle]) Vec2 {
  let speed = vel.length();
  if speed < 0.000001 { return Vec2(0., 0.); }
  let dir = vel * (1. / speed);
  let side = dir.perp();
  var bestT = 1000000000.f;
  var bestSide = 1.f;
  var found = false;
  var i = 0usize;
  while i < obstacles.len() {
    let c = obstacles[i];
    let rel = c.center - pos;
    let along = rel.dot(dir);
    let lateral = rel.dot(side);
    let reach = c.radius + radius;
    if along > 0. && along - reach < lookahead && lateral * lateral < reach * reach {
      let enter = along - (reach * reach - lateral * lateral).sqrt();
      let t = if enter > 0. { enter } else { 0. };
      if t < bestT {
        bestT = t;
        found = true;
        bestSide = if lateral >= 0. { 1. } else { -1. };
      }
    }
    i = i + 1usize;
  }
  if !found || bestT >= lookahead { return Vec2(0., 0.); }
  // The obstacle on the left (positive side) is passed on the right
  side * (-bestSide * maxAccel * (1. - bestT / lookahead))
}

// -------- group behaviours (Reynolds 1987; Millington 3.2.5 for separation) --------
//
// 'self' is the index of the character in 'others', skipped. Only characters
// within 'radius' count.

// Away from each neighbour, by an inverse square law: decay / distance^2,
// held to maxAccel
pub fn separation(self: usize, others: &Array[Body2], radius: f32, decay: f32, maxAccel: f32) Vec2 {
  let me = others[self];
  var sum = Vec2(0., 0.);
  var i = 0usize;
  while i < others.len() {
    if i != self {
      let d = me.pos - others[i].pos;
      let d2 = d.lengthSquared();
      if d2 < radius * radius && d2 > 0.000000001 {
        let strength = if decay / d2 < maxAccel { decay / d2 } else { maxAccel };
        sum = sum + d.normalize() * strength;
      }
    }
    i = i + 1usize;
  }
  truncate(sum, maxAccel)
}

// Towards the neighbours' mean velocity, reached in 'timeToMatch' seconds
pub fn alignment(self: usize, others: &Array[Body2], radius: f32, timeToMatch: f32, maxAccel: f32) Vec2 {
  let me = others[self];
  var sum = Vec2(0., 0.);
  var count = 0.f;
  var i = 0usize;
  while i < others.len() {
    if i != self && me.pos.distance(others[i].pos) < radius {
      sum = sum + others[i].vel;
      count = count + 1.;
    }
    i = i + 1usize;
  }
  if count == 0. { return Vec2(0., 0.); }
  truncate((sum * (1. / count) - me.vel) * (1. / timeToMatch), maxAccel)
}

// Seek the neighbours' centre
pub fn cohesion(self: usize, others: &Array[Body2], radius: f32, maxAccel: f32) Vec2 {
  let me = others[self];
  var sum = Vec2(0., 0.);
  var count = 0.f;
  var i = 0usize;
  while i < others.len() {
    if i != self && me.pos.distance(others[i].pos) < radius {
      sum = sum + others[i].pos;
      count = count + 1.;
    }
    i = i + 1usize;
  }
  if count == 0. { return Vec2(0., 0.); }
  seek(me.pos, sum * (1. / count), maxAccel)
}

// -------- blending (Millington 3.4) --------
//
// Up to 16 behaviours each add (priority, weight, acceleration). 'weighted'
// is the weighted sum, held to maxAccel. 'prioritized' is Millington's
// priority arbitration: the entries of the smallest priority number are
// blended by weight, and if that is longer than 'epsilon' it is the answer;
// otherwise the next priority is tried, and the last one's blend is returned
// whatever its size. (So obstacle avoidance at priority 0 overrides the rest
// whenever it has something to say, and says nothing when the way is clear.)
// Fixed storage: nothing is allocated.
pub struct SteeringBlend {
  prio: Array[u32, 16];
  weight: Array[f32, 16];
  acc: Array[Vec2, 16];
  pub count: usize;

  pub fn make() SteeringBlend {
    SteeringBlend(Array[u32, 16]() <- fill 0u32, Array[f32, 16]() <- fill 0., Array[Vec2, 16]() <- fill Vec2(0., 0.), 0usize)
  }

  pub fn clear(self: &mut) { count = 0usize; }

  // Entries past sixteen are ignored
  pub fn add(self: &mut, priority: u32, w: f32, a: Vec2) {
    if count < 16usize {
      prio[count] = priority;
      weight[count] = w;
      acc[count] = a;
      count = count + 1usize;
    }
  }

  pub fn weighted(self: &, maxAccel: f32) Vec2 {
    var sum = Vec2(0., 0.);
    var i = 0usize;
    while i < count {
      sum = sum + acc[i] * weight[i];
      i = i + 1usize;
    }
    truncate(sum, maxAccel)
  }

  pub fn prioritized(self: &, maxAccel: f32, epsilon: f32) Vec2 {
    // Walk the priorities in ascending order without sorting: each round
    // takes the smallest priority above the last one tried
    var tried = 0u32;
    var first = true;
    var result = Vec2(0., 0.);
    var more = true;
    while more {
      var p = 0u32;
      var have = false;
      var i = 0usize;
      while i < count {
        if (first || prio[i] > tried) && (!have || prio[i] < p) { p = prio[i]; have = true; }
        i = i + 1usize;
      }
      if !have {
        more = false;
      } else {
        var sum = Vec2(0., 0.);
        i = 0usize;
        while i < count {
          if prio[i] == p { sum = sum + acc[i] * weight[i]; }
          i = i + 1usize;
        }
        result = truncate(sum, maxAccel);
        if result.length() > epsilon { more = false; }
        tried = p;
        first = false;
      }
    }
    result
  }
}
