// crowd50: fifty characters in a 60 m square courtyard with six pillars,
// simulated for 90 s, and a top-down picture of where each walked.
//
//   congo run packages/npcbehave/examples/crowd50.cone -- --out trace.bmp
//
// Without '--out' nothing is written. The cast, each steering with the
// package's behaviours to a preferred velocity, which ORCA then bends so that
// nobody walks into anybody or into a pillar:
//
//   blue    20 commuters  cross the courtyard to a point on the far side with
//                         'arrive', then pick another
//   green   15 wanderers  'Wander', gently leashed to the middle
//   orange  10 flockers   separation, alignment and cohesion, blended with a wander
//   red      5 fleers     'evade' the yellow "player", who walks a circle at 2.5 m/s,
//                         and 'seek' their own spot otherwise
//
// The picture is 900 x 900, 15 pixels to the metre, +z up the page: a line
// for each character's track (a dot every 0.2 s), a disc for each pillar, a
// white ring at each character's last position, the player's track in yellow.

mod crowd50;

import stdio use *;
import fs;
import path use Path;
import collections use *;
import geomath use *;
import npcbehave use *;

const SIZE = 900;
const SCALE = 15.f;
const HALF = 30.f;
const NPILLARS = 6usize;

// ---- a tiny image ----

struct Canvas {
  px List[u8];       // RGB, top row first

  fn make() Canvas {
    var px = List[u8].withCapacity(usize.from(SIZE * SIZE * 3));
    var i = 0;
    while i < SIZE * SIZE {
      px.push(18u8);
      px.push(20u8);
      px.push(26u8);
      i = i + 1;
    }
    new Canvas(px)
  }

  fn set(self &mut, x i32, y i32, r u8, g u8, b u8) {
    if x < 0 or y < 0 or x >= SIZE or y >= SIZE { return; }
    let p = usize.from((y * SIZE + x) * 3);
    px.set(p, r);
    px.set(p + 1usize, g);
    px.set(p + 2usize, b);
  }

  // Bresenham
  fn line(self &mut, x0 i32, y0 i32, x1 i32, y1 i32, r u8, g u8, b u8) {
    var x = x0;
    var y = y0;
    let dx = if x1 > x0 { x1 - x0 } else { x0 - x1 };
    let dy = if y1 > y0 { y0 - y1 } else { y1 - y0 };
    let sx = if x0 < x1 { 1 } else { -1 };
    let sy = if y0 < y1 { 1 } else { -1 };
    var err = dx + dy;
    var going = true;
    while going {
      self.set(x, y, r, g, b);
      if x == x1 and y == y1 { going = false; }
      else {
        let e2 = 2 * err;
        if e2 >= dy { err = err + dy; x = x + sx; }
        if e2 <= dx { err = err + dx; y = y + sy; }
      }
    }
  }

  fn disc(self &mut, cx i32, cy i32, rad i32, r u8, g u8, b u8, ring bool) {
    var y = -rad - 1;
    while y <= rad + 1 {
      var x = -rad - 1;
      while x <= rad + 1 {
        let d2 = x * x + y * y;
        if ring { if d2 <= (rad + 1) * (rad + 1) and d2 >= (rad - 1) * (rad - 1) { self.set(cx + x, cy + y, r, g, b); } }
        elif d2 <= rad * rad { self.set(cx + x, cy + y, r, g, b); }
        x = x + 1;
      }
      y = y + 1;
    }
  }

  fn toBmp(self &) List[u8] {
    var out = List[u8].withCapacity(usize.from(54 + SIZE * SIZE * 3));
    out.push('B');
    out.push('M');
    put32(&mut out, u32.from(54 + SIZE * SIZE * 3));
    put32(&mut out, 0u32);
    put32(&mut out, 54u32);
    put32(&mut out, 40u32);
    put32(&mut out, u32.from(SIZE));
    put32(&mut out, u32.from(SIZE));
    out.push(1u8);
    out.push(0u8);
    out.push(24u8);
    out.push(0u8);
    put32(&mut out, 0u32);
    put32(&mut out, u32.from(SIZE * SIZE * 3));
    put32(&mut out, 2835u32);
    put32(&mut out, 2835u32);
    put32(&mut out, 0u32);
    put32(&mut out, 0u32);
    // Rows bottom first, blue green red
    var y = SIZE - 1;
    while y >= 0 {
      var x = 0;
      while x < SIZE {
        let p = usize.from((y * SIZE + x) * 3);
        out.push(*px[p + 2usize]);
        out.push(*px[p + 1usize]);
        out.push(*px[p]);
        x = x + 1;
      }
      y = y - 1;
    }
    out
  }
}

fn put32(out &mut List[u8], v u32) {
  out.push(u8.from(v & 0xFFu32));
  out.push(u8.from((v >> 8u32) & 0xFFu32));
  out.push(u8.from((v >> 16u32) & 0xFFu32));
  out.push(u8.from((v >> 24u32) & 0xFFu32));
}

fn px(x f32) i32 { i32.from((x + HALF) * SCALE) }
fn py(z f32) i32 { i32.from((HALF - z) * SCALE) }

// ---- arguments ----

fn cstrEquals(a *u8, b &Array[u8]) bool {
  var i = 0usize;
  while i < b.len {
    if *(a + i) != b[i] { return false; }
    i = i + 1usize;
  }
  *(a + b.len) == 0u8
}

fn cstrString(s *u8) String {
  var out = String.empty();
  var i = 0usize;
  while *(s + i) != 0u8 {
    out.appendByte(*(s + i));
    i = i + 1usize;
  }
  out
}

// ---- the cast ----

const COMMUTER = 0;
const WANDERER = 1;
const FLOCKER = 2;
const FLEER = 3;

fn roleOf(i usize) i32 {
  if i < 20usize { COMMUTER } elif i < 35usize { WANDERER } elif i < 45usize { FLOCKER } else { FLEER }
}

fn randomIn(seed u32, a u32, b u32, lo f32, hi f32) f32 { lo + (hi - lo) * unitHash(seed, a, b) }

fn main(argc i32, argv **u8) i32 {
  var outFile = String.empty();
  var a = 1;
  while a < argc {
    let arg = *(argv + usize.from(a));
    if cstrEquals(arg, "--out") and a + 1 < argc {
      outFile = cstrString(*(argv + usize.from(a + 1)));
      a = a + 1;
    } else {
      print <- "Unknown argument; use --out FILE.bmp\n";
      return 2;
    }
    a = a + 1;
  }

  let seed = 11u32;
  let radius = 0.35f;
  var world = OrcaWorld.make(4., 6., 10usize);
  let pillars = new Array[Circle, 6] <- new Circle(new Vec2(0., 0.), 3.), new Circle(new Vec2(-12., 10.), 2.),
    new Circle(new Vec2(12., 10.), 2.), new Circle(new Vec2(-12., -10.), 2.), new Circle(new Vec2(12., -10.), 2.),
    new Circle(new Vec2(0., 18.), 1.5);
  var p = 0usize;
  while p < NPILLARS {
    world.addObstacle(pillars[p].center, pillars[p].radius);
    p = p + 1usize;
  }

  // Place 50 characters not inside a pillar, and give each a goal and a wander
  let n = 50usize;
  var goals = List[Vec2].empty();
  var wanders = List[Wander].empty();
  var i = 0usize;
  while i < n {
    let ui = u32.from(i);
    let role = roleOf(i);
    var pos = new Vec2(0., 0.);
    if role == COMMUTER {
      // Left or right edge; the goal is on the other side
      let left = i % 2usize == 0usize;
      pos = new Vec2(if left { -27. } else { 27. }, randomIn(seed, ui, 1u32, -25., 25.));
      goals.push(new Vec2(if left { 27. } else { -27. }, randomIn(seed, ui, 2u32, -25., 25.)));
    } elif role == FLEER {
      // Homes on the circle the player walks, evenly spaced
      pos = Vec2.fromAngle(f32.from(i - 45usize) * 1.2566) * 22.;
      goals.push(pos);
    } else {
      pos = new Vec2(randomIn(seed, ui, 3u32, -26., 26.), randomIn(seed, ui, 4u32, -26., 26.));
      goals.push(pos);
    }
    // Out of any pillar
    var k = 0usize;
    while k < NPILLARS {
      let c = pillars[k];
      if pos.distance(c.center) < c.radius + 1.5 { pos = c.center + (pos - c.center).normalize() * (c.radius + 1.8); }
      k = k + 1usize;
    }
    world.addAgent(pos, radius, if role == COMMUTER { 1.6 } elif role == FLEER { 3. } else { 1.3 });
    wanders.push(Wander.make(seed + ui));
    i = i + 1usize;
  }

  var canvas = Canvas.make();
  // Pillars first, so tracks draw over them
  p = 0usize;
  while p < NPILLARS {
    canvas.disc(px(pillars[p].center.x), py(pillars[p].center.y), i32.from(pillars[p].radius * SCALE), 70u8, 72u8, 80u8, false);
    p = p + 1usize;
  }

  var last = List[Vec2].empty();
  i = 0usize;
  while i < n { last.push((*world.agents[i]).pos); i = i + 1usize; }
  var playerLast = new Vec2(22., 0.);

  let dt = 0.05f;
  let steps = 1800;
  var minGap = 1000.f;
  var minPillar = 1000.f;
  var arrivals = 0;
  var speedSum = 0.;
  var speedCount = 0.;
  var fleerClosest = 1000.f;
  var s = 0;
  while s < steps {
    let t = f32.from(s) * dt;
    let player = new Vec2(22. * cos(t * 0.1136), 22. * sin(t * 0.1136));
    let playerVel = new Vec2(-2.5 * sin(t * 0.1136), 2.5 * cos(t * 0.1136));

    // The bodies as steering sees them
    var crowd = List[Body2].empty();
    i = 0usize;
    while i < n {
      let ag = *world.agents[i];
      var b = Body2.make(ag.pos, ag.radius, ag.maxSpeed, 3.);
      b.vel = ag.vel;
      crowd.push(b);
      i = i + 1usize;
    }

    i = 0usize;
    while i < n {
      let ag = *world.agents[i];
      let role = roleOf(i);
      let ui = u32.from(i);
      var acc = new Vec2(0., 0.);
      if role == COMMUTER {
        if ag.pos.distance(*goals[i]) < 1.5 {
          arrivals = arrivals + 1;
          let toRight = (*goals[i]).x > 0.;
          goals.set(i, new Vec2(if toRight { -27. } else { 27. }, randomIn(seed, ui, u32.from(s) + 10u32, -25., 25.)));
        }
        acc = arrive(ag.pos, ag.vel, *goals[i], 3., ag.maxSpeed, 0.5, 3., 0.5);
      } elif role == WANDERER {
        var w = *wanders[i];
        acc = w.accel(ag.pos, if ag.vel.length() > 0.1 { ag.vel.normalize() } else { new Vec2(1., 0.) }, 2., 2., 1., 1.5, dt);
        wanders.set(i, w);
        acc = acc + seek(ag.pos, new Vec2(0., 0.), 4. * clampf((ag.pos.length() - 10.) / 8., 0., 1.));
      } elif role == FLOCKER {
        var blend = SteeringBlend.make();
        blend.add(0u32, 1.5, separation(i, crowd.view(), 4., 2., 3.));
        blend.add(0u32, 1.0, alignment(i, crowd.view(), 8., 1., 3.));
        blend.add(0u32, 0.8, cohesion(i, crowd.view(), 10., 3.));
        var w = *wanders[i];
        blend.add(0u32, 0.5, w.accel(ag.pos, if ag.vel.length() > 0.1 { ag.vel.normalize() } else { new Vec2(1., 0.) }, 2., 2., 1., 1.0, dt));
        wanders.set(i, w);
        blend.add(0u32, 1., seek(ag.pos, new Vec2(0., 0.), 4. * clampf((ag.pos.length() - 10.) / 8., 0., 1.)));
        acc = blend.weighted(3.);
      } else {
        let d = ag.pos.distance(player);
        // (not in the first 5 s: they begin where the player does)
        if d < fleerClosest and s > 100 { fleerClosest = d; }
        if d < 8. { acc = evade(ag.pos, ag.vel, 5., player, playerVel, 1.5); }
        else { acc = arrive(ag.pos, ag.vel, *goals[i], 3., ag.maxSpeed * 0.5, 0.5, 3., 0.5); }
      }
      // Wanderers and flockers keep an easy pace
      let want = truncate(ag.vel + acc * dt * 4., ag.maxSpeed);
      world.setPreferred(i, want);
      i = i + 1usize;
    }
    world.step(dt);

    // Measures, and the trail every 0.2 s
    i = 0usize;
    while i < n {
      let ag = *world.agents[i];
      speedSum = speedSum + ag.vel.length();
      speedCount = speedCount + 1.;
      var j = i + 1usize;
      while j < n {
        let g = ag.pos.distance((*world.agents[j]).pos) - 2. * radius;
        if g < minGap { minGap = g; }
        j = j + 1usize;
      }
      var k = 0usize;
      while k < NPILLARS {
        let c = ag.pos.distance(pillars[k].center) - pillars[k].radius - radius;
        if c < minPillar { minPillar = c; }
        k = k + 1usize;
      }
      i = i + 1usize;
    }
    if s % 4 == 3 {
      i = 0usize;
      while i < n {
        let now = (*world.agents[i]).pos;
        let role = roleOf(i);
        let l = *last[i];
        if role == COMMUTER { canvas.line(px(l.x), py(l.y), px(now.x), py(now.y), 90u8, 150u8, 255u8); }
        elif role == WANDERER { canvas.line(px(l.x), py(l.y), px(now.x), py(now.y), 90u8, 220u8, 120u8); }
        elif role == FLOCKER { canvas.line(px(l.x), py(l.y), px(now.x), py(now.y), 255u8, 170u8, 60u8); }
        else { canvas.line(px(l.x), py(l.y), px(now.x), py(now.y), 255u8, 80u8, 80u8); }
        last.set(i, now);
        i = i + 1usize;
      }
      canvas.line(px(playerLast.x), py(playerLast.y), px(player.x), py(player.y), 255u8, 230u8, 60u8);
      playerLast = player;
    }
    s = s + 1;
  }

  i = 0usize;
  while i < n {
    let now = (*world.agents[i]).pos;
    canvas.disc(px(now.x), py(now.y), 5, 255u8, 255u8, 255u8, true);
    i = i + 1usize;
  }

  print <- "50 characters, ", steps, " steps of ", dt, " s\n";
  print <- "least gap between any two bodies: ", minGap, " m\n";
  print <- "least clearance from a pillar: ", minPillar, " m\n";
  print <- "commuter arrivals: ", arrivals, "; mean speed ", speedSum / speedCount, " m/s\n";
  print <- "closest a fleer got to the player: ", fleerClosest, " m\n";
  if outFile.len() > 0usize {
    let bmp = canvas.toBmp();
    let file = Path.from(outFile.view());
    if fs.writeFile(&file, bmp.view()) is Ok { print <- "wrote the trace\n"; }
    else { print <- "could not write the trace\n"; return 1; }
  }
  if minGap < 0. or minPillar < 0. { return 1; }
  0
}
