// ======== Huffman-coded literals ========
//
// RFC 8878 section 4.2. A tree is described by the weights of its symbols
// (4 bits each, or FSE-coded), the last symbol's weight left to be worked
// out; a weight w > 0 is a code of (maxBits + 1 - w) bits. Codes are
// canonical with the longest first: symbols in order of weight, then of
// value, each taking 2^(w - 1) entries of a table indexed by the next maxBits
// bits of the backward stream. So one look decodes any symbol.

// The most bits a literal's code may have (RFC 8878 section 4.2.1)
fn maxHuffBits() u32 { 11u32 }

// A Huffman decoding table: entry = symbol | (code bits << 8), indexed by the
// next 'maxBits' bits
struct HufTable is Default {
  entries: List[u16];
  maxBits: u32;
  // Scratch: the weights read, and where each weight's entries start
  weights: List[u8];
  rankStart: List[u32];
  fse: FseTable;
  norm: List[i16];

  // Reads a Huffman tree description at src[start, end) and builds the
  // table. The bytes it took, or -1 when it is not valid.
  fn read(self: &mut, src: &Array[u8], start: usize, end: usize) i64 {
    if start >= end { return -1i64; }
    let head = usize.from(src[start]);
    weights.clear();
    var used = 0usize;
    if head >= 128usize {
      // Direct: (head - 127) weights, two to a byte, the first in the high half
      let count = head - 127usize;
      let bytes = (count + 1usize) / 2usize;
      if end - start - 1usize < bytes { return -1i64; }
      var i = 0usize;
      while i < count {
        let b = src[start + 1usize + i / 2usize];
        weights.push(if i % 2usize == 0usize {b >> 4u8} else {b & 15u8});
        i = i + 1usize;
      }
      used = 1usize + bytes;
    } else {
      // FSE-coded: 'head' bytes, a table description then the weights'
      // bitstream, decoded with two states taking turns
      if head == 0usize || end - start - 1usize < head { return -1i64; }
      let a = start + 1usize;
      let b = a + head;
      var log = 0u32;
      let nc = readNCount(src, a, b, 255usize, 6u32, &mut norm, &mut log);
      if nc < 0i64 { return -1i64; }
      if !fse.build(norm.view(), log) { return -1i64; }
      var Some(bits) = BackBits.open(src, a + usize.from(nc), b) else { return -1i64; };
      var s1 = bits.read(src, log);
      var s2 = bits.read(src, log);
      while true {
        if weights.len() > 253usize { return -1i64; }
        let c1 = *fse.cells[usize.from(s1)];
        weights.push(u8.from(c1 & 0xFFu32));
        s1 = (c1 >> 16u32) + bits.read(src, (c1 >> 8u32) & 0xFFu32);
        if bits.overflowed() {
          weights.push(u8.from(*fse.cells[usize.from(s2)] & 0xFFu32));
          break;
        }
        if weights.len() > 253usize { return -1i64; }
        let c2 = *fse.cells[usize.from(s2)];
        weights.push(u8.from(c2 & 0xFFu32));
        s2 = (c2 >> 16u32) + bits.read(src, (c2 >> 8u32) & 0xFFu32);
        if bits.overflowed() {
          weights.push(u8.from(*fse.cells[usize.from(s1)] & 0xFFu32));
          break;
        }
      }
      used = 1usize + head;
    }
    if !self.build() { return -1i64; }
    i64.from(used)
  }

  // The table from 'weights' (all but the last symbol's). false when they
  // do not make a code: a weight over the limit, no weight at all, a total
  // whose remainder to a power of 2 is not one, or (as the reference
  // decoder requires) fewer than two codes of the longest length.
  fn build(self: &mut) bool {
    let n = weights.len();
    if n == 0usize || n > 255usize { return false; }
    var total = 0u32;
    var i = 0usize;
    while i < n {
      let w = u32.from(*weights[i]);
      if w > maxHuffBits() { return false; }
      if w > 0u32 { total = total + (1u32 << (w - 1u32)); }
      i = i + 1usize;
    }
    if total == 0u32 { return false; }
    let bits = highBit(total) + 1u32;
    if bits > maxHuffBits() { return false; }
    let rest = (1u32 << bits) - total;
    if (rest & (rest - 1u32)) != 0u32 { return false; }
    weights.push(u8.from(highBit(rest) + 1u32));
    maxBits = bits;
    // Where each weight's entries start: weight 1 (the longest codes) first
    rankStart.clear();
    var w = 0u32;
    while w <= bits + 1u32 { rankStart.push(0u32); w = w + 1u32; }
    i = 0usize;
    var ones = 0u32;
    while i <= n {
      let wt = u32.from(*weights[i]);
      if wt > 0u32 { rankStart.set(usize.from(wt), *rankStart[usize.from(wt)] + (1u32 << (wt - 1u32))); }
      if wt == 1u32 { ones = ones + 1u32; }
      i = i + 1usize;
    }
    if ones < 2u32 || (ones & 1u32) != 0u32 { return false; }
    // counts to starts
    var at = 0u32;
    w = 1u32;
    while w <= bits {
      let c = *rankStart[usize.from(w)];
      rankStart.set(usize.from(w), at);
      at = at + c;
      w = w + 1u32;
    }
    entries.clear();
    entries.resize(1usize << usize.from(bits), 0u16);
    i = 0usize;
    while i <= n {
      let wt = u32.from(*weights[i]);
      if wt > 0u32 {
        let len = 1u32 << (wt - 1u32);
        let e = u16.from(i) | u16.from((bits + 1u32 - wt) << 8u32);
        var k = *rankStart[usize.from(wt)];
        let stop = k + len;
        while k < stop { entries.set(usize.from(k), e); k = k + 1u32; }
        rankStart.set(usize.from(wt), stop);
      }
      i = i + 1usize;
    }
    true
  }

  // Decodes 'count' literals from the backward stream src[start, end),
  // appending them to 'out'. false unless the stream is used exactly.
  fn decodeStream(self: &, src: &Array[u8], start: usize, end: usize, count: usize, out: &mut List[u8]) bool {
    var Some(bits) = BackBits.open(src, start, end) else { return false; };
    let mb = maxBits;
    var i = 0usize;
    while i < count {
      let e = *entries[usize.from(bits.peek(src, mb))];
      out.push(u8.from(e & 0xFFu16));
      bits.skip(u32.from(e >> 8u16));
      i = i + 1usize;
    }
    bits.exact()
  }

  // Decodes a block's four literal streams together into out[0, regen): stream
  // 1 is src[a, b), 2 is [b, c), 3 is [c, d), 4 is [d, e); streams 1 to 3 hold
  // 'seg' literals each and stream 4 the rest (regen - 3 * seg, at most seg).
  // false unless every stream is used exactly. The loop takes one symbol from
  // each stream per step, so four independent chains run side by side, and
  // loads all four containers once per group of steps; what is left of each
  // stream is then finished one at a time by the same reads as 'decodeStream'.
  //
  // Bounds (untrusted input). Reads: each stream has its own 'BackBits' over
  // its own bytes, opened with a checked read of its last byte, so end <=
  // src.len, and 'refillSeq' reads inside [start, src.len) (its argument is in
  // fse.cone). Nothing is read before a stream's start: once its real bytes
  // are all loaded, 'refillSeq' adds zero bits (counted in 'pad'), the same
  // bits 'decodeStream' would read past the start; they make 'n' 56 to 63 after
  // every refill. A group of g = 56 / maxBits steps takes at most g * maxBits <=
  // 56 bits from a stream (a table entry's length is at most maxBits, since it
  // is maxBits + 1 - weight with weight >= 1), so 'n' never goes below 0 and
  // the peek reads the top maxBits bits of the n held (n <= 64, so the left
  // shift 64 - n is 0 to 63). The table index is below 2^maxBits = entries.len.
  // Writes: 'out' has regen bytes; stream k writes index (k - 1) * seg + i for
  // i below its count, and the counts are seg, seg, seg, regen - 3 * seg, so
  // every write is below regen (the caller checked 3 * seg <= regen). A stream
  // that ends wrong: 'exact' is false when real bits are left or any virtual
  // one was taken, as for 'decodeStream'; the answer is the same on every input.
  fn decode4(self: &, src: &Array[u8], a: usize, b: usize, c: usize, d: usize, e: usize,
      seg: usize, regen: usize, out: &mut List[u8]) bool {
    var Some(s1) = BackBits.open(src, a, b) else { return false; };
    var Some(s2) = BackBits.open(src, b, c) else { return false; };
    var Some(s3) = BackBits.open(src, c, d) else { return false; };
    var Some(s4) = BackBits.open(src, d, e) else { return false; };
    out.resize(regen, 0u8);
    let op = out.viewMut() as *u8;
    let mb = maxBits;
    let len4 = regen - 3usize * seg;
    let g = 56u32 / mb;
    let sh = u64.from(64u32 - mb);
    var i = 0usize;
    while i + usize.from(g) <= len4 {
      s1.refillSeq(src);
      s2.refillSeq(src);
      s3.refillSeq(src);
      s4.refillSeq(src);
      var j = 0u32;
      while j < g {
        let e1 = *entries[usize.from(u32.from((s1.acc << u64.from(64u32 - s1.n)) >> sh))];
        let e2 = *entries[usize.from(u32.from((s2.acc << u64.from(64u32 - s2.n)) >> sh))];
        let e3 = *entries[usize.from(u32.from((s3.acc << u64.from(64u32 - s3.n)) >> sh))];
        let e4 = *entries[usize.from(u32.from((s4.acc << u64.from(64u32 - s4.n)) >> sh))];
        s1.n = s1.n - u32.from(e1 >> 8u16);
        s2.n = s2.n - u32.from(e2 >> 8u16);
        s3.n = s3.n - u32.from(e3 >> 8u16);
        s4.n = s4.n - u32.from(e4 >> 8u16);
        mem.writeRaw[u8](op + i, u8.from(e1 & 0xFFu16));
        mem.writeRaw[u8](op + (seg + i), u8.from(e2 & 0xFFu16));
        mem.writeRaw[u8](op + (2usize * seg + i), u8.from(e3 & 0xFFu16));
        mem.writeRaw[u8](op + (3usize * seg + i), u8.from(e4 & 0xFFu16));
        i = i + 1usize;
        j = j + 1u32;
      }
    }
    if !self.finish(src, &mut s1, op, 0usize, i, seg) { return false; }
    if !self.finish(src, &mut s2, op, seg, i, seg) { return false; }
    if !self.finish(src, &mut s3, op, 2usize * seg, i, seg) { return false; }
    self.finish(src, &mut s4, op, 3usize * seg, i, len4)
  }

  // The rest of one stream of 'decode4': literals from index 'from' to 'count'
  // of the stream whose output starts at op + base
  fn finish(self: &, src: &Array[u8], bits: &mut BackBits, op: *u8, base: usize, from: usize, count: usize) bool {
    let mb = maxBits;
    var i = from;
    while i < count {
      let e = *entries[usize.from(bits.peek(src, mb))];
      mem.writeRaw[u8](op + (base + i), u8.from(e & 0xFFu16));
      bits.skip(u32.from(e >> 8u16));
      i = i + 1usize;
    }
    bits.exact()
  }
}
