// ======== The constants of RFC 8878 ========
//
// The literal-length and match-length codes (section 3.1.1.3.2.1.1) and the
// three predefined distributions (section 3.1.1.3.2.2). Immutable
// module-level arrays, as deflate keeps RFC 1951's.

// Literal lengths: the base of each of the 36 codes, and how many extra bits
// follow it. Codes 0 to 15 are the length itself.
let llBase: Array[u32, 36] = [0u32, 1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 7u32, 8u32, 9u32, 10u32, 11u32,
  12u32, 13u32, 14u32, 15u32, 16u32, 18u32, 20u32, 22u32, 24u32, 28u32, 32u32, 40u32, 48u32, 64u32,
  128u32, 256u32, 512u32, 1024u32, 2048u32, 4096u32, 8192u32, 16384u32, 32768u32, 65536u32];
let llBits: Array[u32, 36] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
  0u32, 0u32, 0u32, 0u32, 1u32, 1u32, 1u32, 1u32, 2u32, 2u32, 3u32, 3u32, 4u32, 6u32, 7u32, 8u32, 9u32,
  10u32, 11u32, 12u32, 13u32, 14u32, 15u32, 16u32];

// Match lengths: the base of each of the 53 codes, and its extra bits.
// Codes 0 to 31 are the length less 3.
let mlBase: Array[u32, 53] = [3u32, 4u32, 5u32, 6u32, 7u32, 8u32, 9u32, 10u32, 11u32, 12u32, 13u32, 14u32,
  15u32, 16u32, 17u32, 18u32, 19u32, 20u32, 21u32, 22u32, 23u32, 24u32, 25u32, 26u32, 27u32, 28u32, 29u32,
  30u32, 31u32, 32u32, 33u32, 34u32, 35u32, 37u32, 39u32, 41u32, 43u32, 47u32, 51u32, 59u32, 67u32, 83u32,
  99u32, 131u32, 259u32, 515u32, 1027u32, 2051u32, 4099u32, 8195u32, 16387u32, 32771u32, 65539u32];
let mlBits: Array[u32, 53] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
  0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
  0u32, 0u32, 0u32, 1u32, 1u32, 1u32, 1u32, 2u32, 2u32, 3u32, 3u32, 4u32, 4u32, 5u32, 7u32, 8u32, 9u32,
  10u32, 11u32, 12u32, 13u32, 14u32, 15u32, 16u32];

// The predefined distributions: normalized counts (-1 is "less than 1"),
// accuracy logs 6, 6 and 5
let llDefault: Array[i16, 36] = [4i16, 3i16, 2i16, 2i16, 2i16, 2i16, 2i16, 2i16, 2i16, 2i16, 2i16, 2i16,
  2i16, 1i16, 1i16, 1i16, 2i16, 2i16, 2i16, 2i16, 2i16, 2i16, 2i16, 2i16, 2i16, 3i16, 2i16, 1i16, 1i16,
  1i16, 1i16, 1i16, -1i16, -1i16, -1i16, -1i16];
let mlDefault: Array[i16, 53] = [1i16, 4i16, 3i16, 2i16, 2i16, 2i16, 2i16, 2i16, 2i16, 1i16, 1i16, 1i16,
  1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16,
  1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16,
  -1i16, -1i16, -1i16, -1i16, -1i16, -1i16, -1i16];
let ofDefault: Array[i16, 29] = [1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 2i16, 2i16, 2i16, 1i16, 1i16, 1i16,
  1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, 1i16, -1i16, -1i16, -1i16, -1i16,
  -1i16];
