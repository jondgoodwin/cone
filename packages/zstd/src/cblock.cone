// ======== Writing a compressed block: literals, then sequences ========
//
// RFC 8878 section 3.1.1.3, the writing side of block.cone. Every choice is
// made for the block alone, by its size: no table is carried from the block
// before except the Huffman code of the literals ("treeless" literals repeat
// the last one kept, when that is no worse; the "repeat" table mode of the
// sequences is never written), so a block written raw instead costs nothing
// but its repeat offsets (the code is kept only once a block is coded).
//
//   literals    raw when there are fewer than 64 (as the reference does) or
//               Huffman does not save at least 1/64 of them and 2 bytes; RLE
//               when they are one byte value; else Huffman-coded, in one
//               stream under 256 literals and in four from 256 on, the tree
//               by FSE-coded weights when that is smaller than 4 bits each
//   sequences   for each of literal lengths, offsets and match lengths, the
//               cheapest of the predefined table, RLE (one code only) and a
//               table of its own (FSE), by an estimate of the bits each costs
//               (a table of its own pays for its description)

// The smallest saving that makes a coded form worth it over the raw one:
// 1/64 of the size and 2 bytes (the reference's ZSTD_minGain at these levels)
fn minGain(size: usize) usize { (size >> 6usize) + 2usize }

// The literal-length and match-length codes of RFC 8878 section
// 3.1.1.3.2.1.1, for a value under 64 (lengths) or a match length less 3
// under 128; beyond those the code is the value's highest bit plus 19 (or 36)
fn smallCodes(base: &Array[u32], bias: u32, n: usize) List[u8] {
  var t = List[u8].withCapacity(n);
  var c = 0usize;
  var v = 0usize;
  while v < n {
    while c + 1usize < base.len && usize.from(base[c + 1usize] - bias) <= v { c += 1usize; }
    t.push(u8.from(c));
    v += 1usize;
  }
  t
}

// What a block's encoding needs besides the block: the Huffman code, the
// three FSE tables, the codes of the sequences and scratch for counting
struct BlockEnc {
  huf: HufEnc;
  ll: FseEnc;
  of: FseEnc;
  ml: FseEnc;
  llCodes: List[u8];
  ofCodes: List[u8];
  mlCodes: List[u8];
  llSmall: List[u8];
  mlSmall: List[u8];
  // How often each code occurs in the block (128 slots each: a code is under 68), counted as the codes are derived
  cntLl: List[u32];
  cntOf: List[u32];
  cntMl: List[u32];
  norm: List[i16];
  desc: List[u8];

  fn make() BlockEnc {
    BlockEnc(HufEnc(), FseEnc(), FseEnc(), FseEnc(), List[u8](),
      List[u8](), List[u8](), smallCodes(&llBase, 0u32, 64usize), smallCodes(&mlBase, 3u32, 128usize),
      List[u32](), List[u32](), List[u32](), List[i16](), List[u8]())
  }
}

// The literals section header for 'n' raw (kind 0) or RLE (kind 1)
// literals: 1, 2 or 3 bytes as the size needs
fn writeLitHeader(out: &mut List[u8], kind: u8, n: usize) {
  if n < 32usize {
    out.push(kind | u8.from(n << 3usize));
  } else if n < 4096usize {
    out.push(kind | 4u8 | u8.from((n & 15usize) << 4usize));
    out.push(u8.from(n >> 4usize));
  } else {
    out.push(kind | 12u8 | u8.from((n & 15usize) << 4usize));
    out.push(u8.from((n >> 4usize) & 255usize));
    out.push(u8.from(n >> 12usize));
  }
}

fn writeRawLiterals(out: &mut List[u8], lits: &Array[u8]) {
  let n = lits.len;
  writeLitHeader(out, 0u8, n);
  out.appendSlice(lits);
}

// Appends the literals section for 'lits' (the block's literals: the first 'nlit' of the Seqs' array)
//
// A block's Huffman code is its own, or, as the reference does, the code of the last block kept
// with one (treeless literals) when that is no worse: the literals cost under it no more than
// under a new code plus its description (HUF_compress_internal; its preferRepeat for
// 1024 literals or fewer is left out, as it can cost bytes). 'huf.pending' says the block carries a new code.
fn writeLiterals(lits: &Array[u8], huf: &mut HufEnc, out: &mut List[u8]) {
  let n = lits.len;
  huf.pending = false;
  if n < 64usize {
    writeRawLiterals(out, lits);
    return;
  }
  let distinct = huf.histogram(lits);
  if distinct == 1usize {
    writeLitHeader(out, 1u8, n);
    out.push(lits[0usize]);
    return;
  }
  huf.build(maxHuffBits());
  // The header's size follows the literals' count: the coded size is smaller
  let hs = if n < 1024usize {3usize} else if n < 16384usize {4usize} else {5usize};
  let mark = out.len();
  var k = 0usize;
  while k < hs {
    out.push(0u8);
    k += 1usize;
  }
  let old = huf.oldCost();
  let canReuse = old != 0xFFFFFFFFFFFFFFFFu64;
  let fresh = huf.newCost();
  var reuse = canReuse && old <= fresh;
  if !reuse {
    let at = out.len();
    if huf.writeTree(out) {
      if canReuse && (old <= u64.from(out.len() - at) + fresh || out.len() - at + 12usize >= n) {
        out.truncate(at);
        reuse = true;
      }
    } else if canReuse {
      reuse = true;
    } else {
      out.truncate(mark);
      writeRawLiterals(out, lits);
      return;
    }
  }
  let single = n < 256usize;
  if single {
    if reuse { huf.encodeStream(lits, 0usize, n, out, &huf.prevPk, huf.prevLog); }
    else { huf.encodeStream(lits, 0usize, n, out, &huf.pk, huf.tableLog); }
  } else {
    // A jump table of the first three streams' sizes, then the four
    let jump = out.len();
    k = 0usize;
    while k < 6usize {
      out.push(0u8);
      k += 1usize;
    }
    let seg = (n + 3usize) / 4usize;
    var i = 0usize;
    while i < 4usize {
      let from = i * seg;
      let to = if i == 3usize {n} else {from + seg};
      let at = out.len();
      if reuse { huf.encodeStream(lits, from, to, out, &huf.prevPk, huf.prevLog); }
      else { huf.encodeStream(lits, from, to, out, &huf.pk, huf.tableLog); }
      if i < 3usize {
        let size = out.len() - at;
        out.set(jump + 2usize * i, u8.from(size & 255usize));
        out.set(jump + 2usize * i + 1usize, u8.from((size >> 8usize) & 255usize));
      }
      i += 1usize;
    }
  }
  let csize = out.len() - mark - hs;
  if csize + minGain(n) >= n {
    out.truncate(mark);
    writeRawLiterals(out, lits);
    return;
  }
  huf.pending = !reuse;
  let sf = if single {0u64} else if hs == 3usize {1u64} else if hs == 4usize {2u64} else {3u64};
  let sizeBits = if hs == 3usize {10u64} else if hs == 4usize {14u64} else {18u64};
  let kind = if reuse {3u64} else {2u64};
  let h = kind | (sf << 2u64) | (u64.from(n) << 4u64) | (u64.from(csize) << (4u64 + sizeBits));
  k = 0usize;
  while k < hs {
    out.set(mark + k, u8.from((h >> u64.from(8usize * k)) & 255u64));
    k += 1usize;
  }
}

// The code of a literal length or of a match length (its value less 3):
// 'small' holds the codes of the values below n, 'delta' is the code of 1
// less its highest bit
fn lengthCode(small: *u8, n: usize, v: u32, delta: u32) u8 inline {
  if usize.from(v) < n { return mem.readRaw[u8](small + usize.from(v)); }
  u8.from(highBit(v) + delta)
}

// One pass over the sequences: the three arrays of codes, and how often each
// code occurs. The raw stores and loads are inside bounds fixed here: the
// three sequence arrays are checked to hold 'nb' entries and the code arrays
// are sized to 'nb' before the loop; a small table is read only below its
// length (checked); a code is under 68 (a u32's highest bit is at most 31,
// plus 36), so its count's slot (128 to each) is in the list.
fn deriveCodes(seqs: &Seqs, enc: &mut BlockEnc) {
  let nb = seqs.nseq;
  if seqs.ll.len() < nb || seqs.ml.len() < nb || seqs.off.len() < nb { panic("zstd: fewer sequences than counted"); }
  enc.llCodes.resize(nb, 0u8);
  enc.ofCodes.resize(nb, 0u8);
  enc.mlCodes.resize(nb, 0u8);
  enc.cntLl.clear();
  enc.cntLl.resize(128usize, 0u32);
  enc.cntOf.clear();
  enc.cntOf.resize(128usize, 0u32);
  enc.cntMl.clear();
  enc.cntMl.resize(128usize, 0u32);
  if enc.llSmall.len() != 64usize || enc.mlSmall.len() != 128usize { panic("zstd: a code table has the wrong size"); }
  let llS = enc.llSmall.view() as *u8;
  let mlS = enc.mlSmall.view() as *u8;
  let llIn = seqs.ll.view() as *u32 as *u8;
  let mlIn = seqs.ml.view() as *u32 as *u8;
  let ofIn = seqs.off.view() as *u32 as *u8;
  let llOut = enc.llCodes.viewMut() as *u8;
  let ofOut = enc.ofCodes.viewMut() as *u8;
  let mlOut = enc.mlCodes.viewMut() as *u8;
  let llC = enc.cntLl.viewMut() as *u32 as *u8;
  let ofC = enc.cntOf.viewMut() as *u32 as *u8;
  let mlC = enc.cntMl.viewMut() as *u32 as *u8;
  var i = 0usize;
  while i < nb {
    let lc = lengthCode(llS, 64usize, mem.readRaw[u32]((llIn + 4usize * i) as *u32), 19u32);
    let mc = lengthCode(mlS, 128usize, mem.readRaw[u32]((mlIn + 4usize * i) as *u32) - 3u32, 36u32);
    let oc = u8.from(highBit(mem.readRaw[u32]((ofIn + 4usize * i) as *u32)));
    mem.writeRaw[u8](llOut + i, lc);
    mem.writeRaw[u8](mlOut + i, mc);
    mem.writeRaw[u8](ofOut + i, oc);
    let pl = (llC + 4usize * (usize.from(lc) & 127usize)) as *u32;
    mem.writeRaw[u32](pl, mem.readRaw[u32](pl) + 1u32);
    let pm = (mlC + 4usize * (usize.from(mc) & 127usize)) as *u32;
    mem.writeRaw[u32](pm, mem.readRaw[u32](pm) + 1u32);
    let po = (ofC + 4usize * (usize.from(oc) & 127usize)) as *u32;
    mem.writeRaw[u32](po, mem.readRaw[u32](po) + 1u32);
    i += 1usize;
  }
  // A code at or past its alphabet would have counted into a slot no table reads
  var s = 36usize;
  while s < 128usize {
    if *enc.cntLl[s] != 0u32 { panic("zstd: a literal-length code is past its alphabet"); }
    s += 1usize;
  }
  s = 32usize;
  while s < 128usize {
    if *enc.cntOf[s] != 0u32 { panic("zstd: an offset code is past its alphabet"); }
    s += 1usize;
  }
  s = 53usize;
  while s < 128usize {
    if *enc.cntMl[s] != 0u32 { panic("zstd: a match-length code is past its alphabet"); }
    s += 1usize;
  }
}

// The table for one of the three codes, by cost: appends its description
// (an RLE symbol, or FSE counts) to 'desc', builds 't', answers the mode
// (0 predefined, 1 RLE, 2 FSE)
fn chooseTable(nb: usize, cnt: &List[u32], alphabet: usize, defaults: &Array[i16], defaultLog: u32, maxLog: u32,
    norm: &mut List[i16], desc: &mut List[u8], t: &mut FseEnc) u8 {
  var maxSym = 0usize;
  var distinct = 0usize;
  var s = 0usize;
  while s < alphabet {
    if *cnt[s] > 0u32 {
      maxSym = s;
      distinct += 1usize;
    }
    s += 1usize;
  }
  // Costs in 1/256 bits; none is "not possible"
  let none = 0xFFFFFFFFFFFFFFFFu64;
  var predef = none;
  if maxSym < defaults.len {
    predef = 0u64;
    s = 0usize;
    while s <= maxSym {
      let c = *cnt[s];
      if c > 0u32 {
        let d = defaults[s];
        if d == 0i16 { predef = none; break; }
        let p = if d < 0i16 {1u32} else {u32.from(d)};
        predef = predef + u64.from(c) * u64.from(defaultLog * 256u32 - log2x256(p));
      }
      s += 1usize;
    }
  }
  if distinct == 1usize {
    if predef <= 2048u64 {
      t.build(defaults, defaultLog);
      return 0u8;
    }
    desc.push(u8.from(maxSym));
    t.setRle();
    return 1u8;
  }
  let log = fseTableLog(maxLog, u32.from(nb), maxSym);
  normalize(cnt.view(), maxSym, u32.from(nb), log, norm);
  let mark = desc.len();
  writeNCount(desc, norm.view(), log);
  var own = u64.from(desc.len() - mark) * 2048u64;
  s = 0usize;
  while s <= maxSym {
    let c = *cnt[s];
    if c > 0u32 { own = own + u64.from(c) * u64.from(log * 256u32 - log2x256(u32.from(*norm[s]))); }
    s += 1usize;
  }
  if predef <= own {
    desc.truncate(mark);
    t.build(defaults, defaultLog);
    return 0u8;
  }
  t.build(norm.view(), log);
  2u8
}

// Appends the sequences section for 'seqs'
fn writeSequences(seqs: &Seqs, enc: &mut BlockEnc, out: &mut List[u8]) {
  let nb = seqs.nseq;
  if nb < 128usize {
    out.push(u8.from(nb));
  } else if nb < 0x7F00usize {
    out.push(u8.from((nb >> 8usize) + 128usize));
    out.push(u8.from(nb & 255usize));
  } else {
    out.push(255u8);
    out.push(u8.from((nb - 0x7F00usize) & 255usize));
    out.push(u8.from((nb - 0x7F00usize) >> 8usize));
  }
  if nb == 0usize { return; }
  deriveCodes(seqs, enc);
  enc.desc.clear();
  let llMode = chooseTable(nb, &enc.cntLl, 36usize, &llDefault, 6u32, 9u32, &mut enc.norm, &mut enc.desc, &mut enc.ll);
  let ofMode = chooseTable(nb, &enc.cntOf, 32usize, &ofDefault, 5u32, 8u32, &mut enc.norm, &mut enc.desc, &mut enc.of);
  let mlMode = chooseTable(nb, &enc.cntMl, 53usize, &mlDefault, 6u32, 9u32, &mut enc.norm, &mut enc.desc, &mut enc.ml);
  var i = 0usize;
  out.push((llMode << 6u8) | (ofMode << 4u8) | (mlMode << 2u8));
  out.reserve(enc.desc.len());
  i = 0usize;
  while i < enc.desc.len() {
    out.push(*enc.desc[i]);
    i += 1usize;
  }
  // The bitstream, the last sequence first: each sequence's codes are
  // written after the next one's extra bits, so that reading backward the
  // decoder takes a sequence's extra bits, then moves its states on
  // A sequence's bits: the three states at most 9 + 8 + 9, the extra bits at
  // most 16 + 16 + 31, so 89 bits and at most 12 bytes, inside the 16 reserved
  // a sequence. The container holds at most 7 bits between flushes, so the
  // states and the literal-length bits (7 + 26 + 16) and then the match-length
  // and offset bits (7 + 16 + 31) each fit in 64 bits before their flush.
  // The table logs are what that rests on, checked here.
  if enc.ll.log > 9u32 || enc.of.log > 8u32 || enc.ml.log > 9u32 { panic("zstd: an FSE table log is above its limit"); }
  var bw = BitRun.open(out, nb * 16usize + 16usize);
  let last = nb - 1usize;
  var llc = usize.from(*enc.llCodes[last]);
  var ofc = usize.from(*enc.ofCodes[last]);
  var mlc = usize.from(*enc.mlCodes[last]);
  var llState = enc.ll.first(llc);
  var ofState = enc.of.first(ofc);
  var mlState = enc.ml.first(mlc);
  bw.put(u64.from(*seqs.ll[last] - llBase[llc]), llBits[llc]);
  bw.put(u64.from(*seqs.ml[last] - mlBase[mlc]), mlBits[mlc]);
  bw.put(u64.from(*seqs.off[last]), u32.from(ofc));
  // The loop below reads the code lists, the sequence lists and the three
  // tables through raw pointers, with the lengths checked here once: nothing
  // in the loop appends to, resizes or rebuilds any of them. A code is below
  // 64 in every list (a literal length and a match length code are 35 and 52
  // at most for a block, an offset code is a bit index below 32), and a cell
  // list holds 64 cells ('FseEnc.build' and 'setRle' pad it), so a code
  // masked to 63 is in bounds. A state goes into 'states' at an index below
  // 1 << log (a base the construction keeps in the table, plus the bits
  // shifted out), masked to that size, which 'states' holds (an RLE table
  // holds one state, 0, and has log 0). The bit writer's fields are locals
  // here, and an RLE table goes through the same code (a cell of no bits
  // that leads back to state 0), so the loop tests for RLE nowhere.
  let llMask = (1usize << usize.from(enc.ll.log)) - 1usize;
  let ofMask = (1usize << usize.from(enc.of.log)) - 1usize;
  let mlMask = (1usize << usize.from(enc.ml.log)) - 1usize;
  if enc.llCodes.len() < nb || enc.ofCodes.len() < nb || enc.mlCodes.len() < nb
      || seqs.ll.len() < nb || seqs.ml.len() < nb || seqs.off.len() < nb
      || enc.ll.cell.len() < 64usize || enc.of.cell.len() < 64usize || enc.ml.cell.len() < 64usize
      || enc.ll.states.len() <= llMask || enc.of.states.len() <= ofMask || enc.ml.states.len() <= mlMask {
    panic("zstd: a sequence list or table is shorter than the writer needs");
  }
  let llcp = enc.llCodes.view() as *u8;
  let ofcp = enc.ofCodes.view() as *u8;
  let mlcp = enc.mlCodes.view() as *u8;
  let llp = seqs.ll.view() as *u32;
  let mlp = seqs.ml.view() as *u32;
  let offp = seqs.off.view() as *u32;
  let llCell = enc.ll.cell.view() as *u64;
  let ofCell = enc.of.cell.view() as *u64;
  let mlCell = enc.ml.cell.view() as *u64;
  let llSt = enc.ll.states.view() as *u16;
  let ofSt = enc.of.states.view() as *u16;
  let mlSt = enc.ml.states.view() as *u16;
  let bias = usize.from(cellBias);
  var acc = bw.acc;
  var bn = bw.n;
  var w = bw.w;
  var n = last;
  while n > 0usize {
    n -= 1usize;
    llc = usize.from(mem.readRaw[u8](llcp + n));
    ofc = usize.from(mem.readRaw[u8](ofcp + n));
    mlc = usize.from(mem.readRaw[u8](mlcp + n));
    // offset code
    let oc = mem.readRaw[u64](ofCell + (ofc & 63usize));
    let onb = (ofState + u32.from(oc & 0xFFFFFFFFu64)) >> 16u32;
    acc = acc | ((u64.from(ofState) & ((1u64 << (u64.from(onb) & 63u64)) - 1u64)) << (u64.from(bn) & 63u64));
    bn = bn + onb;
    let oi = (usize.from(u64.from(ofState >> (onb & 31u32)) + (oc >> 32u64)) - bias) & ofMask;
    ofState = u32.from(mem.readRaw[u16](ofSt + oi));
    // match length code
    let mc = mem.readRaw[u64](mlCell + (mlc & 63usize));
    let mnb = (mlState + u32.from(mc & 0xFFFFFFFFu64)) >> 16u32;
    acc = acc | ((u64.from(mlState) & ((1u64 << (u64.from(mnb) & 63u64)) - 1u64)) << (u64.from(bn) & 63u64));
    bn = bn + mnb;
    let mi = (usize.from(u64.from(mlState >> (mnb & 31u32)) + (mc >> 32u64)) - bias) & mlMask;
    mlState = u32.from(mem.readRaw[u16](mlSt + mi));
    // literal length code
    let lc = mem.readRaw[u64](llCell + (llc & 63usize));
    let lnb = (llState + u32.from(lc & 0xFFFFFFFFu64)) >> 16u32;
    acc = acc | ((u64.from(llState) & ((1u64 << (u64.from(lnb) & 63u64)) - 1u64)) << (u64.from(bn) & 63u64));
    bn = bn + lnb;
    let li = (usize.from(u64.from(llState >> (lnb & 31u32)) + (lc >> 32u64)) - bias) & llMask;
    llState = u32.from(mem.readRaw[u16](llSt + li));
    // the literal length's extra bits, then flush
    let lbits = llBits[llc];
    acc = acc | ((u64.from(mem.readRaw[u32](llp + n) - llBase[llc]) & ((1u64 << (u64.from(lbits) & 63u64)) - 1u64)) << (u64.from(bn) & 63u64));
    bn = bn + lbits;
    mem.writeRaw[u64](w as *u64, acc);
    w = w + usize.from(bn >> 3u32);
    acc = acc >> (u64.from(bn & 248u32) & 63u64);
    bn = bn & 7u32;
    // the match length's and the offset's extra bits, then flush
    let mbits = mlBits[mlc];
    acc = acc | ((u64.from(mem.readRaw[u32](mlp + n) - mlBase[mlc]) & ((1u64 << (u64.from(mbits) & 63u64)) - 1u64)) << (u64.from(bn) & 63u64));
    bn = bn + mbits;
    acc = acc | ((u64.from(mem.readRaw[u32](offp + n)) & ((1u64 << (ofc & 63usize)) - 1u64)) << (u64.from(bn) & 63u64));
    bn = bn + u32.from(ofc);
    mem.writeRaw[u64](w as *u64, acc);
    w = w + usize.from(bn >> 3u32);
    acc = acc >> (u64.from(bn & 248u32) & 63u64);
    bn = bn & 7u32;
  }
  bw.acc = acc;
  bw.n = bn;
  bw.w = w;
  enc.ml.flushRun(&mut bw, mlState);
  enc.of.flushRun(&mut bw, ofState);
  enc.ll.flushRun(&mut bw, llState);
  bw.finish(out);
}
