// ======== A compressed block: literals, then sequences ========
//
// RFC 8878 section 3.1.1.3. A compressed block is decoded whole, once all of
// its bytes are in: its literals into a buffer, then its sequences, each
// executed as it is decoded (copy so many literals, then a match from so far
// back), then the literals left over. The tables and repeat offsets go on
// from block to block within a frame ('Entropy').

// What went wrong in a block; each is one ErrorKind and one sentence
enum Fault {
  Ok;
  LitHeader;
  LitSize;
  LitStreams;
  HuffTree;
  NoHuffTable;
  HuffStream;
  SeqHeader;
  FseTable;
  RleSymbol;
  NoSeqTable;
  SeqStream;
  LitOverrun;
  BlockTooBig;
  OffsetZero;
  OffsetFar;
}

fn faultKind(f: Fault) ErrorKind {
  if f == Fault.LitHeader || f == Fault.LitSize || f == Fault.LitStreams || f == Fault.SeqHeader
    || f == Fault.BlockTooBig { return ErrorKind.BadBlock; }
  if f == Fault.HuffTree || f == Fault.NoHuffTable || f == Fault.FseTable || f == Fault.RleSymbol
    || f == Fault.NoSeqTable { return ErrorKind.BadTable; }
  if f == Fault.OffsetZero || f == Fault.OffsetFar { return ErrorKind.BadOffset; }
  ErrorKind.BadSequence
}

fn faultReason(f: Fault) &str {
  if f == Fault.LitHeader { return "zstd: the literals section header is cut off or does not fit the block"; }
  if f == Fault.LitSize { return "zstd: the literals section is larger than a block"; }
  if f == Fault.LitStreams { return "zstd: the four literal streams' sizes do not add up"; }
  if f == Fault.HuffTree { return "zstd: the Huffman tree description is not valid"; }
  if f == Fault.NoHuffTable { return "zstd: treeless literals with no Huffman table before them in the frame"; }
  if f == Fault.HuffStream { return "zstd: a literal stream does not decode to exactly its end"; }
  if f == Fault.SeqHeader { return "zstd: the sequences section header is cut off or not valid"; }
  if f == Fault.FseTable { return "zstd: an FSE table description is not valid"; }
  if f == Fault.RleSymbol { return "zstd: an RLE sequence code is out of range"; }
  if f == Fault.NoSeqTable { return "zstd: a repeated sequence table with none before it in the frame"; }
  if f == Fault.SeqStream { return "zstd: the sequences bitstream does not decode to exactly its end"; }
  if f == Fault.LitOverrun { return "zstd: a literal length goes past the block's literals"; }
  if f == Fault.BlockTooBig { return "zstd: a block decodes to more than the block maximum (the window, at most 128 KiB)"; }
  if f == Fault.OffsetZero { return "zstd: a repeat offset of 0"; }
  if f == Fault.OffsetFar { return "zstd: a match reaches back before the window"; }
  "zstd: no fault"
}

// The largest a block's content may be (RFC 8878 Block_Maximum_Size, 128 KiB)
fn blockSizeMax() usize { 131072usize }

// The tables and offsets that go on from block to block in a frame, and the
// literals buffer
struct Entropy {
  lit: HufTable;
  litReady: bool;
  ll: FseTable;
  of: FseTable;
  ml: FseTable;
  seqReady: bool;
  rep1: u64;
  rep2: u64;
  rep3: u64;
  norm: List[i16];
  lits: List[u8];

  fn make() Entropy {
    Entropy(HufTable(), false, FseTable(), FseTable(), FseTable(), false,
      1u64, 4u64, 8u64, List[i16](), List[u8]())
  }

  // A frame's start: no tables, the first repeat offsets
  fn reset(self: &mut) {
    litReady = false;
    seqReady = false;
    rep1 = 1u64;
    rep2 = 4u64;
    rep3 = 8u64;
  }
}

// Where the frame's output is: what a match may reach
struct Reach {
  // The window size the frame header gave
  window: u64;
  // Where the frame's output starts in the history (0 once trimmed past)
  base: usize;
  // The frame's output before this block
  out: u64;
  // The most a block may hold, compressed or not: the window, at most 128 KiB
  blockMax: usize;
}

// A little-endian number of 'n' bytes (up to 8) at src[p]
fn leN(src: &Array[u8], p: usize, n: usize) u64 {
  var v = 0u64;
  var i = 0usize;
  while i < n {
    v = v | (u64.from(src[p + i]) << u64.from(i * 8usize));
    i = i + 1usize;
  }
  v
}

// Decodes the compressed block src[start, end), appending its content to
// 'hist'. 'dict' is the raw-content dictionary of the frame (empty for none).
fn decodeBlock(src: &Array[u8], start: usize, end: usize, ent: &mut Entropy, hist: &mut List[u8],
    reach: &Reach, dict: &List[u8]) Fault {
  var p = start;
  let f = decodeLiterals(src, &mut p, end, ent);
  if f != Fault.Ok { return f; }
  decodeSequences(src, p, end, ent, hist, reach, dict)
}

// The literals section at src[*p, end) into ent.lits; *p moves past it
fn decodeLiterals(src: &Array[u8], p: &mut usize, end: usize, ent: &mut Entropy) Fault {
  ent.lits.clear();
  // Room for the largest literals and 16 bytes of slack, which the sequences'
  // wide copies read past the end into
  ent.lits.reserve(blockSizeMax() + 16usize);
  let at = *p;
  if at >= end { return Fault.LitHeader; }
  let b0 = src[at];
  let kind = b0 & 3u8;
  let sf = (b0 >> 2u8) & 3u8;
  if kind < 2u8 {
    // Raw or RLE: a header of 1 to 3 bytes holding the size
    var hs = 1usize;
    var regen = 0usize;
    if sf == 0u8 || sf == 2u8 {
      regen = usize.from(b0 >> 3u8);
    } else if sf == 1u8 {
      if end - at < 2usize { return Fault.LitHeader; }
      hs = 2usize;
      regen = usize.from(b0 >> 4u8) + (usize.from(src[at + 1usize]) << 4usize);
    } else {
      if end - at < 3usize { return Fault.LitHeader; }
      hs = 3usize;
      regen = usize.from(b0 >> 4u8) + (usize.from(src[at + 1usize]) << 4usize) + (usize.from(src[at + 2usize]) << 12usize);
    }
    if regen > blockSizeMax() { return Fault.LitSize; }
    let q = at + hs;
    if kind == 0u8 {
      if end - q < regen { return Fault.LitHeader; }
      ent.lits.appendSlice(&src[q ..< q + regen]);
      *p = q + regen;
    } else {
      if end - q < 1usize { return Fault.LitHeader; }
      let b = src[q];
      ent.lits.resize(regen, b);
      *p = q + 1usize;
    }
    return Fault.Ok;
  }
  // Huffman-coded (2) or treeless (3, the frame's last table again)
  var hs = 3usize;
  var sizeBits = 10usize;
  var streams = 4usize;
  if sf == 0u8 { streams = 1usize; }
  else if sf == 2u8 { hs = 4usize; sizeBits = 14usize; }
  else if sf == 3u8 { hs = 5usize; sizeBits = 18usize; }
  if end - at < hs { return Fault.LitHeader; }
  let h = leN(src, at, hs);
  let mask = (1u64 << u64.from(sizeBits)) - 1u64;
  let regen = usize.from((h >> 4u64) & mask);
  let csize = usize.from((h >> u64.from(4usize + sizeBits)) & mask);
  if regen > blockSizeMax() { return Fault.LitSize; }
  let q0 = at + hs;
  if end - q0 < csize { return Fault.LitHeader; }
  let qend = q0 + csize;
  var q = q0;
  if kind == 2u8 {
    let used = ent.lit.read(src, q, qend);
    if used < 0i64 { return Fault.HuffTree; }
    q = q + usize.from(used);
    ent.litReady = true;
  } else if !ent.litReady {
    return Fault.NoHuffTable;
  }
  ent.lits.reserve(regen);
  if streams == 1usize {
    if !ent.lit.decodeStream(src, q, qend, regen, &mut ent.lits) { return Fault.HuffStream; }
  } else {
    // A jump table of three 2-byte sizes; the fourth stream is the rest
    if qend - q < 6usize { return Fault.LitStreams; }
    let s1 = usize.from(leN(src, q, 2usize));
    let s2 = usize.from(leN(src, q + 2usize, 2usize));
    let s3 = usize.from(leN(src, q + 4usize, 2usize));
    let a = q + 6usize;
    if qend - a < s1 + s2 + s3 { return Fault.LitStreams; }
    let seg = (regen + 3usize) / 4usize;
    if 3usize * seg > regen { return Fault.LitStreams; }
    let b = a + s1;
    let c = b + s2;
    let d = c + s3;
    if !ent.lit.decode4(src, a, b, c, d, qend, seg, regen, &mut ent.lits) { return Fault.HuffStream; }
  }
  *p = qend;
  Fault.Ok
}

// One of the three tables by its mode (RFC 8878 section 3.1.1.3.2.1.2) at
// src[*p, end); *p moves past what it took
fn seqTable(src: &Array[u8], p: &mut usize, end: usize, mode: u8, t: &mut FseTable, defaults: &Array[i16],
    defaultLog: u32, maxSymbol: usize, maxLog: u32, norm: &mut List[i16], ready: bool, kind: u32) Fault {
  if mode == 0u8 {
    t.buildSeq(defaults, defaultLog, kind);
    return Fault.Ok;
  }
  if mode == 1u8 {
    if *p >= end { return Fault.SeqHeader; }
    let s = src[*p];
    if usize.from(s) > maxSymbol { return Fault.RleSymbol; }
    t.rle(s);
    t.fold(kind);
    *p = *p + 1usize;
    return Fault.Ok;
  }
  if mode == 2u8 {
    var log = 0u32;
    let used = readNCount(src, *p, end, maxSymbol, maxLog, norm, &mut log);
    if used < 0i64 { return Fault.FseTable; }
    if !t.buildSeq(norm.view(), log, kind) { return Fault.FseTable; }
    *p = *p + usize.from(used);
    return Fault.Ok;
  }
  if !ready { return Fault.NoSeqTable; }
  Fault.Ok
}

// The sequences section at src[p, end): decoded and executed into 'hist',
// then the literals left over
fn decodeSequences(src: &Array[u8], p0: usize, end: usize, ent: &mut Entropy, hist: &mut List[u8],
    reach: &Reach, dict: &List[u8]) Fault {
  var p = p0;
  let blockStart = hist.len();
  let nlits = ent.lits.len();
  if p >= end { return Fault.SeqHeader; }
  let b0 = usize.from(src[p]);
  var nseq = 0usize;
  if b0 == 0usize {
    if p + 1usize != end { return Fault.SeqHeader; }
    if nlits > reach.blockMax { return Fault.BlockTooBig; }
    appendRange(hist, &ent.lits, 0usize, nlits);
    return Fault.Ok;
  }
  if b0 < 128usize {
    nseq = b0;
    p = p + 1usize;
  } else if b0 < 255usize {
    if end - p < 2usize { return Fault.SeqHeader; }
    nseq = ((b0 - 128usize) << 8usize) + usize.from(src[p + 1usize]);
    p = p + 2usize;
  } else {
    if end - p < 3usize { return Fault.SeqHeader; }
    nseq = usize.from(src[p + 1usize]) + (usize.from(src[p + 2usize]) << 8usize) + 0x7F00usize;
    p = p + 3usize;
  }
  if p >= end { return Fault.SeqHeader; }
  let modes = src[p];
  p = p + 1usize;
  if (modes & 3u8) != 0u8 { return Fault.SeqHeader; }
  let ready = ent.seqReady;
  var f = seqTable(src, &mut p, end, modes >> 6u8, &mut ent.ll, &llDefault, 6u32, 35usize, 9u32, &mut ent.norm, ready, 0u32);
  if f != Fault.Ok { return f; }
  f = seqTable(src, &mut p, end, (modes >> 4u8) & 3u8, &mut ent.of, &ofDefault, 5u32, 31usize, 8u32, &mut ent.norm, ready, 2u32);
  if f != Fault.Ok { return f; }
  f = seqTable(src, &mut p, end, (modes >> 2u8) & 3u8, &mut ent.ml, &mlDefault, 6u32, 52usize, 9u32, &mut ent.norm, ready, 1u32);
  if f != Fault.Ok { return f; }
  ent.seqReady = true;

  var Some(bits) = BackBits.open(src, p, end) else { return Fault.SeqStream; };
  var llState = bits.read(src, ent.ll.log);
  var ofState = bits.read(src, ent.of.log);
  var mlState = bits.read(src, ent.ml.log);
  // The fast reads in the loop below take bits with no test, on this budget
  // (every figure is a bound that holds on any input):
  // - the next-state bits of a sequence: each is at most its table's log, and
  //   the logs are at most 9 (ll), 9 (ml) and 8 (of), 'readNCount' refusing
  //   more; the predefined tables are 6, 6, 5 and a repeated table is one of
  //   these. Entry check: their sum is at most 26, or the block is refused;
  // - the extra bits: a cell's code is below its distribution's size, so the
  //   offset's are at most 31 and the match's and literal's at most 16 each;
  //   'buildSeq' (or 'fold') took them from the code tables by checked lookups.
  // 'refillSeq' leaves 56 to 63 bits held, whatever the input. A sequence
  // starts with at least 56 and takes T = of + ml + ll extra bits, then S <= 26
  // state bits. If T < 31, T + S <= 56: no refill between. Otherwise there is
  // one after the offset's bits (56 >= ml + ll, at most 32) and one after the
  // extras (56 >= S). The sequence ends with a refill when fewer than 56 are
  // held. 'readFast' needs n >= k and n between 8 and 64: n is 56 to 63 after
  // a refill and above 8 at every read by the above.
  if ent.ll.log + ent.ml.log + ent.of.log > 26u32 { return Fault.FseTable; }
  bits.refillSeq(src);
  var r1 = ent.rep1;
  var r2 = ent.rep2;
  var r3 = ent.rep3;
  var litPos = 0usize;
  let dictLen = dict.len();
  // The block's own output may not pass the block maximum
  let room = reach.blockMax;
  // The 16 bytes of slack are what the wide copies below may write past the end
  // of a literal run or a match (at most 15), after the checks have shown the
  // run or match itself inside 'room'; 'reserve' makes capacity for len + room
  // + 16, so no raw write leaves the allocation. A wide copy reads only bytes of
  // the literals (inside their 16-byte slack) or of this block's own output
  // behind its write point; a match whose offset reaches before the frame's
  // output, or past the window, is refused by the checks below before its copy.
  hist.reserve(room + 16usize);
  // The block is written through pointers into the room just reserved
  // (everything checked against 'room' and the literals' length first), 'w'
  // the next byte; 'hist' gets its new length once, at the end
  let bp = hist.viewMut() as *u8;
  let lp = ent.lits.view() as *u8;
  let dp = dict.view() as *u8;
  var w = blockStart;
  var i = 0usize;
  while i < nseq {
    let llc = *ent.ll.seq[usize.from(llState)];
    let ofc = *ent.of.seq[usize.from(ofState)];
    let mlc = *ent.ml.seq[usize.from(mlState)];
    let ofX = u32.from((ofc >> 32u64) & 0xFFu64);
    let mlX = u32.from((mlc >> 32u64) & 0xFFu64);
    let llX = u32.from((llc >> 32u64) & 0xFFu64);
    let wide = ofX + mlX + llX >= 31u32;
    let ofValue = (ofc & 0xFFFFFFFFu64) + u64.from(bits.readFast(ofX));
    if wide && bits.n < 56u32 { bits.refillSeq(src); }
    let ml = usize.from(u32.from(mlc & 0xFFFFFFFFu64) + bits.readFast(mlX));
    let ll = usize.from(u32.from(llc & 0xFFFFFFFFu64) + bits.readFast(llX));
    var off = 0u64;
    if ofValue > 3u64 {
      off = ofValue - 3u64;
      r3 = r2;
      r2 = r1;
      r1 = off;
    } else {
      let idx = ofValue - 1u64 + (if ll == 0usize {1u64} else {0u64});
      if idx == 0u64 {
        off = r1;
      } else if idx == 1u64 {
        off = r2;
        r2 = r1;
        r1 = off;
      } else if idx == 2u64 {
        off = r3;
        r3 = r2;
        r2 = r1;
        r1 = off;
      } else {
        off = r1 - 1u64;
        if off == 0u64 { return Fault.OffsetZero; }
        r3 = r2;
        r2 = r1;
        r1 = off;
      }
    }
    if i + 1usize < nseq {
      if wide && bits.n < 56u32 { bits.refillSeq(src); }
      llState = u32.from(llc >> 48u64) + bits.readFast(u32.from((llc >> 40u64) & 0xFFu64));
      mlState = u32.from(mlc >> 48u64) + bits.readFast(u32.from((mlc >> 40u64) & 0xFFu64));
      ofState = u32.from(ofc >> 48u64) + bits.readFast(u32.from((ofc >> 40u64) & 0xFFu64));
      if bits.n < 56u32 { bits.refillSeq(src); }
    }
    // Execute: the literals, then the match
    if ll > nlits - litPos { return Fault.LitOverrun; }
    if (w - blockStart) + ll + ml > room { return Fault.BlockTooBig; }
    copyWords(bp + w, lp + litPos, ll);
    w = w + ll;
    litPos = litPos + ll;
    // The frame's output so far, and how far back a match may reach: the
    // window, or while the output is no longer than the window, all of it
    // and the dictionary before it
    let pos = reach.out + u64.from(w - blockStart);
    var limit = if pos < reach.window {pos} else {reach.window};
    if dictLen > 0usize && pos <= reach.window { limit = pos + u64.from(dictLen); }
    if off > limit { return Fault.OffsetFar; }
    if off <= pos {
      // From the frame's own output
      let o = usize.from(off);
      if o > w - reach.base { return Fault.OffsetFar; }
      if o >= 16usize && ml <= 64usize {
        copyFar(bp + w, bp + (w - o), ml);
      } else {
        copyMatch(bp, w, w - o, ml);
      }
    } else {
      // From the dictionary, then on into the frame's output
      let back = usize.from(off - pos);
      let first = if ml < back {ml} else {back};
      copyBytes(bp + w, dp + (dictLen - back), first);
      if ml > first { copyMatch(bp, w + first, reach.base, ml - first); }
    }
    w = w + ml;
    i = i + 1usize;
  }
  if !bits.exact() { return Fault.SeqStream; }
  ent.rep1 = r1;
  ent.rep2 = r2;
  ent.rep3 = r3;
  let rest = nlits - litPos;
  if (w - blockStart) + rest > room { return Fault.BlockTooBig; }
  copyWords(bp + w, lp + litPos, rest);
  w = w + rest;
  commit(hist, blockStart, w - blockStart);
  Fault.Ok
}

// Gives 'hist' the n bytes already written at its end, past its length, in
// room it reserved: 'appendSlice' of exactly those bytes (a copy of them onto
// themselves, a block move, where growing the list by 'resize' or 'push'
// writes a byte at a time)
fn commit(hist: &mut List[u8], at: usize, n: usize) {
  let p = hist.viewMut() as *u8;
  hist.appendSlice(mem.sliceFromParts[u8](p + at, n));
}

// Appends src[from, from + n) to 'dst' in one block copy. 'appendSlice' is
// given a slice made from a pointer because the checker, seeing two lists
// behind references, cannot tell that 'dst' and 'src' are not the same one.
// Bounds-checked.
fn appendRange(dst: &mut List[u8], src: &List[u8], from: usize, n: usize) {
  let part = &src.view()[from ..< from + n];
  dst.appendSlice(mem.sliceFromParts[u8](part as *u8, n));
}

// n bytes from 'from' to 'to', which do not overlap; no bounds check
fn copyBytes(to: *u8, from: *u8, n: usize) inline {
  if n <= 16usize {
    var k = 0usize;
    while k < n {
      mem.writeRaw[u8](to + k, mem.readRaw[u8](from + k));
      k = k + 1usize;
    }
  } else {
    mem.moveRaw[u8](to, from, n);
  }
}

// A wild copy of n bytes from 'from' to 'to', which do not overlap, sixteen
// bytes a step (two words): it reads up to 15 bytes past the source's end and
// writes up to 15 past the target's, so both need 16 bytes of slack beyond the
// n (as 'decodeLiterals' and 'decodeSequences' reserve it). Longer ones go to
// the block move, which a call per copy makes dearer than the steps below that.
fn copyWords(to: *u8, from: *u8, n: usize) inline {
  if n <= 64usize {
    var k = 0usize;
    while k < n {
      mem.writeRaw[u64]((to + k) as *u64, mem.readRaw[u64]((from + k) as *u64));
      mem.writeRaw[u64]((to + (k + 8usize)) as *u64, mem.readRaw[u64]((from + (k + 8usize)) as *u64));
      k = k + 16usize;
    }
  } else {
    mem.moveRaw[u8](to, from, n);
  }
}

// A match of n bytes, 16 or more behind its target (so each 16-byte step reads
// only bytes already final), sixteen bytes a step as 'copyWords' does; the last
// step writes up to 15 bytes past the match, into the 16 bytes of slack
fn copyFar(to: *u8, from: *u8, n: usize) inline {
  var k = 0usize;
  while k < n {
    mem.writeRaw[u64]((to + k) as *u64, mem.readRaw[u64]((from + k) as *u64));
    mem.writeRaw[u64]((to + (k + 8usize)) as *u64, mem.readRaw[u64]((from + (k + 8usize)) as *u64));
    k = k + 16usize;
  }
}

// Writes 'ml' bytes at b[at] as if copied one at a time from b[from],
// b[from + 1], ...: when the source runs on into the bytes being written (the
// match is longer than its offset, from + ml > at), the last 'at - from' bytes
// repeat. The caller has checked 0 < at - from and that b has room to at + ml
// plus 16 bytes of slack, which the last step may write into.
fn copyMatch(b: *u8, at: usize, from: usize, ml: usize) {
  var a = at;
  var f = from;
  var n = ml;
  let off = at - from;
  if off < 8usize {
    if ml <= 8usize {
      var k = 0usize;
      while k < ml {
        mem.writeRaw[u8](b + (at + k), mem.readRaw[u8](b + (from + k)));
        k = k + 1usize;
      }
      return;
    }
    // The first eight bytes one at a time (each reads what the one before
    // wrote); the output is then periodic with period 'off', so the rest can
    // be read from d bytes behind the write, d a multiple of 'off' in 8 to 14
    // (the table: 8 8 9 8 10 12 14 for off 1 to 7), a distance the word steps
    // below handle
    var k = 0usize;
    while k < 8usize {
      mem.writeRaw[u8](b + (at + k), mem.readRaw[u8](b + (from + k)));
      k = k + 1usize;
    }
    let d = usize.from((0x0E0C0A0809080800u64 >> u64.from(off << 3usize)) & 0xFFu64);
    a = at + 8usize;
    f = a - d;
    n = ml - 8usize;
  } else if off >= n && n > 64usize {
    mem.moveRaw[u8](b + a, b + f, n);
    return;
  }
  // Here a - f >= 8. Two words a step, the second read after the first
  // written: the bytes a step reads are all written before it reads them, since
  // each is at least 8 behind its own target and the steps go in order. The
  // last step may write up to 15 bytes past the match, into the slack, from
  // bytes it reads that are not yet written (inside the allocation, and they
  // reach only those bytes past the match: byte j of a step comes from j - d
  // behind it, so the bytes of the match itself never depend on them).
  var k = 0usize;
  while k < n {
    mem.writeRaw[u64]((b + (a + k)) as *u64, mem.readRaw[u64]((b + (f + k)) as *u64));
    mem.writeRaw[u64]((b + (a + (k + 8usize))) as *u64, mem.readRaw[u64]((b + (f + (k + 8usize))) as *u64));
    k = k + 16usize;
  }
}
