// ======== Finding matches: the sequences of a block ========
//
// A block's content becomes sequences (RFC 8878 section 3.1.1.3.2): so many
// literals, then a match of so many bytes from so far back. Two matchers,
// both the reference's shape (zstd's lib/compress/zstd_fast.c and
// zstd_double_fast.c) without their unrolling:
//
//   fast (level 1)          one hash table of the 6 bytes at a position;
//                           one candidate a position
//   double fast (2 and 3)   a table of the 8 bytes at a position and one of
//                           the 5 bytes; the long candidate is tried first,
//                           then the short one (and then the long one a byte
//                           on, which may be better)
//
// Both try the last offset used one byte on before they hash (a "repeat"),
// stretch a match backward over the literals before it, enter two
// positions inside it in the tables, and after a match try the
// second-to-last offset at once. A position no match starts at is skipped
// faster the longer the run of literals (one more byte for every 128, or
// 256, of them). A table holds positions in the input buffer, not checked
// against anything: a candidate is taken only when its bytes match, it
// comes before the position, and it is within the window, so a stale or
// empty (0) entry costs a comparison, never a wrong match.
//
// The input is read through '&Array[u8]', a slice of the compressor's buffer
// held for the whole block, beside '&mut' to its tables.

// The three repeat offsets, as the decoder keeps them
struct Reps {
  r1: u32;
  r2: u32;
  r3: u32;
}

// A block's sequences: its literals in a row, and for each sequence the
// literals before it, the match length and the offset code ("Offset_Value":
// 1 to 3 a repeat, the offset plus 3 otherwise)
//
// The matcher fills pre-sized arrays, so that no List is reshaped inside its
// loop (error 1339 would refuse a slice of the input held across that). Before
// a block, 'prepare' sizes them for the block's length n: the literals are at
// most n; a sequence takes at least 4 bytes of the block (its match), so at
// most n/4 sequences. 'nseq' counts the sequences in 'll', 'ml' and 'off' (the
// arrays are longer); 'nlit' counts the literals in 'lits'.
struct Seqs is Default {
  lits: List[u8];
  ll: List[u32];
  ml: List[u32];
  off: List[u32];
  nseq: usize;
  nlit: usize;

  fn clear(self: &mut) {
    nseq = 0usize;
    nlit = 0usize;
  }

  // Room for a block of n bytes (the Lists only ever grow: their contents beyond the counts are stale)
  fn prepare(self: &mut, n: usize) {
    if lits.len() < n { lits.resize(n, 0u8); }
    let cap = (n >> 2usize) + 2usize;
    if ll.len() < cap {
      ll.resize(cap, 0u32);
      ml.resize(cap, 0u32);
      off.resize(cap, 0u32);
    }
    nseq = 0usize;
    nlit = 0usize;
  }
}

// Where the matcher writes: the Seqs' arrays by pointer (so that they hold no registers in the matcher's loop), with
// their lengths, and how many literals and sequences are written. THE POINTERS STAY IN BOUNDS because 'emit' and
// 'emitRest' check the count against the length before every write (a program error if ever exceeded; it cannot be:
// see Seqs), and the arrays are not touched by anything else while the matcher runs.
struct SeqOut {
  lits: *u8;
  litCap: usize;
  ll: *u32;
  ml: *u32;
  off: *u32;
  seqCap: usize;
  nl: usize;
  ns: usize;

  fn open(seqs: &mut Seqs) SeqOut {
    SeqOut(seqs.lits.viewMut() as *u8, seqs.lits.len(), seqs.ll.viewMut() as *u32, seqs.ml.viewMut() as *u32,
      seqs.off.viewMut() as *u32, seqs.ll.len(), 0usize, 0usize)
  }

  // The counts into 'seqs' (it must be the one 'open' took)
  fn close(self: &, seqs: &mut Seqs) {
    seqs.nseq = ns;
    seqs.nlit = nl;
  }
}

// Records a sequence: the 'll' literals at src[anchor], then a match of 'ml'
// bytes 'off' back. The offset is coded as the decoder will read it (a
// repeat where one fits, by RFC 8878 section 3.1.1.5, which shifts the
// repeats by one when there are no literals) and the repeats are moved
// exactly as the decoder will move them.
fn emit(src: &Array[u8], anchor: usize, ll: usize, off: u32, ml: usize, reps: &mut Reps, so: &mut SeqOut) {
  if ll > 0usize {
    let from = &src[anchor ..< anchor + ll];
    if so.nl + ll > so.litCap { panic("zstd: literals overflow their array"); }
    mem.moveRaw[u8](so.lits + so.nl, from as *u8, ll);
    so.nl += ll;
  }
  if so.ns >= so.seqCap { panic("zstd: sequences overflow their arrays"); }
  var code = 0u32;
  if ll > 0usize {
    if off == reps.r1 {
      code = 1u32;
    } else if off == reps.r2 {
      code = 2u32;
      reps.r2 = reps.r1;
      reps.r1 = off;
    } else if off == reps.r3 {
      code = 3u32;
      reps.r3 = reps.r2;
      reps.r2 = reps.r1;
      reps.r1 = off;
    } else {
      code = off + 3u32;
      reps.r3 = reps.r2;
      reps.r2 = reps.r1;
      reps.r1 = off;
    }
  } else {
    if off == reps.r2 {
      code = 1u32;
      reps.r2 = reps.r1;
      reps.r1 = off;
    } else if off == reps.r3 {
      code = 2u32;
      reps.r3 = reps.r2;
      reps.r2 = reps.r1;
      reps.r1 = off;
    } else if reps.r1 > 1u32 && off == reps.r1 - 1u32 {
      code = 3u32;
      reps.r3 = reps.r2;
      reps.r2 = reps.r1;
      reps.r1 = off;
    } else {
      code = off + 3u32;
      reps.r3 = reps.r2;
      reps.r2 = reps.r1;
      reps.r1 = off;
    }
  }
  let k = so.ns << 2usize;
  mem.writeRaw[u32]((so.ll as *u8 + k) as *u32, u32.from(ll));
  mem.writeRaw[u32]((so.ml as *u8 + k) as *u32, u32.from(ml));
  mem.writeRaw[u32]((so.off as *u8 + k) as *u32, code);
  so.ns += 1usize;
}

// The literals after the last sequence
fn emitRest(src: &Array[u8], anchor: usize, end: usize, so: &mut SeqOut) {
  if end > anchor {
    let n = end - anchor;
    let from = &src[anchor ..< end];
    if so.nl + n > so.litCap { panic("zstd: literals overflow their array"); }
    mem.moveRaw[u8](so.lits + so.nl, from as *u8, n);
    so.nl += n;
  }
}

// The 4 and 8 bytes at src[p], least significant first. One slice of
// exactly that many bytes is one bounds check, and its byte loads then fold
// into one load.
fn rd32(src: &Array[u8], p: usize) u32 { word32(src, p) }
fn rd64(src: &Array[u8], p: usize) u64 { word64(src, p) }

fn word32(b: &Array[u8], p: usize) u32 {
  let s = &b[p..<p + 4usize];
  u32.from(s[0usize]) | (u32.from(s[1usize]) << 8u32) | (u32.from(s[2usize]) << 16u32) | (u32.from(s[3usize]) << 24u32)
}

fn word64(b: &Array[u8], p: usize) u64 {
  let s = &b[p..<p + 8usize];
  u64.from(s[0usize]) | (u64.from(s[1usize]) << 8u64) | (u64.from(s[2usize]) << 16u64)
    | (u64.from(s[3usize]) << 24u64) | (u64.from(s[4usize]) << 32u64) | (u64.from(s[5usize]) << 40u64)
    | (u64.from(s[6usize]) << 48u64) | (u64.from(s[7usize]) << 56u64)
}

// How many bytes from src[a] equal those from src[c] (c < a), not reaching 'end'
fn matchLen(src: &Array[u8], a: usize, c: usize, end: usize) usize {
  let b = src;
  var k = 0usize;
  while a + k + 8usize <= end {
    let x = word64(b, a + k) ^ word64(b, c + k);
    if x != 0u64 { return k + usize.from(x.trailingZeros() >> 3u32); }
    k += 8usize;
  }
  while a + k < end && b[a + k] == b[c + k] { k += 1usize; }
  k
}

// Whether a match of offset 'r' (a repeat) can start at p: it reaches no
// further back than the buffer and the window
fn repFits(p: usize, r: u32, window: usize) bool {
  let ru = usize.from(r);
  ru <= p && ru <= window
}

// ======== The matchers: fast (level 1) and double-fast (levels 2, 3) ========
//
// The fast matcher over src[start, end): sequences into 'seqs', the repeats
// moved in 'reps'; 'table' is 2^log entries, by the 'mls' (6 or 7) bytes at
// a position. The double-fast one has a table by 8 bytes and one by 5.
//
// Each table has a one-byte tag beside every slot (a parallel List[u8], same
// index): a hash of the 4 bytes at the position the slot holds, the very
// bytes a candidate is verified on. A probe reads the tag first, and only
// when it is the tag of the probe's own 4 bytes reads the slot's position
// and then the window at it; a slot whose tag differs holds other bytes, so
// the window load, a cache miss into the 2 MiB window, is skipped. The slot
// is still written on every probe. THE OUTPUT IS THE UNTAGGED MATCHER'S,
// byte for byte: the tag is a function of the 4 verified bytes alone, so it
// rejects exactly the candidates the verify would reject. An empty slot, or
// one a slide dropped to position 0, holds position 0, which the verify may
// accept; their tags are the tag of the buffer's first 4 bytes (Compressor).

// The multiplicative products of the 8 bytes w (read at a position), before the shift
// The multiplicative products of the 8 bytes w (read at a position), before the shift
const MUL_FAST7: u64 = 58295818150454627u64;
const MUL_FAST6: u64 = 227718039650203u64;
const MUL_5: u64 = 889523592379u64;
const MUL_8: u64 = 0xCF1BBCDCB7A56463u64;
fn prod5(w: u64) u64 { (w << 24u64) * MUL_5 }
fn prod8(w: u64) u64 { w * MUL_8 }

// The tag of the 4 bytes w32 (the bytes every candidate is verified on). A candidate whose 4 bytes equal the
// probe's has the probe's tag, so a tag mismatch rejects only candidates the verify would reject
fn tagOf(w32: u32) u8 {
  u8.from(((u64.from(w32) * 2654435761u64) >> 20u64) & 255u64)
}
pub fn tag4(src: &Array[u8], p: usize) u8 { tagOf(rd32(src, p)) }

// The low 4 bytes of the 8 at a position
fn low32(w: u64) u32 { u32.from(w & 0xFFFFFFFFu64) }

// The tables are read and written by pointer in the matchers' loops: a slot index is 'pr >> shift' with shift =
// 64 - log, so it is below 2^log; 'tablePtr' and 'tagPtr' check once, on entry, that log is in 1..31 (so shift =
// 64 - log is in 33..63, never 0 or 64) and that the List holds exactly 2^log
// slots (it does: Compressor.tables sizes them so, and sliding only moves values), so every access is in bounds.
// A pointer to a table of u32 positions is kept as '*u8' and scaled by hand.
fn tablePtr(t: &mut List[u32], log: u32) *u8 {
  if log < 1u32 || log > 31u32 { panic("zstd: a matcher table's log is outside 1..31"); }
  if t.len() != (1usize << usize.from(log)) { panic("zstd: a matcher table is not 2^log slots"); }
  t.viewMut() as *u32 as *u8
}
fn tagPtr(t: &mut List[u8], log: u32) *u8 {
  if log < 1u32 || log > 31u32 { panic("zstd: a matcher table's log is outside 1..31"); }
  if t.len() != (1usize << usize.from(log)) { panic("zstd: a matcher tag table is not 2^log slots"); }
  t.viewMut() as *u8
}

// In one step: the candidate in the slot a product picks, or 'none' (the probe's own position) when its tag is not
// 'tag' (the tag of the 4 bytes at 'none'), and 'pos' entered in the slot with that tag. The shift is below 64
fn slot(t: *u8, g: *u8, pr: u64, shift: u64, tag: u8, pos: usize, none: usize) usize inline {
  let h = usize.from(pr >> shift);
  let tp = (t + (h << 2usize)) as *u32;
  var cand = none;
  if mem.readRaw[u8](g + h) == tag { cand = usize.from(mem.readRaw[u32](tp)); }
  mem.writeRaw[u32](tp, u32.from(pos));
  mem.writeRaw[u8](g + h, tag);
  cand
}

// Enters 'pos' in the slot a product picks, with the tag of the 4 bytes at pos
fn putTag(src: &Array[u8], t: *u8, g: *u8, pr: u64, shift: u64, pos: usize) inline {
  let h = usize.from(pr >> shift);
  mem.writeRaw[u32]((t + (h << 2usize)) as *u32, u32.from(pos));
  mem.writeRaw[u8](g + h, tag4(src, pos));
}

// The product of the bytes at src[p] for the fast matcher (sh and mul are its 'mls' choice: 6 or 7 bytes)
fn prF(src: &Array[u8], p: usize, sh: u64, mul: u64) u64 inline { (rd64(src, p) << sh) * mul }

// The matchers take the tables as pointers (above), the sequences by 'SeqOut', the shifts, multipliers and the
// tag of a position in locals, and touch no List in the loop. The input stays a bounds-checked '&Array'.

// matchFast with tags: 'tags' is as long as 'table'
//
// The miss path is a pair loop, libzstd's shape: each turn probes the pair p and p + 1 (the hash and tag of p + 1 come
// from the word already read at p), and takes the repeat check once, at p2 = p + step, the position the next turn starts
// at, whose word the next turn reuses. The step starts at 2 and grows by one every 128 bytes from the start of the run
// ('nextStep'), compared once a turn. A hit leaves the loop with the match's position and candidate; what follows a
// match (extension, 'emit', the fills, the second repeat) is as before.
//
// BOUNDS. The loop reads the input through a raw pointer. Its condition 'p + step + 8 <= end', checked every turn
// (one compare for all), covers every read the turn makes: the 8 bytes at p (read checked at the run's start, then
// the previous turn's p2 read), at p + 1 (taken from the word at p, no read), and at p2 = p + step (ends at
// p2 + 8 <= end). A candidate is read only when 'cand < pos' (pos = p or p + 1), so its 4 bytes end at
// cand + 4 <= pos + 4 <= p + 5 <= end. The repeat's 4 bytes at p2 - r start at p2 - r >= 0 because r <= p2
// (checked) and end at p2 - r + 4 <= p2 + 4 <= end. The run starts with p + 9 <= end (the outer condition).
// All of this is relative to 'end', and the check on entry ('start <= end && end <= src.len') is what ties 'end' to
// the array: with it, every position below 'end' is in 'src'.
fn matchFast(src: &Array[u8], start: usize, end: usize, window: usize, log: u32, mls: u32, table: &mut List[u32],
    tags: &mut List[u8], reps: &mut Reps, seqs: &mut Seqs) {
  if start > end || end > src.len { panic("zstd: a matcher's range is outside its input"); }
  seqs.prepare(end - start);
  let t = tablePtr(table, log);
  let g = tagPtr(tags, log);
  var so = SeqOut.open(seqs);
  let shift = (64u64 - u64.from(log)) & 63u64;
  let sh = if mls == 7u32 {8u64} else {16u64};
  let mul = if mls == 7u32 {MUL_FAST7} else {MUL_FAST6};
  let sp = src as *u8;
  var ip = start;
  var anchor = start;
  while ip + 9usize <= end {
    var p = ip;
    var step = 2usize;
    var nextStep = ip + 128usize;
    var w0 = rd64(src, p);
    var kind = 0u32;
    var mp = 0usize;
    var mc = 0usize;
    while p + step + 8usize <= end {
      let p2 = p + step;
      let w2 = mem.readRaw[u64]((sp + p2) as *u64);
      let r = usize.from(reps.r1);
      if r <= p2 && r <= window && low32(w2) == mem.readRaw[u32]((sp + (p2 - r)) as *u32) {
        // a repeat at p2; p and p + 1 enter the table first
        slot(t, g, (w0 << sh) * mul, shift, tagOf(low32(w0)), p, p);
        let w1 = w0 >> 8u64;
        slot(t, g, (w1 << sh) * mul, shift, tagOf(low32(w1)), p + 1usize, p + 1usize);
        kind = 3u32;
        mp = p2;
        mc = p2 - r;
        break;
      }
      let w32 = low32(w0);
      let c0 = slot(t, g, (w0 << sh) * mul, shift, tagOf(w32), p, p);
      if c0 < p && p - c0 <= window && mem.readRaw[u32]((sp + c0) as *u32) == w32 {
        kind = 1u32;
        mp = p;
        mc = c0;
        break;
      }
      let w1 = w0 >> 8u64;
      let w132 = low32(w1);
      let c1 = slot(t, g, (w1 << sh) * mul, shift, tagOf(w132), p + 1usize, p + 1usize);
      if c1 < p + 1usize && p + 1usize - c1 <= window && mem.readRaw[u32]((sp + c1) as *u32) == w132 {
        kind = 1u32;
        mp = p + 1usize;
        mc = c1;
        break;
      }
      p = p2;
      w0 = w2;
      if p >= nextStep {
        step += 1usize;
        nextStep += 128usize;
      }
    }
    if kind == 0u32 { break; }
    var ml = 4usize + matchLen(src, mp + 4usize, mc + 4usize, end);
    var s = mp;
    var c = mc;
    while s > anchor && c > 0usize && src[s - 1usize] == src[c - 1usize] {
      s -= 1usize;
      c -= 1usize;
      ml += 1usize;
    }
    emit(src, anchor, s - anchor, u32.from(mp - mc), ml, reps, &mut so);
    ip = s + ml;
    anchor = ip;
    if ip + 8usize <= end {
      putTag(src, t, g, prF(src, mp + 2usize, sh, mul), shift, mp + 2usize);
      putTag(src, t, g, prF(src, ip - 2usize, sh, mul), shift, ip - 2usize);
    }
    while ip + 8usize <= end && repFits(ip, reps.r2, window)
        && rd32(src, ip) == rd32(src, ip - usize.from(reps.r2)) {
      let r2 = reps.r2;
      let ml = 4usize + matchLen(src, ip + 4usize, ip + 4usize - usize.from(r2), end);
      putTag(src, t, g, prF(src, ip, sh, mul), shift, ip);
      emit(src, anchor, 0usize, r2, ml, reps, &mut so);
      ip += ml;
      anchor = ip;
    }
  }
  emitRest(src, anchor, end, &mut so);
  so.close(seqs);
}

// matchDouble with tags: 'longG' and 'shortG' as long as 'longT' and 'shortT'
fn matchDouble(src: &Array[u8], start: usize, end: usize, window: usize, longLog: u32, shortLog: u32,
    longT: &mut List[u32], shortT: &mut List[u32], longG: &mut List[u8], shortG: &mut List[u8],
    reps: &mut Reps, seqs: &mut Seqs) {
  seqs.prepare(end - start);
  let lt = tablePtr(longT, longLog);
  let st = tablePtr(shortT, shortLog);
  let lg = tagPtr(longG, longLog);
  let sg = tagPtr(shortG, shortLog);
  var so = SeqOut.open(seqs);
  let shiftL = (64u64 - u64.from(longLog)) & 63u64;
  let shiftS = (64u64 - u64.from(shortLog)) & 63u64;
  var ip = start;
  var anchor = start;
  while ip + 9usize <= end {
    let w = rd64(src, ip);
    let w32 = low32(w);
    let tag = tagOf(w32);
    let candL = slot(lt, lg, prod8(w), shiftL, tag, ip, ip);
    let candS = slot(st, sg, prod5(w), shiftS, tag, ip, ip);
    let r = reps.r1;
    if repFits(ip + 1usize, r, window) && low32(w >> 8u64) == rd32(src, ip + 1usize - usize.from(r)) {
      let ml = 4usize + matchLen(src, ip + 5usize, ip + 5usize - usize.from(r), end);
      emit(src, anchor, ip + 1usize - anchor, r, ml, reps, &mut so);
      ip = ip + 1usize + ml;
      anchor = ip;
    } else {
      var ml = 0usize;
      var s = ip;
      var c = 0usize;
      if candL < ip && ip - candL <= window && rd64(src, candL) == w {
        ml = 8usize + matchLen(src, ip + 8usize, candL + 8usize, end);
        c = candL;
      } else if candS < ip && ip - candS <= window && rd32(src, candS) == w32 {
        let next = ip + 1usize;
        let w1 = rd64(src, next);
        let candL1 = slot(lt, lg, prod8(w1), shiftL, tagOf(low32(w1)), next, next);
        if candL1 < next && next - candL1 <= window && rd64(src, candL1) == w1 {
          ml = 8usize + matchLen(src, next + 8usize, candL1 + 8usize, end);
          s = next;
          c = candL1;
        } else {
          ml = 4usize + matchLen(src, ip + 4usize, candS + 4usize, end);
          c = candS;
        }
      } else {
        ip += ((ip - anchor) >> 8usize) + 1usize;
        continue;
      }
      let off = u32.from(s - c);
      while s > anchor && c > 0usize && src[s - 1usize] == src[c - 1usize] {
        s -= 1usize;
        c -= 1usize;
        ml += 1usize;
      }
      emit(src, anchor, s - anchor, off, ml, reps, &mut so);
      let at = ip;
      ip = s + ml;
      anchor = ip;
      if ip + 8usize <= end {
        putTag(src, lt, lg, prod8(rd64(src, at + 2usize)), shiftL, at + 2usize);
        putTag(src, lt, lg, prod8(rd64(src, ip - 2usize)), shiftL, ip - 2usize);
        putTag(src, st, sg, prod5(rd64(src, at + 2usize)), shiftS, at + 2usize);
        putTag(src, st, sg, prod5(rd64(src, ip - 1usize)), shiftS, ip - 1usize);
      }
    }
    while ip + 8usize <= end && repFits(ip, reps.r2, window)
        && rd32(src, ip) == rd32(src, ip - usize.from(reps.r2)) {
      let r2 = reps.r2;
      let ml = 4usize + matchLen(src, ip + 4usize, ip + 4usize - usize.from(r2), end);
      let wi = rd64(src, ip);
      putTag(src, st, sg, prod5(wi), shiftS, ip);
      putTag(src, lt, lg, prod8(wi), shiftL, ip);
      emit(src, anchor, 0usize, r2, ml, reps, &mut so);
      ip += ml;
      anchor = ip;
    }
  }
  emitRest(src, anchor, end, &mut so);
  so.close(seqs);
}
