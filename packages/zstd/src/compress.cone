// ======== Compressing a whole input at once ========

// Compresses 'data' into one zstd frame at 'level' (1 to 3; below 1 acts as
// 1, above 3 as 3), with the content size and the content checksum in it. A
// Compressor run to the end of the input, the whole output kept. Data that
// does not compress grows by the frame header, 3 bytes a 128 KiB block and
// the 4-byte checksum.
pub fn compress(data: &Array[u8], level: i32) List[u8] {
  var c = Compressor.make(level);
  c.feed(data);
  c.finish();
  c.runAll();
  c.takeOutput()
}
