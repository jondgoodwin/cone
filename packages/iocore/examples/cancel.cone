// What cancel, the targets, the blocking pool and external operations cost,
// measured, not assumed: run it with
//
//   congo run --release packages/iocore/examples/cancel.cone
//
// 1. Reply latency by target: an answer the loop takes from its port, from
//    that moment (its 'dequeued') to its receiver holding it -- the loop's
//    own poll (Here); a thread asleep in a channel's recv (Chan); a thread
//    asleep on a one-shot (Once); a thread looking at a status slot without
//    sleeping (Status). 5,000 each.
// 2. Cancel: lp.cancel on a receive in flight (the call, and the call to
//    the Cancelled answer); a Request cancelled by another thread (the
//    Request handed over a channel, to the Cancelled answer); a group of
//    1,000 receives cancelled at once (the call, and the time until all
//    1,000 are answered); 1,000 jobs taken out of a lane's queue by cancel;
//    a submit and cancel of a timer, with and without a group.
// 3. The blocking pool's hand-off: a job that does nothing, one at a time
//    (submit to answer, the lane's thread woken each time), and 10,000 at
//    once on four threads.
// 4. External operations: a Completer ended on another thread, from its
//    end to the answer in a loop asleep in poll(forever()).

mod cancel;

import stdio use *;
import thread;
import sync use Sender, Receiver, Channel, Oneshot, OneshotSender, OneshotReceiver;
import collections use List;
import time use Instant, Duration;
import iobuf use *;
import iocore use *;
import diag use Histogram;

const n = 5000u64;

fn spinFor(ns: i64) {
  let until = Instant.now() + Duration.fromNanos(ns);
  while Instant.now() < until {}
}

fn noWork(arg: u64, buf: &mut IoBuf) Outcome {Outcome.Done(0usize)}

fn sleepWork(arg: u64, buf: &mut IoBuf) Outcome {
  thread.sleep(Duration.fromMillis(i64.from(arg)));
  Outcome.Done(0usize)
}

fn waitFor(lp: &mut Loop, out: &mut List[Completion], k: usize) {
  while out.len() < k {lp.poll(forever(), out);}
}

// A connected pair of sockets on lp
fn pair(lp: &mut Loop) Handle, Handle {
  let listener = lp.mustListen(SocketAddr.localhost(0u16));
  var port = 0u16;
  match lp.localAddr(listener) {
    case let Ok(a) {port = a.port();}
    case let Error(e) {}
  }
  lp.submit(Op.Accept(listener), Target.Here(1u64));
  lp.submit(Op.Connect(SocketAddr.localhost(port)), Target.Here(2u64));
  var out = List[Completion].empty();
  waitFor(lp, &mut out, 2usize);
  var a = Handle.none();
  var b = Handle.none();
  var k = 0usize;
  while k < out.len() {
    if out[k].token == 1u64 {a = out[k].handle;} else {b = out[k].handle;}
    k = k + 1usize;
  }
  a, b
}

// Receivers on other threads, each timing its answers from their dequeue
fn chanReceiver(rx: Receiver[Completion]) Histogram {
  var r = rx;
  var h = Histogram.make();
  var more = true;
  while more {
    match r.recv() {
      case let Some(s) {h.record((Instant.now() - s.dequeued).nanos());}
      case is None[Completion] {more = false;}
    }
  }
  h
}

fn onceReceiver(rx: Receiver[OneshotReceiver[Completion]]) Histogram {
  var r = rx;
  var h = Histogram.make();
  var more = true;
  while more {
    match r.recv() {
      case var Some(s) {
        match s.recv() {
          case let Some(c) {h.record((Instant.now() - c.dequeued).nanos());}
          case is None[Completion] {}
        }
      }
      case is None[OneshotReceiver[Completion]] {more = false;}
    }
  }
  h
}

fn statusWatcher(board: StatusArray) Histogram {
  var h = Histogram.make();
  var got = List[Completion].empty();
  var k = 0u64;
  while k < n {
    if board.take(0u32, &mut got) {
      h.record((Instant.now() - got[0usize].dequeued).nanos());
      got.clear();
      k = k + 1u64;
    }
  }
  h
}

fn requestCanceller(rx: Receiver[Request]) u64 {
  var r = rx;
  var k = 0u64;
  var more = true;
  while more {
    match r.recv() {
      case var Some(s) {
        s.cancel();
        k = k + 1u64;
      }
      case is None[Request] {more = false;}
    }
  }
  k
}

// Ends each Completer that arrives, stamping the moment into its count
fn ender(rx: Receiver[Completer]) u64 {
  var r = rx;
  var k = 0u64;
  var more = true;
  while more {
    match r.recv() {
      case var Some(s) {
        spinFor(20000i64);
        s.done(usize.from(Instant.now().nanos()));
        k = k + 1u64;
      }
      case is None[Completer] {more = false;}
    }
  }
  k
}

fn main() i32 {
  var lp = Loop.mustMake();
  var out = List[Completion].empty();

  // 1. Reply latency by target
  printStr("1. reply latency, from the loop taking the answer to its receiver holding it\n");
  {
    var here = Histogram.make();
    var k = 0u64;
    while k < n {
      var c = lp.external(Target.Here(0u64), IoBuf.empty());
      c.done(0usize);
      waitFor(&mut lp, &mut out, 1usize);
      here.record((out[0usize].delivered - out[0usize].dequeued).nanos());
      out.clear();
      k = k + 1u64;
    }
    here.printLine("   Here, the loop's own poll");

    var tx: Sender[Completion];
    var rx: Receiver[Completion];
    tx, rx = Channel[Completion].make();
    let ct = thread.start(rx, &chanReceiver);
    k = 0u64;
    while k < n {
      spinFor(30000i64);
      let before = lp.counters().handedOff;
      var c = lp.external(Target.Chan(0u64, tx.clone()), IoBuf.empty());
      c.done(0usize);
      while lp.counters().handedOff == before {lp.poll(forever(), &mut out);}
      k = k + 1u64;
    }
    {
      let gone = tx;
    }
    ct.join().printLine("   Chan, a thread asleep in recv");

    var otx: Sender[OneshotReceiver[Completion]];
    var orx: Receiver[OneshotReceiver[Completion]];
    otx, orx = Channel[OneshotReceiver[Completion]].make();
    let ot = thread.start(orx, &onceReceiver);
    k = 0u64;
    while k < n {
      var stx: OneshotSender[Completion];
      var srx: OneshotReceiver[Completion];
      stx, srx = Oneshot[Completion].make();
      otx.send(srx);
      spinFor(30000i64);
      let before = lp.counters().handedOff;
      var c = lp.external(Target.Once(0u64, stx), IoBuf.empty());
      c.done(0usize);
      while lp.counters().handedOff == before {lp.poll(forever(), &mut out);}
      k = k + 1u64;
    }
    {
      let gone = otx;
    }
    ot.join().printLine("   Once, a thread asleep on a one-shot");

    let board = StatusArray.make(1u32);
    let st = thread.start(board, &statusWatcher);
    k = 0u64;
    while k < n {
      while !board.isFree(0u32) {}
      spinFor(5000i64);
      var c = lp.external(Target.Status(0u64, board, 0u32), IoBuf.empty());
      c.done(0usize);
      let before = lp.counters().handedOff;
      while lp.counters().handedOff == before {lp.poll(forever(), &mut out);}
      k = k + 1u64;
    }
    st.join().printLine("   Status, a thread looking without sleeping");
  }

  // 2. Cancel
  printStr("2. cancel\n");
  {
    var a = Handle.none();
    var b = Handle.none();
    a, b = pair(&mut lp);
    var call = Histogram.make();
    var reply = Histogram.make();
    var k = 0u64;
    while k < n {
      let id = lp.submit(Op.Recv(a, IoBuf(64usize)), Target.Here(0u64));
      let t0 = Instant.now();
      lp.cancel(id);
      let t1 = Instant.now();
      waitFor(&mut lp, &mut out, 1usize);
      call.record((t1 - t0).nanos());
      reply.record((out[0usize].delivered - t0).nanos());
      out.clear();
      k = k + 1u64;
    }
    call.printLine("   lp.cancel, the call (CancelIoEx)");
    reply.printLine("   lp.cancel, the call to the Cancelled answer");

    var rtx: Sender[Request];
    var rrx: Receiver[Request];
    rtx, rrx = Channel[Request].make();
    let rt = thread.start(rrx, &requestCanceller);
    var remote = Histogram.make();
    k = 0u64;
    while k < n {
      let id = lp.submit(Op.Recv(a, IoBuf(64usize)), Target.Here(0u64));
      let t0 = Instant.now();
      rtx.send(lp.request(id));
      waitFor(&mut lp, &mut out, 1usize);
      remote.record((out[0usize].delivered - t0).nanos());
      out.clear();
      spinFor(20000i64);
      k = k + 1u64;
    }
    {
      let gone = rtx;
    }
    rt.join();
    remote.printLine("   a Request cancelled on another thread, handed over to answered");

    // A group of 1,000 receives, on 1,000 sockets' worth of records: one socket
    // holds one receive at a time, so 1,000 pairs
    var socks = List[Handle].empty();
    k = 0u64;
    while k < 1000u64 {
      var x = Handle.none();
      var y = Handle.none();
      x, y = pair(&mut lp);
      socks.push(x);
      k = k + 1u64;
    }
    var groupCall = Histogram.make();
    var groupAll = Histogram.make();
    var rep = 0u32;
    while rep < 5u32 {
      let g = CancelGroup.make();
      var j = 0usize;
      while j < socks.len() {
        lp.submitIn(Op.Recv(*socks[j], IoBuf(64usize)), Target.Here(0u64), g, forever());
        j = j + 1usize;
      }
      let t0 = Instant.now();
      g.cancel();
      let t1 = Instant.now();
      waitFor(&mut lp, &mut out, 1000usize);
      groupCall.record((t1 - t0).nanos());
      groupAll.record((Instant.now() - t0).nanos());
      out.clear();
      rep = rep + 1u32;
    }
    groupCall.printLine("   a group of 1,000 receives: cancel, the call");
    groupAll.printLine("   ...the call to all 1,000 answered");

    let one = addLane(LaneConfig(name: "one", maxThreads: 1u32, queueBound: 2000u32));
    // A job holding the lane's one thread, so the 1,000 behind it stay queued
    lp.submit(Op.Call(one, &sleepWork, 300u64, IoBuf.empty()), Target.Here(0u64));
    var ids = List[OpId].empty();
    k = 0u64;
    while k < 1000u64 {
      ids.push(lp.submit(Op.Call(one, &noWork, 0u64, IoBuf(64usize)), Target.Here(0u64)));
      k = k + 1u64;
    }
    let t0 = Instant.now();
    var j = 0usize;
    while j < ids.len() {
      lp.cancel(*ids[j]);
      j = j + 1usize;
    }
    let t1 = Instant.now();
    waitFor(&mut lp, &mut out, 1000usize);
    printStr("   1,000 jobs cancelled out of a queue: ");
    printUInt(u64.from((t1 - t0).nanos()) / 1000u64);
    printStr(" ns a cancel; all answered in ");
    diag.printNanos(u64.from(t0.elapsed().nanos()));
    printStr("\n");
    out.clear();
    waitFor(&mut lp, &mut out, 1usize);
    out.clear();

    let g = CancelGroup.make();
    let reps = 100000u64;
    let s0 = Instant.now();
    k = 0u64;
    while k < reps {
      let id = lp.after(Instant.now() + Duration.fromSeconds(1i64), Target.Here(0u64));
      lp.cancel(id);
      k = k + 1u64;
    }
    let s1 = Instant.now();
    k = 0u64;
    while k < reps {
      let id = lp.afterIn(Instant.now() + Duration.fromSeconds(1i64), Target.Here(0u64), g);
      lp.cancel(id);
      k = k + 1u64;
    }
    let s2 = Instant.now();
    while lp.inFlight() > 0u64 {
      lp.poll(Instant.now(), &mut out);
      out.clear();
    }
    printStr("   a timer submitted and cancelled: ");
    printUInt(u64.from((s1 - s0).nanos()) / reps);
    printStr(" ns alone, ");
    printUInt(u64.from((s2 - s1).nanos()) / reps);
    printStr(" ns in a group\n");
  }

  // 3. The pool's hand-off
  printStr("3. the blocking pool, a job that does nothing\n");
  {
    var rt = Histogram.make();
    var k = 0u64;
    while k < n {
      let t0 = Instant.now();
      lp.submit(Op.Call(Lane.general(), &noWork, 0u64, IoBuf.empty()), Target.Here(0u64));
      waitFor(&mut lp, &mut out, 1usize);
      rt.record((out[0usize].delivered - t0).nanos());
      out.clear();
      spinFor(20000i64);
      k = k + 1u64;
    }
    rt.printLine("   one at a time, submit to answer (its thread woken each time)");
    let t0 = Instant.now();
    k = 0u64;
    while k < 10000u64 {
      lp.submit(Op.Call(Lane.general(), &noWork, 0u64, IoBuf.empty()), Target.Here(0u64));
      if k % 1000u64 == 999u64 {
        waitFor(&mut lp, &mut out, 1000usize);
        out.clear();
      }
      k = k + 1u64;
    }
    printStr("   10,000 in batches of 1,000 on four threads: ");
    diag.printNanos(u64.from(t0.elapsed().nanos()) / 10000u64);
    printStr(" a job\n");
  }

  // 4. External operations
  printStr("4. an external operation ended on another thread\n");
  {
    var etx: Sender[Completer];
    var erx: Receiver[Completer];
    etx, erx = Channel[Completer].make();
    let et = thread.start(erx, &ender);
    var h = Histogram.make();
    var k = 0u64;
    while k < n {
      etx.send(lp.external(Target.Here(0u64), IoBuf.empty()));
      lp.poll(forever(), &mut out);
      while out.len() == 0usize {lp.poll(forever(), &mut out);}
      h.record(out[0usize].delivered.nanos() - i64.from(out[0usize].n));
      out.clear();
      k = k + 1u64;
    }
    {
      let gone = etx;
    }
    et.join();
    h.printLine("   ended to answered, the loop asleep in poll(forever())");
  }
  0i32
}
