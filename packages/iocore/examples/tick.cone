// A 1 ms tick measured for jitter, not assumed: run it with
//
//   congo run --release packages/iocore/examples/tick.cone
//
// 1. The loop's 1 ms tick: 2,000 timers, each armed when the one before is
//    delivered, for start + k ms (each due within a tick, so precise): how
//    late each is dequeued, at p50, p99 and the maximum.
// 2. Timeouts through the wheel: 2,000 armed at once, 2 to 2,001 ms off:
//    how late each fires (the wheel's own tick adds up to a millisecond).
// 3. For comparison, what the loop does without its high-resolution timer:
//    the OS's own 1 ms timeout (Windows: GetQueuedCompletionStatusEx on an
//    empty port, at the system's default timer resolution; Linux: epoll_wait
//    on an empty epoll instance), 200 times.
// 4. The cost of a poll that waits for nothing, poll(Instant.now()).

mod tick;

import stdio use *;
import collections use List;
import time use Instant, Duration;
import iocore use *;
import diag use Histogram;

extern {
  fn @c(system) CreateIoCompletionPort(h: usize, port: usize, key: usize, threads: u32) usize;
  fn @c(system) GetQueuedCompletionStatusEx(port: usize, entries: *u8, count: u32,
      removed: &mut u32, ms: u32, alertable: i32) i32;
  fn @c(system) CloseHandle(h: usize) i32;
  fn @c epoll_create1(flags: i32) i32;
  fn @c epoll_wait(epfd: i32, events: *u8, max: i32, timeout: i32) i32;
  fn @c close(fd: i32) i32;
}

fn main() i32 {
  var lp = Loop.mustMake();
  var out = List[Completion].empty();

  // 1. The tick
  let start = Instant.now();
  var late = Histogram.make();
  var k = 1i64;
  lp.after(start + Duration.fromMillis(1i64), Target.Here(1u64));
  while k <= 2000i64 {
    lp.poll(forever(), &mut out);
    var j = 0usize;
    while j < out.len() {
      let c = out[j];
      late.record((c.dequeued - (start + Duration.fromMillis(i64.from(c.token)))).nanos());
      k = k + 1i64;
      if k <= 2000i64 {lp.after(start + Duration.fromMillis(k), Target.Here(u64.from(k)));}
      j = j + 1usize;
    }
    out.clear();
  }
  printStr("1. a 1 ms tick, 2,000 times, through the loop's high-resolution timer\n");
  late.printLine("   lateness");

  // 2. Timeouts through the wheel
  let t0 = Instant.now();
  var i = 0i64;
  while i < 2000i64 {
    let ms = 2i64 + (i * 37i64) % 2000i64;
    lp.after(t0 + Duration.fromMillis(ms), Target.Here(u64.from(ms)));
    i = i + 1i64;
  }
  var wl = Histogram.make();
  var got = 0u64;
  while got < 2000u64 {
    lp.poll(forever(), &mut out);
    var j = 0usize;
    while j < out.len() {
      let c = out[j];
      wl.record((c.dequeued - (t0 + Duration.fromMillis(i64.from(c.token)))).nanos());
      got = got + 1u64;
      j = j + 1usize;
    }
    out.clear();
  }
  printStr("2. 2,000 timeouts, 2 ms to 2 s off, through the wheel\n");
  wl.printLine("   lateness");

  // 3. The port's own timeout
  var entries = Array[u8, 256]() <- fill 0u8;
  var pl = Histogram.make();
  var n = 0u32;
  var w = 0u32;
  if isWindows() {
    let port = CreateIoCompletionPort(0xFFFFFFFFFFFFFFFFusize, 0usize, 0usize, 1u32);
    while w < 200u32 {
      let s = Instant.now();
      GetQueuedCompletionStatusEx(port, &mut entries as *u8, 4u32, &mut n, 1u32, 0i32);
      pl.record((s.elapsed() - Duration.fromMillis(1i64)).nanos());
      w = w + 1u32;
    }
    CloseHandle(port);
  } else {
    let ep = epoll_create1(0i32);
    while w < 200u32 {
      let s = Instant.now();
      epoll_wait(ep, &mut entries as *u8, 4i32, 1i32);
      pl.record((s.elapsed() - Duration.fromMillis(1i64)).nanos());
      w = w + 1u32;
    }
    close(ep);
  }
  printStr(if isWindows() {"3. the completion port's own 1 ms timeout, 200 times, without it\n"}
    else {"3. epoll_wait's own 1 ms timeout, 200 times, without a timerfd\n"});
  pl.printLine("   lateness");

  // 4. A poll that waits for nothing
  let p0 = Instant.now();
  var q = 0u32;
  while q < 100000u32 {
    lp.poll(Instant.now(), &mut out);
    q = q + 1u32;
  }
  printStr("4. poll(Instant.now()) with nothing ready: ");
  printUInt(u64.from(p0.elapsed().nanos()) / 100000u64);
  printStr(" ns a call\n");
  let c = lp.counters();
  printStr(if c.delivered == c.submitted {"   every timer answered once\n"} else {"   TIMERS MISSING\n"});
  printStr("   the timer's expiries ");
  printUInt(c.timerExpiries);
  printStr(", waits ended by the port's own timeout instead ");
  printUInt(c.waitTimeouts);
  printStr("\n");
  0i32
}
