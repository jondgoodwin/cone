// Linux: everything iocore asks of the OS, in one place, beside windows.cone.
// The loop is an epoll instance, with an eventfd that other threads wake it
// by (their packets wait in a queue of the Port, under a lock, and the
// eventfd says there are some) and a timerfd that ends its wait on time.
//
// The model differs from Windows' in one way that shapes the rest. A
// completion port is told "do this" and later "it is done"; epoll is told
// "tell me when this socket can" and the program does the call itself. So a
// socket operation here is tried at once, without waiting (every socket is
// non-blocking); if the kernel says it would block, the operation waits in a
// queue of its handle, receives in one and sends and connects in the other,
// and when epoll says the socket is ready the head of the queue is tried
// again, in order, until one would block. The sockets are registered edge
// triggered, once, for reading and writing both, which is what makes this
// cheap: nothing is re-armed, and an event arrives for every change from not
// ready to ready, so an operation tried and told to wait cannot miss the
// change that follows. A cancel or a deadline needs no help from the kernel:
// the operation is taken out of its queue and answered then and there, its
// buffer with it, so a Linux loop has nothing it must wait for at its death
// and never answers a TimedOut without the buffer.
//
// Files are not epoll's: a regular file is always "ready", and reading it can
// still block on a disk. ReadAt and WriteAt run as jobs on a lane of the
// blocking pool of their own ('pread' and 'pwrite' on a duplicate of the
// descriptor, so that closing the handle while a job runs is harmless), and
// answer through the loop like any pool job. io_uring would give files the
// completion form Windows has, and was not chosen: it is blocked by default
// in the seccomp profile of Docker and of the container runtimes built on it
// (where the playground and any server of ours will run), and a ring is a
// larger thing to build from Cone alone than the epoll calls are.
//
// The numbers an error is given. An IoError's code is Linux's own: the errno
// of the call that failed, or one iocore chose for a failure it found itself
// (EBADF for a handle that names nothing, EINVAL for a buffer with no room,
// EBUSY for a lane's queue full, EMSGSIZE for a datagram cut to the room). A
// getaddrinfo failure is its EAI_ number, which is below 0, kept as a u32
// (EAI_SYSTEM is the errno it names instead). The ioerror package sorts
// these into the kinds that are the same on every system, and 'lxSystemText'
// gives the C library's words.

// epoll's struct epoll_event on x86-64, where it is packed: 12 bytes, the
// events and then the 64-bit datum as two words
struct EpollEvent {
  pub events: u32;
  pub lo: u32;
  pub hi: u32;
}

// struct itimerspec: a timer's period, then its first expiry, each seconds
// and nanoseconds
struct ItimerSpec {
  pub intervalSec: i64;
  pub intervalNsec: i64;
  pub valueSec: i64;
  pub valueNsec: i64;
}

// struct linger
struct LingerLx {
  pub onoff: i32;
  pub secs: i32;
}

// struct msghdr on x86-64, for sendmsg: no address (a connected socket), the
// iovec (Spans), no control data
struct MsgHdrLx {
  pub name: *u8;
  pub namelen: u32;
  pub pad0: u32;
  pub iov: *Span;
  pub iovlen: usize;
  pub control: *u8;
  pub controllen: usize;
  pub flags: i32;
  pub pad1: i32;
}

// The most segments one sendmsg is given (Linux's own bound, IOV_MAX, is
// 1,024): a gather of more goes on from where the call left it, as a partial
// send does
const gatherBatch = 64usize;

// struct addrinfo, as getaddrinfo's results are linked
struct AddrInfoLx {
  pub flags: i32;
  pub family: i32;
  pub socktype: i32;
  pub protocol: i32;
  pub addrlen: u32;
  pub pad: u32;
  pub addr: *u8;
  pub canonname: *u8;
  pub next: *AddrInfoLx;
}

extern {
  fn @c epoll_create1(flags: i32) i32;
  fn @c epoll_ctl(epfd: i32, op: i32, fd: i32, ev: *EpollEvent) i32;
  fn @c epoll_wait(epfd: i32, events: *EpollEvent, max: i32, timeout: i32) i32;
  fn @c eventfd(initial: u32, flags: i32) i32;
  fn @c getrusage(who: i32, usage: *u8) i32;
  fn @c timerfd_create(clock: i32, flags: i32) i32;
  fn @c timerfd_settime(fd: i32, flags: i32, spec: *ItimerSpec, old: *ItimerSpec) i32;
  fn @c("read") sysRead(fd: i32, buf: *u8, n: usize) i64;
  fn @c("write") sysWrite(fd: i32, buf: *u8, n: usize) i64;
  fn @c("close") sysClose(fd: i32) i32;
  fn @c("socket") sysSocket(domain: i32, kind: i32, proto: i32) i32;
  fn @c("accept4") sysAccept4(fd: i32, addr: *u8, len: *u32, flags: i32) i32;
  fn @c("connect") sysConnect(fd: i32, addr: *u8, len: u32) i32;
  fn @c("recv") sysRecv(fd: i32, buf: *u8, n: usize, flags: i32) i64;
  fn @c("send") sysSend(fd: i32, buf: *u8, n: usize, flags: i32) i64;
  fn @c("recvfrom") sysRecvfrom(fd: i32, buf: *u8, n: usize, flags: i32, addr: *u8, len: *u32) i64;
  fn @c("sendto") sysSendto(fd: i32, buf: *u8, n: usize, flags: i32, addr: *u8, len: u32) i64;
  fn @c("sendmsg") sysSendmsg(fd: i32, msg: *MsgHdrLx, flags: i32) i64;
  fn @c("open") sysOpen(path: *u8, flags: i32, mode: u32) i32;
  fn @c("fcntl") sysFcntl(fd: i32, cmd: i32, arg: i32) i32;
  fn @c("pread") sysPread(fd: i32, buf: *u8, n: usize, at: i64) i64;
  fn @c("pwrite") sysPwrite(fd: i32, buf: *u8, n: usize, at: i64) i64;
  fn @c("stat") sysStat(path: cstr, st: *u8) i32;
  fn @c("getaddrinfo") sysGetaddrinfo(node: *u8, service: *u8, hints: *AddrInfoLx, res: &mut *AddrInfoLx) i32;
  fn @c("freeaddrinfo") sysFreeaddrinfo(res: *AddrInfoLx);
  fn @c("gai_strerror") sysGaiStrerror(rc: i32) cstr;
}

// epoll
const epollCtlAdd = 1i32;
const epollIn = 1u32;
const epollOut = 4u32;
const epollErr = 8u32;
const epollHup = 16u32;
const epollRdHup = 0x2000u32;
const epollEt = 0x80000000u32;
const epollCloexec = 0x80000i32;                    // EPOLL_CLOEXEC, EFD_CLOEXEC, TFD_CLOEXEC, SOCK_CLOEXEC, O_CLOEXEC
const nonBlock = 0x800i32;                          // EFD_NONBLOCK, TFD_NONBLOCK, SOCK_NONBLOCK, O_NONBLOCK
const clockMonotonic = 1i32;

// What an epoll datum names: a handle's entry in the low word and its
// generation in the high one (never 0), or, with a high word of 0, one of
// the loop's own descriptors
const datumWake = 1u32;
const datumTimer = 2u32;

// Sockets
const afInetLx = 2i32;
const sockStreamLx = 1i32;
const solSocketLx = 1i32;
const soReuseAddr = 2i32;
const soError = 4i32;
const soLingerLx = 13i32;
const soKeepAliveLx = 9i32;                         // SO_KEEPALIVE
const tcpKeepIdleLx = 4i32;                         // TCP_KEEPIDLE, seconds
const tcpKeepIntvlLx = 5i32;                        // TCP_KEEPINTVL, seconds
const tcpKeepCntLx = 6i32;                          // TCP_KEEPCNT
const tcpUserTimeoutLx = 18i32;                     // TCP_USER_TIMEOUT, milliseconds
const msgNoSignal = 0x4000i32;
const msgPeek = 2i32;
const msgTrunc = 0x20i32;                           // recvfrom answers the datagram's whole length, even when it was cut
const shutWr = 1i32;
const inprogress = 115i32;

// Files
const oRdonly = 0i32;
const oRdwr = 2i32;
const oCreat = 0x40i32;
const oTrunc = 0x200i32;
const fDupfdCloexec = 1030i32;
const sIfmt = 0xF000u32;
const sIfdir = 0x4000u32;

// errno values the loop tells apart
const eintr = 4i32;
const eagain = 11i32;
const econnaborted = 103i32;
const enotconn = 107i32;

// The errno of the call that has just failed
fn lastErrno() i32 {*libc.errno()}


// The C library's words for an error number (gai_strerror's for a
// getaddrinfo failure), 'Error N' where it has none
fn lxSystemText(code: u32) String {
  var out = String.empty();
  if code >= gaiFloor {
    let gtext = sysGaiStrerror(gaiOf(code));
    out.appendBytes(mem.sliceFromParts(gtext.ptr(), gtext.len()));
    return out;
  }
  if code == 0u32 || code > 0x7FFFu32 {
    out.append("Error ");
    out.appendUInt(u64.from(code));
    return out;
  }
  let text = libc.strerror(i32.from(code));
  out.appendBytes(mem.sliceFromParts(text.ptr(), text.len()));
  out
}

const eaiSystem = 0i32 - 11i32;                     // EAI_SYSTEM: the errno says why

// A getaddrinfo failure as an IoError's number: its EAI_ number kept as a u32
// (ioerror's gaiNumber, the numbers from its 'gaiFloor' up), or for
// EAI_SYSTEM the errno
fn lookupFailure(rc: i32) u32 {
  if rc == eaiSystem {return u32.from(lastErrno());}
  gaiNumber(rc)
}

// The same, in 'room' (of 'cap' bytes) when it fits, so that nothing is
// allocated (the pool's work, with a room on its stack); else in a block from
// malloc. The caller lets it go with 'uncopy'
fn cstrIn(s: &Array[u8], room: *u8, cap: usize) *u8 {
  if s.len + 1usize > cap {return cstrCopy(s);}
  libc.memcpy(room, s as *u8, s.len);
  *(room + s.len) = 0u8;
  room
}

// What cstrIn made let go: freed unless it is the room
fn uncopy(p: *u8, room: *u8) {
  if p as usize != room as usize {libc.free(p);}
}

// A NUL-terminated copy of a path's bytes, in a block from libc's malloc the
// caller frees; null when there is no room
fn cstrCopy(s: &Array[u8]) *u8 {
  let p = libc.malloc(s.len + 1usize);
  if p as usize == 0usize {return null;}
  libc.memcpy(p, s as *u8, s.len);
  *(p + s.len) = 0u8;
  p
}

// ---------------------------------------------------------------------------
// The loop's descriptors
// ---------------------------------------------------------------------------

// A descriptor, as the loop's tables hold it
fn fdOf(raw: usize) i32 {i32.from(raw)}

// Add fd to the loop's epoll instance for the datum: edge triggered for
// reading and writing both, and for the peer's close; a socket
fn lxWatch(epfd: usize, fd: usize, entry: u32, gen: u32) u32 {
  if isWindows() {return errorInvalidParameter;}
  var ev = EpollEvent(epollIn | epollOut | epollRdHup | epollEt, entry, gen);
  if epoll_ctl(fdOf(epfd), epollCtlAdd, fdOf(fd), &mut ev as *EpollEvent) != 0i32 {return u32.from(lastErrno());}
  0u32
}

// A level-triggered watch on a descriptor of the loop's own
fn lxWatchOwn(epfd: usize, fd: usize, datum: u32) bool {
  if isWindows() {return false;}
  var ev = EpollEvent(epollIn, datum, 0u32);
  epoll_ctl(fdOf(epfd), epollCtlAdd, fdOf(fd), &mut ev as *EpollEvent) == 0i32
}

// The calling thread's time so far, in nanoseconds: in user mode, then in
// the kernel; zeros if the system cannot say (threadTimes). getrusage's
// RUSAGE_THREAD: a struct rusage of 18 words, its first two timevals these
fn lxThreadTimes() u64, u64 {
  if isWindows() {return 0u64, 0u64;}
  let ru = libc.calloc(18usize, 8usize) as *u64;
  if ru as usize == 0usize {return 0u64, 0u64;}
  var user = 0u64;
  var kernel = 0u64;
  if getrusage(1i32, ru as *u8) == 0i32 {
    user = *ru * 1000000000u64 + *(ru + 1usize) * 1000u64;
    kernel = *(ru + 2usize) * 1000000000u64 + *(ru + 3usize) * 1000u64;
  }
  libc.free(ru as *u8);
  user, kernel
}

// The epoll instance, an eventfd to wake it by and a timerfd to end its wait
// on time, the last two watched: 0 and the three descriptors, or the error
// number that stopped them and zeros. (Each is closed by whoever fails here.)
fn lxOpen() u32, usize, usize, usize {
  if isWindows() {return errorInvalidParameter, 0usize, 0usize, 0usize;}
  let ep = epoll_create1(epollCloexec);
  if ep < 0i32 {return u32.from(lastErrno()), 0usize, 0usize, 0usize;}
  let ev = eventfd(0u32, nonBlock | epollCloexec);
  if ev < 0i32 {
    let code = u32.from(lastErrno());
    sysClose(ep);
    return code, 0usize, 0usize, 0usize;
  }
  let tm = timerfd_create(clockMonotonic, nonBlock | epollCloexec);
  if tm < 0i32 {
    let code = u32.from(lastErrno());
    sysClose(ev);
    sysClose(ep);
    return code, 0usize, 0usize, 0usize;
  }
  if !lxWatchOwn(usize.from(ep), usize.from(ev), datumWake) || !lxWatchOwn(usize.from(ep), usize.from(tm), datumTimer) {
    let code = u32.from(lastErrno());
    sysClose(tm);
    sysClose(ev);
    sysClose(ep);
    return code, 0usize, 0usize, 0usize;
  }
  0u32, usize.from(ep), usize.from(ev), usize.from(tm)
}

// ---------------------------------------------------------------------------
// Handle wait queues: operations that would block, in order, on a socket
// ---------------------------------------------------------------------------

// A socket's queues are its handle's two lists of records in flight (its
// reads and its writes, loop.cone's linkSide and unlinkSide), linked by the
// records' own pointers: a record waits at the end of its list, and readiness
// tries the head

// Whether kind k waits on its handle's queues
fn socketKind(k: u32) bool {
  k == diag.kindConnect || k == diag.kindAccept || k == diag.kindRecv
    || k == diag.kindRecvReady || k == diag.kindSend || k == diag.kindRecvFrom || k == diag.kindSendTo
}

// ---------------------------------------------------------------------------
// Trying an operation
// ---------------------------------------------------------------------------

const triedDone = 0u32;       // answered (decided), and out of its queue
const triedWait = 1u32;       // it would block: it stays where it is

// The bytes a send is sending: the owned buffer's, or the shared ones'
fn sendData(r: &mut OpCore) *u8, usize {
  match r.bytes {
    case let Some(b) {
      let v = b.view();
      return v as *u8, v.len;
    }
    else {}
  }
  r.bufBase(), r.bufLen()
}

// A socket made, closed with the loop's entry for it: a descriptor adopted
// into the handle table and watched. 0 and the handle, or the error number
// (the descriptor is then closed)
fn lxAdopt(lp: &mut Loop, fd: usize, kind: u32, family: u16) u32, Handle {
  if isWindows() {return errorInvalidParameter, Handle.none();}
  let h = lp.register(fd, kind, family);
  let code = lxWatch(lp.portHandle, fd, h.index, h.gen);
  if code != 0u32 {
    lp.close(h);
    return code, Handle.none();
  }
  0u32, h
}

// Try record p's operation now. The record is the head of its queue
fn lxTry(lp: &mut Loop, p: *OpCore, at: Instant) u32 {
  if isWindows() {return triedDone;}
  let r = p as &mut OpCore;
  let ei = lp.handleIndex(r.handle);
  if ei == noEntry {
    lp.unlinkSide(p);
    lp.decide(p, diag.outcomeFailed, 0usize, noSuchHandle());
    return triedDone;
  }
  let fd = fdOf((*lp.handles.at(ei)).raw);
  let k = r.kind;
  if k == diag.kindRecv {
    var n = sysRecv(fd, r.bufBase() + r.bufLen(), r.bufRoom(), 0i32);
    while n < 0i64 && lastErrno() == eintr {n = sysRecv(fd, r.bufBase() + r.bufLen(), r.bufRoom(), 0i32);}
    if n >= 0i64 {
      r.dequeued = at;
      r.bufGrow(usize.from(n));
      lp.unlinkSide(p);
      lp.decide(p, diag.outcomeDone, usize.from(n), 0u32);
      return triedDone;
    }
    let e = lastErrno();
    if e == eagain {return triedWait;}
    r.dequeued = at;
    lp.unlinkSide(p);
    lp.decide(p, diag.outcomeFailed, 0usize, u32.from(e));
    return triedDone;
  }
  if k == diag.kindRecvReady {
    // Data to read, or the end of the stream, without taking either
    var probe = 0u8;
    var n = sysRecv(fd, &mut probe as *u8, 1usize, msgPeek);
    while n < 0i64 && lastErrno() == eintr {n = sysRecv(fd, &mut probe as *u8, 1usize, msgPeek);}
    if n >= 0i64 {
      r.dequeued = at;
      lp.unlinkSide(p);
      lp.decide(p, diag.outcomeDone, 0usize, 0u32);
      return triedDone;
    }
    let e = lastErrno();
    if e == eagain {return triedWait;}
    r.dequeued = at;
    lp.unlinkSide(p);
    lp.decide(p, diag.outcomeFailed, 0usize, u32.from(e));
    return triedDone;
  }
  if k == diag.kindSend && r.isGather() {
    // A gather: sendmsg over the segments from the byte 'done' reached, until
    // the socket has taken them all or would block
    let len = r.gatherLen();
    var spans = Array[Span, 64]() <- fill Span(null, 0usize);
    var failed = 0i32;
    while r.done < len && failed == 0i32 {
      let cnt = r.gatherSpans(r.done, &mut spans as *Span, gatherBatch);
      var msg = MsgHdrLx(null, 0u32, 0u32, &mut spans as *Span, cnt, null, 0usize, 0i32, 0i32);
      let n = sysSendmsg(fd, &mut msg as *MsgHdrLx, msgNoSignal);
      if n >= 0i64 {
        r.done = r.done + usize.from(n);
      } else {
        let e = lastErrno();
        if e != eintr {failed = e;}
      }
    }
    if failed == eagain {return triedWait;}
    r.dequeued = at;
    lp.unlinkSide(p);
    if failed != 0i32 {
      lp.decide(p, diag.outcomeFailed, 0usize, u32.from(failed));
    } else {
      lp.decide(p, diag.outcomeDone, len, 0u32);
    }
    return triedDone;
  }
  if k == diag.kindSend {
    var data = null as *u8;
    var len = 0usize;
    data, len = sendData(r);
    var failed = 0i32;
    while r.done < len && failed == 0i32 {
      let n = sysSend(fd, data + r.done, len - r.done, msgNoSignal);
      if n >= 0i64 {
        r.done = r.done + usize.from(n);
      } else {
        let e = lastErrno();
        if e != eintr {failed = e;}
      }
    }
    if failed == eagain {return triedWait;}
    r.dequeued = at;
    lp.unlinkSide(p);
    if failed != 0i32 {
      lp.decide(p, diag.outcomeFailed, 0usize, u32.from(failed));
    } else {
      lp.decide(p, diag.outcomeDone, len, 0u32);
    }
    return triedDone;
  }
  if k == diag.kindRecvFrom {
    // One datagram. MSG_TRUNC makes the answer its whole length, so a cut one
    // is told from one that fitted exactly
    let room = r.bufRoom();
    (*r.sockAddr()).size = 28i32;
    var n = sysRecvfrom(fd, r.bufBase() + r.bufLen(), room, msgTrunc, r.sockAddr() as *u8, &mut (*r.sockAddr()).size as *u32);
    while n < 0i64 && lastErrno() == eintr {
      (*r.sockAddr()).size = 28i32;
      n = sysRecvfrom(fd, r.bufBase() + r.bufLen(), room, msgTrunc, r.sockAddr() as *u8, &mut (*r.sockAddr()).size as *u32);
    }
    if n >= 0i64 {
      r.dequeued = at;
      lp.unlinkSide(p);
      if usize.from(n) > room {
        // The room is filled, the rest of the datagram lost: EMSGSIZE, which
        // answerError reads as Truncated (Windows' WSAEMSGSIZE)
        r.bufGrow(room);
        lp.decide(p, diag.outcomeFailed, 0usize, datagramCut());
      } else {
        r.bufGrow(usize.from(n));
        lp.decide(p, diag.outcomeDone, usize.from(n), 0u32);
      }
      return triedDone;
    }
    let e = lastErrno();
    if e == eagain {return triedWait;}
    r.dequeued = at;
    lp.unlinkSide(p);
    lp.decide(p, diag.outcomeFailed, 0usize, u32.from(e));
    return triedDone;
  }
  if k == diag.kindSendTo {
    // One datagram, whole or not at all
    let len = r.bufLen();
    var n = sysSendto(fd, r.bufBase(), len, msgNoSignal, r.sockAddr() as *u8, u32.from((*r.sockAddr()).size));
    while n < 0i64 && lastErrno() == eintr {
      n = sysSendto(fd, r.bufBase(), len, msgNoSignal, r.sockAddr() as *u8, u32.from((*r.sockAddr()).size));
    }
    if n < 0i64 && lastErrno() == eagain {return triedWait;}
    r.dequeued = at;
    lp.unlinkSide(p);
    if n < 0i64 {
      lp.decide(p, diag.outcomeFailed, 0usize, u32.from(lastErrno()));
    } else {
      lp.decide(p, diag.outcomeDone, usize.from(n), 0u32);
    }
    return triedDone;
  }
  if k == diag.kindAccept {
    var s = sysAccept4(fd, null, null, nonBlock | epollCloexec);
    while s < 0i32 && (lastErrno() == eintr || lastErrno() == econnaborted) {
      s = sysAccept4(fd, null, null, nonBlock | epollCloexec);
    }
    if s >= 0i32 {
      r.dequeued = at;
      lp.unlinkSide(p);
      let sock = usize.from(s);
      // noDelay first, as the Windows side does for the sockets it adopts
      noDelay(sock);
      var code = 0u32;
      var h = Handle.none();
      code, h = lxAdopt(lp, sock, hSocket, (*lp.handles.at(ei)).family);
      if code != 0u32 {
        lp.decide(p, diag.outcomeFailed, 0usize, code);
      } else {
        r.newHandle = h;
        lp.decide(p, diag.outcomeDone, 0usize, 0u32);
      }
      return triedDone;
    }
    let e = lastErrno();
    if e == eagain {return triedWait;}
    r.dequeued = at;
    lp.unlinkSide(p);
    lp.decide(p, diag.outcomeFailed, 0usize, u32.from(e));
    return triedDone;
  }
  if k == diag.kindConnect {
    // Writable, or failed: SO_ERROR says which. Not yet connected is no answer
    var err = 0i32;
    var len = 4i32;
    if getsockopt(usize.from(fd), solSocketLx, soError, &mut err as *u8, &mut len) != 0i32 {
      err = lastErrno();
    }
    if err == 0i32 {
      var a = Array[u8, 28]() <- fill 0u8;
      var alen = 28i32;
      if getpeername(usize.from(fd), &mut a as *u8, &mut alen) != 0i32 {
        if lastErrno() == enotconn {return triedWait;}
        err = lastErrno();
      }
    }
    r.dequeued = at;
    lp.unlinkSide(p);
    if err == 0i32 {
      noDelay(usize.from(fd));
      r.newHandle = r.handle;
      lp.decide(p, diag.outcomeDone, 0usize, 0u32);
    } else {
      // The socket was only for this connection
      lp.close(r.handle);
      lp.decide(p, diag.outcomeFailed, 0usize, u32.from(err));
    }
    return triedDone;
  }
  triedDone
}

/// Try the operations waiting on one side of entry ei, in order, until one
// would block, or one closes the handle (a failed connect does: its entry is
// then gone)
fn lxRun(lp: &mut Loop, ei: u32, side: u32, at: Instant) {
  if isWindows() {return;}
  while true {
    let e = lp.handles.at(ei);
    if e as usize == 0usize {break;}
    let head = if side == onReads {(*e).reads} else {(*e).writes};
    if head as usize == 0usize {break;}
    if lxTry(lp, head, at) == triedWait {break;}
  }
}

// epoll says handle entry ei (generation gen) has events
fn lxEvent(lp: &mut Loop, ei: u32, gen: u32, events: u32, at: Instant) {
  if isWindows() {return;}
  if lp.handles.get(Slot(ei, gen)) as usize == 0usize {return;}
  if (events & (epollIn | epollErr | epollHup | epollRdHup)) != 0u32 {lxRun(lp, ei, onReads, at);}
  // The operations may have closed it (a failed connect does): look again
  if lp.handles.get(Slot(ei, gen)) as usize == 0usize {return;}
  if (events & (epollOut | epollErr | epollHup)) != 0u32 {lxRun(lp, ei, onWrites, at);}
}

// Start record p's operation on its socket: it is tried at once, and waits in
// its handle's queue if it would block
fn lxQueue(lp: &mut Loop, p: *OpCore, side: u32) u32 {
  if isWindows() {return errorInvalidParameter;}
  let r = p as &mut OpCore;
  let ei = lp.handleIndex(r.handle);
  if ei == noEntry {return noSuchHandle();}
  r.done = 0usize;
  lp.linkSide(p, side);
  lxRun(lp, ei, side, Instant.now());
  0u32
}

// A send issued on another thread that moved part of its bytes (shared.cone):
// it waits in its handle's queue and goes on from 'done', which is kept (not
// lxQueue's fresh start); a handle gone meanwhile fails it, as a try does
fn lxLinkIssued(lp: &mut Loop, p: *OpCore) {
  if isWindows() {return;}
  let r = p as &mut OpCore;
  let ei = lp.handleIndex(r.handle);
  if ei == noEntry {
    lp.decide(p, diag.outcomeFailed, 0usize, noSuchHandle());
    return;
  }
  let side = if writes(r.kind) {onWrites} else {onReads};
  lp.linkSide(p, side);
  lxRun(lp, ei, side, Instant.now());
}

// A Recv or a RecvReady
fn lxStartRecv(lp: &mut Loop, p: *OpCore, ready: bool) u32 {
  if isWindows() {return errorInvalidParameter;}
  let r = p as &mut OpCore;
  if lp.rawOf(r.handle, hSocket) == invalidHandle {return noSuchHandle();}
  if !ready && r.bufRoom() == 0usize {return noRoom();}
  lxQueue(lp, p, onReads)
}

// A Send, a SendBytes or a SendChain
fn lxStartSend(lp: &mut Loop, p: *OpCore) u32 {
  if isWindows() {return errorInvalidParameter;}
  let r = p as &mut OpCore;
  if lp.rawOf(r.handle, hSocket) == invalidHandle {return noSuchHandle();}
  lxQueue(lp, p, onWrites)
}

// A RecvFrom
fn lxStartRecvFrom(lp: &mut Loop, p: *OpCore) u32 {
  if isWindows() {return errorInvalidParameter;}
  let r = p as &mut OpCore;
  if lp.rawOf(r.handle, hDatagram) == invalidHandle {return noSuchHandle();}
  if r.bufRoom() == 0usize {return noRoom();}
  lxQueue(lp, p, onReads)
}

// A SendTo
fn lxStartSendTo(lp: &mut Loop, p: *OpCore) u32 {
  if isWindows() {return errorInvalidParameter;}
  let r = p as &mut OpCore;
  if lp.rawOf(r.handle, hDatagram) == invalidHandle {return noSuchHandle();}
  lxQueue(lp, p, onWrites)
}

fn lxStartAccept(lp: &mut Loop, p: *OpCore) u32 {
  if isWindows() {return errorInvalidParameter;}
  let r = p as &mut OpCore;
  if lp.rawOf(r.handle, hListener) == invalidHandle {return noSuchHandle();}
  lxQueue(lp, p, onReads)
}

// A Connect: the socket is made and connected (non-blocking) before epoll
// is told of it, so that the readiness it reports is the connection's, and
// is a handle of the table until the operation ends (the record waits on its
// writes); it is exposed in the answer if it connects
fn lxStartConnect(lp: &mut Loop, p: *OpCore, addr: SocketAddr) u32 {
  if isWindows() {return errorInvalidParameter;}
  let r = p as &mut OpCore;
  let s = tcpSocket(addr.family());
  if s == invalidHandle {return wsaError();}
  var a = addr;
  let rc = sysConnect(fdOf(s), &mut a as *u8, u32.from(a.size));
  var e = 0i32;
  if rc != 0i32 {
    e = lastErrno();
    if e != inprogress {
      sysClose(fdOf(s));
      return u32.from(e);
    }
  }
  var code = 0u32;
  var h = Handle.none();
  code, h = lxAdopt(lp, s, hSocket, addr.family());
  if code != 0u32 {return code;}
  r.handle = h;
  r.family = addr.family();
  // Connected already, or waiting for the socket to become writable
  lp.linkSide(p, onWrites);
  if rc == 0i32 {lxRun(lp, h.index, onWrites, Instant.now());}
  0u32
}

// ---------------------------------------------------------------------------
// Cancel
// ---------------------------------------------------------------------------

// A socket operation is asked to end: it is taken out of its queue and
// answered at once, its buffer with it. A connection being made loses its
// socket
fn lxCancel(lp: &mut Loop, p: *OpCore, outcome: u32) {
  if isWindows() {return;}
  let r = p as &mut OpCore;
  lp.unlinkSide(p);
  if r.kind == diag.kindConnect {lp.close(r.handle);}
  r.dequeued = Instant.now();
  lp.decide(p, outcome, 0usize, 0u32);
}

// A socket operation is asked to end, by a cancel or a deadline. What the
// kernel would have done by now is done: the operation, first in its queue,
// gets one more try, and if the socket can give it what it wants it ends
// Done (or Failed), as an operation finished before the cancel does on
// Windows. If not, the cancel has caught it: it leaves its queue, so that
// nothing that arrives afterwards can complete it, and is answered at the
// next wait (lxSettleCancels), so that asking again says it is still to answer
fn lxAskCancel(lp: &mut Loop, p: *OpCore) {
  if isWindows() {return;}
  let r = p as &mut OpCore;
  if r.side != onNone && r.hprev as usize == 0usize {
    if lxTry(lp, p, Instant.now()) == triedDone {return;}
  }
  lp.unlinkSide(p);
  lp.cancels.push(Asked(p, r.gen));
}

// The cancels asked since the last wait are answered, after the events that
// came with the wait (an operation they finished is Done, not Cancelled).
// Each names its record and the record's generation then, so one answered
// meanwhile, and its record reused, is not mistaken for another
fn lxSettleCancels(lp: &mut Loop) {
  if isWindows() {return;}
  var k = 0usize;
  while k < lp.cancels.len() {
    let p = lp.cancels[k].p;
    let gen = lp.cancels[k].gen;
    k = k + 1usize;
    let r = p as &mut OpCore;
    if r.gen != gen || r.state != stFlight {continue;}
    lxCancel(lp, p, if r.asked == askedDeadline {diag.outcomeTimedOut} else {diag.outcomeCancelled});
  }
  lp.cancels.clear();
}

// The file operations in flight on file handle h are asked to end, as
// Windows' CancelIoEx asks them: one still queued is answered Cancelled, one
// running ends as it ends. They are the jobs on its lists
fn lxCancelFiles(lp: &mut Loop, h: Handle) {
  if isWindows() {return;}
  let e = lp.handles.at(h.index) as &HEntry;
  if e.kind != hFile {return;}
  var side = 0u32;
  while side < 2u32 {
    var p = if side == 0u32 {e.reads} else {e.writes};
    while p as usize != 0usize {
      let next = (*p).hnext;
      if (*p).state == stFlight && (*p).asked == askedNone {lp.askCancel(p, askedCancel);}
      p = next;
    }
    side = side + 1u32;
  }
}

// Every socket operation waiting on handle entry ei is answered Cancelled (a
// file's lists hold its jobs, which the pool's own records end)
fn lxCancelAll(lp: &mut Loop, ei: u32) {
  if isWindows() {return;}
  if (*lp.handles.at(ei)).kind == hFile {return;}
  while true {
    let head = (*lp.handles.at(ei)).reads;
    if head as usize == 0usize {break;}
    lp.unlinkSide(head);
    lp.decide(head, diag.outcomeCancelled, 0usize, 0u32);
  }
  while true {
    let head = (*lp.handles.at(ei)).writes;
    if head as usize == 0usize {break;}
    lp.unlinkSide(head);
    lp.decide(head, diag.outcomeCancelled, 0usize, 0u32);
  }
}

// ---------------------------------------------------------------------------
// The wait
// ---------------------------------------------------------------------------

// Arm the timer for wakeAt (unless it already is) and answer the wait's own
// timeout in milliseconds, a backstop a millisecond past it; 'infinite' when
// wakeAt never comes
fn lxArm(lp: &mut Loop, wakeAt: Instant, now: Instant) u32 {
  if isWindows() {return 0u32;}
  if wakeAt >= forever() {return infinite;}
  let left = (wakeAt - now).nanos();
  if !lp.associated || lp.armedFor != wakeAt {
    let ns = if left < 1i64 {1i64} else {left};
    var spec = ItimerSpec(0i64, 0i64, ns / 1000000000i64, ns % 1000000000i64);
    timerfd_settime(fdOf(lp.timer), 0i32, &mut spec as *ItimerSpec, null);
    lp.armedFor = wakeAt;
    lp.associated = true;
  }
  let ms = (left + 999999i64) / 1000000i64 + 1i64;
  if ms >= i64.from(infinite) {infinite - 1u32} else {u32.from(ms)}
}

// Take what the other threads have posted: the eventfd is reset and the
// queue emptied, each packet handled. How many answers went to out
fn lxDrain(lp: &mut Loop, at: Instant, out: &mut List[Completion]) usize {
  if isWindows() {return 0usize;}
  var counter = 0u64;
  sysRead(fdOf(lp.port.handle), &mut counter as *u8, 8usize);
  // Cleared before the queue is taken: a poster after this writes again, and
  // one before it has its packet in the queue taken below
  lp.port.pending.store(0u32);
  // A wake carries no packet: its word, taken after 'pending' is cleared, so
  // a wake after this writes again
  var n = 0usize;
  if lp.port.wakes.swap(0u32) != 0u32 {
    n = lp.handlePacket(keyWake, null, at, out);
  }
  let st = lp.port.lists();
  st.lock.lock();
  var node = st.head;
  var job = st.jobsHead;
  st.head = null;
  st.tail = null;
  st.jobsHead = null;
  st.jobsTail = null;
  st.lock.unlock();
  while node as usize != 0usize {
    let next = (*node).next;
    n = n + lp.handlePacket((*node).key, (*node).ov, at, out);
    libc.free(node as *u8);
    node = next;
  }
  // The jobs' records come home, each linked by its own 'jnext' (read before
  // the record is the loop's again)
  while job as usize != 0usize {
    let next = (*job).jnext;
    lp.completeJob(job, at);
    job = next;
  }
  n
}

// One wait in epoll, for at most ms, and what it brought processed: how many
// answers posted by other loops went to out
fn lxDequeue(lp: &mut Loop, ms: u32, out: &mut List[Completion]) usize {
  if isWindows() {return 0usize;}
  let timeout = if ms == infinite {0i32 - 1i32} else if ms > 0x7FFFFFFFu32 {0x7FFFFFFFi32} else {i32.from(ms)};
  let got = epoll_wait(fdOf(lp.portHandle), lp.events, i32.from(batch), timeout);
  lp.stats.passes = lp.stats.passes + 1u64;
  if ms != 0u32 {lp.stats.waits = lp.stats.waits + 1u64;}
  if got <= 0i32 {
    if ms != 0u32 && ms != infinite {lp.stats.waitTimeouts = lp.stats.waitTimeouts + 1u64;}
    lxSettleCancels(lp);
    return 0usize;
  }
  let at = Instant.now();
  lp.stats.dequeued = lp.stats.dequeued + u64.from(got);
  if u64.from(got) > lp.stats.largestBatch {lp.stats.largestBatch = u64.from(got);}
  var n = 0usize;
  var k = 0usize;
  while k < usize.from(got) {
    let ev = lp.events + k;
    let entry = (*ev).lo;
    let gen = (*ev).hi;
    if gen == 0u32 {
      if entry == datumWake {
        n = n + lxDrain(lp, at, out);
      } else if entry == datumTimer {
        var expirations = 0u64;
        sysRead(fdOf(lp.timer), &mut expirations as *u8, 8usize);
        lp.associated = false;
        lp.stats.timerExpiries = lp.stats.timerExpiries + 1u64;
      }
    } else {
      lxEvent(lp, entry, gen, (*ev).events, at);
    }
    k = k + 1usize;
  }
  if lp.groupsDirty {lp.sweepGroups();}
  lxSettleCancels(lp);
  n
}

// ---------------------------------------------------------------------------
// Files, as jobs of the blocking pool
// ---------------------------------------------------------------------------

/// A ReadAt or WriteAt: a job on the files lane, the record holding a
// duplicate of the descriptor ('jfd', closed when the job is home), so that
// closing the handle while it runs is harmless. The record goes away, its
// buffer in it, and the lane's thread reads or writes it in place (pool.cone)
fn lxStartFile(lp: &mut Loop, p: *OpCore, write: bool) u32 {
  if isWindows() {return errorInvalidParameter;}
  let r = p as &mut OpCore;
  let raw = lp.rawOf(r.handle, hFile);
  if raw == invalidHandle {return noSuchHandle();}
  if !write && r.bufRoom() == 0usize {return noRoom();}
  let l = laneAt(filesLane);
  if l as usize == 0usize {return badParameter();}
  let dup = sysFcntl(fdOf(raw), fDupfdCloexec, 0i32);
  if dup < 0i32 {return u32.from(lastErrno());}
  r.jfd = dup;
  r.lane = Lane(filesLane);
  sendAway(p, Waker(lp.port), jobQueued);
  if !enqueueJob(p, l) {
    bringHome(p);
    return queueFull();
  }
  0u32
}

// A file job, run on a thread of the pool on its record: the whole of a
// write, as much as there is of a read (up to the buffer's room), at the
// record's offset
fn lxFileJob(r: &mut OpCore) Outcome {
  if isWindows() {return Outcome.Failed(errorInvalidParameter);}
  let fd = r.jfd;
  let at = r.at;
  let write = r.kind == diag.kindWriteAt;
  match &mut r.buf {
    case var &mut Some(buf) {return lxFileIo(fd, at, write, buf);}
    else {}
  }
  Outcome.Failed(badParameter())
}

fn lxFileIo(fd: i32, at: u64, write: bool, buf: &mut IoBuf) Outcome {
  if isWindows() {return Outcome.Failed(errorInvalidParameter);}
  if write {
    let len = buf.len();
    var done = 0usize;
    var failed = 0i32;
    while done < len && failed == 0i32 {
      let n = sysPwrite(fd, buf.base() + done, len - done, i64.from(at + u64.from(done)));
      if n >= 0i64 {
        done = done + usize.from(n);
      } else {
        let e = lastErrno();
        if e != eintr {failed = e;}
      }
    }
    if failed != 0i32 {return Outcome.Failed(u32.from(failed));}
    return Outcome.Done(len);
  }
  let room = buf.room();
  var n = sysPread(fd, buf.base() + buf.len(), room, i64.from(at));
  while n < 0i64 && lastErrno() == eintr {
    n = sysPread(fd, buf.base() + buf.len(), room, i64.from(at));
  }
  if n < 0i64 {return Outcome.Failed(u32.from(lastErrno()));}
  buf.setLen(buf.len() + usize.from(n));
  Outcome.Done(usize.from(n))
}

// ---------------------------------------------------------------------------
// Work for the pool: a name looked up, a file's metadata, a file read
// ---------------------------------------------------------------------------

fn lxResolve(arg: u64, buf: &mut IoBuf) Outcome {
  if isWindows() {return Outcome.Failed(errorInvalidParameter);}
  var narrow = Array[u8, 1024]() <- fill 0u8;
  let name = cstrIn(buf.view(), &mut narrow as *u8, 1024usize);
  if name as usize == 0usize {return Outcome.Failed(noMemory());}
  var hints = AddrInfoLx(0i32, 0i32, sockStreamLx, 6i32, 0u32, 0u32, null, null, null);
  var res = null as *AddrInfoLx;
  let rc = sysGetaddrinfo(name, null, &mut hints as *AddrInfoLx, &mut res);
  uncopy(name, &mut narrow as *u8);
  if rc != 0i32 {return Outcome.Failed(lookupFailure(rc));}
  buf.clear();
  var count = 0usize;
  var a = res;
  let recSize = mem.sizeof[SocketAddr]();
  while a as usize != 0usize {
    if (*a).addrlen <= 28u32 && buf.room() >= recSize {
      var s = SocketAddr(Array[u8, 28]() <- fill 0u8, i32.from((*a).addrlen));
      libc.memcpy(&mut s.raw as *u8, (*a).addr, usize.from((*a).addrlen));
      s.setPort(u16.from(arg));
      buf.append(mem.sliceFromParts(&mut s as *u8, recSize));
      count = count + 1usize;
    }
    a = (*a).next;
  }
  sysFreeaddrinfo(res);
  Outcome.Done(count)
}

// A file's metadata in the shape a statOp's buffer has on every system
// (WIN32_FILE_ATTRIBUTE_DATA's): the attributes, three FILETIMEs, the size's
// high word and its low word
fn lxStat(arg: u64, buf: &mut IoBuf) Outcome {
  if isWindows() {return Outcome.Failed(errorInvalidParameter);}
  // The path as a C string, a NUL after its bytes (cstr, the type the posix
  // package declares 'stat' with too: one C name, one signature), on the stack
  // when it fits
  var k = 0usize;
  while k < buf.len() {
    if buf.view()[k] == 0u8 {return Outcome.Failed(badParameter());}
    k = k + 1usize;
  }
  var narrow = Array[u8, 4096]() <- fill 0u8;
  let name = cstrIn(buf.view(), &mut narrow as *u8, 4096usize);
  if name as usize == 0usize {return Outcome.Failed(noMemory());}
  // struct stat on x86-64 is 144 bytes: st_mode at 24, st_size at 48 and
  // st_mtim at 88
  var st = Array[u64, 18]() <- fill 0u64;
  let rc = sysStat(cstr.fromPtr(name), &mut st as *u8);
  uncopy(name, &mut narrow as *u8);
  if rc != 0i32 {return Outcome.Failed(u32.from(lastErrno()));}
  let mode = u32.from(st[3usize] & 0xFFFFFFFFu64);
  let size = st[6usize];
  let sec = i64.from(st[11usize]);
  let nsec = i64.from(st[12usize]);
  var attributes = if (mode & sIfmt) == sIfdir {0x10u32} else {0x80u32};
  if (mode & 0x92u32) == 0u32 {attributes = attributes | 1u32;}
  // A FILETIME counts 100 ns from 1601
  let filetime = u64.from(sec * 10000000i64 + nsec / 100i64 + 116444736000000000i64);
  var data = Array[u32, 9]() <- fill 0u32;
  data[0usize] = attributes;
  data[5usize] = u32.from(filetime & 0xFFFFFFFFu64);
  data[6usize] = u32.from(filetime >> 32u64);
  data[7usize] = u32.from(size >> 32u64);
  data[8usize] = u32.from(size & 0xFFFFFFFFu64);
  buf.clear();
  buf.append(mem.sliceFromParts(&mut data as *u8, 36usize));
  Outcome.Done(36usize)
}

// A file opened, read from 'arg' as far as the buffer's room goes, and closed
fn lxReadFile(arg: u64, buf: &mut IoBuf) Outcome {
  if isWindows() {return Outcome.Failed(errorInvalidParameter);}
  var narrow = Array[u8, 4096]() <- fill 0u8;
  let path = cstrIn(buf.view(), &mut narrow as *u8, 4096usize);
  if path as usize == 0usize {return Outcome.Failed(noMemory());}
  let fd = sysOpen(path, oRdonly | epollCloexec, 0u32);
  uncopy(path, &mut narrow as *u8);
  if fd < 0i32 {return Outcome.Failed(u32.from(lastErrno()));}
  buf.clear();
  let room = buf.room();
  var got = 0usize;
  var failed = 0u32;
  while got < room {
    let n = sysPread(fd, buf.base() + got, room - got, i64.from(arg + u64.from(got)));
    if n < 0i64 {
      let e = lastErrno();
      if e == eintr {continue;}
      failed = u32.from(e);
      break;
    }
    if n == 0i64 {break;}
    got = got + usize.from(n);
  }
  sysClose(fd);
  if failed != 0u32 {return Outcome.Failed(failed);}
  buf.setLen(got);
  Outcome.Done(got)
}
