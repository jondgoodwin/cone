// Windows: everything iocore asks of the OS, in one place (Linux's is in
// linux.cone). kernel32's completion port, overlapped file I/O and waitable
// timer; ntdll's wait completion packet, which turns the timer's expiry into
// a completion on the port, and its translation of an NTSTATUS into a Windows
// error number; and Winsock (ws2_32), whose AcceptEx and ConnectEx are not
// exported but handed out at run time by WSAIoctl and called through function
// pointers.
//
// Each function below that Linux needs too, or that is called from code both
// run, chooses by 'isWindows()', a constant of the compile, so only the
// target's calls are generated; every extern is declared on every platform. The
// Winsock calls that POSIX has too, with the same arguments (bind, listen,
// getsockname, getpeername, shutdown, setsockopt, getsockopt), are called on a Linux
// descriptor as they are on a Windows socket: a usize, whose low 32 bits are
// the descriptor.

// OVERLAPPED: what the kernel holds of an operation until it completes. Its
// first word is the NTSTATUS the operation ended with, its second the bytes
// it moved; Offset and OffsetHigh are a file operation's position
struct Overlapped {
  pub internal: usize;
  pub internalHigh: usize;
  pub offset: u32;
  pub offsetHigh: u32;
  pub hEvent: usize;
}

// OVERLAPPED_ENTRY: one completion, as GetQueuedCompletionStatusEx takes it
struct OverlappedEntry {
  pub key: usize;
  pub ov: *u8;
  pub internal: usize;
  pub bytes: u32;
}

// WSABUF
struct WsaBuf {
  pub len: u32;
  pub buf: *u8;
}

// GUID
struct Guid {
  pub a: u32;
  pub b: u16;
  pub c: u16;
  pub d: Array[u8, 8];
}

extern {
  // kernel32: the port, files, the timer
  fn @c(system) CreateIoCompletionPort(h: usize, port: usize, key: usize, threads: u32) usize;
  fn @c(system) GetQueuedCompletionStatusEx(port: usize, entries: *OverlappedEntry, count: u32,
      removed: &mut u32, ms: u32, alertable: i32) i32;
  fn @c(system) PostQueuedCompletionStatus(port: usize, bytes: u32, key: usize, ov: *u8) i32;
  fn @c(system) CloseHandle(h: usize) i32;
  fn @c(system) GetLastError() u32;
  fn @c(system) CancelIoEx(h: usize, ov: *u8) i32;
  fn @c(system) CreateFileW(name: *u16, access: u32, share: u32, sa: *u8, disposition: u32,
      flags: u32, template: usize) usize;
  fn @c(system) ReadFile(h: usize, buf: *u8, n: u32, done: *u32, ov: *u8) i32;
  fn @c(system) WriteFile(h: usize, buf: *u8, n: u32, done: *u32, ov: *u8) i32;
  fn @c(system) CreateWaitableTimerExW(attrs: *u8, name: *u16, flags: u32, access: u32) usize;
  fn @c(system) SetWaitableTimer(h: usize, due: &i64, period: i32, apc: *u8, arg: *u8, resume: i32) i32;
  fn @c(system) CancelWaitableTimer(h: usize) i32;
  fn @c(system) MultiByteToWideChar(page: u32, flags: u32, from: *u8, fromLen: i32, to: *u16, toLen: i32) i32;
  fn @c(system) WideCharToMultiByte(page: u32, flags: u32, from: *u16, fromLen: i32, to: *u8, toLen: i32,
      fallback: *u8, usedFallback: *i32) i32;
  fn @c(system) FormatMessageW(flags: u32, source: *u8, id: u32, language: u32, buf: *u16, size: u32,
      args: *u8) u32;
  fn @c(system) GetFileAttributesExW(name: *u16, level: i32, info: *u8) i32;

  // ntdll: the wait completion packet (Windows 8 and later), and NTSTATUS
  fn @c(system) NtCreateWaitCompletionPacket(out: &mut usize, access: u32, attrs: *u8) i32;
  fn @c(system) NtAssociateWaitCompletionPacket(packet: usize, port: usize, target: usize,
      keyContext: *u8, apcContext: *u8, status: i32, info: usize, already: *u8) i32;
  fn @c(system) NtCancelWaitCompletionPacket(packet: usize, removeSignaled: u8) i32;
  fn @c(system) RtlNtStatusToDosError(status: u32) u32;

  // ws2_32
  fn @c(system) @initpure WSAStartup(version: u16, data: *u8) i32;
  fn @c(system) @initpure WSASocketW(af: i32, kind: i32, proto: i32, info: *u8, g: u32, flags: u32) usize;
  fn @c(system) @initpure WSAGetLastError() i32;
  fn @c(system) @initpure WSAIoctl(s: usize, code: u32, inBuf: *u8, inLen: u32, outBuf: *u8, outLen: u32,
      returned: &mut u32, ov: *u8, completion: *u8) i32;
  fn @c(system) WSARecv(s: usize, bufs: *WsaBuf, count: u32, received: *u32, flags: &mut u32,
      ov: *u8, completion: *u8) i32;
  fn @c(system) WSASend(s: usize, bufs: *WsaBuf, count: u32, sent: *u32, flags: u32,
      ov: *u8, completion: *u8) i32;
  fn @c(system) WSARecvFrom(s: usize, bufs: *WsaBuf, count: u32, received: *u32, flags: &mut u32,
      from: *u8, fromLen: &mut i32, ov: *u8, completion: *u8) i32;
  fn @c(system) WSASendTo(s: usize, bufs: *WsaBuf, count: u32, sent: *u32, flags: u32,
      to: *u8, toLen: i32, ov: *u8, completion: *u8) i32;
  fn @c(system) @initpure closesocket(s: usize) i32;
  fn @c(system) bind(s: usize, addr: *u8, len: i32) i32;
  fn @c(system) listen(s: usize, backlog: i32) i32;
  fn @c(system) getsockname(s: usize, addr: *u8, len: &mut i32) i32;
  fn @c(system) getpeername(s: usize, addr: *u8, len: &mut i32) i32;
  fn @c(system) shutdown(s: usize, how: i32) i32;
  fn @c(system) setsockopt(s: usize, level: i32, name: i32, val: *u8, len: i32) i32;
  fn @c(system) getsockopt(s: usize, level: i32, name: i32, val: *u8, len: &mut i32) i32;
  fn @c(system) GetAddrInfoW(node: *u16, service: *u16, hints: *AddrInfo, result: &mut *AddrInfo) i32;
  fn @c(system) FreeAddrInfoW(info: *AddrInfo);
}

// ADDRINFOW: one address GetAddrInfoW found, linked to the next
struct AddrInfo {
  pub flags: i32;
  pub family: i32;
  pub socktype: i32;
  pub protocol: i32;
  pub addrlen: usize;
  pub canonname: *u16;
  pub addr: *u8;
  pub next: *AddrInfo;
}

// AcceptEx and ConnectEx, as WSAIoctl hands them out: Windows' functions, so
// references to C-named ones
alias AcceptExFn = &fn @c (listener: usize, accepted: usize, out: *u8, recvLen: u32, localLen: u32,
    remoteLen: u32, got: *u32, ov: *u8) i32;
alias ConnectExFn = &fn @c (s: usize, addr: *u8, len: i32, sendBuf: *u8, sendLen: u32, sent: *u32,
    ov: *u8) i32;

// What a completion's key says it is
const keyIo = 1usize;          // an operation's completion: its OVERLAPPED is its record
const keyTimer = 2usize;       // the high-resolution timer expired
const keyWake = 3usize;        // a waker's wake
const keyPost = 4usize;        // an answer posted by another loop: its block
const keyCancel = 5usize;      // a Request's cancel: the operation's id, as the pointer
const keyGroup = 6usize;       // a cancel group this loop has operations in was cancelled
const keyJob = 7usize;         // a job has run (a pool job, an external operation): its record

const invalidHandle = 0xFFFFFFFFFFFFFFFFusize;     // INVALID_HANDLE_VALUE, INVALID_SOCKET
const infinite = 0xFFFFFFFFu32;                     // INFINITE

// NTSTATUS values an operation ends with
const statusSuccess = 0usize;
const statusCancelled = 0xC0000120usize;            // STATUS_CANCELLED
const statusEndOfFile = 0xC0000011usize;            // STATUS_END_OF_FILE
const statusInvalidBufferSize = 0xC0000206usize;    // STATUS_INVALID_BUFFER_SIZE: a datagram too large to send
const statusBufferOverflow = 0x80000005usize;       // STATUS_BUFFER_OVERFLOW: a datagram longer than the buffer

// Windows' error numbers iocore gives or reads
pub const errorFileNotFound = 2u32;                 // ERROR_FILE_NOT_FOUND
pub const errorHandleEof = 38u32;                   // ERROR_HANDLE_EOF
pub const errorBusy = 170u32;                       // ERROR_BUSY: a lane's queue is full
pub const errorInvalidParameter = 87u32;            // ERROR_INVALID_PARAMETER
pub const errorInsufficientBuffer = 122u32;         // ERROR_INSUFFICIENT_BUFFER
const errorNotEnoughMemory = 8u32;                  // ERROR_NOT_ENOUGH_MEMORY
pub const errorInvalidHandle = 6u32;                // ERROR_INVALID_HANDLE
pub const errorOperationAborted = 995u32;           // ERROR_OPERATION_ABORTED
pub const errorIoPending = 997u32;                  // ERROR_IO_PENDING
pub const errorNotFound = 1168u32;                  // ERROR_NOT_FOUND
pub const errorConnectionRefused = 1225u32;         // ERROR_CONNECTION_REFUSED
pub const errorNetnameDeleted = 64u32;              // ERROR_NETNAME_DELETED: how a receive or send reads a reset
pub const errorNoUnicodeTranslation = 1113u32;      // ERROR_NO_UNICODE_TRANSLATION
pub const errorMsgSize = 10040u32;                  // WSAEMSGSIZE: a datagram longer than the buffer that took it (EMSGSIZE)

// Files
const genericRead = 0x80000000u32;
const genericWrite = 0x40000000u32;
const shareAll = 7u32;                              // FILE_SHARE_READ | WRITE | DELETE
const createAlways = 2u32;
const openExisting = 3u32;
const openAlways = 4u32;
const flagOverlapped = 0x40000000u32;               // FILE_FLAG_OVERLAPPED

// The timer
const timerHighResolution = 2u32;                   // CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
const timerAllAccess = 0x1F0003u32;                 // TIMER_ALL_ACCESS
const genericAll = 0x10000000u32;                   // GENERIC_ALL

// Sockets
const afInet = 2i32;
const afInet6 = 23i32;
const sockStream = 1i32;
const sockDgram = 2i32;                             // the same number on Linux
const ipprotoTcp = 6i32;
const ipprotoUdp = 17i32;
const sioUdpConnReset = 0x9800000Cu32;              // SIO_UDP_CONNRESET
const wsaFlagOverlapped = 0x01u32;
const wsaFlagNoHandleInherit = 0x80u32;
const solSocket = 0xFFFFi32;
const soUpdateAcceptContext = 0x700Bi32;
const soUpdateConnectContext = 0x7010i32;
const tcpNoDelay = 1i32;
const soKeepAlive = 0x0008i32;                      // SO_KEEPALIVE
const tcpKeepIdle = 3i32;                           // TCP_KEEPIDLE, seconds (Windows 10 1709 on)
const tcpKeepCnt = 16i32;                           // TCP_KEEPCNT
const tcpKeepIntvl = 17i32;                         // TCP_KEEPINTVL, seconds
const soLinger = 0x0080i32;
const sdSend = 1i32;                                // SD_SEND: shutdown's sending side
const sioGetExtensionFunctionPointer = 0xC8000006u32;

// AcceptEx's room for each address: the largest sockaddr (sockaddr_in6, 28
// bytes) and 16, as its documentation asks
const acceptAddrLen = 44u32;

// UTF-8 and UTF-16
const utf8Page = 65001u32;                          // CP_UTF8
const invalidUtf8Fails = 8u32;                      // MB_ERR_INVALID_CHARS
const formatFromSystem = 0x1200u32;                 // FORMAT_MESSAGE_FROM_SYSTEM | IGNORE_INSERTS
const english = 0x409u32;

// ---------------------------------------------------------------------------
// Winsock's start, once per process, and its two extension functions
// ---------------------------------------------------------------------------

// What Winsock's start gave: AcceptEx's and ConnectEx's addresses (0 if it did
// not get them) and the error that stopped it, 0 if none. Set in the module's
// 'init' (iocore.cone) from 'startWinsock', and only read after
struct WinsockStart {
  acceptEx: usize;
  connectEx: usize;
  error: u32;
}

let acceptExAddr: usize;
let connectExAddr: usize;
let startError: u32;

// WSAStartup, then AcceptEx's and ConnectEx's addresses, asked of a socket
// made for the purpose. Run by the module's 'init', so every program that
// imports iocore has Winsock started before its 'main' and no loop starts it
fn @initpure startWinsock() WinsockStart {
  if isWindows() {
    var data = Array[u64, 64]() <- fill 0u64;     // WSADATA, 512 bytes
    let r = WSAStartup(0x0202u16, &mut data as *u8);
    if r != 0i32 {
      return WinsockStart(0usize, 0usize, u32.from(r));
    }
    let s = WSASocketW(afInet, sockStream, ipprotoTcp, null, 0u32, wsaFlagOverlapped | wsaFlagNoHandleInherit);
    if s == invalidHandle {
      return WinsockStart(0usize, 0usize, u32.from(WSAGetLastError()));
    }
    // WSAID_ACCEPTEX and WSAID_CONNECTEX
    var accept = Guid(0xb5367df1u32, 0xcbacu16, 0x11cfu16, Array[u8, 8]() <- fill 0u8);
    accept.d[0usize] = 0x95u8; accept.d[1usize] = 0xcau8; accept.d[2usize] = 0x00u8; accept.d[3usize] = 0x80u8;
    accept.d[4usize] = 0x5fu8; accept.d[5usize] = 0x48u8; accept.d[6usize] = 0xa1u8; accept.d[7usize] = 0x92u8;
    var connect = Guid(0x25a207b9u32, 0xddf3u16, 0x4660u16, Array[u8, 8]() <- fill 0u8);
    connect.d[0usize] = 0x8eu8; connect.d[1usize] = 0xe9u8; connect.d[2usize] = 0x76u8; connect.d[3usize] = 0xe5u8;
    connect.d[4usize] = 0x8cu8; connect.d[5usize] = 0x74u8; connect.d[6usize] = 0x06u8; connect.d[7usize] = 0x3eu8;
    var got = 0u32;
    var fa = 0usize;
    var fc = 0usize;
    let ra = WSAIoctl(s, sioGetExtensionFunctionPointer, &mut accept as *u8, 16u32,
      &mut fa as *u8, 8u32, &mut got, null, null);
    let rc = WSAIoctl(s, sioGetExtensionFunctionPointer, &mut connect as *u8, 16u32,
      &mut fc as *u8, 8u32, &mut got, null, null);
    var err = 0u32;
    if ra != 0i32 || rc != 0i32 {
      err = u32.from(WSAGetLastError());
    }
    closesocket(s);
    return WinsockStart(fa, fc, err);
  }
  WinsockStart(0usize, 0usize, 0u32)
}

// Winsock started: 0, or the error that stopped it
fn winsock() u32 {
  startError
}

// The OS's wait made. Windows: Winsock started and a completion port made.
// Linux: an epoll instance, an eventfd to wake it by and a timerfd to end its
// wait on time (linux.cone). The error number that stopped it and zeros, or
// 0 and the port (the epoll instance), and the wake and timer descriptors,
// which are zero on Windows
fn openPort() u32, usize, usize, usize {
  if isWindows() {
    let ws = winsock();
    if ws != 0u32 {return ws, 0usize, 0usize, 0usize;}
    let port = CreateIoCompletionPort(invalidHandle, 0usize, 0usize, 1u32);
    if port == 0usize {return GetLastError(), 0usize, 0usize, 0usize;}
    return 0u32, port, 0usize, 0usize;
  } else {
    return lxOpen();
  }
  0u32, 0usize, 0usize, 0usize
}

// A new TCP socket for the family; invalidHandle on failure. Windows:
// overlapped and not inherited by children. Linux: non-blocking and close-on-exec
fn tcpSocket(family: u16) usize {
  if isWindows() {
    WSASocketW(i32.from(family), sockStream, ipprotoTcp, null, 0u32, wsaFlagOverlapped | wsaFlagNoHandleInherit)
  } else {
    let s = sysSocket(i32.from(family), sockStreamLx | nonBlock | epollCloexec, 0i32);
    if s < 0i32 {invalidHandle} else {usize.from(s)}
  }
}

// A new UDP socket for the family; invalidHandle on failure. As tcpSocket
fn udpSocket(family: u16) usize {
  if isWindows() {
    WSASocketW(i32.from(family), sockDgram, ipprotoUdp, null, 0u32, wsaFlagOverlapped | wsaFlagNoHandleInherit)
  } else {
    let s = sysSocket(i32.from(family), sockDgram | nonBlock | epollCloexec, 0i32);
    if s < 0i32 {invalidHandle} else {usize.from(s)}
  }
}

// Nagle's algorithm off: a small send goes at once
fn noDelay(s: usize) {
  var one = 1i32;
  setsockopt(s, ipprotoTcp, tcpNoDelay, &mut one as *u8, 4i32);
}

// LINGER: on, with a time of 0, makes closesocket abortive: the connection
// is reset (RST) rather than finished (FIN), and what was not sent is dropped
struct Linger {
  pub onoff: u16;
  pub secs: u16;
}

// Close s abortively: its peer sees the connection reset
fn resetSocket(s: usize) {
  if isWindows() {
    var l = Linger(1u16, 0u16);
    setsockopt(s, solSocket, soLinger, &mut l as *u8, 4i32);
    closesocket(s);
  } else {
    var l = LingerLx(1i32, 0i32);
    setsockopt(s, solSocketLx, soLingerLx, &mut l as *u8, 8i32);
    sysClose(fdOf(s));
  }
}

// Close what the OS gave for a handle of kind: a file, or a socket
fn closeRaw(kind: u32, raw: usize) {
  if isWindows() {
    if kind == hFile {CloseHandle(raw);} else {closesocket(raw);}
  } else {
    sysClose(fdOf(raw));
  }
}

// The last Winsock error (Linux: errno), as a Windows error number
fn wsaError() u32 {
  if isWindows() {u32.from(WSAGetLastError())} else {errnoCode(lastErrno())}
}

// ---------------------------------------------------------------------------
// Text
// ---------------------------------------------------------------------------

// s as UTF-16 ending in a 0, in a block from libc's malloc the caller frees;
// a null pointer when s is not UTF-8
// The same, in 'room' (of 'cap' u16s) when it fits, so that nothing is
// allocated (the pool's work, with a room on its stack); else in a block from
// malloc. The caller lets it go with 'unwiden'
fn widenIn(s: &Array[u8], room: *u16, cap: usize) *u16 {
  if isWindows() {
    if s.len == 0usize || s.len > 0x3FFFFFFFusize {return null;}
    let len = i32.from(s.len);
    let n = MultiByteToWideChar(utf8Page, invalidUtf8Fails, s as *u8, len, null, 0i32);
    if n == 0i32 {return null;}
    let count = usize.from(n);
    var p = room;
    if count + 1usize > cap {p = libc.malloc((count + 1usize) * 2usize) as *u16;}
    MultiByteToWideChar(utf8Page, invalidUtf8Fails, s as *u8, len, p, n);
    *(p + count) = 0u16;
    p
  } else {
    null
  }
}

// What widenIn made let go: freed unless it is the room
fn unwiden(w: *u16, room: *u16) {
  if w as usize != room as usize {libc.free(w as *u8);}
}

fn widen(s: &Array[u8]) *u16 {
  if isWindows() {
    if s.len == 0usize || s.len > 0x3FFFFFFFusize {return null;}
    let len = i32.from(s.len);
    let n = MultiByteToWideChar(utf8Page, invalidUtf8Fails, s as *u8, len, null, 0i32);
    if n == 0i32 {return null;}
    let count = usize.from(n);
    let p = libc.malloc((count + 1usize) * 2usize) as *u16;
    MultiByteToWideChar(utf8Page, invalidUtf8Fails, s as *u8, len, p, n);
    *(p + count) = 0u16;
    p
  } else {
    null
  }
}

// The OS's text for an error number. Windows: in English where the system
// has it, with no line end or full stop; 'Windows error N' where it has none.
// Linux: the C library's, for the errno the number stands for
fn systemText(code: u32) String {
  if isWindows() {
    var buf = Array[u16, 512]() <- fill 0u16;
    let bp: *u16 = &[]buf as *u16;
    var n = FormatMessageW(formatFromSystem, null, code, english, bp, 512u32, null);
    if n == 0u32 {
      n = FormatMessageW(formatFromSystem, null, code, 0u32, bp, 512u32, null);
    }
    var out = String.empty();
    if n == 0u32 {
      out.append("Windows error ");
      out.appendUInt(u64.from(code));
      return out;
    }
    let size = WideCharToMultiByte(utf8Page, 0u32, bp, i32.from(n), null, 0i32, null, null);
    if size > 0i32 {
      let text = libc.malloc(usize.from(size));
      WideCharToMultiByte(utf8Page, 0u32, bp, i32.from(n), text, size, null, null);
      out.appendBytes(mem.sliceFromParts(text, usize.from(size)));
      libc.free(text);
    }
    let trimmed = out.trim();
    if trimmed.endsWith(".") {
      return trimmed.sub(0usize, trimmed.len() - 1usize);
    }
    trimmed
  } else {
    lxSystemText(code)
  }
}
