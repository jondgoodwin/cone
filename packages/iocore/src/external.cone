// External operations: an operation whose answer comes from outside the
// kernel and the pool -- another thread, a GPU fence's watcher, a library
// with callbacks of its own -- delivered into the loop as any answer is,
// under the same contract (see the package's header, EXTERNAL OPERATIONS).
//
// How it is built. 'lp.external' makes a record in flight, as any
// operation's, and sends it away at once as a job no lane holds (pool.cone):
// the Completer holds the record's address, and with it the record's job part
// and its buffer. Ending it writes the outcome into the record and posts the
// record home (keyJob), exactly as a lane's thread posts a job that has run,
// so everything the loop does with a job's answer -- a cancel asked while it
// runs, a deadline and its prompt TimedOut, a record answered early and left
// until it is home, a loop that has died -- holds for it unchanged. The loop's
// cancel sets the record's 'jasked' flag, which the completer may read.

// The other side of an external operation: whoever holds it ends the
// operation, once, from any thread. A move type, Sendable; its death
// without an ending ends the operation Failed, ERROR_OPERATION_ABORTED (Linux's
// ECANCELED: IoError.aborted()), so the operation still answers exactly once. It declares Sendable, a promise
// taken on trust, for its record's raw pointer: the record's job part and its
// buffer are its alone until it ends the operation (the record is away, and
// keeps its pool while it is), but for the 'jasked' flag, an atomic the loop
// sets
pub struct Completer is Move, Sendable {
  rec: *OpCore;
  op: OpId;
  waker: Waker;

  // The operation it ends
  pub fn id(self: &) OpId {op}

  // Whether it can still end its operation: false once it has, or when the
  // operation was answered at submit (its group cancelled, its deadline
  // past) and nothing is left to end
  pub fn isLive(self: &) bool {rec as usize != 0usize}

  // Whether the operation's cancel has been asked (by lp.cancel, a Request,
  // its group, or its deadline): a watcher that can stop early ends it
  // with 'cancelled()'. The answer is still the completer's to give
  pub fn isCancelRequested(self: &) bool {
    if rec as usize == 0usize {return false;}
    (*rec).jasked.load() != 0u32
  }

  // The buffer lent with the operation, to write into before ending it. A
  // panic, at the caller's line, once it has ended
  pub fn buf(self: &mut, file: &Array[u8] = srcFile(), line: u32 = srcLine()) &mut IoBuf {
    if rec as usize == 0usize {panic("iocore: Completer.buf after its operation ended", file, line);}
    // An external operation's record always holds its buffer (IoBuf.empty()
    // when it was lent none)
    let r = rec as &mut OpCore;
    match &mut r.buf {
      case var &mut Some(b) {return b;}
      else {}
    }
    panic("iocore: Completer.buf of a record with no buffer", file, line)
  }

  // End it Done, with a count (bytes, or any number: a fence's value)
  pub fn done(self: &mut, n: usize) bool {self.end(Outcome.Done(n))}

  // End it Failed, with an error number
  pub fn fail(self: &mut, code: u32) bool {self.end(Outcome.Failed(code))}

  // End it Cancelled: the completer stopped because the cancel was asked
  pub fn cancelled(self: &mut) bool {self.end(Outcome.Cancelled)}

  // End it as o: true once the ending is on its way to the loop; false if
  // it had ended already, or the loop has gone (its buffer then goes home)
  pub fn end(self: &mut, o: Outcome) bool {
    if rec as usize == 0usize {return false;}
    let p = rec;
    rec = null;
    let alive = !waker.isGone();
    settleJob(p, o);
    alive
  }

  fn final(self: &uni) {
    if rec as usize != 0usize {
      let p = rec;
      rec = null;
      settleJob(p, Outcome.Failed(abandoned()));
    }
  }
}
