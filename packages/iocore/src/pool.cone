// The blocking pool: threads for work that has no completion form -- a
// file's metadata, opening a file, a name looked up in DNS -- whose answers
// come back into the loop that asked, as the kernel's do (see the package's
// header, THE BLOCKING POOL).
//
// How it is built. One pool for the process, in lanes. A lane is a queue
// and the threads that serve it, under one lock: a FIFO of jobs, linked
// both ways so a cancel takes a queued job out in O(1); a bound on its
// length, past which a submit is refused (I9); and between 'minThreads' and
// 'maxThreads' threads, started as jobs arrive while more are queued than
// there are threads idle, and leaving after 'idle' with nothing to do, down
// to 'minThreads'. A job is its RECORD, nothing more (record.cone): the
// record's job part holds the work's outcome, its queue links, its state and
// its cancel flag, and a waker of its loop. The lane's queue links records,
// and its thread is handed the record's address: it runs the work on the
// record's own buffer, in place, as the kernel does an operation, writes the
// outcome into the record, lets the record's waker go (keeping a copy to post
// with) and posts the record's address to the loop's port (keyJob) -- so a
// record in the port's queue holds no owner of the port, and a port whose
// loop has died is freed by the last waker, which takes back what is still
// queued. Nothing is allocated for a job.
//
// While a record is away (queued, or with the lane's thread, until it is
// posted home) its job part and its buffer are the pool's thread's; the loop
// touches only the cancel flag, and the queue links under the lane's lock (to
// take a job still queued back out). The lane's lock decides between a
// thread taking a queued job and the loop's cancel removing it: whichever
// takes the lock first. The loop does not wait for a job that is running at
// its death: it lets the record go, and the record keeps its pool alive
// (record.cone: one hold for each record away); when its thread finds the
// loop gone it dissolves the record there, its buffer going home, and lets go
// of its hold, which frees the pool if it was the last.
//
// The lanes live as long as the process; their threads are detached, and
// wait on the lane's Condvar while there is nothing to do.

// Work for the pool: run on one of a lane's threads, given the operation's
// argument and its buffer, answering how it went (Done with a count, or
// Failed with an error number)
pub alias WorkFn = &fn(arg: u64, buf: &mut IoBuf) Outcome;

fn noWork(arg: u64, buf: &mut IoBuf) Outcome {Outcome.Done(0usize)}

// Whether an operation of kind k is a job: a pool job, or an external
// operation; on Linux a file operation too, which is a job of the pool
// (linux.cone)
fn jobKind(k: u32) bool {
  k == diag.kindCall || k == diag.kindExternal
    || (!isWindows() && (k == diag.kindReadAt || k == diag.kindWriteAt))
}

// Record p's job goes away: it is given a waker of its loop to post it home
// with, and holds its pool (record.cone) until it is home. For an external
// operation, whose Completer holds it from now on
fn sendAway(p: *OpCore, w: Waker, state: u32) {
  let r = p as &mut OpCore;
  r.waker = Some[Waker](w);
  r.jstatus = 0u32;
  r.jn = 0usize;
  r.jcode = 0u32;
  r.jasked.store(0u32);
  holdPool(r.home);
  r.jstate.store(state);
}

// Record p's job is home, or was never run (taken out of its queue, or refused
// by it): its waker, if it still has one, goes, a Linux file job's descriptor
// is closed, and its hold on its pool goes. On the loop's thread
fn bringHome(p: *OpCore) {
  let r = p as &mut OpCore;
  r.jstate.store(jobHome);
  r.waker = None;
  if !isWindows() && r.jfd >= 0i32 {
    sysClose(r.jfd);
    r.jfd = 0i32 - 1i32;
  }
  releasePool(r.home);
}

// ---------------------------------------------------------------------------
// Lanes
// ---------------------------------------------------------------------------

// A lane of the blocking pool (see the package's header, THE BLOCKING POOL)
pub struct Lane {
  pub id: u32;

  // General work: up to 4 threads, 1,024 queued
  pub fn general() Lane {Lane(0u32)}
  // Names looked up: up to 2 threads, 256 queued, so a slow resolver holds
  // up only other look-ups
  pub fn dns() Lane {Lane(1u32)}

  // Its counters, as they are now
  pub fn stats(self) LaneStats {
    let l = laneAt(id);
    if l as usize == 0usize {return LaneStats.zero();}
    let s = l as &mut LaneState;
    s.lock.lock();
    let st = LaneStats(s.queued, s.maxQueued, s.running, s.threads, s.maxThreads,
      s.started, s.ran, s.cancelled, s.refused, s.waitNs, s.maxWaitNs);
    s.lock.unlock();
    st
  }
}

// How a lane is made: its name (its threads', for a debugger), its threads
// at least and at most, the jobs it queues at most, and how long a thread
// beyond the least waits idle before it leaves
pub struct LaneConfig {
  pub name: &str = "iocore";
  pub minThreads: u32 = 0u32;
  pub maxThreads: u32 = 4u32;
  pub queueBound: u32 = 1024u32;
  pub idleMillis: u32 = 10000u32;
}

// A lane's counters
pub struct LaneStats {
  pub queued: u32;         // jobs waiting now
  pub maxQueued: u32;      // the most ever waiting at once: the queue depth
  pub running: u32;        // jobs running now
  pub threads: u32;        // threads now
  pub maxThreads: u32;
  pub started: u64;        // threads ever started
  pub ran: u64;            // jobs run
  pub cancelled: u64;      // jobs taken out of the queue by a cancel, never run
  pub refused: u64;        // submits refused: the queue was full
  pub waitNs: u64;         // nanoseconds jobs spent queued, in all
  pub maxWaitNs: u64;      // the longest a job was queued

  pub fn zero() LaneStats {
    LaneStats(0u32, 0u32, 0u32, 0u32, 0u32, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64)
  }
}

// A lane: its queue, its threads and its counts, under its lock. Plain
// memory from libc's malloc, never freed
struct LaneState {
  lock: Mutex;
  ready: Condvar;          // its idle threads wait here
  head: *OpCore;           // the records queued, linked by their 'jprev' and 'jnext'
  tail: *OpCore;
  queued: u32;
  maxQueued: u32;
  bound: u32;
  threads: u32;
  idle: u32;               // threads waiting on 'ready'
  running: u32;
  minThreads: u32;
  maxThreads: u32;
  idleFor: Duration;
  started: u64;
  ran: u64;
  cancelled: u64;
  refused: u64;
  waitNs: u64;
  maxWaitNs: u64;
  name: Array[u8, 32];
  nameLen: usize;
}

const maxLanes = 64u32;

// The lanes' registry. Any loop's thread and the lanes' own workers reach it:
// the table is made, and the default lanes in it, in the module's 'init'
// (iocore.cone); a lane added later is put in under laneLock, and entries are
// read without the lock, so the count is an atomic and the table's address one,
// both held by 'let' globals
let laneLock: Mutex;
let laneTable: Atomic[*usize];
let laneCount: Atomic[u32];

// The two lanes every process has (three on Linux), made by 'init' before any
// thread can reach them. A lane keeps no thread until it has work, so this
// starts none
fn @initpure makeDefaultLanes() {
  addLaneLocked(LaneConfig(name: "iocore general", maxThreads: 4u32, queueBound: 1024u32));
  addLaneLocked(LaneConfig(name: "iocore dns", maxThreads: 2u32, queueBound: 256u32));
  // Linux: the files' own, for ReadAt and WriteAt (linux.cone); its queue is
  // deep, since a refused file operation is no one's to retry
  if !isWindows() {
    addLaneLocked(LaneConfig(name: "iocore files", maxThreads: 4u32, queueBound: 65536u32));
  }
}

// The lane Linux's file operations run on
const filesLane = 2u32;

// A new lane of the blocking pool. At most 64 lanes, the two every process
// has among them; one more is a panic
pub fn addLane(cfg: LaneConfig, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Lane {
  laneLock.lock();
  if laneCount.load() >= maxLanes {
    laneLock.unlock();
    panic("iocore: more than 64 lanes in the blocking pool", file, line);
  }
  let l = addLaneLocked(cfg);
  laneLock.unlock();
  l
}

fn @initpure addLaneLocked(cfg: LaneConfig) Lane {
  let p = libc.malloc(mem.sizeof[LaneState]()) as *LaneState;
  if p as usize == 0usize {panic("iocore: out of memory for a lane");}
  var name = Array[u8, 32]() <- fill 0u8;
  var k = 0usize;
  while k < cfg.name.len() && k < 31usize {
    name[k] = cfg.name[k];
    k = k + 1usize;
  }
  mem.writeRaw[LaneState](p, LaneState(
    lock: Mutex.make(), ready: Condvar.make(), head: null, tail: null,
    queued: 0u32, maxQueued: 0u32, bound: if cfg.queueBound == 0u32 {1u32} else {cfg.queueBound},
    threads: 0u32, idle: 0u32, running: 0u32,
    minThreads: cfg.minThreads,
    maxThreads: if cfg.maxThreads == 0u32 {1u32} else {cfg.maxThreads},
    idleFor: Duration.fromMillis(i64.from(cfg.idleMillis)),
    started: 0u64, ran: 0u64, cancelled: 0u64, refused: 0u64, waitNs: 0u64, maxWaitNs: 0u64,
    name: name, nameLen: k));
  let id = laneCount.load();
  *(laneTable.load() + usize.from(id)) = p as usize;
  laneCount.store(id + 1u32);
  // The threads it keeps even when idle
  let s = p as &mut LaneState;
  var started = 0u32;
  while started < s.minThreads && started < s.maxThreads {
    s.threads = s.threads + 1u32;
    s.started = s.started + 1u64;
    startWorker(p);
    started = started + 1u32;
  }
  Lane(id)
}

// Lane id's state, or null when there is no such lane
fn laneAt(id: u32) *LaneState {
  if id >= maxLanes {return null;}
  *(laneTable.load() + usize.from(id)) as *LaneState
}

// What a lane's thread is handed: its lane. It declares Sendable, a promise
// taken on trust: the lane is reached only under its lock
struct WorkerArg is Sendable {
  lane: *LaneState;
}

fn startWorker(l: *LaneState) {
  let s = l as &mut LaneState;
  let t = thread.startWith(thread.Options(name: &s.name[0usize ..< s.nameLen] as &str),
    WorkerArg(l), &worker);
  t.detach();
}

// A lane's thread: take the oldest job, run it outside the lock, post it
// home; wait while there is none, and leave after the lane's idle time if
// it has more threads than its least
fn worker(a: WorkerArg) {
  let s = a.lane as &mut LaneState;
  s.lock.lock();
  while true {
    if s.head as usize == 0usize {
      s.idle = s.idle + 1u32;
      let signalled = s.ready.condWaitTimeout(&s.lock, s.idleFor);
      s.idle = s.idle - 1u32;
      if s.head as usize == 0usize && !signalled && s.threads > s.minThreads {
        s.threads = s.threads - 1u32;
        s.lock.unlock();
        iobuf.flushThread();     // its buffer cache goes back to the stock: nothing finalizes a '@threadlocal' yet
        return;
      }
      continue;
    }
    let p = s.head;
    unlinkJob(s, p);
    (*p).jstate.store(jobRunning);
    s.running = s.running + 1u32;
    let waited = u64.from((*p).submitted.elapsed().nanos());
    s.waitNs = s.waitNs + waited;
    if waited > s.maxWaitNs {s.maxWaitNs = waited;}
    s.lock.unlock();
    runJob(p);
    s.lock.lock();
    s.running = s.running - 1u32;
    s.ran = s.ran + 1u64;
  }
}

// Run record p's job on the record, in place, and post it home
fn runJob(p: *OpCore) {
  let r = p as &mut OpCore;
  if !isWindows() && r.jfd >= 0i32 {
    settleJob(p, lxFileJob(r));
    return;
  }
  // Work with no buffer of its own is given an empty one, which it may fill
  match &r.buf {
    case is &None[IoBuf] {r.buf = Some[IoBuf](IoBuf.empty());}
    else {}
  }
  var o = Outcome.Failed(badParameter());
  match &mut r.buf {
    case var &mut Some(buf) {o = (r.work)(r.at, buf);}
    else {}
  }
  settleJob(p, o);
}

// Record p's job has ended (a lane's thread, or a Completer): its outcome into
// the record, and the record posted home; dissolved where it is when its loop
// has let go of it (record.cone, homeDead). The record lets its waker go before
// it is posted, so that in the port's queue it holds no owner of the port; the
// copy kept to post with goes after
fn settleJob(p: *OpCore, o: Outcome) {
  let r = p as &mut OpCore;
  match o {
    case let Done(d) {r.jstatus = diag.outcomeDone; r.jn = d.n;}
    case let Failed(f) {r.jstatus = diag.outcomeFailed; r.jcode = f.code;}
    case is Outcome.Cancelled {r.jstatus = diag.outcomeCancelled;}
    case is Outcome.TimedOut {r.jstatus = diag.outcomeTimedOut;}
  }
  let w = r.waker;
  r.waker = None;
  match w {
    case let Some(s) {
      // The port refuses a packet only when its loop has gone, or (Windows)
      // when the system has no room for one: then it is tried again, since a
      // loop that lives still holds the record
      while !s.postJob(p) {
        if s.isGone() {
          homeDead(p);
          return;
        }
        thread.sleep(Duration.fromMillis(1i64));
      }
    }
    else {homeDead(p);}
  }
}

// Take record p out of its lane's queue: its lock is held
fn unlinkJob(s: &mut LaneState, p: *OpCore) {
  let prev = (*p).jprev;
  let next = (*p).jnext;
  if prev as usize == 0usize {s.head = next;} else {(*prev).jnext = next;}
  if next as usize == 0usize {s.tail = prev;} else {(*next).jprev = prev;}
  (*p).jprev = null;
  (*p).jnext = null;
  s.queued = s.queued - 1u32;
}

// Queue record p on lane l: false when the lane's queue is full (counted)
fn enqueueJob(p: *OpCore, l: *LaneState) bool {
  let s = l as &mut LaneState;
  s.lock.lock();
  if s.queued >= s.bound {
    s.refused = s.refused + 1u64;
    s.lock.unlock();
    return false;
  }
  (*p).jprev = s.tail;
  (*p).jnext = null;
  if s.tail as usize == 0usize {s.head = p;} else {(*s.tail).jnext = p;}
  s.tail = p;
  s.queued = s.queued + 1u32;
  if s.queued > s.maxQueued {s.maxQueued = s.queued;}
  if s.idle > 0u32 {s.ready.notifyOne();}
  // More queued than threads idle to take them: one more thread, while the
  // lane may have one
  var grow = false;
  if s.queued > s.idle && s.threads < s.maxThreads {
    s.threads = s.threads + 1u32;
    s.started = s.started + 1u64;
    grow = true;
  }
  s.lock.unlock();
  if grow {startWorker(l);}
  true
}

// Take record p out of its lane's queue, if no thread has taken it yet: true
// when it was taken out (it will never run, and is home). False for an
// external operation's, which no lane holds
fn removeJob(p: *OpCore) bool {
  if (*p).kind == diag.kindExternal {return false;}
  let l = laneAt((*p).lane.id);
  if l as usize == 0usize {return false;}
  let s = l as &mut LaneState;
  s.lock.lock();
  let queued = (*p).jstate.load() == jobQueued;
  if queued {
    unlinkJob(s, p);
    (*p).jstate.store(jobHome);
    s.cancelled = s.cancelled + 1u64;
  }
  s.lock.unlock();
  queued
}

// ---------------------------------------------------------------------------
// Work the pool comes with: a name looked up, a file's metadata, a file read
// ---------------------------------------------------------------------------

// An operation looking host up (a name, or an address as text) on the DNS
// lane: Done(n), buf holding n addresses, each with 'port', for
// 'addressesIn'; Failed with Winsock's error when there are none. buf is
// cleared and holds the name while the work runs
pub fn resolveOp(host: &str, port: u16, buf: IoBuf) Op {
  var b = buf;
  b.clear();
  b.append(host);
  Op.Call(Lane.dns(), &resolveWork, u64.from(port), b)
}

// The addresses a resolveOp's buffer holds
pub fn addressesIn(buf: &IoBuf) List[SocketAddr] {
  var out = List[SocketAddr].empty();
  let n = buf.len() / mem.sizeof[SocketAddr]();
  var k = 0usize;
  while k < n {
    out.push(*((buf.base() as *SocketAddr) + k));
    k = k + 1usize;
  }
  out
}

fn resolveWork(arg: u64, buf: &mut IoBuf) Outcome {
  if isWindows() {
    var wide = Array[u16, 520]() <- fill 0u16;
    let w = widenIn(buf.view(), &mut wide as *u16, 520usize);
    if w as usize == 0usize {return Outcome.Failed(errorNoUnicodeTranslation);}
    var hints = AddrInfo(0i32, 0i32, sockStream, ipprotoTcp, 0usize, null, null, null);
    var res = null as *AddrInfo;
    let rc = GetAddrInfoW(w, null, &mut hints as *AddrInfo, &mut res);
    unwiden(w, &mut wide as *u16);
    if rc != 0i32 {return Outcome.Failed(u32.from(rc));}
    buf.clear();
    var count = 0usize;
    var a = res;
    let recSize = mem.sizeof[SocketAddr]();
    while a as usize != 0usize {
      if (*a).addrlen <= 28usize && buf.room() >= recSize {
        var s = SocketAddr(Array[u8, 28]() <- fill 0u8, i32.from((*a).addrlen));
        libc.memcpy(&mut s.raw as *u8, (*a).addr, (*a).addrlen);
        s.setPort(u16.from(arg));
        buf.append(mem.sliceFromParts(&mut s as *u8, recSize));
        count = count + 1usize;
      }
      a = (*a).next;
    }
    FreeAddrInfoW(res);
    Outcome.Done(count)
  } else {
    lxResolve(arg, buf)
  }
}

// A file's metadata, as a statOp's buffer holds it
pub struct FileStat {
  pub size: u64;
  pub attributes: u32;     // Windows' FILE_ATTRIBUTE_... bits
  pub modified: Timestamp;

  pub fn isDir(self: &) bool {(attributes & 0x10u32) != 0u32}
}

// An operation asking a file's metadata on lane: Done, buf holding it for
// 'fileStatIn'; Failed with Windows' error (ERROR_FILE_NOT_FOUND...). buf
// is cleared and holds the path while the work runs
pub fn statOp(path: &Path, lane: Lane, buf: IoBuf) Op {
  var b = buf;
  b.clear();
  let text: &Array[u8] = path.view();
  b.append(text);
  Op.Call(lane, &statWork, 0u64, b)
}

// The metadata a statOp's buffer holds
pub fn fileStatIn(buf: &IoBuf) FileStat {
  let p = buf.base() as *u32;
  if buf.len() < 36usize {return FileStat(0u64, 0u32, Timestamp.fromUnixNanos(0i64));}
  // WIN32_FILE_ATTRIBUTE_DATA: attributes, three FILETIMEs (the last
  // written the third), the size's high word and its low word
  let written = (u64.from(*(p + 6usize)) << 32u64) | u64.from(*(p + 5usize));
  let size = (u64.from(*(p + 7usize)) << 32u64) | u64.from(*(p + 8usize));
  // A FILETIME counts 100 ns from 1601; 11,644,473,600 s before 1970
  let unix100 = i64.from(written) - 116444736000000000i64;
  FileStat(size, *p, Timestamp.fromUnixNanos(unix100 * 100i64))
}

fn statWork(arg: u64, buf: &mut IoBuf) Outcome {
  if isWindows() {
    var wide = Array[u16, 520]() <- fill 0u16;
    let w = widenIn(buf.view(), &mut wide as *u16, 520usize);
    if w as usize == 0usize {return Outcome.Failed(errorNoUnicodeTranslation);}
    var data = Array[u32, 9]() <- fill 0u32;
    let ok = GetFileAttributesExW(w, 0i32, &mut data as *u8);
    unwiden(w, &mut wide as *u16);
    if ok == 0i32 {return Outcome.Failed(GetLastError());}
    buf.clear();
    buf.append(mem.sliceFromParts(&mut data as *u8, 36usize));
    Outcome.Done(36usize)
  } else {
    lxStat(arg, buf)
  }
}

// An operation reading a file on lane, from byte 'at', as much as buf's
// capacity holds: opened, read and closed by the lane's thread (a file
// read where no completion form is to be had). Done(n), buf holding the n
// bytes; Done(0) past the end. buf is cleared and holds the path while the
// work runs
pub fn readFileOp(path: &Path, at: u64, lane: Lane, buf: IoBuf) Op {
  var b = buf;
  b.clear();
  let text: &Array[u8] = path.view();
  b.append(text);
  Op.Call(lane, &readFileWork, at, b)
}

fn readFileWork(arg: u64, buf: &mut IoBuf) Outcome {
  if isWindows() {
    var wide = Array[u16, 520]() <- fill 0u16;
    let w = widenIn(buf.view(), &mut wide as *u16, 520usize);
    if w as usize == 0usize {return Outcome.Failed(errorNoUnicodeTranslation);}
    let h = CreateFileW(w, genericRead, shareAll, null, openExisting, 0u32, 0usize);
    unwiden(w, &mut wide as *u16);
    if h == invalidHandle {return Outcome.Failed(GetLastError());}
    buf.clear();
    let room = buf.room();
    let want = if room > 0xFFFFFFFFusize {0xFFFFFFFFu32} else {u32.from(room)};
    // A handle opened without FILE_FLAG_OVERLAPPED reads at the OVERLAPPED's
    // offset and returns when the read is done
    var ov = Overlapped(0usize, 0usize, u32.from(arg & 0xFFFFFFFFu64), u32.from(arg >> 32u64), 0usize);
    var got = 0u32;
    let ok = ReadFile(h, buf.base(), want, &mut got as *u32, &mut ov as *u8);
    let code = if ok == 0i32 {GetLastError()} else {0u32};
    CloseHandle(h);
    if ok == 0i32 && code != errorHandleEof {return Outcome.Failed(code);}
    buf.setLen(usize.from(got));
    Outcome.Done(usize.from(got))
  } else {
    lxReadFile(arg, buf)
  }
}
