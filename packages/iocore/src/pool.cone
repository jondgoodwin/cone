// The blocking pool: threads for work that has no completion form -- a
// file's metadata, opening a file, a name looked up in DNS -- whose answers
// come back into the loop that asked, as the kernel's do (see the package's
// header, THE BLOCKING POOL).
//
// How it is built. One pool for the process, in lanes. A lane is a queue
// and the threads that serve it, under one lock: a FIFO of jobs, linked
// both ways so a cancel takes a queued job out in O(1); a bound on its
// length, past which a submit is refused (I9); and between 'minThreads' and
// 'maxThreads' threads, started as jobs arrive while more are queued than
// there are threads idle, and leaving after 'idle' with nothing to do, down
// to 'minThreads'. A job is a JobBox, allocated by the loop at submit,
// holding the work, its argument, its buffer, and a waker of its loop: a
// lane's thread runs the work outside the lock, takes the waker out of the
// box, and posts the box to the loop's port (keyJob) -- so a box in the
// port's queue holds no owner of the port, and a port whose loop has died
// is freed by the last waker, which takes back what is still queued. The
// box is self-contained: a thread never touches the loop's table, so a job
// answered already (a prompt TimedOut) or owed to a loop that has died is
// simply dropped when it comes back, its buffer going home. While a job is
// queued, the lane's lock decides between a thread taking it and the loop's
// cancel removing it: whichever takes the lock first.
//
// The lanes live as long as the process; their threads are detached, and
// wait on the lane's Condvar while there is nothing to do.

// Work for the pool: run on one of a lane's threads, given the operation's
// argument and its buffer, answering how it went (Done with a count, or
// Failed with an error number)
pub alias WorkFn = &fn(arg u64, buf &mut IoBuf) Outcome;

fn noWork(arg u64, buf &mut IoBuf) Outcome {Outcome.Done[0usize];}

const boxQueued = 0u32;
const boxRunning = 1u32;
const boxRemoved = 2u32;

// One job, from its submit until its answer (see above). Plain memory from
// libc's malloc
struct JobBox {
  work WorkFn;
  arg u64;
  buf IoBuf;
  waker Option[Waker];    // taken out by the thread before it posts the box
  rec u32;                // the record it answers, and the record's generation
  gen u32;
  lane *LaneState;        // null for an external operation's box
  asked Atomic[u32];      // 1 once the loop has asked the cancel: an external completer reads it
  state u32;              // boxQueued, boxRunning, boxRemoved: under the lane's lock
  status u32;             // how the work went
  n usize;
  code u32;
  prev *JobBox;
  next *JobBox;
  queuedAt Instant;
}

fn newBox(work WorkFn, arg u64, w Waker, rec u32, gen u32, lane *LaneState) *JobBox {
  imm b = libc.malloc(mem.sizeof[JobBox]()) as *JobBox;
  if b as usize == 0usize {panic("iocore: out of memory for a blocking job");}
  mem.writeRaw[JobBox](b, new JobBox(work: work, arg: arg, buf: IoBuf.empty(),
    waker: Some[Waker][w], rec: rec, gen: gen, lane: lane, asked: Atomic[u32].of(0u32), state: boxQueued,
    status: 0u32, n: 0usize, code: 0u32, prev: null, next: null, queuedAt: Instant.now()));
  b;
}

// A box's end: its buffer goes home, its waker (if it still has one) goes
fn dropBox(b *JobBox) {
  mem.finalize[JobBox](b);
  libc.free(b as *u8);
}

// ---------------------------------------------------------------------------
// Lanes
// ---------------------------------------------------------------------------

// A lane of the blocking pool (see the package's header, THE BLOCKING POOL)
pub struct Lane {
  pub id u32;

  // General work: up to 4 threads, 1,024 queued
  pub fn general() Lane {lanesReady(); new Lane(0u32);}
  // Names looked up: up to 2 threads, 256 queued, so a slow resolver holds
  // up only other look-ups
  pub fn dns() Lane {lanesReady(); new Lane(1u32);}

  // Its counters, as they are now
  pub fn stats(self) LaneStats {
    imm l = laneAt(id);
    if l as usize == 0usize {return LaneStats.zero();}
    imm s = l as &mut LaneState;
    s.lock.lock();
    imm st = new LaneStats(s.queued, s.maxQueued, s.running, s.threads, s.maxThreads,
      s.started, s.ran, s.cancelled, s.refused, s.waitNs, s.maxWaitNs);
    s.lock.unlock();
    st;
  }
}

// How a lane is made: its name (its threads', for a debugger), its threads
// at least and at most, the jobs it queues at most, and how long a thread
// beyond the least waits idle before it leaves
pub struct LaneConfig {
  pub name &Array[u8] = "iocore";
  pub minThreads u32 = 0u32;
  pub maxThreads u32 = 4u32;
  pub queueBound u32 = 1024u32;
  pub idleMillis u32 = 10000u32;
}

// A lane's counters
pub struct LaneStats {
  pub queued u32;         // jobs waiting now
  pub maxQueued u32;      // the most ever waiting at once: the queue depth
  pub running u32;        // jobs running now
  pub threads u32;        // threads now
  pub maxThreads u32;
  pub started u64;        // threads ever started
  pub ran u64;            // jobs run
  pub cancelled u64;      // jobs taken out of the queue by a cancel, never run
  pub refused u64;        // submits refused: the queue was full
  pub waitNs u64;         // nanoseconds jobs spent queued, in all
  pub maxWaitNs u64;      // the longest a job was queued

  pub fn zero() LaneStats {
    new LaneStats(0u32, 0u32, 0u32, 0u32, 0u32, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
  }
}

// A lane: its queue, its threads and its counts, under its lock. Plain
// memory from libc's malloc, never freed
struct LaneState {
  lock Mutex;
  ready Condvar;          // its idle threads wait here
  head *JobBox;
  tail *JobBox;
  queued u32;
  maxQueued u32;
  bound u32;
  threads u32;
  idle u32;               // threads waiting on 'ready'
  running u32;
  minThreads u32;
  maxThreads u32;
  idleFor Duration;
  started u64;
  ran u64;
  cancelled u64;
  refused u64;
  waitNs u64;
  maxWaitNs u64;
  name Array[u8, 32];
  nameLen usize;
}

const maxLanes = 64u32;

imm laneOnce Once;
imm laneLock Mutex;
mut laneTable *usize = null;
mut laneCount u32 = 0u32;

// The two lanes every process has, made once
fn lanesReady() {
  laneOnce.callOnce(&makeDefaultLanes);
}

fn makeDefaultLanes() {
  laneTable = libc.calloc(usize.from(maxLanes), 8usize) as *usize;
  addLaneLocked(new LaneConfig(name: "iocore general", maxThreads: 4u32, queueBound: 1024u32));
  addLaneLocked(new LaneConfig(name: "iocore dns", maxThreads: 2u32, queueBound: 256u32));
}

// A new lane of the blocking pool. At most 64 lanes, the two every process
// has among them; one more is a panic
pub fn addLane(cfg LaneConfig, file &Array[u8] = srcFile(), line u32 = srcLine()) Lane {
  lanesReady();
  laneLock.lock();
  if laneCount >= maxLanes {
    laneLock.unlock();
    panic("iocore: more than 64 lanes in the blocking pool", file, line);
  }
  imm l = addLaneLocked(cfg);
  laneLock.unlock();
  l;
}

fn addLaneLocked(cfg LaneConfig) Lane {
  imm p = libc.malloc(mem.sizeof[LaneState]()) as *LaneState;
  if p as usize == 0usize {panic("iocore: out of memory for a lane");}
  mut name = new Array[u8, 32] <- fill 0u8;
  mut k = 0usize;
  while k < cfg.name.len and k < 31usize {
    name[k] = cfg.name[k];
    k = k + 1usize;
  }
  mem.writeRaw[LaneState](p, new LaneState(
    lock: Mutex.make(), ready: Condvar.make(), head: null, tail: null,
    queued: 0u32, maxQueued: 0u32, bound: if cfg.queueBound == 0u32 {1u32;} else {cfg.queueBound;},
    threads: 0u32, idle: 0u32, running: 0u32,
    minThreads: cfg.minThreads,
    maxThreads: if cfg.maxThreads == 0u32 {1u32;} else {cfg.maxThreads;},
    idleFor: Duration.fromMillis(i64.from(cfg.idleMillis)),
    started: 0u64, ran: 0u64, cancelled: 0u64, refused: 0u64, waitNs: 0u64, maxWaitNs: 0u64,
    name: name, nameLen: k));
  imm id = laneCount;
  *(laneTable + usize.from(id)) = p as usize;
  laneCount = laneCount + 1u32;
  // The threads it keeps even when idle
  imm s = p as &mut LaneState;
  mut started = 0u32;
  while started < s.minThreads and started < s.maxThreads {
    s.threads = s.threads + 1u32;
    s.started = s.started + 1u64;
    startWorker(p);
    started = started + 1u32;
  }
  new Lane(id);
}

// Lane id's state, or null when there is no such lane
fn laneAt(id u32) *LaneState {
  lanesReady();
  if id >= maxLanes {return null;}
  *(laneTable + usize.from(id)) as *LaneState;
}

// What a lane's thread is handed: its lane. It declares Sendable, a promise
// taken on trust: the lane is reached only under its lock
struct WorkerArg is Sendable {
  lane *LaneState;
}

fn startWorker(l *LaneState) {
  imm s = l as &mut LaneState;
  imm t = thread.startWith(new thread.Options(name: &s.name[0usize .. s.nameLen]),
    new WorkerArg(l), &worker);
  t.detach();
}

// A lane's thread: take the oldest job, run it outside the lock, post it
// home; wait while there is none, and leave after the lane's idle time if
// it has more threads than its least
fn worker(a WorkerArg) {
  imm s = a.lane as &mut LaneState;
  s.lock.lock();
  while true {
    if s.head as usize == 0usize {
      s.idle = s.idle + 1u32;
      imm signalled = s.ready.condWaitTimeout(&s.lock, s.idleFor);
      s.idle = s.idle - 1u32;
      if s.head as usize == 0usize and not signalled and s.threads > s.minThreads {
        s.threads = s.threads - 1u32;
        s.lock.unlock();
        return;
      }
      continue;
    }
    imm b = s.head;
    unlinkBox(s, b);
    (*b).state = boxRunning;
    s.running = s.running + 1u32;
    imm waited = u64.from((*b).queuedAt.elapsed().nanos());
    s.waitNs = s.waitNs + waited;
    if waited > s.maxWaitNs {s.maxWaitNs = waited;}
    s.lock.unlock();
    runBox(b);
    s.lock.lock();
    s.running = s.running - 1u32;
    s.ran = s.ran + 1u64;
  }
}

// Run a job and post it to its loop; drop it when its loop has gone
fn runBox(b *JobBox) {
  imm j = b as &mut JobBox;
  imm o = (j.work)(j.arg, &mut j.buf);
  settleBox(b, o);
}

// A box's outcome is known: post it to its loop, or drop it when its loop
// has gone
fn settleBox(b *JobBox, o Outcome) {
  imm j = b as &mut JobBox;
  match o {
    case imm d Done {j.status = diag.outcomeDone; j.n = d.n;}
    case imm f Failed {j.status = diag.outcomeFailed; j.code = f.code;}
    case is Outcome.Cancelled {j.status = diag.outcomeCancelled;}
    case is Outcome.TimedOut {j.status = diag.outcomeTimedOut;}
  }
  mut w Option[Waker] = None[Waker][];
  w <=> j.waker;
  match w {
    case imm s Some {
      if not s.value.postJob(b) {dropBox(b);}
    }
    else {dropBox(b);}
  }
}

// Take box b out of its lane's queue: its lock is held
fn unlinkBox(s &mut LaneState, b *JobBox) {
  imm prev = (*b).prev;
  imm next = (*b).next;
  if prev as usize == 0usize {s.head = next;} else {(*prev).next = next;}
  if next as usize == 0usize {s.tail = prev;} else {(*next).prev = prev;}
  (*b).prev = null;
  (*b).next = null;
  s.queued = s.queued - 1u32;
}

// Queue box b on its lane: false when the lane's queue is full (counted)
fn enqueueBox(b *JobBox) bool {
  imm l = (*b).lane;
  imm s = l as &mut LaneState;
  s.lock.lock();
  if s.queued >= s.bound {
    s.refused = s.refused + 1u64;
    s.lock.unlock();
    return false;
  }
  (*b).prev = s.tail;
  (*b).next = null;
  if s.tail as usize == 0usize {s.head = b;} else {(*s.tail).next = b;}
  s.tail = b;
  s.queued = s.queued + 1u32;
  if s.queued > s.maxQueued {s.maxQueued = s.queued;}
  if s.idle > 0u32 {s.ready.notifyOne();}
  // More queued than threads idle to take them: one more thread, while the
  // lane may have one
  mut grow = false;
  if s.queued > s.idle and s.threads < s.maxThreads {
    s.threads = s.threads + 1u32;
    s.started = s.started + 1u64;
    grow = true;
  }
  s.lock.unlock();
  if grow {startWorker(l);}
  true;
}

// Take box b out of its lane's queue, if no thread has taken it yet: true
// when it was taken out (it will never run)
fn removeBox(b *JobBox) bool {
  if (*b).lane as usize == 0usize {return false;}
  imm s = (*b).lane as &mut LaneState;
  s.lock.lock();
  imm queued = (*b).state == boxQueued;
  if queued {
    unlinkBox(s, b);
    (*b).state = boxRemoved;
    s.cancelled = s.cancelled + 1u64;
  }
  s.lock.unlock();
  queued;
}

// ---------------------------------------------------------------------------
// Work the pool comes with: a name looked up, a file's metadata, a file read
// ---------------------------------------------------------------------------

// An operation looking host up (a name, or an address as text) on the DNS
// lane: Done(n), buf holding n addresses, each with 'port', for
// 'addressesIn'; Failed with Winsock's error when there are none. buf is
// cleared and holds the name while the work runs
pub fn resolveOp(host &Array[u8], port u16, buf IoBuf) Op {
  mut b = buf;
  b.clear();
  b.append(host);
  Op.Call[Lane.dns(), &resolveWork, u64.from(port), b];
}

// The addresses a resolveOp's buffer holds
pub fn addressesIn(buf &IoBuf) List[SocketAddr] {
  mut out = List[SocketAddr].empty();
  imm n = buf.len() / mem.sizeof[SocketAddr]();
  mut k = 0usize;
  while k < n {
    out.push(*((buf.base() as *SocketAddr) + k));
    k = k + 1usize;
  }
  out;
}

fn resolveWork(arg u64, buf &mut IoBuf) Outcome {
  imm w = widen(buf.view());
  if w as usize == 0usize {return Outcome.Failed[errorNoUnicodeTranslation];}
  mut hints = new AddrInfo(0i32, 0i32, sockStream, ipprotoTcp, 0usize, null, null, null);
  mut res = null as *AddrInfo;
  imm rc = GetAddrInfoW(w, null, &mut hints as *AddrInfo, &mut res);
  libc.free(w as *u8);
  if rc != 0i32 {return Outcome.Failed[u32.from(rc)];}
  buf.clear();
  mut count = 0usize;
  mut a = res;
  imm recSize = mem.sizeof[SocketAddr]();
  while a as usize != 0usize {
    if (*a).addrlen <= 28usize and buf.room() >= recSize {
      mut s = new SocketAddr(new Array[u8, 28] <- fill 0u8, i32.from((*a).addrlen));
      libc.memcpy(&mut s.raw as *u8, (*a).addr, (*a).addrlen);
      s.setPort(u16.from(arg));
      buf.append(mem.sliceFromParts(&mut s as *u8, recSize));
      count = count + 1usize;
    }
    a = (*a).next;
  }
  FreeAddrInfoW(res);
  Outcome.Done[count];
}

// A file's metadata, as a statOp's buffer holds it
pub struct FileStat {
  pub size u64;
  pub attributes u32;     // Windows' FILE_ATTRIBUTE_... bits
  pub modified Timestamp;

  pub fn isDir(self &) bool {(attributes & 0x10u32) != 0u32;}
}

// An operation asking a file's metadata on lane: Done, buf holding it for
// 'fileStatIn'; Failed with Windows' error (ERROR_FILE_NOT_FOUND...). buf
// is cleared and holds the path while the work runs
pub fn statOp(path &Array[u8], lane Lane, buf IoBuf) Op {
  mut b = buf;
  b.clear();
  b.append(path);
  Op.Call[lane, &statWork, 0u64, b];
}

// The metadata a statOp's buffer holds
pub fn fileStatIn(buf &IoBuf) FileStat {
  imm p = buf.base() as *u32;
  if buf.len() < 36usize {return new FileStat(0u64, 0u32, Timestamp.fromUnixNanos(0i64));}
  // WIN32_FILE_ATTRIBUTE_DATA: attributes, three FILETIMEs (the last
  // written the third), the size's high word and its low word
  imm written = (u64.from(*(p + 6usize)) << 32u64) | u64.from(*(p + 5usize));
  imm size = (u64.from(*(p + 7usize)) << 32u64) | u64.from(*(p + 8usize));
  // A FILETIME counts 100 ns from 1601; 11,644,473,600 s before 1970
  imm unix100 = i64.from(written) - 116444736000000000i64;
  new FileStat(size, *p, Timestamp.fromUnixNanos(unix100 * 100i64));
}

fn statWork(arg u64, buf &mut IoBuf) Outcome {
  imm w = widen(buf.view());
  if w as usize == 0usize {return Outcome.Failed[errorNoUnicodeTranslation];}
  mut data = new Array[u32, 9] <- fill 0u32;
  imm ok = GetFileAttributesExW(w, 0i32, &mut data as *u8);
  libc.free(w as *u8);
  if ok == 0i32 {return Outcome.Failed[GetLastError()];}
  buf.clear();
  buf.append(mem.sliceFromParts(&mut data as *u8, 36usize));
  Outcome.Done[36usize];
}

// An operation reading a file on lane, from byte 'at', as much as buf's
// capacity holds: opened, read and closed by the lane's thread (a file
// read where no completion form is to be had). Done(n), buf holding the n
// bytes; Done(0) past the end. buf is cleared and holds the path while the
// work runs
pub fn readFileOp(path &Array[u8], at u64, lane Lane, buf IoBuf) Op {
  mut b = buf;
  b.clear();
  b.append(path);
  Op.Call[lane, &readFileWork, at, b];
}

fn readFileWork(arg u64, buf &mut IoBuf) Outcome {
  imm w = widen(buf.view());
  if w as usize == 0usize {return Outcome.Failed[errorNoUnicodeTranslation];}
  imm h = CreateFileW(w, genericRead, shareAll, null, openExisting, 0u32, 0usize);
  libc.free(w as *u8);
  if h == invalidHandle {return Outcome.Failed[GetLastError()];}
  buf.clear();
  imm room = buf.room();
  imm want = if room > 0xFFFFFFFFusize {0xFFFFFFFFu32;} else {u32.from(room);};
  // A handle opened without FILE_FLAG_OVERLAPPED reads at the OVERLAPPED's
  // offset and returns when the read is done
  mut ov = new Overlapped(0usize, 0usize, u32.from(arg & 0xFFFFFFFFu64), u32.from(arg >> 32u64), 0usize);
  mut got = 0u32;
  imm ok = ReadFile(h, buf.base(), want, &mut got as *u32, &mut ov as *u8);
  imm code = if ok == 0i32 {GetLastError();} else {0u32;};
  CloseHandle(h);
  if ok == 0i32 and code != errorHandleEof {return Outcome.Failed[code];}
  buf.setLen(usize.from(got));
  Outcome.Done[usize.from(got)];
}
