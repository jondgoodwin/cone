// The Loop: its in-flight table, its handle table, its timers and its wait.
//
// How it is built. Every operation and timer is a record in the in-flight
// table, which owns it, and so its buffer, its target, its group and its
// addresses, until its answer is delivered (I2, I18). A record begins with
// the OVERLAPPED the kernel holds, so the address a completion hands back is
// the record's. Records live in blocks of 64 that never move or shrink while
// the loop lives (the kernel holds their addresses), reused through a free
// list; an OpId is a record's index and generation, and the generation moves
// on when the record's answer is delivered, so an old id finds nothing. A
// record is in one of four states: free; in flight (the kernel, the wheel or
// the blocking pool holds it); decided (its outcome is known, and its answer
// waits in 'decided' to be delivered at the end of this pass of poll); or
// abandoned (its answer, a prompt TimedOut, has been delivered, but the
// kernel still holds its buffer: the record waits for the kernel's
// completion, then gives the buffer back to its pool and is free). Every
// answer is built and delivered in one place, 'deliver', which moves the
// generation on: a record is delivered once, which is the exactly-once
// invariant (I1) by construction. A decision made before the kernel has
// answered (a prompt TimedOut) is replaced by the kernel's own outcome if
// the kernel answers before the decision is delivered: the reply says how
// the operation really ended whenever the loop can know it.
//
// Its Move fields (the buffer, the shared bytes, the target, the group) are
// written into a record's raw memory once, as empty values, when its block
// is made, and from then on only swapped in and out, so the memory always
// holds valid values; they are finalized when the loop frees the block.
//
// Timers are a timewheel.Wheel, its token a record's index and generation:
// a timer record (after) fires Done; an operation's deadline (submitBy,
// submitIn) asks its cancel, then gives the kernel 'grace' to answer the
// cancel before answering TimedOut without the buffer. The wait: GetQueued-
// CompletionStatusEx, for at most a batch of 128, its timeout the nearer of
// 'until' and the wheel's next expiry. The high-resolution waitable timer is
// armed for that instant and associated with the port through a wait
// completion packet, which the kernel queues on the port when the timer is
// signalled; a packet is good for one signal, so it is associated again
// when its packet has been taken. The port's own timeout is kept as a
// backstop (a millisecond past the instant) in case the packet could not be
// made: then a wait may end up to a timer tick late.

// Where a record is
const stFree = 0u32;
const stFlight = 1u32;
const stDecided = 2u32;
const stAbandoned = 3u32;

// What a cancel of an operation in flight should answer
const askedNone = 0u32;
const askedCancel = 1u32;
const askedDeadline = 2u32;

// An operation or a timer, and everything it owns until its answer is
// delivered. 'ov' must stay first: its address is the record's
struct Rec {
  ov Overlapped;
  wsa WsaBuf;
  flags u32;
  index u32;
  gen u32;
  state u32;
  kind u32;
  asked u32;              // askedCancel, askedDeadline: a cancel has been asked, and why
  hit bool;               // its deadline has passed: the grace is running, or has run
  abandon bool;           // decided TimedOut while the kernel or the pool still holds it
  nextFree u32;
  handle usize;           // the OS handle the operation is on, for CancelIoEx
  newSock usize;          // Accept's or Connect's new socket, until registered
  newHandle Handle;       // ...and its handle once registered
  family u16;             // Accept's listener's family
  sock Handle;            // the socket or file the operation names
  at u64;                 // ReadAt's and WriteAt's offset; Call's argument
  peer SocketAddr;        // Connect's address
  lane Lane;              // Call's lane and work, and its job while the pool holds it
  work WorkFn;
  job *JobBox;
  token u64;
  timer TimerId;          // its deadline's (or grace's) timer, or a timer record's own
  submitted Instant;
  dequeued Instant;
  status u32;             // decided: its outcome
  n usize;
  code u32;
  buf IoBuf;
  bytes Option[Bytes];
  target Target;
  group Option[CancelGroup];
  addr Array[u8, 96];     // AcceptEx's two addresses; Connect's address
}

fn blankRec(index u32, next u32) Rec {
  new Rec(
    ov: new Overlapped(0usize, 0usize, 0u32, 0u32, 0usize),
    wsa: new WsaBuf(0u32, null),
    flags: 0u32, index: index, gen: 1u32, state: stFree, kind: 0u32, asked: askedNone,
    hit: false, abandon: false,
    nextFree: next, handle: 0usize, newSock: invalidHandle, newHandle: Handle.none(),
    family: 0u16, sock: Handle.none(), at: 0u64,
    peer: new SocketAddr(new Array[u8, 28] <- fill 0u8, 0i32),
    lane: new Lane(0u32), work: &noWork, job: null,
    token: 0u64, timer: TimerId.none(),
    submitted: new Instant(), dequeued: new Instant(),
    status: 0u32, n: 0usize, code: 0u32,
    buf: IoBuf.empty(), bytes: None[Bytes][], target: Target.Here[0u64],
    group: None[CancelGroup][],
    addr: new Array[u8, 96] <- fill 0u8);
}

const recsPerBlock = 64u32;

// Whether an operation of kind k is held in a JobBox: a pool job, or an
// external operation
fn boxed(k u32) bool {k == diag.kindCall or k == diag.kindExternal;}

// What a handle is
const hFree = 0u32;
const hSocket = 1u32;
const hListener = 2u32;
const hFile = 3u32;

// An entry of the handle table
struct HEntry {
  pub raw usize;
  pub gen u32;
  pub kind u32;
  pub family u16;
  pub nextFree u32;
}

// The most completions one wait takes from the kernel
const batch = 128u32;

// The longest a poll waits while answers are held for a full channel: they
// are tried again after it
const heldRetryNs = 1000000i64;

// ---------------------------------------------------------------------------
// Loop
// ---------------------------------------------------------------------------

// The completion loop (see the package's header, THE LOOP). Driven by one
// thread
pub struct Loop {
  loopId u64;
  port Arc[imm, Port];
  portHandle usize;
  blocks List[*Rec];
  recCount u32;
  freeRec u32;
  kernelHeld u32;         // records the kernel holds: it has not completed them
  grouped u32;            // records in flight in a cancel group
  groupsDirty bool;       // a group's cancel has been posted: look at the grouped records
  decided List[u32];
  heldC List[Completion]; // answers held back by a full channel...
  heldT List[Target];     // ...and where they go
  handles List[HEntry];
  freeHandle u32;
  wheel Wheel;
  expiries List[Expiry];
  entries *OverlappedEntry;
  timer usize;            // the high-resolution waitable timer
  packet usize;           // its wait completion packet, or 0 when none could be made
  associated bool;        // the packet is associated, and not yet taken from the port
  armedFor Instant;       // the instant the timer is set for
  woken bool;
  grace Duration;         // after a deadline, how long the kernel has to give the buffer back
  stats diag.Counters;
  sub diag.Subscriber;
  subscribed bool;

  // A new loop for the calling thread, or the reason there is none
  pub fn make() Result[Loop, IoError] {
    mut port = 0usize;
    mut code = 0u32;
    code, port = openPort();
    if code != 0u32 {return Error[Loop, IoError][new IoError(code)];}
    Ok[Loop, IoError][Loop.assemble(port)];
  }

  // A new loop; a panic, at the caller's line, if there can be none. (It
  // does not unwrap make's Result: Cone moves no value out of a matched
  // variant's field, and a Loop has no empty value to swap in)
  pub fn mustMake(file &[]u8 = srcFile(), line u32 = srcLine()) Loop {
    mut port = 0usize;
    mut code = 0u32;
    code, port = openPort();
    if code != 0u32 {panic("iocore: Loop.make failed: no completion port", file, line);}
    Loop.assemble(port);
  }

  // The loop around a new port
  fn assemble(port usize) Loop {
    // The high-resolution timer (Windows 10 1803 on); an ordinary one, as
    // fine as the system's tick, before it
    mut timer = CreateWaitableTimerExW(null, null, timerHighResolution, timerAllAccess);
    if timer == 0usize {
      timer = CreateWaitableTimerExW(null, null, 0u32, timerAllAccess);
    }
    mut packet = 0usize;
    if NtCreateWaitCompletionPacket(&mut packet, genericAll, null) != 0i32 {
      packet = 0usize;
    }
    imm entries = libc.malloc(usize.from(batch) * mem.sizeof[OverlappedEntry]()) as *OverlappedEntry;
    imm shared = new Arc[imm, Port](new Port(port, Atomic[bool].of(false)));
    new Loop(
      loopId: diag.nextLoopId(), port: shared, portHandle: port,
      blocks: List[*Rec].empty(), recCount: 0u32, freeRec: noEntry, kernelHeld: 0u32,
      grouped: 0u32, groupsDirty: false,
      decided: List[u32].empty(), heldC: List[Completion].empty(), heldT: List[Target].empty(),
      handles: List[HEntry].empty(), freeHandle: noEntry,
      wheel: Wheel.make(Instant.now()), expiries: List[Expiry].empty(),
      entries: entries, timer: timer, packet: packet, associated: false,
      armedFor: new Instant(), woken: false, grace: Duration.fromMillis(1i64),
      stats: diag.Counters.zero(), sub: &diag.noSubscriber, subscribed: false);
  }

  // Its id, unique in the process, as its diagnostics records name it
  pub fn id(self &) u64 {loopId;}

  // Operations and timers submitted and not yet answered
  pub fn inFlight(self &) u64 {stats.inFlight;}

  // Its counters, as they are now
  pub fn counters(self &) diag.Counters {stats;}

  // Hand every answer delivered here to s, as a diag.OpRecord
  pub fn subscribe(self &mut, s diag.Subscriber) {
    sub = s;
    subscribed = true;
  }

  // A Waker for this loop: Sendable; copied to share
  pub fn waker(self &) Waker {new Waker(port);}

  // How long after an operation's deadline the loop waits for the kernel
  // (or the pool) to answer its cancel and give the buffer back, before it
  // answers TimedOut without the buffer (see the package's header,
  // DEADLINES). 1 ms unless set; zero answers at the deadline itself
  pub fn setGrace(self &mut, d Duration) {grace = d;}

  // A Request for operation id: a handle whose death cancels it, which may
  // be held on any thread (see the package's header, REQUESTS)
  pub fn request(self &, id OpId) Request {new Request(new Waker(port), id, not id.isNone());}

  // -------------------------------------------------------------------------
  // Handles
  // -------------------------------------------------------------------------

  // A TCP socket listening at addr, for Accept; addr's port 0 has the OS
  // choose one, which localAddr tells
  pub fn listen(self &mut, addr SocketAddr, backlog i32 = 128i32) Result[Handle, IoError] {
    imm s = tcpSocket(addr.family());
    if s == invalidHandle {return Error[Handle, IoError][new IoError(wsaError())];}
    mut a = addr;
    // Winsock's listen, named through the module: Loop's own 'listen' is
    // the bare name here
    if bind(s, &mut a as *u8, a.size) != 0i32 or iocore.listen(s, backlog) != 0i32 {
      imm code = wsaError();
      closesocket(s);
      return Error[Handle, IoError][new IoError(code)];
    }
    if CreateIoCompletionPort(s, portHandle, keyIo, 0u32) == 0usize {
      imm code = GetLastError();
      closesocket(s);
      return Error[Handle, IoError][new IoError(code)];
    }
    Ok[Handle, IoError][self.register(s, hListener, addr.family())];
  }

  // A listening socket; a panic, at the caller's line, if there can be none
  pub fn mustListen(self &mut, addr SocketAddr, file &[]u8 = srcFile(), line u32 = srcLine()) Handle {
    match self.listen(addr) {
      case imm r Ok {r.value;}
      case imm e Error {panic("iocore: listen failed", file, line);}
    }
  }

  // The address a socket is bound to
  pub fn localAddr(self &, h Handle) Result[SocketAddr, IoError] {
    imm i = self.handleIndex(h);
    if i == noEntry {return Error[SocketAddr, IoError][new IoError(errorInvalidHandle)];}
    imm e = handles[usize.from(i)];
    mut a = new SocketAddr(new Array[u8, 28] <- fill 0u8, 28i32);
    mut len = 28i32;
    if getsockname(e.raw, &mut a as *u8, &mut len) != 0i32 {
      return Error[SocketAddr, IoError][new IoError(wsaError())];
    }
    a.size = len;
    Ok[SocketAddr, IoError][a];
  }

  // The address of a connected socket's peer
  pub fn peerAddr(self &, h Handle) Result[SocketAddr, IoError] {
    imm raw = self.rawOf(h, hSocket);
    if raw == invalidHandle {return Error[SocketAddr, IoError][new IoError(errorInvalidHandle)];}
    mut a = new SocketAddr(new Array[u8, 28] <- fill 0u8, 28i32);
    mut len = 28i32;
    if getpeername(raw, &mut a as *u8, &mut len) != 0i32 {
      return Error[SocketAddr, IoError][new IoError(wsaError())];
    }
    a.size = len;
    Ok[SocketAddr, IoError][a];
  }

  // A file, for ReadAt and WriteAt
  pub fn openFile(self &mut, path &[]u8, access Access) Result[Handle, IoError] {
    imm w = widen(path);
    if w as usize == 0usize {return Error[Handle, IoError][new IoError(errorNoUnicodeTranslation)];}
    mut want = genericRead;
    mut how = openExisting;
    match access {
      case is Access.Read {}
      case is Access.Create {want = genericRead | genericWrite; how = createAlways;}
      case is Access.Update {want = genericRead | genericWrite; how = openAlways;}
    }
    imm h = CreateFileW(w, want, shareAll, null, how, flagOverlapped, 0usize);
    libc.free(w as *u8);
    if h == invalidHandle {return Error[Handle, IoError][new IoError(GetLastError())];}
    if CreateIoCompletionPort(h, portHandle, keyIo, 0u32) == 0usize {
      imm code = GetLastError();
      CloseHandle(h);
      return Error[Handle, IoError][new IoError(code)];
    }
    Ok[Handle, IoError][self.register(h, hFile, 0u16)];
  }

  // Whether h names something this loop holds
  pub fn isOpen(self &, h Handle) bool {self.handleIndex(h) != noEntry;}

  // Close what h names: every operation in flight on it is cancelled (each
  // still answers), and h names nothing from now on. False if it named
  // nothing already
  pub fn close(self &mut, h Handle) bool {
    imm i = self.handleIndex(h);
    if i == noEntry {return false;}
    imm e = &mut handles[usize.from(i)];
    CancelIoEx(e.raw, null);
    if e.kind == hFile {CloseHandle(e.raw);} else {closesocket(e.raw);}
    e.kind = hFree;
    e.raw = 0usize;
    e.gen = if e.gen == 0xFFFFFFFFu32 {1u32;} else {e.gen + 1u32;};
    e.nextFree = freeHandle;
    freeHandle = i;
    true;
  }

  // A connected socket's sending side is finished (a half-close: TCP's FIN
  // goes after what was sent): its peer's receive ends, Done(0), while this
  // side can still receive. 0, or Winsock's error; a send submitted after
  // it fails. ERROR_INVALID_HANDLE when h is no connected socket
  pub fn shutdown(self &mut, h Handle) u32 {
    imm raw = self.rawOf(h, hSocket);
    if raw == invalidHandle {return errorInvalidHandle;}
    if iocore.shutdown(raw, sdSend) != 0i32 {return wsaError();}
    0u32;
  }

  // Close a connected socket abortively: its peer sees the connection
  // reset (RST), not finished, and what was not yet sent is dropped. As
  // 'close' otherwise: everything in flight on it is cancelled, and h names
  // nothing from now on. False if it named no socket
  pub fn reset(self &mut, h Handle) bool {
    imm i = self.handleIndex(h);
    if i == noEntry {return false;}
    imm e = &mut handles[usize.from(i)];
    if e.kind != hSocket {return false;}
    CancelIoEx(e.raw, null);
    resetSocket(e.raw);
    e.kind = hFree;
    e.raw = 0usize;
    e.gen = if e.gen == 0xFFFFFFFFu32 {1u32;} else {e.gen + 1u32;};
    e.nextFree = freeHandle;
    freeHandle = i;
    true;
  }

  fn register(self &mut, raw usize, kind u32, family u16) Handle {
    if freeHandle == noEntry {
      handles.push(new HEntry(0usize, 1u32, hFree, 0u16, noEntry));
      freeHandle = u32.from(handles.len() - 1usize);
    }
    imm i = freeHandle;
    imm e = &mut handles[usize.from(i)];
    freeHandle = e.nextFree;
    e.raw = raw;
    e.kind = kind;
    e.family = family;
    e.nextFree = noEntry;
    new Handle(i, e.gen);
  }

  // h's entry, or noEntry if h names nothing
  fn handleIndex(self &, h Handle) u32 {
    if h.index == noEntry or usize.from(h.index) >= handles.len() {return noEntry;}
    imm e = handles[usize.from(h.index)];
    if e.gen != h.gen or e.kind == hFree {return noEntry;}
    h.index;
  }

  // The OS handle h names, if it is of kind; invalidHandle if not
  fn rawOf(self &, h Handle, kind u32) usize {
    imm i = self.handleIndex(h);
    if i == noEntry {return invalidHandle;}
    imm e = handles[usize.from(i)];
    if e.kind != kind {return invalidHandle;}
    e.raw;
  }

  // -------------------------------------------------------------------------
  // The in-flight table
  // -------------------------------------------------------------------------

  fn recAt(self &, i u32) *Rec {
    *blocks[usize.from(i / recsPerBlock)] + usize.from(i % recsPerBlock);
  }

  // A free record, in flight, its submission stamped
  fn allocRec(self &mut) u32 {
    if freeRec == noEntry {
      imm block = libc.malloc(usize.from(recsPerBlock) * mem.sizeof[Rec]()) as *Rec;
      if block as usize == 0usize {panic("iocore: out of memory for the in-flight table");}
      imm base = recCount;
      mut j = 0u32;
      while j < recsPerBlock {
        imm next = if j + 1u32 < recsPerBlock {base + j + 1u32;} else {noEntry;};
        mem.writeRaw[Rec](block + usize.from(j), blankRec(base + j, next));
        j = j + 1u32;
      }
      blocks.push(block);
      recCount = recCount + recsPerBlock;
      freeRec = base;
    }
    imm i = freeRec;
    imm r = self.recAt(i) as &mut Rec;
    freeRec = r.nextFree;
    r.state = stFlight;
    r.asked = askedNone;
    r.hit = false;
    r.abandon = false;
    r.submitted = Instant.now();
    r.dequeued = r.submitted;
    r.newSock = invalidHandle;
    r.newHandle = Handle.none();
    r.timer = TimerId.none();
    r.job = null;
    stats.submit();
    i;
  }

  // The wheel's token for a record: its generation above its index
  fn tokenOf(self &, i u32) u64 {
    imm r = self.recAt(i) as &Rec;
    (u64.from(r.gen) << 32u64) | u64.from(i);
  }

  // The outcome of record i is known: it waits for delivery at the end of
  // this pass of poll (or the next one). A record decided already and not
  // yet delivered -- a prompt TimedOut the kernel has now answered after
  // all -- takes the kernel's outcome instead, its buffer back with it
  fn decide(self &mut, i u32, status u32, n usize, code u32) {
    imm r = self.recAt(i) as &mut Rec;
    r.status = status;
    r.n = n;
    r.code = code;
    r.abandon = false;
    if r.state == stDecided {return;}
    r.state = stDecided;
    if not r.timer.isNone() {
      wheel.cancel(r.timer);
      r.timer = TimerId.none();
    }
    decided.push(i);
  }

  // Record i's deadline has passed and the kernel (or the pool) still holds
  // it: answer TimedOut now, without its buffer, which goes home when the
  // kernel gives it back
  fn abandonRec(self &mut, i u32) {
    self.decide(i, diag.outcomeTimedOut, 0usize, 0u32);
    (self.recAt(i) as &mut Rec).abandon = true;
  }

  // Build record i's answer, free the record (or leave it abandoned to the
  // kernel), and send the answer where its target says: how many went to out
  fn deliver(self &mut, i u32, out &mut List[Completion], at Instant) usize {
    imm r = self.recAt(i) as &mut Rec;
    // A record abandoned to the kernel keeps its buffer, and its bytes, for
    // the kernel; a job's buffer is in its box, which comes back by itself
    imm keep = r.abandon and not boxed(r.kind);
    mut b = IoBuf.empty();
    if not keep {
      b <=> r.buf;
      r.bytes = None[Bytes][];
    }
    if r.abandon {stats.promptTimeouts = stats.promptTimeouts + 1u64;}
    mut t Target = Target.Here[0u64];
    t <=> r.target;
    mut g Option[CancelGroup] = None[CancelGroup][];
    g <=> r.group;
    match g {
      case is None[CancelGroup] {}
      else {grouped = grouped - 1u32;}
    }
    imm c = new Completion(loopId, new OpId(i, r.gen), r.token, r.kind, r.status, r.n, r.code,
      b, r.newHandle, r.submitted, r.dequeued, at);
    stats.count(r.status);
    // Its id names nothing from now on
    r.gen = if r.gen == 0xFFFFFFFFu32 {1u32;} else {r.gen + 1u32;};
    r.job = null;
    if keep {
      r.state = stAbandoned;
    } else {
      self.freeRecord(i);
    }
    self.send(c, t, out);
  }

  fn freeRecord(self &mut, i u32) {
    imm r = self.recAt(i) as &mut Rec;
    r.state = stFree;
    r.abandon = false;
    r.nextFree = freeRec;
    freeRec = i;
  }

  // Hand the subscriber an answer this loop sends to another thread (one
  // posted to another loop is recorded there)
  fn note(self &, c &Completion) {
    if subscribed {
      imm rec = c.record();
      (sub)(&rec);
    }
  }

  // Send answer c where t says: to out (Here: 1) or elsewhere (0)
  fn send(self &mut, c Completion, t Target, out &mut List[Completion]) usize {
    // A channel's send may find it full: the answer is held, and tried again
    mut back = blankCompletion();
    mut hold = false;
    mut n = 0usize;
    mut to = t;
    match &mut to {
      case imm p &mut Post {
        if p.waker.post(c) {
          stats.postsSent = stats.postsSent + 1u64;
        } else {
          stats.postsDropped = stats.postsDropped + 1u64;
        }
      }
      case imm ch &mut Chan {
        self.note(&c);
        hold = self.tryChan(&ch.tx, c, &mut back);
      }
      case mut o &mut Once {
        self.note(&c);
        match o.tx.send(c) {
          case is None[Completion] {stats.handedOff = stats.handedOff + 1u64;}
          else {stats.handedDropped = stats.handedDropped + 1u64;}
        }
      }
      case imm s &mut Status {
        self.note(&c);
        s.board.put(s.slot, c);
        stats.handedOff = stats.handedOff + 1u64;
      }
      case mut h &mut Hook {
        self.note(&c);
        h.sink.give(c);
        stats.handedOff = stats.handedOff + 1u64;
      }
      else {
        self.note(&c);
        out.push(c);
        n = 1usize;
      }
    }
    if hold {
      stats.held = stats.held + 1u64;
      heldC.push(back);
      heldT.push(to);
    }
    n;
  }

  // Send c on a channel without waiting: false when it is taken, or its
  // receiver has gone (c dropped, its buffer home); true when the channel
  // is full, c handed back in 'back'
  fn tryChan(self &mut, tx &Sender[Completion], c Completion, back &mut Completion) bool {
    mut full = false;
    match tx.trySend(c) {
      case mut s Some {
        if tx.isClosed() {
          stats.handedDropped = stats.handedDropped + 1u64;
        } else {
          *back <=> s.value;
          full = true;
        }
      }
      else {stats.handedOff = stats.handedOff + 1u64;}
    }
    full;
  }

  // Try again the answers a full channel held back: those it takes, or
  // whose receiver has gone, are done with
  fn retryHeld(self &mut) {
    if heldC.len() == 0usize {return;}
    mut k = 0usize;
    while k < heldC.len() {
      mut c = blankCompletion();
      imm slot = &mut heldC[k];
      c <=> *slot;
      mut back = blankCompletion();
      mut still = false;
      // Out of the list into a local, to be narrowed to its variant
      mut to Target = Target.Here[0u64];
      imm tslot = &mut heldT[k];
      to <=> *tslot;
      match &mut to {
        case imm ch &mut Chan {still = self.tryChan(&ch.tx, c, &mut back);}
        else {}
      }
      if still {
        imm again = &mut heldC[k];
        back <=> *again;
        imm tagain = &mut heldT[k];
        to <=> *tagain;
        k = k + 1usize;
      } else {
        // Done with: the last goes into its place
        imm last = heldC.len() - 1usize;
        heldC.swap(k, last);
        heldT.swap(k, last);
        heldC.pop();
        heldT.pop();
      }
    }
  }

  // Deliver every decided answer: how many went to out
  fn flush(self &mut, out &mut List[Completion]) usize {
    if decided.len() == 0usize {return 0usize;}
    imm at = Instant.now();
    mut n = 0usize;
    mut k = 0usize;
    while k < decided.len() {
      imm i = *decided[k];
      n = n + self.deliver(i, out, at);
      k = k + 1usize;
    }
    decided.clear();
    n;
  }

  // -------------------------------------------------------------------------
  // Submitting
  // -------------------------------------------------------------------------

  // Start an operation; its answer goes where 'to' says (see the package's
  // header, OPERATIONS and TARGETS). Its id, for cancel
  pub fn submit(self &mut, op Op, to Target, file &[]u8 = srcFile(), line u32 = srcLine()) OpId {
    self.start(op, to, forever(), None[CancelGroup][], file, line);
  }

  // Start an operation that answers TimedOut if it has not finished by
  // deadline (see the package's header, DEADLINES)
  pub fn submitBy(self &mut, op Op, to Target, deadline Instant,
      file &[]u8 = srcFile(), line u32 = srcLine()) OpId {
    self.start(op, to, deadline, None[CancelGroup][], file, line);
  }

  // Start an operation in a cancel group: the group's cancel cancels it, and
  // its deadline is the tighter of 'deadline' and the group's (forever()
  // for the group's alone). Answered Cancelled at once, never started, when
  // the group is cancelled already (see the package's header, CANCEL GROUPS)
  pub fn submitIn(self &mut, op Op, to Target, group CancelGroup, deadline Instant,
      file &[]u8 = srcFile(), line u32 = srcLine()) OpId {
    self.start(op, to, deadline, Some[CancelGroup][group], file, line);
  }

  // A timer: it answers Done (n 0) at 'at', to its target, unless cancelled
  pub fn after(self &mut, at Instant, to Target, file &[]u8 = srcFile(), line u32 = srcLine()) OpId {
    self.startTimer(at, to, None[CancelGroup][], file, line);
  }

  // A timer in a cancel group: the group's cancel cancels it
  pub fn afterIn(self &mut, at Instant, to Target, group CancelGroup,
      file &[]u8 = srcFile(), line u32 = srcLine()) OpId {
    self.startTimer(at, to, Some[CancelGroup][group], file, line);
  }

  // An external operation: one ended by whoever holds the Completer this
  // answers -- another thread, a GPU fence's watcher -- from any thread,
  // its answer delivered where 'to' says as any operation's is (see the
  // package's header, EXTERNAL OPERATIONS). buf is lent to the completer
  // (IoBuf.empty() for none) and comes back in the answer
  pub fn external(self &mut, to Target, buf IoBuf, file &[]u8 = srcFile(), line u32 = srcLine()) Completer {
    self.startExternal(to, buf, forever(), None[CancelGroup][], file, line);
  }

  // An external operation in a cancel group, with a deadline (forever()
  // for the group's alone)
  pub fn externalIn(self &mut, to Target, buf IoBuf, group CancelGroup, deadline Instant,
      file &[]u8 = srcFile(), line u32 = srcLine()) Completer {
    self.startExternal(to, buf, deadline, Some[CancelGroup][group], file, line);
  }

  fn startExternal(self &mut, to Target, buf IoBuf, deadline Instant, group Option[CancelGroup],
      file &[]u8, line u32) Completer {
    imm token = to.token;
    mut t = self.claim(to, file, line);
    imm i = self.allocRec();
    imm r = self.recAt(i) as &mut Rec;
    r.token = token;
    r.target <=> t;
    r.kind = diag.kindExternal;
    mut b = buf;
    r.buf <=> b;
    imm gen = r.gen;
    mut dl = deadline;
    match group {
      case imm s Some {if s.value.deadline() < dl {dl = s.value.deadline();}}
      else {}
    }
    if self.join(i, group) {
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(i, diag.outcomeCancelled, 0usize, 0u32);
      return new Completer(null, new OpId(i, gen), new Waker(port));
    }
    if dl <= r.submitted {
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(i, diag.outcomeTimedOut, 0usize, 0u32);
      return new Completer(null, new OpId(i, gen), new Waker(port));
    }
    imm box = newBox(&noWork, 0u64, new Waker(port), i, gen, null);
    (box as &mut JobBox).buf <=> r.buf;
    (*box).state = boxRunning;
    r.job = box;
    if dl < forever() {
      r.timer = wheel.insert(dl, self.tokenOf(i));
    }
    new Completer(box, new OpId(i, gen), new Waker(port));
  }

  // The target's own part of a submit: a status slot is claimed. The target
  // passes through
  fn claim(self &mut, to Target, file &[]u8, line u32) Target {
    match &to {
      case imm s &Status {
        if not s.board.arm(s.slot) {
          panic("iocore: a status slot given an operation while it holds one, or out of range", file, line);
        }
      }
      else {}
    }
    to;
  }

  // The group's part of a submit: the record joins it, and the loop is told
  // when it is cancelled. True when it is cancelled already
  fn join(self &mut, i u32, group Option[CancelGroup]) bool {
    imm r = self.recAt(i) as &mut Rec;
    mut g = group;
    r.group <=> g;
    mut cancelled = false;
    match r.group {
      case imm s Some {
        grouped = grouped + 1u32;
        imm w = new Waker(port);
        s.value.register(loopId, &w);
        // After the registration: a cancel since is either seen here or
        // posted to this loop
        cancelled = s.value.isCancelled();
      }
      else {}
    }
    cancelled;
  }

  fn startTimer(self &mut, at Instant, to Target, group Option[CancelGroup],
      file &[]u8, line u32) OpId {
    imm token = to.token;
    mut t = self.claim(to, file, line);
    imm i = self.allocRec();
    imm r = self.recAt(i) as &mut Rec;
    r.kind = diag.kindTimer;
    r.token = token;
    r.target <=> t;
    imm gen = r.gen;
    if self.join(i, group) {
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(i, diag.outcomeCancelled, 0usize, 0u32);
    } else {
      r.timer = wheel.insert(at, self.tokenOf(i));
    }
    new OpId(i, gen);
  }

  fn start(self &mut, op Op, to Target, deadline Instant, group Option[CancelGroup],
      file &[]u8, line u32) OpId {
    imm token = to.token;
    mut t = self.claim(to, file, line);
    imm i = self.allocRec();
    imm p = self.recAt(i);
    imm r = p as &mut Rec;
    r.token = token;
    r.target <=> t;
    r.ov.internal = 0usize;
    r.ov.internalHigh = 0usize;
    r.ov.offset = 0u32;
    r.ov.offsetHigh = 0u32;
    r.ov.hEvent = 0usize;
    // What it is, and what it owns, into the record
    match op {
      case imm o Connect {
        r.kind = diag.kindConnect;
        r.peer = o.addr;
      }
      case imm o Accept {
        r.kind = diag.kindAccept;
        r.sock = o.listener;
      }
      case mut o Recv {
        r.kind = diag.kindRecv;
        r.buf <=> o.buf;
        r.sock = o.sock;
      }
      case imm o RecvReady {
        r.kind = diag.kindRecvReady;
        r.sock = o.sock;
      }
      case mut o Send {
        r.kind = diag.kindSend;
        r.buf <=> o.buf;
        r.sock = o.sock;
      }
      case imm o SendBytes {
        r.kind = diag.kindSend;
        r.bytes = Some[Bytes][o.bytes];
        r.sock = o.sock;
      }
      case mut o ReadAt {
        r.kind = diag.kindReadAt;
        r.buf <=> o.buf;
        r.sock = o.file;
        r.at = o.at;
      }
      case mut o WriteAt {
        r.kind = diag.kindWriteAt;
        r.buf <=> o.buf;
        r.sock = o.file;
        r.at = o.at;
      }
      case mut o Call {
        r.kind = diag.kindCall;
        r.buf <=> o.buf;
        r.lane = o.lane;
        r.work = o.work;
        r.at = o.arg;
      }
    }
    imm gen = r.gen;
    // Its deadline: the tighter of its own and its group's
    mut dl = deadline;
    match group {
      case imm s Some {if s.value.deadline() < dl {dl = s.value.deadline();}}
      else {}
    }
    // Cancelled is a state: an operation in a cancelled group, or whose
    // deadline has passed, is answered at once and never started
    if self.join(i, group) {
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(i, diag.outcomeCancelled, 0usize, 0u32);
      return new OpId(i, gen);
    }
    if dl <= r.submitted {
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(i, diag.outcomeTimedOut, 0usize, 0u32);
      return new OpId(i, gen);
    }
    imm code = self.launch(p);
    if code == errorHandleEof {
      self.decide(i, diag.outcomeDone, 0usize, 0u32);
    } elif code != 0u32 {
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(i, diag.outcomeFailed, 0usize, code);
    } else {
      if r.kind != diag.kindCall {kernelHeld = kernelHeld + 1u32;}
      if dl < forever() {
        r.timer = wheel.insert(dl, self.tokenOf(i));
      }
    }
    new OpId(i, gen);
  }

  // Hand record p's operation to the kernel or the pool: 0, it holds it now
  // (its completion will come to the port); or the error that stopped it
  // before it was taken
  fn launch(self &mut, p *Rec) u32 {
    imm r = p as &mut Rec;
    imm k = r.kind;
    if k == diag.kindConnect {return self.startConnect(p, r.peer);}
    if k == diag.kindAccept {return self.startAccept(p, r.sock);}
    if k == diag.kindRecv {return self.startRecv(p, r.sock, false);}
    if k == diag.kindRecvReady {return self.startRecv(p, r.sock, true);}
    if k == diag.kindSend {
      match r.bytes {
        case imm b Some {
          imm v = b.value.view();
          return self.startSend(p, r.sock, v, v.len);
        }
        else {}
      }
      return self.startSend(p, r.sock, r.buf.base(), r.buf.len());
    }
    if k == diag.kindReadAt {return self.startFile(p, r.sock, r.at, false);}
    if k == diag.kindWriteAt {return self.startFile(p, r.sock, r.at, true);}
    self.startCall(p);
  }

  // Each starts its kind of operation in record p: 0, the kernel holds it
  // now (its completion will come to the port); or the error that stopped it
  // before the kernel took it

  fn startConnect(self &mut, p *Rec, addr SocketAddr) u32 {
    imm r = p as &mut Rec;
    if connectExAddr == 0usize {return errorInvalidParameter;}
    imm s = tcpSocket(addr.family());
    if s == invalidHandle {return wsaError();}
    mut here = addr.wildcard();
    if bind(s, &mut here as *u8, here.size) != 0i32 {
      imm code = wsaError();
      closesocket(s);
      return code;
    }
    if CreateIoCompletionPort(s, portHandle, keyIo, 0u32) == 0usize {
      imm code = GetLastError();
      closesocket(s);
      return code;
    }
    r.newSock = s;
    r.handle = s;
    r.family = addr.family();
    mut a = addr;
    libc.memcpy(&mut r.addr as *u8, &mut a as *u8, 28usize);
    imm connectEx = connectExAddr as *u8 as ConnectExFn;
    if connectEx(s, &mut r.addr as *u8, a.size, null, 0u32, null, p as *u8) == 0i32 {
      imm code = wsaError();
      if code != errorIoPending {
        closesocket(s);
        r.newSock = invalidHandle;
        return code;
      }
    }
    0u32;
  }

  fn startAccept(self &mut, p *Rec, listener Handle) u32 {
    imm r = p as &mut Rec;
    if acceptExAddr == 0usize {return errorInvalidParameter;}
    imm li = self.handleIndex(listener);
    if li == noEntry {return errorInvalidHandle;}
    imm e = handles[usize.from(li)];
    if e.kind != hListener {return errorInvalidHandle;}
    imm s = tcpSocket(e.family);
    if s == invalidHandle {return wsaError();}
    r.newSock = s;
    r.handle = e.raw;
    r.family = e.family;
    imm acceptEx = acceptExAddr as *u8 as AcceptExFn;
    if acceptEx(e.raw, s, &mut r.addr as *u8, 0u32, acceptAddrLen, acceptAddrLen, null, p as *u8) == 0i32 {
      imm code = wsaError();
      if code != errorIoPending {
        closesocket(s);
        r.newSock = invalidHandle;
        return code;
      }
    }
    0u32;
  }

  fn startRecv(self &mut, p *Rec, sock Handle, ready bool) u32 {
    imm r = p as &mut Rec;
    imm raw = self.rawOf(sock, hSocket);
    if raw == invalidHandle {return errorInvalidHandle;}
    r.handle = raw;
    if ready {
      r.wsa.len = 0u32;
      r.wsa.buf = null;
    } else {
      imm room = r.buf.room();
      if room == 0usize {return errorInsufficientBuffer;}
      r.wsa.len = if room > 0xFFFFFFFFusize {0xFFFFFFFFu32;} else {u32.from(room);};
      r.wsa.buf = r.buf.base() + r.buf.len();
    }
    r.flags = 0u32;
    if WSARecv(raw, &mut r.wsa as *WsaBuf, 1u32, null, &mut r.flags, p as *u8, null) != 0i32 {
      imm code = wsaError();
      if code != errorIoPending {return code;}
    }
    0u32;
  }

  fn startSend(self &mut, p *Rec, sock Handle, data *u8, len usize) u32 {
    imm r = p as &mut Rec;
    imm raw = self.rawOf(sock, hSocket);
    if raw == invalidHandle {return errorInvalidHandle;}
    if len > 0xFFFFFFFFusize {return errorInvalidParameter;}
    r.handle = raw;
    r.wsa.len = u32.from(len);
    r.wsa.buf = data;
    if WSASend(raw, &mut r.wsa as *WsaBuf, 1u32, null, 0u32, p as *u8, null) != 0i32 {
      imm code = wsaError();
      if code != errorIoPending {return code;}
    }
    0u32;
  }

  fn startFile(self &mut, p *Rec, file Handle, at u64, write bool) u32 {
    imm r = p as &mut Rec;
    imm raw = self.rawOf(file, hFile);
    if raw == invalidHandle {return errorInvalidHandle;}
    r.handle = raw;
    r.ov.offset = u32.from(at & 0xFFFFFFFFu64);
    r.ov.offsetHigh = u32.from(at >> 32u64);
    mut ok = 0i32;
    if write {
      imm len = r.buf.len();
      if len > 0xFFFFFFFFusize {return errorInvalidParameter;}
      ok = WriteFile(raw, r.buf.base(), u32.from(len), null, p as *u8);
    } else {
      imm room = r.buf.room();
      if room == 0usize {return errorInsufficientBuffer;}
      imm want = if room > 0xFFFFFFFFusize {0xFFFFFFFFu32;} else {u32.from(room);};
      ok = ReadFile(raw, r.buf.base() + r.buf.len(), want, null, p as *u8);
    }
    if ok == 0i32 {
      imm code = GetLastError();
      if code != errorIoPending {return code;}
    }
    0u32;
  }

  // A job for the blocking pool: boxed with a waker of this loop, its
  // buffer moved into the box, and queued on its lane
  fn startCall(self &mut, p *Rec) u32 {
    imm r = p as &mut Rec;
    imm l = laneAt(r.lane.id);
    if l as usize == 0usize {return errorInvalidParameter;}
    imm b = newBox(r.work, r.at, new Waker(port), r.index, r.gen, l);
    (b as &mut JobBox).buf <=> r.buf;
    if not enqueueBox(b) {
      r.buf <=> (b as &mut JobBox).buf;
      dropBox(b);
      return errorBusy;
    }
    r.job = b;
    stats.jobs = stats.jobs + 1u64;
    0u32;
  }

  // -------------------------------------------------------------------------
  // Cancel
  // -------------------------------------------------------------------------

  // Ask an operation or a timer to end (see the package's header, CANCEL):
  // true while its answer is still to come, false once it is decided or for
  // an id that names nothing
  pub fn cancel(self &mut, id OpId) bool {
    if id.isNone() or id.index >= recCount {return false;}
    imm r = self.recAt(id.index) as &mut Rec;
    if r.gen != id.gen or r.state != stFlight {return false;}
    if r.asked == askedNone {
      stats.cancelsAsked = stats.cancelsAsked + 1u64;
      self.askCancel(id.index, askedCancel);
    }
    true;
  }

  // Ask record i's cancel, for 'why': a timer, or a job still queued, is
  // decided at once (a job with its buffer back); the kernel is asked
  // (CancelIoEx); a running job answers when it returns
  fn askCancel(self &mut, i u32, why u32) {
    imm p = self.recAt(i);
    imm r = p as &mut Rec;
    imm outcome = if why == askedDeadline {diag.outcomeTimedOut;} else {diag.outcomeCancelled;};
    if r.kind == diag.kindTimer {
      self.decide(i, outcome, 0usize, 0u32);
      return;
    }
    if r.asked != askedNone {return;}
    r.asked = why;
    if r.kind == diag.kindExternal {
      // Nothing to interrupt: its completer is told, and answers
      if r.job as usize != 0usize {(*r.job).asked.store(1u32);}
      return;
    }
    if r.kind == diag.kindCall {
      if r.job as usize != 0usize and removeBox(r.job) {
        r.buf <=> (r.job as &mut JobBox).buf;
        dropBox(r.job);
        r.job = null;
        self.decide(i, outcome, 0usize, 0u32);
      }
      return;
    }
    CancelIoEx(r.handle, p as *u8);
  }

  // A cancel group has been cancelled: every operation in flight in a
  // cancelled group is asked to end
  fn sweepGroups(self &mut) {
    groupsDirty = false;
    if grouped == 0u32 {return;}
    mut i = 0u32;
    while i < recCount {
      imm r = self.recAt(i) as &mut Rec;
      if r.state == stFlight and r.asked == askedNone {
        mut hit = false;
        match r.group {
          case imm s Some {hit = s.value.isCancelled();}
          else {}
        }
        if hit {
          stats.groupCancels = stats.groupCancels + 1u64;
          self.askCancel(i, askedCancel);
        }
      }
      i = i + 1u32;
    }
  }

  // -------------------------------------------------------------------------
  // Completing
  // -------------------------------------------------------------------------

  // The kernel has completed record p, moving 'bytes'
  fn complete(self &mut, p *Rec, bytes u32, at Instant) {
    imm r = p as &mut Rec;
    kernelHeld = kernelHeld - 1u32;
    if r.state == stAbandoned {
      // Its answer went long ago: the buffer goes home, the record is free
      if r.newSock != invalidHandle {
        closesocket(r.newSock);
        r.newSock = invalidHandle;
      }
      mut b = IoBuf.empty();
      b <=> r.buf;
      r.bytes = None[Bytes][];
      stats.lateReturns = stats.lateReturns + 1u64;
      self.freeRecord(r.index);
      return;
    }
    r.dequeued = at;
    imm status = r.ov.internal & 0xFFFFFFFFusize;
    imm n = usize.from(bytes);
    if status == statusSuccess {
      if r.kind == diag.kindRecv or r.kind == diag.kindReadAt {
        r.buf.setLen(r.buf.len() + n);
      }
      if r.kind == diag.kindAccept or r.kind == diag.kindConnect {
        imm code = self.adopt(p);
        if code != 0u32 {
          self.decide(r.index, diag.outcomeFailed, 0usize, code);
          return;
        }
      }
      self.decide(r.index, diag.outcomeDone, n, 0u32);
      return;
    }
    if r.newSock != invalidHandle {
      closesocket(r.newSock);
      r.newSock = invalidHandle;
    }
    if status == statusCancelled {
      if r.asked == askedDeadline {
        self.decide(r.index, diag.outcomeTimedOut, 0usize, 0u32);
      } else {
        self.decide(r.index, diag.outcomeCancelled, 0usize, 0u32);
      }
    } elif status == statusEndOfFile {
      self.decide(r.index, diag.outcomeDone, 0usize, 0u32);
    } else {
      self.decide(r.index, diag.outcomeFailed, 0usize, RtlNtStatusToDosError(u32.from(status)));
    }
  }

  // A job has come back from the pool: its record takes its buffer and its
  // outcome; a job answered already (a prompt TimedOut) is dropped, its
  // buffer going home
  fn completeJob(self &mut, b *JobBox, at Instant) {
    imm j = b as &mut JobBox;
    imm i = j.rec;
    if i >= recCount {
      dropBox(b);
      return;
    }
    imm r = self.recAt(i) as &mut Rec;
    if r.gen != j.gen or r.job != b or (r.state != stFlight and r.state != stDecided) {
      stats.lateReturns = stats.lateReturns + 1u64;
      dropBox(b);
      return;
    }
    r.job = null;
    r.dequeued = at;
    r.buf <=> j.buf;
    mut status = j.status;
    if status == diag.outcomeCancelled and r.asked == askedDeadline {
      status = diag.outcomeTimedOut;
    }
    self.decide(i, status, if status == diag.outcomeDone {j.n;} else {0usize;}, j.code);
    dropBox(b);
  }

  // An accepted or connected socket is finished and registered: 0, or the
  // error that stopped it (the socket is then closed)
  fn adopt(self &mut, p *Rec) u32 {
    imm r = p as &mut Rec;
    imm s = r.newSock;
    r.newSock = invalidHandle;
    mut rc = 0i32;
    if r.kind == diag.kindAccept {
      mut listener = r.handle;
      rc = setsockopt(s, solSocket, soUpdateAcceptContext, &mut listener as *u8, 8i32);
      if rc == 0i32 and CreateIoCompletionPort(s, portHandle, keyIo, 0u32) == 0usize {
        imm code = GetLastError();
        closesocket(s);
        return code;
      }
    } else {
      rc = setsockopt(s, solSocket, soUpdateConnectContext, null, 0i32);
    }
    if rc != 0i32 {
      imm code = wsaError();
      closesocket(s);
      return code;
    }
    noDelay(s);
    r.newHandle = self.register(s, hSocket, r.family);
    0u32;
  }

  // Fire what the wheel says is due by now: a timer answers Done; an
  // operation's deadline asks its cancel and starts its grace; a grace run
  // out answers TimedOut without the buffer
  fn fireTimers(self &mut, now Instant) {
    if wheel.isEmpty() {return;}
    wheel.expired(now, &mut expiries);
    mut k = 0usize;
    while k < expiries.len() {
      imm token = expiries[k].token;
      imm i = u32.from(token & 0xFFFFFFFFu64);
      imm gen = u32.from(token >> 32u64);
      k = k + 1usize;
      if i >= recCount {continue;}
      imm r = self.recAt(i) as &mut Rec;
      if r.gen != gen or r.state != stFlight {continue;}
      r.timer = TimerId.none();
      if r.kind == diag.kindTimer {
        r.dequeued = now;
        self.decide(i, diag.outcomeDone, 0usize, 0u32);
      } elif not r.hit {
        // The deadline
        r.hit = true;
        if r.asked == askedNone {self.askCancel(i, askedDeadline);}
        if r.state == stFlight {
          if grace.nanos() <= 0i64 {
            self.abandonRec(i);
          } else {
            r.timer = wheel.insert(now + grace, token);
          }
        }
      } else {
        // The grace has run out, and the kernel still holds it
        self.abandonRec(i);
      }
    }
    expiries.clear();
  }

  // -------------------------------------------------------------------------
  // Waiting
  // -------------------------------------------------------------------------

  // Wait for answers, at most until 'until', and append them to out: how
  // many (see the package's header, POLL)
  pub fn poll(self &mut, until Instant, out &mut List[Completion]) usize {
    stats.polls = stats.polls + 1u64;
    woken = false;
    imm elsewhere = stats.postsSent + stats.postsDropped + stats.handedOff + stats.handedDropped;
    mut n = 0usize;
    while true {
      self.retryHeld();
      imm now = Instant.now();
      // How long the kernel may keep us: not at all when answers are ready
      // or a timer is due
      mut ms = 0u32;
      if decided.len() == 0usize and now < until {
        mut wakeAt = until;
        match wheel.nextExpiry() {
          case imm s Some {if s.value < wakeAt {wakeAt = s.value;}}
          case is None[Instant] {}
        }
        if heldC.len() > 0usize {
          imm retry = now + Duration.fromNanos(heldRetryNs);
          if retry < wakeAt {wakeAt = retry;}
        }
        if wakeAt > now {ms = self.armFor(wakeAt, now);}
      }
      n = n + self.dequeue(ms, out);
      imm after = Instant.now();
      self.fireTimers(after);
      n = n + self.flush(out);
      if n > 0usize or woken or after >= until {return n;}
      // Answers sent elsewhere -- another loop, a channel, a one-shot, a
      // status slot -- are progress too: the driver may be waiting for its
      // operations to be done
      if stats.postsSent + stats.postsDropped + stats.handedOff + stats.handedDropped != elsewhere {
        return n;
      }
    }
    n;
  }

  // Arm the high-resolution timer for wakeAt (unless it already is) and
  // answer the port's own timeout, a backstop a millisecond past it; INFINITE
  // when wakeAt never comes
  fn armFor(self &mut, wakeAt Instant, now Instant) u32 {
    if wakeAt >= forever() {return infinite;}
    imm left = (wakeAt - now).nanos();
    if packet != 0usize and (not associated or armedFor != wakeAt) {
      // Relative, in 100 ns units: negative
      mut due = 0i64 - (left + 99i64) / 100i64;
      SetWaitableTimer(timer, &due, 0i32, null, null, 0i32);
      armedFor = wakeAt;
      if not associated {
        mut already = 0u8;
        if NtAssociateWaitCompletionPacket(packet, portHandle, timer, keyTimer as *u8, null,
            0i32, 0usize, &mut already as *u8) == 0i32 {
          associated = true;
        }
      }
    }
    imm ms = (left + 999999i64) / 1000000i64 + 1i64;
    if ms >= i64.from(infinite) {infinite - 1u32;} else {u32.from(ms);};
  }

  // One wait in the kernel, for at most ms, and what it brought processed:
  // how many answers posted by other loops went to out
  fn dequeue(self &mut, ms u32, out &mut List[Completion]) usize {
    mut got = 0u32;
    imm ok = GetQueuedCompletionStatusEx(portHandle, entries, batch, &mut got, ms, 0i32);
    if ms != 0u32 {stats.waits = stats.waits + 1u64;}
    if ok == 0i32 or got == 0u32 {
      if ms != 0u32 and ms != infinite {stats.waitTimeouts = stats.waitTimeouts + 1u64;}
      return 0usize;
    }
    imm at = Instant.now();
    stats.dequeued = stats.dequeued + u64.from(got);
    if u64.from(got) > stats.largestBatch {stats.largestBatch = u64.from(got);}
    mut n = 0usize;
    mut k = 0usize;
    while k < usize.from(got) {
      imm e = entries + k;
      imm key = (*e).key;
      if key == keyIo {
        self.complete((*e).ov as *Rec, (*e).bytes, at);
      } elif key == keyJob {
        self.completeJob((*e).ov as *JobBox, at);
      } elif key == keyTimer {
        associated = false;
        stats.timerExpiries = stats.timerExpiries + 1u64;
      } elif key == keyWake {
        woken = true;
        stats.wakes = stats.wakes + 1u64;
      } elif key == keyCancel {
        imm number = u64.from((*e).ov as usize);
        stats.remoteCancels = stats.remoteCancels + 1u64;
        self.cancel(new OpId(u32.from(number & 0xFFFFFFFFu64), u32.from(number >> 32u64)));
      } elif key == keyGroup {
        groupsDirty = true;
      } elif key == keyPost {
        imm block = (*e).ov as *Completion;
        mut c = mem.readRaw[Completion](block);
        libc.free(block as *u8);
        c.delivered = at;
        stats.postsReceived = stats.postsReceived + 1u64;
        if subscribed {
          imm rec = c.record();
          (sub)(&rec);
        }
        out.push(c);
        n = n + 1usize;
      }
      k = k + 1usize;
    }
    if groupsDirty {self.sweepGroups();}
    n;
  }

  // -------------------------------------------------------------------------
  // Its death: cancel and drain (I18)
  // -------------------------------------------------------------------------

  fn final(self &uni) {
    port.closed.store(true);
    // Every handle's operations cancelled, all before any is closed (a
    // socket closed first would end its peer's receive as the end of the
    // stream, not as the cancel it is), then every handle closed
    mut h = 0usize;
    while h < handles.len() {
      if handles[h].kind != hFree {CancelIoEx(handles[h].raw, null);}
      h = h + 1usize;
    }
    h = 0usize;
    while h < handles.len() {
      imm e = &mut handles[h];
      if e.kind != hFree {
        if e.kind == hFile {CloseHandle(e.raw);} else {closesocket(e.raw);}
        e.kind = hFree;
      }
      h = h + 1usize;
    }
    // Connections still being made hold sockets of their own; timers answer
    // Cancelled; jobs still queued are taken out, and those running are left
    // to their threads, which find this loop gone and drop them
    mut i = 0u32;
    while i < recCount {
      imm p = self.recAt(i);
      imm r = p as &mut Rec;
      if r.state == stFlight or r.state == stAbandoned {
        if r.kind == diag.kindTimer {
          self.decide(i, diag.outcomeCancelled, 0usize, 0u32);
        } elif boxed(r.kind) {
          if r.kind == diag.kindExternal and r.job as usize != 0usize {(*r.job).asked.store(1u32);}
          if r.job as usize != 0usize and removeBox(r.job) {
            r.buf <=> (r.job as &mut JobBox).buf;
            dropBox(r.job);
          }
          r.job = null;
          self.decide(i, diag.outcomeCancelled, 0usize, 0u32);
        } elif r.kind == diag.kindConnect and r.newSock != invalidHandle {
          CancelIoEx(r.newSock, null);
        } else {
          CancelIoEx(r.handle, p as *u8);
        }
      }
      i = i + 1u32;
    }
    // Wait until the kernel has given back every record, and deliver what
    // was owed to other loops and threads; what was owed here dies, buffers
    // going home
    mut scratch = List[Completion].empty();
    self.flush(&mut scratch);
    scratch.clear();
    while kernelHeld > 0u32 {
      self.dequeue(1000u32, &mut scratch);
      self.flush(&mut scratch);
      scratch.clear();
    }
    // Answers a full channel still holds back are tried once more, then go
    self.retryHeld();
    stats.handedDropped = stats.handedDropped + u64.from(heldC.len());
    heldC.clear();
    heldT.clear();
    if packet != 0usize {
      NtCancelWaitCompletionPacket(packet, 1u8);
      CloseHandle(packet);
    }
    if timer != 0usize {CloseHandle(timer);}
    // The table's blocks, every record's empty values with them
    mut b = 0usize;
    while b < blocks.len() {
      imm block = *blocks[b];
      mut j = 0u32;
      while j < recsPerBlock {
        mem.finalize[Rec](block + usize.from(j));
        j = j + 1u32;
      }
      libc.free(block as *u8);
      b = b + 1usize;
    }
    libc.free(entries as *u8);
  }
}
