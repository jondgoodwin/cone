// The Loop: the records it works on, its handle table, its timers and its wait.
//
// How it is built. Every operation and timer is ONE RECORD (record.cone), which
// owns it, and so its buffer, its group and its addresses, from its start until
// it is dissolved (I2, I18). The old API's records come from the Loop's own pool
// (OpPool[OldAsk]: the target and the token kept with each); an asker's come
// from its own pool and are started by 'lp.start'. A record begins with the
// OVERLAPPED the kernel holds, so the address a completion hands back is the
// record's. A record in flight is on exactly one list, so that nothing is
// walked that is not in flight: its handle's reads or writes (what
// 'cancelHandle' and a handle's close reach; on Linux the wait queue epoll's
// readiness tries in order), or, when no handle names it, the Loop's own (a
// timer, a job, an external operation, Windows' connect). One in a cancel group
// is also on the grouped list, which is all 'sweepGroups' walks.
//
// A record is in flight (the kernel, the wheel or the blocking pool holds
// it); decided (its outcome is known, and it waits in 'decided' to be
// answered at the end of this pass of poll); or abandoned (answered early, a
// prompt TimedOut, while the kernel or the pool still holds it and its
// buffer: it waits for the kernel's completion, or for its job to come home,
// and is then dissolved, its buffer going home). A job's record (a pool job,
// an external operation) is AWAY from its queueing until it is posted home:
// its job part and its buffer are the pool's thread's then (pool.cone), and
// the loop does not wait for it at its death (it lets it go: its thread
// dissolves it when it comes home). Every answer is made in one place:
// 'deliver' for the old API, which DISSOLVES the record (reads it whole and
// takes it apart with field lists) into a Completion sent where its target
// says, and 'toDone' for an asker's, which puts the record on the done list
// that 'takeDone' hands over; either moves the generation on when the answer
// goes early, so a record is answered once, which is the exactly-once
// invariant (I1) by construction. A decision made before the kernel has
// answered (a prompt TimedOut) is replaced by the kernel's own outcome if the
// kernel answers before the decision is answered: the reply says how the
// operation really ended whenever the loop can know it.
//
// Timers are a timewheel.Wheel, its token the record's address (the wheel's
// own TimerId, kept in the record, tells a current entry from a stale one):
// a timer record (after) fires Done; an operation's deadline (submitBy,
// submitIn, an asker's deadline) asks its cancel, then gives the kernel
// 'grace' to answer the cancel before answering TimedOut without the buffer.
// The wait: GetQueuedCompletionStatusEx, for at most a batch of 128, its
// timeout the nearer of 'until' and the wheel's next expiry. The
// high-resolution waitable timer is armed for that instant and associated
// with the port through a wait completion packet, which the kernel queues on
// the port when the timer is signalled; a packet is good for one signal, so it
// is associated again when its packet has been taken. The port's own timeout
// is kept as a backstop (a millisecond past the instant) in case the packet
// could not be made: then a wait may end up to a timer tick late.

// Whether an operation of kind k is on its handle's writes (else its reads)
fn writes(k: u32) bool {
  k == diag.kindSend || k == diag.kindSendTo || k == diag.kindWriteAt || k == diag.kindConnect
}

// What a handle is (a free cell of the handle table holds no entry at all)
const hSocket = 1u32;
const hListener = 2u32;
const hFile = 3u32;
const hDatagram = 4u32;       // a bound UDP socket

// An entry of the handle table (a slots.SlotTable: its cell's number and
// generation are the Handle's)
struct HEntry {
  pub raw: usize;          // the OS's: Windows' handle or socket, Linux's descriptor
  pub kind: u32;
  pub family: u16;
  pub hint: u32;           // the hint word, kept for the layer that opened it (lp.hint, lp.setHint)
  // The operations in flight on it, per direction, in the order started: what
  // cancelHandle and close reach, and on Linux the wait queues readiness tries
  // in order (linux.cone)
  pub reads: *OpCore;
  pub readsTail: *OpCore;
  pub writes: *OpCore;
  pub writesTail: *OpCore;
}

// An answer a full channel held back, and the channel's sender (a clone of
// its target's) to try again
struct Held {
  c: Completion;
  tx: Sender[Completion];
}

// Linux: a socket operation asked to end, answered at the next wait: its
// record and the record's generation then
struct Asked {
  p: *OpCore;
  gen: u32;
}

// The most completions one wait takes from the kernel
const batch = 128u32;

// The longest a poll waits while answers are held for a full channel: they
// are tried again after it
const heldRetryNs = 1000000i64;

fn nullCore() *OpCore {null}

// ---------------------------------------------------------------------------
// Loop
// ---------------------------------------------------------------------------

// The completion loop (see the package's header, THE LOOP). Driven by one
// thread
pub struct Loop {
  loopId: u64;
  driverGen: u32;          // the last generation 'nextDriverGen' handed out
  port: Arc[imm, Port];
  portHandle: usize;
  pool: OpPool[OldAsk];    // the old API's records
  kernelHeld: u32;         // records the kernel holds: it has not completed them
  grouped: u32;            // records on the grouped list
  groupHead: *OpCore;      // the records in flight in a cancel group
  groupsDirty: bool;       // a group's cancel has been posted: look at the grouped records
  unbound: *OpCore;        // the records in flight that no handle names
  unboundTail: *OpCore;
  decided: List[*OpCore];
  done: List[*OpCore];     // an asker's records answered, for takeDone
  cancels: List[Asked];    // Linux: socket operations asked to end, answered at the next wait (linux.cone)
  held: List[Held];        // answers held back by a full channel
  handles: SlotTable[HEntry];
  wheel: Wheel;
  expiries: List[Expiry];
  entries: *OverlappedEntry;   // Windows: what one wait takes from the port
  events: *EpollEvent;     // Linux: what one wait takes from epoll
  timer: usize;            // Windows: the high-resolution waitable timer. Linux: the timerfd
  packet: usize;           // its wait completion packet, or 0 when none could be made (Windows)
  associated: bool;        // the packet is associated, and not yet taken from the port; Linux: the timerfd is armed and not yet taken
  armedFor: Instant;       // the instant the timer is set for
  woken: bool;
  dying: bool;             // its death has begun: a job's record come home is dissolved, its answer abandoned
  grace: Duration;         // after a deadline, how long the kernel has to give the buffer back
  stats: diag.Counters;
  sub: diag.Subscriber;
  subscribed: bool;

  // A new loop for the calling thread, or the reason there is none
  pub fn make() Result[Loop, IoError] {
    var port = 0usize;
    var wake = 0usize;
    var tick = 0usize;
    var code = 0u32;
    code, port, wake, tick = openPort();
    if code != 0u32 {return Error[Loop, IoError](IoError(code));}
    Ok[Loop, IoError](Loop.assemble(port, wake, tick))
  }

  // A new loop; a panic, at the caller's line, if there can be none. (It
  // does not unwrap make's Result: Cone moves no value out of a matched
  // variant's field, and a Loop has no empty value to swap in)
  pub fn mustMake(file: &Array[u8] = srcFile(), line: u32 = srcLine()) Loop {
    var port = 0usize;
    var wake = 0usize;
    var tick = 0usize;
    var code = 0u32;
    code, port, wake, tick = openPort();
    if code != 0u32 {panic("iocore: Loop.make failed: no completion port", file, line);}
    Loop.assemble(port, wake, tick)
  }

  // The loop around a new port (Linux: the epoll instance, and the eventfd
  // and timerfd it watches)
  fn assemble(port: usize, wake: usize, tick: usize) Loop {
    var timer = tick;
    var packet = 0usize;
    var entries = null as *OverlappedEntry;
    var events = null as *EpollEvent;
    if isWindows() {
      // The high-resolution timer (Windows 10 1803 on); an ordinary one, as
      // fine as the system's tick, before it
      timer = CreateWaitableTimerExW(null, null, timerHighResolution, timerAllAccess);
      if timer == 0usize {
        timer = CreateWaitableTimerExW(null, null, 0u32, timerAllAccess);
      }
      if NtCreateWaitCompletionPacket(&mut packet, genericAll, null) != 0i32 {
        packet = 0usize;
      }
      entries = libc.malloc(usize.from(batch) * mem.sizeof[OverlappedEntry]()) as *OverlappedEntry;
    } else {
      events = libc.malloc(usize.from(batch) * mem.sizeof[EpollEvent]()) as *EpollEvent;
    }
    let shared = Arc[imm, Port](Port(if isWindows() {port} else {wake}, Atomic[bool].of(false),
      Atomic[u32].of(0u32), Mutex.make(), null, null, null, null, Atomic[u32].of(0u32)));
    Loop(
      loopId: diag.nextLoopId(), driverGen: 0u32, port: shared, portHandle: port,
      pool: OpPool[OldAsk].make(), kernelHeld: 0u32,
      grouped: 0u32, groupHead: null, groupsDirty: false, unbound: null, unboundTail: null,
      decided: List[*OpCore].empty(), done: List[*OpCore].empty(), cancels: List[Asked].empty(),
      held: List[Held].empty(),
      handles: SlotTable[HEntry].make(64u32),
      wheel: Wheel.make(Instant.now()), expiries: List[Expiry].empty(),
      entries: entries, events: events, timer: timer, packet: packet, associated: false,
      armedFor: Instant(), woken: false, dying: false, grace: Duration.fromMillis(1i64),
      stats: diag.Counters.zero(), sub: &diag.noSubscriber, subscribed: false)
  }

  // Its id, unique in the process, as its diagnostics records name it
  pub fn id(self: &) u64 {loopId}

  // A generation, 1 to 255, in turn, for a layer above that gives its
  // tokens a mark of its own on this loop (httpconn's drivers): two that
  // ask in turn have different ones until 255 more have asked in between,
  // so a late completion of a layer that is gone does not look like the
  // answer a later one with the same mark is waiting for. Per loop; no
  // global
  pub fn nextDriverGen(self: &mut) u64 {
    driverGen = if driverGen >= 255u32 {1u32} else {driverGen + 1u32};
    u64.from(driverGen)
  }

  // Operations and timers submitted and not yet answered
  pub fn inFlight(self: &) u64 {stats.inFlight}

  // Its counters, as they are now
  pub fn counters(self: &) diag.Counters {stats}

  // Hand every answer delivered here to s, as a diag.OpRecord
  pub fn subscribe(self: &mut, s: diag.Subscriber) {
    sub = s;
    subscribed = true;
  }

  // A Waker for this loop: Sendable; copied to share
  pub fn waker(self: &) Waker {Waker(port)}

  // How long after an operation's deadline the loop waits for the kernel
  // (or the pool) to answer its cancel and give the buffer back, before it
  // answers TimedOut without the buffer (see the package's header,
  // DEADLINES). 1 ms unless set; zero answers at the deadline itself
  pub fn setGrace(self: &mut, d: Duration) {grace = d;}

  // A Request for operation id: a handle whose death cancels it, which may
  // be held on any thread (see the package's header, REQUESTS)
  pub fn request(self: &, id: OpId) Request {Request(Waker(port), id, !id.isNone())}

  // The old API's records: how many are taken (in flight, decided, or
  // abandoned to the kernel), and how many its pool has made
  pub fn records(self: &) u32 {pool.inUse()}
  pub fn recordsMade(self: &) u32 {pool.size()}

  // -------------------------------------------------------------------------
  // Handles
  // -------------------------------------------------------------------------

  // A TCP socket listening at addr, for Accept; addr's port 0 has the OS
  // choose one, which localAddr tells
  pub fn listen(self: &mut, addr: SocketAddr, backlog: i32 = 128i32) Result[Handle, IoError] {
    let s = tcpSocket(addr.family());
    if s == invalidHandle {return Error[Handle, IoError](IoError(wsaError()));}
    var a = addr;
    // Winsock's listen, named through the module: Loop's own 'listen' is
    // the bare name here
    if !isWindows() {
      // A restarted server may bind its port again while old connections linger
      var one = 1i32;
      setsockopt(s, solSocketLx, soReuseAddr, &mut one as *u8, 4i32);
    }
    if bind(s, &mut a as *u8, a.size) != 0i32 || iocore.listen(s, backlog) != 0i32 {
      let code = wsaError();
      closeRaw(hSocket, s);
      return Error[Handle, IoError](IoError(code));
    }
    if isWindows() {
      if CreateIoCompletionPort(s, portHandle, keyIo, 0u32) == 0usize {
        let code = GetLastError();
        closesocket(s);
        return Error[Handle, IoError](IoError(code));
      }
      return Ok[Handle, IoError](self.register(s, hListener, addr.family()));
    }
    // Linux: epoll is told of it once it is a handle
    var code = 0u32;
    var h = Handle.none();
    code, h = lxAdopt(self, s, hListener, addr.family());
    if code != 0u32 {return Error[Handle, IoError](IoError(code));}
    Ok[Handle, IoError](h)
  }

  // A UDP socket bound to addr, for RecvFrom and SendTo; addr's port 0 has
  // the OS choose one, which localAddr tells. It is not connected: every
  // datagram it sends names its destination, and every one it receives
  // names its sender
  pub fn bindUdp(self: &mut, addr: SocketAddr) Result[Handle, IoError] {
    let s = udpSocket(addr.family());
    if s == invalidHandle {return Error[Handle, IoError](IoError(wsaError()));}
    var a = addr;
    if bind(s, &mut a as *u8, a.size) != 0i32 {
      let code = wsaError();
      closeRaw(hDatagram, s);
      return Error[Handle, IoError](IoError(code));
    }
    if isWindows() {
      // An ICMP "port unreachable" for a datagram sent earlier must not make
      // a later receive on this socket fail (Winsock's default)
      var off = 0i32;
      var got = 0u32;
      WSAIoctl(s, sioUdpConnReset, &mut off as *u8, 4u32, null, 0u32, &mut got, null, null);
      if CreateIoCompletionPort(s, portHandle, keyIo, 0u32) == 0usize {
        let code = GetLastError();
        closesocket(s);
        return Error[Handle, IoError](IoError(code));
      }
      return Ok[Handle, IoError](self.register(s, hDatagram, addr.family()));
    }
    var code = 0u32;
    var h = Handle.none();
    code, h = lxAdopt(self, s, hDatagram, addr.family());
    if code != 0u32 {return Error[Handle, IoError](IoError(code));}
    Ok[Handle, IoError](h)
  }

  // A bound UDP socket; a panic, at the caller's line, if there can be none
  pub fn mustBindUdp(self: &mut, addr: SocketAddr, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Handle {
    match self.bindUdp(addr) {
      case let Ok(r) {r}
      case let Error(e) {panic("iocore: bindUdp failed", file, line)}
    }
  }

  // A listening socket; a panic, at the caller's line, if there can be none
  pub fn mustListen(self: &mut, addr: SocketAddr, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Handle {
    match self.listen(addr) {
      case let Ok(r) {r}
      case let Error(e) {panic("iocore: listen failed", file, line)}
    }
  }

  // The address a socket is bound to
  pub fn localAddr(self: &, h: Handle) Result[SocketAddr, IoError] {
    let i = self.handleIndex(h);
    if i == noEntry {return Error[SocketAddr, IoError](IoError(errorInvalidHandle));}
    let e = handles.at(i) as &HEntry;
    var a = SocketAddr(Array[u8, 28]() <- fill 0u8, 28i32);
    var len = 28i32;
    if getsockname(e.raw, &mut a as *u8, &mut len) != 0i32 {
      return Error[SocketAddr, IoError](IoError(wsaError()));
    }
    a.size = len;
    Ok[SocketAddr, IoError](a)
  }

  // The address of a connected socket's peer
  pub fn peerAddr(self: &, h: Handle) Result[SocketAddr, IoError] {
    let raw = self.rawOf(h, hSocket);
    if raw == invalidHandle {return Error[SocketAddr, IoError](IoError(errorInvalidHandle));}
    var a = SocketAddr(Array[u8, 28]() <- fill 0u8, 28i32);
    var len = 28i32;
    if getpeername(raw, &mut a as *u8, &mut len) != 0i32 {
      return Error[SocketAddr, IoError](IoError(wsaError()));
    }
    a.size = len;
    Ok[SocketAddr, IoError](a)
  }

  // A file, for ReadAt and WriteAt
  pub fn openFile(self: &mut, path: &Path, access: Access) Result[Handle, IoError] {
    let text: &Array[u8] = path.view();
    if isWindows() {
      let w = widen(text);
      if w as usize == 0usize {return Error[Handle, IoError](IoError(errorNoUnicodeTranslation));}
      var want = genericRead;
      var how = openExisting;
      match access {
        case is Access.Read {}
        case is Access.Create {want = genericRead | genericWrite; how = createAlways;}
        case is Access.Update {want = genericRead | genericWrite; how = openAlways;}
      }
      let h = CreateFileW(w, want, shareAll, null, how, flagOverlapped, 0usize);
      libc.free(w as *u8);
      if h == invalidHandle {return Error[Handle, IoError](IoError(GetLastError()));}
      if CreateIoCompletionPort(h, portHandle, keyIo, 0u32) == 0usize {
        let code = GetLastError();
        CloseHandle(h);
        return Error[Handle, IoError](IoError(code));
      }
      Ok[Handle, IoError](self.register(h, hFile, 0u16))
    } else {
      // Not epoll's: a file is read and written by the pool's threads
      let p = cstrCopy(text);
      if p as usize == 0usize {return Error[Handle, IoError](IoError(errorNotEnoughMemory));}
      var flags = oRdonly;
      match access {
        case is Access.Read {}
        case is Access.Create {flags = oRdwr | oCreat | oTrunc;}
        case is Access.Update {flags = oRdwr | oCreat;}
      }
      let fd = sysOpen(p, flags | epollCloexec, 438u32);      // 0666, less the umask
      libc.free(p);
      if fd < 0i32 {return Error[Handle, IoError](IoError(errnoCode(lastErrno())));}
      Ok[Handle, IoError](self.register(usize.from(fd), hFile, 0u16))
    }
  }

  // Whether h names something this loop holds
  pub fn isOpen(self: &, h: Handle) bool {self.handleIndex(h) != noEntry}

  // The hint word of h: a u32 kept for the layer that opened it (aio's calm
  // bit), 0 when it is opened; 0 for a handle that names nothing
  pub fn hint(self: &, h: Handle) u32 {
    let p = handles.get(Slot(h.index, h.gen));
    if p as usize == 0usize {return 0u32;}
    (*p).hint
  }

  // Set h's hint word: false, and nothing set, if h names nothing
  pub fn setHint(self: &mut, h: Handle, v: u32) bool {
    let p = handles.get(Slot(h.index, h.gen));
    if p as usize == 0usize {return false;}
    (*p).hint = v;
    true
  }

  // Close what h names: every operation in flight on it is cancelled (each
  // still answers), and h names nothing from now on. False if it named
  // nothing already
  pub fn close(self: &mut, h: Handle) bool {
    let i = self.handleIndex(h);
    if i == noEntry {return false;}
    // Linux: what waits on it is answered Cancelled now (a job already
    // queued on a file is cancelled by the pool's own record)
    lxCancelAll(self, i);
    lxCancelFiles(self, h);
    let e = handles.at(i) as &HEntry;
    if isWindows() {CancelIoEx(e.raw, null);}
    self.detachLists(i);
    closeRaw(e.kind, e.raw);
    handles.removeAt(i);
    true
  }

  // A connected socket's sending side is finished (a half-close: TCP's FIN
  // goes after what was sent): its peer's receive ends, Done(0), while this
  // side can still receive. 0, or Winsock's error; a send submitted after
  // it fails. ERROR_INVALID_HANDLE when h is no connected socket
  pub fn shutdown(self: &mut, h: Handle) u32 {
    let raw = self.rawOf(h, hSocket);
    if raw == invalidHandle {return errorInvalidHandle;}
    if iocore.shutdown(raw, sdSend) != 0i32 {return wsaError();}
    0u32
  }

  // Close a connected socket abortively: its peer sees the connection
  // reset (RST), not finished, and what was not yet sent is dropped. As
  // 'close' otherwise: everything in flight on it is cancelled, and h names
  // nothing from now on. False if it named no socket
  pub fn reset(self: &mut, h: Handle) bool {
    let i = self.handleIndex(h);
    if i == noEntry {return false;}
    if (*handles.at(i)).kind != hSocket {return false;}
    lxCancelAll(self, i);
    let e = handles.at(i) as &HEntry;
    if isWindows() {CancelIoEx(e.raw, null);}
    self.detachLists(i);
    resetSocket(e.raw);
    handles.removeAt(i);
    true
  }

  fn register(self: &mut, raw: usize, kind: u32, family: u16) Handle {
    let s = handles.add(HEntry(raw, kind, family, 0u32, null, null, null, null));
    Handle(s.index, s.gen)
  }

  // h's entry, or noEntry if h names nothing
  fn handleIndex(self: &, h: Handle) u32 {
    if handles.get(Slot(h.index, h.gen)) as usize == 0usize {return noEntry;}
    h.index
  }

  // The OS handle h names, if it is of kind; invalidHandle if not
  fn rawOf(self: &, h: Handle, kind: u32) usize {
    let i = self.handleIndex(h);
    if i == noEntry {return invalidHandle;}
    let e = handles.at(i) as &HEntry;
    if e.kind != kind {return invalidHandle;}
    e.raw
  }

  // -------------------------------------------------------------------------
  // The lists a record in flight is on
  // -------------------------------------------------------------------------

  // Record p joins the end of a list: its handle's reads or writes, or the
  // Loop's own (onLoop). Its handle names an entry
  fn linkSide(self: &mut, p: *OpCore, side: u32) {
    let r = p as &mut OpCore;
    r.side = side;
    r.hnext = null;
    if side == onLoop {
      r.hprev = unboundTail;
      if unboundTail as usize == 0usize {unbound = p;} else {(*unboundTail).hnext = p;}
      unboundTail = p;
      return;
    }
    let e = handles.get(Slot(r.handle.index, r.handle.gen)) as &mut HEntry;
    if side == onReads {
      r.hprev = e.readsTail;
      if e.readsTail as usize == 0usize {e.reads = p;} else {(*e.readsTail).hnext = p;}
      e.readsTail = p;
    } else {
      r.hprev = e.writesTail;
      if e.writesTail as usize == 0usize {e.writes = p;} else {(*e.writesTail).hnext = p;}
      e.writesTail = p;
    }
  }

  // Record p leaves the list it is on, if it is on one
  fn unlinkSide(self: &mut, p: *OpCore) {
    let r = p as &mut OpCore;
    let side = r.side;
    if side == onNone {return;}
    let prev = r.hprev;
    let next = r.hnext;
    r.side = onNone;
    r.hprev = null;
    r.hnext = null;
    if side == onLoop {
      if prev as usize == 0usize {unbound = next;} else {(*prev).hnext = next;}
      if next as usize == 0usize {unboundTail = prev;} else {(*next).hprev = prev;}
      return;
    }
    // A closed handle's lists were let go at its close (detachLists), which
    // took every record off them: an entry is there for a record still on one
    let ep = handles.get(Slot(r.handle.index, r.handle.gen));
    if ep as usize == 0usize {return;}
    let e = ep as &mut HEntry;
    if side == onReads {
      if prev as usize == 0usize {e.reads = next;} else {(*prev).hnext = next;}
      if next as usize == 0usize {e.readsTail = prev;} else {(*next).hprev = prev;}
    } else {
      if prev as usize == 0usize {e.writes = next;} else {(*prev).hnext = next;}
      if next as usize == 0usize {e.writesTail = prev;} else {(*next).hprev = prev;}
    }
  }

  // Handle entry i is about to go: every record on its lists leaves them
  // (what is still the kernel's completes later, on no list)
  fn detachLists(self: &mut, i: u32) {
    let e = handles.at(i) as &mut HEntry;
    var p = e.reads;
    while p as usize != 0usize {
      let next = (*p).hnext;
      (*p).side = onNone;
      (*p).hprev = null;
      (*p).hnext = null;
      p = next;
    }
    p = e.writes;
    while p as usize != 0usize {
      let next = (*p).hnext;
      (*p).side = onNone;
      (*p).hprev = null;
      (*p).hnext = null;
      p = next;
    }
    e.reads = null;
    e.readsTail = null;
    e.writes = null;
    e.writesTail = null;
  }

  // Record p, started and held, goes on the list it belongs on while in
  // flight (a Linux socket operation waiting is on its handle's queue already)
  fn place(self: &mut, p: *OpCore) {
    let r = p as &mut OpCore;
    if r.side != onNone {return;}
    let k = r.kind;
    if (jobKind(k) && k != diag.kindReadAt && k != diag.kindWriteAt) || (isWindows() && k == diag.kindConnect) {
      self.linkSide(p, onLoop);
      return;
    }
    if !isWindows() && k != diag.kindReadAt && k != diag.kindWriteAt {return;}
    self.linkSide(p, if writes(k) {onWrites} else {onReads});
  }

  // Record p joins the grouped list
  fn linkGroup(self: &mut, p: *OpCore) {
    let r = p as &mut OpCore;
    if r.inGroup {return;}
    r.inGroup = true;
    r.gprev = null;
    r.gnext = groupHead;
    if groupHead as usize != 0usize {(*groupHead).gprev = p;}
    groupHead = p;
    grouped = grouped + 1u32;
  }

  // Record p leaves the grouped list, if it is on it
  fn unlinkGroup(self: &mut, p: *OpCore) {
    let r = p as &mut OpCore;
    if !r.inGroup {return;}
    r.inGroup = false;
    let prev = r.gprev;
    let next = r.gnext;
    if prev as usize == 0usize {groupHead = next;} else {(*prev).gnext = next;}
    if next as usize != 0usize {(*next).gprev = prev;}
    r.gprev = null;
    r.gnext = null;
    grouped = grouped - 1u32;
  }

  // -------------------------------------------------------------------------
  // Deciding and answering
  // -------------------------------------------------------------------------

  // The wheel's token for a record: its address
  fn tokenOf(self: &, p: *OpCore) u64 {u64.from(p as usize)}

  // The outcome of record p is known: it waits to be answered at the end of
  // this pass of poll (or the next one). A record decided already and not
  // yet answered -- a prompt TimedOut the kernel has now answered after
  // all -- takes the kernel's outcome instead, its buffer back with it
  fn decide(self: &mut, p: *OpCore, status: u32, n: usize, code: u32) {
    let r = p as &mut OpCore;
    r.status = status;
    r.n = n;
    r.code = code;
    r.early = false;
    if r.state == stDecided {return;}
    r.state = stDecided;
    if !r.timer.isNone() {
      wheel.cancel(r.timer);
      r.timer = TimerId.none();
    }
    decided.push(p);
  }

  // Record p's deadline has passed and the kernel (or the pool) still holds
  // it: answer TimedOut now, without its buffer, which goes home when the
  // kernel gives it back
  fn abandonRec(self: &mut, p: *OpCore) {
    // Linux: nothing of a socket operation is the kernel's to give back, so
    // it is answered TimedOut with its buffer, never promptly without it
    if !isWindows() && socketKind((p as &OpCore).kind) {
      lxCancel(self, p, diag.outcomeTimedOut);
      return;
    }
    self.decide(p, diag.outcomeTimedOut, 0usize, 0u32);
    (p as &mut OpCore).early = true;
  }

  // Answer an old-API record and send the answer where its target says: how
  // many went to out. The record is dissolved -- read whole, and taken apart
  // by field lists, its buffer into the answer -- unless it is answered
  // early while the kernel (or the pool) still holds it: then the answer
  // goes without the buffer, and the record waits (abandoned), its id naming
  // nothing from now on
  fn deliver(self: &mut, p: *OpCore, out: &mut List[Completion], at: Instant) usize {
    let r = p as &mut OpCore;
    self.unlinkGroup(p);
    if r.early {stats.promptTimeouts = stats.promptTimeouts + 1u64;}
    stats.count(r.status);
    let id = r.id();
    let peer = r.peer();
    let kind = r.kind;
    let status = r.status;
    let n = r.n;
    let code = r.code;
    let made = r.newHandle;
    let submitted = r.submitted;
    let dequeued = r.dequeued;
    if r.early {
      r.gen = nextGen(r.gen);
      r.state = stAbandoned;
      // The target is used where it lies, in the record (no other reference
      // reaches it while the answer is sent)
      let a = &mut (*(p as *OpRec[OldAsk])).ask;
      let c = Completion(loopId, id, a.token, kind, status, n, code, IoBuf.empty(), made, peer,
        submitted, dequeued, at);
      return self.send(c, &mut a.target as *Target as &uni Target, out);
    }
    self.unlinkSide(p);
    let rec = pool.dissolveHere(p as *OpRec[OldAsk]);
    let core, ask = rec.(core, ask);
    let buf = core.(buf);
    let target, token = ask.(target, token);
    let b = match buf {
      case var Some(x) {x}
      else {IoBuf.empty()}
    };
    var t = target;
    let c = Completion(loopId, id, token, kind, status, n, code, b, made, peer, submitted, dequeued, at);
    self.send(c, &uni t, out)
  }

  // Answer an asker's record: it goes on the done list, for takeDone. One
  // answered early (TimedOut while the kernel or the pool still holds it)
  // stays the kernel's: its asker answers its own and leaves it, and it is on
  // the done list again, late, when the kernel gives it back
  fn toDone(self: &mut, p: *OpCore, at: Instant) {
    let r = p as &mut OpCore;
    self.unlinkGroup(p);
    if r.early {stats.promptTimeouts = stats.promptTimeouts + 1u64;}
    stats.count(r.status);
    if subscribed {
      let rec = diag.OpRecord(loopId, r.id().number(), r.kind, r.status, r.code, u64.from(r.n), 0u64,
        r.submitted, r.dequeued, at);
      (sub)(&rec);
    }
    if r.early {
      r.gen = nextGen(r.gen);
      r.state = stAbandoned;
    } else {
      self.unlinkSide(p);
      r.state = stDone;
    }
    r.listed = true;
    done.push(p);
  }

  // An abandoned record the kernel (or the pool) has given back: the old
  // API's is dissolved, its buffer going home; an asker's is on the done
  // list once more, late, for its asker to dissolve. 'late' counts it a late
  // return
  fn ended(self: &mut, p: *OpCore, late: bool) {
    if late {stats.lateReturns = stats.lateReturns + 1u64;}
    self.unlinkSide(p);
    let r = p as &mut OpCore;
    if r.own {
      // Read out whole, and let go: its buffer goes home, its target dies
      let gone = pool.dissolveHere(p as *OpRec[OldAsk]);
      return;
    }
    r.late = true;
    r.state = stDone;
    r.listed = true;
    done.push(p);
  }

  // Hand the subscriber an answer this loop sends to another thread (one
  // posted to another loop is recorded there)
  fn note(self: &, c: &Completion) {
    if subscribed {
      let rec = c.record();
      (sub)(&rec);
    }
  }

  // Send answer c where t says: to out (Here: 1) or elsewhere (0). A
  // channel's send may find it full: the answer is held, with a clone of the
  // channel's sender, and tried again
  fn send(self: &mut, c: Completion, t: &uni Target, out: &mut List[Completion]) usize {
    var n = 0usize;
    match t {
      case let &uni Post(p) {
        if p.waker.post(c) {
          stats.postsSent = stats.postsSent + 1u64;
        } else {
          stats.postsDropped = stats.postsDropped + 1u64;
        }
      }
      case let &uni Chan(ch) {
        self.note(&c);
        match ch.tx.trySend(c) {
          case var Some(back) {
            if ch.tx.isClosed() {
              stats.handedDropped = stats.handedDropped + 1u64;
            } else {
              stats.held = stats.held + 1u64;
              held.push(Held(back, ch.tx.clone()));
            }
          }
          else {stats.handedOff = stats.handedOff + 1u64;}
        }
      }
      case var &uni Once(o) {
        self.note(&c);
        match o.tx.send(c) {
          case is None[Completion] {stats.handedOff = stats.handedOff + 1u64;}
          else {stats.handedDropped = stats.handedDropped + 1u64;}
        }
      }
      case let &uni Status(s) {
        self.note(&c);
        s.board.put(s.slot, c);
        stats.handedOff = stats.handedOff + 1u64;
      }
      case var &uni Hook(h) {
        self.note(&c);
        h.sink.give(c);
        stats.handedOff = stats.handedOff + 1u64;
      }
      else {
        self.note(&c);
        out.push(c);
        n = 1usize;
      }
    }
    n
  }

  // Try again the answers a full channel held back: the list is drained and
  // rebuilt of those still held (those taken, or whose receiver has gone,
  // are done with)
  fn retryHeld(self: &mut) {
    if held.len() == 0usize {return;}
    var keep = List[Held].empty();
    each h in held.drain() {
      let c, tx = h.(c, tx);
      match tx.trySend(c) {
        case var Some(back) {
          if tx.isClosed() {
            stats.handedDropped = stats.handedDropped + 1u64;
          } else {
            keep.push(Held(back, tx));
          }
        }
        else {stats.handedOff = stats.handedOff + 1u64;}
      }
    }
    held = keep;
  }

  // Answer every decided record: how many answers went to out
  fn flush(self: &mut, out: &mut List[Completion]) usize {
    if decided.len() == 0usize {return 0usize;}
    let at = Instant.now();
    var n = 0usize;
    var k = 0usize;
    while k < decided.len() {
      let p = *decided[k];
      if (p as &OpCore).own {
        n = n + self.deliver(p, out, at);
      } else {
        self.toDone(p, at);
      }
      k = k + 1usize;
    }
    decided.clear();
    n
  }

  // -------------------------------------------------------------------------
  // Submitting: the old API
  // -------------------------------------------------------------------------

  // Start an operation; its answer goes where 'to' says (see the package's
  // header, OPERATIONS and TARGETS). Its id, for cancel
  pub fn submit(self: &mut, op: Op, to: Target, file: &Array[u8] = srcFile(), line: u32 = srcLine()) OpId {
    self.startOp(op, to, forever(), None, file, line)
  }

  // Start an operation that answers TimedOut if it has not finished by
  // deadline (see the package's header, DEADLINES)
  pub fn submitBy(self: &mut, op: Op, to: Target, deadline: Instant,
      file: &Array[u8] = srcFile(), line: u32 = srcLine()) OpId {
    self.startOp(op, to, deadline, None, file, line)
  }

  // Start an operation in a cancel group: the group's cancel cancels it, and
  // its deadline is the tighter of 'deadline' and the group's (forever()
  // for the group's alone). Answered Cancelled at once, never started, when
  // the group is cancelled already (see the package's header, CANCEL GROUPS)
  pub fn submitIn(self: &mut, op: Op, to: Target, group: CancelGroup, deadline: Instant,
      file: &Array[u8] = srcFile(), line: u32 = srcLine()) OpId {
    self.startOp(op, to, deadline, Some[CancelGroup](group), file, line)
  }

  // A timer: it answers Done (n 0) at 'at', to its target, unless cancelled
  pub fn after(self: &mut, at: Instant, to: Target, file: &Array[u8] = srcFile(), line: u32 = srcLine()) OpId {
    self.startTimer(at, to, None, file, line)
  }

  // A timer in a cancel group: the group's cancel cancels it
  pub fn afterIn(self: &mut, at: Instant, to: Target, group: CancelGroup,
      file: &Array[u8] = srcFile(), line: u32 = srcLine()) OpId {
    self.startTimer(at, to, Some[CancelGroup](group), file, line)
  }

  // An external operation: one ended by whoever holds the Completer this
  // answers -- another thread, a GPU fence's watcher -- from any thread,
  // its answer delivered where 'to' says as any operation's is (see the
  // package's header, EXTERNAL OPERATIONS). buf is lent to the completer
  // (IoBuf.empty() for none) and comes back in the answer
  pub fn external(self: &mut, to: Target, buf: IoBuf, file: &Array[u8] = srcFile(), line: u32 = srcLine()) Completer {
    self.startExternal(to, buf, forever(), None, file, line)
  }

  // An external operation in a cancel group, with a deadline (forever()
  // for the group's alone)
  pub fn externalIn(self: &mut, to: Target, buf: IoBuf, group: CancelGroup, deadline: Instant,
      file: &Array[u8] = srcFile(), line: u32 = srcLine()) Completer {
    self.startExternal(to, buf, deadline, Some[CancelGroup](group), file, line)
  }

  // A record of the Loop's own pool, holding the target and the token
  fn takeOwn(self: &mut, to: Target, token: u64) *OpCore {
    let p = pool.takeHere(OldAsk(to, token)) as *OpCore;
    (*p).own = true;
    p
  }

  fn startExternal(self: &mut, to: Target, buf: IoBuf, deadline: Instant, group: Option[CancelGroup],
      file: &Array[u8], line: u32) Completer {
    let token = to.token;
    let t = self.claim(to, file, line);
    let p = self.takeOwn(t, token);
    let r = p as &mut OpCore;
    r.kind = diag.kindExternal;
    r.deadline = deadline;
    r.group = group;
    self.stamp(p);
    let id = r.id();
    var dl = deadline;
    match r.group {
      case let Some(s) {if s.deadline() < dl {dl = s.deadline();}}
      else {}
    }
    if self.join(p) {
      r.buf = Some[IoBuf](buf);
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(p, diag.outcomeCancelled, 0usize, 0u32);
      return Completer(null, id, Waker(port));
    }
    if dl <= r.submitted {
      r.buf = Some[IoBuf](buf);
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(p, diag.outcomeTimedOut, 0usize, 0u32);
      return Completer(null, id, Waker(port));
    }
    // The record goes away, its buffer in it: the Completer holds it
    r.buf = Some[IoBuf](buf);
    sendAway(p, Waker(port), jobRunning);
    self.linkSide(p, onLoop);
    if dl < forever() {
      r.timer = wheel.insert(dl, self.tokenOf(p));
    }
    Completer(p, id, Waker(port))
  }

  // The target's own part of a submit: a status slot is claimed. The target
  // passes through
  fn claim(self: &mut, to: Target, file: &Array[u8], line: u32) Target {
    match &to {
      case let &Status(s) {
        if !s.board.arm(s.slot) {
          panic("iocore: a status slot given an operation while it holds one, or out of range", file, line);
        }
      }
      else {}
    }
    to
  }

  // The group's part of a start: the record joins the grouped list, and the
  // group tells the loop when it is cancelled. True when it is cancelled
  // already
  fn join(self: &mut, p: *OpCore) bool {
    let r = p as &mut OpCore;
    var cancelled = false;
    match r.group {
      case let Some(s) {
        self.linkGroup(p);
        let w = Waker(port);
        s.register(loopId, &w);
        // After the registration: a cancel since is either seen here or
        // posted to this loop
        cancelled = s.isCancelled();
      }
      else {}
    }
    cancelled
  }

  fn startTimer(self: &mut, at: Instant, to: Target, group: Option[CancelGroup],
      file: &Array[u8], line: u32) OpId {
    let token = to.token;
    let t = self.claim(to, file, line);
    let p = self.takeOwn(t, token);
    let r = p as &mut OpCore;
    r.kind = diag.kindTimer;
    r.deadline = at;
    r.group = group;
    let id = r.id();
    self.begin(p);
    id
  }

  fn startOp(self: &mut, op: Op, to: Target, deadline: Instant, group: Option[CancelGroup],
      file: &Array[u8], line: u32) OpId {
    let token = to.token;
    let t = self.claim(to, file, line);
    let p = self.takeOwn(t, token);
    let r = p as &mut OpCore;
    // What it is, and what it owns, into the record
    match op {
      case let Connect(o) {
        r.kind = diag.kindConnect;
        r.setPeer(o.addr);
      }
      case let Accept(o) {
        r.kind = diag.kindAccept;
        r.handle = o.listener;
      }
      case let Recv(o) {
        let buf, sock = o.(buf, sock);
        r.kind = diag.kindRecv;
        r.buf = Some[IoBuf](buf);
        r.handle = sock;
      }
      case let RecvReady(o) {
        r.kind = diag.kindRecvReady;
        r.handle = o.sock;
      }
      case let Send(o) {
        let buf, sock = o.(buf, sock);
        r.kind = diag.kindSend;
        r.buf = Some[IoBuf](buf);
        r.handle = sock;
      }
      case let SendBytes(o) {
        r.kind = diag.kindSend;
        r.bytes = Some[Bytes](o.bytes);
        r.handle = o.sock;
      }
      case let ReadAt(o) {
        let buf, file, at = o.(buf, file, at);
        r.kind = diag.kindReadAt;
        r.buf = Some[IoBuf](buf);
        r.handle = file;
        r.at = at;
      }
      case let WriteAt(o) {
        let buf, file, at = o.(buf, file, at);
        r.kind = diag.kindWriteAt;
        r.buf = Some[IoBuf](buf);
        r.handle = file;
        r.at = at;
      }
      case let Call(o) {
        let buf, lane, work, arg = o.(buf, lane, work, arg);
        r.kind = diag.kindCall;
        r.buf = Some[IoBuf](buf);
        r.lane = lane;
        r.work = work;
        r.at = arg;
      }
      case let RecvFrom(o) {
        let buf, sock = o.(buf, sock);
        r.kind = diag.kindRecvFrom;
        r.buf = Some[IoBuf](buf);
        r.handle = sock;
      }
      case let SendTo(o) {
        let buf, sock, addr = o.(buf, sock, addr);
        r.kind = diag.kindSendTo;
        r.buf = Some[IoBuf](buf);
        r.handle = sock;
        r.setPeer(addr);
      }
    }
    r.deadline = deadline;
    r.group = group;
    let id = r.id();
    self.begin(p);
    id
  }

  // -------------------------------------------------------------------------
  // Starting: the new API, and what both share
  // -------------------------------------------------------------------------

  // Start record p, which its asker took from its pool (OpPool.take) and
  // filled -- kind, handle, buf or bytes, at, deadline, group, lane and work,
  // and the address (setPeer) for SendTo and Connect -- or took back from
  // takeDone to start again (a read's second stage). On the loop's thread.
  // Its answer is no Completion: it goes on the done list, which takeDone
  // hands over after poll (see the package's header, RECORDS). A panic, at
  // the caller's line, for a record in flight or abandoned, an external
  // operation's, or one of the old API's
  pub fn start(self: &mut, p: *OpCore, file: &Array[u8] = srcFile(), line: u32 = srcLine()) {
    let r = p as &mut OpCore;
    if r.state != stTaken && r.state != stDone {
      panic("iocore: lp.start given a record that is in flight, or not taken from a pool", file, line);
    }
    if r.own || r.kind == diag.kindExternal {
      panic("iocore: lp.start given an external operation, or the old API's record", file, line);
    }
    r.late = false;
    self.begin(p);
  }

  // The asker's records answered since the last call, moved to the end of
  // out (each a pointer to its OpCore): how many. Each is then the asker's to
  // dissolve or to start again -- except one that isEarly(), which the asker
  // answers and leaves to the kernel: it comes back once more, isLate()
  pub fn takeDone(self: &mut, out: &mut List[*OpCore]) usize {
    let n = done.len();
    var k = 0usize;
    while k < n {
      let p = *done[k];
      (*p).listed = false;
      out.push(p);
      k = k + 1usize;
    }
    done.clear();
    n
  }

  // Record p is in flight from now: its promise reset and its submission
  // stamped (counted)
  fn stamp(self: &mut, p: *OpCore) {
    let r = p as &mut OpCore;
    r.state = stFlight;
    r.asked = askedNone;
    r.hit = false;
    r.lapses = false;
    r.early = false;
    r.submitted = Instant.now();
    r.dequeued = r.submitted;
    r.newSock = invalidHandle;
    r.newHandle = Handle.none();
    r.timer = TimerId.none();
    r.jfd = 0i32 - 1i32;
    r.status = 0u32;
    r.n = 0usize;
    r.code = 0u32;
    r.done = 0usize;
    r.ov = Overlapped(0usize, 0usize, 0u32, 0u32, 0usize);
    stats.submit();
  }

  // Start record p: its deadline the tighter of its own and its group's, it
  // joins its group, and it is handed to the kernel, the wheel or the pool --
  // or answered at once. Cancelled is a state: an operation in a cancelled
  // group, or whose deadline has passed, is answered at once and never
  // started
  fn begin(self: &mut, p: *OpCore) {
    self.stamp(p);
    let r = p as &mut OpCore;
    if r.kind == diag.kindTimer {
      self.beginTimer(p);
      return;
    }
    var dl = r.deadline;
    match r.group {
      case let Some(s) {if s.deadline() < dl {dl = s.deadline();}}
      else {}
    }
    if self.join(p) {
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(p, diag.outcomeCancelled, 0usize, 0u32);
      return;
    }
    if dl <= r.submitted {
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(p, diag.outcomeTimedOut, 0usize, 0u32);
      return;
    }
    let code = self.launch(p);
    if code == errorHandleEof {
      self.decide(p, diag.outcomeDone, 0usize, 0u32);
    } else if code != 0u32 {
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(p, diag.outcomeFailed, 0usize, code);
    } else if r.state == stFlight {
      // (Linux: an operation the socket took at once is decided already, and
      // needs neither a deadline nor the kernel's holding)
      if isWindows() && r.kind != diag.kindCall {kernelHeld = kernelHeld + 1u32;}
      self.place(p);
      if dl < forever() {
        r.timer = wheel.insert(dl, self.tokenOf(p));
      }
    }
  }

  // A timer: Done at its time (its 'deadline'), or TimedOut at its group's
  // deadline when that comes first
  fn beginTimer(self: &mut, p: *OpCore) {
    let r = p as &mut OpCore;
    let at = r.deadline;
    // A timer due after its group's deadline answers TimedOut at the
    // deadline instead; one due at or before it answers Done at its time
    var dl = forever();
    match r.group {
      case let Some(s) {dl = s.deadline();}
      else {}
    }
    if self.join(p) {
      stats.atSubmit = stats.atSubmit + 1u64;
      self.decide(p, diag.outcomeCancelled, 0usize, 0u32);
      return;
    }
    if dl < at {
      if dl <= r.submitted {
        stats.atSubmit = stats.atSubmit + 1u64;
        self.decide(p, diag.outcomeTimedOut, 0usize, 0u32);
        return;
      }
      r.lapses = true;
      r.timer = wheel.insert(dl, self.tokenOf(p));
    } else {
      r.timer = wheel.insert(at, self.tokenOf(p));
    }
    self.linkSide(p, onLoop);
  }

  // Hand record p's operation to the kernel or the pool: 0, it holds it now
  // (its completion will come to the port); or the error that stopped it
  // before it was taken
  fn launch(self: &mut, p: *OpCore) u32 {
    let r = p as &mut OpCore;
    let k = r.kind;
    if k == diag.kindConnect {return self.startConnect(p);}
    if k == diag.kindAccept {return self.startAccept(p, r.handle);}
    if k == diag.kindRecv {return self.startRecv(p, r.handle, false);}
    if k == diag.kindRecvReady {return self.startRecv(p, r.handle, true);}
    if k == diag.kindSend {
      match r.bytes {
        case let Some(b) {
          let v = b.view();
          return self.startSend(p, r.handle, v as *u8, v.len);
        }
        else {}
      }
      return self.startSend(p, r.handle, r.bufBase(), r.bufLen());
    }
    if k == diag.kindRecvFrom {return self.startRecvFrom(p, r.handle);}
    if k == diag.kindSendTo {return self.startSendTo(p, r.handle);}
    if k == diag.kindReadAt {return self.startFile(p, r.handle, r.at, false);}
    if k == diag.kindWriteAt {return self.startFile(p, r.handle, r.at, true);}
    if k == diag.kindCall {return self.startCall(p);}
    errorInvalidParameter
  }

  // Each starts its kind of operation in record p: 0, the kernel holds it
  // now (its completion will come to the port); or the error that stopped it
  // before the kernel took it

  fn startConnect(self: &mut, p: *OpCore) u32 {
    let r = p as &mut OpCore;
    let addr = *r.sockAddr();
    if isWindows() {
      if connectExAddr == 0usize {return errorInvalidParameter;}
      let s = tcpSocket(addr.family());
      if s == invalidHandle {return wsaError();}
      var here = addr.wildcard();
      if bind(s, &mut here as *u8, here.size) != 0i32 {
        let code = wsaError();
        closesocket(s);
        return code;
      }
      if CreateIoCompletionPort(s, portHandle, keyIo, 0u32) == 0usize {
        let code = GetLastError();
        closesocket(s);
        return code;
      }
      r.newSock = s;
      r.raw = s;
      r.family = addr.family();
      let connectEx = connectExAddr as *u8 as ConnectExFn;
      if connectEx(s, &mut r.addr as *u8, addr.size, null, 0u32, null, p as *u8) == 0i32 {
        let code = wsaError();
        if code != errorIoPending {
          closesocket(s);
          r.newSock = invalidHandle;
          return code;
        }
      }
      0u32
    } else {
      lxStartConnect(self, p, addr)
    }
  }

  fn startAccept(self: &mut, p: *OpCore, listener: Handle) u32 {
    let r = p as &mut OpCore;
    if isWindows() {
      if acceptExAddr == 0usize {return errorInvalidParameter;}
      let li = self.handleIndex(listener);
      if li == noEntry {return errorInvalidHandle;}
      let e = handles.at(li) as &HEntry;
      if e.kind != hListener {return errorInvalidHandle;}
      let s = tcpSocket(e.family);
      if s == invalidHandle {return wsaError();}
      r.newSock = s;
      r.raw = e.raw;
      r.family = e.family;
      let acceptEx = acceptExAddr as *u8 as AcceptExFn;
      if acceptEx(e.raw, s, &mut r.addr as *u8, 0u32, acceptAddrLen, acceptAddrLen, null, p as *u8) == 0i32 {
        let code = wsaError();
        if code != errorIoPending {
          closesocket(s);
          r.newSock = invalidHandle;
          return code;
        }
      }
      0u32
    } else {
      lxStartAccept(self, p)
    }
  }

  fn startRecv(self: &mut, p: *OpCore, sock: Handle, ready: bool) u32 {
    let r = p as &mut OpCore;
    if isWindows() {
      let raw = self.rawOf(sock, hSocket);
      if raw == invalidHandle {return errorInvalidHandle;}
      r.raw = raw;
      if ready {
        r.wsa.len = 0u32;
        r.wsa.buf = null;
      } else {
        let room = r.bufRoom();
        if room == 0usize {return errorInsufficientBuffer;}
        r.wsa.len = if room > 0xFFFFFFFFusize {0xFFFFFFFFu32} else {u32.from(room)};
        r.wsa.buf = r.bufBase() + r.bufLen();
      }
      r.flags = 0u32;
      if WSARecv(raw, &mut r.wsa as *WsaBuf, 1u32, null, &mut r.flags, p as *u8, null) != 0i32 {
        let code = wsaError();
        if code != errorIoPending {return code;}
      }
      0u32
    } else {
      lxStartRecv(self, p, ready)
    }
  }

  fn startSend(self: &mut, p: *OpCore, sock: Handle, data: *u8, len: usize) u32 {
    let r = p as &mut OpCore;
    if isWindows() {
      let raw = self.rawOf(sock, hSocket);
      if raw == invalidHandle {return errorInvalidHandle;}
      if len > 0xFFFFFFFFusize {return errorInvalidParameter;}
      r.raw = raw;
      r.wsa.len = u32.from(len);
      r.wsa.buf = data;
      if WSASend(raw, &mut r.wsa as *WsaBuf, 1u32, null, 0u32, p as *u8, null) != 0i32 {
        let code = wsaError();
        if code != errorIoPending {return code;}
      }
      0u32
    } else {
      lxStartSend(self, p)
    }
  }

  // One datagram into the buffer's room, the sender into the record's
  // address area
  fn startRecvFrom(self: &mut, p: *OpCore, sock: Handle) u32 {
    let r = p as &mut OpCore;
    if isWindows() {
      let raw = self.rawOf(sock, hDatagram);
      if raw == invalidHandle {return errorInvalidHandle;}
      let room = r.bufRoom();
      if room == 0usize {return errorInsufficientBuffer;}
      r.raw = raw;
      r.wsa.len = if room > 0xFFFFFFFFusize {0xFFFFFFFFu32} else {u32.from(room)};
      r.wsa.buf = r.bufBase() + r.bufLen();
      r.flags = 0u32;
      let from = r.sockAddr();
      (*from).size = 28i32;
      if WSARecvFrom(raw, &mut r.wsa as *WsaBuf, 1u32, null, &mut r.flags, from as *u8,
          &mut (*from).size, p as *u8, null) != 0i32 {
        let code = wsaError();
        if code != errorIoPending {return code;}
      }
      0u32
    } else {
      lxStartRecvFrom(self, p)
    }
  }

  // The buffer as one datagram to the address in the record's address area
  fn startSendTo(self: &mut, p: *OpCore, sock: Handle) u32 {
    let r = p as &mut OpCore;
    if isWindows() {
      let raw = self.rawOf(sock, hDatagram);
      if raw == invalidHandle {return errorInvalidHandle;}
      if r.bufLen() > 0xFFFFFFFFusize {return errorInvalidParameter;}
      r.raw = raw;
      r.wsa.len = u32.from(r.bufLen());
      r.wsa.buf = r.bufBase();
      let to = r.sockAddr();
      if WSASendTo(raw, &mut r.wsa as *WsaBuf, 1u32, null, 0u32, to as *u8, (*to).size,
          p as *u8, null) != 0i32 {
        let code = wsaError();
        if code != errorIoPending {return code;}
      }
      0u32
    } else {
      lxStartSendTo(self, p)
    }
  }

  fn startFile(self: &mut, p: *OpCore, file: Handle, at: u64, write: bool) u32 {
    let r = p as &mut OpCore;
    if isWindows() {
      let raw = self.rawOf(file, hFile);
      if raw == invalidHandle {return errorInvalidHandle;}
      r.raw = raw;
      r.ov.offset = u32.from(at & 0xFFFFFFFFu64);
      r.ov.offsetHigh = u32.from(at >> 32u64);
      var ok = 0i32;
      if write {
        let len = r.bufLen();
        if len > 0xFFFFFFFFusize {return errorInvalidParameter;}
        ok = WriteFile(raw, r.bufBase(), u32.from(len), null, p as *u8);
      } else {
        let room = r.bufRoom();
        if room == 0usize {return errorInsufficientBuffer;}
        let want = if room > 0xFFFFFFFFusize {0xFFFFFFFFu32} else {u32.from(room)};
        ok = ReadFile(raw, r.bufBase() + r.bufLen(), want, null, p as *u8);
      }
      if ok == 0i32 {
        let code = GetLastError();
        if code != errorIoPending {return code;}
      }
      0u32
    } else {
      lxStartFile(self, p, write)
    }
  }

  // A job for the blocking pool: the record goes away, with a waker of this
  // loop, queued on its lane; the lane's thread works on it, its buffer and
  // all, where it is (pool.cone)
  fn startCall(self: &mut, p: *OpCore) u32 {
    let r = p as &mut OpCore;
    let l = laneAt(r.lane.id);
    if l as usize == 0usize {return errorInvalidParameter;}
    sendAway(p, Waker(port), jobQueued);
    if !enqueueJob(p, l) {
      bringHome(p);
      return errorBusy;
    }
    stats.jobs = stats.jobs + 1u64;
    0u32
  }

  // -------------------------------------------------------------------------
  // Cancel
  // -------------------------------------------------------------------------

  // Ask an operation or a timer to end (see the package's header, CANCEL):
  // true while its answer is still to come, false once it is decided or for
  // an id that names nothing. The ids are the old API's (submit's, after's,
  // a Completer's); an asker's record is ended by its handle (cancelHandle)
  // or its group
  pub fn cancel(self: &mut, id: OpId) bool {
    if id.isNone() {return false;}
    let rp = pool.at(id.index);
    if rp as usize == 0usize {return false;}
    let p = rp as *OpCore;
    let r = p as &mut OpCore;
    if r.gen != id.gen || r.state != stFlight {return false;}
    if r.asked == askedNone {
      stats.cancelsAsked = stats.cancelsAsked + 1u64;
      self.askCancel(p, askedCancel);
    }
    true
  }

  // Ask every operation in flight on h, in one direction, to end: its reads
  // (accept, receive, RecvFrom, ReadAt) or its writes (send, SendTo, WriteAt,
  // Linux's connect), old API and new alike. Each still answers once, as a
  // cancel's does. How many were asked (one asked already is not asked
  // again); 0 for a handle that names nothing
  pub fn cancelHandle(self: &mut, h: Handle, write: bool) usize {
    let i = self.handleIndex(h);
    if i == noEntry {return 0usize;}
    let e = handles.at(i) as &HEntry;
    var p = if write {e.writes} else {e.reads};
    var n = 0usize;
    while p as usize != 0usize {
      let next = (*p).hnext;
      if (*p).state == stFlight && (*p).asked == askedNone {
        stats.cancelsAsked = stats.cancelsAsked + 1u64;
        self.askCancel(p, askedCancel);
        n = n + 1usize;
      }
      // An operation may have closed it (Linux: a connect that failed on its
      // try): its lists went with it
      if handles.get(Slot(h.index, h.gen)) as usize == 0usize {break;}
      p = next;
    }
    n
  }

  // Ask record p's cancel, for 'why': a timer, or a job still queued, is
  // decided at once (a job with its buffer back); the kernel is asked
  // (CancelIoEx); a running job answers when it returns
  fn askCancel(self: &mut, p: *OpCore, why: u32) {
    let r = p as &mut OpCore;
    let outcome = if why == askedDeadline {diag.outcomeTimedOut} else {diag.outcomeCancelled};
    if r.kind == diag.kindTimer {
      self.decide(p, outcome, 0usize, 0u32);
      return;
    }
    if r.asked != askedNone {return;}
    r.asked = why;
    if jobKind(r.kind) {
      // Away: the one field of its job part the loop sets. A Completer is told,
      // and answers; a job still queued is taken back, home with its buffer,
      // and answered now; one running answers when it returns
      r.jasked.store(1u32);
      if removeJob(p) {
        bringHome(p);
        self.unlinkSide(p);
        self.decide(p, outcome, 0usize, 0u32);
      }
      return;
    }
    // The kernel is asked, and answers at the next wait: on Linux the loop
    // answers it then itself (settleCancels), after the events that came with
    // the wait, so an operation that finished first is Done, as on Windows
    if isWindows() {CancelIoEx(r.raw, p as *u8);} else {lxAskCancel(self, p);}
  }

  // A cancel group has been cancelled: every operation in flight in a
  // cancelled group is asked to end. Only the grouped list is walked
  fn sweepGroups(self: &mut) {
    groupsDirty = false;
    var p = groupHead;
    while p as usize != 0usize {
      let next = (*p).gnext;
      if (*p).state == stFlight && (*p).asked == askedNone {
        var hit = false;
        match (*p).group {
          case let Some(s) {hit = s.isCancelled();}
          else {}
        }
        if hit {
          stats.groupCancels = stats.groupCancels + 1u64;
          self.askCancel(p, askedCancel);
        }
      }
      p = next;
    }
  }

  // -------------------------------------------------------------------------
  // Completing
  // -------------------------------------------------------------------------

  // The kernel has completed record p, moving 'bytes'
  // (Windows only: Linux's operations are tried by linux.cone, not completed)
  fn complete(self: &mut, p: *OpCore, bytes: u32, at: Instant) {
    if isWindows() {
      let r = p as &mut OpCore;
      kernelHeld = kernelHeld - 1u32;
      self.unlinkSide(p);
      if r.state == stAbandoned {
        // Its answer went long ago: its socket closed, and the record ended
        // (its buffer home)
        if r.newSock != invalidHandle {
          closesocket(r.newSock);
          r.newSock = invalidHandle;
        }
        self.ended(p, true);
        return;
      }
      r.dequeued = at;
      let status = r.ov.internal & 0xFFFFFFFFusize;
      let n = usize.from(bytes);
      if status == statusBufferOverflow && r.kind == diag.kindRecvFrom {
        // The datagram was longer than the buffer's room: the room is filled,
        // the rest of it is lost, and the answer says so (WSAEMSGSIZE)
        r.bufGrow(n);
        self.decide(p, diag.outcomeFailed, 0usize, errorMsgSize);
        return;
      }
      if status == statusSuccess {
        if r.kind == diag.kindRecv || r.kind == diag.kindReadAt || r.kind == diag.kindRecvFrom {
          r.bufGrow(n);
        }
        if r.kind == diag.kindAccept || r.kind == diag.kindConnect {
          let code = self.adopt(p);
          if code != 0u32 {
            self.decide(p, diag.outcomeFailed, 0usize, code);
            return;
          }
        }
        self.decide(p, diag.outcomeDone, n, 0u32);
        return;
      }
      if r.newSock != invalidHandle {
        closesocket(r.newSock);
        r.newSock = invalidHandle;
      }
      if status == statusCancelled {
        if r.asked == askedDeadline {
          self.decide(p, diag.outcomeTimedOut, 0usize, 0u32);
        } else {
          self.decide(p, diag.outcomeCancelled, 0usize, 0u32);
        }
      } else if status == statusEndOfFile {
        self.decide(p, diag.outcomeDone, 0usize, 0u32);
      } else if status == statusInvalidBufferSize && r.kind == diag.kindSendTo {
        // A datagram larger than UDP carries: what Winsock's own call calls WSAEMSGSIZE
        self.decide(p, diag.outcomeFailed, 0usize, errorMsgSize);
      } else {
        self.decide(p, diag.outcomeFailed, 0usize, RtlNtStatusToDosError(u32.from(status)));
      }
    }
  }

  // A job's record has come home from the pool (or its Completer): its job
  // part is the loop's again, and its outcome its answer; a record answered
  // already (a prompt TimedOut) ends, its buffer going home. In the loop's
  // death its answer is abandoned, and it is dissolved
  fn completeJob(self: &mut, p: *OpCore, at: Instant) {
    let r = p as &mut OpCore;
    if dying {
      // Off the loop's lists while every record on them still lives (no
      // record away is dissolved by its thread before the port is closed)
      self.unlinkSide(p);
      self.unlinkGroup(p);
      homeDead(p);
      return;
    }
    // Its hold goes: its pool's owner holds the pool while this loop lives
    bringHome(p);
    if r.state == stAbandoned {
      self.ended(p, true);
      return;
    }
    r.dequeued = at;
    var status = r.jstatus;
    let n = r.jn;
    let code = r.jcode;
    if status == diag.outcomeCancelled && r.asked == askedDeadline {
      status = diag.outcomeTimedOut;
    }
    self.unlinkSide(p);
    self.decide(p, status, if status == diag.outcomeDone {n} else {0usize}, code);
  }

  // An accepted or connected socket is finished and registered: 0, or the
  // error that stopped it (the socket is then closed)
  // (Windows only: Linux adopts a socket where it makes or accepts it)
  fn adopt(self: &mut, p: *OpCore) u32 {
    if isWindows() {
      let r = p as &mut OpCore;
      let s = r.newSock;
      r.newSock = invalidHandle;
      var rc = 0i32;
      if r.kind == diag.kindAccept {
        var listener = r.raw;
        rc = setsockopt(s, solSocket, soUpdateAcceptContext, &mut listener as *u8, 8i32);
        if rc == 0i32 && CreateIoCompletionPort(s, portHandle, keyIo, 0u32) == 0usize {
          let code = GetLastError();
          closesocket(s);
          return code;
        }
      } else {
        rc = setsockopt(s, solSocket, soUpdateConnectContext, null, 0i32);
      }
      if rc != 0i32 {
        let code = wsaError();
        closesocket(s);
        return code;
      }
      noDelay(s);
      r.newHandle = self.register(s, hSocket, r.family);
      0u32
    } else {
      errorInvalidParameter
    }
  }

  // Fire what the wheel says is due by now: a timer answers Done (TimedOut,
  // when it is its group's deadline that is due, not its own time); an
  // operation's deadline asks its cancel and starts its grace; a grace run
  // out answers TimedOut without the buffer
  fn fireTimers(self: &mut, now: Instant) {
    if wheel.isEmpty() {return;}
    wheel.expired(now, &mut expiries);
    var k = 0usize;
    while k < expiries.len() {
      let token = expiries[k].token;
      let id = expiries[k].id;
      k = k + 1usize;
      let p = usize.from(token) as *OpCore;
      let r = p as &mut OpCore;
      // A record's entry is cancelled whenever it is decided: one firing is
      // its current one
      if r.state != stFlight || r.timer != id {continue;}
      r.timer = TimerId.none();
      if r.kind == diag.kindTimer {
        r.dequeued = now;
        self.decide(p, if r.lapses {diag.outcomeTimedOut} else {diag.outcomeDone}, 0usize, 0u32);
      } else if !r.hit {
        // The deadline
        r.hit = true;
        if r.asked == askedNone {self.askCancel(p, askedDeadline);}
        if r.state == stFlight {
          if grace.nanos() <= 0i64 {
            self.abandonRec(p);
          } else {
            r.timer = wheel.insert(now + grace, token);
          }
        }
      } else {
        // The grace has run out, and the kernel still holds it
        self.abandonRec(p);
      }
    }
    expiries.clear();
  }

  // -------------------------------------------------------------------------
  // Waiting
  // -------------------------------------------------------------------------

  // Wait for answers, at most until 'until', and append them to out: how
  // many (see the package's header, POLL). It returns too when an asker's
  // records are on the done list (takeDone)
  pub fn poll(self: &mut, until: Instant, out: &mut List[Completion]) usize {
    stats.polls = stats.polls + 1u64;
    woken = false;
    // The records the last pass gave back, taken first by the submits since
    // (takeHere), go back to the pool's list under one lock
    pool.flushHere();
    let elsewhere = stats.postsSent + stats.postsDropped + stats.handedOff + stats.handedDropped;
    var n = 0usize;
    while true {
      self.retryHeld();
      let now = Instant.now();
      // How long the kernel may keep us: not at all when answers are ready
      // or a timer is due
      var ms = 0u32;
      if decided.len() == 0usize && cancels.len() == 0usize && done.len() == 0usize && now < until {
        var wakeAt = until;
        match wheel.nextExpiry() {
          case let Some(s) {if s < wakeAt {wakeAt = s;}}
          case is None[Instant] {}
        }
        if held.len() > 0usize {
          let retry = now + Duration.fromNanos(heldRetryNs);
          if retry < wakeAt {wakeAt = retry;}
        }
        if wakeAt > now {ms = self.armFor(wakeAt, now);}
      }
      n = n + self.dequeue(ms, out);
      let after = Instant.now();
      self.fireTimers(after);
      n = n + self.flush(out);
      if n > 0usize || done.len() > 0usize || woken || after >= until {return n;}
      // Answers sent elsewhere -- another loop, a channel, a one-shot, a
      // status slot -- are progress too: the driver may be waiting for its
      // operations to be done
      if stats.postsSent + stats.postsDropped + stats.handedOff + stats.handedDropped != elsewhere {
        return n;
      }
    }
    n
  }

  // Arm the high-resolution timer for wakeAt (unless it already is) and
  // answer the port's own timeout, a backstop a millisecond past it; INFINITE
  // when wakeAt never comes
  fn armFor(self: &mut, wakeAt: Instant, now: Instant) u32 {
    if wakeAt >= forever() {return infinite;}
    if isWindows() {
      let left = (wakeAt - now).nanos();
      if packet != 0usize && (!associated || armedFor != wakeAt) {
        // Relative, in 100 ns units: negative
        var due = 0i64 - (left + 99i64) / 100i64;
        SetWaitableTimer(timer, &due, 0i32, null, null, 0i32);
        armedFor = wakeAt;
        if !associated {
          var already = 0u8;
          if NtAssociateWaitCompletionPacket(packet, portHandle, timer, keyTimer as *u8, null,
              0i32, 0usize, &mut already as *u8) == 0i32 {
            associated = true;
          }
        }
      }
      let ms = (left + 999999i64) / 1000000i64 + 1i64;
      if ms >= i64.from(infinite) {infinite - 1u32} else {u32.from(ms)}
    } else {
      lxArm(self, wakeAt, now)
    }
  }

  // One wait in the kernel, for at most ms, and what it brought processed:
  // how many answers posted by other loops went to out
  fn dequeue(self: &mut, ms: u32, out: &mut List[Completion]) usize {
    if isWindows() {
      var got = 0u32;
      let ok = GetQueuedCompletionStatusEx(portHandle, entries, batch, &mut got, ms, 0i32);
      if ms != 0u32 {stats.waits = stats.waits + 1u64;}
      if ok == 0i32 || got == 0u32 {
        if ms != 0u32 && ms != infinite {stats.waitTimeouts = stats.waitTimeouts + 1u64;}
        return 0usize;
      }
      let at = Instant.now();
      stats.dequeued = stats.dequeued + u64.from(got);
      if u64.from(got) > stats.largestBatch {stats.largestBatch = u64.from(got);}
      var n = 0usize;
      var k = 0usize;
      while k < usize.from(got) {
        let e = entries + k;
        let key = (*e).key;
        if key == keyIo {
          self.complete((*e).ov as *OpCore, (*e).bytes, at);
        } else if key == keyTimer {
          associated = false;
          stats.timerExpiries = stats.timerExpiries + 1u64;
        } else {
          n = n + self.handlePacket(key, (*e).ov, at, out);
        }
        k = k + 1usize;
      }
      if groupsDirty {self.sweepGroups();}
      n
    } else {
      lxDequeue(self, ms, out)
    }
  }

  // A packet another thread posted to the loop (the same on both systems):
  // a job come home, a wake, a cancel, a cancelled group, an answer for this
  // loop. How many answers went to out
  fn handlePacket(self: &mut, key: usize, ov: *u8, at: Instant, out: &mut List[Completion]) usize {
    var n = 0usize;
    if key == keyJob {
      self.completeJob(ov as *OpCore, at);
    } else if key == keyWake {
      woken = true;
      stats.wakes = stats.wakes + 1u64;
    } else if key == keyCancel {
      let number = u64.from(ov as usize);
      stats.remoteCancels = stats.remoteCancels + 1u64;
      self.cancel(OpId(u32.from(number & 0xFFFFFFFFu64), u32.from(number >> 32u64)));
    } else if key == keyGroup {
      groupsDirty = true;
    } else if key == keyPost {
      let block = ov as *Completion;
      var c = mem.readRaw[Completion](block);
      libc.free(block as *u8);
      c.delivered = at;
      stats.postsReceived = stats.postsReceived + 1u64;
      if subscribed {
        let rec = c.record();
        (sub)(&rec);
      }
      out.push(c);
      n = 1usize;
    }
    n
  }

  // -------------------------------------------------------------------------
  // Its death: cancel and drain (I18)
  // -------------------------------------------------------------------------

  // Record p, in flight at the loop's death and on no handle's queue the
  // kernel drains: a timer answers Cancelled; a job still queued is taken
  // back, its buffer with it, and answered Cancelled. A job running (or held by
  // a Completer, which is told) is left to its thread: the old API's answers
  // Cancelled now, without its buffer, and an asker's answer is abandoned; it
  // is dissolved when it comes home, by its thread once the loop has let go of
  // it. A connection being made (Windows) holds a socket of its own, cancelled
  fn endAtDeath(self: &mut, p: *OpCore) {
    let r = p as &mut OpCore;
    if r.state != stFlight && r.state != stAbandoned {return;}
    if r.kind == diag.kindTimer {
      self.decide(p, diag.outcomeCancelled, 0usize, 0u32);
      return;
    }
    if jobKind(r.kind) {
      r.jasked.store(1u32);
      if r.state == stFlight && removeJob(p) {
        bringHome(p);
        self.unlinkSide(p);
        self.decide(p, diag.outcomeCancelled, 0usize, 0u32);
      } else if r.state == stFlight && r.own {
        self.decide(p, diag.outcomeCancelled, 0usize, 0u32);
        r.early = true;
      }
      return;
    }
    if isWindows() && r.kind == diag.kindConnect && r.newSock != invalidHandle {
      CancelIoEx(r.newSock, null);
    }
  }

  fn final(self: &uni) {
    dying = true;
    // Every handle's operations cancelled, all before any is closed (a
    // socket closed first would end its peer's receive as the end of the
    // stream, not as the cancel it is), then every handle closed
    var h = 0u32;
    while usize.from(h) < handles.bound() {
      if handles.isLive(h) {
        if isWindows() {
          CancelIoEx((*handles.at(h)).raw, null);
        } else {
          lxCancelAll(self, h);
          // Linux: the file jobs on it
          let e = handles.at(h) as &HEntry;
          var p = e.reads;
          while p as usize != 0usize {
            let next = (*p).hnext;
            self.endAtDeath(p);
            p = next;
          }
          p = e.writes;
          while p as usize != 0usize {
            let next = (*p).hnext;
            self.endAtDeath(p);
            p = next;
          }
        }
      }
      h = h + 1u32;
    }
    h = 0u32;
    while usize.from(h) < handles.bound() {
      if handles.isLive(h) {
        let e = handles.at(h) as &HEntry;
        self.detachLists(h);
        closeRaw(e.kind, e.raw);
        handles.removeAt(h);
      }
      h = h + 1u32;
    }
    // What no handle names: timers, jobs, external operations, connections
    // being made
    var p = unbound;
    while p as usize != 0usize {
      let next = (*p).hnext;
      self.endAtDeath(p);
      p = next;
    }
    // Linux: the cancels asked and not yet answered
    lxSettleCancels(self);
    // An asker's record answered early and still on the done list is away: it
    // is its job's thread's, and is dissolved when it comes home
    var kept = List[*OpCore].empty();
    var k = 0usize;
    while k < done.len() {
      let d = *done[k];
      if !isAway(d) {kept.push(d);}
      k = k + 1usize;
    }
    done = kept;
    // Wait until the kernel has given back every record, and deliver what
    // was owed to other loops and threads; what was owed here dies, buffers
    // going home
    var scratch = List[Completion].empty();
    self.flush(&mut scratch);
    scratch.clear();
    while kernelHeld > 0u32 {
      self.dequeue(1000u32, &mut scratch);
      self.flush(&mut scratch);
      scratch.clear();
    }
    // Answers a full channel still holds back are tried once more, then go
    self.retryHeld();
    stats.handedDropped = stats.handedDropped + u64.from(held.len());
    held.clear();
    // An asker's records the loop still holds are dissolved into their own
    // pools: their answers are abandoned, their buffers go home
    k = 0usize;
    while k < done.len() {
      let d = *done[k];
      let home = (*d).home;
      let f = (*home).dropper;
      f(d);
      k = k + 1usize;
    }
    done.clear();
    pool.flushHere();
    // The loop lets go of its records: from here on a job's thread that finds
    // the port closed dissolves its record itself, and what was posted home
    // before is dissolved now (the close and a job's post are one step under the
    // port's lock, so none is posted after this drain). Nothing below reads a
    // record
    port.close();
    port.drainDead();
    if isWindows() {
      if packet != 0usize {
        NtCancelWaitCompletionPacket(packet, 1u8);
        CloseHandle(packet);
      }
      if timer != 0usize {CloseHandle(timer);}
    } else {
      // The timerfd and the epoll instance (the eventfd is the Port's, closed
      // by its last owner)
      sysClose(fdOf(timer));
      sysClose(fdOf(portHandle));
    }
    libc.free(entries as *u8);
    libc.free(events as *u8);
  }
}
