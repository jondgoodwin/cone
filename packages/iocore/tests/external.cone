// External operations: answers from outside the kernel and the pool --
// another thread, a GPU fence's watcher -- delivered into a loop under the
// same contract as any operation's.
//
// 1. A Completer moved to another thread, which writes into the lent
//    buffer and ends it Done(n): the loop, idle in poll(forever()), wakes
//    with the answer, its token, its count and its buffer. A second ending
//    says false.
// 2. A Completer dropped without an ending: Failed, ERROR_OPERATION_ABORTED.
// 3. A cancel: the completer sees it asked, and ends the operation
//    Cancelled; the answer is the completer's.
// 4. A deadline the completer misses: TimedOut after the grace, without the
//    buffer; the completer's late ending is dropped and the buffer goes
//    home.
// 5. In a cancelled group: answered Cancelled at submit, and the Completer
//    has nothing to end.
// 6. A loop that has died: ending its operation says false, and the buffer
//    goes home.
// 7. 20,000 external operations ended by another thread, each answered
//    exactly once.

mod external;

import testing use *;
import thread;
import sync use Sender, Receiver, Channel;
import collections use List;
import time use Instant, Duration;
import iobuf use *;
import iocore use *;
import diag;

fn waitFor(lp: &mut Loop, out: &mut List[Completion], n: usize) {
  let limit = Instant.now() + Duration.fromSeconds(5i64);
  while out.len() < n && Instant.now() < limit {
    lp.poll(limit, out);
  }
}

fn finishLater(c: Completer) bool {
  var q = c;
  thread.sleep(Duration.fromMillis(20i64));
  q.buf().append("fence 42");
  let first = q.done(42usize);
  first && !q.done(43usize)
}

// End each Completer that comes, Done with its index
fn finisher(rx: Receiver[Completer]) u64 {
  var r = rx;
  var n = 0u64;
  var more = true;
  while more {
    match r.recv() {
      case var Some(s) {
        s.done(usize.from(n));
        n = n + 1u64;
      }
      case is None[Completer] {more = false;}
    }
  }
  n
}

// A completer of a loop that has died
fn orphan() Completer {
  var lp = Loop.mustMake();
  lp.external(Target.Here(0u64), IoBuf(10usize))
}

fn main() i32 {
  {
    var lp = Loop.mustMake();
    var out = List[Completion].empty();

    // 1. Ended on another thread
    {
      let c = lp.external(Target.Here(1u64), IoBuf(64usize));
      expect(c.isLive(), "live");
      let id = c.id();
      let t = thread.start(c, &finishLater);
      lp.poll(forever(), &mut out);
      expect(t.join(), "ended once; the second ending said false");
      requireUInt(u64.from(out.len()), 1u64, "the idle loop woke with the answer");
      let a = out[0usize];
      expect(a.id == id && a.token == 1u64, "its id and token");
      expectUInt(u64.from(a.kind), u64.from(diag.kindExternal), "an external operation");
      expect(a.isDone() && a.count() == 42usize, "Done, with the completer's count");
      expectStr(a.buf.view(), "fence 42", "and the buffer it wrote");
      out.clear();
      lp.poll(Instant.now() + Duration.fromMillis(5i64), &mut out);
      expectUInt(u64.from(out.len()), 0u64, "answered once");
    }

    // 2. Dropped
    {
      {
        let c = lp.external(Target.Here(2u64), IoBuf.empty());
      }
      waitFor(&mut lp, &mut out, 1usize);
      expectUInt(u64.from(out[0usize].status), u64.from(diag.outcomeFailed), "a dropped completer: Failed");
      expectUInt(u64.from(out[0usize].code), u64.from(errorOperationAborted), "ERROR_OPERATION_ABORTED");
      out.clear();
    }

    // 3. Cancelled
    {
      var c = lp.external(Target.Here(3u64), IoBuf(64usize));
      expect(!c.isCancelRequested(), "no cancel asked yet");
      expect(lp.cancel(c.id()), "the cancel asked");
      lp.poll(Instant.now() + Duration.fromMillis(5i64), &mut out);
      expectUInt(u64.from(out.len()), 0u64, "the answer is the completer's to give");
      expect(c.isCancelRequested(), "the completer sees it asked");
      c.cancelled();
      waitFor(&mut lp, &mut out, 1usize);
      expectUInt(u64.from(out[0usize].status), u64.from(diag.outcomeCancelled), "Cancelled");
      expectUInt(u64.from(out[0usize].buf.capacity()), 4096u64, "with its buffer");
      out.clear();
    }

    // 4. A deadline missed
    {
      var c = lp.externalIn(Target.Here(4u64), IoBuf(64usize), CancelGroup.make(),
        Instant.now() + Duration.fromMillis(20i64));
      waitFor(&mut lp, &mut out, 1usize);
      expectUInt(u64.from(out[0usize].status), u64.from(diag.outcomeTimedOut), "TimedOut");
      expectUInt(u64.from(out[0usize].buf.capacity()), 0u64, "without the buffer the completer holds");
      expect(c.isCancelRequested(), "the completer was asked to stop");
      out.clear();
      let late = lp.counters().lateReturns;
      c.done(1usize);
      lp.poll(Instant.now() + Duration.fromMillis(10i64), &mut out);
      expectUInt(u64.from(out.len()), 0u64, "its late ending answers nothing");
      expectUInt(lp.counters().lateReturns - late, 1u64, "and its buffer came back");
    }

    // 5. A cancelled group
    {
      let g = CancelGroup.make();
      g.cancel();
      var c = lp.externalIn(Target.Here(5u64), IoBuf(64usize), g, forever());
      expect(!c.isLive(), "nothing to end");
      expect(!c.done(0usize), "ending it says false");
      lp.poll(Instant.now(), &mut out);
      requireUInt(u64.from(out.len()), 1u64, "answered at submit");
      expectUInt(u64.from(out[0usize].status), u64.from(diag.outcomeCancelled), "Cancelled");
      expectUInt(u64.from(out[0usize].buf.capacity()), 4096u64, "with its buffer");
      out.clear();
    }

    // 6. A loop that has died
    {
      var c = orphan();
      expect(!c.done(0usize), "its loop gone: false");
      expectUInt(stats().lent, 0u64, "the buffer home");
    }

    // 7. Twenty thousand, from another thread
    {
      var tx: Sender[Completer];
      var rx: Receiver[Completer];
      tx, rx = Channel[Completer].make();
      let t = thread.start(rx, &finisher);
      var i = 0u64;
      while i < 20000u64 {
        tx.send(lp.external(Target.Here(i), IoBuf.empty()));
        i = i + 1u64;
      }
      {
        let gone = tx;
      }
      var seen = List[bool].empty();
      i = 0u64;
      while i < 20000u64 {
        seen.push(false);
        i = i + 1u64;
      }
      var twice = 0u64;
      var wrong = 0u64;
      var got = 0u64;
      let limit = Instant.now() + Duration.fromSeconds(20i64);
      while got < 20000u64 && Instant.now() < limit {
        lp.poll(limit, &mut out);
        var k = 0usize;
        while k < out.len() {
          let s = usize.from(out[k].token);
          if *seen[s] {twice = twice + 1u64;} else {seen.set(s, true); got = got + 1u64;}
          if !out[k].isDone() {wrong = wrong + 1u64;}
          k = k + 1usize;
        }
        out.clear();
      }
      expectUInt(t.join(), 20000u64, "the other thread ended all 20,000");
      expectUInt(got, 20000u64, "each answered");
      expectUInt(twice, 0u64, "none twice");
      expectUInt(wrong, 0u64, "each Done");
    }

    let cs = lp.counters();
    expectUInt(cs.delivered, cs.submitted, "every operation answered once");
    expectUInt(cs.inFlight, 0u64, "nothing in flight");
    expectUInt(stats().lent, 0u64, "every buffer back in the pool");
  }
  trimAll();      // the pools are the process's: their idle slabs go back to the OS on request
  expectUInt(osBlocks(), 0u64, "and every block back to the OS");
  done()
}
