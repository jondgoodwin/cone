// A status slot given a second operation while the first is still armed on
// it: a panic reported at the caller's line, since two answers cannot share
// one slot and the second has nowhere else to go.

mod statusbusy;

import stdio use *;
import time use Instant, Duration;
import iocore use *;

fn main() {
  mut lp = Loop.mustMake();
  imm board = StatusArray.make(2u32);
  lp.after(Instant.now() + Duration.fromSeconds(10i64), Target.Status[1u64, board, 0u32]);
  printStr("slot 0 armed\n");
  lp.after(Instant.now() + Duration.fromSeconds(10i64), Target.Status[2u64, board, 0u32]);
  printStr("not reached\n");
}
