// A SocketAddr's 'toText' sends exactly what 'text()' gives, so '$"..."' takes
// the address: '127.0.0.1:8080' and the IPv6 form with every group written.

mod addrtext;

import testing use *;
import collections use String;
import iocore use *;

fn main() i32 {
  let a = SocketAddr.v4(10u8, 0u8, 0u8, 7u8, 8080u16);
  let s = $"{a}";
  expectStr(s.view(), a.text().view(), "an IPv4 address: $\"...\" is text()");
  expectStr(s.view(), "10.0.0.7:8080", "...and is the written form");

  let a6: Array[u8, 16] = [0x20u8, 0x01u8, 0x0du8, 0xb8u8, 0u8, 0u8, 0u8, 0x0au8, 0u8, 0u8, 0xffu8, 0x00u8, 0x00u8, 0x42u8, 0x83u8, 0x29u8];
  let b = SocketAddr.v6(&a6, 80u16);
  let s6 = $"peer {b}!";
  expectStr(s6.view(), "peer [2001:db8:0:a:0:ff00:42:8329]:80!", "an IPv6 address through $\"...\"");
  let t6 = $"{b}";
  expectStr(t6.view(), b.text().view(), "...and alone it is text()");
  done()
}
