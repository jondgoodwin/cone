// A connection's two directions, and its ends, over 127.0.0.1 on one Loop:
//
// 1. peerAddr: each end's peer is the other's local address.
// 2. shutdown, a half-close: one end sends, then shuts its sending side;
//    the other receives the bytes, then the end of the stream (Done(0)),
//    and can still send back, which the first still receives. A send after
//    the shutdown fails.
// 3. reset: the peer's pending receive fails (the connection reset), not
//    Done(0): ConnectionReset (ERROR_NETNAME_DELETED, 64, the NTSTATUS of a
//    reset as a Windows error number; ECONNRESET on Linux).
// 4. close with received bytes left unread: Windows resets the connection
//    rather than finishing it, so the peer's receive fails the same way.
// 5. close with nothing unread: the peer sees the end of the stream.
// 6. The same controls through the shared table, from a second thread, with
//    the entry locked (Shared's CONTROLS): peerAddr, setKeepAlive and
//    keepAlive, then shutdownSend, which ends the stream for the peer; a
//    listener is refused (InvalidInput); an entry marked closing is refused.

mod halfclose;

import testing use *;
import thread;
import collections use List;
import time use Instant, Duration;
import iobuf use *;
import iocore use *;
import ioerror use IoErrorKind;
import diag;

// Poll until the answer with token tok comes; its status, count and code
// (status 99 when none came in time)
struct Got {
  pub status: u32;
  pub n: usize;
  pub code: u32;
  pub handle: Handle;
}

fn await1(lp: &mut Loop, tok: u64) Got {
  var out = List[Completion]();
  let until = Instant.now() + Duration.fromSeconds(3i64);
  while Instant.now() < until {
    lp.poll(until, &mut out);
    var k = 0usize;
    while k < out.len() {
      let c = &mut out[k];
      if c.token == tok {
        let g = Got(c.status, c.n, c.code, c.handle);
        out.clear();
        return g;
      }
      k = k + 1usize;
    }
    out.clear();
  }
  Got(99u32, 0usize, 0u32, Handle.none())
}

// A connected pair: the client's end and the accepted one
fn pair(lp: &mut Loop, l: Handle, port: u16) Handle, Handle {
  lp.submit(Op.Accept(l), Target.Here(1u64));
  lp.submit(Op.Connect(SocketAddr.localhost(port)), Target.Here(2u64));
  var a = Handle.none();
  var b = Handle.none();
  var out = List[Completion]();
  let until = Instant.now() + Duration.fromSeconds(3i64);
  while (a.isNone() || b.isNone()) && Instant.now() < until {
    lp.poll(until, &mut out);
    var k = 0usize;
    while k < out.len() {
      let c = &mut out[k];
      if c.token == 1u64 {a = c.handle;}
      if c.token == 2u64 {b = c.handle;}
      k = k + 1usize;
    }
    out.clear();
  }
  b, a
}

fn send(lp: &mut Loop, h: Handle, text: &Array[u8], tok: u64) Got {
  var b = IoBuf(64usize);
  b.append(text);
  lp.submit(Op.Send(h, b), Target.Here(tok));
  await1(lp, tok)
}

fn recv(lp: &mut Loop, h: Handle, tok: u64) Got {
  lp.submit(Op.Recv(h, IoBuf(4096usize)), Target.Here(tok));
  await1(lp, tok)
}

struct ControlArg is Sendable {
  pub sh: Shared;
  pub c: Handle;
  pub l: Handle;
  pub port: u16;
}

// Case 6, on a second thread: one bit of the answer for each thing that held
fn controls(a: ControlArg) u32 {
  let sh = &a.sh;
  var bits = 0u32;
  if !sh.lock(a.c) {return bits;}
  match sh.peerAddr(a.c) {
    case let Ok(p) {if p.port() == a.port {bits = bits | 1u32;}}
    case let Err(e) {}
  }
  let ka = KeepAlive(Duration.fromSeconds(30i64), Duration.fromSeconds(5i64), 4u32, Duration.zero());
  if sh.setKeepAlive(a.c, ka) == 0u32 {bits = bits | 2u32;}
  match sh.keepAlive(a.c) {
    case let Ok(k) {
      if k.idle.millis() == 30000i64 && k.interval.millis() == 5000i64 && k.probes == 4u32 {bits = bits | 4u32;}
    }
    case let Err(e) {}
  }
  if sh.shutdownSend(a.c) == 0u32 {bits = bits | 8u32;}
  sh.unlock(a.c);
  if sh.lock(a.l) {
    if IoError(sh.shutdownSend(a.l)).kind() == IoErrorKind.InvalidInput {bits = bits | 16u32;}
    match sh.peerAddr(a.l) {
      case is Err {bits = bits | 32u32;}
      else {}
    }
    sh.unlock(a.l);
  }
  bits
}

fn main() i32 {
  {
    var lp = Loop.mustMake();
    let l = lp.mustListen(SocketAddr.localhost(0u16));
    var port = 0u16;
    match lp.localAddr(l) {
      case let Ok(a) {port = a.port();}
      case let Err(e) {}
    }

    // 1. peerAddr
    var c: Handle;
    var s: Handle;
    c, s = pair(&mut lp, l, port);
    match lp.peerAddr(c) {
      case let Ok(a) {expectUInt(u64.from(a.port()), u64.from(port), "1: the client's peer is the listener's port");}
      case let Err(e) {expect(false, "1: the client's peer");}
    }
    var cport = 0u16;
    match lp.localAddr(c) {
      case let Ok(a) {cport = a.port();}
      case let Err(e) {}
    }
    match lp.peerAddr(s) {
      case let Ok(a) {expectUInt(u64.from(a.port()), u64.from(cport), "1: the server's peer is the client's port");}
      case let Err(e) {expect(false, "1: the server's peer");}
    }
    expect(IoError(lp.shutdown(l)).kind() == IoErrorKind.InvalidInput, "1: a listener is no connected socket to shut");

    // 2. A half-close
    expect(send(&mut lp, c, "x", 10u64).status == diag.outcomeDone, "2: the client sends");
    expectUInt(u64.from(lp.shutdown(c)), 0u64, "2: ...then shuts its sending side");
    let g1 = recv(&mut lp, s, 11u64);
    expect(g1.status == diag.outcomeDone && g1.n == 1usize, "2: the server receives the byte");
    let g2 = recv(&mut lp, s, 12u64);
    expect(g2.status == diag.outcomeDone && g2.n == 0usize, "2: ...then the end of the stream");
    expect(send(&mut lp, s, "yz", 13u64).status == diag.outcomeDone, "2: the server still sends");
    let g3 = recv(&mut lp, c, 14u64);
    expect(g3.status == diag.outcomeDone && g3.n == 2usize, "2: ...and the client still receives");
    expect(send(&mut lp, c, "late", 15u64).status == diag.outcomeFailed, "2: a send after the shutdown fails");
    lp.close(c);
    lp.close(s);

    // 3. A reset
    c, s = pair(&mut lp, l, port);
    lp.submit(Op.Recv(c, IoBuf(4096usize)), Target.Here(20u64));
    expect(lp.reset(s), "3: reset");
    expect(!lp.isOpen(s), "3: ...names nothing from now on");
    expect(!lp.reset(s), "3: ...and a second reset says false");
    let g4 = await1(&mut lp, 20u64);
    expect(g4.status == diag.outcomeFailed, "3: the peer's receive fails");
    expect(IoError(g4.code).kind() == IoErrorKind.ConnectionReset, "3: ...ConnectionReset");
    lp.close(c);

    // 4. close with unread bytes: a reset
    c, s = pair(&mut lp, l, port);
    send(&mut lp, c, "unread", 30u64);
    // Let the bytes arrive at the server's end before it closes
    lp.after(Instant.now() + Duration.fromMillis(20i64), Target.Here(31u64));
    await1(&mut lp, 31u64);
    lp.submit(Op.Recv(c, IoBuf(4096usize)), Target.Here(32u64));
    lp.close(s);
    let g5 = await1(&mut lp, 32u64);
    expect(g5.status == diag.outcomeFailed, "4: close with bytes unread: the peer's receive fails (a reset)");
    expectUInt(u64.from(g5.code), u64.from(g4.code), "4: ...as a reset does");
    lp.close(c);

    // 5. close with nothing unread: the end of the stream
    c, s = pair(&mut lp, l, port);
    lp.submit(Op.Recv(c, IoBuf(4096usize)), Target.Here(40u64));
    lp.close(s);
    let g6 = await1(&mut lp, 40u64);
    expect(g6.status == diag.outcomeDone && g6.n == 0usize, "5: close with nothing unread: the end of the stream");
    lp.close(c);

    // 6. The controls through the shared table, from a second thread
    c, s = pair(&mut lp, l, port);
    {
      let sh = lp.share();
      let t = thread.start(ControlArg(lp.share(), c, l, port), &controls);
      let bits = t.join();
      expectUInt(u64.from(bits & 1u32), 1u64, "6: peerAddr through the table is the listener's port");
      expectUInt(u64.from(bits & 2u32), 2u64, "6: setKeepAlive through the table");
      expectUInt(u64.from(bits & 4u32), 4u64, "6: keepAlive reads it back");
      expectUInt(u64.from(bits & 8u32), 8u64, "6: shutdownSend through the table");
      expectUInt(u64.from(bits & 16u32), 16u64, "6: a listener's shutdownSend is InvalidInput");
      expectUInt(u64.from(bits & 32u32), 32u64, "6: and its peerAddr an error");
      let g7 = recv(&mut lp, s, 50u64);
      expect(g7.status == diag.outcomeDone && g7.n == 0usize, "6: the peer sees the end of the stream");
      if sh.lock(s) {
        sh.markClosing(s);
        expect(sh.shutdownSend(s) != 0u32, "6: an entry marked closing is refused");
        expect(sh.peerAddr(s) is Err, "6: ... for its peer address too");
        sh.unlock(s);
      } else {
        expect(false, "6: the server's entry is published");
      }
    }
    lp.close(c);
    lp.close(s);
  }
  expectUInt(stats().lent, 0u64, "every buffer back in the pool");
  done()
}
