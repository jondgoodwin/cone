// The blocking pool: work with no completion form, run on a lane's threads
// and answered into the loop that asked, as the kernel's answers are.
//
// 1. A name looked up on the DNS lane: 'localhost' and '127.0.0.1', each
//    address carrying the port asked for.
// 2. A file's metadata: its size; a folder is a folder; a file that is not
//    there fails with ERROR_FILE_NOT_FOUND.
// 3. 1,000 file reads at once, opened, read and closed on the general
//    lane's threads, every one answered into this one loop with the right
//    bytes; the lane's queue depth and threads stay within its bounds.
// 4. A slow resolver does not delay disk work: while six look-ups, held on
//    the gate (below), fill the DNS lane, 200 file reads on the general lane
//    are all answered before the first look-up is.
// 5. A lane's queue is bounded: past it a submit is refused at once,
//    Failed with ERROR_BUSY, its buffer back.
// 6. A lane keeps its least threads, grows to its most while jobs wait, and
//    shrinks back after its idle time.
//
// No check here depends on how long a job takes. A job that must still be
// running when the test looks is held on the gate, which the test opens only
// after it has looked; and the test waits for the state it checks (a job
// started, a thread gone) rather than for a time to pass.

mod pool;

import testing use *;
import thread;
import collections use List, String;
import time use Instant, Duration;
import iobuf use *;
import iocore use *;
import ioerror use IoErrorKind;
import diag;
import path use Path;

fn waitFor(lp: &mut Loop, out: &mut List[Completion], n: usize) {
  let limit = Instant.now() + Duration.fromSeconds(10i64);
  while out.len() < n && Instant.now() < limit {
    lp.poll(limit, out);
  }
}

var gate: Atomic[u32];       // 0 while held jobs wait; the test sets 1 to let them go
var started: Atomic[u32];    // held jobs that have begun to run

fn @initpure init() {
  gate = Atomic[u32].of(0u32);
  started = Atomic[u32].of(0u32);
}

// Work that says it has started, then waits for the gate (or, were the test
// itself stuck, for a long time, so that a failure ends rather than hangs):
// Done(0)
fn heldWork(arg: u64, buf: &mut IoBuf) Outcome {
  started.add(1u32);
  let limit = Instant.now() + Duration.fromSeconds(30i64);
  while gate.load() == 0u32 && Instant.now() < limit {
    thread.sleep(Duration.fromMillis(1i64));
  }
  Outcome.Done(0usize)
}

// Work that ends at once: Done(0)
fn quickWork(arg: u64, buf: &mut IoBuf) Outcome {
  Outcome.Done(0usize)
}

// Wait until the held jobs started reach n
fn waitStarted(n: u32) {
  let limit = Instant.now() + Duration.fromSeconds(10i64);
  while started.load() < n && Instant.now() < limit {
    thread.sleep(Duration.fromMillis(1i64));
  }
}

fn fileName(i: u64) Path {
  var s = String.from("pool");
  s.appendUInt(i);
  s.append(".tmp");
  Path.fromString(s)
}

fn main() i32 {
  {
    var lp = Loop.mustMake();
    var out = List[Completion].empty();

    // 1. Names
    {
      lp.submit(resolveOp("localhost", 8080u16, IoBuf(4096usize)), Target.Here(1u64));
      lp.submit(resolveOp("127.0.0.1", 443u16, IoBuf(4096usize)), Target.Here(2u64));
      waitFor(&mut lp, &mut out, 2usize);
      requireUInt(u64.from(out.len()), 2u64, "both looked up");
      var k = 0usize;
      while k < 2usize {
        let c = &out[k];
        expectUInt(u64.from(c.kind), u64.from(diag.kindCall), "a pool job");
        require(c.isDone() && c.count() >= 1usize, "found");
        let addrs = addressesIn(&c.buf);
        expectUInt(u64.from(addrs.len()), u64.from(c.count()), "as many addresses as it says");
        var loopback = false;
        var ports = true;
        var j = 0usize;
        while j < addrs.len() {
          let t = addrs[j].text();
          if t.equals("127.0.0.1:8080") || t.equals("[0:0:0:0:0:0:0:1]:8080") || t.equals("127.0.0.1:443") {
            loopback = true;
          }
          if addrs[j].port() != (if c.token == 1u64 {8080u16} else {443u16}) {ports = false;}
          j = j + 1usize;
        }
        expect(loopback, "this machine's address among them");
        expect(ports, "each with the port asked for");
        k = k + 1usize;
      }
      out.clear();
    }

    // The files the rest reads: eight of 4,096 bytes, file i filled with
    // the letter 'a' + i
    var f = 0u64;
    while f < 8u64 {
      let named = fileName(f);
      match lp.openFile(&named, Access.Create) {
        case let Ok(r) {
          var b = IoBuf(4096usize);
          {
            let w = b.whole();
            var j = 0usize;
            while j < 4096usize {
              w[j] = 97u8 + u8.from(f);
              j = j + 1usize;
            }
          }
          b.setLen(4096usize);
          lp.submit(Op.WriteAt(r, 0u64, b), Target.Here(0u64));
          waitFor(&mut lp, &mut out, 1usize);
          out.clear();
          lp.close(r);
        }
        case let Err(e) {}
      }
      f = f + 1u64;
    }

    // 2. Metadata
    {
      // A Path variable is lent, and is as it was after the call
      let third = fileName(3u64);
      lp.submit(statOp(&third, Lane.general(), IoBuf(4096usize)), Target.Here(1u64));
      expectStr(third.view(), "pool3.tmp", "statOp lends its path");
      // A literal where a path is wanted is made one
      lp.submit(statOp(".", Lane.general(), IoBuf(4096usize)), Target.Here(2u64));
      lp.submit(statOp("no such file.tmp", Lane.general(), IoBuf(4096usize)), Target.Here(3u64));
      waitFor(&mut lp, &mut out, 3usize);
      requireUInt(u64.from(out.len()), 3u64, "three asked");
      var k = 0usize;
      while k < 3usize {
        let c = &out[k];
        if c.token == 1u64 {
          expect(c.isDone(), "a file's metadata");
          let s = fileStatIn(&c.buf);
          expectUInt(s.size, 4096u64, "its size");
          expect(!s.isDir(), "not a folder");
          expect(s.modified.unixSeconds() > 1700000000i64, "written lately");
        } else if c.token == 2u64 {
          expect(c.isDone() && fileStatIn(&c.buf).isDir(), "a folder");
        } else {
          expectUInt(u64.from(c.status), u64.from(diag.outcomeFailed), "a file not there: Failed");
          expect(c.error().kind() == IoErrorKind.NotFound, "NotFound (ERROR_FILE_NOT_FOUND, ENOENT)");
        }
        k = k + 1usize;
      }
      out.clear();
    }

    // 3. A thousand reads at once
    {
      var i = 0u64;
      while i < 1000u64 {
        let named = fileName(i % 8u64);
        lp.submit(readFileOp(&named, (i % 4u64) * 1024u64, Lane.general(),
          IoBuf(1024usize)), Target.Here(1000u64 + i));
        i = i + 1u64;
      }
      waitFor(&mut lp, &mut out, 1000usize);
      requireUInt(u64.from(out.len()), 1000u64, "all 1,000 answered into this loop");
      var right = 0u64;
      var k = 0usize;
      while k < out.len() {
        let c = &out[k];
        let want = 97u8 + u8.from((c.token - 1000u64) % 8u64);
        let v = c.buf.view();
        // Each read from its offset to the end of the 4,096 bytes, as much
        // as the 4,096-byte buffer holds
        let expected = 4096usize - usize.from(((c.token - 1000u64) % 4u64) * 1024u64);
        if c.isDone() && v.len == expected && v[0usize] == want && v[v.len - 1usize] == want {
          right = right + 1u64;
        }
        k = k + 1usize;
      }
      expectUInt(right, 1000u64, "each with its file's bytes, from its offset");
      out.clear();
      let st = Lane.general().stats();
      expect(st.maxQueued > 0u32 && st.maxQueued <= 1024u32, "jobs queued, within the lane's bound");
      expect(st.threads <= 4u32 && st.started >= 1u64, "on at most four threads");
      expectUInt(u64.from(st.queued), 0u64, "none waiting now");
    }

    // 4. A slow resolver beside the disk
    {
      gate.store(0u32);
      var i = 0u64;
      while i < 6u64 {
        lp.submit(Op.Call(Lane.dns(), &heldWork, 0u64, IoBuf.empty()), Target.Here(1u64));
        i = i + 1u64;
      }
      i = 0u64;
      while i < 200u64 {
        let named = fileName(i % 8u64);
        lp.submit(readFileOp(&named, 0u64, Lane.general(), IoBuf(4096usize)),
          Target.Here(2u64));
        i = i + 1u64;
      }
      // The look-ups are held, so the reads are answered while they are
      waitFor(&mut lp, &mut out, 200usize);
      requireUInt(u64.from(out.len()), 200u64, "the 200 reads answered while the look-ups are held");
      gate.store(1u32);
      waitFor(&mut lp, &mut out, 206usize);
      requireUInt(u64.from(out.len()), 206u64, "all answered");
      var firstSlow = out.len();
      var lastDisk = 0usize;
      var k = 0usize;
      while k < out.len() {
        if out[k].token == 1u64 && firstSlow == out.len() {firstSlow = k;}
        if out[k].token == 2u64 {lastDisk = k;}
        k = k + 1usize;
      }
      expect(lastDisk < firstSlow, "every disk read answered before the first slow look-up");
      expect(Lane.dns().stats().maxQueued >= 4u32, "the look-ups queued on their own lane");
      out.clear();
    }

    // 5. A bounded queue
    {
      let tiny = addLane(LaneConfig(name: "tiny", maxThreads: 1u32, queueBound: 2u32));
      // The lane's one thread is held in a job, so the next two wait in its
      // queue and the fourth finds it full
      gate.store(0u32);
      let before = started.load();
      lp.submit(Op.Call(tiny, &heldWork, 0u64, IoBuf.empty()), Target.Here(1u64));
      waitStarted(before + 1u32);
      lp.submit(Op.Call(tiny, &quickWork, 0u64, IoBuf.empty()), Target.Here(2u64));
      lp.submit(Op.Call(tiny, &quickWork, 0u64, IoBuf.empty()), Target.Here(3u64));
      lp.submit(Op.Call(tiny, &quickWork, 0u64, IoBuf(10usize)), Target.Here(4u64));
      lp.poll(Instant.now(), &mut out);
      requireUInt(u64.from(out.len()), 1u64, "the one past the bound answered at once");
      expectUInt(out[0usize].token, 4u64, "the fourth");
      expectUInt(u64.from(out[0usize].status), u64.from(diag.outcomeFailed), "Failed");
      expect(out[0usize].error().kind() == IoErrorKind.ResourceBusy, "ResourceBusy (ERROR_BUSY, EBUSY)");
      expectUInt(u64.from(out[0usize].buf.capacity()), 4096u64, "its buffer back");
      out.clear();
      gate.store(1u32);
      waitFor(&mut lp, &mut out, 3usize);
      expectUInt(u64.from(out.len()), 3u64, "the three within it ran");
      out.clear();
      let st = tiny.stats();
      expectUInt(st.refused, 1u64, "one refused");
      expectUInt(u64.from(st.maxQueued), 2u64, "two queued at most");
    }

    // 6. Threads grow and shrink
    {
      let l = addLane(LaneConfig(name: "elastic", minThreads: 1u32, maxThreads: 3u32, idleMillis: 50u32));
      expectUInt(u64.from(l.stats().threads), 1u64, "its least thread, from the start");
      gate.store(0u32);
      let before = started.load();
      var i = 0u64;
      while i < 3u64 {
        lp.submit(Op.Call(l, &heldWork, 0u64, IoBuf.empty()), Target.Here(1u64));
        i = i + 1u64;
      }
      waitStarted(before + 3u32);
      expectUInt(u64.from(l.stats().threads), 3u64, "three while three jobs are held");
      gate.store(1u32);
      waitFor(&mut lp, &mut out, 3usize);
      out.clear();
      // A thread beyond the least leaves after its 50 ms idle: wait for that,
      // up to a limit, not for a time to pass
      let gone = Instant.now() + Duration.fromSeconds(10i64);
      while l.stats().threads > 1u32 && Instant.now() < gone {
        thread.sleep(Duration.fromMillis(5i64));
      }
      expectUInt(u64.from(l.stats().threads), 1u64, "back to its least after its idle time");
    }

    let cs = lp.counters();
    expectUInt(cs.delivered, cs.submitted, "every operation answered once");
    expectUInt(cs.inFlight, 0u64, "nothing in flight");
    expectUInt(stats().lent, 0u64, "every buffer back in the pool");
  }
  trimAll();      // the pools are the process's: their idle slabs go back to the OS on request
  expectUInt(osBlocks(), 0u64, "and every block back to the OS");

  // A lane's name is text, a '&str'
  let laneCfg = LaneConfig(name: "text", maxThreads: 1u32);
  let laneName: &str = laneCfg.name;
  expect(laneName == "text", "a lane's name is text");
  done()
}
