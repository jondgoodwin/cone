// A lane that waits (LaneConfig.waitWhenFull), as the DNS lane does: a job
// offered with the queue full is kept in the lane's waiting list, holding no
// thread, and is neither refused nor lost.
//
// 1. Past the bound a job waits (stats().waiting), is not refused, and when
//    room frees it is queued and runs: every job answers Done, in the order
//    offered.
// 2. A waiting job with a deadline ends at it: TimedOut, with its buffer, never
//    run; the others go on.
// 3. A waiting job cancelled: Cancelled, with its buffer, never run.
// 4. The DNS lane waits; a lane made with no waitWhenFull still refuses
//    (pool.cone's case 5).

mod lanewait;

import testing use *;
import thread;
import collections use List;
import time use Instant, Duration;
import iobuf use *;
import iocore use *;
import ioerror use IoErrorKind;
import diag;

fn waitFor(lp: &mut Loop, out: &mut List[Completion], n: usize) {
  let limit = Instant.now() + Duration.fromSeconds(10i64);
  while out.len() < n && Instant.now() < limit {
    lp.poll(limit, out);
  }
}

var gate: Atomic[u32];       // 0 while held jobs wait; the test sets 1 to let them go
var started: Atomic[u32];    // held jobs that have begun to run
var ran: Atomic[u32];        // quick jobs that ran

fn @initpure init() {
  gate = Atomic[u32].of(0u32);
  started = Atomic[u32].of(0u32);
  ran = Atomic[u32].of(0u32);
}

fn heldWork(arg: u64, buf: &mut IoBuf) Outcome {
  started.add(1u32);
  let limit = Instant.now() + Duration.fromSeconds(30i64);
  while gate.load() == 0u32 && Instant.now() < limit {
    thread.sleep(Duration.fromMillis(1i64));
  }
  Outcome.Done(0usize)
}

fn quickWork(arg: u64, buf: &mut IoBuf) Outcome {
  ran.add(1u32);
  Outcome.Done(usize.from(arg))
}

fn waitStarted(n: u32) {
  let limit = Instant.now() + Duration.fromSeconds(10i64);
  while started.load() < n && Instant.now() < limit {
    thread.sleep(Duration.fromMillis(1i64));
  }
}

fn main() i32 {
  {
    var lp = Loop.mustMake();
    var out = List[Completion]();

    // 1. Past the bound: waits, then runs when room frees
    {
      let l = addLane(LaneConfig(name: "waits", maxThreads: 1u32, queueBound: 2u32, waitWhenFull: true));
      gate.store(0u32);
      ran.store(0u32);
      let before = started.load();
      lp.submit(Op.Call(l, &heldWork, 0u64, IoBuf()), Target.Here(100u64));
      waitStarted(before + 1u32);
      // Two fill the queue; the next four are past the bound
      var i = 1u64;
      while i <= 6u64 {
        lp.submit(Op.Call(l, &quickWork, i, IoBuf()), Target.Here(i));
        i = i + 1u64;
      }
      lp.poll(Instant.now(), &mut out);
      expectUInt(u64.from(out.len()), 0u64, "nothing answered while the thread is held, nothing refused");
      var st = l.stats();
      expectUInt(u64.from(st.queued), 2u64, "two in the queue");
      expectUInt(u64.from(st.waiting), 4u64, "four in the waiting list");
      expectUInt(st.refused, 0u64, "none refused");
      expectUInt(u64.from(st.threads), 1u64, "no thread added for them");
      gate.store(1u32);
      waitFor(&mut lp, &mut out, 7usize);
      requireUInt(u64.from(out.len()), 7u64, "all seven answered");
      var allDone = true;
      var k = 0usize;
      while k < out.len() {
        if !out[k].isDone() {allDone = false;}
        k = k + 1usize;
      }
      expect(allDone, "each Done: the waiting ones ran when room freed");
      expectUInt(u64.from(ran.load()), 6u64, "the six quick jobs ran");
      // The lane runs in the order offered: held one first, then 1 to 6
      var inOrder = true;
      k = 1usize;
      while k < out.len() {
        if out[k].token != u64.from(k) {inOrder = false;}
        k = k + 1usize;
      }
      expect(inOrder, "in the order offered");
      out.clear();
      st = l.stats();
      expectUInt(u64.from(st.waiting), 0u64, "the waiting list is empty");
      expectUInt(st.refused, 0u64, "still none refused");
      expectUInt(u64.from(st.maxQueued), 2u64, "the queue never held more than its bound");
    }

    // 2. A waiting job ends at its deadline; 3. and on a cancel
    {
      let l = addLane(LaneConfig(name: "waits2", maxThreads: 1u32, queueBound: 1u32, waitWhenFull: true));
      gate.store(0u32);
      ran.store(0u32);
      let before = started.load();
      lp.submit(Op.Call(l, &heldWork, 0u64, IoBuf()), Target.Here(100u64));
      waitStarted(before + 1u32);
      lp.submit(Op.Call(l, &quickWork, 1u64, IoBuf()), Target.Here(1u64));       // the queue's one
      let t0 = Instant.now();
      lp.submitBy(Op.Call(l, &quickWork, 2u64, IoBuf(100usize)), Target.Here(2u64),
        t0 + Duration.fromMillis(30i64));                                          // waiting, with a deadline
      let id = lp.submit(Op.Call(l, &quickWork, 3u64, IoBuf(100usize)), Target.Here(3u64)); // waiting, to cancel
      lp.submit(Op.Call(l, &quickWork, 4u64, IoBuf()), Target.Here(4u64));       // waiting, left alone
      expectUInt(u64.from(l.stats().waiting), 3u64, "three waiting");
      waitFor(&mut lp, &mut out, 1usize);
      requireUInt(u64.from(out.len()), 1u64, "the one with a deadline answered, the thread still held");
      expectUInt(out[0usize].token, 2u64, "the one with the deadline");
      expectUInt(u64.from(out[0usize].status), u64.from(diag.outcomeTimedOut), "TimedOut");
      expect(out[0usize].error().kind() == IoErrorKind.TimedOut, "its error says so");
      expectUInt(u64.from(out[0usize].buf.capacity()), 4096u64, "with its buffer: it never ran");
      expect(Instant.now() >= t0 + Duration.fromMillis(25i64), "not long before its deadline");
      out.clear();
      expectUInt(u64.from(l.stats().waiting), 2u64, "two waiting now");
      expect(lp.cancel(id), "the cancel of a waiting job is accepted");
      waitFor(&mut lp, &mut out, 1usize);
      requireUInt(u64.from(out.len()), 1u64, "the cancelled one answered");
      expectUInt(out[0usize].token, 3u64, "the cancelled one");
      expectUInt(u64.from(out[0usize].status), u64.from(diag.outcomeCancelled), "Cancelled");
      expectUInt(u64.from(out[0usize].buf.capacity()), 4096u64, "with its buffer: it never ran");
      out.clear();
      expectUInt(u64.from(l.stats().waiting), 1u64, "one waiting now");
      gate.store(1u32);
      waitFor(&mut lp, &mut out, 3usize);
      requireUInt(u64.from(out.len()), 3u64, "the held job and the two left answered");
      var done = 0u64;
      var k = 0usize;
      while k < out.len() {
        if out[k].isDone() {done = done + 1u64;}
        k = k + 1usize;
      }
      expectUInt(done, 3u64, "all Done");
      expectUInt(u64.from(ran.load()), 2u64, "only the jobs 1 and 4 ran; the deadline's and the cancel's never did");
      out.clear();
      let st = l.stats();
      expectUInt(st.cancelled, 2u64, "two taken out, from the waiting list");
      expectUInt(u64.from(st.waiting), 0u64, "none waiting");
    }

    // 4. The DNS lane waits
    {
      gate.store(0u32);
      let before = started.load();
      let n = 300u64;
      lp.submit(Op.Call(Lane.dns(), &heldWork, 0u64, IoBuf()), Target.Here(1000u64));
      lp.submit(Op.Call(Lane.dns(), &heldWork, 0u64, IoBuf()), Target.Here(1001u64));
      waitStarted(before + 2u32);
      var i = 0u64;
      while i < n {
        lp.submit(resolveOp("127.0.0.1", 80u16, IoBuf(4096usize)), Target.Here(i));
        i = i + 1u64;
      }
      let st = Lane.dns().stats();
      expectUInt(st.refused, 0u64, "no look-up refused, though 300 are past the 256 bound");
      expectUInt(u64.from(st.waiting), 44u64, "44 wait in the list");
      gate.store(1u32);
      waitFor(&mut lp, &mut out, 302usize);
      requireUInt(u64.from(out.len()), 302u64, "all answered");
      var good = 0u64;
      var k = 0usize;
      while k < out.len() {
        if out[k].isDone() {good = good + 1u64;}
        k = k + 1usize;
      }
      expectUInt(good, 302u64, "all Done");
      out.clear();
    }

    let cs = lp.counters();
    expectUInt(cs.delivered, cs.submitted, "every operation answered once");
    expectUInt(cs.inFlight, 0u64, "nothing in flight");
    expectUInt(stats().lent, 0u64, "every buffer back in the pool");
  }
  trimAll();
  expectUInt(osBlocks(), 0u64, "and every block back to the OS");
  done()
}
