// The one line each error of this package gives a person is pinned here, so a change
// to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import iocore use IoError;
import ioerror use IoErrorKind;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- IoError.cancelled(), "cancelled", "cancelled");
  says(String() <- IoError.timedOut(), "deadline passed", "deadline");
  says(String() <- IoError.ofKind(IoErrorKind.InvalidInput), "invalid input", "made of a kind");
  says(String() <- IoError(2u32), #if #os == .windows {"The system cannot find the file specified"} #else {"No such file or directory"}, "a system number");
  done()
}
