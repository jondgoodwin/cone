// cnmalloc unit tests: the class table (every size 0 to 64 KiB gets a block at least that big, the waste
// above 128 bytes stays under 12.5%), aligned requests at every power of two to 1 MiB, the standard API's
// edges (malloc(0), realloc(NULL/0), calloc overflow, _expand, _recalloc), large blocks growing and
// shrinking in place, and a block the C runtime made going through free, realloc and _msize.
// Each test makes its own heap (a 1 GiB reservation) and destroys it, so nothing here touches the
// program's own malloc.

mod edges;

import testing use *;
import libc;
import cnmalloc;

// Row 454: with CNTEST_GLOBAL=1, when the program is linked with cn.lib and CNMALLOC=design=2, the tests that can run on
// the PROCESS's heap do (the shim exports it as cnmalloc_heap), so the API's edges are checked through the second design. The
// lock design's own internals (batches, the large-reserve setting's own heaps, layout) are skipped then, and no heap is destroyed.
extern {
  fn @c(system) GetModuleHandleW(name: *u8) usize;
}
alias HeapFn = &fn @c () usize;
alias DesignFn = &fn @c () i32;

fn globalHeap() usize {
  if libc.getenv("CNTEST_GLOBAL") as usize == 0usize { return 0usize; }
  let m = GetModuleHandleW(null);
  let hf = GetProcAddress(m, "cnmalloc_heap");
  let df = GetProcAddress(m, "cnmalloc_design");
  if hf == 0usize || df == 0usize { return 0usize; }
  if (df as *u8 as DesignFn)() != 2i32 { return 0usize; }
  (hf as *u8 as HeapFn)()
}

fn drop(h: usize) {
  if h != globalHeap() { cnmalloc.cnm_destroy(h); }
}

fn heap(mode: usize, delay: u64) usize {
  let g = globalHeap();
  if g != 0usize { return g; }
  cnmalloc.cnm_make(1073741824usize, mode, delay, 67108864usize)
}

fn at(p: *u8, i: usize) *u8 { ((p as usize) + i) as *u8 }

fn fill(p: *u8, n: usize, v: u8) {
  var i = 0usize;
  while i < n { *at(p, i) = v; i = i + 1usize; }
}

fn same(p: *u8, n: usize, v: u8) bool {
  var i = 0usize;
  while i < n { if *at(p, i) != v { return false; } i = i + 1usize; }
  true
}

fn classTable() {
  let h = heap(1usize, 1000u64);
  var bad = 0i64;
  var tooBig = 0i64;
  var n = 0usize;
  while n <= 65536usize {
    let p = cnmalloc.cnm_malloc(h, n);
    if p as usize == 0usize { bad = bad + 1i64; n = n + 1usize; continue; }
    let u = cnmalloc.cnm_usable(h, p);
    if u < n { bad = bad + 1i64; }
    if n > 128usize && n <= 32768usize && u * 8usize > n * 9usize { tooBig = tooBig + 1i64; }
    if n > 0usize { *at(p, n - 1usize) = 7u8; *p = 7u8; }
    cnmalloc.cnm_free(h, p);
    n = n + 1usize;
  }
  expectInt(bad, 0, "every size 0 to 64 KiB gets a block at least that big");
  expectInt(tooBig, 0, "above 128 bytes the block is under 12.5% bigger than the request");
  // the classes: 16-byte steps to 128
  expectUInt(u64.from(cnmalloc.cnm_usable(h, cnmalloc.cnm_malloc(h, 1usize))), 16, "1 byte: the 16-byte class");
  expectUInt(u64.from(cnmalloc.cnm_usable(h, cnmalloc.cnm_malloc(h, 128usize))), 128, "128 bytes: its own class");
  expectUInt(u64.from(cnmalloc.cnm_usable(h, cnmalloc.cnm_malloc(h, 129usize))), 144, "129 bytes: the next, 144");
  expectUInt(u64.from(cnmalloc.cnm_usable(h, cnmalloc.cnm_malloc(h, 32768usize))), 32768, "32 KiB: the largest small class");
  expectUInt(u64.from(cnmalloc.cnm_usable(h, cnmalloc.cnm_malloc(h, 32769usize))), 32769, "over 32 KiB: a large block, its own size");
  // two malloc(0) are two blocks
  let a = cnmalloc.cnm_malloc(h, 0usize);
  let b = cnmalloc.cnm_malloc(h, 0usize);
  expect(a as usize != 0usize && b as usize != 0usize && a as usize != b as usize, "malloc(0): two unique blocks");
  expectUInt(u64.from(cnmalloc.cnm_usable(h, a)), 16, "malloc(0): the smallest class");
  drop(h);
}

fn aligned() {
  let h = heap(1usize, 1000u64);
  var bad = 0i64;
  var a = 1usize;
  while a <= 1048576usize {
    var round = 0usize;
    while round < 4usize {
      let n = if round == 0usize { 1usize } else if round == 1usize { 100usize } else if round == 2usize { 5000usize } else { 70000usize };
      let p = cnmalloc.cnm_aligned(h, a, n);
      if p as usize == 0usize { bad = bad + 1i64; }
      else {
        if (p as usize) % a != 0usize { bad = bad + 1i64; }
        if cnmalloc.cnm_usable(h, p) < n { bad = bad + 1i64; }
        fill(p, n, 0x5Au8);
        cnmalloc.cnm_free(h, p);
      }
      round = round + 1usize;
    }
    a = a * 2usize;
  }
  expectInt(bad, 0, "aligned blocks at every power of two to 1 MiB, four sizes each");
  expect(cnmalloc.cnm_aligned(h, 24usize, 10usize) as usize == 0usize, "an alignment that is not a power of two: null");
  drop(h);
}

fn apiEdges() {
  let h = heap(1usize, 1000u64);
  // realloc(NULL, n) is malloc(n)
  let p = cnmalloc.cnm_realloc(h, 0usize as *u8, 50usize);
  expect(p as usize != 0usize && cnmalloc.cnm_usable(h, p) >= 50usize, "realloc(NULL, 50) is a malloc");
  fill(p, 50usize, 0x11u8);
  // same class: same pointer
  let q = cnmalloc.cnm_realloc(h, p, 60usize);
  expect(q as usize == p as usize, "realloc within the class: the same pointer");
  // bigger: moves, prefix survives
  let r = cnmalloc.cnm_realloc(h, q, 5000usize);
  expect(r as usize != 0usize && same(r, 50usize, 0x11u8), "realloc to a bigger class: the prefix survives");
  // smaller
  let s = cnmalloc.cnm_realloc(h, r, 20usize);
  expect(s as usize != 0usize && same(s, 20usize, 0x11u8), "realloc to a smaller class: the prefix survives");
  // realloc(p, 0) frees and answers null
  expect(cnmalloc.cnm_realloc(h, s, 0usize) as usize == 0usize, "realloc(p, 0) answers null");
  cnmalloc.cnm_free(h, 0usize as *u8);
  expect(true, "free(NULL) does nothing");
  // calloc: overflow is null, and the block is zero even when reused dirty
  expect(cnmalloc.cnm_calloc(h, 0x8000000000000000usize, 4usize) as usize == 0usize, "calloc: count * size overflowing gives null");
  var zeroBad = 0i64;
  var round = 0usize;
  while round < 50usize {
    let d = cnmalloc.cnm_malloc(h, 300usize);
    fill(d, 300usize, 0xFFu8);
    cnmalloc.cnm_free(h, d);
    let z = cnmalloc.cnm_calloc(h, 10usize, 30usize);
    if !same(z, 300usize, 0u8) { zeroBad = zeroBad + 1i64; }
    cnmalloc.cnm_free(h, z);
    round = round + 1usize;
  }
  expectInt(zeroBad, 0, "calloc from a block freed dirty is zero");
  // _expand: in place or null
  let e = cnmalloc.cnm_malloc(h, 100usize);
  expect(cnmalloc.cnm_expand(h, e, 112usize) as usize == e as usize, "_expand within the cell: the same pointer");
  expect(cnmalloc.cnm_expand(h, e, 10000usize) as usize == 0usize, "_expand that would not fit: null");
  // _recalloc: grows zero-filled
  let rc = cnmalloc.cnm_recalloc(h, 0usize as *u8, 10usize, 10usize);
  expect(rc as usize != 0usize && same(rc, 100usize, 0u8), "_recalloc(NULL, 10, 10) is a zeroed 100");
  fill(rc, 100usize, 0x22u8);
  let rc2 = cnmalloc.cnm_recalloc(h, rc, 100usize, 10usize);
  expect(rc2 as usize != 0usize && same(rc2, 100usize, 0x22u8) && same(at(rc2, 100usize), 900usize, 0u8), "_recalloc grows: prefix kept, the rest zero");
  drop(h);
}

fn largeBlocks() {
  let h = heap(1usize, 1000u64);
  let p = cnmalloc.cnm_malloc(h, 100000usize);
  fill(p, 100000usize, 0xABu8);
  expectUInt(u64.from(cnmalloc.cnm_usable(h, p)), 100000, "a large block's size is what was asked");
  let g = cnmalloc.cnm_realloc(h, p, 200000usize);
  // (on the process's heap a freed reservation of another size may be reused for p, with no room to grow: not a fault)
  expect(g as usize == p as usize || globalHeap() != 0usize, "a large block grows in place when its reservation has room");
  expect(same(g, 100000usize, 0xABu8), "grown in place: the prefix is intact");
  fill(g, 200000usize, 0xCDu8);
  let s = cnmalloc.cnm_realloc(h, g, 70000usize);
  expect(s as usize == g as usize && same(s, 70000usize, 0xCDu8), "a large block shrinks in place (tail of 64 KiB or more decommitted)");
  expectUInt(u64.from(cnmalloc.cnm_usable(h, s)), 70000, "and reports the new size");
  // growing past its reservation moves it and keeps the data
  let big = cnmalloc.cnm_realloc(h, s, 300000000usize);
  expect(big as usize != 0usize && same(big, 70000usize, 0xCDu8), "growing past the reservation moves it, the prefix intact");
  // down to a small class: moves to a cell
  let sm = cnmalloc.cnm_realloc(h, big, 100usize);
  expect(sm as usize != 0usize && same(sm, 100usize, 0xCDu8) && cnmalloc.cnm_usable(h, sm) == 112usize, "a large block realloc'd small becomes a cell");
  cnmalloc.cnm_free(h, sm);
  // a freed large block is reused (kept committed) by the next that fits
  let a = cnmalloc.cnm_malloc(h, 1000000usize);
  cnmalloc.cnm_free(h, a);
  let b = cnmalloc.cnm_malloc(h, 900000usize);
  expect(b as usize == a as usize, "a freed large reservation is reused by a later block that fits");
  expect(same(cnmalloc.cnm_calloc(h, 1usize, 900000usize), 900000usize, 0u8), "calloc of a large block is zero");
  // many large blocks: the table grows
  var live = 0usize;
  var ptrs = libc.calloc(5000usize, 8usize) as *usize;
  var i = 0usize;
  while i < 5000usize {
    let x = cnmalloc.cnm_malloc(h, 40000usize + i);
    if x as usize != 0usize { *((ptrs as usize + i * 8usize) as *usize) = x as usize; live = live + 1usize; }
    i = i + 1usize;
  }
  expectUInt(u64.from(live), 5000, "5000 large blocks at once (the table grows by doubling)");
  var ok = 0i64;
  i = 0usize;
  while i < 5000usize {
    let x = *((ptrs as usize + i * 8usize) as *usize);
    if cnmalloc.cnm_usable(h, x as *u8) == 40000usize + i { ok = ok + 1i64; }
    cnmalloc.cnm_free(h, x as *u8);
    i = i + 1usize;
  }
  expectInt(ok, 5000, "each found by address, each its own size, all freed");
  libc.free(ptrs as *u8);
  drop(h);
}

fn foreign() {
  let h = heap(1usize, 1000u64);
  var q = libc.malloc(100usize);
  fill(q, 100usize, 0x33u8);
  expect(!cnmalloc.cnm_owns(h, q as usize), "a block the C runtime made is not ours");
  expect(cnmalloc.cnm_usable(h, q) >= 100usize, "_msize of a foreign block is forwarded");
  q = cnmalloc.cnm_realloc(h, q, 400usize);
  expect(!cnmalloc.cnm_owns(h, q as usize) && same(q, 100usize, 0x33u8), "realloc of a foreign block stays foreign, data intact");
  cnmalloc.cnm_free(h, q);
  expect(true, "free of a foreign block is forwarded, no crash");
  let mine = cnmalloc.cnm_malloc(h, 100usize);
  expect(cnmalloc.cnm_owns(h, mine as usize), "our own block is ours");
  cnmalloc.cnm_free(h, mine);
  drop(h);
}

extern {
  fn @c(system) GetModuleHandleA(name: cstr) usize;
  fn @c(system) GetProcAddress(module: usize, name: cstr) usize;
}

// a block from ucrtbase's own _aligned_malloc must be freed and sized by ucrtbase's aligned functions (plain free would corrupt its heap)
fn foreignAligned() {
  let h = heap(1usize, 1000u64);
  let m = GetModuleHandleA("ucrtbase.dll");
  let am = GetProcAddress(m, "_aligned_malloc") as &fn @c (n: usize, a: usize) *u8;
  let p = am(100usize, 64usize);
  expect(p as usize != 0usize && !cnmalloc.cnm_owns(h, p as usize), "a block from the C runtime's _aligned_malloc is foreign");
  fill(p, 100usize, 0x44u8);
  expect(cnmalloc.cnm_aligned_msize(h, p, 64usize, 0usize) >= 100usize, "_aligned_msize of a foreign aligned block asks the C runtime (with its alignment)");
  cnmalloc.cnm_aligned_free(h, p);
  expect(true, "_aligned_free of a foreign aligned block goes to the C runtime's _aligned_free, no crash");
  let mine = cnmalloc.cnm_aligned(h, 64usize, 100usize);
  expect(cnmalloc.cnm_aligned_msize(h, mine, 64usize, 0usize) >= 100usize, "_aligned_msize of our own block");
  cnmalloc.cnm_aligned_free(h, mine);
  drop(h);
}

// row 446: a block doubled from 64 KiB to 64 MiB (11 sizes, 10 reallocs). At the default reserve of 2 it
// outgrows its reservation on every second doubling: 5 moves (copying 128K+512K+2M+8M+32M = 44695552 bytes)
// and 5 grows in place. At 32 its first reservation is 2 MiB, so 128K..2M grow in place (5), the 4 MiB move
// takes a reservation of 4M + 64M (the cap), and the rest grow in place: 1 move (2097152 bytes) and 9 grows.
fn word(out: *u64, i: usize) u64 { *((out as usize + i * 8usize) as *u64) }

fn doubling(reserveN: usize) *u64 {
  let h = cnmalloc.cnm_make_lr(1073741824usize, 1usize, 1000u64, 67108864usize, reserveN);
  var p = cnmalloc.cnm_malloc(h, 65536usize);
  fill(p, 65536usize, 0x5Au8);
  var sz = 65536usize;
  var ok = true;
  while sz < 67108864usize {
    p = cnmalloc.cnm_realloc(h, p, sz * 2usize);
    if p as usize == 0usize || !same(p, sz, 0x5Au8) { ok = false; break; }
    fill(p, sz * 2usize, 0x5Au8);
    sz = sz * 2usize;
  }
  expect(ok && sz == 67108864usize, "doubling to 64 MiB keeps the data");
  var out = libc.calloc(400usize, 8usize) as *u64;
  cnmalloc.cnm_stats(h, out, 400usize);
  cnmalloc.cnm_free(h, p);
  drop(h);
  out
}

fn largeReserveSetting() {
  let a = doubling(2usize);
  expectUInt(word(a, 368usize), 5, "reserve 2: 5 grows in place");
  expectUInt(word(a, 369usize), 5, "reserve 2: 5 moves");
  expectUInt(word(a, 378usize), 44695552, "reserve 2: bytes copied by moves");
  expectUInt(word(a, 371usize), word(a, 379usize) + word(a, 380usize) + word(a, 381usize) + word(a, 382usize), "syscalls = reserve + commit + decommit + release");
  expect(word(a, 379usize) >= 6u64, "reserve 2: reserve calls counted (first block and each move, plus the table)");
  let b = doubling(32usize);
  expectUInt(word(b, 368usize), 9, "reserve 32: 9 grows in place");
  expectUInt(word(b, 369usize), 1, "reserve 32: 1 move");
  expectUInt(word(b, 378usize), 2097152, "reserve 32: bytes copied by moves");
  expectUInt(word(b, 371usize), word(b, 379usize) + word(b, 380usize) + word(b, 381usize) + word(b, 382usize), "reserve 32: syscalls add up by kind");
  libc.free(a as *u8);
  libc.free(b as *u8);
}

fn layout() {
  expectUInt(u64.from(mem.sizeof[cnmalloc.Desc]()), 64, "a page descriptor is 64 bytes");
  expect(mem.sizeof[cnmalloc.Class]() <= 128usize, "a class fits its 128-byte stride");
  expect(mem.sizeof[cnmalloc.Heap]() <= 1024usize, "the heap header fits its 1 KiB");
  expect(mem.sizeof[cnmalloc.Pool]() <= 1024usize, "the pool fits its 1 KiB");
  expect(mem.sizeof[cnmalloc.Large]() <= 512usize, "the large table's header fits its 512 bytes");
  expectUInt(u64.from(mem.sizeof[cnmalloc.LEntry]()), 48, "a large entry is 48 bytes");
  expect(mem.sizeof[cnmalloc.Timer]() <= 512usize, "the timer's state fits its 512 bytes");
}

// row 426: the batch calls the workers' cache uses. Cells taken in a batch stay counted as used (live, and their
// pages active) until a batch free gives them back, and a page retires only when its last cell comes back.
fn pageCount(h: usize, cl: usize) u64 {
  let out = libc.calloc(400usize, 8usize) as *u64;
  cnmalloc.cnm_stats(h, out, 400usize);
  let v = *((out as usize + (cl * 5usize + 3usize) * 8usize) as *u64);
  libc.free(out as *u8);
  v
}

fn liveCount(h: usize, cl: usize) u64 {
  let out = libc.calloc(400usize, 8usize) as *u64;
  cnmalloc.cnm_stats(h, out, 400usize);
  let v = *((out as usize + (cl * 5usize + 2usize) * 8usize) as *u64);
  libc.free(out as *u8);
  v
}

fn batches() {
  let h = heap(0usize, 1000u64);                  // giveback=now: a page retires the moment it empties
  let cl = cnmalloc.cnm_class_of(h, 1024usize);
  expectUInt(u64.from(cnmalloc.cnm_class_size(h, cl)), 1024, "the 1024-byte class");
  expectUInt(u64.from(cnmalloc.cnm_class_of(h, 40000usize) + 1usize), 0, "a size over 32 KiB has no class");
  var got = 0usize;
  let chain = cnmalloc.cnm_batch_alloc(h, cl, 200usize, &mut got);
  expectUInt(u64.from(got), 200, "a batch of 200 cells");
  expectUInt(liveCount(h, cl), 200, "the batch's cells are counted as used");
  expectUInt(pageCount(h, cl), 4, "200 cells of 1024 bytes need 4 pages (64 a page)");
  // walk the chain: 200 distinct cells, each writable end to end
  var n = 0usize;
  var a = chain;
  var distinct = true;
  while a != 0usize && n < 300usize {
    let nx = *(a as *usize);
    fill(at(a as *u8, 8usize), 1016usize, 5u8);   // all but the link word
    if cnmalloc.cnm_cell_class(h, a as *u8) != cl { distinct = false; }
    a = nx;
    n = n + 1usize;
  }
  expectUInt(u64.from(n), 200, "the chain holds 200 cells");
  expect(distinct, "every cell of the batch reports the batch's class");
  // give back the first 150 and then the rest: the live count follows, the pages retire only when empty
  var rest = chain;
  var i = 0usize;
  while i < 150usize { rest = *(rest as *usize); i = i + 1usize; }
  // the 150th cell's link must be cut before the first part goes back (the free overwrites first words)
  var cut = chain;
  i = 1usize;
  while i < 150usize { cut = *(cut as *usize); i = i + 1usize; }
  *(cut as *usize) = 0usize;
  cnmalloc.cnm_batch_free(h, cl, chain, 150usize);
  expectUInt(liveCount(h, cl), 50, "150 given back: 50 still used");
  expect(pageCount(h, cl) >= 1u64, "a page holding a cell still used is not retired");
  cnmalloc.cnm_batch_free(h, cl, rest, 50usize);
  expectUInt(liveCount(h, cl), 0, "all given back");
  expectUInt(pageCount(h, cl), 0, "every page retired once its last cell is back");
  // a batch free of a plain malloc'd block and a plain free of a batched one mix
  let one = cnmalloc.cnm_batch_alloc(h, cl, 1usize, &mut got);
  expectUInt(u64.from(got), 1, "a batch of one");
  cnmalloc.cnm_free(h, one as *u8);
  expectUInt(liveCount(h, cl), 0, "a batched cell freed singly");
  drop(h);
}

fn main() i32 {
  let g = globalHeap();
  layout();
  if g == 0usize { batches(); }
  classTable();
  aligned();
  apiEdges();
  largeBlocks();
  if g == 0usize { largeReserveSetting(); }
  // a block "the C runtime made" is one of ours when the program is linked with cn.lib: the foreign tests are for the test heaps
  if g == 0usize { foreign(); foreignAligned(); }
  done()
}
