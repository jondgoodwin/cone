mod osplat;

import oswin;
import oslinux;

// The OS layer the heap calls (row 550): one name for the platform's implementation, because a module trait cannot be
// chosen by a build setting yet. Each function forwards, at compile time, to 'oswin' on Windows and 'oslinux' on Linux.
// A platform with no layer fails at link, by this name: cnmalloc_has_no_os_layer_for_this_platform, which no object
// defines. Both modules meet the trait 'Os' (os.cone); the rest of what they offer is the same on both. The wrong
// platform's module is compiled but never called, so nothing of it is linked in.

pub alias TimerCb = &fn @c (inst: usize, ctx: usize, timer: usize);

extern {
  fn @c cnmalloc_has_no_os_layer_for_this_platform() usize;
}

pub fn reserve(bytes: usize) usize inline {
  #if #os == .windows { oswin.reserve(bytes) } #else { #if #os == .linux { oslinux.reserve(bytes) } #else { cnmalloc_has_no_os_layer_for_this_platform() } }
}
pub fn commit(addr: usize, bytes: usize) bool inline {
  #if #os == .windows { oswin.commit(addr, bytes) } #else { #if #os == .linux { oslinux.commit(addr, bytes) } #else { cnmalloc_has_no_os_layer_for_this_platform() != 0usize } }
}
pub fn decommit(addr: usize, bytes: usize) inline {
  #if #os == .windows { oswin.decommit(addr, bytes); } #else { #if #os == .linux { oslinux.decommit(addr, bytes); } #else { cnmalloc_has_no_os_layer_for_this_platform(); } }
}
pub fn release(addr: usize, bytes: usize) inline {
  #if #os == .windows { oswin.release(addr, bytes); } #else { #if #os == .linux { oslinux.release(addr, bytes); } #else { cnmalloc_has_no_os_layer_for_this_platform(); } }
}
pub fn tick() u64 inline {
  #if #os == .windows { oswin.tick() } #else { #if #os == .linux { oslinux.tick() } #else { u64.from(cnmalloc_has_no_os_layer_for_this_platform()) } }
}
pub fn lock(l: usize) inline {
  #if #os == .windows { oswin.lock(l); } #else { #if #os == .linux { oslinux.lock(l); } #else { cnmalloc_has_no_os_layer_for_this_platform(); } }
}
pub fn tryLock(l: usize) bool inline {
  #if #os == .windows { oswin.tryLock(l) } #else { #if #os == .linux { oslinux.tryLock(l) } #else { cnmalloc_has_no_os_layer_for_this_platform() != 0usize } }
}
pub fn unlock(l: usize) inline {
  #if #os == .windows { oswin.unlock(l); } #else { #if #os == .linux { oslinux.unlock(l); } #else { cnmalloc_has_no_os_layer_for_this_platform(); } }
}
pub fn timerCreate(cb: TimerCb, ctx: usize) usize {
  #if #os == .windows { oswin.timerCreate(cb, ctx) } #else { #if #os == .linux { oslinux.timerCreate(cb, ctx) } #else { cnmalloc_has_no_os_layer_for_this_platform() } }
}
pub fn timerArm(timer: usize, ms: u64) {
  #if #os == .windows { oswin.timerArm(timer, ms); } #else { #if #os == .linux { oslinux.timerArm(timer, ms); } #else { cnmalloc_has_no_os_layer_for_this_platform(); } }
}
pub fn timerClose(timer: usize) {
  #if #os == .windows { oswin.timerClose(timer); } #else { #if #os == .linux { oslinux.timerClose(timer); } #else { cnmalloc_has_no_os_layer_for_this_platform(); } }
}
pub fn writeErr(buf: usize, n: usize) {
  #if #os == .windows { oswin.writeErr(buf, n); } #else { #if #os == .linux { oslinux.writeErr(buf, n); } #else { cnmalloc_has_no_os_layer_for_this_platform(); } }
}
pub fn fatal() {
  #if #os == .windows { oswin.fatal(); } #else { #if #os == .linux { oslinux.fatal(); } #else { cnmalloc_has_no_os_layer_for_this_platform(); } }
}
pub fn getEnv(name: cstr, buf: usize, size: usize) usize {
  #if #os == .windows { oswin.getEnv(name, buf, size) } #else { #if #os == .linux { oslinux.getEnv(name, buf, size) } #else { cnmalloc_has_no_os_layer_for_this_platform() } }
}
pub fn processors() usize {
  #if #os == .windows { oswin.processors() } #else { #if #os == .linux { oslinux.processors() } #else { cnmalloc_has_no_os_layer_for_this_platform() } }
}
pub fn foreignFree() usize {
  #if #os == .windows { oswin.foreignFree() } #else { #if #os == .linux { oslinux.foreignFree() } #else { cnmalloc_has_no_os_layer_for_this_platform() } }
}
