  #if #os == .windows { oswin.foreignAFree() } #else { #if #os == .linux { oslinux.foreignAFree() } #else { cnmalloc_has_no_os_layer_for_this_platform() } }
}
pub fn foreignARealloc() usize {
  #if #os == .windows { oswin.foreignARealloc() } #else { #if #os == .linux { oslinux.foreignARealloc() } #else { cnmalloc_has_no_os_layer_for_this_platform() } }
}
pub fn foreignAMsize() usize {
  #if #os == .windows { oswin.foreignAMsize() } #else { #if #os == .linux { oslinux.foreignAMsize() } #else { cnmalloc_has_no_os_layer_for_this_platform() } }
}
