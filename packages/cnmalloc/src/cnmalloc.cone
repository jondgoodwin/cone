// cnmalloc: one shared heap for a process, standard C allocation API only (malloc, calloc, realloc, free,
// _msize, _expand, _recalloc and the _aligned_ family, which shim/cn_shim.c exports over the functions here).
// It is off by default: nothing links it unless a program asks (shim/README.md, "Linking it").
//
// The heap has no per-thread state. Everything a thread touches is under a lock or is read-only. (Row 426's
// optional workers' cache is the one per-thread thing, and it is in shim/cn_shim.c, outside the heap: a cached
// cell stays counted as used here, see "The workers' cache" below.)
//
// THE FOUR PARTS
//   OS layer     os.cone is the interface (reserve, commit, decommit, release), oswin.cone the Windows
//                implementation (VirtualAlloc, VirtualFree) and oslinux.cone the Linux one (mmap, mprotect, madvise,
//                munmap; row 550). osplat.cone picks the one the build targets, and is the only name this file uses.
//                The layer is the only code that asks the system for memory, time, a lock, a timer or the settings.
//   Reservation  "reserve with room, commit as it grows": a large block's own OS reservation, with address space
//                to grow in place (largeAlloc, largeResize below). INTERFACE: largeAlloc(n, align) -> block,
//                largeResize(p, n) -> grows or shrinks in place when it can, largeFree(p). The second API set
//                hands this to pools as a capacity that grows (Jon's declared-capacity idea).
//   Page pool    64 KiB pages carved from one reservation; INTERFACE: poolTake(need) -> a page whose first 'need'
//                bytes are committed (lowest address first, committed-empty before decommitted before fresh
//                address), poolPut(page) -> an empty page comes back (it may be decommitted at once or later),
//                giveRun / cnm_collect -> the give-back. The second API set hands runs of pages to pools as slabs;
//                this version's interface is one page at a time, which is what the size classes use.
//   Size classes the first client of both: one lock per class, cells cut from pages, no header anywhere.
//
// LARGE BLOCKS AND THEIR COMMIT (row 547)
//   A freed large block (above 32 KiB) stays committed in the cache, under largecap and the give-back delay. When a
//   request takes it, the block keeps at most (request rounded up to 4 KiB) + largeSlack committed bytes while it
//   lives; the rest is decommitted. THE BOUND: a live large block never holds more than request + largeSlack
//   committed (default 256 KiB, CNMALLOC=largeslack=<bytes>; 0 keeps only the request). Beyond the bound nothing
//   changes: the cached bytes stay under largecap and the delay. The slack exists because the block usually grows
//   again at once (a List's realloc), and a tail decommitted and committed again faults every page twice.
//   Why 256 KiB: it is the smallest slack that keeps the whole saving (havlak's faults and decommits match no trim at
//   all), so the saving doesn't hang on one program's sizes. 128 KiB keeps 99.7% but sits on the knee (havlak still
//   decommits and regrows about 1,070 times). The cost over 128 KiB is about 2 MiB on a workload built to stress the
//   bound (16 freed 3 MiB blocks, then 2,000 live 40-200 KiB blocks: +4.1 MiB, +1.7% over trimming to the request).
//
// LOCK ORDER (the whole of it)
//   a class lock, THEN the pool lock, then (inside giveRun) nothing; never the reverse. The large table's lock
//   is taken alone (it never holds a class or pool lock, and takes none while held). The timer's lock is taken
//   alone and never while any other cnmalloc lock is held. Operating-system calls (commit, decommit) may happen
//   while a class lock and the pool lock are held in this version; they are counted (the pool's commitCalls and
//   decommitCalls, the large table's sysCalls).
//
// THE CONCURRENCY RULE
//   Everything about a page that holds cells of class c (its descriptor, its cells' free list, its bit in c's
//   bitmap) is read and written only under c's lock. The one exception is free()'s read of the descriptor's
//   class (see freeSmall). A page's class is changed only by the pool, under the pool lock, while the page is
//   empty and in no class's hands. No atomics, no lock-free path. (That is the lock design, the default. The second
//   design, CNMALLOC=design=lockfree (row 454), keeps the lock for everything but a page's cells, which are bits in a
//   second descriptor taken and given by one atomic operation each: "THE SECOND DESIGN" below has its rules.)
//
// ADDRESS SPACE
//   One reservation (size a setting, default 64 GiB) holds every small-block page. (p - base) < size is the
//   ownership test. A page is (p - base) >> 16. Descriptors (64 bytes each) are in a second reservation, one per
//   page, committed 4 KiB at a time as pages come into use; nothing is in a page but cells. The classes' and
//   the pool's bitmaps (three levels, so the lowest page with a free cell is three find-first-set operations)
//   are in a third reservation, committed in 4 KiB chunks as bits are first set.
//
// This package is C-named ('mod @c'): no prelude, no core, no globals, no runtime of Cone's. Each function takes
// the heap, an address made by cnm_create; shim/cn_shim.c holds the one global that points at the process's heap
// and the start-up, and the names malloc and free. A heap is also a plain value to a test: it can make several.
mod @c cnmalloc;

// Row 454: the second design's slow paths use the atomic operations (core's intrinsics, which compile to the machine's
// atomic instructions and call nothing). A C-named module has no prelude: core is imported for these two names alone.
import core use mem, MemOrder;

// ---------------------------------------------------------------------------
// Constants and layout
// ---------------------------------------------------------------------------

const pageShift = 16usize;
const pageSize = 65536usize;
const nClasses = 72usize;
const nTrees = 74usize;             // one per class, then the pool's empty-committed and decommitted sets
const treeEmpty = 72usize;
const treeDecommitted = 73usize;
const none = 0xFFFFFFFFFFFFFFFFusize;
const maxSmall = 32768usize;
const allOnes = 0xFFFFFFFFFFFFFFFFu64;

// where each part sits in the heap's own region (all of it committed at once, never freed)
const poolOff = 1024usize;
const largeOff = 2048usize;
const timerOff = 2560usize;
const cacheOff = 3072usize;         // 16 freed large reservations, 48 bytes each
const cacheSlots = 16usize;
const sizeMapOff = 3840usize;       // 65 bytes
const classOff = 4096usize;         // 72 classes, 128 bytes each
const classStride = 128usize;
const scratchOff = 13312usize;      // 3072 bytes: settings text, a line of statistics
const flagsOff = 16384usize;        // one byte per 4 KiB chunk of each tree
const regionBytes = 81920usize;

// the second design (row 454): a page descriptor's layout and the states of a page (see "THE SECOND DESIGN" below)
const d2Stride = 576usize;          // per page: 64 bytes of header, then 64 words of bits
const lfClsStride = 1024usize;       // per class: slots, flags, counters (see lfc)
const lfHeadBytes = 4096usize;
const lfMaxSlots = 32usize;
const lfAttached = 1u64;
const lfListed = 2u64;
const lfUnlisted = 3u64;
const lfRetired = 0u64;
const lfRetireBatch = 16usize;      // listed pages that collect tries to retire, per class per call

// page states
const stUnused = 0u32;
const stActive = 1u32;
const stEmpty = 2u32;
const stDecommitted = 3u32;

// give-back modes
const modeNow = 0usize;
const modeDelay = 1usize;
const modeNever = 2usize;

pub struct Desc {
  cls: u32;
  state: u32;
  used: u32;
  bump: u32;          // offset in the page of the next never-used cell
  dirty: u32;         // high-water mark: nothing at or above it has been written since the last commit
  limit: u32;         // end of the cell area (cells never straddle it)
  commit: u32;        // bytes of the page committed from its start
  pad: u32;
  freeHead: usize;    // LIFO list of freed cells, linked through their first word; 0 for none
  since: u64;         // when the page became empty (ms)
  p1: u64;
  p2: u64;
}

pub struct Class {
  lock: usize;        // an SRWLOCK: first field, so the class's address is the lock's
  cur: usize;         // the lowest page with a free cell, or none
  spare: usize;       // one empty page kept, or none
  idx: usize;
  size: usize;        // cell size
  limit: usize;       // bytes of cells in a page: (65536 / size) * size
  commit: usize;      // limit rounded up to 4 KiB: what a page of this class commits
  allocs: u64;
  frees: u64;
  live: u64;
  pages: u64;
  waits: u64;         // lock takes whose first try failed
  retired: u64;
  spareHits: u64;
}

pub struct Heap {
  region: usize;
  base: usize;
  size: usize;
  npages: usize;
  descBase: usize;
  metaBase: usize;
  flags: usize;
  treeStride: usize;
  firstBytes: usize;
  firstChunks: usize;
  chunksPerTree: usize;
  l0w: usize;
  l1w: usize;
  l2w: usize;
  mode: usize;
  delayMs: u64;
  largeCap: usize;
  largeSlack: usize;       // row 547: bytes a reused large block may keep committed beyond its request (multiple of 4 KiB)
  largeReserve: usize;     // row 446: a large block reserves this many times its size ...
  largeReserveCap: usize;  // ... and at most this many bytes more than its size
  stats: usize;
  ucfree: usize;
  ucrealloc: usize;
  ucmsize: usize;
  ucafree: usize;
  ucarealloc: usize;
  ucamsize: usize;
  foreign: u64;       // foreign frees and reallocs forwarded (counted under the pool lock)
  descReserve: usize;
  metaReserve: usize;
  cacheCap: usize;    // row 426: blocks per size class a worker may cache; 0 turns the cache off
  cacheMax: usize;    // row 426: only requests up to this many bytes are cached
  cBytes: u64;        // row 426: the C shim's per-worker caches, published to the counters (cnm_set_cache_stats)
  cHits: u64;
  cMisses: u64;
  cReturns: u64;
  cFills: u64;
  design: usize;      // row 454: 1 the lock design (the default), 2 the second design (lock-free shared pages)
  lf: usize;          // design 2: the area holding its header and per-class records (0 under design 1)
  d2Base: usize;      // design 2: the page descriptors, 576 bytes each
  d2Reserve: usize;
  d2Done: usize;      // bytes of them committed
  slotCap: usize;     // design 2: the most slots a class may hold
  collLimit: usize;   // design 2: collisions since the last change that add a slot
  lfAlloc: usize;     // design 2: the shim's allocate and free of a small cell, for the calls that come through Cone
  lfFree: usize;
  hookDetach: usize;  // design 2, tests: called between a detach's state exchange and its scan
  hookRetire: usize;  // design 2, tests: called between a retire's claims and its generation raise
  hookClaim: usize;   // design 2, tests: called after a page was found wholly free and before the retire claims its words
  hookAfter: usize;   // design 2, tests: called in "after a free", under the class lock, after the state load and before the scan
  lfDebug: usize;     // design 2: non-zero in the shim's debug build; the slot rule is then asserted (cnm_lf_attach)
  lfK: usize;         // design 2 (row 603): CNMALLOC=relist=<k>, a page is listed again when a word holds min(k, valid bits / q) free cells
  lfQ: usize;         // design 2 (row 603): CNMALLOC=relistq=<q>
  nonWorker: u64;     // design 2: small allocations made by threads that are not workers (statistics run)
  callocs: u64;
  callocBytes: u64;
  hookTimer: usize;   // tests: called in armTimer between the timer lock's release and the timer's creation (row 550)
}

pub struct Pool {
  lock: usize;
  fresh: usize;       // pages below this have been handed out at least once
  descDone: usize;    // bytes of descriptors committed
  nEmpty: u64;
  nDecommitted: u64;
  committedBytes: u64;
  reused: u64;
  commitCalls: u64;
  decommitCalls: u64;
  taken: u64;
}

pub struct LEntry {
  addr: usize;        // the block
  base: usize;        // where its reservation starts (before addr when over-aligned)
  reserved: usize;    // bytes reserved from base
  committed: usize;   // bytes committed from addr
  size: usize;        // the size the caller asked for
  stamp: u64;
}

pub struct Large {
  lock: usize;
  table: usize;       // open addressing, keyed by address, 48-byte entries
  cap: usize;         // entries, a power of two
  bits: usize;
  count: usize;
  tableBytes: usize;
  cachedBytes: usize;
  live: u64;
  bytes: u64;
  grows: u64;
  moves: u64;
  cacheHits: u64;
  sysCalls: u64;
  copied: u64;        // row 446: bytes copied by moves
  nReserve: u64;      // row 446: sysCalls split by kind
  nCommit: u64;
  nDecommit: u64;
  nRelease: u64;
}

pub struct Timer {
  lock: usize;
  armed: usize;
  handle: usize;
  fired: u64;
}

extern {
  fn memset(p: *u8, v: i32, n: usize) *u8;
  fn memcpy(d: *u8, s: *u8, n: usize) *u8;
  fn @c("strncpy") copyLit(d: *u8, s: cstr, n: usize) *u8;
  fn strncmp(a: *u8, b: cstr, n: usize) i32;
}

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

fn at(h: usize, off: usize) usize { h + off }
fn poolOf(h: *Heap) *Pool { ((h as usize) + poolOff) as *Pool }
fn largeOf(h: *Heap) *Large { ((h as usize) + largeOff) as *Large }
fn timerOf(h: *Heap) *Timer { ((h as usize) + timerOff) as *Timer }
fn classAt(h: *Heap, c: usize) *Class { ((h as usize) + classOff + c * classStride) as *Class }
fn descOf(h: *Heap, page: usize) *Desc { (h.descBase + page * 64usize) as *Desc }
fn pageAddr(h: *Heap, page: usize) usize { h.base + (page << pageShift) }
fn cacheAt(h: *Heap, i: usize) *LEntry { ((h as usize) + cacheOff + i * 48usize) as *LEntry }
fn roundUp(x: usize, a: usize) usize { (x + a - 1usize) & ~(a - 1usize) }
fn lowMask(b: usize) u64 { if b >= 63usize { allOnes } else { (1u64 << u64.from(b + 1usize)) - 1u64 } }
fn hiBit(v: u64) usize { 63usize - usize.from(v.leadingZeros()) }
fn loBit(v: u64) usize { usize.from(v.trailingZeros()) }
fn rd(a: usize) u64 { *(a as *u64) }
fn wr(a: usize, v: u64) { *(a as *u64) = v; }
fn rd32(a: usize) u32 { *(a as *u32) }
fn wr32(a: usize, v: u32) { *(a as *u32) = v; }
fn rd8(a: usize) u8 { *(a as *u8) }
fn wr8(a: usize, v: u8) { *(a as *u8) = v; }

// ---------------------------------------------------------------------------
// Size classes: 16-byte steps to 128, then 8 classes per doubling to 32 KiB (72 in all)
// ---------------------------------------------------------------------------

fn classSizeOf(c: usize) usize {
  if c < 8usize {
    (c + 1usize) * 16usize
  } else {
    let k = (c - 8usize) >> 3usize;
    let j = (c - 8usize) & 7usize;
    (16usize << k) * (9usize + j)
  }
}

// the class of a size over 128, up to 32 KiB, by a leading-zero count
fn classOfBig(n: usize) usize {
  let t = n - 1usize;
  let msb = 63usize - usize.from(t.leadingZeros());
  8usize + (msb - 7usize) * 8usize + ((t >> (msb - 3usize)) & 7usize)
}

// the class that holds a request of n bytes, n up to 32 KiB (0 gets the smallest)
fn classOf(h: *Heap, n: usize) usize {
  if n <= 1024usize {
    return usize.from(*(((h as usize) + sizeMapOff + ((n + 15usize) >> 4usize)) as *u8));
  }
  classOfBig(n)
}

// ---------------------------------------------------------------------------
// The bitmaps: three levels. Level 0 has a bit per page, level 1 a bit per level-0 word that is not zero,
// level 2 a bit per level-1 word that is not zero. A tree is a page of its class's, or one of the pool's sets.
// Every use is under the lock of what the tree belongs to.
// ---------------------------------------------------------------------------

fn treeAddr(h: *Heap, ti: usize) usize { h.metaBase + ti * h.treeStride }
fn flagPtr(h: *Heap, ti: usize, k: usize) *u8 { (h.flags + ti * h.chunksPerTree + k) as *u8 }

fn ensureFirst(h: *Heap, ti: usize) {
  let f = flagPtr(h, ti, 0usize);
  if *f == 0u8 {
    if !osplat.commit(treeAddr(h, ti), h.firstBytes) { osplat.fatal(); }
    *f = 1u8;
  }
}

fn btSet(h: *Heap, ti: usize, i: usize) {
  ensureFirst(h, ti);
  let t = treeAddr(h, ti);
  let w0 = i >> 6usize;
  let k = w0 >> 9usize;
  let f = flagPtr(h, ti, h.firstChunks + k);
  if *f == 0u8 {
    if !osplat.commit(t + h.firstBytes + k * 4096usize, 4096usize) { osplat.fatal(); }
    *f = 1u8;
  }
  let a0 = t + h.firstBytes + w0 * 8usize;
  wr(a0, rd(a0) | (1u64 << u64.from(i & 63usize)));
  let w1 = w0 >> 6usize;
  let a1 = t + h.l2w * 8usize + w1 * 8usize;
  wr(a1, rd(a1) | (1u64 << u64.from(w0 & 63usize)));
  let a2 = t + (w1 >> 6usize) * 8usize;
  wr(a2, rd(a2) | (1u64 << u64.from(w1 & 63usize)));
}

// the level-0 word, zero when its chunk was never committed
fn l0word(h: *Heap, ti: usize, w0: usize) u64 {
  if *flagPtr(h, ti, h.firstChunks + (w0 >> 9usize)) == 0u8 { return 0u64; }
  rd(treeAddr(h, ti) + h.firstBytes + w0 * 8usize)
}

fn btClear(h: *Heap, ti: usize, i: usize) {
  if *flagPtr(h, ti, 0usize) == 0u8 { return; }
  let t = treeAddr(h, ti);
  let w0 = i >> 6usize;
  if *flagPtr(h, ti, h.firstChunks + (w0 >> 9usize)) == 0u8 { return; }
  let a0 = t + h.firstBytes + w0 * 8usize;
  let v0 = rd(a0) & ~(1u64 << u64.from(i & 63usize));
  wr(a0, v0);
  if v0 == 0u64 {
    let w1 = w0 >> 6usize;
    let a1 = t + h.l2w * 8usize + w1 * 8usize;
    let v1 = rd(a1) & ~(1u64 << u64.from(w0 & 63usize));
    wr(a1, v1);
    if v1 == 0u64 {
      let a2 = t + (w1 >> 6usize) * 8usize;
      wr(a2, rd(a2) & ~(1u64 << u64.from(w1 & 63usize)));
    }
  }
}

fn btTest(h: *Heap, ti: usize, i: usize) bool {
  if *flagPtr(h, ti, 0usize) == 0u8 { return false; }
  (l0word(h, ti, i >> 6usize) & (1u64 << u64.from(i & 63usize))) != 0u64
}

// the lowest set bit, or none: three find-first-set steps
fn btFirst(h: *Heap, ti: usize) usize {
  if *flagPtr(h, ti, 0usize) == 0u8 { return none; }
  let t = treeAddr(h, ti);
  var j = 0usize;
  while j < h.l2w {
    let v2 = rd(t + j * 8usize);
    if v2 != 0u64 {
      let w1 = j * 64usize + loBit(v2);
      let v1 = rd(t + h.l2w * 8usize + w1 * 8usize);
      let w0 = w1 * 64usize + loBit(v1);
      let v0 = rd(t + h.firstBytes + w0 * 8usize);
      return w0 * 64usize + loBit(v0);
    }
    j = j + 1usize;
  }
  none
}

// the highest set bit below i, or none
fn btLastBelow(h: *Heap, ti: usize, i: usize) usize {
  if i == 0usize { return none; }
  if *flagPtr(h, ti, 0usize) == 0u8 { return none; }
  let t = treeAddr(h, ti);
  let j0 = i - 1usize;
  let w0 = j0 >> 6usize;
  let v0 = l0word(h, ti, w0) & lowMask(j0 & 63usize);
  if v0 != 0u64 { return w0 * 64usize + hiBit(v0); }
  if w0 == 0usize { return none; }
  let j1 = w0 - 1usize;
  let w1 = j1 >> 6usize;
  let v1 = rd(t + h.l2w * 8usize + w1 * 8usize) & lowMask(j1 & 63usize);
  if v1 != 0u64 {
    let x0 = w1 * 64usize + hiBit(v1);
    return x0 * 64usize + hiBit(l0word(h, ti, x0));
  }
  if w1 == 0usize { return none; }
  let j2 = w1 - 1usize;
  var w2 = j2 >> 6usize;
  var v2 = rd(t + w2 * 8usize) & lowMask(j2 & 63usize);
  while true {
    if v2 != 0u64 {
      let x1 = w2 * 64usize + hiBit(v2);
      let x0 = x1 * 64usize + hiBit(rd(t + h.l2w * 8usize + x1 * 8usize));
      return x0 * 64usize + hiBit(l0word(h, ti, x0));
    }
    if w2 == 0usize { return none; }
    w2 = w2 - 1usize;
    v2 = rd(t + w2 * 8usize);
  }
  none
}

// ---------------------------------------------------------------------------
// Settings and statistics helpers
// ---------------------------------------------------------------------------

fn bumpForeign(h: *Heap) {
  let p = poolOf(h);
  osplat.lock(p as usize);
  h.foreign = h.foreign + 1u64;
  osplat.unlock(p as usize);
}

fn fatalNow() { osplat.fatal(); }

// ---------------------------------------------------------------------------
// The page pool. Its lock is taken under a class's lock, never the other way round. Pages are in one of
// four conditions: fresh address (>= fresh), empty and committed (tree 72), decommitted (tree 73), or in a
// class's hands (active, or that class's spare).
// ---------------------------------------------------------------------------

fn ensureDesc(h: *Heap, p: *Pool, page: usize) {
  while p.descDone < (page + 1usize) * 64usize {
    if !osplat.commit(h.descBase + p.descDone, 4096usize) { osplat.fatal(); }
    p.descDone = p.descDone + 4096usize;
  }
  // design 2: the page's second descriptor (header and bits), committed for good (Rule D) as the page first comes into use
  if h.design == 2usize {
    while h.d2Done < (page + 1usize) * d2Stride {
      if !osplat.commit(h.d2Base + h.d2Done, 4096usize) { osplat.fatal(); }
      h.d2Done = h.d2Done + 4096usize;
    }
  }
}

fn pageDue(d: *Desc, now: u64, delay: u64) bool { now - d.since >= delay }

// Decommits pages lo .. lo+count-1, all empty and committed (in tree 72), in ONE system call. Pool lock held.
fn decommitRun(h: *Heap, p: *Pool, lo: usize, count: usize) {
  osplat.decommit(pageAddr(h, lo), count << pageShift);
  p.decommitCalls = p.decommitCalls + 1u64;
  var i = lo;
  while i < lo + count {
    let d = descOf(h, i);
    p.committedBytes = p.committedBytes - u64.from(d.commit);
    d.state = stDecommitted;
    d.commit = 0u32;
    d.dirty = 0u32;
    btClear(h, treeEmpty, i);
    btSet(h, treeDecommitted, i);
    i = i + 1usize;
  }
  p.nEmpty = p.nEmpty - u64.from(count);
  p.nDecommitted = p.nDecommitted + u64.from(count);
}

// Decommits one contiguous run of empty pages, highest address first, that have been empty at least 'delay'
// ms. At most maxPages pages and a scan of at most maxScan empty pages. Pool lock held. Returns the pages done.
fn giveRun(h: *Heap, p: *Pool, now: u64, delay: u64, maxPages: usize, maxScan: usize) usize {
  var q = btLastBelow(h, treeEmpty, h.npages);
  var scanned = 0usize;
  while q != none {
    if pageDue(descOf(h, q), now, delay) { break; }
    scanned = scanned + 1usize;
    if scanned >= maxScan { return 0usize; }
    q = btLastBelow(h, treeEmpty, q);
  }
  if q == none { return 0usize; }
  var lo = q;
  var count = 1usize;
  while lo > 0usize && count < maxPages && btTest(h, treeEmpty, lo - 1usize) && pageDue(descOf(h, lo - 1usize), now, delay) {
    lo = lo - 1usize;
    count = count + 1usize;
  }
  decommitRun(h, p, lo, count);
  count
}

// a page for a class: the lowest committed-empty one, else the lowest decommitted one, else fresh address.
// The first 'need' bytes of it are committed. Called under a class lock; takes the pool lock.
fn poolTake(h: *Heap, need: usize) usize {
  let p = poolOf(h);
  osplat.lock(p as usize);
  var page = btFirst(h, treeEmpty);
  if page != none {
    btClear(h, treeEmpty, page);
    p.nEmpty = p.nEmpty - 1u64;
    p.reused = p.reused + 1u64;
  } else {
    page = btFirst(h, treeDecommitted);
    if page != none {
      btClear(h, treeDecommitted, page);
      p.nDecommitted = p.nDecommitted - 1u64;
    } else if p.fresh < h.npages {
      page = p.fresh;
      p.fresh = p.fresh + 1usize;
      ensureDesc(h, p, page);
    }
  }
  if page != none {
    let d = descOf(h, page);
    let have = usize.from(d.commit);
    if have < need {
      if !osplat.commit(pageAddr(h, page) + have, need - have) {
        // out of memory: the page goes back as it was
        if have == 0usize { d.state = stDecommitted; btSet(h, treeDecommitted, page); p.nDecommitted = p.nDecommitted + 1u64; }
        else { btSet(h, treeEmpty, page); p.nEmpty = p.nEmpty + 1u64; }
        osplat.unlock(p as usize);
        return none;
      }
      p.commitCalls = p.commitCalls + 1u64;
      p.committedBytes = p.committedBytes + u64.from(need - have);
      d.commit = u32.from(need);
    }
    p.taken = p.taken + 1u64;
  }
  if h.mode == modeDelay {
    // a bounded amount of give-back: at most 16 pages, one run
    giveRun(h, p, osplat.tick(), h.delayMs, 16usize, 64usize);
  }
  osplat.unlock(p as usize);
  page
}

// an empty page comes back. Called under a class lock; takes the pool lock. With give-back 'now' it is
// decommitted at once.
fn poolPut(h: *Heap, page: usize, now: u64) {
  let p = poolOf(h);
  osplat.lock(p as usize);
  let d = descOf(h, page);
  d.state = stEmpty;
  d.cls = 0xFFFFFFFFu32;
  d.since = now;
  btSet(h, treeEmpty, page);
  p.nEmpty = p.nEmpty + 1u64;
  if h.mode == modeNow {
    decommitRun(h, p, page, 1usize);
  } else if h.mode == modeDelay {
    giveRun(h, p, now, h.delayMs, 16usize, 64usize);
  }
  osplat.unlock(p as usize);
}

// ---------------------------------------------------------------------------
// The timer: gives back when the process goes quiet. One OS thread-pool timer, created once, armed only while
// something waits. Its lock is leaf: nothing else of ours is held when it is taken.
// ---------------------------------------------------------------------------

fn timerFired(inst: usize, ctx: usize, timer: usize) {
  let h = ctx as *Heap;
  let t = timerOf(h);
  osplat.lock(t as usize);
  t.armed = 0usize;
  t.fired = t.fired + 1u64;
  osplat.unlock(t as usize);
  let ms = cnm_collect(ctx, false);
  if ms > 0u64 { armTimer(h, ms); }
}

// The handle while a thread is making the timer (never a real handle). Row 550: making the timer may allocate (on
// Linux it is a thread made by pthread_create, whose start calls the C library's calloc, which is this heap, and that
// allocation can come back here through armIfWaiting). So the timer is made with its lock NOT held, behind this
// sentinel: an arm that finds it returns, because the thread that is making the timer arms it right after.
const timerCreating = 1usize;

fn armTimer(h: *Heap, ms: u64) {
  let t = timerOf(h);
  osplat.lock(t as usize);
  if t.armed != 0usize || t.handle == timerCreating { osplat.unlock(t as usize); return; }
  if t.handle == 0usize {
    t.handle = timerCreating;
    osplat.unlock(t as usize);
    hookCall(h.hookTimer, 0usize);                   // tests only: an allocation inside the creation, reaching armTimer again
    let created = osplat.timerCreate(&timerFired, h as usize);
    osplat.lock(t as usize);
    t.handle = created;                              // 0 when it could not be made: a later arm tries again
  }
  if t.handle != 0usize && t.armed == 0usize {
    t.armed = 1usize;
    osplat.timerArm(t.handle, ms);
  }
  osplat.unlock(t as usize);
}

// called with no cnmalloc lock held, after something was left waiting
fn armIfWaiting(h: *Heap) {
  if timerOf(h).armed != 0usize { return; }
  if h.mode == modeDelay { armTimer(h, h.delayMs); }
  else if h.mode == modeNow { armTimer(h, 1u64); }   // 1 ms: the shortest the thread-pool timer takes
}

// ---------------------------------------------------------------------------
// Classes: allocate and free
// ---------------------------------------------------------------------------

// retire a class's spare to the pool when it has been empty past the delay. Class lock held.
fn checkSpare(h: *Heap, c: *Class) {
  if h.mode == modeDelay {
    let now = osplat.tick();
    let d = descOf(h, c.spare);
    if now - d.since >= h.delayMs {
      let page = c.spare;
      c.spare = none;
      poolPut(h, page, now);
    }
  }
}

fn lockClass(h: *Heap, c: *Class) {
  if !osplat.tryLock(c as usize) {
    osplat.lock(c as usize);
    c.waits = c.waits + 1u64;
  }
  if c.spare != none { checkSpare(h, c); }
}

// An empty page gives its class a spare (when none is kept; at 'now' too, which hands it back at the next collect:
// a worker's park or the timer, never here), else goes to the pool.
// Class lock held; the page has no live cell and no bit in the class's tree.
fn retirePage(h: *Heap, c: *Class, page: usize, d: *Desc) {
  d.freeHead = 0usize;          // the free list is dropped: the next class may have another cell size
  d.bump = 0u32;                // ... and the bump starts again. The dirty mark stays.
  if c.cur == page { c.cur = none; }
  c.pages = c.pages - 1u64;
  c.retired = c.retired + 1u64;
  let now = osplat.tick();
  if c.spare == none {
    c.spare = page; d.state = stEmpty; d.since = now;
    return;
  }
  if page < c.spare {
    // keep the lower page, so the top empties
    let old = c.spare;
    c.spare = page; d.state = stEmpty; d.since = now;
    poolPut(h, old, descOf(h, old).since);
    return;
  }
  poolPut(h, page, now);
}

// A cell of class cl. Returns its address, or 0. *fresh is 1 when the cell is memory still zero from its commit.
fn smallAlloc(h: *Heap, cl: usize, fresh: *u32) usize {
  if h.design == 2usize {
    // the second design's cell comes from the shim's lock-free path, and is dirty: the caller fills what it needs
    *fresh = 0u32;
    let f = h.lfAlloc as &fn @c (cl: usize) usize;
    return f(cl);
  }
  let c = classAt(h, cl);
  lockClass(h, c);
  let a = takeCell(h, c, cl, fresh);
  osplat.unlock(c as usize);
  a
}

// The body of smallAlloc, with c's lock held and left held (the caller unlocks); the batch allocate (row 426)
// calls it once per cell under one take of the lock.
fn takeCell(h: *Heap, c: *Class, cl: usize, fresh: *u32) usize {
  if c.cur == none {
    var q = btFirst(h, cl);
    if q == none {
      if c.spare != none {
        q = c.spare;
        c.spare = none;
        c.spareHits = c.spareHits + 1u64;
        descOf(h, q).state = stActive;
        c.pages = c.pages + 1u64;
        btSet(h, cl, q);
      } else {
        q = poolTake(h, c.commit);
        if q == none { return 0usize; }
        let nd = descOf(h, q);
        nd.cls = u32.from(cl);          // written before any cell of the page is handed out (see freeSmall)
        nd.state = stActive;
        nd.used = 0u32;
        nd.freeHead = 0usize;
        nd.bump = 0u32;
        nd.limit = u32.from(c.limit);
        c.pages = c.pages + 1u64;
        btSet(h, cl, q);
      }
    }
    c.cur = q;
  }
  let page = c.cur;
  let d = descOf(h, page);
  var a = 0usize;
  if d.freeHead != 0usize {
    a = d.freeHead;
    d.freeHead = usize.from(rd(a));
    *fresh = 0u32;
  } else {
    let off = usize.from(d.bump);
    a = pageAddr(h, page) + off;
    d.bump = u32.from(off + c.size);
    if usize.from(d.dirty) <= off { *fresh = 1u32; } else { *fresh = 0u32; }
    if off + c.size > usize.from(d.dirty) { d.dirty = u32.from(off + c.size); }
  }
  d.used = d.used + 1u32;
  c.allocs = c.allocs + 1u64;
  c.live = c.live + 1u64;
  if d.freeHead == 0usize && usize.from(d.bump) + c.size > usize.from(d.limit) {
    btClear(h, cl, page);
    c.cur = none;
  }
  a
}

fn freeSmall(h: *Heap, a: usize) {
  if h.design == 2usize {
    let f = h.lfFree as &fn @c (p: usize);
    f(a);
    return;
  }
  let page = (a - h.base) >> pageShift;
  let d = descOf(h, page);
  // Reading the class WITHOUT the lock is safe because a is live: its page is active, and the page's class is
  // written only before the first cell of the page is handed out (smallAlloc, under the class's lock, then
  // published to whoever got the cell through whatever handed the pointer over: a lock, a queue, a thread
  // start) and never rewritten while any cell of the page is live or cached. A page's class changes only
  // when its used count has fallen to 0 and the page has gone to the pool and come back. So the value read
  // here is the class the page had when a was allocated, and it stays so until this very free is done.
  let cl = usize.from(d.cls);
  let c = classAt(h, cl);
  lockClass(h, c);
  let waiting = putCell(h, c, cl, page, d, a);
  osplat.unlock(c as usize);
  if waiting { armIfWaiting(h); }
}

// The body of freeSmall, with c's lock held and left held: push a onto its page's free list, and retire the page
// if that was its last live cell. Returns whether a page was retired (the caller arms the timer, after unlocking).
// The batch free (row 426) calls it once per cell under one take of the lock.
fn putCell(h: *Heap, c: *Class, cl: usize, page: usize, d: *Desc, a: usize) bool {
  let full = d.freeHead == 0usize && usize.from(d.bump) + c.size > usize.from(d.limit);
  wr(a, u64.from(d.freeHead));
  d.freeHead = a;
  d.used = d.used - 1u32;
  c.frees = c.frees + 1u64;
  c.live = c.live - 1u64;
  var waiting = false;
  if d.used == 0u32 {
    // Retiring is safe because it happens under c's lock: no thread can be allocating from this page,
    // since allocation needs the same lock, and no cell of it is live.
    if !full { btClear(h, cl, page); }
    retirePage(h, c, page, d);
    waiting = true;
  } else if full {
    btSet(h, cl, page);
    if c.cur != none && page < c.cur { c.cur = page; }
  } else if c.cur != none && page < c.cur {
    c.cur = page;
  }
  waiting
}

// ---------------------------------------------------------------------------
// THE SECOND DESIGN (row 454; WI\cnmalloc-second-design-spec.md, sections 1, 2, 5, 6 and 8): lock-free shared pages.
// Off unless CNMALLOC=design=lockfree. The common paths (allocate: one compare-and-swap; free: one fetch_or) are C, in
// shim/cn_shim.c (lf_alloc, lf_free, lf_release); this is everything that is under a class lock: attaching a page to a
// slot, listing a page that has room again, retiring a wholly free page, adding and dropping slots.
//
// A page's SECOND DESCRIPTOR (d2Of; 576 bytes, in its own reservation, committed for good as the page first comes
// into use, so a stale pointer to it is always readable: Rule D) holds
//     +0   genclass  the class in the low 8 bits, a generation above; written only under the class lock
//     +8   state     ATTACHED, LISTED, UNLISTED or RETIRED; written only under the class lock
//     +16  ncells    the page's cell count in its present life (written before its bits are set)
//     +24  base      the page's address (never changes)
//     +64  bits      64 words, one bit per cell, SET MEANS FREE; every word is zero while the page is RETIRED (Rule Z)
// A class's record (lfc; 1024 bytes) holds its slots (up to 32 words at +512, each the address of an ATTACHED page's
// second descriptor or 0), the count of active slots (+64), the per-slot "used" flags (+80, 32 bytes), the idle stamps
// (+768, 32 words), the collision count (+192) and the class's counters (+256).
// THE CAP (row 580): at most 32 slots a class (lfMaxSlots); the default is min(processors, 32), and CNMALLOC=slots=<n>
// is clamped to 32 only. Nothing above 16 threads was measured, so a machine with more than 32 processors is a later
// row. THE MEMORY BOUND: a slot is added only on a collision and idles back down, so a class holds at most
// (cap - 8) x 64 KiB more than the former cap of 8 did, while that many threads collide on it.
//
// RE-LISTING AND HIDDEN CELLS (row 603; settings relist=<k>, relistq=<q>, default 8 and 4, provisional until row 602's memory numbers and Jon's answer; relist=1 is the rule of one free
// cell). A page that is neither attached nor listed is listed again when a free brings some WORD of its bits to thr free
// cells, thr = min(k, the word's valid bits / q), at least 1 (thrOf here, g_lfthrf and g_lfthrl in the shim; the same
// numbers). The free tests it with popcount(old) + 1 == thr on the word its fetch_or returned: one popcount, no new atomic;
// the wholly-free test is unchanged. lfDetach and "after a free" list a page when some word holds at least thr free cells
// (lfWorth); lfPick still accepts any free bit. Why: with one free cell as the threshold a class whose live set spans
// many pages lists a page at nearly every free and attaches one at nearly every allocation, two lock takes per operation.
// THE BOUND: the free cells a page can hide are those below the threshold in each of its words, in a page neither
// attached nor listed: at most thr - 1 per word, that is under k per 64 cells (a 102-cell page of 640 bytes, thresholds 8 and
// 8: at most 7 + 7 = 14 hidden, 14%; a 32-cell page of 2048 bytes: at most 7, 22%).
// THE OUT-OF-MEMORY SWEEP: hidden cells never cause an out-of-memory. When cnm_lf_attach finds no page (no listed
// page, no spare, none from the pool), the shim calls cnm_lf_sweep, which lists every UNLISTED page of the class that has
// a free cell, under the class lock, and the shim tries again. The sweep walks every page the pool has handed out, so it
// runs only at out of memory, never before an ordinary new page: doing it there would make a live set that grows walk
// every page at each growth step. A program that sits at its address-space limit and keeps allocating pays one walk per
// failed allocation. The model of rows 455 and 490 (extended for thresholds 1 to 3 and the sweep) covers this.
//
// WHO WRITES WHAT: the lock holder writes the slots, the states and genclass, with the atomic operations below
// (sequentially consistent: the Dekker rule of section 5 needs the exchange of a state to come before the scan of
// its bits, and a free's fetch_or to come before its read of the state). Any thread may compare-and-swap or
// fetch_or a bits word at any time. Everything else here is plain.
// ---------------------------------------------------------------------------

fn d2Of(h: *Heap, page: usize) usize { h.d2Base + page * d2Stride }
fn lfc(h: *Heap, cl: usize) usize { h.lf + lfHeadBytes + cl * lfClsStride }
fn d2Page(h: *Heap, d2: usize) usize { (usize.from(rd(d2 + 24usize)) - h.base) >> pageShift }
fn bitsAt(d2: usize, j: usize) usize { d2 + 64usize + j * 8usize }
fn nwOf(ncells: usize) usize { (ncells + 63usize) >> 6usize }
// the valid bits of word j of a page of n cells
fn maskOf(n: usize, j: usize) u64 {
  let full = n >> 6usize;
  if j < full { return allOnes; }
  if j == full && (n & 63usize) != 0usize { return (1u64 << u64.from(n & 63usize)) - 1u64; }
  0u64
}
fn lfBump(L: usize, k: usize) { wr(L + 256usize + k * 8usize, rd(L + 256usize + k * 8usize) + 1u64); }   // class lock held

// the atomic operations (all sequentially consistent)
fn aLd(a: usize) u64 { mem.atomicLoad[u64](a as *u64, MemOrder.SeqCst) }
fn aSt(a: usize, v: u64) { mem.atomicStore[u64](a as *u64, v, MemOrder.SeqCst); }
fn aXchg(a: usize, v: u64) u64 { mem.atomicSwap[u64](a as *u64, v, MemOrder.SeqCst) }
fn aOr(a: usize, v: u64) u64 { mem.atomicOr[u64](a as *u64, v, MemOrder.SeqCst) }
fn aCas(a: usize, from: u64, to: u64) bool {
  var o = 0u64;
  var ok = false;
  o, ok = mem.atomicCompareSwap[u64](a as *u64, from, to, MemOrder.SeqCst, MemOrder.SeqCst);
  ok
}

// What a page's words say: 0 no bit is set (no free cell), 1 some are, 2 every word equals its mask (wholly free)
fn lfScan(d2: usize) usize {
  let n = usize.from(rd(d2 + 16usize));
  let nw = nwOf(n);
  var any = false;
  var all = true;
  var j = 0usize;
  while j < nw {
    let v = aLd(bitsAt(d2, j));
    if v != 0u64 { any = true; }
    if v != maskOf(n, j) { all = false; }
    j = j + 1usize;
  }
  if all { 2usize } else if any { 1usize } else { 0usize }
}

// (row 603) The listing threshold of word j of a page of n cells: min(k, valid bits of the word / q), at least 1, with k and q the
// settings relist= and relistq=. The shim computes the same numbers for its edge test (lf_setup); the two must agree.
fn thrOf(h: *Heap, n: usize, j: usize) usize {
  var v = n - j * 64usize;
  if v > 64usize { v = 64usize; }
  var t = v / h.lfQ;
  if t > h.lfK { t = h.lfK; }
  if t < 1usize { t = 1usize; }
  t
}
// worth listing: some word holds at least its threshold of free cells (lfPick still accepts any free bit)
fn lfWorth(h: *Heap, d2: usize) bool {
  let n = usize.from(rd(d2 + 16usize));
  let nw = nwOf(n);
  var j = 0usize;
  while j < nw {
    let v = aLd(bitsAt(d2, j));
    if usize.from(v.countOnes()) >= thrOf(h, n, j) { return true; }
    j = j + 1usize;
  }
  false
}

fn hookCall(f: usize, cl: usize) {
  if f != 0usize {
    let g = f as &fn @c (cl: usize);
    g(cl);
  }
}

// Makes a page of class cl ready (section 5, step 4): genclass first, then each word of bits = its mask. Class lock
// held, and the page is out of the pool or is the class's spare, so nothing can act on it but a stale pointer (Rule G).
fn lfReady(h: *Heap, cl: usize, page: usize, size: usize) {
  let d2 = d2Of(h, page);
  let n = pageSize / size;
  wr(d2 + 16usize, u64.from(n));
  wr(d2 + 24usize, u64.from(pageAddr(h, page)));
  let g = rd(d2);
  aSt(d2, ((g >> 8u64) << 8u64) | u64.from(cl));
  descOf(h, page).cls = u32.from(cl);
  var j = 0usize;
  let nw = nwOf(n);
  while j < nw {
    aSt(bitsAt(d2, j), maskOf(n, j));
    j = j + 1usize;
  }
}

// Retires a page (section 6): LISTED or UNLISTED, class lock held. Claims every word by compare-and-swap from its mask
// to 0; if one fails the claimed words are put back with fetch_or and the page stays as it was. Otherwise the
// retirer holds every cell: the page leaves the tree, becomes RETIRED, its generation rises by one, and it is the
// class's spare or goes to the pool. Returns whether it retired.
fn lfRetire(h: *Heap, c: *Class, cl: usize, page: usize, d2: usize) bool {
  let L = lfc(h, cl);
  let n = usize.from(rd(d2 + 16usize));
  let nw = nwOf(n);
  hookCall(h.hookClaim, cl);
  var k = 0usize;
  while k < nw {
    if !aCas(bitsAt(d2, k), maskOf(n, k), 0u64) {
      var j = 0usize;
      while j < k {
        aOr(bitsAt(d2, j), maskOf(n, j));
        j = j + 1usize;
      }
      lfBump(L, 8usize);
      return false;
    }
    k = k + 1usize;
  }
  if aLd(d2 + 8usize) == lfListed { btClear(h, cl, page); }
  aSt(d2 + 8usize, lfRetired);
  hookCall(h.hookRetire, cl);
  let g = aLd(d2);
  aSt(d2, (((g >> 8u64) + 1u64) << 8u64) | (g & 255u64));
  lfBump(L, 7usize);
  c.pages = c.pages - 1u64;
  c.retired = c.retired + 1u64;
  let d = descOf(h, page);
  let now = osplat.tick();
  if c.spare == none {
    c.spare = page; d.state = stEmpty; d.since = now;
    return true;
  }
  if page < c.spare {
    let old = c.spare;
    c.spare = page; d.state = stEmpty; d.since = now;
    poolPut(h, old, descOf(h, old).since);
    return true;
  }
  poolPut(h, page, now);
  true
}

// Takes a page out of a slot (section 5, step 2): the state is exchanged to UNLISTED, and only then are its words
// scanned (the Dekker rule: a free that ORed its bit before the exchange is seen by the scan; one that ORs after it
// reads a state other than ATTACHED and comes to the lock). Wholly free: tries to retire. Some word at its threshold
// (lfWorth; with relist=1 any bit set): LISTED and in the tree. Otherwise it stays UNLISTED, its few free cells hidden
// until a free brings a word to its threshold or the out-of-memory sweep (cnm_lf_sweep) lists it. Class lock held; the
// slot no longer names the page. Returns whether it retired.
fn lfDetach(h: *Heap, c: *Class, cl: usize, page: usize, d2: usize) bool {
  aXchg(d2 + 8usize, lfUnlisted);
  hookCall(h.hookDetach, cl);
  let r = lfScan(d2);
  if r == 2usize {
    if lfRetire(h, c, cl, page, d2) { return true; }
  }
  if r != 0usize && lfWorth(h, d2) {
    aSt(d2 + 8usize, lfListed);
    btSet(h, cl, page);
    lfBump(lfc(h, cl), 6usize);
  }
  false
}

// The next page for a slot (section 5, step 3): the lowest page in the class's tree confirmed by a scan to have a free
// bit (a page found full is set UNLISTED by the same exchange-then-scan and skipped), else the class's spare, else a
// page from the pool. The page is ready and out of the tree; the caller attaches it. none when out of memory.
fn lfPick(h: *Heap, c: *Class, cl: usize) usize {
  var q = none;
  var found = false;
  while !found {
    let t = btFirst(h, cl);
    if t == none { break; }
    let d2 = d2Of(h, t);
    var r = lfScan(d2);
    if r == 0usize {
      aXchg(d2 + 8usize, lfUnlisted);
      r = lfScan(d2);
      if r == 0usize {
        btClear(h, cl, t);
      } else {
        aSt(d2 + 8usize, lfListed);     // a free landed between: it has a free bit after all
        found = true;
      }
    } else {
      found = true;
    }
    if found {
      btClear(h, cl, t);
      q = t;
    }
  }
  if found { return q; }
  if c.spare != none {
    q = c.spare;
    c.spare = none;
    c.spareHits = c.spareHits + 1u64;
    descOf(h, q).state = stActive;
  } else {
    q = poolTake(h, c.commit);
    if q == none { return none; }
    let nd = descOf(h, q);
    nd.state = stActive;
    nd.limit = u32.from(c.limit);
  }
  c.pages = c.pages + 1u64;
  lfReady(h, cl, q, c.size);
  q
}

// Debug builds only (section 2's slot rule): while the class lock is free, a slot is null or names a page ATTACHED to this
// class. Class lock held. A violation names the class and the page's state and genclass, and ends the process.
fn lfSlotRule(h: *Heap, cl: usize, d2: usize) {
  let g = aLd(d2);
  let st = aLd(d2 + 8usize);
  if st == lfAttached && usize.from(g & 255u64) == cl { return; }
  let buf = h.region + scratchOff;
  var n = putStr(buf, 0usize, "cnmalloc: slot rule broken, class ", 34usize);
  n = putNum(buf, n, u64.from(cl));
  n = putStr(buf, n, " state ", 7usize); n = putNum(buf, n, st);
  n = putStr(buf, n, " genclass ", 10usize); n = putNum(buf, n, g);
  n = putStr(buf, n, "\n", 1usize);
  osplat.writeErr(buf, n);
  osplat.fatal();
}

// "A slot's page has no free bit" (section 5), called by the shim's allocate with the thread's number and the page
// pointer it saw in its slot (0 for none). Returns 1 when the caller should retry the common path, 0 when the heap is
// out of memory.
pub fn cnm_lf_attach(hh: usize, cl: usize, tnum: usize, seen: usize) usize {
  let h = hh as *Heap;
  let c = classAt(h, cl);
  let L = lfc(h, cl);
  lockClass(h, c);
  let act = usize.from(rd32(L + 64usize));
  let si = tnum % act;
  let cur = usize.from(rd(L + 512usize + si * 8usize));
  if h.lfDebug != 0usize && cur != 0usize { lfSlotRule(h, cl, cur); }
  if cur != seen {
    osplat.unlock(c as usize);
    return 1usize;
  }
  var waiting = false;
  if cur != 0usize {
    // the same page: its words may have read as zero to this thread only because another lock holder was retiring it or
    // making it ready, and the same page can come back to the same slot (row 455's F2). A set bit sends the thread round.
    if lfScan(cur) != 0usize {
      osplat.unlock(c as usize);
      return 1usize;
    }
    wr(L + 512usize + si * 8usize, 0u64);
    waiting = lfDetach(h, c, cl, d2Page(h, cur), cur);
  }
  let q = lfPick(h, c, cl);
  if q == none {
    osplat.unlock(c as usize);
    if waiting { armIfWaiting(h); }
    return 0usize;
  }
  let d2 = d2Of(h, q);
  aXchg(d2 + 8usize, lfAttached);
  wr(L + 512usize + si * 8usize, u64.from(d2));
  wr8(L + 80usize + si, 1u8);
  lfBump(L, 5usize);
  osplat.unlock(c as usize);
  armIfWaiting(h);
  1usize
}

// "After a free" (section 5): g is the page's genclass as the freer read it BEFORE its fetch_or. Under the lock of
// class(g): if the page's genclass is no longer g it was retired after the free and belongs to another life; whoever
// retired it has dealt with it. While the lock is held and genclass == g the page cannot retire.
pub fn cnm_lf_after_free(hh: usize, d2: usize, g: u64) {
  let h = hh as *Heap;
  let cl = usize.from(g & 255u64);
  let c = classAt(h, cl);
  lockClass(h, c);
  if aLd(d2) != g {
    osplat.unlock(c as usize);
    return;
  }
  let st = aLd(d2 + 8usize);
  hookCall(h.hookAfter, cl);
  if st == lfAttached {
    osplat.unlock(c as usize);
    return;
  }
  var waiting = false;
  let r = lfScan(d2);
  var done = false;
  if r == 2usize {
    waiting = lfRetire(h, c, cl, d2Page(h, d2), d2);
    done = waiting;
  }
  if !done && r != 0usize && st == lfUnlisted && lfWorth(h, d2) {
    aSt(d2 + 8usize, lfListed);
    btSet(h, cl, d2Page(h, d2));
    lfBump(lfc(h, cl), 6usize);
  }
  osplat.unlock(c as usize);
  if waiting { armIfWaiting(h); }
}

// (row 603) The out-of-memory sweep. The shim calls it when cnm_lf_attach has returned 0 (no listed page, no spare, no page from
// the pool): under the class lock, every UNLISTED page of the class that has any free cell is listed, and the shim retries
// the allocation if this listed one. So the cells a relist threshold hides (fewer than the threshold in each word of a page
// that is neither attached nor listed) never cause an out-of-memory. It walks every page the pool has ever handed out, so it
// runs only here, never before an ordinary new page: a live set that grows would otherwise walk every page at each step.
// The class lock makes the state and class of such a page stable; a free that lands in a page after the walk has passed it
// is a free that happened after the out-of-memory verdict. Returns 1 when it listed a page.
pub fn cnm_lf_sweep(hh: usize, cl: usize) usize {
  let h = hh as *Heap;
  let c = classAt(h, cl);
  let p = poolOf(h);
  lockClass(h, c);
  osplat.lock(p as usize);
  let top = p.fresh;
  osplat.unlock(p as usize);
  var listed = 0usize;
  var q = 0usize;
  while q < top {
    let d2 = d2Of(h, q);
    if aLd(d2 + 8usize) == lfUnlisted && usize.from(aLd(d2) & 255u64) == cl && lfScan(d2) != 0usize {
      aSt(d2 + 8usize, lfListed);
      btSet(h, cl, q);
      lfBump(lfc(h, cl), 6usize);
      listed = 1usize;
    }
    q = q + 1usize;
  }
  osplat.unlock(c as usize);
  listed
}
// the settings the shim reads to compute its edge thresholds (lf_setup)
pub fn cnm_lf_relist(hh: usize) usize { (hh as *Heap).lfK }
pub fn cnm_lf_relistq(hh: usize) usize { (hh as *Heap).lfQ }

// The class has seen enough collisions: one more slot, up to the cap (section 8)
pub fn cnm_lf_grow(hh: usize, cl: usize) {
  let h = hh as *Heap;
  let c = classAt(h, cl);
  let L = lfc(h, cl);
  lockClass(h, c);
  let act = usize.from(rd32(L + 64usize));
  if act < h.slotCap {
    wr(L + 768usize + act * 8usize, u64.from(osplat.tick()));
    wr8(L + 80usize + act, 1u8);
    wr32(L + 64usize, u32.from(act + 1usize));
    lfBump(L, 3usize);
  }
  wr32(L + 192usize, 0u32);
  osplat.unlock(c as usize);
}

// Collect's share (section 5, last paragraph, and section 8): a slot not used for the give-back delay is dropped (its
// page detached; the active count lowered, down to 1; slot 0 keeps its page unless it is wholly free), and a bounded
// number of listed pages are tried for retirement. Returns the milliseconds until something here falls due, or 0.
fn lfCollect(h: *Heap, force: bool, delay: u64) u64 {
  var due = 0u64;
  let period = if delay < 2u64 { 2u64 } else { delay };
  var cl = 0usize;
  while cl < nClasses {
    let c = classAt(h, cl);
    if c.pages != 0u64 || rd32(lfc(h, cl) + 64usize) > 1u32 {
      let L = lfc(h, cl);
      lockClass(h, c);
      let now = osplat.tick();
      var k = usize.from(rd32(L + 64usize));
      if delay >= 0xFFFFFFFFFFFFFFu64 { k = 0usize; }     // giveback=never: no slot is dropped
      while k > 0usize {
        k = k - 1usize;
        if rd8(L + 80usize + k) != 0u8 {
          wr8(L + 80usize + k, 0u8);
          wr(L + 768usize + k * 8usize, u64.from(now));
          due = minDue(due, period);
        } else {
          let age = now - rd(L + 768usize + k * 8usize);
          if force || age >= delay {
            let P = usize.from(rd(L + 512usize + k * 8usize));
            if P != 0usize && (k >= 1usize || lfScan(P) == 2usize) {
              wr(L + 512usize + k * 8usize, 0u64);
              lfDetach(h, c, cl, d2Page(h, P), P);
            }
            if k >= 1usize && k == usize.from(rd32(L + 64usize)) - 1usize && rd(L + 512usize + k * 8usize) == 0u64 {
              wr32(L + 64usize, u32.from(k));
              wr32(L + 192usize, 0u32);
              lfBump(L, 4usize);
            }
          } else {
            due = minDue(due, delay - age);
          }
        }
      }
      var q = btLastBelow(h, cl, h.npages);
      var n = 0usize;
      while q != none && n < lfRetireBatch {
        let d2 = d2Of(h, q);
        if lfScan(d2) == 2usize { lfRetire(h, c, cl, q, d2); }
        q = btLastBelow(h, cl, q);
        n = n + 1usize;
      }
      osplat.unlock(c as usize);
    }
    cl = cl + 1usize;
  }
  due
}

// the shim hands the heap its two small-cell functions (for the calls that come through Cone: a large block shrinking to a small one, aligned cells)
pub fn cnm_lf_set(hh: usize, alloc: usize, free: usize, debug: usize) {
  let h = hh as *Heap;
  h.lfDebug = debug;
  h.lfAlloc = alloc;
  h.lfFree = free;
}
// tests only: functions called inside a detach (between the exchange and the scan), inside a retire after the page was
// found wholly free and before its words are claimed, inside a retire after the page is RETIRED, before its generation rises, and
// in "after a free" past the generation test (class lock held, page state loaded, nothing scanned yet)
pub fn cnm_lf_set_hooks(hh: usize, detach: usize, retire: usize, claim: usize, after: usize) {
  let h = hh as *Heap;
  h.hookDetach = detach;
  h.hookRetire = retire;
  h.hookClaim = claim;
  h.hookAfter = after;
}
// tests only (row 550): a function called, with the timer lock released and the timer's handle the creation sentinel,
// just before the timer is made; a test makes it allocate and free, so that armIfWaiting reaches armTimer again
pub fn cnm_set_timer_hook(hh: usize, f: usize) { (hh as *Heap).hookTimer = f; }
// the timer's state, for the test: its handle (0 none, 1 being made), whether it is armed, and how often it fired
pub fn cnm_timer_handle(hh: usize) usize { timerOf(hh as *Heap).handle }
pub fn cnm_timer_armed(hh: usize) usize { timerOf(hh as *Heap).armed }
pub fn cnm_timer_fired(hh: usize) u64 { timerOf(hh as *Heap).fired }
pub fn cnm_design(hh: usize) usize { (hh as *Heap).design }
// the header the shim reads: page base, descriptor base, heap size, the first class record, the statistics flag
pub fn cnm_lf_info(hh: usize) usize { (hh as *Heap).lf }
pub fn cnm_lf_collision_limit(hh: usize) usize { (hh as *Heap).collLimit }
// the park timeout the actors scheduler uses under design 2: the give-back delay in milliseconds (at least 1), 0 under design 1
pub fn cnm_park_ms(hh: usize) u64 {
  let h = hh as *Heap;
  if h.design != 2usize { return 0u64; }
  if h.mode == modeDelay { if h.delayMs < 1u64 { return 1u64; } return h.delayMs; }
  1u64
}
// statistics the shim keeps for the heap: calloc calls and bytes filled, small allocations by threads that are not workers
pub fn cnm_lf_set_counts(hh: usize, callocs: u64, callocBytes: u64, nonWorker: u64) {
  let h = hh as *Heap;
  h.callocs = callocs; h.callocBytes = callocBytes; h.nonWorker = nonWorker;
}

// ---------------------------------------------------------------------------
// Large blocks: each its own reservation, with room to grow in place
// ---------------------------------------------------------------------------

fn hashSlot(l: *Large, addr: usize) usize {
  ((addr >> 16usize) * 11400714819323198485usize) >> (64usize - l.bits)
}

fn entryAt(l: *Large, i: usize) *LEntry { (l.table + i * 48usize) as *LEntry }

fn capOf(e: *LEntry) usize { e.base + e.reserved - e.addr }

// find the slot of a block, or none. Large lock held.
fn largeFind(l: *Large, addr: usize) usize {
  if l.table == 0usize { return none; }
  var i = hashSlot(l, addr);
  while true {
    let e = entryAt(l, i);
    if e.addr == addr { return i; }
    if e.addr == 0usize { return none; }
    i = (i + 1usize) & (l.cap - 1usize);
  }
  none
}

fn largeInsertRaw(l: *Large, src: *LEntry) {
  var i = hashSlot(l, src.addr);
  while entryAt(l, i).addr != 0usize { i = (i + 1usize) & (l.cap - 1usize); }
  let e = entryAt(l, i);
  e.addr = src.addr; e.base = src.base; e.reserved = src.reserved;
  e.committed = src.committed; e.size = src.size; e.stamp = src.stamp;
}

// false when the table cannot grow
fn largeInsert(l: *Large, src: *LEntry) bool {
  if l.table == 0usize || (l.count + 1usize) * 2usize > l.cap {
    let ncap = if l.table == 0usize { 1024usize } else { l.cap * 2usize };
    let bytes = ncap * 48usize;
    let r = osplat.reserve(bytes);
    if r == 0usize { return false; }
    if !osplat.commit(r, bytes) { osplat.release(r, bytes); return false; }
    let oldT = l.table;
    let oldCap = l.cap;
    let oldBytes = l.tableBytes;
    l.table = r;
    l.cap = ncap;
    l.bits = 63usize - usize.from(ncap.leadingZeros());
    l.tableBytes = bytes;
    cReserve(l, 1u64); cCommit(l, 1u64);
    var j = 0usize;
    while j < oldCap {
      let e = (oldT + j * 48usize) as *LEntry;
      if e.addr != 0usize { largeInsertRaw(l, e); }
      j = j + 1usize;
    }
    if oldT != 0usize { osplat.release(oldT, oldBytes); cRelease(l, 1u64); }
  }
  largeInsertRaw(l, src);
  l.count = l.count + 1usize;
  true
}

// backward-shift deletion, so lookups need no tombstones
fn largeRemoveAt(l: *Large, slot: usize) {
  let mask = l.cap - 1usize;
  var i = slot;
  var j = slot;
  while true {
    j = (j + 1usize) & mask;
    let e = entryAt(l, j);
    if e.addr == 0usize { break; }
    let home = hashSlot(l, e.addr);
    // e may move into the hole at i only when its home is not in the (cyclic) range (i, j]
    var inRange = false;
    if i <= j { inRange = home > i && home <= j; } else { inRange = home > i || home <= j; }
    if !inRange {
      let t = entryAt(l, i);
      t.addr = e.addr; t.base = e.base; t.reserved = e.reserved;
      t.committed = e.committed; t.size = e.size; t.stamp = e.stamp;
      i = j;
    }
  }
  entryAt(l, i).addr = 0usize;
  l.count = l.count - 1usize;
}

fn cacheCount(h: *Heap, decommitted: bool) usize {
  var n = 0usize;
  var i = 0usize;
  while i < cacheSlots {
    let e = cacheAt(h, i);
    if e.addr != 0usize && ((e.committed == 0usize) == decommitted) { n = n + 1usize; }
    i = i + 1usize;
  }
  n
}

// row 446: each large-block system call is counted in sysCalls and in its own kind
fn cReserve(l: *Large, k: u64) { l.sysCalls = l.sysCalls + k; l.nReserve = l.nReserve + k; }
fn cCommit(l: *Large, k: u64) { l.sysCalls = l.sysCalls + k; l.nCommit = l.nCommit + k; }
fn cDecommit(l: *Large, k: u64) { l.sysCalls = l.sysCalls + k; l.nDecommit = l.nDecommit + k; }
fn cRelease(l: *Large, k: u64) { l.sysCalls = l.sysCalls + k; l.nRelease = l.nRelease + k; }

fn cacheRelease(h: *Heap, l: *Large, i: usize) {
  let e = cacheAt(h, i);
  l.cachedBytes = l.cachedBytes - e.committed;
  osplat.release(e.base, e.reserved);
  cRelease(l, 1u64);
  e.addr = 0usize;
}

// release the oldest decommitted entry (or the oldest of all when none is decommitted)
fn cacheEvict(h: *Heap, l: *Large, wantDecommitted: bool) {
  var best = none;
  var i = 0usize;
  while i < cacheSlots {
    let e = cacheAt(h, i);
    if e.addr != 0usize && (!wantDecommitted || e.committed == 0usize) {
      if best == none || e.stamp < cacheAt(h, best).stamp { best = i; }
    }
    i = i + 1usize;
  }
  if best != none { cacheRelease(h, l, best); }
}

fn cacheDecommit(l: *Large, e: *LEntry) {
  if e.committed != 0usize {
    osplat.decommit(e.addr, e.committed);
    cDecommit(l, 1u64);
    l.cachedBytes = l.cachedBytes - e.committed;
    e.committed = 0usize;
  }
}

// *fresh is 1 when the block is zero memory. Returns the block or 0. align is 0 for the natural 64 KiB.
fn largeAlloc(h: *Heap, n: usize, align: usize, fresh: *u32) usize {
  let l = largeOf(h);
  let rounded = roundUp(if n == 0usize { 1usize } else { n }, pageSize);
  let commitBytes = roundUp(if n == 0usize { 1usize } else { n }, 4096usize);
  osplat.lock(l as usize);
  // a freed reservation that fits (the smallest one), kept for reuse
  if align <= pageSize {
    var best = none;
    var i = 0usize;
    while i < cacheSlots {
      let e = cacheAt(h, i);
      if e.addr != 0usize && capOf(e) >= rounded && (best == none || capOf(e) < capOf(cacheAt(h, best))) { best = i; }
      i = i + 1usize;
    }
    if best != none {
      let e = cacheAt(h, best);
      var ent = *e;
      // the entry leaves the cache: its committed bytes leave the cache's count
      l.cachedBytes = l.cachedBytes - ent.committed;
      e.addr = 0usize;
      var ok = true;
      if ent.committed < commitBytes {
        ok = osplat.commit(ent.addr + ent.committed, commitBytes - ent.committed);
        cCommit(l, 1u64);
        if ok { ent.committed = commitBytes; }
      } else if ent.committed >= commitBytes + pageSize {
        // row 547: a live block keeps at most commitBytes + largeSlack committed (the bound); the rest goes back.
        // The program usually grows the block again (a List's realloc), and the tail it still holds is not faulted a second time.
        let keep = commitBytes + h.largeSlack;
        if ent.committed > keep {
          osplat.decommit(ent.addr + keep, ent.committed - keep);
          cDecommit(l, 1u64);
          ent.committed = keep;
        }
      }
      ent.size = n;
      ent.stamp = 0u64;
      if ok && largeInsert(l, &mut ent) {
        l.live = l.live + 1u64;
        l.bytes = l.bytes + u64.from(ent.committed);
        l.cacheHits = l.cacheHits + 1u64;
        osplat.unlock(l as usize);
        *fresh = 0u32;
        return ent.addr;
      }
      osplat.release(ent.base, ent.reserved);
      cRelease(l, 1u64);
      osplat.unlock(l as usize);
      return 0usize;
    }
  }
  // row 446: the reservation is largeReserve times the request, at most largeReserveCap more than it (2 and 64 MiB: as before)
  let extraWant = rounded * (h.largeReserve - 1usize);
  var reserved = rounded + (if extraWant < h.largeReserveCap { extraWant } else { h.largeReserveCap });
  if align > pageSize { reserved = reserved + align; }
  let r = osplat.reserve(reserved);
  cReserve(l, 1u64);
  if r == 0usize { osplat.unlock(l as usize); return 0usize; }
  let addr = if align > pageSize { roundUp(r, align) } else { r };
  if !osplat.commit(addr, commitBytes) {
    osplat.release(r, reserved);
    cCommit(l, 1u64); cRelease(l, 1u64);
    osplat.unlock(l as usize);
    return 0usize;
  }
  cCommit(l, 1u64);
  var ent = LEntry(addr, r, reserved, commitBytes, n, 0u64);
  if !largeInsert(l, &mut ent) {
    osplat.release(r, reserved);
    osplat.unlock(l as usize);
    return 0usize;
  }
  l.live = l.live + 1u64;
  l.bytes = l.bytes + u64.from(commitBytes);
  osplat.unlock(l as usize);
  *fresh = 1u32;
  addr
}

// Frees a large block into the cache (or releases it). Returns true if it was found.
fn largeFree(h: *Heap, a: usize) bool {
  let l = largeOf(h);
  osplat.lock(l as usize);
  let slot = largeFind(l, a);
  if slot == none { osplat.unlock(l as usize); return false; }
  var ent = *entryAt(l, slot);
  largeRemoveAt(l, slot);
  l.live = l.live - 1u64;
  l.bytes = l.bytes - u64.from(ent.committed);
  let now = osplat.tick();
  ent.stamp = now;
  ent.size = 0usize;
  var keep = true;
  if h.mode == modeNow {
    osplat.decommit(ent.addr, ent.committed);
    cDecommit(l, 1u64);
    ent.committed = 0usize;
  } else if h.mode == modeDelay && l.cachedBytes + ent.committed > h.largeCap {
    osplat.decommit(ent.addr, ent.committed);
    cDecommit(l, 1u64);
    ent.committed = 0usize;
  }
  // a slot for it: a full cache gives up its oldest
  var slotFree = none;
  var tries = 0usize;
  while slotFree == none && tries < 2usize {
    var i = 0usize;
    while i < cacheSlots { if cacheAt(h, i).addr == 0usize { slotFree = i; break; } i = i + 1usize; }
    if slotFree == none { cacheEvict(h, l, false); }
    tries = tries + 1usize;
  }
  if slotFree == none { keep = false; }
  if keep {
    let e = cacheAt(h, slotFree);
    e.addr = ent.addr; e.base = ent.base; e.reserved = ent.reserved;
    e.committed = ent.committed; e.size = 0usize; e.stamp = ent.stamp;
    l.cachedBytes = l.cachedBytes + ent.committed;
    // more than 8 decommitted reservations held: the oldest is released
    while cacheCount(h, true) > 8usize { cacheEvict(h, l, true); }
  } else {
    osplat.release(ent.base, ent.reserved);
    cRelease(l, 1u64);
  }
  osplat.unlock(l as usize);
  armIfWaiting(h);
  true
}

// the size of a large block, or none when a is not one
fn largeSize(h: *Heap, a: usize) usize {
  let l = largeOf(h);
  osplat.lock(l as usize);
  let slot = largeFind(l, a);
  var r = none;
  if slot != none { r = entryAt(l, slot).size; }
  osplat.unlock(l as usize);
  r
}

// grows or shrinks a large block in place when it can. 0 = could not, 1 = done. none when a is not large.
fn largeResize(h: *Heap, a: usize, n: usize) usize {
  let l = largeOf(h);
  osplat.lock(l as usize);
  let slot = largeFind(l, a);
  if slot == none { osplat.unlock(l as usize); return none; }
  let e = entryAt(l, slot);
  let want = roundUp(if n == 0usize { 1usize } else { n }, 4096usize);
  var r = 0usize;
  if want <= capOf(e) {
    r = 1usize;
    if want > e.committed {
      if osplat.commit(e.addr + e.committed, want - e.committed) {
        cCommit(l, 1u64);
        l.bytes = l.bytes + u64.from(want - e.committed);
        e.committed = want;
        l.grows = l.grows + 1u64;
      } else { r = 0usize; }
    } else if e.committed - want >= pageSize {
      osplat.decommit(e.addr + want, e.committed - want);
      cDecommit(l, 1u64);
      l.bytes = l.bytes - u64.from(e.committed - want);
      e.committed = want;
    }
    if r == 1usize { e.size = n; }
  }
  osplat.unlock(l as usize);
  r
}

// ---------------------------------------------------------------------------
// Giving back: collect
// ---------------------------------------------------------------------------

fn minDue(cur: u64, d: u64) u64 { if cur == 0u64 || d < cur { d } else { cur } }

// Does everything due under the delay (everything, when force), one run per take of the pool lock. Returns the
// milliseconds until the next empty page, spare or large block falls due, or 0 when nothing waits.
pub fn cnm_collect(hh: usize, force: bool) u64 {
  let h = hh as *Heap;
  let delay = if force { 0u64 } else { h.delayMs };
  var due = 0u64;
  let giving = force || h.mode == modeDelay;
  if h.design == 2usize {
    // the delay a slot or a listed page must have gone unused: 0 at 'now' and when forced, the setting under 'delay', never under 'never'
    var lfDelay = 0xFFFFFFFFFFFFFFu64;
    if force || h.mode == modeNow { lfDelay = 0u64; } else if h.mode == modeDelay { lfDelay = h.delayMs; }
    due = lfCollect(h, force, lfDelay);
  }
  var cl = 0usize;
  while cl < nClasses {
    let c = classAt(h, cl);
    if c.spare != none {
      osplat.lock(c as usize);
      if c.spare != none {
        let now = osplat.tick();
        let d = descOf(h, c.spare);
        let age = now - d.since;
        // at 'now' the spare goes back at a collect once the tick has moved on since it was kept (a loop that
        // frees and re-takes one block keeps stamping it, so a timer firing mid-loop leaves it alone)
        let nowDue = h.mode == modeNow && (force || age >= 1u64);
        if (giving && age >= delay) || nowDue {
          let page = c.spare;
          c.spare = none;
          poolPut(h, page, now);
        } else if h.mode == modeDelay {
          due = minDue(due, delay - age);
        } else if h.mode == modeNow {
          due = minDue(due, 1u64);
        }
      }
      osplat.unlock(c as usize);
    }
    cl = cl + 1usize;
  }
  let p = poolOf(h);
  if giving {
    while true {
      osplat.lock(p as usize);
      let n = giveRun(h, p, osplat.tick(), delay, 1usize << 20usize, 1usize << 30usize);
      osplat.unlock(p as usize);
      if n == 0usize { break; }
    }
  }
  if h.mode == modeDelay && !force {
    osplat.lock(p as usize);
    let now = osplat.tick();
    var q = btLastBelow(h, treeEmpty, h.npages);
    while q != none {
      let age = now - descOf(h, q).since;
      due = minDue(due, if age >= delay { 1u64 } else { delay - age });
      q = btLastBelow(h, treeEmpty, q);
    }
    osplat.unlock(p as usize);
  }
  // large blocks held for reuse
  let l = largeOf(h);
  osplat.lock(l as usize);
  let now = osplat.tick();
  var i = 0usize;
  while i < cacheSlots {
    let e = cacheAt(h, i);
    if e.addr != 0usize && e.committed != 0usize {
      let age = now - e.stamp;
      if giving && age >= delay {
        cacheDecommit(l, e);
      } else if h.mode == modeDelay {
        due = minDue(due, delay - age);
      }
    }
    i = i + 1usize;
  }
  while cacheCount(h, true) > 8usize { cacheEvict(h, l, true); }
  if force {
    var k = 0usize;
    while k < cacheSlots { if cacheAt(h, k).addr != 0usize { cacheRelease(h, l, k); } k = k + 1usize; }
  }
  osplat.unlock(l as usize);
  if due != 0u64 && due < 1u64 { due = 1u64; }
  due
}

// ---------------------------------------------------------------------------
// Creating a heap, settings
// ---------------------------------------------------------------------------

fn parseNum(a: usize, end: usize) usize {
  var v = 0usize;
  var i = a;
  while i < end {
    let ch = usize.from(*(i as *u8));
    if ch >= 48usize && ch <= 57usize { v = v * 10usize + (ch - 48usize); } else { break; }
    i = i + 1usize;
  }
  // a suffix: k, m, g
  if i < end {
    let s = usize.from(*(i as *u8));
    if s == 107usize || s == 75usize { v = v << 10usize; }
    else if s == 109usize || s == 77usize { v = v << 20usize; }
    else if s == 103usize || s == 71usize { v = v << 30usize; }
  }
  v
}

pub struct Settings {
  reserve: usize;
  mode: usize;
  delayMs: u64;
  largeCap: usize;
  stats: usize;
  cacheCap: usize;
  cacheMax: usize;
  largeReserve: usize;     // row 446: CNMALLOC=largereserve=<n>, 1 to 64, default 2
  largeReserveCap: usize;  // row 446: CNMALLOC=largereservecap=<bytes>, 1 MiB to 64 GiB, default 64 MiB
  design: usize;           // row 454: CNMALLOC=design=lockfree chooses the lock-free shared pages; 1 (default, also design=lock) the lock design
  slotCap: usize;          // row 454: CNMALLOC=slots=<n>, the most slots a class may hold (1 to 32; 0, the default, means min(processors, 32))
  collLimit: usize;        // row 454: CNMALLOC=collisions=<n>, collisions that add a slot (default 64)
  largeSlack: usize;       // row 547: CNMALLOC=largeslack=<bytes>, default 256 KiB; 0 trims a reused block to its request
  relist: usize;           // row 603: CNMALLOC=relist=<k>, 1 to 64: under design 2 a page is listed again when a word holds min(k, valid bits / q) free cells; 1 is the rule of one free cell
  relistq: usize;          // row 603: CNMALLOC=relistq=<q>, 1 to 64, default 4
}

// the defaults: 64 GiB of address space, give-back after 1000 ms, 64 MiB of large blocks kept, no cache
// (row 426: cache=<n> blocks per class per worker, 0 = off; cache_max=<bytes>, 1024)
pub fn cnm_defaults(s: *Settings) {
  s.reserve = 68719476736usize;
  s.mode = modeDelay;
  s.delayMs = 1000u64;
  s.largeCap = 67108864usize;
  s.stats = 0usize;
  s.cacheCap = 0usize;
  s.cacheMax = 1024usize;
  s.largeReserve = 2usize;
  s.largeReserveCap = 67108864usize;
  s.design = 1usize;
  s.slotCap = 0usize;
  s.collLimit = 64usize;
  s.largeSlack = 262144usize;
  s.relist = 8usize;
  s.relistq = 4usize;
}

// Reads CNMALLOC (for example "giveback=now,reserve=32g,largecap=16m,stats") into s. buf is 1024 bytes of scratch.
pub fn cnm_readEnv(s: *Settings, buf: usize) {
  let n = osplat.getEnv("CNMALLOC", buf, 1000usize);
  if n == 0usize { return; }
  let end = buf + n;
  var a = buf;
  while a < end {
    var z = a;
    while z < end && *(z as *u8) != 44u8 { z = z + 1usize; }
    let len = z - a;
    if len >= 9usize && strncmp(a as *u8, "giveback=", 9usize) == 0i32 {
      let v = a + 9usize;
      if strncmp(v as *u8, "now", 3usize) == 0i32 { s.mode = modeNow; }
      else if strncmp(v as *u8, "never", 5usize) == 0i32 { s.mode = modeNever; }
      else if strncmp(v as *u8, "delay:", 6usize) == 0i32 { s.mode = modeDelay; s.delayMs = u64.from(parseNum(v + 6usize, z)); }
    } else if len >= 11usize && strncmp(a as *u8, "largeslack=", 11usize) == 0i32 {
      s.largeSlack = parseNum(a + 11usize, z);
    } else if len >= 8usize && strncmp(a as *u8, "reserve=", 8usize) == 0i32 {
      s.reserve = parseNum(a + 8usize, z);
    } else if len >= 9usize && strncmp(a as *u8, "largecap=", 9usize) == 0i32 {
      s.largeCap = parseNum(a + 9usize, z);
    } else if len >= 13usize && strncmp(a as *u8, "largereserve=", 13usize) == 0i32 {
      s.largeReserve = parseNum(a + 13usize, z);
      if s.largeReserve < 1usize { s.largeReserve = 1usize; }
      if s.largeReserve > 64usize { s.largeReserve = 64usize; }
    } else if len >= 16usize && strncmp(a as *u8, "largereservecap=", 16usize) == 0i32 {
      s.largeReserveCap = parseNum(a + 16usize, z);
      if s.largeReserveCap < 1048576usize { s.largeReserveCap = 1048576usize; }
      if s.largeReserveCap > 68719476736usize { s.largeReserveCap = 68719476736usize; }
    } else if len >= 15usize && strncmp(a as *u8, "design=lockfree", 15usize) == 0i32 {
      s.design = 2usize;
    } else if len >= 11usize && strncmp(a as *u8, "design=lock", 11usize) == 0i32 {
      s.design = 1usize;
    } else if len >= 6usize && strncmp(a as *u8, "slots=", 6usize) == 0i32 {
      s.slotCap = parseNum(a + 6usize, z);
      if s.slotCap < 1usize { s.slotCap = 1usize; }
      if s.slotCap > lfMaxSlots { s.slotCap = lfMaxSlots; }
    } else if len >= 8usize && strncmp(a as *u8, "relistq=", 8usize) == 0i32 {
      s.relistq = parseNum(a + 8usize, z);
      if s.relistq < 1usize { s.relistq = 1usize; }
      if s.relistq > 64usize { s.relistq = 64usize; }
    } else if len >= 7usize && strncmp(a as *u8, "relist=", 7usize) == 0i32 {
      s.relist = parseNum(a + 7usize, z);
      if s.relist < 1usize { s.relist = 1usize; }
      if s.relist > 64usize { s.relist = 64usize; }
    } else if len >= 11usize && strncmp(a as *u8, "collisions=", 11usize) == 0i32 {
      s.collLimit = parseNum(a + 11usize, z);
      if s.collLimit < 1usize { s.collLimit = 1usize; }
    } else if len >= 6usize && strncmp(a as *u8, "cache=", 6usize) == 0i32 {
      s.cacheCap = parseNum(a + 6usize, z);
      if s.cacheCap > 1024usize { s.cacheCap = 1024usize; }
    } else if len >= 10usize && strncmp(a as *u8, "cache_max=", 10usize) == 0i32 {
      s.cacheMax = parseNum(a + 10usize, z);
      if s.cacheMax > maxSmall { s.cacheMax = maxSmall; }
    } else if len >= 5usize && strncmp(a as *u8, "stats", 5usize) == 0i32 {
      s.stats = 1usize;
    }
    a = z + 1usize;
  }
}

// Makes a heap: its own region, its three reservations, its classes. Returns its address, or 0.
pub fn cnm_create(s: *Settings) usize {
  let region = osplat.reserve(regionBytes);
  if region == 0usize { return 0usize; }
  if !osplat.commit(region, regionBytes) { osplat.release(region, regionBytes); return 0usize; }
  let h = region as *Heap;
  h.region = region;
  var size = roundUp(s.reserve, pageSize);
  if size < 67108864usize { size = 67108864usize; }
  if size > 1099511627776usize { size = 1099511627776usize; }
  var base = osplat.reserve(size);
  while base == 0usize && size > 67108864usize {
    size = size >> 1usize;
    base = osplat.reserve(size);
  }
  if base == 0usize { osplat.release(region, regionBytes); return 0usize; }
  h.base = base;
  h.size = size;
  h.npages = size >> pageShift;
  h.l0w = (h.npages + 63usize) >> 6usize;
  h.l1w = (h.l0w + 63usize) >> 6usize;
  h.l2w = (h.l1w + 63usize) >> 6usize;
  h.firstBytes = roundUp((h.l2w + h.l1w) * 8usize, 4096usize);
  h.firstChunks = h.firstBytes >> 12usize;
  h.treeStride = h.firstBytes + roundUp(h.l0w * 8usize, 4096usize);
  h.chunksPerTree = h.treeStride >> 12usize;
  h.flags = region + flagsOff;
  h.metaReserve = nTrees * h.treeStride;
  h.descReserve = h.npages * 64usize;
  h.metaBase = osplat.reserve(h.metaReserve);
  h.descBase = osplat.reserve(h.descReserve);
  if h.metaBase == 0usize || h.descBase == 0usize {
    if h.metaBase != 0usize { osplat.release(h.metaBase, h.metaReserve); }
    if h.descBase != 0usize { osplat.release(h.descBase, h.descReserve); }
    osplat.release(base, size);
    osplat.release(region, regionBytes);
    return 0usize;
  }
  h.mode = s.mode;
  h.delayMs = s.delayMs;
  h.largeCap = s.largeCap;
  h.largeSlack = roundUp(s.largeSlack, 4096usize);
  h.largeReserve = s.largeReserve;
  h.largeReserveCap = s.largeReserveCap;
  h.stats = s.stats;
  h.cacheCap = s.cacheCap;
  h.cacheMax = s.cacheMax;
  h.design = s.design;
  if s.design == 2usize {
    // the second design's descriptors and records: the lock design never reserves them
    h.d2Reserve = h.npages * d2Stride;
    h.d2Base = osplat.reserve(h.d2Reserve);
    let lfBytes = lfHeadBytes + nClasses * lfClsStride;
    h.lf = osplat.reserve(lfBytes);
    if h.d2Base == 0usize || h.lf == 0usize || !osplat.commit(h.lf, lfBytes) {
      if h.d2Base != 0usize { osplat.release(h.d2Base, h.d2Reserve); }
      if h.lf != 0usize { osplat.release(h.lf, lfBytes); }
      osplat.release(h.metaBase, h.metaReserve);
      osplat.release(h.descBase, h.descReserve);
      osplat.release(base, size);
      osplat.release(region, regionBytes);
      return 0usize;
    }
    // row 580: the default (0) is min(processors, 32); an explicit slots=<n> is clamped to 32 only (a test may set it above the processor count)
    var cap = s.slotCap;
    if cap == 0usize {
      cap = osplat.processors();
      if cap > lfMaxSlots { cap = lfMaxSlots; }
    }
    if cap < 1usize { cap = 1usize; }
    h.slotCap = cap;
    h.collLimit = s.collLimit;
    h.lfK = s.relist;
    h.lfQ = s.relistq;
    // the header the shim reads: page base, descriptor base, the heap's size, the first class record, the statistics flag
    wr(h.lf, u64.from(h.base)); wr(h.lf + 8usize, u64.from(h.d2Base)); wr(h.lf + 16usize, u64.from(h.size));
    wr(h.lf + 24usize, u64.from(h.lf + lfHeadBytes)); wr(h.lf + 32usize, u64.from(h.stats));
    var k = 0usize;
    while k < nClasses {
      let L = lfc(h, k);
      wr32(L + 64usize, 1u32); wr32(L + 68usize, u32.from(cap)); wr32(L + 72usize, u32.from(s.collLimit));
      k = k + 1usize;
    }
  }
  var c = 0usize;
  while c < nClasses {
    let k = classAt(h, c);
    k.idx = c;
    k.size = classSizeOf(c);
    k.limit = (pageSize / k.size) * k.size;
    k.commit = roundUp(k.limit, 4096usize);
    k.cur = none;
    k.spare = none;
    c = c + 1usize;
  }
  var i = 0usize;
  while i <= 64usize {
    let n = i * 16usize;
    var cl = 0usize;
    if i == 0usize { cl = 0usize; } else if n <= 128usize { cl = i - 1usize; } else { cl = classOfBig(n); }
    *((region + sizeMapOff + i) as *u8) = u8.from(cl);
    i = i + 1usize;
  }
  // where a foreign block goes: the C library's own functions, found by the platform's layer (never by the names this heap's
  // shim replaces)
  h.ucfree = osplat.foreignFree();
  h.ucrealloc = osplat.foreignRealloc();
  h.ucmsize = osplat.foreignMsize();
  h.ucafree = osplat.foreignAFree();
  h.ucarealloc = osplat.foreignARealloc();
  h.ucamsize = osplat.foreignAMsize();
  region
}

// A heap with the given settings (mode: 0 now, 1 delay, 2 never), for tests and tools that make their own.
// For tests and tools: a heap as cnm_make makes, with a large-block reserve factor (1 to 64) and the cap on the
// extra left at 64 MiB. Programs set these through CNMALLOC=largereserve=<n>,largereservecap=<n> instead.
pub fn cnm_make_lr(reserve: usize, mode: usize, delayMs: u64, largeCap: usize, largeReserve: usize) usize {
  var s = Settings(reserve, mode, delayMs, largeCap, 0usize, 0usize, 1024usize, largeReserve, 67108864usize, 1usize, 8usize, 64usize, 262144usize, 8usize, 4usize);
  cnm_create(&mut s)
}

pub fn cnm_make(reserve: usize, mode: usize, delayMs: u64, largeCap: usize) usize {
  var s = Settings(reserve, mode, delayMs, largeCap, 0usize, 0usize, 1024usize, 2usize, 67108864usize, 1usize, 8usize, 64usize, 262144usize, 8usize, 4usize);
  cnm_create(&mut s)
}

// A heap from the CNMALLOC environment variable. This is the process's: shim/cn_shim.c calls it once.
pub fn cnm_boot() usize {
  var s = Settings(0usize, 0usize, 0u64, 0usize, 0usize, 0usize, 1024usize, 2usize, 67108864usize, 1usize, 8usize, 64usize, 262144usize, 8usize, 4usize);
  cnm_defaults(&mut s);
  // the settings text is read into a scratch area, so the heap's own region is not made yet: a small
  // reservation holds it for the moment
  let tmp = osplat.reserve(65536usize);
  if tmp == 0usize { return 0usize; }
  if !osplat.commit(tmp, 4096usize) { osplat.release(tmp, 65536usize); return 0usize; }
  cnm_readEnv(&mut s, tmp);
  osplat.release(tmp, 65536usize);
  cnm_create(&mut s)
}

// FORK SAFETY (row 550). The shim registers these with pthread_atfork (Linux): the C library's own allocator is fork-safe,
// so the one that replaces it has to be. Before the fork the calling thread takes every lock the heap has, in the one
// order the LOCK ORDER above allows: each class lock by class number, then the pool's, the large table's and the
// timer's (the last three are never held while another is taken, so their place after the classes is free). No other
// thread then holds one across the fork, so the child never waits on a lock whose holder does not exist there. After it,
// the parent releases them in the reverse order; the child does the same, and has first forgotten its timer, whose thread
// is not in the child (a later arm makes another).
pub fn cnm_fork_prepare(hh: usize) {
  let h = hh as *Heap;
  var c = 0usize;
  while c < nClasses { osplat.lock(classAt(h, c) as usize); c = c + 1usize; }
  osplat.lock(poolOf(h) as usize);
  osplat.lock(largeOf(h) as usize);
  osplat.lock(timerOf(h) as usize);
}

fn forkUnlock(h: *Heap) {
  osplat.unlock(timerOf(h) as usize);
  osplat.unlock(largeOf(h) as usize);
  osplat.unlock(poolOf(h) as usize);
  var c = nClasses;
  while c > 0usize { c = c - 1usize; osplat.unlock(classAt(h, c) as usize); }
}

pub fn cnm_fork_parent(hh: usize) { forkUnlock(hh as *Heap); }

pub fn cnm_fork_child(hh: usize) {
  let h = hh as *Heap;
  let t = timerOf(h);
  t.handle = 0usize;
  t.armed = 0usize;
  forkUnlock(h);
}

// Gives every reservation back (tests only: a process's heap is never destroyed)
pub fn cnm_destroy(hh: usize) {
  let h = hh as *Heap;
  let t = timerOf(h);
  if t.handle > timerCreating { osplat.timerClose(t.handle); }
  let l = largeOf(h);
  var i = 0usize;
  while i < cacheSlots { if cacheAt(h, i).addr != 0usize { osplat.release(cacheAt(h, i).base, cacheAt(h, i).reserved); } i = i + 1usize; }
  var j = 0usize;
  while l.table != 0usize && j < l.cap {
    let e = entryAt(l, j);
    if e.addr != 0usize { osplat.release(e.base, e.reserved); }
    j = j + 1usize;
  }
  if l.table != 0usize { osplat.release(l.table, l.tableBytes); }
  if h.design == 2usize { osplat.release(h.d2Base, h.d2Reserve); osplat.release(h.lf, lfHeadBytes + nClasses * lfClsStride); }
  osplat.release(h.metaBase, h.metaReserve);
  osplat.release(h.descBase, h.descReserve);
  osplat.release(h.base, h.size);
  osplat.release(h.region, regionBytes);
}

// ---------------------------------------------------------------------------
// The standard API
// ---------------------------------------------------------------------------

// the ownership test: one subtract and one compare
pub fn cnm_owns(hh: usize, p: usize) bool {
  let h = hh as *Heap;
  (p - h.base) < h.size
}

// CNMALLOC=stats was set: the C file prints the counters at exit
pub fn cnm_wants_stats(hh: usize) bool { (hh as *Heap).stats != 0usize }

fn doMalloc(h: *Heap, n: usize, zero: bool) usize {
  if n <= maxSmall {
    var fresh = 0u32;
    let cl = classOf(h, n);
    let a = smallAlloc(h, cl, &mut fresh);
    if a != 0usize && zero && fresh == 0u32 { memset(a as *u8, 0i32, classAt(h, cl).size); }
    return a;
  }
  var fresh = 0u32;
  let a = largeAlloc(h, n, 0usize, &mut fresh);
  if a != 0usize && zero && fresh == 0u32 { memset(a as *u8, 0i32, n); }
  a
}

pub fn cnm_malloc(hh: usize, n: usize) *u8 { doMalloc(hh as *Heap, n, false) as *u8 }

pub fn cnm_calloc(hh: usize, count: usize, size: usize) *u8 {
  if count != 0usize && size > 0xFFFFFFFFFFFFFFFFusize / count { return 0usize as *u8; }
  doMalloc(hh as *Heap, count * size, true) as *u8
}

// the usable size of a block that is ours (small or large), or none when it is neither
fn sizeOfMine(h: *Heap, a: usize) usize {
  if (a - h.base) < h.size {
    let d = descOf(h, (a - h.base) >> pageShift);
    return classAt(h, usize.from(d.cls)).size;
  }
  largeSize(h, a)
}

pub fn cnm_usable(hh: usize, p: *u8) usize {
  let h = hh as *Heap;
  let a = p as usize;
  let s = sizeOfMine(h, a);
  if s != none { return s; }
  bumpForeign(h);
  if h.ucmsize == 0usize { return 0usize; }
  let f = h.ucmsize as &fn @c (p: *u8) usize;
  f(p)
}

pub fn cnm_free(hh: usize, p: *u8) {
  let a = p as usize;
  if a == 0usize { return; }
  let h = hh as *Heap;
  if (a - h.base) < h.size { freeSmall(h, a); return; }
  if largeFree(h, a) { return; }
  bumpForeign(h);
  let f = h.ucfree as &fn @c (p: *u8);
  f(p);
}

pub fn cnm_realloc(hh: usize, p: *u8, n: usize) *u8 {
  let h = hh as *Heap;
  let a = p as usize;
  if a == 0usize { return doMalloc(h, n, false) as *u8; }
  if (a - h.base) < h.size {
    if n == 0usize { freeSmall(h, a); return 0usize as *u8; }
    let d = descOf(h, (a - h.base) >> pageShift);
    let old = classAt(h, usize.from(d.cls)).size;
    if n <= maxSmall && classOf(h, n) == usize.from(d.cls) { return p; }
    let q = doMalloc(h, n, false);
    if q == 0usize { return 0usize as *u8; }
    memcpy(q as *u8, p, if n < old { n } else { old });
    freeSmall(h, a);
    return q as *u8;
  }
  let sz = largeSize(h, a);
  if sz != none {
    if n == 0usize { largeFree(h, a); return 0usize as *u8; }
    if n > maxSmall {
      if largeResize(h, a, n) == 1usize { return p; }
    }
    let q = doMalloc(h, n, false);
    if q == 0usize { return 0usize as *u8; }
    let cp = if n < sz { n } else { sz };
    memcpy(q as *u8, p, cp);
    largeFree(h, a);
    let l = largeOf(h);
    osplat.lock(l as usize);
    l.moves = l.moves + 1u64;
    l.copied = l.copied + u64.from(cp);
    osplat.unlock(l as usize);
    return q as *u8;
  }
  bumpForeign(h);
  let f = h.ucrealloc as &fn @c (p: *u8, n: usize) *u8;
  f(p, n)   // a foreign block stays foreign
}

// grows or shrinks in place only; null when it cannot
pub fn cnm_expand(hh: usize, p: *u8, n: usize) *u8 {
  let h = hh as *Heap;
  let a = p as usize;
  if a == 0usize { return 0usize as *u8; }
  if (a - h.base) < h.size {
    let d = descOf(h, (a - h.base) >> pageShift);
    if n <= classAt(h, usize.from(d.cls)).size && n != 0usize { return p; }
    return 0usize as *u8;
  }
  if largeSize(h, a) != none {
    if n > maxSmall && largeResize(h, a, n) == 1usize { return p; }
    return 0usize as *u8;
  }
  0usize as *u8
}

// _recalloc zeroes what the block grew by, counted from the old block's usable size (_msize), which is how MSVC
// defines it: the bytes between the caller's old count and the class's cell size are not cleared when a block
// that came from malloc grows. Accepted, as the C runtime's contract; a block from calloc/_recalloc is zero there.
pub fn cnm_recalloc(hh: usize, p: *u8, count: usize, size: usize) *u8 {
  if count != 0usize && size > 0xFFFFFFFFFFFFFFFFusize / count { return 0usize as *u8; }
  let n = count * size;
  let old = if p as usize == 0usize { 0usize } else { cnm_usable(hh, p) };
  let q = cnm_realloc(hh, p, n);
  if q as usize != 0usize && n > old && n != 0usize { memset((q as usize + old) as *u8, 0i32, n - old); }
  q
}

// Aligned blocks. A power-of-two alignment up to 64 KiB uses the smallest class whose cell size is a multiple
// of it: cells are at page base + k * size and pages are 64 KiB aligned. Otherwise (or when no class fits) a
// large block, placed at the alignment.
pub fn cnm_aligned(hh: usize, align: usize, n: usize) *u8 {
  let h = hh as *Heap;
  if align == 0usize || (align & (align - 1usize)) != 0usize { return 0usize as *u8; }
  if align <= 16usize { return doMalloc(h, n, false) as *u8; }
  if n <= maxSmall && align <= maxSmall {
    var cl = classOf(h, n);
    while cl < nClasses && (classAt(h, cl).size & (align - 1usize)) != 0usize { cl = cl + 1usize; }
    if cl < nClasses {
      var fresh = 0u32;
      return smallAlloc(h, cl, &mut fresh) as *u8;
    }
  }
  var fresh = 0u32;
  largeAlloc(h, n, align, &mut fresh) as *u8
}

pub fn cnm_aligned_realloc(hh: usize, p: *u8, n: usize, align: usize) *u8 {
  if p as usize == 0usize { return cnm_aligned(hh, align, n); }
  let h = hh as *Heap;
  let a = p as usize;
  let sz = sizeOfMine(h, a);
  if sz == none {
    bumpForeign(h);
    let f = h.ucarealloc as &fn @c (p: *u8, n: usize, a: usize) *u8;
    return f(p, n, align);
  }
  let q = cnm_aligned(hh, align, n);
  if q as usize == 0usize { return q; }
  memcpy(q, p, if n < sz { n } else { sz });
  cnm_free(hh, p);
  q
}

// A block from the C runtime's own _aligned_malloc is foreign: its free and its size go to ucrtbase's aligned
// functions (the plain free would corrupt its heap). Ours go the ordinary way.
pub fn cnm_aligned_free(hh: usize, p: *u8) {
  let h = hh as *Heap;
  let a = p as usize;
  if a == 0usize { return; }
  if (a - h.base) < h.size || largeSize(h, a) != none { cnm_free(hh, p); return; }
  bumpForeign(h);
  let f = h.ucafree as &fn @c (p: *u8);
  f(p);
}

pub fn cnm_aligned_msize(hh: usize, p: *u8, align: usize, off: usize) usize {
  let h = hh as *Heap;
  let s = sizeOfMine(h, p as usize);
  if s != none { return s; }
  bumpForeign(h);
  let f = h.ucamsize as &fn @c (p: *u8, a: usize, o: usize) usize;
  f(p, align, off)
}

// ---------------------------------------------------------------------------
// The workers' cache (row 426): the heap's half
//
// The cache itself (a short LIFO list of cells per class, per worker, in a C thread-local) is in shim/cn_shim.c,
// because a C-named Cone module has no globals and so no thread-locals. This is what that file needs of the heap.
// A CACHED CELL STAYS COUNTED AS USED: nothing here changes d.used, c.live or a page's free list when a cell goes
// into a cache or comes out of one. A cell leaves the heap only through takeCell (d.used + 1, under the class
// lock) and returns only through putCell (d.used - 1, under the class lock, retiring the page if that was its
// last live cell), exactly as an uncached allocate and free do. So a page with a cell in some worker's cache has
// used >= 1 and cannot retire, and retiring is untouched: it still happens only in putCell, under the class lock.
// ---------------------------------------------------------------------------

// the cache settings, read once by the shim
pub fn cnm_cache_cap(hh: usize) usize { (hh as *Heap).cacheCap }
pub fn cnm_cache_max(hh: usize) usize { (hh as *Heap).cacheMax }

// the class of a request of n bytes, or none when n is over the largest small class
pub fn cnm_class_of(hh: usize, n: usize) usize {
  if n > maxSmall { return none; }
  classOf(hh as *Heap, n)
}

pub fn cnm_class_size(hh: usize, cl: usize) usize { classAt(hh as *Heap, cl).size }

// the class of a block of ours that lives in a page, or none (a large or foreign block). Read without the lock,
// on the same argument as freeSmall's: the caller holds a live block.
pub fn cnm_cell_class(hh: usize, p: *u8) usize {
  let h = hh as *Heap;
  let a = p as usize;
  if (a - h.base) >= h.size { return none; }
  usize.from(descOf(h, (a - h.base) >> pageShift).cls)
}

// Up to n cells of class cl, taken under one take of the class's lock, chained through their first words (the
// last has 0). *got says how many (fewer only when the heap is out of memory). The cells are not zeroed.
pub fn cnm_batch_alloc(hh: usize, cl: usize, n: usize, got: *usize) usize {
  let h = hh as *Heap;
  let c = classAt(h, cl);
  var head = 0usize;
  var k = 0usize;
  var fresh = 0u32;
  lockClass(h, c);
  while k < n {
    let a = takeCell(h, c, cl, &mut fresh);
    if a == 0usize { break; }
    wr(a, u64.from(head));
    head = a;
    k = k + 1usize;
  }
  osplat.unlock(c as usize);
  *got = k;
  head
}

// n cells of class cl, chained through their first words, given back under one take of the class's lock. Every
// cell goes through putCell, so pages that empty retire exactly as they do for single frees.
pub fn cnm_batch_free(hh: usize, cl: usize, head: usize, n: usize) {
  let h = hh as *Heap;
  let c = classAt(h, cl);
  var waiting = false;
  var a = head;
  var k = 0usize;
  lockClass(h, c);
  while a != 0usize && k < n {
    let nx = usize.from(rd(a));       // before putCell overwrites the cell's first word
    let page = (a - h.base) >> pageShift;
    if putCell(h, c, cl, page, descOf(h, page), a) { waiting = true; }
    a = nx;
    k = k + 1usize;
  }
  osplat.unlock(c as usize);
  if waiting { armIfWaiting(h); }
}

// The shim publishes its caches' totals before the counters are read or printed: bytes held now, hits, misses
// (an allocate that found its list empty), batch returns (a push over the cap) and batch fills (= misses that got cells).
pub fn cnm_set_cache_stats(hh: usize, bytes: u64, hits: u64, misses: u64, returns: u64, fills: u64) {
  let h = hh as *Heap;
  h.cBytes = bytes; h.cHits = hits; h.cMisses = misses; h.cReturns = returns; h.cFills = fills;
}

// ---------------------------------------------------------------------------
// Counters
// ---------------------------------------------------------------------------

// Copies the counters out, 64-bit each, in this order, and returns how many. Per class (72 times):
// allocs, frees, live, pages, lock waits. Then the pool: committed bytes, empty pages, decommitted pages,
// pages reused, commit calls, decommit calls. Then large: live blocks, committed bytes, in-place grows,
// moves, cache hits, system calls. Then foreign blocks forwarded. Taken without the locks: a snapshot, not
// a transaction.
pub fn cnm_stats(hh: usize, out: *u64, max: usize) usize {
  let h = hh as *Heap;
  var n = 0usize;
  var c = 0usize;
  while c < nClasses && n + 5usize <= max {
    let k = classAt(h, c);
    let o = out as usize + n * 8usize;
    wr(o, k.allocs); wr(o + 8usize, k.frees); wr(o + 16usize, k.live); wr(o + 24usize, k.pages); wr(o + 32usize, k.waits);
    n = n + 5usize;
    c = c + 1usize;
  }
  if n + 19usize <= max {
    let p = poolOf(h);
    let l = largeOf(h);
    let o = out as usize + n * 8usize;
    wr(o, p.committedBytes); wr(o + 8usize, p.nEmpty); wr(o + 16usize, p.nDecommitted);
    wr(o + 24usize, p.reused); wr(o + 32usize, p.commitCalls); wr(o + 40usize, p.decommitCalls);
    wr(o + 48usize, l.live); wr(o + 56usize, l.bytes); wr(o + 64usize, l.grows);
    wr(o + 72usize, l.moves); wr(o + 80usize, l.cacheHits); wr(o + 88usize, l.sysCalls);
    wr(o + 96usize, h.foreign);
    n = n + 13usize;
    // row 426: the workers' caches, as last published by the shim: bytes held, hits, misses, batch returns, batch fills
    if n + 5usize <= max {
      wr(o + 104usize, h.cBytes); wr(o + 112usize, h.cHits); wr(o + 120usize, h.cMisses);
      wr(o + 128usize, h.cReturns); wr(o + 136usize, h.cFills);
      n = n + 5usize;
      // row 446: bytes copied by moves, then system calls by kind: reserve, commit, decommit, release
      if n + 5usize <= max {
        wr(o + 144usize, l.copied); wr(o + 152usize, l.nReserve); wr(o + 160usize, l.nCommit);
        wr(o + 168usize, l.nDecommit); wr(o + 176usize, l.nRelease);
        n = n + 5usize;
        // row 454, design 2 only: calloc calls, bytes filled, small allocations by non-workers; then per class (72 times):
        // allocs, frees, collisions, slots added, slots dropped, pages attached, pages listed, pages retired, retires
        // abandoned, Rule G undos (the first three counted by the shim's common paths, only in a statistics run)
        if h.design == 2usize && n + 3usize + nClasses * 10usize <= max {
          let o2 = out as usize + n * 8usize;
          wr(o2, h.callocs); wr(o2 + 8usize, h.callocBytes); wr(o2 + 16usize, h.nonWorker);
          n = n + 3usize;
          var k = 0usize;
          while k < nClasses {
            var m = 0usize;
            while m < 10usize {
              wr(out as usize + n * 8usize, rd(lfc(h, k) + 256usize + m * 8usize));
              n = n + 1usize;
              m = m + 1usize;
            }
            k = k + 1usize;
          }
        }
      }
    }
  }
  n
}

// ---- printing, with no allocation: lines are built in the heap's own scratch area -----------------------

fn putStr(buf: usize, pos: usize, s: cstr, len: usize) usize {
  copyLit((buf + pos) as *u8, s, len);
  pos + len
}

fn putNum(buf: usize, pos: usize, v: u64) usize {
  var digits = 1usize;
  var t = v;
  while t >= 10u64 { t = t / 10u64; digits = digits + 1usize; }
  var x = v;
  var i = digits;
  while i > 0usize {
    i = i - 1usize;
    *((buf + pos + i) as *u8) = u8.from(48u64 + x % 10u64);
    x = x / 10u64;
  }
  pos + digits
}

// one line per class that was used, then the pool and the large table; to stderr
pub fn cnm_print_stats(hh: usize) {
  let h = hh as *Heap;
  let buf = h.region + scratchOff;
  var c = 0usize;
  while c < nClasses {
    let k = classAt(h, c);
    if k.allocs != 0u64 {
      var n = putStr(buf, 0usize, "cnmalloc class ", 15usize);
      n = putNum(buf, n, u64.from(k.size));
      n = putStr(buf, n, " allocs ", 8usize); n = putNum(buf, n, k.allocs);
      n = putStr(buf, n, " frees ", 7usize); n = putNum(buf, n, k.frees);
      n = putStr(buf, n, " live ", 6usize); n = putNum(buf, n, k.live);
      n = putStr(buf, n, " pages ", 7usize); n = putNum(buf, n, k.pages);
      n = putStr(buf, n, " lockwaits ", 11usize); n = putNum(buf, n, k.waits);
      n = putStr(buf, n, "\n", 1usize);
      osplat.writeErr(buf, n);
    }
    c = c + 1usize;
  }
  let p = poolOf(h);
  let l = largeOf(h);
  var n = putStr(buf, 0usize, "cnmalloc pool committed ", 24usize);
  n = putNum(buf, n, p.committedBytes);
  n = putStr(buf, n, " empty ", 7usize); n = putNum(buf, n, p.nEmpty);
  n = putStr(buf, n, " decommitted ", 13usize); n = putNum(buf, n, p.nDecommitted);
  n = putStr(buf, n, " reused ", 8usize); n = putNum(buf, n, p.reused);
  n = putStr(buf, n, " commitcalls ", 13usize); n = putNum(buf, n, p.commitCalls);
  n = putStr(buf, n, " decommitcalls ", 15usize); n = putNum(buf, n, p.decommitCalls);
  n = putStr(buf, n, "\n", 1usize);
  osplat.writeErr(buf, n);
  n = putStr(buf, 0usize, "cnmalloc large live ", 20usize);
  n = putNum(buf, n, l.live);
  n = putStr(buf, n, " bytes ", 7usize); n = putNum(buf, n, l.bytes);
  n = putStr(buf, n, " grows ", 7usize); n = putNum(buf, n, l.grows);
  n = putStr(buf, n, " moves ", 7usize); n = putNum(buf, n, l.moves);
  n = putStr(buf, n, " foreign ", 9usize); n = putNum(buf, n, h.foreign);
  n = putStr(buf, n, " syscalls ", 10usize); n = putNum(buf, n, l.sysCalls);
  n = putStr(buf, n, " cachehits ", 11usize); n = putNum(buf, n, l.cacheHits);
  n = putStr(buf, n, " copied ", 8usize); n = putNum(buf, n, l.copied);
  n = putStr(buf, n, " reserves ", 10usize); n = putNum(buf, n, l.nReserve);
  n = putStr(buf, n, " commits ", 9usize); n = putNum(buf, n, l.nCommit);
  n = putStr(buf, n, " decommits ", 11usize); n = putNum(buf, n, l.nDecommit);
  n = putStr(buf, n, " releases ", 10usize); n = putNum(buf, n, l.nRelease);
  n = putStr(buf, n, "\n", 1usize);
  osplat.writeErr(buf, n);
  if h.cacheCap != 0usize {
    n = putStr(buf, 0usize, "cnmalloc cache cap ", 19usize);
    n = putNum(buf, n, u64.from(h.cacheCap));
    n = putStr(buf, n, " max ", 5usize); n = putNum(buf, n, u64.from(h.cacheMax));
    n = putStr(buf, n, " bytes ", 7usize); n = putNum(buf, n, h.cBytes);
    n = putStr(buf, n, " hits ", 6usize); n = putNum(buf, n, h.cHits);
    n = putStr(buf, n, " misses ", 8usize); n = putNum(buf, n, h.cMisses);
    n = putStr(buf, n, " batchreturns ", 14usize); n = putNum(buf, n, h.cReturns);
    n = putStr(buf, n, " batchfills ", 12usize); n = putNum(buf, n, h.cFills);
    n = putStr(buf, n, "\n", 1usize);
    osplat.writeErr(buf, n);
  }
  if h.design == 2usize {
    var cls = 0usize;
    var wholly = 0u64;
    while cls < nClasses {
      let L = lfc(h, cls);
      let act = usize.from(rd32(L + 64usize));
      let allocs = rd(L + 256usize);
      let attached = rd(L + 296usize);
      var s = 0usize;
      while s < act {
        let P = usize.from(rd(L + 512usize + s * 8usize));
        if P != 0usize && lfScan(P) == 2usize { wholly = wholly + 1u64; }
        s = s + 1usize;
      }
      if allocs != 0u64 || attached != 0u64 {
        n = putStr(buf, 0usize, "cnmalloc lf class ", 18usize);
        n = putNum(buf, n, u64.from(classAt(h, cls).size));
        n = putStr(buf, n, " allocs ", 8usize); n = putNum(buf, n, allocs);
        n = putStr(buf, n, " frees ", 7usize); n = putNum(buf, n, rd(L + 264usize));
        n = putStr(buf, n, " collisions ", 12usize); n = putNum(buf, n, rd(L + 272usize));
        n = putStr(buf, n, " activeslots ", 13usize); n = putNum(buf, n, u64.from(act));
        n = putStr(buf, n, " slotsadded ", 12usize); n = putNum(buf, n, rd(L + 280usize));
        n = putStr(buf, n, " slotsdropped ", 14usize); n = putNum(buf, n, rd(L + 288usize));
        n = putStr(buf, n, " attached ", 10usize); n = putNum(buf, n, attached);
        n = putStr(buf, n, " listed ", 8usize); n = putNum(buf, n, rd(L + 304usize));
        n = putStr(buf, n, " retired ", 9usize); n = putNum(buf, n, rd(L + 312usize));
        n = putStr(buf, n, " retiresabandoned ", 18usize); n = putNum(buf, n, rd(L + 320usize));
        n = putStr(buf, n, " ruleGundos ", 12usize); n = putNum(buf, n, rd(L + 328usize));
        n = putStr(buf, n, "\n", 1usize);
        osplat.writeErr(buf, n);
      }
      cls = cls + 1usize;
    }
    n = putStr(buf, 0usize, "cnmalloc lf calloccalls ", 24usize); n = putNum(buf, n, h.callocs);
    n = putStr(buf, n, " callocbytes ", 13usize); n = putNum(buf, n, h.callocBytes);
    n = putStr(buf, n, " nonworkersmall ", 16usize); n = putNum(buf, n, h.nonWorker);
    n = putStr(buf, n, " attachedwhollyfree ", 20usize); n = putNum(buf, n, wholly);
    n = putStr(buf, n, "\n", 1usize);
    osplat.writeErr(buf, n);
  }
}

// what the runner collects: one line per class that was ever contended, and the total
pub fn cnm_print_lock_waits_of(hh: usize) {
  let h = hh as *Heap;
  let buf = h.region + scratchOff;
  var total = 0u64;
  var c = 0usize;
  while c < nClasses {
    let k = classAt(h, c);
    total = total + k.waits;
    if k.waits != 0u64 {
      var n = putStr(buf, 0usize, "lockwaits class ", 16usize);
      n = putNum(buf, n, u64.from(k.size));
      n = putStr(buf, n, " ", 1usize); n = putNum(buf, n, k.waits);
      n = putStr(buf, n, "\n", 1usize);
      osplat.writeErr(buf, n);
    }
    c = c + 1usize;
  }
  var n = putStr(buf, 0usize, "lockwaits total ", 16usize);
  n = putNum(buf, n, total);
  n = putStr(buf, n, "\n", 1usize);
  osplat.writeErr(buf, n);
}
