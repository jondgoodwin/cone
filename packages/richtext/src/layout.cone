// ======== Layout: blocks to lines, glyphs, boxes and rectangles ========
//
// METHOD: GREEDY FIRST-FIT line breaking (the line is filled with words until the next word does not
// fit, then broken at the last space, or at a hyphen, or inside the word if it alone is wider than the
// line), then justification by widening the spaces. This is what browsers and word processors do for
// their lines. Knuth and Plass's total-fit algorithm ("Breaking Paragraphs into Lines", 1981) makes
// the paragraph as a whole look better (fewer loose lines, no rivers), but its boxes-glue-penalties
// model wants the width of every line before the paragraph is laid out, and here a line's width depends
// on the floats beside it, which depend on the height of the lines above. The width per line could be
// given to it by an iteration; that is the extension, and the line breaker is one function.
//
// FLOATS. An image placed left or right is ANCHORED in its paragraph: the picture is put at the top of
// that paragraph (as Word does for a picture anchored to a paragraph) against the page margin, below any
// float already on that side that it would overlap, and every line whose band meets the picture is
// narrower by the picture and a gap. Lines of the following paragraphs wrap around it too, until its
// bottom. A band too narrow to hold a word is skipped past the float.
//
// FONTS. Bold and italic are faces (separate font files), chosen by the style: 'Faces' holds up to four
// and maps (bold, italic) to one. A missing face falls back to the regular one (no synthetic oblique:
// msdftext's quads cannot slant, and a synthetic bold would need the field to be widened).
//
// Layout depends on fonts and the document, never on the GPU or the atlas: the renderer asks the atlas
// for glyph quads when it draws. Positions are in pixels, x right, y DOWN, the page's top left being 0.

pub const GF_UNDERLINE = 1u32;
pub const GF_LINK = 2u32;
pub const GF_SPACE = 4u32;
pub const GF_OBJECT = 8u32;     // an image's anchor character: no glyph

pub struct Faces {
  pub fonts: List[Font];
  pub slot0: u32 = 0u32;          // regular
  pub slot1: u32 = 0u32;          // bold
  pub slot2: u32 = 0u32;          // italic
  pub slot3: u32 = 0u32;          // bold italic
  pub hasBold: bool = false;
  pub hasItalic: bool = false;

  // A family of one font; add the others with 'setBold', 'setItalic', 'setBoldItalic'
  pub fn make(regular: Font) Faces {
    var f = Faces(List[Font].empty());
    f.fonts.push(regular);
    f
  }

  pub fn setBold(self: &mut, font: Font) { fonts.push(font); slot1 = u32.from(fonts.len() - 1usize); hasBold = true; }
  pub fn setItalic(self: &mut, font: Font) { fonts.push(font); slot2 = u32.from(fonts.len() - 1usize); hasItalic = true; }
  pub fn setBoldItalic(self: &mut, font: Font) {
    fonts.push(font);
    slot3 = u32.from(fonts.len() - 1usize);
  }

  // The face for a style: bold-italic falls back to bold, then italic, then regular
  pub fn pick(self: &, bold: bool, italic: bool) u32 {
    if bold && italic {
      if slot3 != 0u32 { return slot3; }
      if slot1 != 0u32 { return slot1; }
      return slot2;
    }
    if bold { return slot1; }
    if italic { return slot2; }
    slot0
  }

  pub fn font(self: &, face: u32) &Font { fonts[usize.from(face)] }
  pub fn count(self: &) usize { fonts.len() }
}

pub struct LayoutConfig {
  pub width: f32;                 // the page's width
  pub margin: f32;                // left and right
  pub marginTop: f32;
  pub baseSize: f32;              // body text, pixels of em
  pub lineHeight: f32;            // times the font's ascent + descent
  pub paraGap: f32;               // between paragraphs, times baseSize
  pub listIndent: f32;            // per list level
  pub floatGap: f32;              // between a float and the text beside it
  pub textColor: u32;             // 0xRRGGBBAA
  pub linkColor: u32;
  pub align: u32;                 // the default for a block whose align is AL_LEFT

  pub fn standard(width: f32) LayoutConfig {
    LayoutConfig(width, 40.0, 36.0, 18.0, 1.25, 0.55, 28.0, 14.0, 0x202124ffu32, 0x1a5fb4ffu32, AL_LEFT)
  }
}

// One character placed (a space, a letter, an anchor). 'x' is the pen, 'y' the baseline
pub struct GlyphP {
  pub x: f32;
  pub y: f32;
  pub adv: f32;
  pub size: f32;
  pub face: u32;
  pub glyph: u32;
  pub color: u32;
  pub flags: u32;
  pub block: u32;
  pub off: u32;                   // byte offset in the block's text
  pub len: u32;                   // bytes of the character
  pub link: u32 = 0u32;           // the link it belongs to (0: none)
}

pub struct LineP {
  pub block: u32;
  pub start: u32;                 // the bytes this line shows: start..end
  pub end: u32;
  pub inkEnd: u32;                // where trailing spaces begin
  pub top: f32;
  pub height: f32;
  pub baseline: f32;
  pub x0: f32;                    // the content's left and right
  pub x1: f32;
  pub g0: u32;                    // its glyphs: g0..g0+gn
  pub gn: u32;
  pub last: bool;                 // the block's last line
}

// An image placed
pub struct BoxP {
  pub x: f32;
  pub y: f32;
  pub w: f32;
  pub h: f32;
  pub image: u32;                 // number + 1
  pub block: u32;
  pub off: u32;
  pub floating: bool;
}

pub const RK_UNDERLINE = 0u32;

pub struct RectP {
  pub x: f32;
  pub y: f32;
  pub w: f32;
  pub h: f32;
  pub color: u32;
  pub kind: u32;
}

pub struct RichLayout {
  pub glyphs: List[GlyphP];
  pub markers: List[GlyphP];      // list bullets and numbers
  pub lines: List[LineP];
  pub boxes: List[BoxP];
  pub rects: List[RectP];         // underlines
  pub floats: List[FloatBox];     // the space the floats take
  // For each block, where its items start in each list, and the y it started at (before the gap above it):
  // what an incremental layout needs to start in the middle
  pub blockLine: List[u32];
  pub blockGlyph: List[u32];
  pub blockBox: List[u32];
  pub blockRect: List[u32];
  pub blockMarker: List[u32];
  pub blockFloat: List[u32];
  pub blockY: List[f32];
  pub endY: f32 = 0.0;            // y after the last block
  pub width: f32;
  pub height: f32;
  pub reused: u32 = 0u32;         // blocks an incremental layout took from the previous layout (prefix + tail)
}

pub fn emptyLayout(width: f32) RichLayout {
  RichLayout(List[GlyphP].empty(), List[GlyphP].empty(), List[LineP].empty(), List[BoxP].empty(), List[RectP].empty(),
    List[FloatBox].empty(), List[u32].empty(), List[u32].empty(), List[u32].empty(), List[u32].empty(), List[u32].empty(),
    List[u32].empty(), List[f32].empty(), 0.0, width, 0.0)
}

// ---- the builder ----

struct Item {
  off: u32;
  len: u32;
  kind: u32;                      // 0 glyph, 1 space, 2 inline object, 3 float anchor
  adv: f32;
  kern: f32;                      // with the item before, same line
  size: f32;
  face: u32;
  glyph: u32;
  color: u32;
  flags: u32;
  asc: f32;
  desc: f32;
  img: u32;                       // number + 1
  hyphen: bool;
  link: u32 = 0u32;
}

pub struct FloatBox {
  pub x0: f32;
  pub x1: f32;
  pub y0: f32;
  pub y1: f32;
}

fn maxf(a: f32, b: f32) f32 { if a > b { a } else { b } }

fn decodeAt(t: &str, off: usize, len: &mut usize) u32 {
  let b = u32.from(t[off]);
  if b < 0x80u32 { *len = 1usize; return b; }
  if b >= 0xC2u32 && b < 0xE0u32 && off + 1usize < t.len() {
    *len = 2usize;
    return ((b & 0x1Fu32) << 6u32) | (u32.from(t[off + 1usize]) & 0x3Fu32);
  }
  if b >= 0xE0u32 && b < 0xF0u32 && off + 2usize < t.len() {
    *len = 3usize;
    return ((b & 0x0Fu32) << 12u32) | ((u32.from(t[off + 1usize]) & 0x3Fu32) << 6u32) | (u32.from(t[off + 2usize]) & 0x3Fu32);
  }
  if b >= 0xF0u32 && b < 0xF5u32 && off + 3usize < t.len() {
    *len = 4usize;
    return ((b & 0x07u32) << 18u32) | ((u32.from(t[off + 1usize]) & 0x3Fu32) << 12u32)
      | ((u32.from(t[off + 2usize]) & 0x3Fu32) << 6u32) | (u32.from(t[off + 3usize]) & 0x3Fu32);
  }
  *len = 1usize;
  0xFFFDu32
}

struct Builder {
  out: RichLayout;
  floats: List[FloatBox];
  y: f32;                         // the next block's top
  counters: List[u32];            // numbering per depth

  fn floatBottom(self: &, y: f32, h: f32) f32 {
    // the lowest bottom edge among floats that meet the band y..y+h
    var best = y;
    var i = 0usize;
    while i < floats.len() {
      let f = floats[i];
      if f.y0 < y + h && f.y1 > y && f.y1 > best { best = f.y1; }
      i = i + 1usize;
    }
    best
  }

  // The free span of the band y..y+h between left and right
  fn span(self: &, y: f32, h: f32, left: f32, right: f32, outL: &mut f32, outR: &mut f32) {
    var xl = left;
    var xr = right;
    var i = 0usize;
    while i < floats.len() {
      let f = floats[i];
      if f.y0 < y + h && f.y1 > y {
        // a float in the left half pushes the left edge, one in the right half the right
        if (f.x0 + f.x1) * 0.5 < (left + right) * 0.5 { if f.x1 > xl { xl = f.x1; } }
        else { if f.x0 < xr { xr = f.x0; } }
      }
      i = i + 1usize;
    }
    *outL = xl;
    *outR = xr;
  }
}

fn listMarker(kind: u32, depth: u32, n: u32) String {
  var s = String.empty();
  if kind == BK_BULLET {
    // U+2022, U+25E6, U+25AA
    let d = depth % 3u32;
    if d == 0u32 { s.appendByte(0xE2u8); s.appendByte(0x80u8); s.appendByte(0xA2u8); }
    elif d == 1u32 { s.appendByte(0xE2u8); s.appendByte(0x97u8); s.appendByte(0xA6u8); }
    else { s.appendByte(0xE2u8); s.appendByte(0x96u8); s.appendByte(0xAAu8); }
    return s;
  }
  let d = depth % 3u32;
  if d == 0u32 { s.appendUInt(u64.from(n)); }
  elif d == 1u32 {
    // a, b, c ... z, aa, ab ...
    var k = n;
    var digits = List[u8].empty();
    while k > 0u32 {
      k = k - 1u32;
      digits.push(u8.from(97u32 + k % 26u32));
      k = k / 26u32;
    }
    var i = digits.len();
    while i > 0usize {
      i = i - 1usize;
      s.appendByte(*digits[i]);
    }
  } else {
    // roman, lower case
    var k = n;
    let vals = [1000u32, 900u32, 500u32, 400u32, 100u32, 90u32, 50u32, 40u32, 10u32, 9u32, 5u32, 4u32, 1u32];
    let names = ["m", "cm", "d", "cd", "c", "xc", "l", "xl", "x", "ix", "v", "iv", "i"];
    var i = 0usize;
    while i < 13usize {
      while k >= vals[i] {
        s.append(names[i]);
        k = k - vals[i];
      }
      i = i + 1usize;
    }
  }
  s.append(".");
  s
}

fn headingScale(kind: u32) f32 {
  if kind == BK_H1 { return 2.0; }
  if kind == BK_H2 { return 1.55; }
  if kind == BK_H3 { return 1.25; }
  1.0
}

// The numbering state after a block, and the number a numbered block takes
fn stepCounters(b: &mut Builder, blk: &Block) u32 {
  var number = 0u32;
  if blk.kind == BK_NUMBER {
    while b.counters.len() <= usize.from(blk.depth) { b.counters.push(0u32); }
    b.counters.set(usize.from(blk.depth), *b.counters[usize.from(blk.depth)] + 1u32);
    number = *b.counters[usize.from(blk.depth)];
    // deeper levels start again
    var d = usize.from(blk.depth) + 1usize;
    while d < b.counters.len() { b.counters.set(d, 0u32); d = d + 1usize; }
  } elif blk.kind == BK_BULLET {
    var d = usize.from(blk.depth) + 1usize;
    while d < b.counters.len() { b.counters.set(d, 0u32); d = d + 1usize; }
  } else {
    b.counters.clear();
  }
  number
}

fn at(l: &List[u32], i: usize, total: usize) usize { if i < l.len() { usize.from(*l[i]) } else { total } }

fn shiftU(x: u32, d: i64) u32 { u32.from(i64.from(x) + d) }

// The blocks before 'n' are as in 'p': take their lines, glyphs and the rest, and the state the layout was in
fn copyPrefix(b: &mut Builder, p: &RichLayout, n: usize) {
  let nl = at(&p.blockLine, n, p.lines.len());
  let ng = at(&p.blockGlyph, n, p.glyphs.len());
  let nb = at(&p.blockBox, n, p.boxes.len());
  let nr = at(&p.blockRect, n, p.rects.len());
  let nm = at(&p.blockMarker, n, p.markers.len());
  let nf = at(&p.blockFloat, n, p.floats.len());
  var k = 0usize;
  while k < ng { b.out.glyphs.push(*p.glyphs[k]); k = k + 1usize; }
  k = 0usize;
  while k < nl { b.out.lines.push(*p.lines[k]); k = k + 1usize; }
  k = 0usize;
  while k < nb { b.out.boxes.push(*p.boxes[k]); k = k + 1usize; }
  k = 0usize;
  while k < nr { b.out.rects.push(*p.rects[k]); k = k + 1usize; }
  k = 0usize;
  while k < nm { b.out.markers.push(*p.markers[k]); k = k + 1usize; }
  k = 0usize;
  while k < nf { b.floats.push(*p.floats[k]); k = k + 1usize; }
  k = 0usize;
  while k < n {
    b.out.blockLine.push(*p.blockLine[k]);
    b.out.blockGlyph.push(*p.blockGlyph[k]);
    b.out.blockBox.push(*p.blockBox[k]);
    b.out.blockRect.push(*p.blockRect[k]);
    b.out.blockMarker.push(*p.blockMarker[k]);
    b.out.blockFloat.push(*p.blockFloat[k]);
    b.out.blockY.push(*p.blockY[k]);
    k = k + 1usize;
  }
  b.y = if n < p.blockY.len() { *p.blockY[n] } else { p.endY };
}

// Whether blocks from old index 'oldIdx' on can be moved down by the difference in y: no float of either layout reaches
// down to where they start, so nothing before them can touch them
fn canSplice(b: &Builder, p: &RichLayout, oldIdx: usize) bool {
  var k = 0usize;
  while k < b.floats.len() {
    if (*b.floats[k]).y1 > b.y { return false; }
    k = k + 1usize;
  }
  let nf = at(&p.blockFloat, oldIdx, p.floats.len());
  let oy = *p.blockY[oldIdx];
  k = 0usize;
  while k < nf {
    if (*p.floats[k]).y1 > oy { return false; }
    k = k + 1usize;
  }
  true
}

// Take blocks oldIdx.. of 'p' as blocks bi.. of the layout being built, moved by the difference in y
fn spliceTail(b: &mut Builder, p: &RichLayout, oldIdx: usize, bi: usize) {
  let dy = b.y - *p.blockY[oldIdx];
  let dBlock = i64.from(bi) - i64.from(oldIdx);
  let l0 = at(&p.blockLine, oldIdx, p.lines.len());
  let g0 = at(&p.blockGlyph, oldIdx, p.glyphs.len());
  let b0 = at(&p.blockBox, oldIdx, p.boxes.len());
  let r0 = at(&p.blockRect, oldIdx, p.rects.len());
  let m0 = at(&p.blockMarker, oldIdx, p.markers.len());
  let f0 = at(&p.blockFloat, oldIdx, p.floats.len());
  let lShift = i64.from(b.out.lines.len()) - i64.from(l0);
  let gShift = i64.from(b.out.glyphs.len()) - i64.from(g0);
  let bShift = i64.from(b.out.boxes.len()) - i64.from(b0);
  let rShift = i64.from(b.out.rects.len()) - i64.from(r0);
  let mShift = i64.from(b.out.markers.len()) - i64.from(m0);
  let fShift = i64.from(b.floats.len()) - i64.from(f0);
  var k = g0;
  while k < p.glyphs.len() {
    var g = *p.glyphs[k];
    g.y = g.y + dy;
    g.block = shiftU(g.block, dBlock);
    b.out.glyphs.push(g);
    k = k + 1usize;
  }
  k = l0;
  while k < p.lines.len() {
    var ln = *p.lines[k];
    ln.top = ln.top + dy;
    ln.baseline = ln.baseline + dy;
    ln.block = shiftU(ln.block, dBlock);
    ln.g0 = shiftU(ln.g0, gShift);
    b.out.lines.push(ln);
    k = k + 1usize;
  }
  k = b0;
  while k < p.boxes.len() {
    var bx = *p.boxes[k];
    bx.y = bx.y + dy;
    bx.block = shiftU(bx.block, dBlock);
    b.out.boxes.push(bx);
    k = k + 1usize;
  }
  k = r0;
  while k < p.rects.len() {
    var r = *p.rects[k];
    r.y = r.y + dy;
    b.out.rects.push(r);
    k = k + 1usize;
  }
  k = m0;
  while k < p.markers.len() {
    var m = *p.markers[k];
    m.y = m.y + dy;
    m.block = shiftU(m.block, dBlock);
    b.out.markers.push(m);
    k = k + 1usize;
  }
  k = f0;
  while k < p.floats.len() {
    var f = *p.floats[k];
    f.y0 = f.y0 + dy;
    f.y1 = f.y1 + dy;
    b.floats.push(f);
    k = k + 1usize;
  }
  k = oldIdx;
  while k < p.blockLine.len() {
    b.out.blockLine.push(shiftU(*p.blockLine[k], lShift));
    b.out.blockGlyph.push(shiftU(*p.blockGlyph[k], gShift));
    b.out.blockBox.push(shiftU(*p.blockBox[k], bShift));
    b.out.blockRect.push(shiftU(*p.blockRect[k], rShift));
    b.out.blockMarker.push(shiftU(*p.blockMarker[k], mShift));
    b.out.blockFloat.push(shiftU(*p.blockFloat[k], fShift));
    b.out.blockY.push(*p.blockY[k] + dy);
    k = k + 1usize;
  }
  b.y = p.endY + dy;
  b.out.reused = b.out.reused + u32.from(p.blockLine.len() - oldIdx);
}

pub fn layoutRich(blocks: &List[Block], images: &List[ImageInfo], faces: &Faces, cfg: &LayoutConfig) RichLayout {
  let none = emptyLayout(cfg.width);
  layoutRichFrom(blocks, images, faces, cfg, &none, 0usize, blocks.len(), 0usize, false)
}

// The layout of the document after an edit that replaced blocks lo..hi (counted now) which were lo..oldHi in
// 'prev', the layout before the edit, made with the same fonts and configuration. The blocks before lo are taken from
// 'prev' as they are. The blocks from hi on are taken too, moved by the change in y, from the first one where that is
// safe: a block that is not in a list (so numbering does not carry in), with no float from either layout reaching
// down to it (so nothing above can wrap around into it). A list continues to be laid out until such a block is
// reached; a float reaching far down makes the layout go on. The result is the same as 'layoutRich''s (the test
// compares them field by field).
pub fn layoutRichFrom(blocks: &List[Block], images: &List[ImageInfo], faces: &Faces, cfg: &LayoutConfig, prev: &RichLayout, lo: usize,
    hi: usize, oldHi: usize, usePrev: bool) RichLayout {
  var b = Builder(emptyLayout(cfg.width), List[FloatBox].empty(), cfg.marginTop, List[u32].empty());
  let left = cfg.margin;
  let right = cfg.width - cfg.margin;
  var bi = 0usize;
  let prevBlocks = prev.blockLine.len();
  if usePrev && lo > 0usize && lo <= prevBlocks && lo <= blocks.len() {
    copyPrefix(&mut b, prev, lo);
    var k = 0usize;
    while k < lo { stepCounters(&mut b, blocks[k]); k = k + 1usize; }
    bi = lo;
    b.out.reused = u32.from(lo);
  }
  if usePrev {
    // the lists will be about as long as the previous ones: no growing by doubling
    b.out.glyphs.reserve(prev.glyphs.len() + 256usize);
    b.out.lines.reserve(prev.lines.len() + 16usize);
    b.out.boxes.reserve(prev.boxes.len() + 4usize);
    b.out.rects.reserve(prev.rects.len() + 8usize);
    b.out.markers.reserve(prev.markers.len() + 8usize);
    b.out.blockLine.reserve(prev.blockLine.len() + 4usize);
    b.out.blockGlyph.reserve(prev.blockLine.len() + 4usize);
    b.out.blockBox.reserve(prev.blockLine.len() + 4usize);
    b.out.blockRect.reserve(prev.blockLine.len() + 4usize);
    b.out.blockMarker.reserve(prev.blockLine.len() + 4usize);
    b.out.blockFloat.reserve(prev.blockLine.len() + 4usize);
    b.out.blockY.reserve(prev.blockLine.len() + 4usize);
  }
  var spliced = false;
  while bi < blocks.len() {
    let blk = blocks[bi];
    if usePrev && bi >= hi {
      let oldIdx = bi - hi + oldHi;
      if oldIdx < prevBlocks && !blk.isList() && canSplice(&b, prev, oldIdx) {
        spliceTail(&mut b, prev, oldIdx, bi);
        spliced = true;
        break;
      }
    }
    b.out.blockLine.push(u32.from(b.out.lines.len()));
    b.out.blockGlyph.push(u32.from(b.out.glyphs.len()));
    b.out.blockBox.push(u32.from(b.out.boxes.len()));
    b.out.blockRect.push(u32.from(b.out.rects.len()));
    b.out.blockMarker.push(u32.from(b.out.markers.len()));
    b.out.blockFloat.push(u32.from(b.floats.len()));
    b.out.blockY.push(b.y);
    let number = stepCounters(&mut b, blk);
    layoutBlock(&mut b, bi, blk, number, images, faces, cfg, left, right);
    bi = bi + 1usize;
  }
  b.out.endY = b.y;
  // the page ends below the lowest float too
  var bottom = b.y;
  var f = 0usize;
  while f < b.floats.len() {
    let fl = b.floats[f];
    if fl.y1 > bottom { bottom = fl.y1; }
    f = f + 1usize;
  }
  b.out.height = bottom + cfg.marginTop;
  b.out.floats <=> b.floats;
  var result = emptyLayout(cfg.width);
  result <=> b.out;
  result
}

fn layoutBlock(bd: &mut Builder, bi: usize, blk: &Block, number: u32, images: &List[ImageInfo], faces: &Faces, cfg: &LayoutConfig,
    pageLeft: f32, pageRight: f32) {
  let heading = blk.isHeading();
  let scale = headingScale(blk.kind);
  let bodySize = cfg.baseSize * scale;
  let indent = if blk.isList() { cfg.listIndent * f32.from(blk.depth + 1u32) } else { 0.0 };
  let left = pageLeft + indent;
  let right = pageRight;
  let text = blk.text.view();
  // space before: headings take more
  if bi > 0usize {
    bd.y = bd.y + cfg.baseSize * (if heading { cfg.paraGap + 0.45 * scale } else { cfg.paraGap });
  }
  // ---- the items ----
  var items = List[Item].empty();
  var nominalAsc = 0.0f;
  var nominalDesc = 0.0f;
  var at = 0usize;
  var ri = 0usize;
  var prevFace = 0xFFFFFFFFu32;
  var prevGlyph = 0u32;
  while ri < blk.runs.len() {
    let run = *blk.runs[ri];
    let st = run.style;
    let size = if st.size > 0.0 { st.size } else { bodySize };
    let bold = st.bold || heading;
    let face = faces.pick(bold, st.italic);
    let font = faces.font(face);
    let k = size / f32.from(font.unitsPerEm);
    let asc = f32.from(font.ascent) * k;
    let desc = -f32.from(font.descent) * k;
    let gap = f32.from(font.lineGap) * k;
    if asc > nominalAsc { nominalAsc = asc; }
    if desc + gap > nominalDesc { nominalDesc = desc + gap; }
    var color = if st.color != 0u32 { st.color } elif st.link != 0u32 { cfg.linkColor } else { cfg.textColor };
    var flags = 0u32;
    if st.underline || st.link != 0u32 { flags = flags | GF_UNDERLINE; }
    if st.link != 0u32 { flags = flags | GF_LINK; }
    let end = at + run.len;
    var o = at;
    while o < end {
      var clen = 1usize;
      let cp = decodeAt(text, o, &mut clen);
      if st.image != 0u32 {
        let info = images[usize.from(st.image - 1u32)];
        let floating = info.place != PL_INLINE;
        items.push(Item(u32.from(o), u32.from(clen), if floating { 3u32 } else { 2u32 }, if floating { 0.0 } else { info.w },
          0.0, size, face, 0u32, color, flags, if floating { 0.0 } else { info.h }, 0.0, st.image, false));
        prevFace = 0xFFFFFFFFu32;
      } else {
        let g = font.glyphOf(if cp == 9u32 { 32u32 } else { cp });
        var adv = f32.from(font.advance(g)) * k;
        if cp == 9u32 { adv = adv * 4.0; }
        var kern = 0.0f;
        if prevFace == face { kern = f32.from(font.kerning(prevGlyph, g)) * k; }
        let isSpace = cp == 32u32 || cp == 9u32 || cp == 0xA0u32;
        items.push(Item(u32.from(o), u32.from(clen), if isSpace { 1u32 } else { 0u32 }, adv, kern, size, face, g, color,
          if isSpace { flags | GF_SPACE } else { flags }, asc, desc + gap, 0u32, cp == 45u32));
        prevFace = face;
        prevGlyph = g;
      }
      items[items.len() - 1usize].link = st.link;
      o = o + clen;
    }
    at = end;
    ri = ri + 1usize;
  }
  if nominalAsc == 0.0 {
    // an empty block: the line is as tall as the body font says
    let font = faces.font(faces.pick(heading, false));
    let k = bodySize / f32.from(font.unitsPerEm);
    nominalAsc = f32.from(font.ascent) * k;
    nominalDesc = -f32.from(font.descent) * k + f32.from(font.lineGap) * k;
  }
  let lineH = (nominalAsc + nominalDesc) * cfg.lineHeight;
  // ---- hoist the floats ----
  let firstTop = bd.y;
  var i = 0usize;
  while i < items.len() {
    let it = *items[i];
    if it.kind == 3u32 {
      let info = images[usize.from(it.img - 1u32)];
      let onLeft = info.place == PL_LEFT;
      var y0 = firstTop;
      var moved = true;
      while moved {
        moved = false;
        var f = 0usize;
        while f < bd.floats.len() {
          let fl = bd.floats[f];
          let sameSide = (fl.x0 + fl.x1) * 0.5 < (pageLeft + pageRight) * 0.5;
          if sameSide == onLeft && fl.y0 < y0 + info.h && fl.y1 > y0 && y0 < fl.y1 {
            y0 = fl.y1;
            moved = true;
          }
          f = f + 1usize;
        }
      }
      let x = if onLeft { pageLeft } else { pageRight - info.w };
      bd.out.boxes.push(BoxP(x, y0, info.w, info.h, it.img, u32.from(bi), it.off, true));
      bd.floats.push(FloatBox(x - (if onLeft { 0.0 } else { cfg.floatGap }), x + info.w + (if onLeft { cfg.floatGap } else { 0.0 }),
        y0, y0 + info.h + cfg.floatGap * 0.5));
    }
    i = i + 1usize;
  }
  // ---- the marker ----
  var markerPlaced = false;
  // ---- break into lines ----
  let n = items.len();
  var start = 0usize;
  var lineNo = 0u32;
  while start < n || (n == 0usize && lineNo == 0u32) {
    // the band
    var xl = left;
    var xr = right;
    bd.span(bd.y, lineH, left, right, &mut xl, &mut xr);
    // too narrow for a word: go down past the float
    var tries = 0u32;
    while xr - xl < cfg.baseSize * 3.0 && tries < 32u32 {
      let nb = bd.floatBottom(bd.y, lineH);
      if nb <= bd.y { break; }
      bd.y = nb;
      bd.span(bd.y, lineH, left, right, &mut xl, &mut xr);
      tries = tries + 1u32;
    }
    let avail = xr - xl;
    // fill
    var j = start;
    var w = 0.0;
    var lastBreak = start;
    var hasBreak = false;
    while j < n {
      let it = *items[j];
      if it.kind == 3u32 { j = j + 1usize; continue; }
      let gap = if j == start { 0.0 } else { it.kern };
      if w + gap + it.adv > avail && it.kind != 1u32 && j > start {
        if hasBreak { j = lastBreak; }
        break;
      }
      w = w + gap + it.adv;
      if it.kind == 1u32 { lastBreak = j + 1usize; hasBreak = true; }
      elif it.hyphen && j + 1usize < n && (*items[j + 1usize]).kind == 0u32 && j > start { lastBreak = j + 1usize; hasBreak = true; }
      elif it.kind == 2u32 { lastBreak = j + 1usize; hasBreak = true; }
      j = j + 1usize;
    }
    // a line of [start, j); trailing spaces hang
    var e = j;
    while e > start && ((*items[e - 1usize]).kind == 1u32 || (*items[e - 1usize]).kind == 3u32) { e = e - 1usize; }
    // ink width and the tallest thing on the line
    var inkW = 0.0f;
    var asc = nominalAsc;
    var desc = nominalDesc;
    var spaces = 0u32;
    var m = start;
    while m < e {
      let it = *items[m];
      let gap = if m == start { 0.0 } else { it.kern };
      inkW = inkW + gap + it.adv;
      if it.kind == 1u32 { spaces = spaces + 1u32; }
      if it.kind == 2u32 && it.asc > asc { asc = it.asc; }
      m = m + 1usize;
    }
    let isLast = j >= n;
    let thisH = (asc + desc) * cfg.lineHeight;
    let lead = (thisH - (asc + desc)) * 0.5;
    let baseline = bd.y + lead + asc;
    // alignment
    var align = blk.align;
    if align == AL_LEFT { align = cfg.align; }
    var x = xl;
    var extra = 0.0f;
    if align == AL_CENTER { x = xl + (avail - inkW) * 0.5; }
    elif align == AL_RIGHT { x = xr - inkW; }
    elif align == AL_JUSTIFY && !isLast && spaces > 0u32 && avail > inkW { extra = (avail - inkW) / f32.from(spaces); }
    // the marker, once, beside the first line
    if !markerPlaced && blk.isList() {
      markerPlaced = true;
      let mtext = listMarker(blk.kind, blk.depth, number);
      let font = faces.font(faces.pick(false, false));
      let size = cfg.baseSize;
      let kk = size / f32.from(font.unitsPerEm);
      var mw = 0.0f;
      var mo = 0usize;
      var mstart = List[GlyphP].empty();
      while mo < mtext.len() {
        var clen = 1usize;
        let cp = decodeAt(mtext.view(), mo, &mut clen);
        let g = font.glyphOf(cp);
        let adv = f32.from(font.advance(g)) * kk;
        mstart.push(GlyphP(mw, baseline, adv, size, faces.pick(false, false), g, cfg.textColor, 0u32, u32.from(bi), 0u32, u32.from(clen)));
        mw = mw + adv;
        mo = mo + clen;
      }
      // right-aligned just left of the text
      let mx = left - cfg.listIndent * 0.25 - mw;
      var q = 0usize;
      while q < mstart.len() {
        var gp = *mstart[q];
        gp.x = gp.x + mx;
        bd.out.markers.push(gp);
        q = q + 1usize;
      }
    }
    // glyphs
    let g0 = bd.out.glyphs.len();
    var pen = x;
    var p = start;
    var ulStart = -1.0f;
    var ulColor = 0u32;
    var ulSize = 0.0f;
    while p < j {
      let it = *items[p];
      if p > start { pen = pen + it.kern; }
      var adv = it.adv;
      if it.kind == 1u32 && p < e { adv = adv + extra; }
      bd.out.glyphs.push(GlyphP(pen, baseline, adv, it.size, it.face, it.glyph, it.color, if it.kind == 2u32 || it.kind == 3u32 { it.flags | GF_OBJECT } else { it.flags },
        u32.from(bi), it.off, it.len));
      bd.out.glyphs[bd.out.glyphs.len() - 1usize].link = it.link;
      if it.kind == 2u32 {
        bd.out.boxes.push(BoxP(pen, baseline - it.asc, it.adv, it.asc, it.img, u32.from(bi), it.off, false));
      }
      // underline runs (not under hanging spaces)
      let underlined = (it.flags & GF_UNDERLINE) != 0u32 && p < e && it.kind != 2u32 && it.kind != 3u32;
      if underlined {
        if ulStart < 0.0 { ulStart = pen; ulColor = it.color; ulSize = it.size; }
        elif ulColor != it.color {
          bd.out.rects.push(RectP(ulStart, baseline + ulSize * 0.12, pen - ulStart, maxf(1.0, ulSize / 16.0), ulColor, RK_UNDERLINE));
          ulStart = pen;
          ulColor = it.color;
          ulSize = it.size;
        }
      } elif ulStart >= 0.0 {
        bd.out.rects.push(RectP(ulStart, baseline + ulSize * 0.12, pen - ulStart, maxf(1.0, ulSize / 16.0), ulColor, RK_UNDERLINE));
        ulStart = -1.0;
      }
      pen = pen + adv;
      p = p + 1usize;
    }
    if ulStart >= 0.0 {
      // the underline ends at the end of the last underlined glyph, not at the hanging spaces
      var endX = pen;
      if e < j { endX = (*bd.out.glyphs[g0 + (e - start)]).x; }
      bd.out.rects.push(RectP(ulStart, baseline + ulSize * 0.12, endX - ulStart, maxf(1.0, ulSize / 16.0), ulColor, RK_UNDERLINE));
    }
    let startOff = if start < n { (*items[start]).off } else { u32.from(text.len()) };
    let endOff = if j < n { (*items[j]).off } else { u32.from(text.len()) };
    let inkEndOff = if e < n { (*items[e]).off } else { u32.from(text.len()) };
    // a line that ended only in float anchors is ink up to its end
    let gn = bd.out.glyphs.len() - g0;
    bd.out.lines.push(LineP(u32.from(bi), startOff, endOff, if e == j { endOff } else { inkEndOff }, bd.y, thisH, baseline, x, x + inkW + extra * f32.from(spaces),
      u32.from(g0), u32.from(gn), isLast));
    bd.y = bd.y + thisH;
    lineNo = lineNo + 1u32;
    if n == 0usize { break; }
    if j == start { j = start + 1usize; }
    start = j;
  }
}

// ---- asking the layout ----

// The index of the line a position is on: the first whose range holds the offset; the last line of a
// block also holds its end
pub fn lineOf(l: &RichLayout, p: Pos) usize {
  var i = usize.from(*l.blockLine[p.block]);
  while i < l.lines.len() {
    let ln = l.lines[i];
    if usize.from(ln.block) != p.block { break; }
    if p.off < usize.from(ln.end) || ln.last { return i; }
    i = i + 1usize;
  }
  if i > 0usize { i - 1usize } else { 0usize }
}

// The x of a position on its line
pub fn xOf(l: &RichLayout, line: usize, p: Pos) f32 {
  let ln = l.lines[line];
  var g = usize.from(ln.g0);
  let gEnd = g + usize.from(ln.gn);
  while g < gEnd {
    let gl = l.glyphs[g];
    if usize.from(gl.off) >= p.off { return gl.x; }
    g = g + 1usize;
  }
  ln.x1
}

// The caret rectangle: x, top, height
pub struct CaretRect {
  pub x: f32;
  pub y: f32;
  pub h: f32;
}

pub fn caretRect(l: &RichLayout, p: Pos) CaretRect {
  let li = lineOf(l, p);
  let ln = l.lines[li];
  CaretRect(xOf(l, li, p), ln.top, ln.height)
}

// The position nearest to a point
pub fn posAt(l: &RichLayout, x: f32, y: f32) Pos {
  if l.lines.len() == 0usize { return pos(0usize, 0usize); }
  // the line: the one holding y, else the nearest
  var best = 0usize;
  var bestD = 1000000.0;
  var i = 0usize;
  while i < l.lines.len() {
    let ln = l.lines[i];
    var d = 0.0;
    if y < ln.top { d = ln.top - y; } elif y > ln.top + ln.height { d = y - ln.top - ln.height; }
    if d < bestD { bestD = d; best = i; }
    i = i + 1usize;
  }
  posOnLine(l, best, x)
}

pub fn posOnLine(l: &RichLayout, line: usize, x: f32) Pos {
  let ln = l.lines[line];
  var g = usize.from(ln.g0);
  let gEnd = g + usize.from(ln.gn);
  while g < gEnd {
    let gl = l.glyphs[g];
    if x < gl.x + gl.adv * 0.5 || (usize.from(gl.off) >= usize.from(ln.inkEnd) && !ln.last) {
      if usize.from(gl.off) > usize.from(ln.inkEnd) { return pos(usize.from(ln.block), usize.from(ln.inkEnd)); }
      return pos(usize.from(ln.block), usize.from(gl.off));
    }
    g = g + 1usize;
  }
  if ln.last { pos(usize.from(ln.block), usize.from(ln.end)) } else { pos(usize.from(ln.block), usize.from(ln.inkEnd)) }
}

// The start and end of the line a position is on
pub fn lineStartPos(l: &RichLayout, p: Pos) Pos {
  let ln = l.lines[lineOf(l, p)];
  pos(usize.from(ln.block), usize.from(ln.start))
}

pub fn lineEndPos(l: &RichLayout, p: Pos) Pos {
  let ln = l.lines[lineOf(l, p)];
  pos(usize.from(ln.block), usize.from(if ln.last { ln.end } else { ln.inkEnd }))
}

// One line up (dir -1) or down (+1) keeping to x
pub fn moveLine(l: &RichLayout, p: Pos, dir: i32, x: f32) Pos {
  let li = lineOf(l, p);
  if dir < 0i32 {
    if li == 0usize { return pos(0usize, 0usize); }
    return posOnLine(l, li - 1usize, x);
  }
  if li + 1usize >= l.lines.len() {
    let ln = l.lines[li];
    return pos(usize.from(ln.block), usize.from(ln.end));
  }
  posOnLine(l, li + 1usize, x)
}

// Rectangles covering the selection lo..hi, one a line
pub fn selectionRects(l: &RichLayout, lo: Pos, hi: Pos) List[RectP] {
  var out = List[RectP].empty();
  if lo.same(&hi) { return out; }
  var i = lineOf(l, lo);
  let last = lineOf(l, hi);
  while i <= last && i < l.lines.len() {
    let ln = l.lines[i];
    let b = usize.from(ln.block);
    var xa = ln.x0;
    var xb = ln.x1;
    if b == lo.block && lo.off >= usize.from(ln.start) { xa = xOf(l, i, lo); }
    if b == hi.block && hi.off <= usize.from(ln.end) { xb = xOf(l, i, hi); }
    elif b < hi.block || (b == hi.block && ln.last) { xb = xb + 6.0; }
    if xb > xa { out.push(RectP(xa, ln.top, xb - xa, ln.height, 0u32, 1u32)); }
    i = i + 1usize;
  }
  out
}

// The image box (if any) under a point
pub fn boxAt(l: &RichLayout, x: f32, y: f32) i32 {
  var i = l.boxes.len();
  while i > 0usize {
    i = i - 1usize;
    let bx = l.boxes[i];
    if x >= bx.x && x < bx.x + bx.w && y >= bx.y && y < bx.y + bx.h { return i32.from(i); }
  }
  -1i32
}

// The link under a point: the number of the link whose glyph's box holds it, or 0
pub fn linkAt(l: &RichLayout, x: f32, y: f32) u32 {
  let p = posAt(l, x, y);
  let li = lineOf(l, p);
  let ln = l.lines[li];
  if y < ln.top || y > ln.top + ln.height { return 0u32; }
  var g = usize.from(ln.g0);
  let gEnd = g + usize.from(ln.gn);
  while g < gEnd {
    let gl = l.glyphs[g];
    if x >= gl.x && x < gl.x + gl.adv { return gl.link; }
    g = g + 1usize;
  }
  0u32
}
