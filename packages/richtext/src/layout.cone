// ======== Layout: blocks to lines, glyphs, boxes and rectangles ========
//
// METHOD: GREEDY FIRST-FIT line breaking (the line is filled with words until the next word does not
// fit, then broken at the last space, or at a hyphen, or inside the word if it alone is wider than the
// line), then justification by widening the spaces. This is what browsers and word processors do for
// their lines. Knuth and Plass's total-fit algorithm ("Breaking Paragraphs into Lines", 1981) makes
// the paragraph as a whole look better (fewer loose lines, no rivers), but its boxes-glue-penalties
// model wants the width of every line before the paragraph is laid out, and here a line's width depends
// on the floats beside it, which depend on the height of the lines above. The width per line could be
// given to it by an iteration; that is the extension, and the line breaker is one function.
//
// FLOATS. An image placed left or right is ANCHORED in its paragraph: the picture is put at the top of
// that paragraph (as Word does for a picture anchored to a paragraph) against the page margin, below any
// float already on that side that it would overlap, and every line whose band meets the picture is
// narrower by the picture and a gap. Lines of the following paragraphs wrap around it too, until its
// bottom. A band too narrow to hold a word is skipped past the float.
//
// FONTS. Bold and italic are faces (separate font files), chosen by the style: 'Faces' holds up to four
// and maps (bold, italic) to one. A missing face falls back to the regular one (no synthetic oblique:
// msdftext's quads cannot slant, and a synthetic bold would need the field to be widened).
//
// Layout depends on fonts and the document, never on the GPU or the atlas: the renderer asks the atlas
// for glyph quads when it draws. Positions are in pixels, x right, y DOWN, the page's top left being 0.

pub const GF_UNDERLINE = 1u32;
pub const GF_LINK = 2u32;
pub const GF_SPACE = 4u32;
pub const GF_OBJECT = 8u32;     // an image's anchor character: no glyph

pub struct Faces {
  pub fonts List[Font];
  pub slot0 u32 = 0u32;          // regular
  pub slot1 u32 = 0u32;          // bold
  pub slot2 u32 = 0u32;          // italic
  pub slot3 u32 = 0u32;          // bold italic
  pub hasBold bool = false;
  pub hasItalic bool = false;

  // A family of one font; add the others with 'setBold', 'setItalic', 'setBoldItalic'
  pub fn make(regular Font) Faces {
    mut f = new Faces(List[Font].empty());
    f.fonts.push(regular);
    f;
  }

  pub fn setBold(self &mut, font Font) { fonts.push(font); slot1 = u32.from(fonts.len() - 1usize); hasBold = true; }
  pub fn setItalic(self &mut, font Font) { fonts.push(font); slot2 = u32.from(fonts.len() - 1usize); hasItalic = true; }
  pub fn setBoldItalic(self &mut, font Font) {
    fonts.push(font);
    slot3 = u32.from(fonts.len() - 1usize);
  }

  // The face for a style: bold-italic falls back to bold, then italic, then regular
  pub fn pick(self &, bold bool, italic bool) u32 {
    if bold and italic {
      if slot3 != 0u32 { return slot3; }
      if slot1 != 0u32 { return slot1; }
      return slot2;
    }
    if bold { return slot1; }
    if italic { return slot2; }
    slot0;
  }

  pub fn font(self &, face u32) &Font { fonts[usize.from(face)]; }
  pub fn count(self &) usize { fonts.len(); }
}

pub struct LayoutConfig {
  pub width f32;                 // the page's width
  pub margin f32;                // left and right
  pub marginTop f32;
  pub baseSize f32;              // body text, pixels of em
  pub lineHeight f32;            // times the font's ascent + descent
  pub paraGap f32;               // between paragraphs, times baseSize
  pub listIndent f32;            // per list level
  pub floatGap f32;              // between a float and the text beside it
  pub textColor u32;             // 0xRRGGBBAA
  pub linkColor u32;
  pub align u32;                 // the default for a block whose align is AL_LEFT

  pub fn standard(width f32) LayoutConfig {
    new LayoutConfig(width, 40.0, 36.0, 18.0, 1.25, 0.55, 28.0, 14.0, 0x202124ffu32, 0x1a5fb4ffu32, AL_LEFT);
  }
}

// One character placed (a space, a letter, an anchor). 'x' is the pen, 'y' the baseline
pub struct GlyphP {
  pub x f32;
  pub y f32;
  pub adv f32;
  pub size f32;
  pub face u32;
  pub glyph u32;
  pub color u32;
  pub flags u32;
  pub block u32;
  pub off u32;                   // byte offset in the block's text
  pub len u32;                   // bytes of the character
}

pub struct LineP {
  pub block u32;
  pub start u32;                 // the bytes this line shows: start..end
  pub end u32;
  pub inkEnd u32;                // where trailing spaces begin
  pub top f32;
  pub height f32;
  pub baseline f32;
  pub x0 f32;                    // the content's left and right
  pub x1 f32;
  pub g0 u32;                    // its glyphs: g0..g0+gn
  pub gn u32;
  pub last bool;                 // the block's last line
}

// An image placed
pub struct BoxP {
  pub x f32;
  pub y f32;
  pub w f32;
  pub h f32;
  pub image u32;                 // number + 1
  pub block u32;
  pub off u32;
  pub floating bool;
}

pub const RK_UNDERLINE = 0u32;

pub struct RectP {
  pub x f32;
  pub y f32;
  pub w f32;
  pub h f32;
  pub color u32;
  pub kind u32;
}

pub struct RichLayout {
  pub glyphs List[GlyphP];
  pub markers List[GlyphP];      // list bullets and numbers
  pub lines List[LineP];
  pub boxes List[BoxP];
  pub rects List[RectP];         // underlines
  pub blockLine List[u32];       // the first line of each block
  pub width f32;
  pub height f32;
  pub lineBreaks u32 = 0u32;     // a count, for the tests
}

// ---- the builder ----

struct Item {
  off u32;
  len u32;
  kind u32;                      // 0 glyph, 1 space, 2 inline object, 3 float anchor
  adv f32;
  kern f32;                      // with the item before, same line
  size f32;
  face u32;
  glyph u32;
  color u32;
  flags u32;
  asc f32;
  desc f32;
  img u32;                       // number + 1
  hyphen bool;
}

struct FloatBox {
  x0 f32;
  x1 f32;
  y0 f32;
  y1 f32;
}

fn maxf(a f32, b f32) f32 { if a > b { a; } else { b; }; }

fn decodeAt(t &str, off usize, len &mut usize) u32 {
  imm b = u32.from(t[off]);
  if b < 0x80u32 { *len = 1usize; return b; }
  if b >= 0xC2u32 and b < 0xE0u32 and off + 1usize < t.len() {
    *len = 2usize;
    return ((b & 0x1Fu32) << 6u32) | (u32.from(t[off + 1usize]) & 0x3Fu32);
  }
  if b >= 0xE0u32 and b < 0xF0u32 and off + 2usize < t.len() {
    *len = 3usize;
    return ((b & 0x0Fu32) << 12u32) | ((u32.from(t[off + 1usize]) & 0x3Fu32) << 6u32) | (u32.from(t[off + 2usize]) & 0x3Fu32);
  }
  if b >= 0xF0u32 and b < 0xF5u32 and off + 3usize < t.len() {
    *len = 4usize;
    return ((b & 0x07u32) << 18u32) | ((u32.from(t[off + 1usize]) & 0x3Fu32) << 12u32)
      | ((u32.from(t[off + 2usize]) & 0x3Fu32) << 6u32) | (u32.from(t[off + 3usize]) & 0x3Fu32);
  }
  *len = 1usize;
  0xFFFDu32;
}

struct Builder {
  out RichLayout;
  floats List[FloatBox];
  y f32;                         // the next block's top
  counters List[u32];            // numbering per depth
  counterKinds List[u32];

  fn floatBottom(self &, y f32, h f32) f32 {
    // the lowest bottom edge among floats that meet the band y..y+h
    mut best = y;
    mut i = 0usize;
    while i < floats.len() {
      imm f = floats[i];
      if f.y0 < y + h and f.y1 > y and f.y1 > best { best = f.y1; }
      i = i + 1usize;
    }
    best;
  }

  // The free span of the band y..y+h between left and right
  fn span(self &, y f32, h f32, left f32, right f32, outL &mut f32, outR &mut f32) {
    mut xl = left;
    mut xr = right;
    mut i = 0usize;
    while i < floats.len() {
      imm f = floats[i];
      if f.y0 < y + h and f.y1 > y {
        // a float in the left half pushes the left edge, one in the right half the right
        if (f.x0 + f.x1) * 0.5 < (left + right) * 0.5 { if f.x1 > xl { xl = f.x1; } }
        else { if f.x0 < xr { xr = f.x0; } }
      }
      i = i + 1usize;
    }
    *outL = xl;
    *outR = xr;
  }
}

fn listMarker(kind u32, depth u32, n u32) String {
  mut s = String.empty();
  if kind == BK_BULLET {
    // U+2022, U+25E6, U+25AA
    imm d = depth % 3u32;
    if d == 0u32 { s.appendByte(0xE2u8); s.appendByte(0x80u8); s.appendByte(0xA2u8); }
    elif d == 1u32 { s.appendByte(0xE2u8); s.appendByte(0x97u8); s.appendByte(0xA6u8); }
    else { s.appendByte(0xE2u8); s.appendByte(0x96u8); s.appendByte(0xAAu8); }
    return s;
  }
  imm d = depth % 3u32;
  if d == 0u32 { s.appendUInt(u64.from(n)); }
  elif d == 1u32 {
    // a, b, c ... z, aa, ab ...
    mut k = n;
    mut digits = List[u8].empty();
    while k > 0u32 {
      k = k - 1u32;
      digits.push(u8.from(97u32 + k % 26u32));
      k = k / 26u32;
    }
    mut i = digits.len();
    while i > 0usize {
      i = i - 1usize;
      s.appendByte(*digits[i]);
    }
  } else {
    // roman, lower case
    mut k = n;
    imm vals = [1000u32, 900u32, 500u32, 400u32, 100u32, 90u32, 50u32, 40u32, 10u32, 9u32, 5u32, 4u32, 1u32];
    imm names = ["m", "cm", "d", "cd", "c", "xc", "l", "xl", "x", "ix", "v", "iv", "i"];
    mut i = 0usize;
    while i < 13usize {
      while k >= vals[i] {
        s.append(names[i]);
        k = k - vals[i];
      }
      i = i + 1usize;
    }
  }
  s.append(".");
  s;
}

fn headingScale(kind u32) f32 {
  if kind == BK_H1 { return 2.0; }
  if kind == BK_H2 { return 1.55; }
  if kind == BK_H3 { return 1.25; }
  1.0;
}

pub fn layoutRich(blocks &List[Block], images &List[ImageInfo], faces &Faces, cfg &LayoutConfig) RichLayout {
  mut b = new Builder(new RichLayout(List[GlyphP].empty(), List[GlyphP].empty(), List[LineP].empty(), List[BoxP].empty(),
    List[RectP].empty(), List[u32].empty(), cfg.width, 0.0), List[FloatBox].empty(), cfg.marginTop, List[u32].empty(),
    List[u32].empty());
  imm left = cfg.margin;
  imm right = cfg.width - cfg.margin;
  mut bi = 0usize;
  while bi < blocks.len() {
    imm blk = blocks[bi];
    b.out.blockLine.push(u32.from(b.out.lines.len()));
    // numbering
    mut number = 0u32;
    if blk.kind == BK_NUMBER {
      while b.counters.len() <= usize.from(blk.depth) { b.counters.push(0u32); b.counterKinds.push(0u32); }
      b.counters.set(usize.from(blk.depth), *b.counters[usize.from(blk.depth)] + 1u32);
      b.counterKinds.set(usize.from(blk.depth), BK_NUMBER);
      number = *b.counters[usize.from(blk.depth)];
      // deeper levels start again
      mut d = usize.from(blk.depth) + 1usize;
      while d < b.counters.len() { b.counters.set(d, 0u32); d = d + 1usize; }
    } elif blk.kind == BK_BULLET {
      mut d = usize.from(blk.depth) + 1usize;
      while d < b.counters.len() { b.counters.set(d, 0u32); d = d + 1usize; }
    } else {
      b.counters.clear();
      b.counterKinds.clear();
    }
    layoutBlock(&mut b, bi, blk, number, images, faces, cfg, left, right);
    bi = bi + 1usize;
  }
  // the page ends below the lowest float too
  mut bottom = b.y;
  mut f = 0usize;
  while f < b.floats.len() {
    imm fl = b.floats[f];
    if fl.y1 > bottom { bottom = fl.y1; }
    f = f + 1usize;
  }
  b.out.height = bottom + cfg.marginTop;
  mut result = new RichLayout(List[GlyphP].empty(), List[GlyphP].empty(), List[LineP].empty(), List[BoxP].empty(),
    List[RectP].empty(), List[u32].empty(), cfg.width, 0.0);
  result <=> b.out;
  result;
}

fn layoutBlock(bd &mut Builder, bi usize, blk &Block, number u32, images &List[ImageInfo], faces &Faces, cfg &LayoutConfig,
    pageLeft f32, pageRight f32) {
  imm heading = blk.isHeading();
  imm scale = headingScale(blk.kind);
  imm bodySize = cfg.baseSize * scale;
  imm indent = if blk.isList() { cfg.listIndent * f32.from(blk.depth + 1u32); } else { 0.0; };
  imm left = pageLeft + indent;
  imm right = pageRight;
  imm text = blk.text.view();
  // space before: headings take more
  if bi > 0usize {
    bd.y = bd.y + cfg.baseSize * (if heading { cfg.paraGap + 0.45 * scale; } else { cfg.paraGap; });
  }
  // ---- the items ----
  mut items = List[Item].empty();
  mut nominalAsc = 0.0;
  mut nominalDesc = 0.0;
  mut at = 0usize;
  mut ri = 0usize;
  mut prevFace = 0xFFFFFFFFu32;
  mut prevGlyph = 0u32;
  while ri < blk.runs.len() {
    imm run = *blk.runs[ri];
    imm st = run.style;
    imm size = if st.size > 0.0 { st.size; } else { bodySize; };
    imm bold = st.bold or heading;
    imm face = faces.pick(bold, st.italic);
    imm font = faces.font(face);
    imm k = size / f32.from(font.unitsPerEm);
    imm asc = f32.from(font.ascent) * k;
    imm desc = -f32.from(font.descent) * k;
    imm gap = f32.from(font.lineGap) * k;
    if asc > nominalAsc { nominalAsc = asc; }
    if desc + gap > nominalDesc { nominalDesc = desc + gap; }
    mut color = if st.color != 0u32 { st.color; } elif st.link != 0u32 { cfg.linkColor; } else { cfg.textColor; };
    mut flags = 0u32;
    if st.underline or st.link != 0u32 { flags = flags | GF_UNDERLINE; }
    if st.link != 0u32 { flags = flags | GF_LINK; }
    imm end = at + run.len;
    mut o = at;
    while o < end {
      mut clen = 1usize;
      imm cp = decodeAt(text, o, &mut clen);
      if st.image != 0u32 {
        imm info = images[usize.from(st.image - 1u32)];
        imm floating = info.place != PL_INLINE;
        items.push(new Item(u32.from(o), u32.from(clen), if floating { 3u32; } else { 2u32; }, if floating { 0.0; } else { info.w; },
          0.0, size, face, 0u32, color, flags, if floating { 0.0; } else { info.h; }, 0.0, st.image, false));
        prevFace = 0xFFFFFFFFu32;
      } else {
        imm g = font.glyphOf(if cp == 9u32 { 32u32; } else { cp; });
        mut adv = f32.from(font.advance(g)) * k;
        if cp == 9u32 { adv = adv * 4.0; }
        mut kern = 0.0;
        if prevFace == face { kern = f32.from(font.kerning(prevGlyph, g)) * k; }
        imm isSpace = cp == 32u32 or cp == 9u32 or cp == 0xA0u32;
        items.push(new Item(u32.from(o), u32.from(clen), if isSpace { 1u32; } else { 0u32; }, adv, kern, size, face, g, color,
          if isSpace { flags | GF_SPACE; } else { flags; }, asc, desc + gap, 0u32, cp == 45u32));
        prevFace = face;
        prevGlyph = g;
      }
      o = o + clen;
    }
    at = end;
    ri = ri + 1usize;
  }
  if nominalAsc == 0.0 {
    // an empty block: the line is as tall as the body font says
    imm font = faces.font(faces.pick(heading, false));
    imm k = bodySize / f32.from(font.unitsPerEm);
    nominalAsc = f32.from(font.ascent) * k;
    nominalDesc = -f32.from(font.descent) * k + f32.from(font.lineGap) * k;
  }
  imm lineH = (nominalAsc + nominalDesc) * cfg.lineHeight;
  // ---- hoist the floats ----
  imm firstTop = bd.y;
  mut i = 0usize;
  while i < items.len() {
    imm it = *items[i];
    if it.kind == 3u32 {
      imm info = images[usize.from(it.img - 1u32)];
      imm onLeft = info.place == PL_LEFT;
      mut y0 = firstTop;
      mut moved = true;
      while moved {
        moved = false;
        mut f = 0usize;
        while f < bd.floats.len() {
          imm fl = bd.floats[f];
          imm sameSide = (fl.x0 + fl.x1) * 0.5 < (pageLeft + pageRight) * 0.5;
          if sameSide == onLeft and fl.y0 < y0 + info.h and fl.y1 > y0 and y0 < fl.y1 {
            y0 = fl.y1;
            moved = true;
          }
          f = f + 1usize;
        }
      }
      imm x = if onLeft { pageLeft; } else { pageRight - info.w; };
      bd.out.boxes.push(new BoxP(x, y0, info.w, info.h, it.img, u32.from(bi), it.off, true));
      bd.floats.push(new FloatBox(x - (if onLeft { 0.0; } else { cfg.floatGap; }), x + info.w + (if onLeft { cfg.floatGap; } else { 0.0; }),
        y0, y0 + info.h + cfg.floatGap * 0.5));
    }
    i = i + 1usize;
  }
  // ---- the marker ----
  mut markerPlaced = false;
  // ---- break into lines ----
  imm n = items.len();
  mut start = 0usize;
  mut lineNo = 0u32;
  while start < n or (n == 0usize and lineNo == 0u32) {
    // the band
    mut xl = left;
    mut xr = right;
    bd.span(bd.y, lineH, left, right, &mut xl, &mut xr);
    // too narrow for a word: go down past the float
    mut tries = 0u32;
    while xr - xl < cfg.baseSize * 3.0 and tries < 32u32 {
      imm nb = bd.floatBottom(bd.y, lineH);
      if nb <= bd.y { break; }
      bd.y = nb;
      bd.span(bd.y, lineH, left, right, &mut xl, &mut xr);
      tries = tries + 1u32;
    }
    imm avail = xr - xl;
    // fill
    mut j = start;
    mut w = 0.0;
    mut lastBreak = start;
    mut hasBreak = false;
    while j < n {
      imm it = *items[j];
      if it.kind == 3u32 { j = j + 1usize; continue; }
      imm gap = if j == start { 0.0; } else { it.kern; };
      if w + gap + it.adv > avail and it.kind != 1u32 and j > start {
        if hasBreak { j = lastBreak; }
        break;
      }
      w = w + gap + it.adv;
      if it.kind == 1u32 { lastBreak = j + 1usize; hasBreak = true; }
      elif it.hyphen and j + 1usize < n and (*items[j + 1usize]).kind == 0u32 and j > start { lastBreak = j + 1usize; hasBreak = true; }
      elif it.kind == 2u32 { lastBreak = j + 1usize; hasBreak = true; }
      j = j + 1usize;
    }
    // a line of [start, j); trailing spaces hang
    mut e = j;
    while e > start and ((*items[e - 1usize]).kind == 1u32 or (*items[e - 1usize]).kind == 3u32) { e = e - 1usize; }
    // ink width and the tallest thing on the line
    mut inkW = 0.0;
    mut asc = nominalAsc;
    mut desc = nominalDesc;
    mut spaces = 0u32;
    mut m = start;
    while m < e {
      imm it = *items[m];
      imm gap = if m == start { 0.0; } else { it.kern; };
      inkW = inkW + gap + it.adv;
      if it.kind == 1u32 { spaces = spaces + 1u32; }
      if it.kind == 2u32 and it.asc > asc { asc = it.asc; }
      m = m + 1usize;
    }
    imm isLast = j >= n;
    imm thisH = (asc + desc) * cfg.lineHeight;
    imm lead = (thisH - (asc + desc)) * 0.5;
    imm baseline = bd.y + lead + asc;
    // alignment
    mut align = blk.align;
    if align == AL_LEFT { align = cfg.align; }
    mut x = xl;
    mut extra = 0.0;
    if align == AL_CENTER { x = xl + (avail - inkW) * 0.5; }
    elif align == AL_RIGHT { x = xr - inkW; }
    elif align == AL_JUSTIFY and !isLast and spaces > 0u32 and avail > inkW { extra = (avail - inkW) / f32.from(spaces); }
    // the marker, once, beside the first line
    if !markerPlaced and blk.isList() {
      markerPlaced = true;
      imm mtext = listMarker(blk.kind, blk.depth, number);
      imm font = faces.font(faces.pick(false, false));
      imm size = cfg.baseSize;
      imm kk = size / f32.from(font.unitsPerEm);
      mut mw = 0.0;
      mut mo = 0usize;
      mut mstart = List[GlyphP].empty();
      while mo < mtext.len() {
        mut clen = 1usize;
        imm cp = decodeAt(mtext.view(), mo, &mut clen);
        imm g = font.glyphOf(cp);
        imm adv = f32.from(font.advance(g)) * kk;
        mstart.push(new GlyphP(mw, baseline, adv, size, faces.pick(false, false), g, cfg.textColor, 0u32, u32.from(bi), 0u32, u32.from(clen)));
        mw = mw + adv;
        mo = mo + clen;
      }
      // right-aligned just left of the text
      imm mx = left - cfg.listIndent * 0.25 - mw;
      mut q = 0usize;
      while q < mstart.len() {
        mut gp = *mstart[q];
        gp.x = gp.x + mx;
        bd.out.markers.push(gp);
        q = q + 1usize;
      }
    }
    // glyphs
    imm g0 = bd.out.glyphs.len();
    mut pen = x;
    mut p = start;
    mut ulStart = -1.0;
    mut ulColor = 0u32;
    mut ulSize = 0.0;
    while p < j {
      imm it = *items[p];
      if p > start { pen = pen + it.kern; }
      mut adv = it.adv;
      if it.kind == 1u32 and p < e { adv = adv + extra; }
      bd.out.glyphs.push(new GlyphP(pen, baseline, adv, it.size, it.face, it.glyph, it.color, if it.kind == 2u32 or it.kind == 3u32 { it.flags | GF_OBJECT; } else { it.flags; },
        u32.from(bi), it.off, it.len));
      if it.kind == 2u32 {
        bd.out.boxes.push(new BoxP(pen, baseline - it.asc, it.adv, it.asc, it.img, u32.from(bi), it.off, false));
      }
      // underline runs (not under hanging spaces)
      imm underlined = (it.flags & GF_UNDERLINE) != 0u32 and p < e and it.kind != 2u32 and it.kind != 3u32;
      if underlined {
        if ulStart < 0.0 { ulStart = pen; ulColor = it.color; ulSize = it.size; }
        elif ulColor != it.color {
          bd.out.rects.push(new RectP(ulStart, baseline + ulSize * 0.12, pen - ulStart, maxf(1.0, ulSize / 16.0), ulColor, RK_UNDERLINE));
          ulStart = pen;
          ulColor = it.color;
          ulSize = it.size;
        }
      } elif ulStart >= 0.0 {
        bd.out.rects.push(new RectP(ulStart, baseline + ulSize * 0.12, pen - ulStart, maxf(1.0, ulSize / 16.0), ulColor, RK_UNDERLINE));
        ulStart = -1.0;
      }
      pen = pen + adv;
      p = p + 1usize;
    }
    if ulStart >= 0.0 {
      // the underline ends at the end of the last underlined glyph, not at the hanging spaces
      mut endX = pen;
      if e < j { endX = (*bd.out.glyphs[g0 + (e - start)]).x; }
      bd.out.rects.push(new RectP(ulStart, baseline + ulSize * 0.12, endX - ulStart, maxf(1.0, ulSize / 16.0), ulColor, RK_UNDERLINE));
    }
    imm startOff = if start < n { (*items[start]).off; } else { u32.from(text.len()); };
    imm endOff = if j < n { (*items[j]).off; } else { u32.from(text.len()); };
    imm inkEndOff = if e < n { (*items[e]).off; } else { u32.from(text.len()); };
    // a line that ended only in float anchors is ink up to its end
    imm gn = bd.out.glyphs.len() - g0;
    bd.out.lines.push(new LineP(u32.from(bi), startOff, endOff, if e == j { endOff; } else { inkEndOff; }, bd.y, thisH, baseline, x, x + inkW + extra * f32.from(spaces),
      u32.from(g0), u32.from(gn), isLast));
    bd.out.lineBreaks = bd.out.lineBreaks + 1u32;
    bd.y = bd.y + thisH;
    lineNo = lineNo + 1u32;
    if n == 0usize { break; }
    if j == start { j = start + 1usize; }
    start = j;
  }
}

// ---- asking the layout ----

// The index of the line a position is on: the first whose range holds the offset; the last line of a
// block also holds its end
pub fn lineOf(l &RichLayout, p Pos) usize {
  mut i = usize.from(*l.blockLine[p.block]);
  while i < l.lines.len() {
    imm ln = l.lines[i];
    if usize.from(ln.block) != p.block { break; }
    if p.off < usize.from(ln.end) or ln.last { return i; }
    i = i + 1usize;
  }
  if i > 0usize { i - 1usize; } else { 0usize; };
}

// The x of a position on its line
pub fn xOf(l &RichLayout, line usize, p Pos) f32 {
  imm ln = l.lines[line];
  mut g = usize.from(ln.g0);
  imm gEnd = g + usize.from(ln.gn);
  while g < gEnd {
    imm gl = l.glyphs[g];
    if usize.from(gl.off) >= p.off { return gl.x; }
    g = g + 1usize;
  }
  ln.x1;
}

// The caret rectangle: x, top, height
pub struct CaretRect {
  pub x f32;
  pub y f32;
  pub h f32;
}

pub fn caretRect(l &RichLayout, p Pos) CaretRect {
  imm li = lineOf(l, p);
  imm ln = l.lines[li];
  new CaretRect(xOf(l, li, p), ln.top, ln.height);
}

// The position nearest to a point
pub fn posAt(l &RichLayout, x f32, y f32) Pos {
  if l.lines.len() == 0usize { return pos(0usize, 0usize); }
  // the line: the one holding y, else the nearest
  mut best = 0usize;
  mut bestD = 1000000.0;
  mut i = 0usize;
  while i < l.lines.len() {
    imm ln = l.lines[i];
    mut d = 0.0;
    if y < ln.top { d = ln.top - y; } elif y > ln.top + ln.height { d = y - ln.top - ln.height; }
    if d < bestD { bestD = d; best = i; }
    i = i + 1usize;
  }
  posOnLine(l, best, x);
}

pub fn posOnLine(l &RichLayout, line usize, x f32) Pos {
  imm ln = l.lines[line];
  mut g = usize.from(ln.g0);
  imm gEnd = g + usize.from(ln.gn);
  while g < gEnd {
    imm gl = l.glyphs[g];
    if x < gl.x + gl.adv * 0.5 or (usize.from(gl.off) >= usize.from(ln.inkEnd) and !ln.last) {
      if usize.from(gl.off) > usize.from(ln.inkEnd) { return pos(usize.from(ln.block), usize.from(ln.inkEnd)); }
      return pos(usize.from(ln.block), usize.from(gl.off));
    }
    g = g + 1usize;
  }
  if ln.last { pos(usize.from(ln.block), usize.from(ln.end)); } else { pos(usize.from(ln.block), usize.from(ln.inkEnd)); };
}

// The start and end of the line a position is on
pub fn lineStartPos(l &RichLayout, p Pos) Pos {
  imm ln = l.lines[lineOf(l, p)];
  pos(usize.from(ln.block), usize.from(ln.start));
}

pub fn lineEndPos(l &RichLayout, p Pos) Pos {
  imm ln = l.lines[lineOf(l, p)];
  pos(usize.from(ln.block), usize.from(if ln.last { ln.end; } else { ln.inkEnd; }));
}

// One line up (dir -1) or down (+1) keeping to x
pub fn moveLine(l &RichLayout, p Pos, dir i32, x f32) Pos {
  imm li = lineOf(l, p);
  if dir < 0i32 {
    if li == 0usize { return pos(0usize, 0usize); }
    return posOnLine(l, li - 1usize, x);
  }
  if li + 1usize >= l.lines.len() {
    imm ln = l.lines[li];
    return pos(usize.from(ln.block), usize.from(ln.end));
  }
  posOnLine(l, li + 1usize, x);
}

// Rectangles covering the selection lo..hi, one a line
pub fn selectionRects(l &RichLayout, lo Pos, hi Pos) List[RectP] {
  mut out = List[RectP].empty();
  if lo.same(&hi) { return out; }
  mut i = lineOf(l, lo);
  imm last = lineOf(l, hi);
  while i <= last and i < l.lines.len() {
    imm ln = l.lines[i];
    imm b = usize.from(ln.block);
    mut xa = ln.x0;
    mut xb = ln.x1;
    if b == lo.block and lo.off >= usize.from(ln.start) { xa = xOf(l, i, lo); }
    if b == hi.block and hi.off <= usize.from(ln.end) { xb = xOf(l, i, hi); }
    elif b < hi.block or (b == hi.block and ln.last) { xb = xb + 6.0; }
    if xb > xa { out.push(new RectP(xa, ln.top, xb - xa, ln.height, 0u32, 1u32)); }
    i = i + 1usize;
  }
  out;
}

// The image box (if any) under a point
pub fn boxAt(l &RichLayout, x f32, y f32) i32 {
  mut i = l.boxes.len();
  while i > 0usize {
    i = i - 1usize;
    imm bx = l.boxes[i];
    if x >= bx.x and x < bx.x + bx.w and y >= bx.y and y < bx.y + bx.h { return i32.from(i); }
  }
  -1i32;
}
