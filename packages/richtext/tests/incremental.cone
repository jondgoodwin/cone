// Incremental layout against full layout, over 600 random edits of a document with headings, bullets, numbered
// lists of two depths, floats on both sides and justified and centred paragraphs. After every edit the layout is
// made twice: from scratch (layoutRich) and from the previous layout (RichEditor.relayout, which takes the blocks the
// edit did not touch). They must be the SAME layout: the same lines, glyphs, boxes, rectangles, markers and floats,
// to 0.01 px in y (a block taken from the previous layout is moved by a difference of y, which rounds a little
// differently from a chain of additions) and exactly in everything else. The edits are typing words and line
// breaks, backspace and delete, Enter, bullets and numbering, headings, indentation, bold, floated images, undo
// and redo, and jumps of the caret.

mod incrementaltest;

import testing use *;
import collections use *;
import fs;
import stdio use *;
import path use Path;
import msdftext use Font;
import richtext use *;

fn loadFont(file &str) Option[Font] {
  var out Option[Font] = None;
  match fs.readFile(&Path.from(file)) {
    case let bytes Ok {
      match Font.load(bytes.view()) {
        case let f Ok { out = Some[Font](f); }
        case is Error {}
      }
    }
    case is Error {}
  }
  out
}

fn absF(x f32) f32 { if x < 0.0 { -x } else { x } }
fn near(a f32, b f32) bool { absF(a - b) < 0.01 }

// Returns "" when equal, else what differs first
fn compare(a &RichLayout, b &RichLayout) String {
  if a.glyphs.len() != b.glyphs.len() { return String.from("glyph count"); }
  if a.lines.len() != b.lines.len() { return String.from("line count"); }
  if a.boxes.len() != b.boxes.len() { return String.from("box count"); }
  if a.rects.len() != b.rects.len() { return String.from("rect count"); }
  if a.markers.len() != b.markers.len() { return String.from("marker count"); }
  if a.floats.len() != b.floats.len() { return String.from("float count"); }
  if a.blockLine.len() != b.blockLine.len() { return String.from("block count"); }
  var i = 0usize;
  while i < a.glyphs.len() {
    let p = a.glyphs[i];
    let q = b.glyphs[i];
    if p.x != q.x or !near(p.y, q.y) or p.adv != q.adv or p.glyph != q.glyph or p.color != q.color or p.flags != q.flags
        or p.block != q.block or p.off != q.off or p.len != q.len or p.face != q.face or p.size != q.size {
      var s = String.from("glyph ");
      s.appendUInt(u64.from(i));
      return s;
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < a.lines.len() {
    let p = a.lines[i];
    let q = b.lines[i];
    if p.block != q.block or p.start != q.start or p.end != q.end or p.inkEnd != q.inkEnd or !near(p.top, q.top) or !near(p.height, q.height)
        or !near(p.baseline, q.baseline) or p.x0 != q.x0 or p.x1 != q.x1 or p.g0 != q.g0 or p.gn != q.gn or p.last != q.last {
      var s = String.from("line ");
      s.appendUInt(u64.from(i));
      return s;
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < a.boxes.len() {
    let p = a.boxes[i];
    let q = b.boxes[i];
    if p.x != q.x or !near(p.y, q.y) or p.w != q.w or p.h != q.h or p.image != q.image or p.block != q.block or p.off != q.off
        or p.floating != q.floating { return String.from("box"); }
    i = i + 1usize;
  }
  i = 0usize;
  while i < a.rects.len() {
    let p = a.rects[i];
    let q = b.rects[i];
    if p.x != q.x or !near(p.y, q.y) or p.w != q.w or p.h != q.h or p.color != q.color { return String.from("rect"); }
    i = i + 1usize;
  }
  i = 0usize;
  while i < a.markers.len() {
    let p = a.markers[i];
    let q = b.markers[i];
    if p.x != q.x or !near(p.y, q.y) or p.glyph != q.glyph or p.block != q.block { return String.from("marker"); }
    i = i + 1usize;
  }
  i = 0usize;
  while i < a.blockLine.len() {
    if *a.blockLine[i] != *b.blockLine[i] or *a.blockGlyph[i] != *b.blockGlyph[i] or *a.blockBox[i] != *b.blockBox[i]
        or *a.blockRect[i] != *b.blockRect[i] or *a.blockMarker[i] != *b.blockMarker[i] or *a.blockFloat[i] != *b.blockFloat[i]
        or !near(*a.blockY[i], *b.blockY[i]) { return String.from("block index"); }
    i = i + 1usize;
  }
  if !near(a.height, b.height) or !near(a.endY, b.endY) { return String.from("height"); }
  String.empty()
}

struct Rng {
  state u64;
  fn next(self &mut) u32 {
    state = state * 6364136223846793005u64 + 1442695040888963407u64;
    u32.from(state >> 33u64)
  }
  fn below(self &mut, n u32) u32 { next() % n }
}

fn word(r &mut Rng) &str {
  let w = ["alpha ", "beta ", "gamma delta ", "x", "epsilon zeta eta theta iota kappa lambda ", "mu\nnu ", "a-long-hyphenated-word ", "  ", "omicron. "];
  w[usize.from(r.below(9u32))]
}

fn main() i32 {
  match loadFont("C:/Windows/Fonts/georgia.ttf") {
    case let reg Some {
      var faces = Faces.make(reg);
      match loadFont("C:/Windows/Fonts/georgiab.ttf") { case let b Some { faces.setBold(b); } case is None {} }
      run(&faces);
    }
    case is None { print <- "Georgia is not installed: incremental layout test skipped\n"; }
  }
  done()
}

fn run(faces &Faces) {
  var cfg = LayoutConfig.standard(520.0);
  var e = RichEditor.make();
  // a starting document
  e.setBlockKind(BK_H1);
  e.insertText("Title of the document");
  e.enter();
  e.insertText("An opening paragraph with enough words in it to take two or three lines at this width of page, which is a good length for floats to wrap around.");
  e.enter();
  e.setBlockKind(BK_NUMBER);
  e.insertText("first");
  e.enter();
  e.insertText("second");
  e.setListDepth(1u32);
  e.enter();
  e.insertText("third");
  e.setListDepth(0u32);
  e.enter();
  e.enter();
  e.insertText("A paragraph after the list, centred, with some more words so that it wraps onto a second line at this width.");
  e.setAlign(AL_CENTER);
  e.enter();
  e.setAlign(AL_JUSTIFY);
  e.insertText("Another paragraph to be justified, long enough to wrap onto several lines, which it will do since the page is only five hundred pixels wide.");
  e.enter();
  e.insertText("Last paragraph.");
  var images = List[u32].empty();
  var ii = 0u32;
  while ii < 3u32 {
    let place = if ii == 0u32 { PL_RIGHT } elif ii == 1u32 { PL_LEFT } else { PL_INLINE };
    images.push(e.addImage(new ImageInfo(f32.from(60u32 + 40u32 * ii), f32.from(50u32 + 30u32 * ii), place, String.from("img"), 0u32, 0u32, List[u8].empty())));
    ii = ii + 1u32;
  }
  var prev = e.fullLayout(faces, &cfg);
  var rng = new Rng(12345u64);
  var mismatches = 0u32;
  var firstMismatch = String.empty();
  var reuse = 0u64;
  var blocksSeen = 0u64;
  var steps = 0u32;
  while steps < 600u32 {
    let op = rng.below(20u32);
    let nb = e.blockCount();
    if op < 6u32 { e.insertText(word(&mut rng)); }
    elif op == 6u32 { e.backspace(); }
    elif op == 7u32 { e.deleteForward(); }
    elif op == 8u32 { e.enter(); }
    elif op == 9u32 { e.toggleList(if rng.below(2u32) == 0u32 { BK_NUMBER } else { BK_BULLET }); }
    elif op == 10u32 { e.indent(if rng.below(2u32) == 0u32 { 1i32 } else { -1i32 }); }
    elif op == 11u32 { e.setBlockKind(if rng.below(3u32) == 0u32 { BK_H2 } else { BK_PARA }); }
    elif op == 12u32 { e.toggleStyle(OP_BOLD); }
    elif op == 13u32 { if rng.below(3u32) == 0u32 { e.insertImage(*images[usize.from(rng.below(3u32))]); } }
    elif op == 14u32 { e.undo(); }
    elif op == 15u32 { e.redo(); }
    elif op == 16u32 { e.setAlign(if rng.below(2u32) == 0u32 { AL_JUSTIFY } else { AL_LEFT }); }
    else {
      // jump the caret, sometimes extending a selection
      let bi = usize.from(rng.below(u32.from(nb)));
      let len = e.block(bi).text.len();
      var off = 0usize;
      if len > 0usize { off = usize.from(rng.below(u32.from(len) + 1u32)); }
      // keep to character boundaries
      while off > 0usize and off < len and isContByte(e.block(bi).text[off]) { off = off - 1usize; }
      e.setCaret(pos(bi, off), rng.below(4u32) == 0u32);
    }
    // keep the document from growing without bound
    if e.blockCount() > 60usize { e.setCaret(pos(0usize, 0usize), false); e.setCaret(pos(30usize, 0usize), true); e.deleteSelection(); }
    let full = layoutRich(&e.core.blocks, &e.core.images, faces, &cfg);
    if e.layoutStale() {
      let inc = e.relayout(&prev, faces, &cfg);
      let diff = compare(&inc, &full);
      if diff.len() > 0usize {
        mismatches = mismatches + 1u32;
        if firstMismatch.len() == 0usize {
          firstMismatch = String.from("step ");
          firstMismatch.appendUInt(u64.from(steps));
          firstMismatch.append(": ");
          firstMismatch.append(diff.view());
        }
      }
      reuse = reuse + u64.from(inc.reused);
      blocksSeen = blocksSeen + u64.from(e.blockCount());
      prev = inc;
    } else {
      prev = full;
    }
    steps = steps + 1u32;
  }
  if mismatches > 0u32 { print <- "first mismatch: ", firstMismatch.view(), "\n"; }
  expectInt(i64.from(mismatches), 0i64, "every incremental layout equals the full layout");
  expect(blocksSeen > 0u64 and reuse * 100u64 / blocksSeen > 30u64, "a good part of the blocks were taken from the previous layout");
  print <- "blocks taken from the previous layout: ", reuse, " of ", blocksSeen, "\n";
}
