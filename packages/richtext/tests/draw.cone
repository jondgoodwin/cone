// The renderer on a real GPU (validation on by the gpu package), read back and checked pixel by pixel.
// Skips when Georgia is absent. A 600 x 400 target, a 480-wide page at x 60, margin 30:
//
//   - the desk colour outside the page, the paper colour inside it, away from any text (exactly, to 2/255);
//   - a selection rectangle over paper: its pixels are paper blended with the selection colour at its alpha
//     (the rectangle's last 3 columns, where the selection runs past the line's end, hold no text);
//   - text: dark ink inside the first line's box, and none in the margin;
//   - an underline: the rectangle's middle pixel is the text colour;
//   - an image: the pixel at the middle of a cell is that cell's colour (a 2 x 2 grid of four colours,
//     each cell 40 px square);
//   - the caret: a 1.5 px bar of the caret colour at its x.

mod drawtest;

import testing use *;
import collections use *;
import fs;
import stdio use *;
import path use Path;
import libc;
import gpu use *;
import msdftext use Font;
import richtext use *;

fn loadFont(file &str) Option[Font] {
  mut out Option[Font] = None;
  match fs.readFile(&Path.from(file)) {
    case imm bytes Ok {
      match Font.load(bytes.view()) {
        case imm f Ok { out = Some[Font](f); }
        case is Error {}
      }
    }
    case is Error {}
  }
  out;
}

fn absI(x i32) i32 { if x < 0i32 { -x; } else { x; }; }

// the RGBA of target pixel (x, y)
fn pixel(px *u8, x u32, y u32, w u32, c usize) i32 {
  i32.from(*(px + usize.from((y * w + x) * 4u32) + c));
}

fn near(px *u8, x u32, y u32, w u32, r i32, g i32, b i32, tol i32) bool {
  absI(pixel(px, x, y, w, 0usize) - r) <= tol and absI(pixel(px, x, y, w, 1usize) - g) <= tol and absI(pixel(px, x, y, w, 2usize) - b) <= tol;
}

fn main() i32 {
  match loadFont("C:/Windows/Fonts/georgia.ttf") {
    case imm reg Some { run(reg); }
    case is None { print <- "Georgia is not installed: draw test skipped\n"; }
  }
  done();
}

fn run(reg Font) {
  imm faces = Faces.make(reg);
  mut instance = Instance.create("richtext draw test");
  mut none = Surface.none();
  mut preference = POWER_PREFERENCE_HIGH_PERFORMANCE;
  imm env = libc.getenv("GPU_POWER_PREFERENCE");
  if (env as usize) != 0usize {
    if libc.strcmp(cstr.fromPtr(env), "low-power") == 0i32 { preference = POWER_PREFERENCE_LOW_POWER; }
  }
  mut adapter = instance.requestAdapter(&none, preference);
  mut device = adapter.requestDevice();
  imm w = 600u32;
  imm h = 400u32;
  mut r = RichRenderer.create(&mut device, &faces, TEXTURE_FORMAT_RGBA8_UNORM);
  expect(r.isValid(), "the renderer is valid");
  imm td = new TextureDescriptor(w, h, TEXTURE_FORMAT_RGBA8_UNORM, TEXTURE_USAGE_RENDER_ATTACHMENT | TEXTURE_USAGE_COPY_SRC);
  mut target = device.createTexture(&td);
  mut readback = device.createBuffer(u64.from(w * h * 4u32), BUFFER_USAGE_MAP_READ | BUFFER_USAGE_COPY_DST);

  // a document: an underlined first line, then a paragraph with an inline image (a 2 x 2 grid of colours)
  mut blocks = List[Block].empty();
  mut b0 = Block.fromText("Underlined words", Style.plain());
  imm ul = new StyleOp(OP_UNDERLINE, true, 0.0, 0u32);
  styleRange(&mut b0, 0usize, 16usize, &ul);
  blocks.push(b0);
  mut px = List[u8].empty();
  imm cols = [255u8, 0u8, 0u8, 255u8, 0u8, 255u8, 0u8, 255u8, 0u8, 0u8, 255u8, 255u8, 250u8, 220u8, 0u8, 255u8];
  mut ci = 0usize;
  while ci < 16usize { px.push(cols[ci]); ci = ci + 1usize; }
  mut images = List[ImageInfo].empty();
  images.push(new ImageInfo(80.0, 80.0, PL_INLINE, String.from("grid"), 2u32, 2u32, px));
  mut b1 = Block.empty();
  mut st = Style.plain();
  st.image = 1u32;
  mut anchorChar = String.empty();
  anchorChar.appendByte(0xEFu8);
  anchorChar.appendByte(0xBFu8);
  anchorChar.appendByte(0xBCu8);
  insertInBlock(&mut b1, 0usize, anchorChar.view(), st);
  blocks.push(b1);
  mut cfg = LayoutConfig.standard(480.0);
  cfg.margin = 30.0;
  cfg.marginTop = 20.0;
  imm l = layoutRich(&blocks, &images, &faces, &cfg);
  expectInt(i64.from(l.boxes.len()), 1i64, "one inline image box");
  imm bx = l.boxes[0usize];
  expectFloat(f64.from(bx.w), 80.0d, 0.01d, "it is 80 wide");

  // the selection covers the first line's right end past the text; the caret is at the start of the second block
  imm sel = selectionRects(&l, pos(0usize, 0usize), pos(1usize, 0usize));
  expectInt(i64.from(sel.len()), 1i64, "a selection rectangle over the first line");
  imm caret = caretRect(&l, pos(1usize, 0usize));
  mut view = new RichView(f32.from(w), f32.from(h), 60.0, 0.0, 0x202020ffu32, 0xffffffffu32, 0x0000ff80u32, 0xff0000ffu32, 480.0, true);
  mut encoder = device.createCommandEncoder();
  r.draw(&mut device, &mut encoder, &target, &view, &faces, &l, &images, &sel, &caret);
  encoder.copyTextureToBuffer(&target, &readback);
  device.queue.submit(encoder.finish());
  device.endFrame();
  device.waitIdle();
  imm p = readback.mappedRange();

  // the desk and the paper
  expect(near(p, 20u32, 300u32, w, 0x20, 0x20, 0x20, 2i32), "desk colour left of the page");
  expect(near(p, 580u32, 300u32, w, 0x20, 0x20, 0x20, 2i32), "desk colour right of the page");
  expect(near(p, 300u32, u32.from(l.height) - 6u32, w, 255, 255, 255, 2i32), "paper below the content, inside the page");
  expect(near(p, 300u32, u32.from(l.height) + 6u32, w, 0x20, 0x20, 0x20, 2i32), "desk below the page's end");
  // the selection: the last 3 columns of the rectangle over the first line, which is empty past the text
  imm sr = sel[0usize];
  imm sx = u32.from(60.0 + sr.x + sr.w) - 3u32;
  imm sy = u32.from(sr.y + 3.0);
  // 0x80 = 128/255 of blue over white: r, g = 255 * (1 - 0.502) = 127, b = 255
  expect(near(p, sx, sy, w, 127, 127, 255, 3i32), "selection blends over the paper");
  // ink inside the first line, none in the margin
  mut dark = 0u32;
  mut x = 60u32 + 30u32;
  while x < 60u32 + 30u32 + 120u32 {
    mut y = u32.from(l.lines[0usize].top);
    while y < u32.from(l.lines[0usize].top + l.lines[0usize].height) {
      if pixel(p, x, y, w, 0usize) < 90i32 { dark = dark + 1u32; }
      y = y + 1u32;
    }
    x = x + 1u32;
  }
  expect(dark > 150u32, "dark glyph pixels in the first line");
  mut margin = 0u32;
  x = 60u32 + 2u32;
  while x < 60u32 + 26u32 {
    mut y = u32.from(l.lines[0usize].top);
    while y < u32.from(l.lines[0usize].top + l.lines[0usize].height) {
      if absI(pixel(p, x, y, w, 0usize) - 255i32) > 4i32 and absI(pixel(p, x, y, w, 0usize) - 127i32) > 4i32 { margin = margin + 1u32; }
      y = y + 1u32;
    }
    x = x + 1u32;
  }
  expectInt(i64.from(margin), 0i64, "nothing but paper and selection in the left margin");
  // the underline: the middle of its rectangle is the text colour (0x202124), under the selection it is blended
  expectInt(i64.from(l.rects.len()), 1i64, "one underline");
  imm ur = l.rects[0usize];
  imm ux = u32.from(60.0 + ur.x + ur.w * 0.5);
  imm uy = u32.from(ur.y + ur.h * 0.5);
  expect(pixel(p, ux, uy, w, 0usize) < 140i32 and pixel(p, ux, uy, w, 2usize) > 40i32, "the underline is dark under the translucent selection");
  // the image: cell colours at the middle of each 40 px cell
  imm ix = u32.from(60.0 + bx.x + 0.5);
  imm iy = u32.from(bx.y + 0.5);
  expect(near(p, ix + 20u32, iy + 20u32, w, 255, 0, 0, 3i32), "image cell 0 is red");
  expect(near(p, ix + 60u32, iy + 20u32, w, 0, 255, 0, 3i32), "image cell 1 is green");
  expect(near(p, ix + 20u32, iy + 60u32, w, 0, 0, 255, 3i32), "image cell 2 is blue");
  expect(near(p, ix + 60u32, iy + 60u32, w, 250, 220, 0, 3i32), "image cell 3 is yellow");
  // the caret: red bar at the start of the second block (x = 60 + margin), 1.5 px wide
  imm cx = u32.from(60.0 + caret.x);
  expect(pixel(p, cx, u32.from(caret.y + caret.h * 0.5), w, 0usize) > 200i32 and pixel(p, cx, u32.from(caret.y + caret.h * 0.5), w, 1usize) < 80i32 or
    pixel(p, cx - 1u32, u32.from(caret.y + caret.h * 0.5), w, 0usize) > 200i32, "a red caret bar at its x");
}
