// A Url's 'toText' sends exactly what 'text()' gives, so '$"..."' takes the
// URL: tidied as 'text()' tidies it (the default port left out).

mod urltext;

import testing use *;
import collections use String;
import url use *;

fn main() i32 {
  match Url.parse("HTTPS://Example.COM:443/a/./b/../c?x=1#top") {
    case let Ok(r) {
      let s = $"{r}";
      expectStr(s.view(), r.text().view(), "$\"...\" is text()");
      expectStr(s.view(), "https://example.com/a/c?x=1#top", "...and is the written form");
      let t = $"url {r}!";
      expectStr(t.view(), "url https://example.com/a/c?x=1#top!", "inside other text");
    }
    case let Err(e) {expect(false, "the URL parses");}
  }
  match Url.parse("http://example.com:8080/p") {
    case let Ok(r) {
      let s = $"{r}";
      expectStr(s.view(), r.text().view(), "a port that is not the default: $\"...\" is text()");
      expectStr(s.view(), "http://example.com:8080/p", "...and is the written form");
    }
    case let Err(e) {expect(false, "the second URL parses");}
  }
  done()
}
