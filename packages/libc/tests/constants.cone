// The numbers libc names that differ by C library: ISO C's EILSEQ, and the
// locale categories setlocale takes. cnames.c defines each from the C library's
// own header (errno.h, locale.h), so the program reads the number of the library
// it is linked with; this test pins what those headers say, the UCRT's on Windows
// and glibc's on Linux, as one fact per name, 1 when the value is that library's.
// It also checks that setlocale, asked only to name the locale in force, answers
// one (not null) for each category.
//
// EDOM and ERANGE are the same in every library Cone targets.

mod constants;

import stdio use *;
import libc use *;

fn show(label: &str, n: i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn matches(value: i32, windows: i32, linux: i32) i64 {
  if isWindows() {
    if value == windows {1i64} else {0i64}
  } else {
    if value == linux {1i64} else {0i64}
  }
}

fn answers(category: i32) i64 {
  let asking: *u8 = null;
  if setlocale(category, asking) != null {1i64} else {0i64}
}

fn main() i32 {
  show("EDOM", i64.from(EDOM));
  show("ERANGE", i64.from(ERANGE));
  show("EILSEQ", matches(EILSEQ, 42i32, 84i32));
  show("LC_ALL", matches(LC_ALL, 0i32, 6i32));
  show("LC_COLLATE", matches(LC_COLLATE, 1i32, 3i32));
  show("LC_CTYPE", matches(LC_CTYPE, 2i32, 0i32));
  show("LC_MONETARY", matches(LC_MONETARY, 3i32, 4i32));
  show("LC_NUMERIC", matches(LC_NUMERIC, 4i32, 1i32));
  show("LC_TIME", matches(LC_TIME, 5i32, 2i32));
  show("setlocale-all", answers(LC_ALL));
  show("setlocale-collate", answers(LC_COLLATE));
  show("setlocale-ctype", answers(LC_CTYPE));
  show("setlocale-monetary", answers(LC_MONETARY));
  show("setlocale-numeric", answers(LC_NUMERIC));
  show("setlocale-time", answers(LC_TIME));
  0i32
}
