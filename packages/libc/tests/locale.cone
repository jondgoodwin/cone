// setlocale, from locale.h, and what it does to file names. Each line is one
// fact the C library established, printed as a number:
//
// - a program starts in the "C" locale, and a null name only asks;
// - a locale the library does not know is refused with null, and the one in
//   force stays;
// - a UTF-8 locale is set (Windows' ".UTF-8", glibc's "C.UTF-8"), and the name
//   it answers ends ".utf8" (Windows: "English_United States.utf8") or ".UTF-8"
//   (glibc: "C.UTF-8"), so only that ending is compared; asking one category,
//   LC_CTYPE, answers the same (this also checks that LC_ALL and LC_CTYPE are
//   the numbers of the C library the program is linked with);
// - under it, a file named with "é" (0xC3 0xA9) and "日" (0xE6 0x97 0xA5) is
//   written, read back and removed, as UTF-8 bytes on Windows (whose narrow file
//   functions read a name in the locale's code page unless the locale is
//   UTF-8) and on Linux (whose names are bytes);
// - a name holding 0xE9 alone, which is not UTF-8, is refused ('fopen' answers
//   null) on Windows, which decodes the name as UTF-8 and cannot decode that
//   byte; Linux names are any bytes, so there 'fopen' makes the file (which the
//   test removes). The line says 1 when the platform did its own one of the two;
// - setting "C" again answers "C".
//
// The file is 'module_package_libc_é日.tmp' in the folder TEMP names (on Linux
// TMPDIR, else /tmp).

mod locale;

import stdio use *;
import libc use *;

fn show(label &str, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn yes(b bool) i64 {if b {1i64} else {0i64}}

fn isNull(p *u8) i64 {yes(p == null)}

// A literal as the pointer a function that may take null takes
fn lit(text cstr) *u8 {text.ptr()}

// Whether the C string p ends with the C string end
fn endsWith(p *u8, end cstr) bool {
  let n = strlen(cstr.fromPtr(p));
  let m = strlen(end);
  m <= n and strcmp(cstr.fromPtr(p + (n - m)), end) == 0i32
}

// The folder for temporary files: Windows' TEMP, Linux's TMPDIR or /tmp
fn tempFolder() *u8 {
  if isWindows() {return getenv("TEMP");}
  let dir = getenv("TMPDIR");
  if dir == null {return &"/tmp" as *u8;}
  dir
}

// The temporary folder, a separator, and the name, NUL included, into buf
fn tempPath(buf *u8, name cstr) {
  let temp = tempFolder();
  let templen = strlen(cstr.fromPtr(temp));
  memcpy(buf, temp, templen);
  buf[templen] = if isWindows() {'\\'} else {'/'};
  memcpy(buf + templen + 1usize, name.ptr(), strlen(name) + 1usize);
}

fn main() i32 {
  let asking *u8 = null;
  show("starts-as-C", yes(strcmp(cstr.fromPtr(setlocale(LC_ALL, asking)), "C") == 0i32));
  show("unknown-null", isNull(setlocale(LC_ALL, lit("no-such-locale"))));
  show("still-C", yes(strcmp(cstr.fromPtr(setlocale(LC_ALL, asking)), "C") == 0i32));

  let utf8 = setlocale(LC_ALL, if isWindows() {lit(".UTF-8")} else {lit("C.UTF-8")});
  show("utf8-null", isNull(utf8));
  show("utf8-ends-utf8", yes(endsWith(utf8, ".utf8") or endsWith(utf8, ".UTF-8")));
  let ctype = setlocale(LC_CTYPE, asking);
  show("ctype-ends-utf8", yes(endsWith(ctype, ".utf8") or endsWith(ctype, ".UTF-8")));

  var path = new Array[u8, 512] <- fill 0u8;
  let name *u8 = &[]path as *u8;
  tempPath(name, "module_package_libc_\xC3\xA9\xE6\x97\xA5.tmp");
  let cname = cstr.fromPtr(name);
  let out = fopen(cname, "wb");
  show("utf8-name-fopen-null", isNull(out as *u8));
  show("fwrite-count", i64.from(fwrite(&"caf\xC3\xA9" as *u8, 1usize, 5usize, out)));
  show("fclose", i64.from(fclose(out)));
  var buf = new Array[u8, 16] <- fill 0u8;
  let back = fopen(cname, "rb");
  show("read-back-count", i64.from(fread(&[]buf as *u8, 1usize, 16usize, back)));
  fclose(back);
  show("read-back-equal", yes(strcmp(cstr.fromPtr(&[]buf as *u8), "caf\xC3\xA9") == 0i32));
  show("remove", i64.from(remove(cname)));
  show("fopen-after-remove-null", isNull(fopen(cname, "rb") as *u8));

  var bad = new Array[u8, 512] <- fill 0u8;
  let badName *u8 = &[]bad as *u8;
  tempPath(badName, "module_package_libc_\xE9.tmp");
  let made = fopen(cstr.fromPtr(badName), "wb");
  show("not-utf8-name-platform-rule", if isWindows() {isNull(made as *u8)} else {1i64 - isNull(made as *u8)});
  if (made as *u8) != null {
    fclose(made);
    remove(cstr.fromPtr(badName));
  }

  show("back-to-C", yes(strcmp(cstr.fromPtr(setlocale(LC_ALL, lit("C"))), "C") == 0i32));
  0i32
}
