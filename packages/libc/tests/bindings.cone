// The libc package, imported by name as any program imports it (compiled on its
// own, this test compiled against the include file it generates, and the two
// linked), called by the C names it declares and linked against the C runtime.
// Each line is one fact the C library established, printed as a number:
//
// - calloc gives zeroed memory, realloc grows it keeping what it held, free
//   takes it back; malloc is libc's, and a bare name everywhere, since core
//   folds it in too, publicly: here it arrives by both routes as one binding;
// - a file written with fopen/fwrite/fflush/fclose reads back with fread;
//   rename moves it away, so fopen of the old name fails, with errno ENOENT
//   and strerror's text for it, and back again; ferror is clear after a
//   good read and set after reading a stream opened for writing; remove
//   deletes it, so a second fopen for reading fails;
// - time counts seconds since 1970, and stores them where it is asked to;
//   timespec_get answers TIME_UTC with the same seconds and nanoseconds
//   below a second;
// - getenv answers null for a variable no one sets; system returns the
//   command's exit status;
// - strlen, strcmp, memcpy and memset, and a string literal passed as a C
//   string, since it carries its NUL;
// - math.h's functions, double and float, each at a value known exactly;
// - stdout() is the stream stdio prints to, so what is written to it comes out
//   in order with the rest;
// - exit ends the program with the status given, flushing what was written:
//   main returns 1, which the runner would report, after a call that exits 0.
//
// The file it writes is 'module_package_libc.tmp' in the folder TEMP names,
// its path joined with strlen and memcpy, and it removes the file.

mod bindings;

import stdio use *;
import libc use *;

fn show(label &[]u8, n i64) {
  printStr(label);
  printStr(" = ");
  printInt(n);
  printStr("\n");
}

fn isNull(p *u8) i64 {if p == null {1i64;} else {0i64;};}

fn memory() {
  // calloc: eight zeroed bytes
  mut p = calloc(8usize, 1usize);
  mut sum = 0i64;
  mut i = 0usize;
  while i < 8usize {sum = sum + i64.from(p[i]); i = i + 1usize;};
  show("calloc-zeroed-sum", sum);
  // Filled 1 to 8, grown to 4096 bytes: the first eight survive
  i = 0usize;
  while i < 8usize {p[i] = u8.from(i) + 1u8; i = i + 1usize;};
  p = realloc(p, 4096usize);
  p[4095] = 9u8;
  sum = 0i64;
  i = 0usize;
  while i < 8usize {sum = sum + i64.from(p[i]); i = i + 1usize;};
  show("realloc-kept-sum", sum);
  show("realloc-last", i64.from(p[4095]));
  free(p);
  // malloc, bare: core's fold of libc's and this module's own meet as one
  imm q = malloc(16usize);
  show("malloc-null", isNull(q));
  free(q);
}

fn files() {
  // TEMP, a '\', and the file's name, with the NUL the literal carries
  mut path = new Array[u8, 512] <- fill 0u8;
  imm name *u8 = &[]path;
  imm temp = getenv(&[]"TEMP");
  imm templen = strlen(temp);
  memcpy(name, temp, templen);
  memcpy(name + templen, &[]"\\module_package_libc.tmp", 25usize);
  show("path-length", i64.from(strlen(name) - templen));

  imm out = fopen(name, &[]"wb");
  show("fopen-write-null", isNull(out as *u8));
  imm text = &[]"line one\nline two\n";
  show("fwrite-count", i64.from(fwrite(text, 1usize, 18usize, out)));
  show("fflush", i64.from(fflush(out)));
  show("fclose", i64.from(fclose(out)));

  mut buf = new Array[u8, 64] <- fill 0u8;
  imm back = fopen(name, &[]"rb");
  imm got = fread(&[]buf, 1usize, 64usize, back);
  fclose(back);
  show("fread-count", i64.from(got));
  show("read-back-equal", if strcmp(&[]buf, text) == 0i32 {1i64;} else {0i64;});

  // rename, to the same name with '2' before its NUL, and back
  mut path2 = new Array[u8, 512] <- fill 0u8;
  imm name2 *u8 = &[]path2;
  imm len = strlen(name);
  memcpy(name2, name, len);
  name2[len] = '2';
  show("rename", i64.from(rename(name, name2)));
  show("fopen-old-name-null", isNull(fopen(name, &[]"rb") as *u8));
  show("errno-after-fopen", i64.from(*errno()));
  printStr("strerror = ");
  printCStr(strerror(*errno()));
  printStr("\n");
  show("rename-back", i64.from(rename(name2, name)));
  *errno() = 0i32;
  show("errno-set", i64.from(*errno()));

  // ferror: nothing failed reading, and reading a stream opened for writing does
  imm clean = fopen(name, &[]"rb");
  fread(&[]buf, 1usize, 64usize, clean);
  show("ferror-clean", i64.from(ferror(clean)));
  fclose(clean);
  imm writing = fopen(name, &[]"ab");
  fread(&[]buf, 1usize, 64usize, writing);
  show("ferror-reading-a-writer", if ferror(writing) != 0i32 {1i64;} else {0i64;});
  fclose(writing);

  show("remove", i64.from(remove(name)));
  show("fopen-after-remove-null", isNull(fopen(name, &[]"rb") as *u8));
}

// time: seconds since 1970, after 2026 began, and stored where asked
fn clock() {
  mut stored = 0i64;
  imm now = time(&mut stored as *i64);
  show("time-after-2026", if now >= 1767225600i64 {1i64;} else {0i64;});
  show("time-stored", if stored == now {1i64;} else {0i64;});
  show("time-null", if time(null) >= now {1i64;} else {0i64;});
  // timespec_get: TIME_UTC answered, its seconds time()'s, its nanoseconds
  // below a second
  mut ts = new Timespec(0i64, 0i32);
  imm before = time(null);
  imm base = timespec_get(&mut ts as *Timespec, TIME_UTC);
  imm after = time(null);
  show("timespec_get-base", i64.from(base));
  show("timespec_get-seconds", if ts.tv_sec >= before and ts.tv_sec <= after {1i64;} else {0i64;});
  show("timespec_get-nanoseconds", if ts.tv_nsec >= 0i32 and ts.tv_nsec < 1000000000i32 {1i64;} else {0i64;});
}

fn process() {
  show("getenv-unset-null", isNull(getenv(&[]"CONE_LIBC_NEVER_SET")));
  show("system-status", i64.from(system(&[]"exit /b 3")));
}

fn strings() {
  show("strlen-literal", i64.from(strlen(&[]"hello")));
  show("strcmp-less", if strcmp(&[]"abc", &[]"abd") < 0i32 {1i64;} else {0i64;});
  mut buf = new Array[u8, 8] <- fill 0u8;
  imm at *u8 = &[]buf;
  memset(at, i32.from('x'), 3usize);
  memcpy(at + 3usize, &[]"yz", 3usize);
  printStr("built = ");
  printCStr(&[]buf);
  printStr("\n");
}

// math.h, each result rounded to a millionth and printed as a whole number of
// millionths. Pi arrives from acos, asin, atan and atan2 in both forms; the
// float forms carry f32's pi (3.14159274), which rounds the same
fn micro(x f64) i64 {i64.from(floor(x * 1000000. + 0.5));}

fn maths() {
  imm dpi = acos(-1.);
  imm fpi = acosf(-1f);
  show("sqrt-144", micro(sqrt(144.)));
  show("sqrtf-2.25", micro(sqrtf(2.25f)));
  show("acos-pi", micro(dpi));
  show("acosf-pi", micro(fpi));
  show("asin-pi", micro(asin(1.) * 2.));
  show("asinf-pi", micro(asinf(1f) * 2f));
  show("atan-pi", micro(atan(1.) * 4.));
  show("atanf-pi", micro(atanf(1f) * 4f));
  show("atan2-pi", micro(atan2(1., 1.) * 4.));
  show("atan2f-pi", micro(atan2f(1f, 1f) * 4f));
  // sin 30deg and cos 60deg are a half, tan 45deg is one
  show("sin-sixth-pi", micro(sin(dpi / 6.)));
  show("sinf-sixth-pi", micro(sinf(fpi / 6f)));
  show("cos-third-pi", micro(cos(dpi / 3.)));
  show("cosf-third-pi", micro(cosf(fpi / 3f)));
  show("tan-quarter-pi", micro(tan(dpi / 4.)));
  show("tanf-quarter-pi", micro(tanf(fpi / 4f)));
  // e is 2.718282, and the natural log of 100 is 4.605170
  show("exp-1", micro(exp(1.)));
  show("expf-1", micro(expf(1f)));
  show("log-100", micro(log(100.)));
  show("logf-100", micro(logf(100f)));
  show("pow-2-10", micro(pow(2., 10.)));
  show("powf-1.5-2", micro(powf(1.5f, 2f)));
  show("fabs", micro(fabs(-3.25)));
  show("fabsf", micro(fabsf(-3.25f)));
  // floor and ceil go down and up, the fmod remainder takes the dividend's sign
  show("floor-minus-2.5", micro(floor(-2.5)));
  show("floorf-2.5", micro(floorf(2.5f)));
  show("ceil-minus-2.5", micro(ceil(-2.5)));
  show("ceilf-2.5", micro(ceilf(2.5f)));
  show("fmod-7.5-2", micro(fmod(7.5, 2.)));
  show("fmodf-minus-7.5-2", micro(fmodf(-7.5f, 2f)));
}

fn streams() {
  printStr("stream = ");
  fwrite(&[]"through stdout()\n", 1usize, 17usize, stdout());
}

// Ends the program: nothing after the call runs
fn finish() {
  printStr("exit = 0\n");
  exit(0i32);
  printStr("after-exit = 1\n");
}

fn main() i32 {
  memory();
  files();
  clock();
  process();
  strings();
  maths();
  streams();
  finish();
  1i32;
}
