// The libc package: raw bindings to the ISO C standard library. A program
// reaches it with 'import libc', and calls each function by its C name, with
// C's types: a C string is a '*u8' to bytes ending in a NUL, and a string
// literal carries that NUL, so '&[]"rb"' can be passed straight through.
//
// Raw means nothing is wrapped. Errors come back as C reports them (a null
// pointer, a nonzero or negative return, errno), strings are the caller's to
// NUL-terminate and to free, and the caller keeps every rule C states. The
// Cone-flavoured layer over it (Result errors, slices, owned strings) is the
// 'fs' and 'env' packages; this one stays the C library as C spells it.
//
// Windows first: Cone cannot yet choose declarations by target, so this
// version binds the Windows C runtime (the UCRT, linked through msvcrt.lib,
// which every Congo and test-suite link already names). Where the UCRT
// spells a function differently or has it only as a macro, the binding says
// so beside it. The POSIX functions, which the ISO C library lacks, are the
// posix package's, which is built on this one.
//
// This is a C-named module ('@c' on the 'mod' line): each function below binds
// to the C symbol of its own name. Its object defines nothing: the three stream
// functions, 'errno' and 'fabsf' are 'inline'. Being C-named, it gets no prelude, and uses nothing
// of core: core imports it instead, for the allocator its regions call.

mod @c libc;

// A C stream, 'FILE' in stdio.h. Cone has no way yet to declare an opaque
// type, so it is a struct with no fields: a program holds and passes a
// '*FILE' and never looks inside one.
pub struct FILE {}

// stdlib.h: memory. This is the program's one declaration of the C allocator:
// core re-exports 'malloc', so it is a bare name everywhere, and the regions'
// allocation and release call these same functions.
pub extern {
  fn malloc(size usize) *u8;
  fn calloc(count usize, size usize) *u8;
  fn realloc(p *u8, size usize) *u8;
  fn free(p *u8);
}

// stdlib.h: the environment and the process
pub extern {
  fn getenv(name *u8) *u8;
  fn system(command *u8) i32;
  // Neither returns, which 'Never' says, so either may end a block that must
  // produce a value. Ends the program, flushing every stream
  fn exit(status i32) Never;
  // Ends the program at once and abnormally: nothing more of it runs, and
  // what is buffered for a stream is not written
  fn abort() Never;
}

// stdio.h: files
pub extern {
  fn fopen(path *u8, mode *u8) *FILE;
  fn fclose(stream *FILE) i32;
  fn fread(buf *u8, size usize, count usize, stream *FILE) usize;
  fn fwrite(buf *u8, size usize, count usize, stream *FILE) usize;
  fn fflush(stream *FILE) i32;
  // Nonzero once a read or write on the stream has failed, which tells a
  // short 'fread' that failed from one that reached the end
  fn ferror(stream *FILE) i32;
  // Removes a file. On Windows it refuses a directory (EACCES); posix's
  // 'rmdir' removes an empty one
  fn remove(path *u8) i32;
  // Gives a file or directory a new name, which may be in another directory
  // on the same volume. Where 'to' is already there, POSIX replaces it; the
  // Windows runtime refuses (EEXIST, or EACCES for a directory)
  fn rename(from *u8, to *u8) i32;
}

// errno.h: the number of the last error a C library function reported,
// which C's 'errno' names as a variable. Most functions set it only when
// they fail, so it is read just after a failure, before any other call. The
// UCRT's 'errno' is a macro calling '_errno', which answers where this
// thread's number is kept; 'errno()' is that expansion, read with
// '*libc.errno()' and set with '*libc.errno() = 0i32'. The ISO C names
// follow; the POSIX names, more of them, are posix's.
extern fn _errno() *i32;
pub fn errno() *i32 inline {_errno();}
pub const EDOM = 33i32;
pub const ERANGE = 34i32;
pub const EILSEQ = 42i32;

// time.h: the time now, in seconds since 1970 (UTC), also stored where 't'
// points unless it is null. The UCRT's 'time' is an inline function calling
// '_time64', whose 64-bit 'time_t' this binds.
pub extern {
  fn @c("_time64") time(t *i64) i64;
}

// time.h (C11): the calendar time now, finer than whole seconds. For 'base'
// TIME_UTC, the one base ISO C defines, it stores the seconds since 1970
// (UTC) and the nanoseconds past them in 'ts', and answers TIME_UTC; 0 when
// it fails. The UCRT's 'timespec_get' is an inline function calling
// '_timespec64_get', whose 64-bit 'struct timespec' this binds; it steps in
// the system clock's 100 ns. 'Timespec' is 'struct _timespec64', measured
// against the runtime's header with cl.exe (x64): 16 bytes, 'tv_sec' at 0
// and 'tv_nsec' (a C 'long') at 8.
pub struct Timespec {
  pub tv_sec i64;
  pub tv_nsec i32;
}
pub const TIME_UTC = 1i32;
pub extern {
  fn @c("_timespec64_get") timespec_get(ts *Timespec, base i32) i32;
}

// string.h: the text of an error number, "No such file or directory" for
// ENOENT. The text is the C library's, good until the next call.
pub extern {
  fn strerror(errnum i32) *u8;
}

// stdio.h: the standard streams. C's 'stdin', 'stdout' and 'stderr' are
// macros, which the UCRT expands to a call of '__acrt_iob_func' with the
// stream's number; these three functions are that expansion.
extern fn __acrt_iob_func(index u32) *FILE;
pub fn stdin() *FILE inline {__acrt_iob_func(0u32);}
pub fn stdout() *FILE inline {__acrt_iob_func(1u32);}
pub fn stderr() *FILE inline {__acrt_iob_func(2u32);}

// locale.h: the program's locale, which starts as "C". 'setlocale' sets one
// category, or all of them, to the locale named, and answers that locale's
// name, or null when it cannot set it; a null name only asks, answering the
// name in force. The answer is the C library's, good until the next call.
// The categories are the UCRT's numbers.
//
// On Windows the narrow file functions ('fopen', 'remove', and posix's
// 'mkdir' and folder listing) read a name in the locale's code page, the
// system's ANSI one (1252, say) under "C", so a UTF-8 name with a byte above
// 127 names some other file. 'setlocale(LC_ALL, &[]".UTF-8")' makes them
// read and answer names as UTF-8, and refuse a name that is not UTF-8.
pub const LC_ALL = 0i32;
pub const LC_COLLATE = 1i32;
pub const LC_CTYPE = 2i32;
pub const LC_MONETARY = 3i32;
pub const LC_NUMERIC = 4i32;
pub const LC_TIME = 5i32;
pub extern {
  fn setlocale(category i32, locale *u8) *u8;
}

// string.h
pub extern {
  fn strlen(s *u8) usize;
  fn strcmp(a *u8, b *u8) i32;
  fn memcpy(dest *u8, src *u8, count usize) *u8;
  fn memset(dest *u8, value i32, count usize) *u8;
}

// math.h: each function in its double form and its float form, which C names
// with an 'f' after it. Angles are radians. Cone's f32 and f64 already have
// 'sqrt', 'sin' and 'cos' as methods, built into the compiler ('x.sqrt()'),
// which is what Cone code writes; these are the C library's own functions.
pub extern {
  fn sqrt(x f64) f64;
  fn sin(x f64) f64;
  fn cos(x f64) f64;
  fn tan(x f64) f64;
  fn asin(x f64) f64;
  fn acos(x f64) f64;
  fn atan(x f64) f64;
  fn atan2(y f64, x f64) f64;
  fn exp(x f64) f64;
  fn log(x f64) f64;
  fn pow(x f64, y f64) f64;
  fn fabs(x f64) f64;
  fn floor(x f64) f64;
  fn ceil(x f64) f64;
  fn fmod(x f64, y f64) f64;

  fn sqrtf(x f32) f32;
  fn sinf(x f32) f32;
  fn cosf(x f32) f32;
  fn tanf(x f32) f32;
  fn asinf(x f32) f32;
  fn acosf(x f32) f32;
  fn atanf(x f32) f32;
  fn atan2f(y f32, x f32) f32;
  fn expf(x f32) f32;
  fn logf(x f32) f32;
  fn powf(x f32, y f32) f32;
  fn floorf(x f32) f32;
  fn ceilf(x f32) f32;
  fn fmodf(x f32, y f32) f32;
}

// math.h: the UCRT has 'fabsf' only as an inline function on x64, which widens
// to 'fabs' and narrows back, so this is that expansion.
pub fn fabsf(x f32) f32 inline {f32.from(fabs(f64.from(x)));}
