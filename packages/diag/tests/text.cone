// The text subscriber's line for a record, and the counters' printout: the
// formats are pinned by this test's .out, whose lines are worked out from
// the record below (kernel 12.3 us = 12,345 ns to a tenth, delivery 0.4 us).

mod text;

import time use Instant, Duration;
import diag use *;

fn main() i32 {
  imm t0 = Instant.fromNanos(5000i64);
  imm r = new OpRecord(3u64, 17u64, kindRecv, outcomeDone, 0u32, 64u64, 2u64,
    t0, t0 + Duration.fromNanos(12345i64), t0 + Duration.fromNanos(12789i64));
  textSubscriber(&r);
  imm f = new OpRecord(3u64, 18u64, kindConnect, outcomeFailed, 1225u32, 0u64, 0u64, t0, t0, t0);
  textSubscriber(&f);
  noSubscriber(&f);
  mut c = Counters.zero();
  c.submit();
  c.submit();
  c.count(outcomeDone);
  c.print("  ");
  0i32;
}
