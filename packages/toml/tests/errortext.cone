// The one line each error of this package gives a person is pinned here, with
// the number fields at their widest, so a change to how it is written fails.

mod errortext;

import testing use *;
import collections use *;
import toml;

fn says(text: String, want: &str, label: &str) { expectStr(text.view(), want, label); }

fn main() i32 {
  says(String() <- toml.TomlError(3u32, String.from("dates and times are not supported")), "line 3: dates and times are not supported", "line");
  says(String() <- toml.TomlError(4294967295u32, String.from("x")), "line 4294967295: x", "widest line");
  done()
}
