// Asking a Document for a table it does not have is a program error, and a
// panic at the line of the call, as a Dict's missing key is: .err pins the
// line. 'has' is the question to ask first.

mod notable;

import stdio use *;
import collections use *;
import toml;

fn main() i32 {
  mut doc = new toml.Document();
  match toml.parse("[package]\nname = \"x\"\n") {
    case mut ok Ok { doc <=> ok.value; }
    case is Error { return 2i32; }
  }
  printStr("asking for [link]\n");
  imm link = doc["link"];
  printStr("not reached\n");
  0i32;
}
