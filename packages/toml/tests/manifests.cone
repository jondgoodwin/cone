// Every Congo manifest in the repository read, each checked as Congo checks
// it, and a few spot-checked; then the manifests and machine configs Congo's
// own tests and README write, as text here. The manifests are found from
// this test's folder: up to the toml package's own folder (its congo.toml
// naming it), whose parent is the packages folder, each of whose folders
// holding a congo.toml is a package; the samples beside the packages folder
// are read too when they are there.
//
// What Congo asks of a manifest (tools/congo/congo.py, 'read_manifest'):
// only the tables [package] and [link]; [package] holding only name,
// version and output, each a string; [link] holding only libraries, paths
// and runtime, each a list of strings. Every repository manifest keeps to that,
// and here each must also be named for its folder and build a library or an
// executable. A manifest that does not is printed with what is wrong.

mod manifests;

import testing use *;
import collections use *;
import stdio use *;
import fs;
import path;
import toml;

fn parsed(text &[]u8, label &[]u8) toml.Document {
  mut doc = new toml.Document();
  match toml.parse(text) {
    case mut ok Ok { doc <=> ok.value; }
    case imm e Error {
      imm m = e.value.message();
      expectStr(m.view(), "<parsed>", label);
    }
  }
  doc;
}

fn str(t &toml.Table, key &[]u8) String {
  match t.getString(key) {
    case imm v Some { v.value.copy(); }
    case is None { String.from("<none>"); }
  }
}

fn list(t &toml.Table, key &[]u8) String {
  match t.getStrings(key) {
    case imm v Some { String.join(v.value.view(), "|"); }
    case is None { String.from("<none>"); }
  }
}

fn isStr(t &toml.Table, key &[]u8, want &[]u8, label &[]u8) {
  imm got = str(t, key);
  expectStr(got.view(), want, label);
}

fn isList(t &toml.Table, key &[]u8, want &[]u8, label &[]u8) {
  imm got = list(t, key);
  expectStr(got.view(), want, label);
}

fn isJoined(l &List[String], want &[]u8, label &[]u8) {
  imm got = String.join(l.view(), "|");
  expectStr(got.view(), want, label);
}

fn oneOf(s &[]u8, a &[]u8, b &[]u8) Bool { s == a or s == b; }

// What is wrong with the manifest at file, read as Congo reads it, for the
// package in the folder named folder: "" when nothing is
fn checkManifest(file &[]u8, folder &[]u8) String {
  mut text = String.empty();
  match fs.readFile(file) {
    case mut ok Ok { text <=> ok.value; }
    case imm e Error { return e.value.message(); }
  }
  mut doc = new toml.Document();
  match toml.parse(text.view()) {
    case mut ok Ok { doc <=> ok.value; }
    case imm e Error { return e.value.message(); }
  }
  if doc.root.entries.len() > 0usize { return String.from("keys outside any table"); }
  imm names = doc.names();
  mut i = 0usize;
  while i < names.len() {
    if not oneOf(names[i].view(), "package", "link") {
      mut m = String.from("a table that is not Congo's: ");
      m.append(names[i].view());
      return m;
    }
    i = i + 1usize;
  }
  if not doc.has("package") { return String.from("no [package]"); }
  imm pkg = doc["package"];
  imm keys = pkg.keys();
  i = 0usize;
  while i < keys.len() {
    if not (oneOf(keys[i].view(), "name", "version") or keys[i].equals("output")) {
      return String.from("a [package] key that is not Congo's");
    }
    i = i + 1usize;
  }
  imm name = str(pkg, "name");
  if not name.equals(folder) { return String.from("its name is not its folder's"); }
  imm version = str(pkg, "version");
  if version.equals("<none>") { return String.from("no version string"); }
  imm output = str(pkg, "output");
  if not oneOf(output.view(), "library", "executable") { return String.from("no output"); }
  if doc.has("link") {
    imm link = doc["link"];
    imm lkeys = link.keys();
    i = 0usize;
    while i < lkeys.len() {
      if not (oneOf(lkeys[i].view(), "libraries", "paths") or lkeys[i].equals("runtime")) {
        return String.from("a [link] key that is not Congo's");
      }
      if link.getStrings(lkeys[i].view()) is None {
        return String.from("a [link] key that is not a list of strings");
      }
      i = i + 1usize;
    }
  }
  String.empty();
}

// Check every folder of registry holding a congo.toml; how many there were
fn checkFolder(registry &[]u8, label &[]u8) usize {
  mut entries = List[fs.DirEntry].empty();
  match fs.readDir(registry) {
    case mut ok Ok { entries <=> ok.value; }
    case imm e Error {
      imm m = e.value.message();
      expectStr(m.view(), "", label);
      return 0usize;
    }
  }
  mut count = 0usize;
  mut bad = 0usize;
  mut i = 0usize;
  while i < entries.len() {
    if entries[i].isDir {
      imm file = path.join(entries[i].path.view(), "congo.toml");
      if fs.isFile(file.view()) {
        count = count + 1usize;
        imm wrong = checkManifest(file.view(), entries[i].name.view());
        if not wrong.isEmpty() {
          bad = bad + 1usize;
          printStr(file.view());
          printStr(": ");
          printStr(wrong.view());
          printStr("\n");
        }
      }
    }
    i = i + 1usize;
  }
  expectUInt(u64.from(bad), 0u64, label);
  count;
}

// The packages folder: the parent of the nearest folder above this test's
// whose congo.toml names the toml package
fn packagesFolder() String {
  mut here = String.empty();
  match fs.currentDir() {
    case mut ok Ok { here <=> ok.value; }
    case is Error { return String.empty(); }
  }
  while not here.isEmpty() {
    imm file = path.join(here.view(), "congo.toml");
    if fs.isFile(file.view()) {
      match fs.readFile(file.view()) {
        case imm t Ok {
          imm doc = parsed(t.value.view(), "a congo.toml above the test");
          if doc.has("package") {
            imm name = str(doc["package"], "name");
            if name.equals("toml") { return path.parent(here.view()); }
          }
        }
        case is Error {}
      }
    }
    imm up = path.parent(here.view());
    if up.equals(here.view()) { return String.empty(); }
    here = up;
  }
  here;
}

fn repository() {
  imm packages = packagesFolder();
  require(not packages.isEmpty(), "the packages folder found");
  imm n = checkFolder(packages.view(), "every package's manifest reads as Congo reads it");
  expect(n >= 31usize, "at least the 31 packages there are today");
  imm repo = path.parent(packages.view());
  imm samples = path.join(repo.view(), "samples");
  if fs.isDir(samples.view()) {
    checkFolder(samples.view(), "every sample's manifest reads as Congo reads it");
  }
  else {
    expect(true, "no samples beside this packages folder");
  }

  // Spot checks, through the files themselves
  imm sdl = readPackage(packages.view(), "sdl");
  isList(sdl["link"], "libraries", "SDL3", "sdl links SDL3");
  isList(sdl["link"], "runtime", "SDL3", "sdl has SDL3.dll copied beside its programs");
  isStr(sdl["package"], "output", "library", "sdl is a library");
  imm process = readPackage(packages.view(), "process");
  isList(process["link"], "libraries", "shell32", "process links shell32");
  imm sync = readPackage(packages.view(), "sync");
  isList(sync["link"], "libraries", "synchronization", "sync links synchronization");
  imm own = readPackage(packages.view(), "toml");
  isStr(own["package"], "version", "0.1.0", "this package's version");
  expect(not own.has("link"), "this package links nothing");
}

fn readPackage(packages &[]u8, name &[]u8) toml.Document {
  imm folder = path.join(packages, name);
  imm file = path.join(folder.view(), "congo.toml");
  mut doc = new toml.Document();
  match fs.readFile(file.view()) {
    case imm t Ok { doc = parsed(t.value.view(), name); }
    case imm e Error {
      imm m = e.value.message();
      expectStr(m.view(), "", name);
    }
  }
  doc;
}

// What Congo's tests and README write: 'congo new''s manifest, the machine
// config, a [link] with paths, and the manifests Congo refuses for what they
// say rather than how they are written
fn congoTexts() {
  imm made = parsed("[package]\nname = \"hello\"\nversion = \"0.1.0\"\noutput = \"executable\"\n", "congo new");
  isStr(made["package"], "output", "executable", "congo new's manifest");
  imm config = parsed("[registry]\nfolders = [\"D:/cone/mypackages\", \"~/cone/vendor\"]\n", "the machine config");
  isList(config["registry"], "folders", "D:/cone/mypackages|~/cone/vendor", "the machine config's folders");
  imm tests = parsed("[registry]\nfolders = [\"C:/Users/x/AppData/Local/Temp/tmp1/pk\", \"C:/b\"]\n", "test_congo's config");
  isList(tests["registry"], "folders", "C:/Users/x/AppData/Local/Temp/tmp1/pk|C:/b", "test_congo's config");
  imm linked = parsed("[package]\nname = \"tri\"\nversion = \"0.1.0\"\noutput = \"library\"\n\n[link]\nlibraries = [\"tri3\"]\npaths = [\"clib\"]\n", "a [link] with paths");
  isList(linked["link"], "paths", "clib", "[link] paths");
  imm readme = parsed("[link]\nlibraries = [\"SDL3\", \"user32\"]\npaths = [\"clib\"]\nruntime = [\"SDL3\"]\n", "the README's [link]");
  isList(readme["link"], "libraries", "SDL3|user32", "the README's libraries");
  isList(readme["link"], "runtime", "SDL3", "the README's runtime");
  // Read, and then refused by Congo for what they hold
  imm deps = parsed("[package]\nname = \"lib1\"\nversion = \"1.0.0\"\noutput = \"library\"\n[dependencies]\nstdio = \"1\"\n", "[dependencies]");
  imm names = deps.names();
  isJoined(&names, "package|dependencies", "[dependencies] is read, for Congo to refuse");
  imm short = parsed("[package]\nname = \"lib1\"\nversion = \"1.0\"\noutput = \"library\"\n", "a short version");
  isStr(short["package"], "version", "1.0", "a short version is read, for Congo to refuse");
  imm libs = parsed("[link]\nlibs = [\"SDL2\"]\n", "a [link] key Congo refuses");
  expect(libs["link"].has("libs"), "an unknown [link] key is read, for Congo to refuse");
}

fn main() i32 {
  repository();
  congoTexts();
  done();
}
