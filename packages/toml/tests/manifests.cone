// Every Congo manifest in the repository read, each checked as Congo checks
// it, and a few spot-checked; then the manifests and machine configs Congo's
// own tests and README write, as text here. The manifests are found from
// this test's folder: up to the toml package's own folder (its congo.toml
// naming it), whose parent is the packages folder, each of whose folders
// holding a congo.toml is a package; the samples beside the packages folder
// are read too when they are there.
//
// What Congo asks of a manifest (tools/congo/congo.py, 'read_manifest'):
// only the tables [package] and [link] (and [link.windows], [link.linux]
// and [link.macos], a system's own part of it); [package] holding only name,
// version and output, each a string, and targets, a list naming "native"
// and perhaps "gpu"; [link] and each of its sections holding only libraries,
// paths and runtime, each a list of strings. Every repository manifest keeps to that,
// and here each must also be named for its folder and build a library or an
// executable. A manifest that does not is printed with what is wrong.

mod manifests;

import testing use *;
import collections use *;
import stdio use *;
import fs;
import path use Path;
import toml;

fn parsed(text: &Array[u8], label: &Array[u8]) toml.Document {
  var doc = toml.Document();
  match toml.parse(text) {
    case var Ok(ok) { doc <-> ok; }
    case let Error(e) {
      let m = e.message();
      expectStr(m.view(), "<parsed>", label);
    }
  }
  doc
}

fn strValue(t: &toml.Table, key: &str) String {
  match t.getString(key) {
    case let Some(v) { v.copy() }
    case is None { String.from("<none>") }
  }
}

fn list(t: &toml.Table, key: &str) String {
  match t.getStrings(key) {
    case let Some(v) { String.join(v.view(), "|") }
    case is None { String.from("<none>") }
  }
}

fn isStr(t: &toml.Table, key: &str, want: &Array[u8], label: &Array[u8]) {
  let got = strValue(t, key);
  expectStr(got.view(), want, label);
}

fn isList(t: &toml.Table, key: &str, want: &Array[u8], label: &Array[u8]) {
  let got = list(t, key);
  expectStr(got.view(), want, label);
}

fn isJoined(l: &List[String], want: &Array[u8], label: &Array[u8]) {
  let got = String.join(l.view(), "|");
  expectStr(got.view(), want, label);
}

fn oneOf(s: &Array[u8], a: &Array[u8], b: &Array[u8]) bool { s == a || s == b }

// What is wrong with the manifest at file, read as Congo reads it, for the
// package in the folder named folder: "" when nothing is
fn checkManifest(file: &Path, folder: &str) String {
  var text = String.empty();
  match fs.readFile(file) {
    case var Ok(ok) { text <-> ok; }
    case let Error(e) { return e.message(); }
  }
  var doc = toml.Document();
  match toml.parse(text.view()) {
    case var Ok(ok) { doc <-> ok; }
    case let Error(e) { return e.message(); }
  }
  if doc.root.entries.len() > 0usize { return String.from("keys outside any table"); }
  let names = doc.names();
  var i = 0usize;
  while i < names.len() {
    if !(oneOf(names[i].view(), "package", "link") || isLinkSection(names[i].view())) {
      var m = String.from("a table that is not Congo's: ");
      m.append(names[i].view());
      return m;
    }
    i = i + 1usize;
  }
  if !doc.has("package") { return String.from("no [package]"); }
  let pkg = doc["package"];
  let keys = pkg.keys();
  i = 0usize;
  while i < keys.len() {
    if !(oneOf(keys[i].view(), "name", "version") || oneOf(keys[i].view(), "output", "targets")) {
      return String.from("a [package] key that is not Congo's");
    }
    i = i + 1usize;
  }
  if pkg.has("targets") {
    match pkg.getStrings("targets") {
      case let Some(t) {
        var native = false;
        var j = 0usize;
        while j < t.len() {
          if t[j].equals("native") { native = true; }
          elif !t[j].equals("gpu") { return String.from("a target that is not Congo's"); }
          j = j + 1usize;
        }
        if !native { return String.from("targets without native"); }
      }
      case is None { return String.from("targets that are not a list of strings"); }
    }
  }
  let name = strValue(pkg, "name");
  if !name.equals(folder) { return String.from("its name is not its folder's"); }
  let version = strValue(pkg, "version");
  if version.equals("<none>") { return String.from("no version string"); }
  let output = strValue(pkg, "output");
  if !oneOf(output.view(), "library", "executable") { return String.from("no output"); }
  // [link], and the sections for each system, hold the same keys
  i = 0usize;
  while i < names.len() {
    if names[i].equals("link") || isLinkSection(names[i].view()) {
      let link = doc[names[i].view()];
      let lkeys = link.keys();
      var j = 0usize;
      while j < lkeys.len() {
        if !(oneOf(lkeys[j].view(), "libraries", "paths") || lkeys[j].equals("runtime")) {
          return String.from("a [link] key that is not Congo's");
        }
        if link.getStrings(lkeys[j].view()) is None {
          return String.from("a [link] key that is not a list of strings");
        }
        j = j + 1usize;
      }
    }
    i = i + 1usize;
  }
  String.empty()
}

// Whether name is a system's section of [link]
fn isLinkSection(name: &str) bool {
  name == "link.windows" || name == "link.linux" || name == "link.macos"
}

// Check every folder of registry holding a congo.toml; how many there were
fn checkFolder(registry: &Path, label: &Array[u8]) usize {
  var entries = List[fs.DirEntry].empty();
  match fs.readDir(registry) {
    case var Ok(ok) { entries <-> ok; }
    case let Error(e) {
      let m = e.message();
      expectStr(m.view(), "", label);
      return 0usize;
    }
  }
  var count = 0usize;
  var bad = 0usize;
  var i = 0usize;
  while i < entries.len() {
    if entries[i].isDir {
      let file = entries[i].path.join("congo.toml");
      if fs.isFile(&file) {
        count = count + 1usize;
        let wrong = checkManifest(&file, entries[i].name.view());
        if !wrong.isEmpty() {
          bad = bad + 1usize;
          printStr(file.view());
          printStr(": ");
          printStr(wrong.view());
          printStr("\n");
        }
      }
    }
    i = i + 1usize;
  }
  expectUInt(u64.from(bad), 0u64, label);
  count
}

// The packages folder: the parent of the nearest folder above this test's
// whose congo.toml names the toml package
fn packagesFolder() Path {
  var here = Path.from("");
  match fs.currentDir() {
    case var Ok(ok) { here <-> ok; }
    case is Error { return Path.from(""); }
  }
  while !here.isEmpty() {
    let file = here.join("congo.toml");
    if fs.isFile(&file) {
      match fs.readFile(&file) {
        case let Ok(t) {
          let doc = parsed(t.view(), "a congo.toml above the test");
          if doc.has("package") {
            let name = strValue(doc["package"], "name");
            if name.equals("toml") { return here.parent(); }
          }
        }
        case is Error {}
      }
    }
    let up = here.parent();
    if up.view() == here.view() { return Path.from(""); }
    here = up;
  }
  here
}

fn repository() {
  let packages = packagesFolder();
  require(!packages.isEmpty(), "the packages folder found");
  let n = checkFolder(&packages, "every package's manifest reads as Congo reads it");
  expect(n >= 31usize, "at least the 31 packages there are today");
  let repo = packages.parent();
  let samples = repo.join("samples");
  if fs.isDir(&samples) {
    checkFolder(&samples, "every sample's manifest reads as Congo reads it");
  }
  else {
    expect(true, "no samples beside this packages folder");
  }

  // Spot checks, through the files themselves
  let sdl = readPackage(&packages, "sdl");
  isList(sdl["link"], "libraries", "SDL3", "sdl links SDL3");
  isList(sdl["link"], "runtime", "SDL3", "sdl has SDL3.dll copied beside its programs");
  isStr(sdl["package"], "output", "library", "sdl is a library");
  let process = readPackage(&packages, "process");
  expect(!process.has("link"), "process has no plain [link]: shell32 is Windows only");
  isList(process["link.windows"], "libraries", "shell32", "process links Windows' shell32");
  let sync = readPackage(&packages, "sync");
  expect(!sync.has("link"), "sync has no plain [link]: synchronization is Windows only");
  isList(sync["link.windows"], "libraries", "synchronization", "sync links Windows' synchronization");
  let iocore = readPackage(&packages, "iocore");
  isList(iocore["link.windows"], "libraries", "ws2_32|ntdll", "iocore links Winsock and ntdll on Windows");
  let tls = readPackage(&packages, "tls");
  expect(!tls.has("link"), "tls has no plain [link]: each system's libraries differ");
  isList(tls["link.windows"], "libraries", "libssl|libcrypto|crypt32", "tls on Windows");
  isList(tls["link.linux"], "libraries", "ssl|crypto", "tls on Linux");
  let geomath = readPackage(&packages, "geomath");
  isList(geomath["package"], "targets", "native|gpu", "geomath is marked for the GPU");
  let own = readPackage(&packages, "toml");
  isStr(own["package"], "version", "0.1.0", "this package's version");
  expect(!own.has("link"), "this package links nothing");
}

fn readPackage(packages: &Path, name: &str) toml.Document {
  let folder = packages.join(name);
  let file = folder.join("congo.toml");
  var doc = toml.Document();
  match fs.readFile(&file) {
    case let Ok(t) { doc = parsed(t.view(), name); }
    case let Error(e) {
      let m = e.message();
      expectStr(m.view(), "", name);
    }
  }
  doc
}

// What Congo's tests and README write: 'congo new''s manifest, the machine
// config, a [link] with paths, and the manifests Congo refuses for what they
// say rather than how they are written
fn congoTexts() {
  let made = parsed("[package]\nname = \"hello\"\nversion = \"0.1.0\"\noutput = \"executable\"\n", "congo new");
  isStr(made["package"], "output", "executable", "congo new's manifest");
  let config = parsed("[registry]\nfolders = [\"D:/cone/mypackages\", \"~/cone/vendor\"]\n", "the machine config");
  isList(config["registry"], "folders", "D:/cone/mypackages|~/cone/vendor", "the machine config's folders");
  let tests = parsed("[registry]\nfolders = [\"C:/Users/x/AppData/Local/Temp/tmp1/pk\", \"C:/b\"]\n", "test_congo's config");
  isList(tests["registry"], "folders", "C:/Users/x/AppData/Local/Temp/tmp1/pk|C:/b", "test_congo's config");
  let linked = parsed("[package]\nname = \"tri\"\nversion = \"0.1.0\"\noutput = \"library\"\n\n[link]\nlibraries = [\"tri3\"]\npaths = [\"clib\"]\n", "a [link] with paths");
  isList(linked["link"], "paths", "clib", "[link] paths");
  let readme = parsed("[link]\nlibraries = [\"SDL3\", \"user32\"]\npaths = [\"clib\"]\nruntime = [\"SDL3\"]\n", "the README's [link]");
  isList(readme["link"], "libraries", "SDL3|user32", "the README's libraries");
  isList(readme["link"], "runtime", "SDL3", "the README's runtime");
  let systems = parsed("[link]\nlibraries = [\"z\"]\n\n[link.windows]\nlibraries = [\"user32\"]\n\n[link.linux]\nlibraries = [\"ssl\", \"crypto\"]\n", "the README's per-system sections");
  isList(systems["link.windows"], "libraries", "user32", "the README's Windows section");
  isList(systems["link.linux"], "libraries", "ssl|crypto", "the README's Linux section");
  // Read, and then refused by Congo for what they hold
  let deps = parsed("[package]\nname = \"lib1\"\nversion = \"1.0.0\"\noutput = \"library\"\n[dependencies]\nstdio = \"1\"\n", "[dependencies]");
  let names = deps.names();
  isJoined(&names, "package|dependencies", "[dependencies] is read, for Congo to refuse");
  let short = parsed("[package]\nname = \"lib1\"\nversion = \"1.0\"\noutput = \"library\"\n", "a short version");
  isStr(short["package"], "version", "1.0", "a short version is read, for Congo to refuse");
  let libs = parsed("[link]\nlibs = [\"SDL2\"]\n", "a [link] key Congo refuses");
  expect(libs["link"].has("libs"), "an unknown [link] key is read, for Congo to refuse");
}

fn main() i32 {
  repository();
  congoTexts();
  done()
}
