// What Congo does with toml: read a package's manifest, check it holds only
// what a manifest may, and take its values out; and what a person sees when
// a manifest strays outside the subset. Run it with
//
//   congo run packages/toml/examples/manifest.cone
//
// and it prints
//
//   window 0.1.0, a library
//   links: SDL3, user32
//   congo.toml: line 3: dates and times are not supported

mod manifest;

import stdio use *;
import collections use *;
import toml;

// The manifest's package, or the reason it cannot be read (an application: the
// parser's error and its own refusals alike are an AnyError)
fn describe(text: &Array[u8]) Result[String, AnyError] {
  let doc = toml.parse(text)?;
  // Only Congo's tables, each table only Congo's keys
  let names = doc.names();
  var i = 0usize;
  while i < names.len() {
    if !(names[i].equals("package") || names[i].equals("link")) {
      var m = String.from("[");
      m.append(names[i].view());
      m.append("] is not part of a Congo manifest");
      return Err[String, AnyError](AnyError.msg(m.view()));
    }
    i = i + 1usize;
  }
  if !doc.has("package") {
    return Err[String, AnyError](AnyError.msg("the manifest needs a [package] table"));
  }
  let pkg = &doc["package"];
  var out = String.empty();
  let Some(n) = pkg.getString("name") else { return Err[String, AnyError](AnyError.msg("[package] name must be a string")); };
  out.append(n.view());
  let Some(v) = pkg.getString("version") else { return Err[String, AnyError](AnyError.msg("[package] version must be a string")); };
  out.append(" ");
  out.append(v.view());
  let Some(o) = pkg.getString("output") else { return Err[String, AnyError](AnyError.msg("[package] output must be a string")); };
  out.append(", a ");
  out.append(o.view());
  if doc.has("link") {
    let Some(l) = doc["link"].getStrings("libraries") else { return Err[String, AnyError](AnyError.msg("[link] libraries must be a list of strings")); };
    out.append("\nlinks: ");
    let shown = String.join(l.view(), ", ");
    out.append(shown.view());
  }
  Ok[String, AnyError](out)
}

fn show(text: &Array[u8]) {
  match describe(text) {
    case let Ok(ok) { printStr(ok.view()); }
    case let Err(e) {
      printStr("congo.toml: ");
      printStr(e.message().view());
    }
  }
  printStr("\n");
}

fn main() {
  show("[package]\nname = \"window\"   # the package\nversion = \"0.1.0\"\noutput = \"library\"\n\n[link]\nlibraries = [\n  \"SDL3\",\n  \"user32\",\n]\n");
  show("[package]\nname = \"window\"\nreleased = 2026-10-01\n");
}
