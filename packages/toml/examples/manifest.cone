// What Congo does with toml: read a package's manifest, check it holds only
// what a manifest may, and take its values out; and what a person sees when
// a manifest strays outside the subset. Run it with
//
//   congo run packages/toml/examples/manifest.cone
//
// and it prints
//
//   window 0.1.0, a library
//   links: SDL3, user32
//   congo.toml: line 3: dates and times are not supported

mod manifest;

import stdio use *;
import collections use *;
import toml;

// The manifest's package, or the reason it cannot be read
fn describe(text: &Array[u8]) Result[String, String] {
  var doc = toml.Document();
  match toml.parse(text) {
    case var Ok(ok) { doc <=> ok; }
    case let Error(e) { return Error[String, String](e.message()); }
  }
  // Only Congo's tables, each table only Congo's keys
  let names = doc.names();
  var i = 0usize;
  while i < names.len() {
    if !(names[i].equals("package") || names[i].equals("link")) {
      var m = String.from("[");
      m.append(names[i].view());
      m.append("] is not part of a Congo manifest");
      return Error[String, String](m);
    }
    i = i + 1usize;
  }
  if !doc.has("package") {
    return Error[String, String](String.from("the manifest needs a [package] table"));
  }
  let pkg = doc["package"];
  var out = String.empty();
  match pkg.getString("name") {
    case let Some(n) { out.append(n.view()); }
    case is None { return Error[String, String](String.from("[package] name must be a string")); }
  }
  match pkg.getString("version") {
    case let Some(v) {
      out.append(" ");
      out.append(v.view());
    }
    case is None { return Error[String, String](String.from("[package] version must be a string")); }
  }
  match pkg.getString("output") {
    case let Some(o) {
      out.append(", a ");
      out.append(o.view());
    }
    case is None { return Error[String, String](String.from("[package] output must be a string")); }
  }
  if doc.has("link") {
    match doc["link"].getStrings("libraries") {
      case let Some(l) {
        out.append("\nlinks: ");
        let shown = String.join(l.view(), ", ");
        out.append(shown.view());
      }
      case is None { return Error[String, String](String.from("[link] libraries must be a list of strings")); }
    }
  }
  Ok[String, String](out)
}

fn show(text: &Array[u8]) {
  match describe(text) {
    case let Ok(ok) { printStr(ok.view()); }
    case let Error(e) {
      printStr("congo.toml: ");
      printStr(e.view());
    }
  }
  printStr("\n");
}

fn main() {
  show("[package]\nname = \"window\"   # the package\nversion = \"0.1.0\"\noutput = \"library\"\n\n[link]\nlibraries = [\n  \"SDL3\",\n  \"user32\",\n]\n");
  show("[package]\nname = \"window\"\nreleased = 2026-10-01\n");
}
