// Pi, from the arcsine series: a while loop adds a smaller fraction on
// every pass, and the digits settle a little further each time.

mod pi;

import stdio use *;

fn main() {
  var terms = 10;        // how many fractions to add up

  // The working values of the arcsine series for pi
  var result = 0.5d;
  var seed = 1d;
  var top = 1d;
  var bot = 1d;
  var twos = 2d;

  // The block runs again and again, as long as terms > 0
  while terms > 0 {
    top *= seed;
    bot *= seed + 1d;
    twos *= 2d * 2d;
    result += top / (bot * (seed + 2d) * twos);
    seed += 2d;
    terms -= 1;
  }
  print <- "π = ", result * 6d, "\n";
}
