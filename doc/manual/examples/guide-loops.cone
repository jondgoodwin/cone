// Repeating: while and each
//
// 'while' repeats a block as long as a condition holds; 'each' runs it once
// for every number in a range. 'break' leaves a loop early, 'continue' skips
// to the next pass, and a loop can give a value, as 'if' and 'match' do.

mod repeating;

import stdio use *;

// while: the condition is checked before every pass
fn gcd(mut a i32, mut b i32) i32 {
  while b != 0 {
    imm r = a % b;
    a = b;
    b = r;
  }
  a;
}

// each over a range: 2 .. n runs through n itself
fn factorial(n i32) i32 {
  mut result = 1;
  each x in 2 .. n {
    result *= x;
  }
  result;
}

// A while with no condition stops only at a 'break'
fn collatzSteps(mut n i32) i32 {
  mut steps = 0;
  while {
    break if n == 1;
    n = if n % 2 == 0 { n / 2; } else { 3 * n + 1; };
    ++steps;
  }
  steps;
}

// A loop as a value: 'break' gives it, and 'else' says what it is
// when the range runs out without one
fn firstSquareOver(limit i32) i32 {
  each x in 1 .. 100 {
    if x * x > limit { break x; }
  } else {
    -1;
  }
}

// A label lets 'continue' move on the outer loop
fn printPrimes(limit i32) {
  print <- "primes:";
  'next: each n in 2 .. limit {
    each d in 2 ..< n {
      continue 'next if n % d == 0;
    }
    print <- " ", n;
  }
  print <- "\n";
}

fn main() {
  print <- "gcd(84, 36) = ", gcd(84, 36), "\n";
  print <- "6! = ", factorial(6), "\n";
  print <- "27 takes ", collatzSteps(27), " steps to reach 1\n";
  print <- "first square over 500: ", firstSquareOver(500), "\n";
  printPrimes(30);

  // ..< stops before its end; 'by' sets the step, and a negative one counts down
  print <- "count down:";
  each x in 10 .. 0 by -2 {
    print <- " ", x;
  }
  print <- "\n";

  // 'continue' skips the rest of this pass
  mut odd = 0;
  each x in 0 ..< 10 {
    continue if x % 2 == 0;
    odd += x;
  }
  print <- "odd numbers below 10 add up to ", odd, "\n";

  // An 'if' after the range skips the numbers that fail it
  print <- "multiples of 7:";
  each x in 1 .. 50 if x % 7 == 0 {
    print <- " ", x;
  }
  print <- "\n";
}
