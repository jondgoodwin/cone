// Gauss's sum, the long way: a List built by a loop, walked with each,
// and summed up with map, filter and sum.

mod gauss;

import stdio use *;
// collections gives us List, Dict and the rest
import collections use *;

fn main() {
  // The numbers 1 to 100, made by a loop that sends one value per pass
  imm numbers = new List[i32] <- each i in 1 .. 100 yield i;

  // each walks a collection, a value at a time
  mut total = 0;
  each n in numbers {
    total += n;
  }
  print <- "1 + 2 + ... + 100 = ", total, "\n";

  // map, filter and sum work on the whole collection at once
  imm odd = numbers.iter().filter(n => n % 2 == 1).count();
  imm squares = numbers.iter().map(n => n * n).sum();
  print <- odd, " are odd, and the squares of all 100 add up to ", squares, "\n";
}
