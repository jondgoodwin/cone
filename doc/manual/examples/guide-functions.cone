// Functions: pi, with a name of its own, worked out to as many terms as
// the caller asks for.

mod pi;

import stdio use *;

// calcpi takes the number of terms, an i32, and gives back an f64.
// '= 10' is a default: a call may leave the number of terms off.
fn calcpi(terms i32 = 10) f64 {
  var left = terms;
  var result = 0.5;
  var seed = 1.0;
  var top = 1.0;
  var bot = 1.0;
  var twos = 2.0;
  while left > 0 {
    top *= seed;
    bot *= seed + 1.0;
    twos *= 2.0 * 2.0;
    result += top / (bot * (seed + 2.0) * twos);
    seed += 2.0;
    left -= 1;
  }
  result * 6.0    // the last expression is what the function gives back
}

fn main() {
  print <- "with 2 terms:  ", calcpi(2), "\n";
  print <- "with 10 terms: ", calcpi(), "\n";
  print <- "with 20 terms: ", calcpi(20), "\n";
}
