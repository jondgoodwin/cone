// Apollo 11's landing, from seconds to hours, minutes and seconds: a function
// hands back two values at once as a tuple, and the caller catches both.

mod landing;

import stdio use *;

// divmod gives back two values: how many times b goes into a,
// and what is left over
fn divmod(a i32, b i32) i32, i32 {
  a / b, a % b
}

fn main() {
  // Apollo 11 touched down on the Moon this many seconds after launch
  let elapsed = 369940;

  // Declare a variable for each answer, then catch both at once
  let minutes i32;
  let seconds i32;
  minutes, seconds = divmod(elapsed, 60);

  let hours i32;
  let mins i32;
  hours, mins = divmod(minutes, 60);
  print <- "It landed ", hours, " hours, ", mins, " minutes and ", seconds, " seconds after launch\n";
}
