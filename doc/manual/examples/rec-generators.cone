// A generator walks a tree in order: written as the recursion it is,
// with 'yield each' handing on the walk of each subtree.

mod treewalk;

import stdio use *;

// A sorted tree kept in an array: each node holds the index
// of its left and right child, or -1 for none
struct Node {
  pub val: i64;
  pub left: i64;
  pub right: i64;
}

// Hands out the nodes in order, smallest first
fn inorder(nodes: &Array[Node], at: usize) yields &Node {
  let n = &nodes[at];
  if n.left >= 0 { yield each inorder(nodes, usize.from(n.left)); }
  yield n;
  if n.right >= 0 { yield each inorder(nodes, usize.from(n.right)); }
}

fn main() {
  //            50
  //          /    \
  //        30      70
  //       /          \
  //     20            80
  let nodes = [Node(50, 1, 2), Node(30, 3, -1), Node(70, -1, 4),
               Node(20, -1, -1), Node(80, -1, -1)];
  each n in inorder(&nodes, 0) {
    print <- n.val, " ";
  }
  print <- "\n";
}
