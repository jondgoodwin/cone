// A with block works on one value part by part: through &mut point,
// .x and .y are point's own fields, changed in place.

mod with1;

import stdio use *;

struct Point {
  pub x f32;
  pub y f32;
}

fn main() {
  var point = new Point(3., 4.);

  // Make point one unit long: .x is point.x, through this
  with &mut point {
    let len = (.x * .x + .y * .y).sqrt();
    if len > 0. {
      .x /= len;
      .y /= len;
    }
  }
  print <- point.x, " ", point.y, "\n";
}
