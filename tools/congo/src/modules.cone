// The module tree of one package (congo.py's Module, scan_folder_module,
// scan_organisational, scan_package and check_module_loops). A tree is held
// flat, in a list: modules[0] is the root, and each module names its parent
// and its children, in name order, by their places in the list.

// An import line that names another package: the import's name, and the
// package's index in the registry
struct Line {
  pub name: String;
  pub pkg: usize;
}

struct Module {
  pub name: String;
  pub files: List[Path];
  pub children: List[usize];
  pub hasParent: bool;
  pub parent: usize;
  pub imports: List[Import];
  pub hasExtends: bool;
  pub extended: Import;      // from the 'mod' line of its first file
  pub lines: List[Line];    // what resolving its imports found, in import order
  pub gpu: bool;            // in the package's gpu/ folder, at any depth: compiled for the GPU too
}

fn newModule(name: &str, file: &Path, hasParent: bool, parent: usize) Module {
  var files = List[Path].empty();
  files.push(file.copy());
  Module(String.from(name), files, List[usize].empty(), hasParent, parent,
    List[Import].empty(), false, noImport(), List[Line].empty(), false)
}

// A file's imports join its module's, each once
fn addImports(m: &mut Module, header: &Header) {
  if header.hasExtends && !m.hasExtends {
    m.hasExtends = true;
    m.extended = header.extended.copy();
  }
  var i = 0usize;
  while i < header.imports.len() {
    let imp = header.imports[i];
    var seen = false;
    var j = 0usize;
    while j < m.imports.len() {
      if m.imports[j].written.equals(imp.written.view()) { seen = true; }
      j = j + 1usize;
    }
    if !seen { m.imports.push(imp.copy()); }
    i = i + 1usize;
  }
}

// A folder's .cone files and its subfolders, each by name
struct Listing {
  pub files: List[Path];
  pub folders: List[Path];
}

fn coneFiles(folder: &Path) Listing {
  var entries = List[fs.DirEntry].empty();
  match fs.readDir(folder) {
    case var ok Ok { entries <-> ok; }
    case let e Error {
      fail(fsMessage(&e));
    }
  }
  var out = Listing(List[Path].empty(), List[Path].empty());
  var i = 0usize;
  while i < entries.len() {
    let entry = entries[i];
    // A link is what it leads to, as Path.is_file and is_dir follow it
    let isFile = if entry.isLink {fs.isFile(&entry.path)} else {entry.isFile};
    let isDir = if entry.isLink {fs.isDir(&entry.path)} else {entry.isDir};
    if isFile && entry.path.extension() == ".cone" { out.files.push(entry.path.copy()); }
    if isDir { out.folders.push(entry.path.copy()); }
    i = i + 1usize;
  }
  out
}

// A child's name and place, to sort children by name
struct Named {
  pub name: String;
  pub index: usize;
}

fn byName(a: &Named, b: &Named) i32 { a.name.compare(b.name.view()) }

// Give module m its children, sorted by name
fn setChildren(mods: &mut List[Module], m: usize, kids: &List[usize]) {
  var named = List[Named].empty();
  var i = 0usize;
  while i < kids.len() {
    let k = *kids[i];
    named.push(Named(mods[k].name.copy(), k));
    i = i + 1usize;
  }
  named.sortBy(&byName);
  let module = &mut mods[m];
  i = 0usize;
  while i < named.len() {
    module.children.push(named[i].index);
    i = i + 1usize;
  }
}

// A module folder, by the rules the compiler's own folder sweep follows
// (compiler/c/doc/nodes/module.md, "The folder tree"): the designated file,
// then the folder's other files by name, then each organisational
// subfolder's files at any depth. A file that opens with its own 'mod' line
// is a one-file submodule, and a subfolder holding its designated file is a
// submodule. Answers the module's place in mods.
fn scanFolderModule(mods: &mut List[Module], name: &str, folder: &Path, designated: &Path,
    hasParent: bool, parent: usize) Result[usize, String] {
  let me = mods.len();
  mods.push(newModule(name, designated, hasParent, parent));
  match scanHeader(designated) {
    case let h Ok { addImports(&mut mods[me], &h); }
    case let e Error { return Error[usize, String](e.copy()); }
  }
  var kids = List[usize].empty();
  let listing = coneFiles(folder);
  var i = 0usize;
  while i < listing.files.len() {
    let file = listing.files[i];
    if !samePath(file, designated) {
      var header = noHeader();
      match scanHeader(file) {
        case var h Ok { header <-> h; }
        case let e Error { return Error[usize, String](e.copy()); }
      }
      if header.hasMod {
        let stem = file.stem();
        let fault = nameFault(stem);
        if !fault.isEmpty() {
          let place = native(file);
          return Error[usize, String](cat(place.view(), ": a one-file module is named by its file: '", stem, "' ", fault.view(),
            "; rename the file and its 'mod' line"));
        }
        let child = mods.len();
        mods.push(newModule(stem, file, true, me));
        addImports(&mut mods[child], &header);
        kids.push(child);
      }
      else {
        // No 'mod' line, so no imports: a module's imports are all in its
        // designated file, and the compiler refuses any here
        let here = &mut mods[me];
        here.files.push(file.copy());
      }
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < listing.folders.len() {
    let sub = listing.folders[i];
    let subName = sub.name();
    if subName != "build" {
      let innerName = cat(subName, ".cone");
      let inner = sub.join(innerName.view());
      if fs.isFile(&inner) {
        let fault = nameFault(subName);
        if !fault.isEmpty() {
          let place = native(&inner);
          return Error[usize, String](cat(place.view(), ": a module folder names its module: '", subName, "' ", fault.view(),
            "; rename the folder, its designated file and its 'mod' line"));
        }
        match scanFolderModule(mods, subName, sub, &inner, true, me) {
          case let k Ok { kids.push(k); }
          case let e Error { return Error[usize, String](e.copy()); }
        }
      }
      else {
        match scanOrganisational(mods, me, sub) {
          case is Ok {}
          case let e Error { return Error[usize, String](e.copy()); }
        }
      }
    }
    i = i + 1usize;
  }
  setChildren(mods, me, &kids);
  Ok[usize, String](me)
}

// An organisational folder's files join the module around it, at any
// depth. A module cannot sit there, since a module sits directly in its
// parent's folder.
fn scanOrganisational(mods: &mut List[Module], m: usize, folder: &Path) Result[void, String] {
  let listing = coneFiles(folder);
  let folderPlace = native(folder);
  var i = 0usize;
  while i < listing.files.len() {
    let file = listing.files[i];
    var hasMod = false;
    match scanHeader(file) {
      case let h Ok { hasMod = h.hasMod; }
      case let e Error { return Error[void, String](e.copy()); }
    }
    if hasMod {
      let place = native(file);
      return Error[void, String](cat(place.view(), ": a file opening with 'mod' is a module, and a module must sit directly in its parent module's folder, not in the organisational folder ", folderPlace.view()));
    }
    // Like any file of the module but its designated one, it has no imports
    let here = &mut mods[m];
    here.files.push(file.copy());
    i = i + 1usize;
  }
  i = 0usize;
  while i < listing.folders.len() {
    let sub = listing.folders[i];
    let innerName = cat(sub.name(), ".cone");
    let inner = sub.join(innerName.view());
    if fs.isFile(&inner) {
      let place = native(&inner);
      return Error[void, String](cat(place.view(), ": a module must sit directly in its parent module's folder, not in the organisational folder ", folderPlace.view()));
    }
    match scanOrganisational(mods, m, sub) {
      case is Ok {}
      case let e Error { return Error[void, String](e.copy()); }
    }
    i = i + 1usize;
  }
  succeeded()
}

// The package's module tree. A package's root module is src/, whose
// designated file is src/<name>.cone, the package's name standing in for the
// folder's, which the compiler's own sweep would not see, since 'src' is not
// 'name'. Congo lists the files, so the compiler never sweeps. A lone file is
// a module of its own and nothing beside it joins.
fn scanPackage(pkg: &Package) Result[List[Module], String] {
  if !fs.isFile(&pkg.src) {
    let place = shown(&pkg.src);
    return Error[List[Module], String](cat("package ", pkg.name.view(), " has no ", place.view(),
      ": a package's root module is src/<name>.cone, named as its manifest names it"));
  }
  var mods = List[Module].empty();
  if pkg.lone {
    mods.push(newModule(pkg.name.view(), &pkg.src, false, 0usize));
    match scanHeader(&pkg.src) {
      case let h Ok { addImports(&mut mods[0usize], &h); }
      case let e Error { return Error[List[Module], String](e.copy()); }
    }
    return Ok[List[Module], String](mods);
  }
  let folder = pkg.src.parent();
  // The name copied, not lent as a view of the package's own String: the call stores
  // text into modules (a module's 'extended'), and the compiler cannot tell the
  // String it replaces from the one lent
  let rootName = pkg.name.copy();
  match scanFolderModule(&mut mods, rootName.view(), &folder, &pkg.src, false, 0usize) {
    case is Ok {}
    case let e Error { return Error[List[Module], String](e.copy()); }
  }
  let gpuFolder = pkg.root.join("gpu");
  if fs.isDir(&gpuFolder) {
    match scanGpuFolder(pkg, &mut mods, &gpuFolder) {
      case is Ok {}
      case let e Error { return Error[List[Module], String](e.copy()); }
    }
  }
  Ok[List[Module], String](mods)
}

// A package's gpu/ folder, beside src/ [Jon 3 Oct 2026]: Cone source that
// runs on the GPU, the folder itself the marking. It holds submodules of the
// package's root module, each laid out as it would be in src/: a file
// opening with its own 'mod' line is a module of one file, named for the
// file, and a subfolder holding its designated file is a module folder,
// scanned by the usual rules. src/ reaches them as it reaches any submodule,
// by name; they are compiled for the CPU as part of the package, and for the
// GPU, without src/, into the package's one .spv. A file with no 'mod' line
// would join no module there, and a folder with no designated file would
// organise nothing, so each is refused.
fn scanGpuFolder(pkg: &Package, mods: &mut List[Module], folder: &Path) Result[void, String] {
  if pkg.gpu {
    let place = native(folder);
    return Error[void, String](cat(place.view(), ": ", pkg.name.view(),
      " is marked for the GPU (targets = [\"native\", \"gpu\"]), so all of it is compiled for the GPU already; a gpu/ folder is for a package that is not: move gpu/'s modules into src/, or take \"gpu\" out of targets"));
  }
  var inSrc = List[usize].empty();
  var i = 0usize;
  while i < mods[0usize].children.len() {
    inSrc.push(*mods[0usize].children[i]);
    i = i + 1usize;
  }
  var found = List[usize].empty();
  let listing = coneFiles(folder);
  i = 0usize;
  while i < listing.files.len() {
    let file = listing.files[i];
    var header = noHeader();
    match scanHeader(file) {
      case var h Ok { header <-> h; }
      case let e Error { return Error[void, String](e.copy()); }
    }
    if !header.hasMod {
      let place = native(file);
      return Error[void, String](cat(place.view(), ": a file in gpu/ opens with its own 'mod' line, as a module of one file named for the file: gpu/ holds the package's GPU modules, and a file with no 'mod' line would join none"));
    }
    let stem = file.stem();
    let fault = nameFault(stem);
    if !fault.isEmpty() {
      let place = native(file);
      return Error[void, String](cat(place.view(), ": a one-file module is named by its file: '", stem, "' ", fault.view(),
        "; rename the file and its 'mod' line"));
    }
    let child = mods.len();
    mods.push(newModule(stem, file, true, 0usize));
    addImports(&mut mods[child], &header);
    found.push(child);
    i = i + 1usize;
  }
  i = 0usize;
  while i < listing.folders.len() {
    let sub = listing.folders[i];
    let subName = sub.name();
    let innerName = cat(subName, ".cone");
    let inner = sub.join(innerName.view());
    if !fs.isFile(&inner) {
      let place = native(sub);
      return Error[void, String](cat(place.view(), ": a folder in gpu/ is a module folder, holding its designated file, ", innerName.view(),
        ": gpu/ holds the package's GPU modules, and a folder with none would be part of no module"));
    }
    let fault = nameFault(subName);
    if !fault.isEmpty() {
      let place = native(&inner);
      return Error[void, String](cat(place.view(), ": a module folder names its module: '", subName, "' ", fault.view(),
        "; rename the folder, its designated file and its 'mod' line"));
    }
    match scanFolderModule(mods, subName, sub, &inner, true, 0usize) {
      case let k Ok { found.push(k); }
      case let e Error { return Error[void, String](e.copy()); }
    }
    i = i + 1usize;
  }
  var kids = List[usize].empty();
  i = 0usize;
  while i < inSrc.len() {
    kids.push(*inSrc[i]);
    i = i + 1usize;
  }
  i = 0usize;
  while i < found.len() {
    let m = *found[i];
    var j = 0usize;
    while j < inSrc.len() {
      let clash = *inSrc[j];
      if mods[clash].name.equals(mods[m].name.view()) {
        let here = native(mods[m].files[0usize]);
        let there = native(mods[clash].files[0usize]);
        return Error[void, String](cat(here.view(), ": ", pkg.name.view(), " has two submodules named '", mods[m].name.view(),
          "', this one in gpu/ and ", there.view(), " in src/; rename one"));
      }
      j = j + 1usize;
    }
    let subtree = walkSubtree(mods, m);
    j = 0usize;
    while j < subtree.len() {
      let here = &mut mods[*subtree[j]];
      here.gpu = true;
      j = j + 1usize;
    }
    kids.push(m);
    i = i + 1usize;
  }
  let root = &mut mods[0usize];
  root.children = List[usize].empty();
  setChildren(mods, 0usize, &kids);
  succeeded()
}

// Module m and every module inside it
fn walkSubtree(mods: &List[Module], m: usize) List[usize] {
  var out = List[usize].empty();
  walkFrom(mods, m, &mut out);
  out
}

// The modules in walk order: each module, then each of its children's walks
fn walkOrder(mods: &List[Module]) List[usize] {
  var out = List[usize].empty();
  walkFrom(mods, 0usize, &mut out);
  out
}

fn walkFrom(mods: &List[Module], m: usize, out: &mut List[usize]) {
  out.push(m);
  var i = 0usize;
  while i < mods[m].children.len() {
    walkFrom(mods, *mods[m].children[i], out);
    i = i + 1usize;
  }
}

// The child of parent named name, the last of that name as a dictionary of
// them keeps it; answers whether there is one
fn sisterNamed(mods: &List[Module], m: usize, name: &str, found: &mut usize) bool {
  if !mods[m].hasParent { return false; }
  let parent = mods[m].parent;
  var any = false;
  var i = 0usize;
  while i < mods[parent].children.len() {
    let c = *mods[parent].children[i];
    if mods[c].name.equals(name) {
      *found = c;
      any = true;
    }
    i = i + 1usize;
  }
  any
}

fn qualified(mods: &List[Module], m: usize) String {
  if !mods[m].hasParent { return mods[m].name.copy(); }
  var q = qualified(mods, mods[m].parent);
  q <- ".", mods[m].name.view();
  q
}

// One step of a module's dependencies: what kind, to which module, and the
// import that wrote it, where one did
const edgeContains = 0u8;
const edgeImports = 1u8;
const edgeExtends = 2u8;
const edgeImportsName = 3u8;

struct Step {
  pub from: usize;
  pub kind: u8;
  pub to: usize;
  pub imp: Import;
}

// What a module depends on: each sister it imports or extends, its parent
// where it imports a name of the parent, and each of its own submodules
fn edges(mods: &List[Module], reg: &Registry, m: usize) List[Step] {
  var out = List[Step].empty();
  var sister = 0usize;
  let module = mods[m];
  if module.hasExtends && sisterNamed(mods, m, module.extended.name.view(), &mut sister) {
    out.push(Step(m, edgeExtends, sister, module.extended.copy()));
  }
  var i = 0usize;
  while i < module.imports.len() {
    let imp = module.imports[i];
    if imp.hasName && !imp.name.equals("core") {
      if sisterNamed(mods, m, imp.name.view(), &mut sister) {
        out.push(Step(m, edgeImports, sister, imp.copy()));
      }
      elif !reg.has(imp.name.view()) && module.hasParent {
        out.push(Step(m, edgeImportsName, module.parent, imp.copy()));
      }
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < module.children.len() {
    out.push(Step(m, edgeContains, *module.children[i], noImport()));
    i = i + 1usize;
  }
  out
}

fn stepText(mods: &List[Module], s: &Step) String {
  let from = qualified(mods, s.from);
  let to = qualified(mods, s.to);
  if s.kind == edgeContains { return cat(from.view(), " contains ", to.view()); }
  var verb = String.empty();
  if s.kind == edgeImports { verb <- "imports"; }
  elif s.kind == edgeExtends { verb <- "extends"; }
  else { verb <- "imports ", s.imp.name.view(), " of"; }
  let place = s.imp.location();
  cat(from.view(), " ", verb.view(), " ", to.view(), " at ", place.view())
}

// Imports are a DAG between the modules of a package too. A module depends
// on each sister it imports or extends, on its parent where it imports a
// name of the parent, and on each of its own submodules: so a child that
// imports a name of its parent closes a loop of two. A loop is refused,
// naming it, as the compiler would refuse it (ErrorImportLoop); the
// compiler's own check is the backstop for a direct conec run.
fn checkModuleLoops(pkg: &Package, mods: &List[Module], reg: &Registry) Result[void, String] {
  var state = List[u8].empty();
  var i = 0usize;
  while i < mods.len() {
    state.push(0u8);
    i = i + 1usize;
  }
  var steps = List[Step].empty();
  visitModule(pkg, mods, reg, 0usize, &mut state, &mut steps)
}

const unvisited = 0u8;
const visiting = 1u8;
const visited = 2u8;

fn visitModule(pkg: &Package, mods: &List[Module], reg: &Registry, m: usize,
    state: &mut List[u8], steps: &mut List[Step]) Result[void, String] {
  state.set(m, visiting);
  let out = edges(mods, reg, m);
  var e = 0usize;
  while e < out.len() {
    let step = out[e];
    let to = step.to;
    steps.push(Step(step.from, step.kind, to, step.imp.copy()));
    if *state[to] == visiting {
      var at = 0usize;
      while steps[at].from != to { at = at + 1usize; }
      var chain = String.empty();
      var text = String.empty();
      var contains = false;
      var j = at;
      while j < steps.len() {
        let q = qualified(mods, steps[j].from);
        chain <- q.view(), " -> ";
        let t = stepText(mods, steps[j]);
        if j > at { text <- "; "; }
        text <- t.view();
        if steps[j].kind == edgeContains { contains = true; }
        j = j + 1usize;
      }
      let last = qualified(mods, to);
      chain <- last.view();
      var hint: &str = "";
      if contains { hint = " A module may not depend on a module that contains it: move what they share into a sister both import."; }
      return Error[void, String](cat("import loop between modules of package ", pkg.name.view(), ": ", chain.view(),
        ". Imports between modules must not loop (", text.view(), ").", hint));
    }
    if *state[to] == unvisited {
      match visitModule(pkg, mods, reg, to, state, steps) {
        case is Ok {}
        case let err Error { return Error[void, String](err.copy()); }
      }
    }
    steps.pop();
    e = e + 1usize;
  }
  state.set(m, visited);
  succeeded()
}
