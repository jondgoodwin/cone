// The module tree of one package (congo.py's Module, scan_folder_module,
// scan_organisational, scan_package and check_module_loops). A tree is held
// flat, in a list: modules[0] is the root, and each module names its parent
// and its children, in name order, by their places in the list.

// An import line that names another package: the import's name, and the
// package's index in the registry
struct Line {
  pub name String;
  pub pkg usize;
}

struct Module {
  pub name String;
  pub files List[String];
  pub children List[usize];
  pub hasParent bool;
  pub parent usize;
  pub imports List[Import];
  pub hasExtends bool;
  pub extended Import;      // from the 'mod' line of its first file
  pub lines List[Line];    // what resolving its imports found, in import order
  pub gpu bool;            // in the package's gpu/ folder, at any depth: compiled for the GPU too
}

fn newModule(name &Array[u8], file &Array[u8], hasParent bool, parent usize) Module {
  mut files = List[String].empty();
  files.push(String.fromBytes(file));
  new Module(String.fromBytes(name), files, List[usize].empty(), hasParent, parent,
    List[Import].empty(), false, noImport(), List[Line].empty(), false);
}

// A file's imports join its module's, each once
fn addImports(m &mut Module, header &Header) {
  if header.hasExtends and not m.hasExtends {
    m.hasExtends = true;
    m.extended = header.extended.copy();
  }
  mut i = 0usize;
  while i < header.imports.len() {
    imm imp = header.imports[i];
    mut seen = false;
    mut j = 0usize;
    while j < m.imports.len() {
      if m.imports[j].written.equals(imp.written.view()) { seen = true; }
      j = j + 1usize;
    }
    if not seen { m.imports.push(imp.copy()); }
    i = i + 1usize;
  }
}

// A folder's .cone files and its subfolders, each by name
struct Listing {
  pub files List[String];
  pub folders List[String];
}

fn coneFiles(folder &Array[u8]) Listing {
  mut entries = List[fs.DirEntry].empty();
  match fs.readDir(folder) {
    case mut ok Ok { entries <=> ok.value; }
    case imm e Error {
      fail(e.value.message());
    }
  }
  mut out = new Listing(List[String].empty(), List[String].empty());
  mut i = 0usize;
  while i < entries.len() {
    imm entry = entries[i];
    imm full = joined(folder, entry.name.view());
    // A link is what it leads to, as Path.is_file and is_dir follow it
    imm isFile = if entry.isLink {fs.isFile(full.view());} else {entry.isFile;};
    imm isDir = if entry.isLink {fs.isDir(full.view());} else {entry.isDir;};
    imm ext = path.extension(entry.name.view());
    if isFile and ext.equals(".cone") { out.files.push(full.copy()); }
    if isDir { out.folders.push(full); }
    i = i + 1usize;
  }
  out;
}

// A child's name and place, to sort children by name
struct Named {
  pub name String;
  pub index usize;
}

fn byName(a &Named, b &Named) i32 { a.name.compare(b.name.view()); }

// Give module m its children, sorted by name
fn setChildren(mods &mut List[Module], m usize, kids &List[usize]) {
  mut named = List[Named].empty();
  mut i = 0usize;
  while i < kids.len() {
    imm k = *kids[i];
    named.push(new Named(mods[k].name.copy(), k));
    i = i + 1usize;
  }
  named.sortBy(&byName);
  imm module = &mut mods[m];
  i = 0usize;
  while i < named.len() {
    module.children.push(named[i].index);
    i = i + 1usize;
  }
}

// A module folder, by the rules the compiler's own folder sweep follows
// (compiler/c/doc/nodes/module.md, "The folder tree"): the designated file,
// then the folder's other files by name, then each organisational
// subfolder's files at any depth. A file that opens with its own 'mod' line
// is a one-file submodule, and a subfolder holding its designated file is a
// submodule. Answers the module's place in mods.
fn scanFolderModule(mods &mut List[Module], name &Array[u8], folder &Array[u8], designated &Array[u8],
    hasParent bool, parent usize) Result[usize, String] {
  imm me = mods.len();
  mods.push(newModule(name, designated, hasParent, parent));
  match scanHeader(designated) {
    case imm h Ok { addImports(&mut mods[me], &h.value); }
    case imm e Error { return Error[usize, String][e.value.copy()]; }
  }
  mut kids = List[usize].empty();
  imm listing = coneFiles(folder);
  mut i = 0usize;
  while i < listing.files.len() {
    imm file = listing.files[i].view();
    if not samePath(file, designated) {
      mut header = noHeader();
      match scanHeader(file) {
        case mut h Ok { header <=> h.value; }
        case imm e Error { return Error[usize, String][e.value.copy()]; }
      }
      if header.hasMod {
        imm stem = path.stem(file);
        imm fault = nameFault(stem.view());
        if not fault.isEmpty() {
          return Error[usize, String][cat(file, ": a one-file module is named by its file: '", stem.view(), "' ", fault.view(),
            "; rename the file and its 'mod' line")];
        }
        imm child = mods.len();
        mods.push(newModule(stem.view(), file, true, me));
        addImports(&mut mods[child], &header);
        kids.push(child);
      }
      else {
        // No 'mod' line, so no imports: a module's imports are all in its
        // designated file, and the compiler refuses any here
        imm here = &mut mods[me];
        here.files.push(String.from(file));
      }
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < listing.folders.len() {
    imm sub = listing.folders[i].view();
    imm subName = path.name(sub);
    if not subName.equals("build") {
      imm innerName = cat(subName.view(), ".cone");
      imm inner = joined(sub, innerName.view());
      if fs.isFile(inner.view()) {
        imm fault = nameFault(subName.view());
        if not fault.isEmpty() {
          return Error[usize, String][cat(inner.view(), ": a module folder names its module: '", subName.view(), "' ", fault.view(),
            "; rename the folder, its designated file and its 'mod' line")];
        }
        match scanFolderModule(mods, subName.view(), sub, inner.view(), true, me) {
          case imm k Ok { kids.push(k.value); }
          case imm e Error { return Error[usize, String][e.value.copy()]; }
        }
      }
      else {
        match scanOrganisational(mods, me, sub) {
          case is Ok {}
          case imm e Error { return Error[usize, String][e.value.copy()]; }
        }
      }
    }
    i = i + 1usize;
  }
  setChildren(mods, me, &kids);
  Ok[usize, String][me];
}

// An organisational folder's files join the module around it, at any
// depth. A module cannot sit there, since a module sits directly in its
// parent's folder.
fn scanOrganisational(mods &mut List[Module], m usize, folder &Array[u8]) Result[void, String] {
  imm listing = coneFiles(folder);
  mut i = 0usize;
  while i < listing.files.len() {
    imm file = listing.files[i].view();
    mut hasMod = false;
    match scanHeader(file) {
      case imm h Ok { hasMod = h.value.hasMod; }
      case imm e Error { return Error[void, String][e.value.copy()]; }
    }
    if hasMod {
      return Error[void, String][cat(file, ": a file opening with 'mod' is a module, and a module must sit directly in its parent module's folder, not in the organisational folder ", folder)];
    }
    // Like any file of the module but its designated one, it has no imports
    imm here = &mut mods[m];
    here.files.push(String.from(file));
    i = i + 1usize;
  }
  i = 0usize;
  while i < listing.folders.len() {
    imm sub = listing.folders[i].view();
    imm subName = path.name(sub);
    imm innerName = cat(subName.view(), ".cone");
    imm inner = joined(sub, innerName.view());
    if fs.isFile(inner.view()) {
      return Error[void, String][cat(inner.view(), ": a module must sit directly in its parent module's folder, not in the organisational folder ", folder)];
    }
    match scanOrganisational(mods, m, sub) {
      case is Ok {}
      case imm e Error { return Error[void, String][e.value.copy()]; }
    }
    i = i + 1usize;
  }
  succeeded();
}

// The package's module tree. A package's root module is src/, whose
// designated file is src/<name>.cone, the package's name standing in for the
// folder's, which the compiler's own sweep would not see, since 'src' is not
// 'name'. Congo lists the files, so the compiler never sweeps. A lone file is
// a module of its own and nothing beside it joins.
fn scanPackage(pkg &Package) Result[List[Module], String] {
  if not fs.isFile(pkg.src.view()) {
    imm place = shown(pkg.src.view());
    return Error[List[Module], String][cat("package ", pkg.name.view(), " has no ", place.view(),
      ": a package's root module is src/<name>.cone, named as its manifest names it")];
  }
  mut mods = List[Module].empty();
  if pkg.lone {
    mods.push(newModule(pkg.name.view(), pkg.src.view(), false, 0usize));
    match scanHeader(pkg.src.view()) {
      case imm h Ok { addImports(&mut mods[0usize], &h.value); }
      case imm e Error { return Error[List[Module], String][e.value.copy()]; }
    }
    return Ok[List[Module], String][mods];
  }
  imm folder = parentOf(pkg.src.view());
  match scanFolderModule(&mut mods, pkg.name.view(), folder.view(), pkg.src.view(), false, 0usize) {
    case is Ok {}
    case imm e Error { return Error[List[Module], String][e.value.copy()]; }
  }
  imm gpuFolder = joined(pkg.root.view(), "gpu");
  if fs.isDir(gpuFolder.view()) {
    match scanGpuFolder(pkg, &mut mods, gpuFolder.view()) {
      case is Ok {}
      case imm e Error { return Error[List[Module], String][e.value.copy()]; }
    }
  }
  Ok[List[Module], String][mods];
}

// A package's gpu/ folder, beside src/ [Jon 3 Oct 2026]: Cone source that
// runs on the GPU, the folder itself the marking. It holds submodules of the
// package's root module, each laid out as it would be in src/: a file
// opening with its own 'mod' line is a module of one file, named for the
// file, and a subfolder holding its designated file is a module folder,
// scanned by the usual rules. src/ reaches them as it reaches any submodule,
// by name; they are compiled for the CPU as part of the package, and for the
// GPU, without src/, into the package's one .spv. A file with no 'mod' line
// would join no module there, and a folder with no designated file would
// organise nothing, so each is refused.
fn scanGpuFolder(pkg &Package, mods &mut List[Module], folder &Array[u8]) Result[void, String] {
  if pkg.gpu {
    return Error[void, String][cat(folder, ": ", pkg.name.view(),
      " is marked for the GPU (targets = [\"native\", \"gpu\"]), so all of it is compiled for the GPU already; a gpu/ folder is for a package that is not: move gpu/'s modules into src/, or take \"gpu\" out of targets")];
  }
  mut inSrc = List[usize].empty();
  mut i = 0usize;
  while i < mods[0usize].children.len() {
    inSrc.push(*mods[0usize].children[i]);
    i = i + 1usize;
  }
  mut found = List[usize].empty();
  imm listing = coneFiles(folder);
  i = 0usize;
  while i < listing.files.len() {
    imm file = listing.files[i].view();
    mut header = noHeader();
    match scanHeader(file) {
      case mut h Ok { header <=> h.value; }
      case imm e Error { return Error[void, String][e.value.copy()]; }
    }
    if not header.hasMod {
      return Error[void, String][cat(file, ": a file in gpu/ opens with its own 'mod' line, as a module of one file named for the file: gpu/ holds the package's GPU modules, and a file with no 'mod' line would join none")];
    }
    imm stem = path.stem(file);
    imm fault = nameFault(stem.view());
    if not fault.isEmpty() {
      return Error[void, String][cat(file, ": a one-file module is named by its file: '", stem.view(), "' ", fault.view(),
        "; rename the file and its 'mod' line")];
    }
    imm child = mods.len();
    mods.push(newModule(stem.view(), file, true, 0usize));
    addImports(&mut mods[child], &header);
    found.push(child);
    i = i + 1usize;
  }
  i = 0usize;
  while i < listing.folders.len() {
    imm sub = listing.folders[i].view();
    imm subName = path.name(sub);
    imm innerName = cat(subName.view(), ".cone");
    imm inner = joined(sub, innerName.view());
    if not fs.isFile(inner.view()) {
      return Error[void, String][cat(sub, ": a folder in gpu/ is a module folder, holding its designated file, ", innerName.view(),
        ": gpu/ holds the package's GPU modules, and a folder with none would be part of no module")];
    }
    imm fault = nameFault(subName.view());
    if not fault.isEmpty() {
      return Error[void, String][cat(inner.view(), ": a module folder names its module: '", subName.view(), "' ", fault.view(),
        "; rename the folder, its designated file and its 'mod' line")];
    }
    match scanFolderModule(mods, subName.view(), sub, inner.view(), true, 0usize) {
      case imm k Ok { found.push(k.value); }
      case imm e Error { return Error[void, String][e.value.copy()]; }
    }
    i = i + 1usize;
  }
  mut kids = List[usize].empty();
  i = 0usize;
  while i < inSrc.len() {
    kids.push(*inSrc[i]);
    i = i + 1usize;
  }
  i = 0usize;
  while i < found.len() {
    imm m = *found[i];
    mut j = 0usize;
    while j < inSrc.len() {
      imm clash = *inSrc[j];
      if mods[clash].name.equals(mods[m].name.view()) {
        return Error[void, String][cat(mods[m].files[0usize].view(), ": ", pkg.name.view(), " has two submodules named '", mods[m].name.view(),
          "', this one in gpu/ and ", mods[clash].files[0usize].view(), " in src/; rename one")];
      }
      j = j + 1usize;
    }
    imm subtree = walkSubtree(mods, m);
    j = 0usize;
    while j < subtree.len() {
      imm here = &mut mods[*subtree[j]];
      here.gpu = true;
      j = j + 1usize;
    }
    kids.push(m);
    i = i + 1usize;
  }
  imm root = &mut mods[0usize];
  root.children = List[usize].empty();
  setChildren(mods, 0usize, &kids);
  succeeded();
}

// Module m and every module inside it
fn walkSubtree(mods &List[Module], m usize) List[usize] {
  mut out = List[usize].empty();
  walkFrom(mods, m, &mut out);
  out;
}

// The modules in walk order: each module, then each of its children's walks
fn walkOrder(mods &List[Module]) List[usize] {
  mut out = List[usize].empty();
  walkFrom(mods, 0usize, &mut out);
  out;
}

fn walkFrom(mods &List[Module], m usize, out &mut List[usize]) {
  out.push(m);
  mut i = 0usize;
  while i < mods[m].children.len() {
    walkFrom(mods, *mods[m].children[i], out);
    i = i + 1usize;
  }
}

// The child of parent named name, the last of that name as a dictionary of
// them keeps it; answers whether there is one
fn sisterNamed(mods &List[Module], m usize, name &Array[u8], found &mut usize) bool {
  if not mods[m].hasParent { return false; }
  imm parent = mods[m].parent;
  mut any = false;
  mut i = 0usize;
  while i < mods[parent].children.len() {
    imm c = *mods[parent].children[i];
    if mods[c].name.equals(name as &str) {
      *found = c;
      any = true;
    }
    i = i + 1usize;
  }
  any;
}

fn qualified(mods &List[Module], m usize) String {
  if not mods[m].hasParent { return mods[m].name.copy(); }
  mut q = qualified(mods, mods[m].parent);
  q <- ".", mods[m].name.view();
  q;
}

// One step of a module's dependencies: what kind, to which module, and the
// import that wrote it, where one did
const edgeContains = 0u8;
const edgeImports = 1u8;
const edgeExtends = 2u8;
const edgeImportsName = 3u8;

struct Step {
  pub from usize;
  pub kind u8;
  pub to usize;
  pub imp Import;
}

// What a module depends on: each sister it imports or extends, its parent
// where it imports a name of the parent, and each of its own submodules
fn edges(mods &List[Module], reg &Registry, m usize) List[Step] {
  mut out = List[Step].empty();
  mut sister = 0usize;
  imm module = mods[m];
  if module.hasExtends and sisterNamed(mods, m, module.extended.name.view(), &mut sister) {
    out.push(new Step(m, edgeExtends, sister, module.extended.copy()));
  }
  mut i = 0usize;
  while i < module.imports.len() {
    imm imp = module.imports[i];
    if imp.hasName and not imp.name.equals("core") {
      if sisterNamed(mods, m, imp.name.view(), &mut sister) {
        out.push(new Step(m, edgeImports, sister, imp.copy()));
      }
      elif not reg.has(imp.name.view()) and module.hasParent {
        out.push(new Step(m, edgeImportsName, module.parent, imp.copy()));
      }
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < module.children.len() {
    out.push(new Step(m, edgeContains, *module.children[i], noImport()));
    i = i + 1usize;
  }
  out;
}

fn stepText(mods &List[Module], s &Step) String {
  imm from = qualified(mods, s.from);
  imm to = qualified(mods, s.to);
  if s.kind == edgeContains { return cat(from.view(), " contains ", to.view()); }
  mut verb = String.empty();
  if s.kind == edgeImports { verb <- "imports"; }
  elif s.kind == edgeExtends { verb <- "extends"; }
  else { verb <- "imports ", s.imp.name.view(), " of"; }
  imm place = s.imp.location();
  cat(from.view(), " ", verb.view(), " ", to.view(), " at ", place.view());
}

// Imports are a DAG between the modules of a package too. A module depends
// on each sister it imports or extends, on its parent where it imports a
// name of the parent, and on each of its own submodules: so a child that
// imports a name of its parent closes a loop of two. A loop is refused,
// naming it, as the compiler would refuse it (ErrorImportLoop); the
// compiler's own check is the backstop for a direct conec run.
fn checkModuleLoops(pkg &Package, mods &List[Module], reg &Registry) Result[void, String] {
  mut state = List[u8].empty();
  mut i = 0usize;
  while i < mods.len() {
    state.push(0u8);
    i = i + 1usize;
  }
  mut steps = List[Step].empty();
  visitModule(pkg, mods, reg, 0usize, &mut state, &mut steps);
}

const unvisited = 0u8;
const visiting = 1u8;
const visited = 2u8;

fn visitModule(pkg &Package, mods &List[Module], reg &Registry, m usize,
    state &mut List[u8], steps &mut List[Step]) Result[void, String] {
  state.set(m, visiting);
  imm out = edges(mods, reg, m);
  mut e = 0usize;
  while e < out.len() {
    imm step = out[e];
    imm to = step.to;
    steps.push(new Step(step.from, step.kind, to, step.imp.copy()));
    if *state[to] == visiting {
      mut at = 0usize;
      while steps[at].from != to { at = at + 1usize; }
      mut chain = String.empty();
      mut text = String.empty();
      mut contains = false;
      mut j = at;
      while j < steps.len() {
        imm q = qualified(mods, steps[j].from);
        chain <- q.view(), " -> ";
        imm t = stepText(mods, steps[j]);
        if j > at { text <- "; "; }
        text <- t.view();
        if steps[j].kind == edgeContains { contains = true; }
        j = j + 1usize;
      }
      imm last = qualified(mods, to);
      chain <- last.view();
      mut hint &Array[u8] = "";
      if contains { hint = " A module may not depend on a module that contains it: move what they share into a sister both import."; }
      return Error[void, String][cat("import loop between modules of package ", pkg.name.view(), ": ", chain.view(),
        ". Imports between modules must not loop (", text.view(), ").", hint)];
    }
    if *state[to] == unvisited {
      match visitModule(pkg, mods, reg, to, state, steps) {
        case is Ok {}
        case imm err Error { return Error[void, String][err.value.copy()]; }
      }
    }
    steps.pop();
    e = e + 1usize;
  }
  state.set(m, visited);
  succeeded();
}
