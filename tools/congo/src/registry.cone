// Packages: the manifest a package folder holds (congo.py's Package,
// read_manifest and read_link), the machine config, and the registry of
// packages found in the registry folders.

// One package of a build: from its manifest, or a lone file standing as one
struct Package {
  pub name: String;
  pub version: String;          // "" for a lone file, which has none
  pub output: String;           // "executable" or "library"
  pub root: Path;               // the package folder; a lone file's own folder
  pub src: Path;                // the root module's designated file
  pub lone: bool;
  pub libraries: List[String];  // [link] libraries
  pub linkPaths: List[Path];    // [link] paths, absolute
  pub runtime: List[String];    // [link] runtime: DLLs, bare names
  pub gpu: bool;                // [package] targets names "gpu": it may be compiled for the GPU

  pub fn label(self: &) String {
    if version.isEmpty() { return name.copy(); }
    cat(name.view(), " v", version.view())
  }

  // Where an include file written by hand used to sit, <name>.cone at the
  // package root. Congo no longer reads one, and says so where it finds one.
  pub fn handInclude(self: &) Path {
    let file = cat(name.view(), ".cone");
    root.join(file.view())
  }
}

fn emptyPackage() Package {
  Package(String.empty(), String.empty(), String.empty(), Path.from(""), Path.from(""),
    false, List[String].empty(), List[Path].empty(), List[String].empty(), false)
}

fn copyStrings(from: &List[String]) List[String] {
  var out = List[String].withCapacity(from.len());
  var i = 0usize;
  while i < from.len() {
    out.push(from[i].copy());
    i = i + 1usize;
  }
  out
}

fn copyPaths(from: &List[Path]) List[Path] {
  var out = List[Path].withCapacity(from.len());
  var i = 0usize;
  while i < from.len() {
    out.push(from[i].copy());
    i = i + 1usize;
  }
  out
}

// MAJOR.MINOR.PATCH, each 0 or a number not starting with 0
fn isVersion(v: &str) bool {
  var parts = 0usize;
  var i = 0usize;
  while parts < 3usize {
    let start = i;
    while i < v.len() && v[i] >= '0' && v[i] <= '9' { i = i + 1usize; }
    if i == start || (v[start] == '0' && i > start + 1usize) { return false; }
    parts = parts + 1usize;
    if parts < 3usize {
      if i >= v.len() || v[i] != '.' { return false; }
      i = i + 1usize;
    }
  }
  i == v.len()
}

// A C library as the linker is told it, without its prefix or suffix
fn isLibraryName(lib: &str) bool {
  if lib.len() == 0usize || !isNameByte(lib[0usize]) { return false; }
  var i = 1usize;
  while i < lib.len() {
    let b = lib[i];
    if !(isNameByte(b) || b == '.' || b == '+' || b == '-') { return false; }
    i = i + 1usize;
  }
  var lower = String.from(lib);
  lower.lowerAscii();
  !(lower.endsWith(".lib") || lower.endsWith(".a") || lower.endsWith(".so")
    || lower.endsWith(".dylib") || lower.endsWith(".dll"))
}

// A file's text as Python's read_text gives it: every line end '\n'
fn readText(file: &Path) Result[String, String] {
  match fs.readFile(file) {
    case var ok Ok {
      var text = String.empty();
      text <=> ok;
      text.replace("\r\n", "\n");
      text.replaceByte('\r', '\n');
      Ok[String, String](text)
    }
    case let e Error { Error[String, String](fsMessage(&e)) }
  }
}

// The TOML document in a file, or the reason it cannot be read
fn readToml(file: &Path) Result[toml.Document, String] {
  var text = String.empty();
  match readText(file) {
    case var ok Ok { text <=> ok; }
    case var e Error {
      var m = String.empty();
      m <=> e;
      return Error[toml.Document, String](m);
    }
  }
  match toml.parse(text.view()) {
    case var ok Ok {
      var doc = toml.Document();
      doc <=> ok;
      Ok[toml.Document, String](doc)
    }
    case let e Error { Error[toml.Document, String](e.message()) }
  }
}

fn manifestError(file: &Path, m: String) Result[Package, String] {
  let place = native(file);
  Error[Package, String](cat(place.view(), ": ", m.view()))
}

// The system Congo runs on, as a [link] section is named: windows, linux or
// macos
fn hostSystem() &str {
  if isWindows() { return "windows"; }
  if isLinux() { return "linux"; }
  "macos"
}

fn isSystemName(key: &str) bool {
  key == "windows" || key == "linux" || key == "macos"
}

// The keys of [link], or of one system's section of it (label is its name in a
// message, "[link]" or "[link.windows]"): the C libraries a program using this
// package must be linked with, folders to search for them, relative to the
// package folder, and the DLLs the program needs beside it to run, which Congo
// copies there. A table's keys are checked whether or not it is this system's
// (a mistake in another system's section is found on every machine), and
// added to pkg after what is there only when apply. "" or what is wrong.
fn readLinkKeys(file: &Path, table: &toml.Table, label: &str, apply: bool, pkg: &mut Package) String {
  let place = native(file);
  let keys = table.keys();
  var i = 0usize;
  while i < keys.len() {
    let key = keys[i].view();
    if key != "libraries" && key != "paths" && key != "runtime" && !(label == "[link]" && isSystemName(key)) {
      return cat(place.view(), ": '", key, "' is not a ", label, " key; the keys are libraries, paths and runtime");
    }
    i = i + 1usize;
  }
  var libraries = List[String].empty();
  var paths = List[String].empty();
  var runtime = List[String].empty();
  if table.has("libraries") {
    match table.getStrings("libraries") {
      case var l Some { libraries <=> l; }
      case is None { return cat(place.view(), ": ", label, " libraries must be a list of strings"); }
    }
  }
  if table.has("paths") {
    match table.getStrings("paths") {
      case var l Some { paths <=> l; }
      case is None { return cat(place.view(), ": ", label, " paths must be a list of strings"); }
    }
  }
  if table.has("runtime") {
    match table.getStrings("runtime") {
      case var l Some { runtime <=> l; }
      case is None { return cat(place.view(), ": ", label, " runtime must be a list of strings"); }
    }
  }
  i = 0usize;
  while i < libraries.len() {
    let lib = libraries[i].view();
    if !isLibraryName(lib) {
      return cat(place.view(), ": ", label, " library \"", lib, "\" must be the library's bare name, such as \"SDL3\": no folder, prefix or suffix, which Congo adds for the linker (and paths says where to look)");
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < runtime.len() {
    let dll = runtime[i].view();
    if !isLibraryName(dll) {
      return cat(place.view(), ": ", label, " runtime \"", dll, "\" must be the DLL's bare name, such as \"SDL3\" for SDL3.dll: no folder or suffix, which Congo adds");
    }
    i = i + 1usize;
  }
  if !apply { return String.empty(); }
  i = 0usize;
  while i < paths.len() {
    let user = expandUser(paths[i].view());
    let vars = expandVars(user.view());
    let given = Path.from(vars.view());
    if given.isAbsolute() {
      pkg.linkPaths.push(resolved(&given));
    }
    else {
      let up = file.parent();
      let full = up.join(&given);
      pkg.linkPaths.push(resolved(&full));
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < libraries.len() {
    pkg.libraries.push(libraries[i].copy());
    i = i + 1usize;
  }
  i = 0usize;
  while i < runtime.len() {
    pkg.runtime.push(runtime[i].copy());
    i = i + 1usize;
  }
  String.empty()
}

// [link] and the section for this system, [link.windows], [link.linux] or
// [link.macos]: the plain table applies on every system, and the system's own
// section adds to it, each list after the plain one's. A section for another
// system is read, so that a mistake in it is found on every machine, and
// contributes nothing. Into pkg; "" or what is wrong.
fn readLink(file: &Path, doc: &toml.Document, pkg: &mut Package) String {
  let place = native(file);
  if doc.has("link") {
    let wrong = readLinkKeys(file, doc["link"], "[link]", true, pkg);
    if !wrong.isEmpty() { return wrong; }
  }
  let names = doc.names();
  var i = 0usize;
  while i < names.len() {
    let name = names[i].view();
    if name.startsWith("link.") && name != "link.windows" && name != "link.linux" && name != "link.macos" {
      return cat(place.view(), ": [", name, "] is not a link section; the sections are [link.windows], [link.linux] and [link.macos]");
    }
    i = i + 1usize;
  }
  if doc.has("link") {
    let plain = doc["link"];
    if plain.has("windows") { return cat(place.view(), ": [link] windows must be a table: write it as [link.windows]"); }
    if plain.has("linux") { return cat(place.view(), ": [link] linux must be a table: write it as [link.linux]"); }
    if plain.has("macos") { return cat(place.view(), ": [link] macos must be a table: write it as [link.macos]"); }
  }
  let host = hostSystem();
  i = 0usize;
  while i < names.len() {
    let name = names[i].view();
    if name == "link.windows" || name == "link.linux" || name == "link.macos" {
      let label = cat("[", name, "]");
      let want = cat("link.", host);
      let apply = name == want.view();
      let wrong = readLinkKeys(file, doc[name], label.view(), apply, pkg);
      if !wrong.isEmpty() { return wrong; }
    }
    i = i + 1usize;
  }
  String.empty()
}

// [package] targets: what the package may be compiled for, "native" (the
// machine Congo runs on) and "gpu"; ["native"] where it is not written.
// Whether it names "gpu", into pkg: GPU compatibility is declared per
// package, and a GPU build refuses a package that is not marked [Jon 3 Oct
// 2026]. The spelling is a placeholder. "" or what is wrong.
fn readTargets(file: &Path, table: &toml.Table, pkg: &mut Package) String {
  if !table.has("targets") { return String.empty(); }
  let place = native(file);
  var targets = List[String].empty();
  match table.getStrings("targets") {
    case var l Some { targets <=> l; }
    case is None {
      return cat(place.view(), ": [package] targets must be a list of targets, such as [\"native\", \"gpu\"]");
    }
  }
  var hasNative = false;
  var i = 0usize;
  while i < targets.len() {
    let target = targets[i].view();
    if target == "native" { hasNative = true; }
    elif target == "gpu" { pkg.gpu = true; }
    else {
      return cat(place.view(), ": [package] targets names \"", target, "\", which is not a target; the targets are \"native\" and \"gpu\"");
    }
    i = i + 1usize;
  }
  if !hasNative {
    return cat(place.view(), ": [package] targets must name \"native\": a package built for the GPU alone is not built yet");
  }
  if pkg.gpu && !pkg.output.equals("library") {
    return cat(place.view(), ": [package] targets names \"gpu\", and an executable is not built for the GPU: put its kernels in its gpu/ folder, or in a library package it imports");
  }
  String.empty()
}

// congo.toml: a [package] table with name, version and output, and, for a
// package that needs C libraries linked, a [link] table and a section of it
// for each system that needs more. There is no dependencies section: the imports in the source are the dependency list,
// and the registries say where each one is.
fn readManifest(file: &Path) Result[Package, String] {
  var doc = toml.Document();
  match readToml(file) {
    case var ok Ok { doc <=> ok; }
    case let e Error {
      return manifestError(file, cat("cannot read the manifest: ", e.view()));
    }
  }
  // Every top-level key, as tomllib's dict holds them: the root's keys, then
  // the tables, in the order written
  var tops = doc.root.keys();
  let names = doc.names();
  var i = 0usize;
  while i < names.len() {
    tops.push(names[i].copy());
    i = i + 1usize;
  }
  i = 0usize;
  while i < tops.len() {
    // A dotted table is under the table its name starts with: [link.linux]
    // is part of [link], and [package.x] of [package]
    let parts = splitText(tops[i].view(), '.');
    let key = parts[0usize].view();
    if key != "package" && key != "link" {
      var extra: &str = "";
      if key == "dependencies" { extra = " There is no dependencies section: a package's imports are its dependencies."; }
      return manifestError(file, cat("[", key, "] is not part of a Congo manifest, which holds [package] and [link].", extra));
    }
    i = i + 1usize;
  }
  if !doc.has("package") {
    return manifestError(file, String.from("the manifest needs a [package] table with name, version and output"));
  }
  let table = doc["package"];
  let keys = table.keys();
  i = 0usize;
  while i < keys.len() {
    let key = keys[i].view();
    if key != "name" && key != "version" && key != "output" && key != "targets" {
      return manifestError(file, cat("'", key, "' is not a [package] key; the keys are name, version, output and targets"));
    }
    i = i + 1usize;
  }
  // A dotted table under [package], [package.x], is a key that is not one
  i = 0usize;
  while i < names.len() {
    let parts = splitText(names[i].view(), '.');
    if parts.len() > 1usize && parts[0usize].equals("package") {
      return manifestError(file, cat("'", parts[1usize].view(), "' is not a [package] key; the keys are name, version, output and targets"));
    }
    i = i + 1usize;
  }
  var pkg = emptyPackage();
  match table.getString("name") {
    case var n Some { pkg.name <=> n; }
    case is None {}
  }
  if !isConeName(pkg.name.view()) {
    return manifestError(file, String.from("[package] name must be a Cone name, such as \"hello\""));
  }
  let fault = nameFault(pkg.name.view());
  if !fault.isEmpty() {
    return manifestError(file, cat("[package] name '", pkg.name.view(), "' ", fault.view(), "; choose another"));
  }
  match table.getString("version") {
    case var v Some { pkg.version <=> v; }
    case is None {}
  }
  if !isVersion(pkg.version.view()) {
    return manifestError(file, String.from("[package] version must be MAJOR.MINOR.PATCH, such as \"0.1.0\""));
  }
  match table.getString("output") {
    case var o Some { pkg.output <=> o; }
    case is None {}
  }
  if !(pkg.output.equals("executable") || pkg.output.equals("library")) {
    return manifestError(file, String.from("[package] output must be \"executable\" or \"library\""));
  }
  let wrongTargets = readTargets(file, table, &mut pkg);
  if !wrongTargets.isEmpty() { return Error[Package, String](wrongTargets); }
  if doc.root.has("link") {
    return manifestError(file, String.from("[link] must be a table, with libraries, paths and runtime"));
  }
  let wrongLink = readLink(file, &doc, &mut pkg);
  if !wrongLink.isEmpty() { return Error[Package, String](wrongLink); }
  let folder = file.parent();
  pkg.root = resolved(&folder);
  let srcName = cat(pkg.name.view(), ".cone");
  let srcDir = pkg.root.join("src");
  pkg.src = srcDir.join(srcName.view());
  Ok[Package, String](pkg)
}

// -------- the machine config and the registries --------

// The Congo home: CONGO_HOME, or ~/.congo
fn congoHome() Path {
  let named = envOr("CONGO_HOME", "");
  if !named.isEmpty() {
    let given = Path.from(named.view());
    return given.normalize();
  }
  let home = Path.fromString(expandUser("~"));
  let h = home.normalize();
  h.join(".congo")
}

fn configPath() Path {
  let home = congoHome();
  home.join("config.toml")
}

// The package folders searched, in order: the Cone repository's packages/
// first, then each folder the machine config lists. The machine config is
// <Congo home>/config.toml:
//
//     [registry]
//     folders = ["D:/cone/mypackages", "~/cone/vendor"]
//     indexes = ["https://example.com/team/registry.git"]
//
// A relative folder is relative to the config file's own folder. The indexes
// are registries of the other kind (index.cone), searched after every folder.
fn registryFolders(repo: &Path) List[Path] {
  var folders = List[Path].empty();
  if !repo.isEmpty() {
    let packages = repo.join("packages");
    if fs.isDir(&packages) { folders.push(packages); }
  }
  let config = configPath();
  if fs.isFile(&config) {
    let place = native(&config);
    var doc = toml.Document();
    match readToml(&config) {
      case var ok Ok { doc <=> ok; }
      case let e Error {
        fail(cat(place.view(), ": cannot read the machine config: ", e.view()));
      }
    }
    var listed = List[String].empty();
    if doc.has("registry") && doc["registry"].has("folders") {
      match doc["registry"].getStrings("folders") {
        case var l Some { listed <=> l; }
        case is None {
          fail(cat(place.view(), ": [registry] folders must be a list of folder paths"));
        }
      }
    }
    var i = 0usize;
    while i < listed.len() {
      let user = expandUser(listed[i].view());
      let vars = expandVars(user.view());
      let given = Path.from(vars.view());
      if given.isAbsolute() {
        folders.push(resolved(&given));
      }
      else {
        let up = config.parent();
        let full = up.join(&given);
        folders.push(resolved(&full));
      }
      i = i + 1usize;
    }
  }
  folders
}

// Package name -> its package, answered from the registry folders in order.
// A package folder is a folder whose subfolders are packages, each found by
// its congo.toml and named by it, not by the subfolder. 'packages' also holds
// the lone file being built, after the registry's.
struct Registry {
  pub folders: List[Path];
  pub packages: List[Package];
  pub byName: Dict[String, usize];
  pub indexes: List[IndexRegistry];   // searched after the folders, by fetchPackage
  pub missed: List[String];           // names no index has, so not looked up again

  // The package of that name, or None
  pub fn find(self: &, name: &str) Option[usize] {
    if !byName.contains(name) { return None; }
    Some[usize](*byName[name])
  }

  pub fn has(self: &, name: &str) bool { byName.contains(name) }

  pub fn missedName(self: &, name: &str) bool {
    var i = 0usize;
    while i < missed.len() {
      if missed[i].equals(name) { return true; }
      i = i + 1usize;
    }
    false
  }

  // The folders and indexes searched, for a message
  pub fn searched(self: &) String {
    if folders.len() == 0usize && indexes.len() == 0usize { return String.from("(no registry folders)"); }
    var out = nativeList(&folders, ", ");
    var i = 0usize;
    while i < indexes.len() {
      if !out.isEmpty() { out <- ", "; }
      out <- indexes[i].url.view();
      i = i + 1usize;
    }
    out
  }

  // Add a package that is in no registry (a lone file), answering its index
  pub fn add(self: &mut, pkg: Package) usize {
    packages.push(pkg);
    packages.len() - 1usize
  }
}

fn readRegistry(folders: List[Path], indexes: &List[String]) Registry {
  var reg = Registry(folders, List[Package].empty(), Dict[String, usize].empty(),
    List[IndexRegistry].empty(), List[String].empty());
  var x = 0usize;
  while x < indexes.len() {
    reg.indexes.push(newIndexRegistry(indexes[x].view()));
    x = x + 1usize;
  }
  var f = 0usize;
  while f < reg.folders.len() {
    let folder = reg.folders[f].copy();
    if !fs.isDir(&folder) {
      let place = native(&folder);
      warn(cat("warning: registry folder ", place.view(), " does not exist"));
    }
    else {
      var entries = List[fs.DirEntry].empty();
      match fs.readDir(&folder) {
        case var ok Ok { entries <=> ok; }
        case let e Error {
          fail(fsMessage(&e));
        }
      }
      var i = 0usize;
      while i < entries.len() {
        let manifest = entries[i].path.join("congo.toml");
        if fs.isFile(&manifest) {
          match readManifest(&manifest) {
            case var ok Ok {
              var pkg = emptyPackage();
              pkg <=> ok;
              if !reg.byName.contains(pkg.name.view()) {
                let name = pkg.name.copy();
                reg.packages.push(pkg);
                reg.byName.insert(name, reg.packages.len() - 1usize);
              }
            }
            case let e Error {
              warn(cat("warning: skipped: ", e.view()));
            }
          }
        }
        i = i + 1usize;
      }
    }
    f = f + 1usize;
  }
  reg
}
