// The header scan: a source file's leading comments, its 'mod' line and its
// 'import' lines, and nothing after them (congo.py's HeaderTokens and
// scan_header), and the words that cannot name a package or a module.

// What one import line names: a package by its name, or a quoted path, which
// a Congo build refuses
struct Import {
  pub hasName: bool;
  pub name: String;      // "" for a quoted path
  pub written: String;   // as written, for messages
  pub file: Path;
  pub line: u32;

  pub fn copy(self: &) Import {
    Import(hasName, name.copy(), written.copy(), file.copy(), line)
  }

  // 'file:line', for messages
  pub fn location(self: &) String {
    var s = shown(&file);
    s <- ":";
    s.appendUInt(u64.from(line));
    s
  }
}

fn noImport() Import { Import(false, String.empty(), String.empty(), Path.from(""), 0u32) }

// A file's header
struct Header {
  pub hasMod: bool;
  pub modName: String;            // the name on the 'mod' line
  pub imports: List[Import];
  pub hasExtends: bool;
  pub extended: Import;        // 'mod a extends b': b, where the line says so
  pub c: bool;                // 'mod @c ...': a C-named module
}

fn noHeader() Header { Header(false, String.empty(), List[Import].empty(), false, noImport(), false) }

// -------- names --------

// Whether word is one of the space-separated words
fn inWords(word: &str, words: &str) bool {
  var start = 0usize;
  var i = 0usize;
  while i <= words.len() {
    if i == words.len() || words[i] == ' ' {
      if i > start && &words[start..<i] == word { return true; }
      start = i + 1usize;
    }
    i = i + 1usize;
  }
  false
}

// The words the compiler's lexer never reads as a name: its keywords, the
// words it reserves for features not built yet (compiler/c/parser/lexer.c,
// keywordInit), and the permissions (compiler/c/corelib/corelib.c), as
// congo.py lists them; test_congo.py checks congo.py's lists against the
// compiler's own
fn isKeyword(w: &str) bool {
  inWords(w, "include import extern pub static macro fn overload const alias typedef struct mod actor trait extends mixin use but enum return with if elif else case match while each in by break continue as is into inline where new trynew await yield selfactor async do void nil null true false undef using let var")
}
fn isReserved(w: &str) bool {
  inWords(w, "baseurl context local selfmethod wait throw catch spawn")
}
fn isPermission(w: &str) bool { inWords(w, "uni mut imm ro mut1 opaq") }

fn isNameStart(b: u8) bool { (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_' }
fn isNameByte(b: u8) bool { isNameStart(b) || (b >= '0' && b <= '9') }

// A Cone name: a letter or '_', then letters, digits or '_' (NAME_RE)
fn isConeName(w: &str) bool {
  if w.len() == 0usize || !isNameStart(w[0usize]) { return false; }
  var i = 1usize;
  while i < w.len() {
    if !isNameByte(w[i]) { return false; }
    i = i + 1usize;
  }
  true
}

// Why a word cannot name a package or a module, or "" where it can
fn nameFault(name: &str) String {
  if !isConeName(name) {
    return String.from("is not a Cone name: a letter or '_', then letters, digits or '_'");
  }
  if isKeyword(name) {
    return String.from("is a Cone keyword, and a keyword cannot name a package or a module");
  }
  if isReserved(name) {
    return String.from("is reserved for a Cone feature not built yet, and cannot name a package or a module");
  }
  if isPermission(name) {
    return String.from("is a Cone permission, and a permission cannot name a package or a module");
  }
  String.empty()
}

// -------- the tokens --------

const tokEof = 0u8;
const tokName = 1u8;
const tokString = 2u8;
const tokPunct = 3u8;

struct Tok {
  pub kind: u8;
  pub value: String;
  pub line: u32;
}

// Just enough of Cone's lexer for a file's header: names, strings and single
// punctuation, with white space and comments (line, and nested block) passed
// over. A malformed token ends the header, and the compiler reports it. A
// byte beyond ASCII counts as a letter, as congo.py's isalpha() counts most.
struct Toks {
  pub text: String;
  pub pos: usize;
  pub line: u32;
  pub ahead: List[Tok];
  pub head: usize;

  pub fn at(self: &, i: usize) u8 { text[i] }

  // Whether the bytes from i are those of s: byte by byte, since i may be
  // inside a character, where a slice of the text would not begin
  pub fn startsAt(self: &, i: usize, s: &str) bool {
    if i + s.len() > text.len() { return false; }
    var k = 0usize;
    while k < s.len() {
      if text[i + k] != s[k] { return false; }
      k = k + 1usize;
    }
    true
  }

  pub fn skip(self: &mut) {
    let n = text.len();
    while pos < n {
      let ch = self.at(pos);
      if ch == '\n' {
        line = line + 1u32;
        pos = pos + 1usize;
      }
      elif ch == ' ' || ch == '\t' || ch == '\r' || ch == 0x0Cu8 || ch == 0x0Bu8 {
        pos = pos + 1usize;
      }
      elif self.startsAt(pos, "//") {
        while pos < n && self.at(pos) != '\n' { pos = pos + 1usize; }
      }
      elif self.startsAt(pos, "/*") {
        var nest = 1usize;
        pos = pos + 2usize;
        while pos < n && nest > 0usize {
          if self.startsAt(pos, "*/") {
            nest = nest - 1usize;
            pos = pos + 2usize;
          }
          elif self.startsAt(pos, "/*") {
            nest = nest + 1usize;
            pos = pos + 2usize;
          }
          else {
            if self.at(pos) == '\n' { line = line + 1u32; }
            pos = pos + 1usize;
          }
        }
      }
      else {
        return;
      }
    }
  }

  pub fn read(self: &mut) Tok {
    self.skip();
    let start = pos;
    let n = text.len();
    if start >= n { return Tok(tokEof, String.empty(), line); }
    let ch = self.at(start);
    if isNameStart(ch) || ch >= 0x80u8 {
      var end = start + 1usize;
      while end < n && (isNameByte(self.at(end)) || self.at(end) >= 0x80u8) { end = end + 1usize; }
      pos = end;
      return Tok(tokName, text.sub(start, end), line);
    }
    if ch == '"' {
      var end = start + 1usize;
      while end < n && self.at(end) != '"' && self.at(end) != '\n' {
        end = end + (if self.at(end) == '\\' {2usize} else {1usize});
      }
      pos = if end + 1usize < n {end + 1usize} else {n};
      let last = if end < n {end} else {n};
      return Tok(tokString, text.sub(start + 1usize, last), line);
    }
    pos = start + 1usize;
    Tok(tokPunct, text.sub(start, start + 1usize), line)
  }

  // Make sure the token k ahead has been read
  pub fn fill(self: &mut, k: usize) {
    while ahead.len() <= head + k {
      let t = self.read();
      ahead.push(t);
    }
  }

  pub fn kindAt(self: &mut, k: usize) u8 {
    self.fill(k);
    ahead[head + k].kind
  }

  pub fn valueAt(self: &mut, k: usize) String {
    self.fill(k);
    ahead[head + k].value.copy()
  }

  pub fn lineAt(self: &mut, k: usize) u32 {
    self.fill(k);
    ahead[head + k].line
  }

  pub fn isTok(self: &mut, k: usize, kind: u8, value: &str) bool {
    self.fill(k);
    let t = ahead[head + k];
    t.kind == kind && t.value.view() == value
  }

  pub fn isName(self: &mut, word: &str, k: usize) bool { self.isTok(k, tokName, word) }

  // Pass over the next token, answering whether it was the punctuation p
  pub fn nextIs(self: &mut, kind: u8, value: &str) bool {
    let was = self.isTok(0usize, kind, value);
    head = head + 1usize;
    was
  }

  pub fn next(self: &mut) { self.fill(0usize); head = head + 1usize; }

  // Pass over the rest of a statement: up to its ';', with any brackets in
  // it (a 'use { ... }' block) balanced
  pub fn skipStatement(self: &mut) {
    var depth = 0i64;
    while true {
      let kind = self.kindAt(0usize);
      let value = self.valueAt(0usize);
      self.next();
      if kind == tokEof { return; }
      if kind == tokPunct {
        let v = value.view();
        if v == "(" || v == "{" || v == "[" { depth = depth + 1i64; }
        elif v == ")" || v == "}" || v == "]" { depth = depth - 1i64; }
        elif v == ";" && depth <= 0i64 { return; }
      }
    }
  }

  // Pass over tokens up to and including the punctuation p, or to the end
  pub fn passTo(self: &mut, p: &str) {
    while self.kindAt(0usize) != tokEof && !self.nextIs(tokPunct, p) {}
  }
}

// The text of a file without its leading byte order marks
fn withoutBom(text: String) String {
  var start = 0usize;
  let t = text.view();
  while start + 3usize <= t.len() && t[start] == 0xEFu8 && t[start + 1usize] == 0xBBu8 && t[start + 2usize] == 0xBFu8 {
    start = start + 3usize;
  }
  if start == 0usize { return text; }
  text.sub(start, t.len())
}

// A source file's header: comments, then its 'mod' line, then its 'import'
// lines, and then Congo stops reading. The 'mod' line is 'mod name',
// optionally 'pub' before and '@c' or '@c(...)' after the keyword, and a
// generic module's '[T, ...]' after the name, then whatever clauses follow:
// 'extends' is read, since it is a dependency like an import, and 'is' and
// 'use' are passed over. 'mod trait' declares a module trait and is not a
// 'mod' line. An 'import' is 'import name' or 'import "path"', optionally with
// 'pub', and whatever 'as' and 'use' clause follow: the name read is the
// package's, whatever name 'as' binds it under.
fn scanHeader(file: &Path) Result[Header, String] {
  var text = String.empty();
  match fs.readFile(file) {
    case Ok(var ok) { text <=> ok; }
    case Error(e) {
      let place = native(file);
      let m = fsMessage(&e);
      return Error[Header, String](cat("cannot read ", place.view(), ": ", m.view()));
    }
  }
  var toks = Toks(withoutBom(text), 0usize, 1u32, List[Tok].empty(), 0usize);
  var header = noHeader();
  var k = if toks.isName("pub", 0usize) {1usize} else {0usize};
  if toks.isName("mod", k) && !toks.isName("trait", k + 1usize) {
    var j = 0usize;
    while j <= k {
      toks.next();
      j = j + 1usize;
    }
    if toks.isTok(0usize, tokPunct, "@") {
      toks.next();
      header.c = toks.nextIs(tokName, "c");
      if toks.isTok(0usize, tokPunct, "(") { toks.passTo(")"); }
    }
    if toks.kindAt(0usize) == tokName {
      header.hasMod = true;
      header.modName = toks.valueAt(0usize);
      toks.next();
      // A generic module's type parameters, 'mod stack[T]', come before its
      // clauses
      if toks.isTok(0usize, tokPunct, "[") { toks.passTo("]"); }
      if toks.isName("extends", 0usize) {
        toks.next();
        if toks.kindAt(0usize) == tokName {
          let v = toks.valueAt(0usize);
          header.hasExtends = true;
          header.extended = Import(true, v.copy(), v.copy(), file.copy(), toks.lineAt(0usize));
        }
      }
    }
    toks.skipStatement();
  }
  while true {
    k = if toks.isName("pub", 0usize) {1usize} else {0usize};
    if !toks.isName("import", k) { break; }
    var j = 0usize;
    while j <= k {
      toks.next();
      j = j + 1usize;
    }
    let kind = toks.kindAt(0usize);
    let v = toks.valueAt(0usize);
    let line = toks.lineAt(0usize);
    if kind == tokName {
      header.imports.push(Import(true, v.copy(), v.copy(), file.copy(), line));
    }
    elif kind == tokString {
      header.imports.push(Import(false, String.empty(), cat("\"", v.view(), "\""), file.copy(), line));
    }
    toks.skipStatement();
  }
  Ok[Header, String](header)
}

// Whether a source file declares a compute entry point, 'fn @compute' (congo.py's
// holds_kernel): read to its end with the header scan's tokens, so that one
// written in a comment or a string does not count
fn holdsKernel(file: &Path) Result[bool, String] {
  var text = String.empty();
  match fs.readFile(file) {
    case Ok(var ok) { text <=> ok; }
    case Error(e) {
      let place = native(file);
      let m = fsMessage(&e);
      return Error[bool, String](cat("cannot read ", place.view(), ": ", m.view()));
    }
  }
  var toks = Toks(withoutBom(text), 0usize, 1u32, List[Tok].empty(), 0usize);
  while toks.kindAt(0usize) != tokEof {
    if toks.isName("fn", 0usize) && toks.isTok(1usize, tokPunct, "@") && toks.isName("compute", 2usize) {
      return Ok[bool, String](true);
    }
    toks.next();
  }
  Ok[bool, String](false)
}
