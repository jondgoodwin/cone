// The order packages are built in, and each one's build description
// (congo.py's resolve_imports, build_order, prelude_needs, closure and
// description).

// One package of the build, scanned, with what its modules import resolved:
// the packages it imports, in the order first seen, and each module's import
// lines (in its Module)
struct Unit {
  pub pkg: usize;
  pub mods: List[Module];
  pub deps: List[usize];
  pub kernels: bool;      // what is compiled for the GPU holds compute entry points
  pub hasGpu: bool;       // it has a gpu/ folder
  pub gpuDeps: List[usize];   // the packages its gpu/ folder imports, first-seen order
}

fn holds(list: &List[usize], v: usize) bool {
  var i = 0usize;
  while i < list.len() {
    if *list[i] == v { return true; }
    i = i + 1usize;
  }
  false
}

// Which of each module's imports name another package. A submodule's import
// of a sister is answered inside the package, and one of a name of its
// parent too: those get no line. An import of 'core' names the prelude,
// which the compiler loads from the same include file its package line names.
fn resolveImports(reg: &Registry, p: usize, scanned: List[Module]) Result[Unit, String] {
  var mods = scanned;
  var deps = List[usize].empty();
  let pkg = reg.packages[p];
  let order = walkOrder(&mods);
  var w = 0usize;
  while w < order.len() {
    let m = *order[w];
    let imports = importsOf(mods[m]);
    // A module of gpu/ is compiled for the GPU without src/, so it may not
    // use src/: not a sister there, and not a name of the root [Jon 3 Oct]
    let fromGpu = mods[m].gpu && mods[m].hasParent && !mods[mods[m].parent].gpu;
    var sister = 0usize;
    if fromGpu && mods[m].hasExtends && sisterNamed(&mods, m, mods[m].extended.name.view(), &mut sister) && !mods[sister].gpu {
      return Error[Unit, String](gpuUsesSrc(pkg, &mods[m].extended, "extends", &mods, true, sister));
    }
    var i = 0usize;
    while i < imports.len() {
      let imp = imports[i];
      if !imp.hasName {
        let place = imp.location();
        return Error[Unit, String](cat(place.view(), ": import ", imp.written.view(),
          ": a Congo build imports a package by its name, not by a path"));
      }
      else if sisterNamed(&mods, m, imp.name.view(), &mut sister) {
        // a sister, answered inside the package
        if fromGpu && !mods[sister].gpu {
          return Error[Unit, String](gpuUsesSrc(pkg, imp, "import", &mods, true, sister));
        }
      }
      else if fromGpu && !imp.name.equals("core") && !reg.has(imp.name.view()) {
        return Error[Unit, String](gpuUsesSrc(pkg, imp, "import", &mods, false, 0usize));
      }
      else if imp.name.equals("core") {
        // The prelude is loaded already; an explicit import of it names the
        // very file it was loaded from, so the two are one module
        match reg.find("core") {
          case let Some(c) {
            if !pkg.name.equals("core") { addLine(&mut mods[m], imp.name.view(), c); }
          }
          case is None {}
        }
      }
      else {
        match reg.find(imp.name.view()) {
          case let Some(f) {
            if !holds(&deps, f) { deps.push(f); }
            addLine(&mut mods[m], imp.name.view(), f);
          }
          case is None {
            // A name of the parent, which the compiler resolves
            if !mods[m].hasParent {
              let place = imp.location();
              let searched = reg.searched();
              return Error[Unit, String](cat(place.view(), ": import ", imp.name.view(), ": no package named '", imp.name.view(),
                "' in the registries searched: ", searched.view()));
            }
          }
        }
      }
      i = i + 1usize;
    }
    w = w + 1usize;
  }
  match checkModuleLoops(pkg, &mods, reg) {
    case is Ok {}
    case let Error(e) { return Error[Unit, String](e.copy()); }
  }
  // Only what is compiled for the GPU has its kernels built, so only its
  // source is read past the headers: a marked package's, or its gpu/ folder's
  var kernels = false;
  var m = 0usize;
  while m < mods.len() && !kernels {
    if pkg.gpu || mods[m].gpu {
      var f = 0usize;
      while f < mods[m].files.len() && !kernels {
        match holdsKernel(mods[m].files[f]) {
          case let Ok(ok) { kernels = ok; }
          case let Error(e) { return Error[Unit, String](e.copy()); }
        }
        f = f + 1usize;
      }
    }
    m = m + 1usize;
  }
  var hasGpu = false;
  var gpuDeps = List[usize].empty();
  w = 0usize;
  while w < order.len() {
    let g = *order[w];
    if mods[g].gpu {
      hasGpu = true;
      var l = 0usize;
      while l < mods[g].lines.len() {
        let dep = mods[g].lines[l].pkg;
        if !reg.packages[dep].name.equals("core") && !holds(&gpuDeps, dep) { gpuDeps.push(dep); }
        l = l + 1usize;
      }
    }
    w = w + 1usize;
  }
  Ok[Unit, String](Unit(p, mods, deps, kernels, hasGpu, gpuDeps))
}

// The refusal of a gpu/ module's import or extends of src/: a sister there,
// or a name of the root module, whose designated file is in src/
fn gpuUsesSrc(pkg: &Package, imp: &Import, verb: &str, mods: &List[Module], isSister: bool, sister: usize) String {
  var what = String.empty();
  if isSister {
    let place = shown(mods[sister].files[0usize]);
    what <- mods[sister].name.view(), " is a module of ", pkg.name.view(), "'s src/ (", place.view(), ")";
  }
  else {
    what <- imp.name.view(), " is no package, so it would be a name of ", pkg.name.view(), "'s root module, in src/";
  }
  let place = imp.location();
  cat(place.view(), ": ", verb, " ", imp.name.view(), ": ", what.view(),
    ", and gpu/ may not use src/: gpu/ is compiled for the GPU without src/. Move what both need into gpu/, which src/ may use")
}

fn importsOf(m: &Module) List[Import] {
  var out = List[Import].empty();
  var i = 0usize;
  while i < m.imports.len() {
    out.push(m.imports[i].copy());
    i = i + 1usize;
  }
  out
}

// An import line for name, replacing one already there
fn addLine(m: &mut Module, name: &str, pkg: usize) {
  var i = 0usize;
  while i < m.lines.len() {
    if m.lines[i].name.equals(name) {
      m.lines.set(i, Line(String.from(name), pkg));
      return;
    }
    i = i + 1usize;
  }
  m.lines.push(Line(String.from(name), pkg));
}

// The first import of name in the package, in walk order; of its gpu/
// folder only, where asked
fn firstImport(unit: &Unit, name: &str, gpuOnly: bool = false) Import {
  let order = walkOrder(&unit.mods);
  var w = 0usize;
  while w < order.len() {
    let m = *order[w];
    var i = 0usize;
    while i < unit.mods[m].imports.len() && (unit.mods[m].gpu || !gpuOnly) {
      if unit.mods[m].imports[i].name.equals(name) { return unit.mods[m].imports[i].copy(); }
      i = i + 1usize;
    }
    w = w + 1usize;
  }
  unreachable("an import the package was found to make")
}

// The packages of a build, each scanned once, and the order they are built
// in, each after what it imports: 'order' holds places in 'units'
struct Plan {
  pub units: List[Unit];
  pub order: List[usize];
  pub state: Dict[String, u8];
  pub stack: List[usize];

  // The unit of the package named name, in the order
  pub fn unitNamed(self: &, reg: &Registry, name: &str, found: &mut usize) bool {
    var i = 0usize;
    while i < order.len() {
      let u = *order[i];
      if reg.packages[units[u].pkg].name.equals(name) {
        *found = u;
        return true;
      }
      i = i + 1usize;
    }
    false
  }

  pub fn stateOf(self: &, name: &str) u8 {
    if !state.contains(name) { return unvisited; }
    *state[name]
  }

  pub fn visit(self: &mut, reg: &Registry, p: usize) Result[void, String] {
    let name = reg.packages[p].name.view();
    state.insert(String.from(name), visiting);
    var scanned = List[Module].empty();
    match scanPackage(reg.packages[p]) {
      case var Ok(ok) { scanned <-> ok; }
      case let Error(e) { return Error[void, String](e.copy()); }
    }
    var unit = Unit(p, List[Module].empty(), List[usize].empty(), false, false, List[usize].empty());
    match resolveImports(reg, p, scanned) {
      case var Ok(ok) { unit <-> ok; }
      case let Error(e) { return Error[void, String](e.copy()); }
    }
    units.push(unit);
    let u = units.len() - 1usize;
    stack.push(u);
    let deps = depsOf(units[u]);
    var d = 0usize;
    while d < deps.len() {
      let dep = *deps[d];
      let depName = reg.packages[dep].name.view();
      if self.stateOf(depName) == visiting {
        var at = 0usize;
        while !reg.packages[units[*stack[at]].pkg].name.equals(depName) { at = at + 1usize; }
        var chain = String.empty();
        var text = String.empty();
        var j = at;
        while j < stack.len() {
          let unitHere = units[*stack[j]];
          let here = reg.packages[unitHere.pkg].name.view();
          let next = if j + 1usize < stack.len() {reg.packages[units[*stack[j + 1usize]].pkg].name.view()} else {depName};
          chain <- here, " -> ";
          if j > at { text <- "; "; }
          let first = firstImport(unitHere, next);
          let place = first.location();
          text <- here, " imports ", next, " at ", place.view();
          j = j + 1usize;
        }
        chain <- depName;
        return Error[void, String](cat("import loop between packages: ", chain.view(), ". Imports between packages must not loop (",
          text.view(), ")."));
      }
      if self.stateOf(depName) == unvisited {
        match self.visit(reg, dep) {
          case is Ok {}
          case let Error(e) { return Error[void, String](e.copy()); }
        }
      }
      d = d + 1usize;
    }
    stack.pop();
    state.insert(String.from(name), visited);
    order.push(u);
    succeeded()
  }
}

fn depsOf(unit: &Unit) List[usize] {
  var out = List[usize].empty();
  var i = 0usize;
  while i < unit.deps.len() {
    out.push(*unit.deps[i]);
    i = i + 1usize;
  }
  out
}

fn emptyPlan() Plan {
  Plan(List[Unit].empty(), List[usize].empty(), Dict[String, u8].empty(), List[usize].empty())
}

// Every package the build needs, each after what it imports. Imports are a
// DAG between packages: a loop is refused, naming it. The prelude, core,
// comes first of all, since every package uses it -- after the packages core
// itself imports (libc), which are C packages, given no prelude by the
// compiler, and so built before it. A package core imports, built on its
// own, needs no core at all.
fn buildOrder(reg: &Registry, top: usize) Result[Plan, String] {
  var plan = emptyPlan();
  let topName = reg.packages[top].name.view();
  if topName != "core" {
    var core = 0usize;
    match reg.find("core") {
      case let Some(c) { core = c; }
      case is None {
        let searched = reg.searched();
        return Error[Plan, String](cat("no package named 'core', the prelude, in the registries searched: ", searched.view()));
      }
    }
    match plan.visit(reg, core) {
      case is Ok {}
      case let Error(e) { return Error[Plan, String](e.copy()); }
    }
    if plan.state.contains(topName) {
      // One of core's own imports: built with what it imports, and no core
      plan = emptyPlan();
    }
  }
  match plan.visit(reg, top) {
    case is Ok {}
    case let Error(e) { return Error[Plan, String](e.copy()); }
  }
  Ok[Plan, String](plan)
}

// The packages core imports, directly or not: the C packages the prelude
// rests on (libc). Each is built before core and gets no prelude, so its
// description has no package line for core, whose include file does not
// exist yet when it is compiled.
fn preludeNeeds(plan: &Plan, reg: &Registry) List[usize] {
  var needs = List[usize].empty();
  var core = 0usize;
  if plan.unitNamed(reg, "core", &mut core) { needsOf(plan, reg, core, &mut needs); }
  needs
}

fn needsOf(plan: &Plan, reg: &Registry, u: usize, needs: &mut List[usize]) {
  var i = 0usize;
  while i < plan.units[u].deps.len() {
    let dep = *plan.units[u].deps[i];
    if !holds(needs, dep) {
      needs.push(dep);
      var du = 0usize;
      if plan.unitNamed(reg, reg.packages[dep].name.view(), &mut du) { needsOf(plan, reg, du, needs); }
    }
    i = i + 1usize;
  }
}

// Every package in the unit's dependency closure, direct or indirect, in
// build order (each after what it imports), the prelude first, after what
// the prelude itself imports. These are the description's PACKAGE LINES: an
// include file is a module file like any other and may import, and what its
// imports reach is found there -- so core's include file's import of libc is
// answered by libc's line, in every description that has core's. The
// prelude's line is also where conec loads the prelude from. A package core
// imports gets neither: it is built before core, and has no prelude.
fn closure(plan: &Plan, reg: &Registry, u: usize) List[usize] {
  var seen = List[usize].empty();
  let p = plan.units[u].pkg;
  var core = 0usize;
  if !reg.packages[p].name.equals("core") && plan.unitNamed(reg, "core", &mut core) {
    let needs = preludeNeeds(plan, reg);
    if !holds(&needs, p) {
      closureOf(plan, reg, core, &mut seen);
      seen.push(plan.units[core].pkg);
    }
  }
  closureOf(plan, reg, u, &mut seen);
  seen
}

fn closureOf(plan: &Plan, reg: &Registry, u: usize, seen: &mut List[usize]) {
  var i = 0usize;
  while i < plan.units[u].deps.len() {
    let dep = *plan.units[u].deps[i];
    if !holds(seen, dep) {
      var du = 0usize;
      if plan.unitNamed(reg, reg.packages[dep].name.view(), &mut du) { closureOf(plan, reg, du, seen); }
      seen.push(dep);
    }
    i = i + 1usize;
  }
}

// What an importer of a package is compiled against: the include file the
// package's own compile generated, <name>.cone in the build folder, beside
// its object. Every package of a build is compiled into that one folder,
// each before what imports it, so the file is there, and current, when an
// importer's compile reads it.
fn includeFor(pkg: &Package, out: &Path) Path {
  let file = cat(pkg.name.view(), ".cone");
  out.join(file.view())
}

// A path as a build description writes it: absolute, with '/', since the
// description is read as Cone source and a backslash begins an escape
fn conePath(p: &Path) String {
  let abs = resolved(p);
  var s = String.from(abs.view());
  s.replace("\"", "\\\"");
  s
}

// The build description of one package; 'out' is the folder the include
// files of the packages it imports are in. Its lines end as Python's
// write_text ends them on Windows, in '\r\n'.
fn description(reg: &Registry, unit: &Unit, mode: &str, output: &str, out: &Path, packages: &List[usize]) String {
  let pkg = reg.packages[unit.pkg];
  let label = pkg.label();
  var text = String.empty();
  text <- "// The build description of ", label.view(), ", written by Congo for conec;\r\n";
  text <- "// rewritten on every build, so edit the source, not this.\r\n";
  text <- "\r\n";
  text <- "build: "; text.append(mode); text <- "\r\n";
  text <- "output: "; text.append(output); text <- "\r\n";
  text <- "\r\n";
  // The package lines: where each package of the closure is found, for an
  // include file's own imports and, for core, for the prelude. Each is the
  // include file that package's compile generated into 'out'. The package's
  // own modules import only what their own lines, below, give them
  var i = 0usize;
  while i < packages.len() {
    let dep = reg.packages[*packages[i]];
    let incl = includeFor(dep, out);
    let place = conePath(&incl);
    text <- "import ", dep.name.view(), ": \"", place.view(), "\"\r\n";
    i = i + 1usize;
  }
  if packages.len() > 0usize { text <- "\r\n"; }
  emit(reg, unit, 0usize, 0usize, out, &mut text);
  text
}

fn emit(reg: &Registry, unit: &Unit, m: usize, depth: usize, out: &Path, text: &mut String) {
  var pad = String.empty();
  var d = 0usize;
  while d < depth {
    pad <- "    ";
    d = d + 1usize;
  }
  let module = unit.mods[m];
  // The names are copied before they are appended: 'text' and 'unit' are both reached
  // through references, and nothing shows 'text' is none of the Strings 'unit' holds
  let moduleName = module.name.copy();
  text <- pad.view(), moduleName.view(), ": {\r\n";
  var i = 0usize;
  while i < module.files.len() {
    let place = conePath(module.files[i]);
    text <- pad.view(), "    \"", place.view(), "\"\r\n";
    i = i + 1usize;
  }
  i = 0usize;
  while i < module.lines.len() {
    let line = module.lines[i];
    let incl = includeFor(reg.packages[line.pkg], out);
    let place = conePath(&incl);
    let importName = line.name.copy();
    text <- pad.view(), "    import ", importName.view(), ": \"", place.view(), "\"\r\n";
    i = i + 1usize;
  }
  i = 0usize;
  while i < module.children.len() {
    emit(reg, unit, *module.children[i], depth + 1usize, out, text);
    i = i + 1usize;
  }
  text <- pad.view(), "}\r\n";
}
