// The compiler, conestd and the linker (congo.py's find_conec,
// warn_if_stale, find_conestd, find_vcvars, is_msvc_linker, msvc_target,
// without_vs_libs and Linker). Windows only, as Congo's linking is for now:
// Microsoft's link.exe in the environment vcvars64.bat sets up.

// CONEC names the compiler; else the Cone repository's own build,
// build/x64-release/conec.exe; else 'conec' on PATH
fn findConec(repo: &Path) Result[Path, String] {
  let named = envOr("CONEC", "");
  if !named.isEmpty() {
    let given = Path.from(named.view());
    let p = given.normalize();
    if !fs.isFile(&p) {
      let place = native(&p);
      return Error[Path, String](cat("CONEC names ", place.view(), ", which does not exist"));
    }
    return Ok[Path, String](p);
  }
  let build = repo.join("build/x64-release/conec.exe");
  if !repo.isEmpty() && fs.isFile(&build) {
    warnIfStale(repo, &build);
    return Ok[Path, String](build);
  }
  let pathList = envOr("PATH", "");
  let onPath = which("conec", pathList.view());
  if !onPath.isEmpty() { return Ok[Path, String](onPath); }
  let place = native(&build);
  Error[Path, String](cat("no conec: set CONEC to the compiler, build it at ", place.view(), ", or put conec on PATH"))
}

// A stale conec fails good sources in ways that look like a language
// regression. The repository's build is checked against its sources, as the
// test runner checks it.
fn warnIfStale(repo: &Path, conec: &Path) {
  var stamp = time.Timestamp();
  match fs.stat(conec) {
    case let s Ok { stamp = s.modified; }
    case is Error { return; }
  }
  let sources = repo.join("compiler/c");
  var entries = List[fs.DirEntry].empty();
  match fs.walk(&sources) {
    case var ok Ok { entries <-> ok; }
    case is Error { return; }
  }
  var i = 0usize;
  while i < entries.len() {
    let entry = entries[i];
    let ext = entry.path.extension();
    if ext == ".c" || ext == ".h" {
      match fs.stat(&entry.path) {
        case let s Ok {
          if s.modified > stamp {
            // The file relative to the repository, as Path.relative_to gives it
            let full = native(&entry.path);
            let base = native(repo);
            let rest = full.sub(base.len() + 1usize, full.len());
            let place = native(conec);
            warn(cat("warning: ", place.view(), " is older than ", rest.view(),
              "; rebuild it (python test/run.py --build) before trusting what it reports"));
            return;
          }
        }
        case is Error {}
      }
    }
    i = i + 1usize;
  }
}

// CONESTD names the runtime library; else it is the one built beside conec
fn findConestd(conec: &Path) Result[Path, String] {
  let named = envOr("CONESTD", "");
  var lib: Path = "";
  if !named.isEmpty() {
    let given = Path.from(named.view());
    lib = given.normalize();
  }
  else {
    let folder = conec.parent();
    lib = folder.join("conestd.lib");
  }
  if !fs.isFile(&lib) {
    let place = native(&lib);
    return Error[Path, String](cat("no conestd library at ", place.view(), "; build it with conec, or set CONESTD"));
  }
  Ok[Path, String](lib)
}

// Arguments for process.run, from slices
fn argList(a: &str, b: &str = "", c: &str = "", d: &str = "", e: &str = "", f: &str = "",
    g: &str = "", h: &str = "", i: &str = "") List[String] {
  var out = List[String].empty();
  out.push(String.from(a));
  if b.len() > 0usize { out.push(String.from(b)); }
  if c.len() > 0usize { out.push(String.from(c)); }
  if d.len() > 0usize { out.push(String.from(d)); }
  if e.len() > 0usize { out.push(String.from(e)); }
  if f.len() > 0usize { out.push(String.from(f)); }
  if g.len() > 0usize { out.push(String.from(g)); }
  if h.len() > 0usize { out.push(String.from(h)); }
  if i.len() > 0usize { out.push(String.from(i)); }
  out
}

// vcvars64.bat: where vswhere says Visual Studio's C++ tools are, else in
// Visual Studio 2022's usual folders; the empty path when there is none
fn findVcvars() Path {
  let programs = envOr("ProgramFiles(x86)", "C:\\Program Files (x86)");
  let pf = Path.from(programs.view());
  let vswhere = pf.join("Microsoft Visual Studio/Installer/vswhere.exe");
  if fs.exists(&vswhere) {
    let tool = native(&vswhere);
    let args = argList(tool.view(), "-latest", "-products", "*",
      "-requires", "Microsoft.VisualStudio.Component.VC.Tools.x86.x64", "-property", "installationPath",
      "-utf8");
    match process.run(args.view()) {
      case let ok Ok {
        let out = utf8Text(ok.stdout.view());
        let trimmed = out.trim();
        let roots = splitLines(trimmed.view());
        if roots.len() > 0usize {
          let root = Path.from(roots[0usize].view());
          let candidate = root.join("VC/Auxiliary/Build/vcvars64.bat");
          if fs.exists(&candidate) { return candidate; }
        }
      }
      case is Error {}
    }
  }
  let editions = splitText("Community Professional Enterprise BuildTools", ' ');
  let studio = Path.from("C:/Program Files/Microsoft Visual Studio/2022");
  var i = 0usize;
  while i < editions.len() {
    let folder = studio.join(editions[i].view());
    let candidate = folder.join("VC/Auxiliary/Build/vcvars64.bat");
    if fs.exists(&candidate) { return candidate; }
    i = i + 1usize;
  }
  Path.from("")
}

// Git for Windows ships a coreutils link.exe, which is not a linker at all,
// so an inherited link.exe is trusted only when it says it is Microsoft's
fn isMsvcLinker(tool: &Path) bool {
  let place = native(tool);
  let args = argList(place.view(), "/?");
  match process.run(args.view(), process.Options(timeout: time.Duration.fromSeconds(20))) {
    case let ok Ok {
      if ok.timedOut { return false; }
      var both = consoleText(ok.stdout.view());
      let err = consoleText(ok.stderr.view());
      both <- err.view();
      both.contains("Microsoft")
    }
    case is Error { false }
  }
}

// The machine a Microsoft link.exe links for, lower-cased (x64, x86,
// arm64), or "" when nothing says. Its folder says first,
// bin\Host<host>\<target>, since that is the linker that would run; else
// what VsDevCmd.bat and vcvars*.bat record, VSCMD_ARG_TGT_ARCH.
fn msvcTarget(tool: &Path) String {
  let folder = tool.parent();
  let above = folder.parent();
  var host = String.from(above.name());
  host.lowerAscii();
  if host.startsWith("host") {
    var target = String.from(folder.name());
    target.lowerAscii();
    return target;
  }
  var target = envOr("VSCMD_ARG_TGT_ARCH", "");
  target.lowerAscii();
  target
}

// A folder as os.path.normcase(os.path.normpath()) spells it, with a '\'
// after it
fn normFolder(p: &str) String {
  let given = Path.from(p);
  let normal = given.normalize();
  var n = native(&normal);
  n.lowerAscii();
  if !n.endsWith("\\") { n <- "\\"; }
  n
}

// LIB with the folders a Visual Studio environment put on it taken out --
// each entry under the Visual Studio or Windows SDK folder the environment
// names -- and every other entry, the user's own, kept in order.
// vcvars64.bat puts its own folders in front of what LIB already lists, and
// an x86 environment's left behind them would still be searched. (PATH
// keeps its x86 folders: vcvars64.bat's link.exe is found first.)
fn withoutVsLibs(changes: &mut EnvChanges) {
  if !envHas("LIB") { return; }
  var roots = List[String].empty();
  let names = splitText("VSINSTALLDIR WindowsSdkDir UniversalCRTSdkDir", ' ');
  var i = 0usize;
  while i < names.len() {
    let root = envOr(names[i].view(), "");
    if !root.isEmpty() { roots.push(normFolder(root.view())); }
    i = i + 1usize;
  }
  let lib = envOr("LIB", "");
  let entries = lib.split(';');
  var kept = List[String].empty();
  i = 0usize;
  while i < entries.len() {
    let entry = entries[i].view();
    if entry.len() > 0usize {
      let place = normFolder(entry);
      var there = false;
      var r = 0usize;
      while r < roots.len() {
        if place.startsWith(roots[r].view()) { there = true; }
        r = r + 1usize;
      }
      if !there { kept.push(String.from(entry)); }
    }
    i = i + 1usize;
  }
  let cleaned = String.join(kept.view(), ";");
  changes.set("LIB", cleaned.view());
}

// What running vcvars64.bat said: the batch file, and what it printed,
// which a failure to find link.exe shows
struct Vcvars {
  pub ran: bool;
  pub file: Path;
  pub printed: String;
}

// vcvars64.bat's environment, taken on by Congo itself (for the link, and
// undone after it), run in the environment Congo has. It keeps what LIB
// already lists, behind its own folders.
fn runVcvars(changes: &mut EnvChanges) Result[Vcvars, String] {
  let vcvars = findVcvars();
  if vcvars.isEmpty() { return Error[Vcvars, String](String.from("no Visual Studio C++ tools (vcvars64.bat) to link with")); }
  let vcvarsText = native(&vcvars);
  // The line as written, not quoted again: cmd would not recognise the
  // batch path. The marker divides what vcvars64.bat prints, in the
  // console's code page, from the environment, which 'cmd /u' prints in
  // UTF-16 so that every value arrives whole.
  let marker: &str = "--congo: vcvars64.bat's environment--";
  let line = cat("cmd /c \"\"", vcvarsText.view(), "\" && echo ", marker, "&& cmd /u /c set\"");
  var out = String.empty();
  var err = String.empty();
  var code = 0u32;
  match process.runLine(line.view()) {
    case let ok Ok {
      out = ok.stdout.copy();
      err = consoleText(ok.stderr.view());
      code = ok.exitCode;
    }
    case let e Error {
      fail(e.message());
    }
  }
  var printed = String.empty();
  var variables = String.empty();
  // What the batch file printed, then UTF-16: bytes, not text
  let raw: &Array[u8] = out.view();
  match out.find(marker) {
    case let at Some {
      printed = consoleText(&raw[..<at]);
      // After the line end echo writes
      var from = at + marker.len();
      if from + 2usize <= raw.len && raw[from] == '\r' && raw[from + 1usize] == '\n' {
        from = from + 2usize;
      }
      variables = utf16Text(&raw[from..]);
    }
    case is None { printed = consoleText(raw); }
  }
  if code != 0u32 || variables.isEmpty() {
    return Error[Vcvars, String](cat(vcvarsText.view(), " failed:\n", printed.view(), err.view()));
  }
  // Each variable set printed, in any spelling of its name, where its value
  // is not what it already is
  let lines = splitLines(variables.view());
  var i = 0usize;
  while i < lines.len() {
    let l = lines[i].view();
    let eq = findByte(l, '=', 0usize);
    if eq < l.len() && eq > 0usize {
      let name = &l[..<eq];
      let value = &l[eq + 1usize..];
      let now = envOr(name, "");
      if !envHas(name) || now.view() != value { changes.set(name, value); }
    }
    i = i + 1usize;
  }
  printed <- err.view();
  Ok[Vcvars, String](Vcvars(true, vcvars.copy(), printed))
}

// Why no Microsoft link.exe was found: which vcvars64.bat ran and how its
// output ended, and the folders searched
fn noLinker(tool: &Path, pathList: &str, ran: &Vcvars) String {
  var text = String.from("no Microsoft link.exe: install Visual Studio's C++ tools (Congo runs vcvars64.bat to find it)");
  if !tool.isEmpty() {
    let place = native(tool);
    text <- "\nthe link.exe found, "; text.append(place.view()); text <- ", is not Microsoft's";
  }
  if ran.ran {
    let trimmed = ran.printed.trim();
    let all = splitLines(trimmed.view());
    let from = if all.len() > 15usize {all.len() - 15usize} else {0usize};
    var said: &str = "(the end of it):";
    if all.len() == 0usize { said = "nothing"; }
    let batch = native(&ran.file);
    text <- "\nran ", batch.view(), ", which printed "; text.append(said);
    var i = from;
    while i < all.len() {
      text <- "\n    ", all[i].view();
      i = i + 1usize;
    }
  }
  text <- "\nsearched for link.exe in PATH's folders:";
  let folders = splitText(pathList, ';');
  var i = 0usize;
  while i < folders.len() {
    if !folders[i].isEmpty() { text <- "\n    ", folders[i].view(); }
    i = i + 1usize;
  }
  text
}

// The linker a build links with: link.exe, conestd, and the environment the
// link runs in, each variable it sets beyond Congo's own
struct Linker {
  pub tool: Path;
  pub conestd: Path;
  pub names: List[String];
  pub values: List[String];

  // Set the link's environment in Congo's own, in changes, for one link
  pub fn apply(self: &, changes: &mut EnvChanges) {
    var i = 0usize;
    while i < names.len() {
      // Copied: 'changes' holds Lists of Strings, and nothing shows they are not these
      let name = names[i].copy();
      let value = values[i].copy();
      changes.set(name.view(), value.view());
      i = i + 1usize;
    }
  }
}

fn noLinkerYet() Linker {
  Linker(Path.from(""), Path.from(""), List[String].empty(), List[String].empty())
}

// The system linker, with the environment it needs: Microsoft's link.exe in
// the environment vcvars64.bat sets up, which Congo produces itself, so no
// Developer Command Prompt is needed. An inherited environment is used only
// when its link.exe is Microsoft's and links for x64, as conec's objects
// are: Visual Studio's default Developer Command Prompt links for x86. The
// environment is worked out in Congo's own and put back after; the Linker
// holds what it set, for each link.
fn findLinker(conestd: &Path) Result[Linker, String] {
  var changes = noChanges();
  match linkerIn(&mut changes) {
    case let ok Ok {
      var linker = Linker(ok.copy(), conestd.copy(), List[String].empty(), List[String].empty());
      var i = 0usize;
      while i < changes.names.len() {
        let name = changes.names[i].view();
        linker.names.push(String.from(name));
        linker.values.push(envOr(name, ""));
        i = i + 1usize;
      }
      changes.restore();
      Ok[Linker, String](linker)
    }
    case let e Error {
      changes.restore();
      Error[Linker, String](e.copy())
    }
  }
}

// link.exe, its environment set in Congo's own, in changes
fn linkerIn(changes: &mut EnvChanges) Result[Path, String] {
  var ran = Vcvars(false, Path.from(""), String.empty());
  let startPath = envOr("PATH", "");
  let inherited = which("link.exe", startPath.view());
  var vcvarsNeeded = false;
  if !(!inherited.isEmpty() && isMsvcLinker(&inherited)) {
    vcvarsNeeded = true;
  }
  else {
    let target = msvcTarget(&inherited);
    if !(target.isEmpty() || target.equals("x64")) {
      // Silently, as when there is no linker: nothing is the user's to fix
      withoutVsLibs(changes);
      vcvarsNeeded = true;
    }
  }
  if vcvarsNeeded {
    match runVcvars(changes) {
      case var ok Ok { ran <-> ok; }
      case let e Error { return Error[Path, String](e.copy()); }
    }
  }
  let pathList = envOr("PATH", "");
  let tool = which("link.exe", pathList.view());
  if tool.isEmpty() || !isMsvcLinker(&tool) {
    return Error[Path, String](noLinker(&tool, pathList.view(), &ran));
  }
  Ok[Path, String](tool)
}
