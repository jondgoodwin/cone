// congo test (congo.py's Tally, normalized_lines, expected_exit, indent,
// programs, run_test, test_package, package_manifests and cmd_test).
//
// The first phase of package testing, and deliberately thin: each program in
// a package's tests/ folder is built as a program that imports the package
// by name, as any user's program does -- the package compiled on its own,
// the test compiled against the include file that compile generated, the
// two linked -- then run, its output and exit status compared with the
// expected files beside it. Every program in examples/ is built. Nothing
// here decides how tests are scaffolded, mocked or asserted, or whether one
// may reach a private name: a test sees what any importer sees.
//
// A test that does not build, crash, time out or print what it should is a
// result, and the next one runs: what fails in a build is answered as a
// value (build.cone), which is what a test reports.

// How long a test program may run before it fails: 60 seconds
const testTimeoutSeconds = 60i64;

// What 'congo test' counts, for a package and for them all
struct Tally {
  pub passed u64;
  pub failed u64;
  pub skipped u64;           // debug-only tests, not built or run in a release test
  pub built u64;
  pub unbuilt u64;
  pub broken u64;            // packages that did not build, so nothing of theirs ran
  pub failures List[String];

  pub fn add(self &mut, other &Tally) {
    passed = passed + other.passed;
    failed = failed + other.failed;
    skipped = skipped + other.skipped;
    built = built + other.built;
    unbuilt = unbuilt + other.unbuilt;
    broken = broken + other.broken;
    var i = 0usize;
    while i < other.failures.len() {
      failures.push(other.failures[i].copy());
      i = i + 1usize;
    }
  }

  pub fn ok(self &) bool { failed == 0u64 and unbuilt == 0u64 and broken == 0u64; }

  pub fn summary(self &) String {
    var text = counted(passed + failed + skipped, "test");
    text <- ": ";
    text <- passed;
    text <- " passed, ";
    text <- failed;
    text <- " failed";
    // Said only where a test was skipped, so a report without one reads as
    // it always has
    if skipped > 0u64 {
      text <- ", ";
      text <- skipped;
      text <- " skipped (debug only)";
    }
    text <- "; ";
    let examples = counted(built + unbuilt, "example");
    text <- examples.view(), ": ";
    text <- built;
    text <- " built, ";
    text <- unbuilt;
    text <- " failed to build";
    if broken > 0u64 {
      let packages = counted(broken, "package");
      text <- "; ", packages.view(), " did not build";
    }
    text;
  }
}

fn emptyTally() Tally { new Tally(0u64, 0u64, 0u64, 0u64, 0u64, 0u64, List[String].empty()); }

// '1 test', '2 tests'
fn counted(n u64, word &str) String {
  var text = String.empty();
  text <- n;
  text <- " "; text.append(word);
  if n != 1u64 { text <- "s"; }
  text;
}

// Text with each line after a pad, as congo.py's indent writes it: the line
// ends at its end dropped first
fn indent(text &str, pad &str) String {
  var end = text.len();
  while end > 0usize and text[end - 1usize] == '\n' { end = end - 1usize; }
  let lines = splitText(&text[..<end], '\n');
  var out = String.empty();
  var i = 0usize;
  while i < lines.len() {
    if i > 0usize { out <- "\n"; }
    out.append(pad); out <- lines[i].view();
    i = i + 1usize;
  }
  out;
}

// Output as it is compared: line ends made '\n' (git may check an expected
// file out with CRLF), and trailing blank lines dropped, as the compiler's
// suite compares a run's output
fn normalizedLines(text &str) List[String] {
  let unix = newlines(text);
  var lines = unix.split('\n');
  while lines.len() > 0usize and isBlank(lines[lines.len() - 1usize].view()) { lines.pop(); }
  lines;
}

// A path with its extension changed: tests/a.cone to tests/a.out
fn withSuffix(file &Path, suffix &str) Path {
  let folder = file.parent();
  let name = cat(file.stem(), suffix);
  folder.join(name.view());
}

// The file a test's stdout (".out") or stderr (".err") is compared with on this
// host: tests/a.out unless the test has a file of its own for this host,
// tests/a.linux.out ("windows", "linux" or "macos"), for the one thing the OS
// makes differ where the program cannot print the same on all. congo.py's
// 'expectation_file' and the compiler suite's, the same rule
fn expectationFile(file &Path, suffix &str) Path {
  let host = if isWindows() {".windows";} elif isLinux() {".linux";} else {".macos";};
  let hostSuffix = cat(host, suffix);
  let own = withSuffix(file, hostSuffix.view());
  if fs.isFile(&own) { return own; }
  withSuffix(file, suffix);
}

// A file's whole text, or Congo stops, as congo.py stops at a file it cannot
// read
fn readAll(file &Path) String {
  match fs.readFile(file) {
    case var ok Ok {
      var text = String.empty();
      text <=> ok;
      text;
    }
    case let e Error { fail(fsMessage(&e)); }
  }
}

// A file written as bytes, or Congo stops
fn writeAll(file &Path, text &str) {
  match fs.writeFile(file, text) {
    case is Ok {}
    case let e Error { fail(fsMessage(&e)); }
  }
}

// Whether a byte is one Python's str.strip() strips
fn isStripped(b u8) bool {
  b == ' ' or (b >= 0x09u8 and b <= 0x0Du8) or (b >= 0x1Cu8 and b <= 0x1Fu8);
}

// The text without what Python's str.strip() strips at either end
fn stripped(text &str) String {
  var a = 0usize;
  var b = text.len();
  while a < b and isStripped(text[a]) { a = a + 1usize; }
  while b > a and isStripped(text[b - 1usize]) { b = b - 1usize; }
  String.from(&text[a..<b]);
}

// The integer a text spells as Python's int() reads one -- a sign or none,
// then digits, a single '_' allowed between two of them -- written as
// Python's str() writes it back: no '+', no leading zeros, no '_', and no
// '-' before 0. Of any size, as Python's integers are; "" for a text that
// spells none.
fn pyInt(text &str) String {
  var negative = false;
  var start = 0usize;
  if text.len() > 0usize and (text[0usize] == '-' or text[0usize] == '+') {
    negative = text[0usize] == '-';
    start = 1usize;
  }
  if start == text.len() { return String.empty(); }
  var digits = String.empty();
  var i = start;
  while i < text.len() {
    let b = text[i];
    if b == '_' {
      if i == start or i + 1usize == text.len() or text[i - 1usize] == '_' { return String.empty(); }
    }
    elif b >= '0' and b <= '9' {
      if not (b == '0' and digits.isEmpty()) { digits.appendByte(b); }
    }
    else { return String.empty(); }
    i = i + 1usize;
  }
  if digits.isEmpty() { return String.from("0"); }
  if negative { return cat("-", digits.view()); }
  digits;
}

// A text as Python's repr() writes a str: in single quotes, or double when
// it holds a single quote and no double; a backslash, the quote, and each
// control character escaped
fn pyRepr(text &str) String {
  var quote u8 = '\'';
  if findByte(text, '\'', 0usize) < text.len() and findByte(text, '"', 0usize) == text.len() { quote = '"'; }
  var out = String.empty();
  out.appendByte(quote);
  var i = 0usize;
  while i < text.len() {
    let b = text[i];
    if b == '\\' { out <- "\\\\"; }
    elif b == quote { out.appendByte('\\'); out.appendByte(b); }
    elif b == '\n' { out <- "\\n"; }
    elif b == '\r' { out <- "\\r"; }
    elif b == '\t' { out <- "\\t"; }
    elif b < 0x20u8 or b == 0x7Fu8 {
      out <- "\\x";
      out.appendHex(u64.from(b), 2usize);
    }
    else { out.appendByte(b); }
    i = i + 1usize;
  }
  out.appendByte(quote);
  out;
}

// tests/<name>.exit holds the exit status the program must end with, where
// it is not 0: one integer, as the compiler suite's 'program_exit' is.
// Answered in decimal, as Python writes the integer back
fn expectedExit(program &Path) Result[String, String] {
  let file = withSuffix(program, ".exit");
  if not fs.isFile(&file) { return Ok[String, String](String.from("0")); }
  let raw = readAll(&file);
  let text = stripped(raw.view());
  let value = pyInt(text.view());
  if not value.isEmpty() { return Ok[String, String](value); }
  let place = shown(&file);
  let written = pyRepr(text.view());
  Error[String, String](cat(place.view(), " must hold one integer, the exit status the test ends with; it holds ",
    written.view()));
}

// tests/<name>.debug, whatever it holds, marks a test debug-only: a test of a
// check made in a debug build alone (assertDebug, assertDebugMsg), which has
// nothing to say in a release build. A release test skips it
fn debugOnly(program &Path) bool {
  let marker = withSuffix(program, ".debug");
  fs.isFile(&marker);
}

// Paths in the order congo.py's sorted() puts Windows paths: by their
// lower-cased spelling, as pathlib writes it
fn byFoldedPath(a &Path, b &Path) i32 {
  var x = native(a);
  x.lowerAscii();
  var y = native(b);
  y.lowerAscii();
  x.compare(y.view());
}

// The .cone programs directly in a tests/ or examples/ folder, by name,
// those whose name contains the filter where one is given
fn programs(folder &Path, filter &str, hasFilter bool) List[Path] {
  var found = List[Path].empty();
  if not fs.isDir(folder) { return found; }
  var entries = List[fs.DirEntry].empty();
  match fs.readDir(folder) {
    case var ok Ok { entries <=> ok; }
    case let e Error { fail(fsMessage(&e)); }
  }
  var i = 0usize;
  while i < entries.len() {
    let entry = entries[i];
    if fs.isFile(&entry.path) and entry.path.extension() == ".cone" {
      if not hasFilter or entry.path.stem().contains(filter) { found.push(entry.path.copy()); }
    }
    i = i + 1usize;
  }
  found.sortBy(&byFoldedPath);
  found;
}

// One test's result, and what to show of it
struct Verdict {
  pub passed bool;
  pub detail String;
}

// Build, run and compare one test program
fn runTest(s &mut Session, file &Path, bless bool) Verdict {
  let stem = file.stem();
  let tests = s.out.join("tests");
  let dest = tests.join(stem);
  var exe Path = "";
  match buildProgram(s, file, &dest) {
    case var ok Ok { exe <=> ok; }
    case let e Error { return new Verdict(false, e.copy()); }
  }
  // Run in its own build folder, so a file it writes by a relative name
  // lands there and not in the package's source
  var args = List[String].empty();
  args.push(native(&exe));
  var code = 0u32;
  var stdout = String.empty();
  var stderr = String.empty();
  // A crash, a panic's above all, ends at once, not held while Windows
  // reports it (the process package's "A crash")
  match process.run(args.view(), new process.Options(
      timeout: time.Duration.fromSeconds(testTimeoutSeconds), crashReport: false), &dest) {
    case let ok Ok {
      if ok.timedOut {
        // What it wrote to stderr says how far it got: a panic's line, say,
        // before an end that never came
        var note = String.from("timed out after 60 seconds");
        let err = utf8Decode(ok.stderr.view());
        if not isStrippedAway(err.view()) {
          let shownErr = indent(err.view(), "  ");
          note <- "\nstderr:\n", shownErr.view();
        }
        return new Verdict(false, note);
      }
      code = ok.exitCode;
      stdout = utf8Decode(ok.stdout.view());
      stderr = utf8Decode(ok.stderr.view());
    }
    case let e Error { fail(processMessage(&e)); }
  }
  // A program that could not start has nothing to compare, and this line is
  // how a person learns why (no dialog says so)
  let notStarted = dllNote(code, &exe);
  if notStarted.len() > 0usize { return new Verdict(false, notStarted); }
  let expectedPath = expectationFile(file, ".out");
  if not fs.isFile(&expectedPath) {
    let expectedShown = shown(&expectedPath);
    if not bless {
      return new Verdict(false, cat("no expected output, ", expectedShown.view(), ": write it by hand, or run 'congo test ",
        stem, " --bless' and check what it writes against the source"));
    }
    // Blessed only where there is nothing yet: an expected file is written
    // by hand, or blessed once and then checked by hand, and never
    // rewritten from a run, which would pin whatever the package does today
    let lines = normalizedLines(stdout.view());
    var text = String.join(lines.view(), "\n");
    text <- "\n";
    writeAll(&expectedPath, text.view());
    var note = cat("blessed ", expectedShown.view());
    let exitPath = withSuffix(file, ".exit");
    if code != 0u32 {
      var status = String.empty();
      status <- u64.from(code);
      let statusLine = cat(status.view(), "\n");
      writeAll(&exitPath, statusLine.view());
      let exitShown = shown(&exitPath);
      note <- " and ", exitShown.view(), " (", status.view(), ")";
    } elif fs.isFile(&exitPath) {
      // The run ended with 0, so a .exit left from an earlier status would
      // fail the test just blessed
      removeIfThere(&exitPath);
      let staleShown = shown(&exitPath);
      note <- " and removed the stale ", staleShown.view();
    }
    note <- ": check it by hand against the source";
    return new Verdict(true, note);
  }
  var problems = List[String].empty();
  var want = String.empty();
  match expectedExit(file) {
    case var ok Ok { want <=> ok; }
    case let e Error { return new Verdict(false, e.copy()); }
  }
  // Compared in decimal, so a status beyond any exit code's range is
  // simply not the one the test ended with
  var got = String.empty();
  got <- u64.from(code);
  if not got.equals(want.view()) {
    problems.push(cat("exited ", got.view(), ", expected ", want.view()));
  }
  let expectedText = readAll(&expectedPath);
  let expected = normalizedLines(expectedText.view());
  let actual = normalizedLines(stdout.view());
  if not sameLines(&expected, &actual) {
    let expectedShown = shown(&expectedPath);
    let diff = textdiff.unified(expected.view(), actual.view(), expectedShown.view(), "actual", 2usize);
    let shownDiff = indent(diff.view(), "  ");
    problems.push(cat("output differs:\n", shownDiff.view()));
  }
  // tests/<name>.err, written by hand, holds what the program must write to
  // stderr, where it writes there on purpose: a panic's line. Without one,
  // stderr is not compared
  let errPath = expectationFile(file, ".err");
  let errChecked = fs.isFile(&errPath);
  if errChecked {
    let errText = readAll(&errPath);
    let expectedErr = normalizedLines(errText.view());
    let actualErr = normalizedLines(stderr.view());
    if not sameLines(&expectedErr, &actualErr) {
      let errShown = shown(&errPath);
      let diff = textdiff.unified(expectedErr.view(), actualErr.view(), errShown.view(), "actual", 2usize);
      let shownDiff = indent(diff.view(), "  ");
      problems.push(cat("stderr differs:\n", shownDiff.view()));
    }
  }
  if problems.len() > 0usize and not isStrippedAway(stderr.view()) and not errChecked {
    let shownErr = indent(stderr.view(), "  ");
    problems.push(cat("stderr:\n", shownErr.view()));
  }
  let passed = problems.len() == 0usize;
  new Verdict(passed, String.join(problems.view(), "\n"));
}

// Whether Python's str.strip() leaves nothing of a text
fn isStrippedAway(text &str) bool {
  var i = 0usize;
  while i < text.len() {
    if not isStripped(text[i]) { return false; }
    i = i + 1usize;
  }
  true;
}

fn sameLines(a &List[String], b &List[String]) bool {
  if a.len() != b.len() { return false; }
  var i = 0usize;
  while i < a.len() {
    if not a[i].equals(b[i].view()) { return false; }
    i = i + 1usize;
  }
  true;
}

// One line of the report, and what to show under it
fn report(line &str, detail &str) {
  printStr(line);
  printStr("\n");
  if detail.len() > 0usize {
    let shownDetail = indent(detail, "        ");
    printStr(shownDetail.view());
    printStr("\n");
  }
  printFlush();
}

// Build the package, then run each test and build each example
fn testPackage(repo &Path, pkg Package, mode &str, filter &str, hasFilter bool, bless bool,
    defines &List[String]) Tally {
  var tally = emptyTally();
  let label = pkg.label();
  let rootPlace = native(&pkg.root);
  let testing = cat(label.view(), " (", rootPlace.view(), ")");
  say("Testing", testing.view());
  // The package under test is found first, under its own name, so a test
  // imports this copy -- whether or not it is in a registry, and whatever
  // else a registry holds of that name
  let folders = registryFolders(repo);
  let out = buildFolder(&pkg, mode);
  let indexes = registryIndexes();
  var s = newSession(repo, readRegistry(folders, &indexes), &out, mode, defines);
  let name = pkg.name.copy();
  let isLibrary = pkg.output.equals("library");
  let testsFolder = pkg.root.join("tests");
  let examplesFolder = pkg.root.join("examples");
  let top = s.reg.add(pkg);
  s.reg.byName.insert(name.copy(), top);
  var tests = programs(&testsFolder, filter, hasFilter);
  let examples = programs(&examplesFolder, filter, hasFilter);
  match build(&mut s, top) {
    case is Ok {}
    case let e Error {
      warn(cat("error: ", e.view()));
      tally.broken = tally.broken + 1u64;
      tally.failures.push(cat(name.view(), ": the package does not build"));
      let result = cat(name.view(), ": the package does not build");
      say("Result", result.view());
      return tally;
    }
  }
  // Its kernels, where it has them, checked by the Vulkan SDK's validator for
  // Vulkan 1.3, counted as a test; where the SDK is not installed they are
  // only built, and that is said
  if s.spvs.contains(name.view()) and not hasFilter {
    let spv = s.spvs[name.view()].copy();
    let spvName = spv.name();
    let v = validateKernels(&spv);
    if not v.ran {
      let line = cat("     kernels ", spvName, " ... built, not validated: spirv-val, the Vulkan SDK's, is not on PATH");
      report(line.view(), "");
    }
    else {
      var outcome &str = "valid";
      if not v.valid { outcome = "FAILED"; }
      let line = cat("     kernels ", spvName, " ... ", outcome);
      if v.valid {
        report(line.view(), "");
        tally.passed = tally.passed + 1u64;
      }
      else {
        report(line.view(), v.said.view());
        tally.failed = tally.failed + 1u64;
        tally.failures.push(cat(name.view(), ": kernels ", spvName));
      }
    }
  }
  if not fs.isDir(&testsFolder) {
    let none = cat("none: ", name.view(), " has no tests folder");
    say("Tests", none.view());
  }
  elif not isLibrary and tests.len() > 0usize {
    warn(cat("error: ", name.view(), " is an executable package, and a test imports the package it tests; only a library can be imported, so its tests cannot run yet"));
    tally.failed = tally.failed + u64.from(tests.len());
    var i = 0usize;
    while i < tests.len() {
      tally.failures.push(cat(name.view(), ": test ", tests[i].stem()));
      i = i + 1usize;
    }
    tests.clear();
  }
  elif tests.len() == 0usize and not hasFilter {
    let none = cat("none: ", name.view(), "'s tests folder holds no .cone program");
    say("Tests", none.view());
  }
  var i = 0usize;
  while i < tests.len() {
    let file = tests[i];
    let stem = file.stem();
    // Not built or run, so nothing is blessed for it either
    if mode == "release" and debugOnly(file) {
      let skippedLine = cat("        test ", stem, " ... skipped (debug only)");
      report(skippedLine.view(), "");
      tally.skipped = tally.skipped + 1u64;
      i = i + 1usize;
      continue;
    }
    let verdict = runTest(&mut s, file, bless);
    var outcome &str = "ok";
    if not verdict.passed { outcome = "FAILED"; }
    let line = cat("        test ", stem, " ... ", outcome);
    report(line.view(), verdict.detail.view());
    if verdict.passed { tally.passed = tally.passed + 1u64; }
    else {
      tally.failed = tally.failed + 1u64;
      tally.failures.push(cat(name.view(), ": test ", stem));
    }
    i = i + 1usize;
  }
  i = 0usize;
  while i < examples.len() {
    let file = examples[i];
    let stem = file.stem();
    let examplesOut = s.out.join("examples");
    let dest = examplesOut.join(stem);
    var passed = true;
    var detail = String.empty();
    match buildProgram(&mut s, file, &dest) {
      case is Ok {}
      case let e Error {
        passed = false;
        detail = e.copy();
      }
    }
    var outcome &str = "built";
    if not passed { outcome = "FAILED to build"; }
    let line = cat("     example ", stem, " ... ", outcome);
    report(line.view(), detail.view());
    if passed { tally.built = tally.built + 1u64; }
    else {
      tally.unbuilt = tally.unbuilt + 1u64;
      tally.failures.push(cat(name.view(), ": example ", stem));
    }
    i = i + 1usize;
  }
  let summary = tally.summary();
  let result = cat(name.view(), ": ", summary.view());
  say("Result", result.view());
  tally;
}

// The manifests of a folder of packages, a registry folder such as
// packages/: each subfolder's, by name
fn packageManifests(folder &Path) List[Path] {
  var found = List[Path].empty();
  var entries = List[fs.DirEntry].empty();
  match fs.readDir(folder) {
    case var ok Ok { entries <=> ok; }
    case let e Error { fail(fsMessage(&e)); }
  }
  var i = 0usize;
  while i < entries.len() {
    let manifest = entries[i].path.join("congo.toml");
    if fs.isFile(&manifest) { found.push(manifest); }
    i = i + 1usize;
  }
  found;
}

// Test the current package; or, in a folder of packages that is not a
// package itself (a registry folder such as packages/), each package in it
fn cmdTest(filter &str, hasFilter bool, release bool, bless bool, defines &List[String]) i32 {
  var mode &str = "debug";
  if release { mode = "release"; }
  let repo = findRepo();
  var here Path = "";
  match fs.currentDir() {
    case var ok Ok { here <=> ok; }
    case let e Error { fail(fsMessage(&e)); }
  }
  let own = here.join("congo.toml");
  var manifests = List[Path].empty();
  if not fs.isFile(&own) { manifests = packageManifests(&here); }
  if manifests.len() == 0usize { manifests.push(currentManifest()); }
  var total = emptyTally();
  var i = 0usize;
  while i < manifests.len() {
    var pkg = emptyPackage();
    match readManifest(manifests[i]) {
      case var ok Ok { pkg <=> ok; }
      case let e Error { fail(e.copy()); }
    }
    let tally = testPackage(&repo, pkg, mode, filter, hasFilter, bless, defines);
    total.add(&tally);
    i = i + 1usize;
  }
  if hasFilter and total.passed + total.failed + total.skipped + total.built + total.unbuilt + total.broken == 0u64 {
    fail(cat("no test or example has '", filter, "' in its name"));
  }
  if manifests.len() > 1usize {
    let summary = total.summary();
    var result = String.empty();
    result <- u64.from(manifests.len());
    result <- " packages: ", summary.view();
    say("Result", result.view());
  }
  if not total.ok() {
    let listed = String.join(total.failures.view(), "\n");
    let shownList = indent(listed.view(), "    ");
    warn(cat("failed:\n", shownList.view()));
    return 1i32;
  }
  0i32;
}
