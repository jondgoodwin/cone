// What every part of Congo uses: messages, text put together, a failure,
// and the text a child program prints, read as congo.py reads it.

// Text put together from up to nine pieces
fn cat(a &str, b &str = "", c &str = "", d &str = "", e &str = "", f &str = "",
    g &str = "", h &str = "", i &str = "") String {
  mut s = String.from(a);
  s.append(b); s.append(c); s.append(d); s.append(e); s.append(f); s.append(g); s.append(h); s.append(i);
  s;
}

// One progress line, Cargo's shape: a right-aligned verb, then what
fn say(verb &str, rest &str) {
  mut v = String.from(verb);
  v.padStart(12usize);
  printStr(v.view());
  printStr(" ");
  printStr(rest);
  printStr("\n");
  printFlush();
}

// A line to standard error: a warning
fn warn(msg String) {
  printFlush();
  eprintStr(msg.view());
  eprintStr("\n");
  eprintFlush();
}

// A failure Congo reports as one message and exit status 1, as congo.py
// reports a CongoError that reaches its main. Cone has no exceptions: what
// 'congo test' goes on after (a test or a package that does not build) is
// answered as a value, a Result whose Error is the message, and the
// commands that stop at the first one, 'build' and 'run', end the program
// here with it. So does what congo.py would stop at with a traceback: a
// file or folder Congo cannot write, or a program it cannot start.
fn fail(msg String) Never {
  printFlush();
  eprintStr("congo: error: ");
  eprintStr(msg.view());
  eprintStr("\n");
  eprintFlush();
  libc.exit(1i32);
}

// What a step that answers nothing answers when it did not fail
fn succeeded() Result[void, String] { Ok[void, String][nil]; }

// A code point as UTF-8
fn appendUtf8(s &mut String, cp u32) {
  if cp < 0x80u32 {
    s.appendByte(u8.from(cp));
  }
  elif cp < 0x800u32 {
    s.appendByte(u8.from(0xC0u32 | (cp >> 6u32)));
    s.appendByte(u8.from(0x80u32 | (cp & 0x3Fu32)));
  }
  else {
    s.appendByte(u8.from(0xE0u32 | (cp >> 12u32)));
    s.appendByte(u8.from(0x80u32 | ((cp >> 6u32) & 0x3Fu32)));
    s.appendByte(u8.from(0x80u32 | (cp & 0x3Fu32)));
  }
}

// Text with every line end made '\n', as Python's universal newlines make
// '\r\n' and a lone '\r'
fn newlines(text &str) String {
  mut out = String.withCapacity(text.len());
  mut i = 0usize;
  while i < text.len() {
    imm b = text[i];
    if b == '\r' {
      out.appendByte('\n');
      if i + 1usize < text.len() and text[i + 1usize] == '\n' { i = i + 1usize; }
    }
    else { out.appendByte(b); }
    i = i + 1usize;
  }
  out;
}

// How many bytes from i make one well-formed UTF-8 character, with ok
// true; else, ok false, how many of them begin one that is cut short (at
// least 1): the maximal subpart, which Python's decoder replaces with one
// U+FFFD
fn utf8At(b &Array[u8], i usize, ok &mut bool) usize {
  imm b0 = b[i];
  *ok = true;
  if b0 < 0x80u8 { return 1usize; }
  *ok = false;
  mut need = 0usize;
  mut lo = 0x80u8;
  mut hi = 0xBFu8;
  if b0 >= 0xC2u8 and b0 <= 0xDFu8 { need = 1usize; }
  elif b0 == 0xE0u8 { need = 2usize; lo = 0xA0u8; }
  elif b0 == 0xEDu8 { need = 2usize; hi = 0x9Fu8; }
  elif b0 >= 0xE1u8 and b0 <= 0xEFu8 { need = 2usize; }
  elif b0 == 0xF0u8 { need = 3usize; lo = 0x90u8; }
  elif b0 == 0xF4u8 { need = 3usize; hi = 0x8Fu8; }
  elif b0 >= 0xF1u8 and b0 <= 0xF3u8 { need = 3usize; }
  else { return 1usize; }
  mut k = 1usize;
  while k <= need {
    if i + k >= b.len { return k; }
    imm c = b[i + k];
    if k == 1usize {
      if c < lo or c > hi { return 1usize; }
    }
    elif c < 0x80u8 or c > 0xBFu8 { return k; }
    k = k + 1usize;
  }
  *ok = true;
  need + 1usize;
}

// Bytes read as UTF-8, as Python's decode('utf-8', 'replace') reads them:
// each piece that is not well formed one U+FFFD
fn utf8Decode(bytes &Array[u8]) String {
  mut out = String.withCapacity(bytes.len);
  mut i = 0usize;
  while i < bytes.len {
    mut ok = true;
    imm n = utf8At(bytes, i, &mut ok);
    if ok { out.appendBytes(&bytes[i..<i + n]); }
    else { appendUtf8(&mut out, 0xFFFDu32); }
    i = i + n;
  }
  out;
}

// What conec, or vswhere with -utf8, printed: UTF-8, and every line end
// made '\n'
fn utf8Text(bytes &Array[u8]) String {
  imm text = utf8Decode(bytes);
  newlines(text.view());
}

// kernel32's, for the text a console program writes, and the error mode
extern {
  fn @c(system) SetErrorMode(mode u32) u32;
  fn @c(system) GetConsoleOutputCP() u32;
  fn @c(system) GetOEMCP() u32;
  fn @c(system) MultiByteToWideChar(page u32, flags u32, from *u8, fromLen i32, to *u16, toLen i32) i32;
  fn @c(system) WideCharToMultiByte(page u32, flags u32, from *u16, fromLen i32, to *u8, toLen i32,
      fallback *u8, usedFallback *i32) i32;
}

const utf8Page = 65001u32;

// Once at start-up, as congo.py's hard_errors_to_status: the loader's
// missing-DLL dialog, and the other hard-error and file-open boxes, become
// an exit status. A program started without a DLL it needs would otherwise
// stop at a modal dialog on the desktop, waiting for a person. A child
// process inherits this process's error mode, so every program Congo starts
// ends with the status instead (see dllNote). OR-ed into the mode already
// set, as SetErrorMode's documentation advises; process.run never passes
// CREATE_DEFAULT_ERROR_MODE, which would undo this.
fn hardErrorsToStatus() {
  imm before = SetErrorMode(0u32);
  SetErrorMode(before | 0x8001u32);       // | SEM_FAILCRITICALERRORS | SEM_NOOPENFILEERRORBOX
}

// A line saying that the program, by its full path, did not start because a
// DLL it needs was not found, if it ended with STATUS_DLL_NOT_FOUND; empty
// for any other status. With the loader's dialog gone, this line is how a
// person learns of it
fn dllNote(code u32, exe &Path) String {
  if code == 0xC0000135u32 {
    imm full = resolved(exe);
    imm place = native(&full);
    return cat(place.view(), " could not start: a DLL it needs was not found (0xC0000135)");
  }
  String.empty();
}

// n UTF-16 units from p, as UTF-8; a lone surrogate becomes U+FFFD
fn fromUtf16(p *u16, n i32) String {
  mut out = String.empty();
  if n <= 0i32 { return out; }
  imm size = WideCharToMultiByte(utf8Page, 0u32, p, n, null, 0i32, null, null);
  if size <= 0i32 { return out; }
  imm buf = libc.malloc(usize.from(size));
  WideCharToMultiByte(utf8Page, 0u32, p, n, buf, size, null, null);
  out.appendBytes(mem.sliceFromParts(buf, usize.from(size)));
  libc.free(buf);
  out;
}

// What a console program Congo starts printed, link.exe and cmd among
// them: text in the code page of the console it shares with Congo, or,
// when Congo has none, of the console Windows makes for it, whose code page
// is the OEM one. congo.py reads it the same way, through Windows' own
// conversion; every line end made '\n'
fn consoleText(bytes &Array[u8]) String {
  mut page = GetConsoleOutputCP();
  if page == 0u32 { page = GetOEMCP(); }
  if page == utf8Page { return utf8Text(bytes); }
  if bytes.len == 0usize or bytes.len > 0x3FFFFFFFusize { return String.empty(); }
  imm len = i32.from(bytes.len);
  imm n = MultiByteToWideChar(page, 0u32, bytes as *u8, len, null, 0i32);
  if n <= 0i32 { return String.empty(); }
  imm wide = libc.malloc(usize.from(n) * 2usize) as *u16;
  MultiByteToWideChar(page, 0u32, bytes as *u8, len, wide, n);
  imm text = fromUtf16(wide, n);
  libc.free(wide as *u8);
  newlines(text.view());
}

// UTF-16, little-endian, as UTF-8, as congo.py reads it with
// decode('utf-16-le', 'replace'): an odd byte left at the end is U+FFFD;
// every line end made '\n'
fn utf16Text(bytes &Array[u8]) String {
  imm units = bytes.len / 2usize;
  mut text = String.empty();
  if units > 0usize and units <= 0x3FFFFFFFusize {
    imm wide = libc.malloc(units * 2usize);
    libc.memcpy(wide, bytes as *u8, units * 2usize);
    text = fromUtf16(wide as *u16, i32.from(units));
    libc.free(wide);
  }
  if bytes.len % 2usize == 1usize { appendUtf8(&mut text, 0xFFFDu32); }
  newlines(text.view());
}

// The lines of a text, as Python's splitlines() breaks them: at '\n', '\r',
// '\r\n', and the vertical tab, form feed and file, group and record
// separators; no line for an end after the last
fn splitLines(text &str) List[String] {
  mut out = List[String].empty();
  mut start = 0usize;
  mut i = 0usize;
  while i < text.len() {
    imm b = text[i];
    if b == '\n' or b == '\r' or b == 0x0Bu8 or b == 0x0Cu8 or b == 0x1Cu8 or b == 0x1Du8 or b == 0x1Eu8 {
      out.push(String.from(&text[start..<i]));
      if b == '\r' and i + 1usize < text.len() and text[i + 1usize] == '\n' { i = i + 1usize; }
      start = i + 1usize;
    }
    i = i + 1usize;
  }
  if start < text.len() { out.push(String.from(&text[start..])); }
  out;
}

// The pieces of a text between each sep
fn splitText(s &str, sep u8) List[String] {
  imm t = String.from(s);
  t.split(sep);
}

fn isBlank(s &str) bool {
  mut i = 0usize;
  while i < s.len() {
    if not (isSpace(s[i]) or s[i] == 0x0Bu8 or s[i] == 0x0Cu8) { return false; }
    i = i + 1usize;
  }
  true;
}

// Changes Congo makes to its own environment for one child, and undoes
// after it: a child inherits the environment as it is when it starts
struct EnvChanges {
  pub names List[String];
  pub had List[bool];
  pub values List[String];

  // Set name to value, remembering what it was the first time
  pub fn set(self &mut, name &str, value &str) {
    mut seen = false;
    mut i = 0usize;
    while i < names.len() {
      if names[i].equalsIgnoreAsciiCase(name) { seen = true; }
      i = i + 1usize;
    }
    if not seen {
      names.push(String.from(name));
      match env.get(name) {
        case mut v Some {
          mut old = String.empty();
          old <=> v;
          had.push(true);
          values.push(old);
        }
        case is None {
          had.push(false);
          values.push(String.empty());
        }
      }
    }
    env.set(name, value);
  }

  // Put back what was there before, last change first
  pub fn restore(self &mut) {
    mut i = names.len();
    while i > 0usize {
      i = i - 1usize;
      if *had[i] { env.set(names[i].view(), values[i].view()); }
      else { env.unset(names[i].view()); }
    }
    names.clear();
    had.clear();
    values.clear();
  }
}

fn noChanges() EnvChanges {
  new EnvChanges(List[String].empty(), List[bool].empty(), List[String].empty());
}
