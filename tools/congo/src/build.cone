// Building: each package's compile, the link, a package's build as a whole,
// and a lone file standing as a package (congo.py's compile_unit, Session,
// build, build_folder, lone_package and lone_build_root).
//
// What can go wrong in a build that 'congo test' goes on after -- a source it
// cannot scan or resolve, a compile or a link that fails, no conec or linker
// -- is answered as a value, a Result whose Error is congo.py's CongoError
// message. 'congo build' and 'congo run' end on the first, in buildPackage.

// Where a package's build goes: build/<mode>/ in the package's folder; a
// lone file's under the Congo home
fn buildFolder(pkg &Package, mode &Array[u8]) String {
  if pkg.lone {
    imm root = loneBuildRoot(pkg.src.view());
    return joined(root.view(), mode);
  }
  imm folder = joined(pkg.root.view(), "build");
  joined(folder.view(), mode);
}

// The compiles of one build folder, and its link. A package is compiled at
// most once in a session: 'congo test' builds the package, then each test
// program against the objects and include files that build left, compiling
// only what a test imports that the package does not (stdio, say).
struct Session {
  pub repo String;
  pub reg Registry;
  pub out String;
  pub mode String;
  pub objs Dict[String, String];   // each library compiled into out, by name
  pub spvs Dict[String, String];   // each package's kernels compiled into out, by name
  pub gpuChecked List[String];     // packages whose imports were checked for the GPU
  pub warned List[String];         // the packages whose hand include file was warned of
  pub conec String;                // found at the first compile; "" before
  pub hasLinker bool;
  pub linker Linker;               // found at the first link
  // TEMPORARY, a provisional mechanism whose final design is open: each
  // '-D NAME' or '-D NAME=123' given to build, run or test, passed to every
  // conec compile of the build, the packages it imports included (conec's
  // isDefined, definedInt)
  pub defines List[String];
}

fn newSession(repo &Array[u8], reg Registry, out &Array[u8], mode &Array[u8], defines &List[String]) Session {
  new Session(String.fromBytes(repo), reg, String.fromBytes(out), String.fromBytes(mode), Dict[String, String].empty(),
    Dict[String, String].empty(), List[String].empty(), List[String].empty(), String.empty(), false, noLinkerYet(),
    copyStrings(defines));
}

// Build pkg and everything it imports into its build folder, each package
// compiled on its own; answer the executable, or for a library its object.
// A build is whole every time: every description written, every package
// compiled, nothing kept from a build before. The first failure ends Congo.
fn buildPackage(repo &Array[u8], pkg Package, mode &Array[u8], defines &List[String]) String {
  imm folders = registryFolders(repo);
  imm out = buildFolder(&pkg, mode);
  mut s = newSession(repo, readRegistry(folders), out.view(), mode, defines);
  imm top = s.reg.add(pkg);
  match build(&mut s, top) {
    case mut ok Ok {
      mut built = String.empty();
      built <=> ok.value;
      built;
    }
    case imm e Error { fail(e.value.copy()); }
  }
}

// Build the registry's package top, and everything it imports, in the
// session; answer the executable, or for a library its object
fn build(s &mut Session, top usize) Result[String, String] {
  imm isLibrary = s.reg.packages[top].output.equals("library");
  imm name = s.reg.packages[top].name.copy();
  mut plan = emptyPlan();
  match buildOrder(&s.reg, top) {
    case mut ok Ok { plan <=> ok.value; }
    case imm e Error { return Error[String, String][e.value.copy()]; }
  }
  mut objs = List[String].empty();
  match compile(s, &plan, top, "", true) {
    case mut ok Ok { objs <=> ok.value; }
    case imm e Error { return Error[String, String][e.value.copy()]; }
  }
  if isLibrary {
    imm obj = objs[objs.len() - 1usize].copy();
    imm place = shown(obj.view());
    mut finished = cat(s.mode.view(), " library object ", place.view());
    if s.spvs.contains(name.view()) {
      imm kernels = shown(s.spvs[name.view()].view());
      finished <- " and kernels ", kernels.view();
    }
    say("Finished", finished.view());
    return Ok[String, String][obj];
  }
  imm exeName = cat(name.view(), ".exe");
  imm exe = joined(s.out.view(), exeName.view());
  match link(s, &plan, &objs, exe.view(), true) {
    case is Ok {}
    case imm e Error { return Error[String, String][e.value.copy()]; }
  }
  imm place = shown(exe.view());
  imm finished = cat(s.mode.view(), " ", place.view());
  say("Finished", finished.view());
  Ok[String, String][exe];
}

// A test or example program, built as a lone file of its own that imports
// the package by name: its imports resolved through the session's
// registry, where the package under test is found first; the packages it
// imports compiled into the package's build folder (once each, most already
// there), and the program itself into a folder of its own, dest, then
// linked. Answers the executable.
fn buildProgram(s &mut Session, file &Array[u8], dest &Array[u8]) Result[String, String] {
  mut pkg = emptyPackage();
  match lonePackage(file) {
    case mut ok Ok { pkg <=> ok.value; }
    case imm e Error { return Error[String, String][e.value.copy()]; }
  }
  imm exeName = cat(pkg.name.view(), ".exe");
  imm top = s.reg.add(pkg);
  mut plan = emptyPlan();
  match buildOrder(&s.reg, top) {
    case mut ok Ok { plan <=> ok.value; }
    case imm e Error { return Error[String, String][e.value.copy()]; }
  }
  mut objs = List[String].empty();
  match compile(s, &plan, top, dest, false) {
    case mut ok Ok { objs <=> ok.value; }
    case imm e Error { return Error[String, String][e.value.copy()]; }
  }
  imm exe = joined(dest, exeName.view());
  match link(s, &plan, &objs, exe.view(), false) {
    case is Ok {}
    case imm e Error { return Error[String, String][e.value.copy()]; }
  }
  Ok[String, String][exe];
}

// A lone file's build goes under the Congo home, not beside the file: the
// folder a lone file sits in is nobody's package, and may well hold a
// 'build' folder of its own that 'congo clean' must not delete. Named for the
// file and the SHA-1 of its absolute path, lower-cased, as congo.py names it.
fn loneBuildRoot(file &Array[u8]) String {
  mut spelled = resolved(file);
  spelled.lowerAscii();
  imm digest = sha1Hex(spelled.view());
  imm home = congoHome();
  imm lone = joined(home.view(), "lone");
  imm stem = path.stem(file);
  imm short = digest.sub(0usize, 10usize);
  imm folder = cat(stem.view(), "-", short.view());
  joined(lone.view(), folder.view());
}

// A lone file with no manifest is a program of one module, named by its
// 'mod' line. A file with none is named by the file here, and the compiler
// refuses it for the missing line (ErrorNoModDcl).
fn lonePackage(given &Array[u8]) Result[Package, String] {
  imm p = winPath(given);
  imm file = resolved(p.view());
  if not fs.isFile(file.view()) { return Error[Package, String][cat("no file ", file.view())]; }
  mut header = noHeader();
  match scanHeader(file.view()) {
    case mut ok Ok { header <=> ok.value; }
    case imm e Error { return Error[Package, String][e.value.copy()]; }
  }
  imm name = if header.hasMod {header.modName.copy();} else {path.stem(file.view());};
  imm fault = nameFault(name.view());
  if not header.hasMod and not fault.isEmpty() {
    return Error[Package, String][cat(file.view(), ": with no 'mod' line it is named by its file: '", name.view(), "' ", fault.view(),
      "; give the file a 'mod' line")];
  }
  if not fault.isEmpty() {
    return Error[Package, String][cat(file.view(), ": 'mod ", name.view(), "': '", name.view(), "' ", fault.view(),
      "; rename the module, and the file where it is named for it")];
  }
  imm folder = parentOf(file.view());
  Ok[Package, String][new Package(name, String.empty(), String.from("executable"), folder, file.copy(), true,
    List[String].empty(), List[String].empty(), List[String].empty(), false)];
}

// Write the package's build description into out and compile the package
// on its own. Every package but the one being built is a library; the one
// being built is what its manifest says. The description lists the unit's
// dependency closure for its include files, which are in 'includes': the
// session's build folder, where every package but a test program is
// compiled. A library's compile writes its include file beside its object,
// which is what every package compiled after it that imports it is compiled
// against.
fn compileUnit(conec &Array[u8], reg &Registry, plan &Plan, u usize, out &Array[u8], includes &Array[u8], mode &Array[u8],
    defines &List[String], top bool, announce bool) Result[String, String] {
  imm unit = plan.units[u];
  imm pkg = reg.packages[unit.pkg];
  imm output = if top {pkg.output.copy();} else {String.from("library");};
  imm descName = cat(pkg.name.view(), ".conebuild");
  imm desc = joined(out, descName.view());
  imm packages = closure(plan, reg, u);
  imm text = description(reg, unit, mode, output.view(), includes, &packages);
  match fs.writeFile(desc.view(), text.view()) {
    case is Ok {}
    case imm e Error {
      fail(e.value.message());
    }
  }
  // A library's include file is written afresh, so one left by an earlier
  // build never stands in for it
  imm incl = includeFor(pkg, out);
  match fs.removeFile(incl.view()) {
    case is Ok {}
    case imm e Error {
      if not e.value.notFound() {
        fail(e.value.message());
      }
    }
  }
  if announce {
    imm label = pkg.label();
    imm compiling = cat(label.view(), " (", pkg.root.view(), ")");
    say("Compiling", compiling.view());
  }
  if not runConec(conec, defines, argList("-o", out, desc.view())) {
    return Error[String, String][cat("could not compile ", pkg.name.view(), " (build description: ", desc.view(), ")")];
  }
  imm objName = cat(pkg.name.view(), ".obj");
  imm obj = joined(out, objName.view());
  if not fs.isFile(obj.view()) { return Error[String, String][cat("conec wrote no object at ", obj.view())]; }
  if output.equals("library") and not fs.isFile(incl.view()) {
    return Error[String, String][cat("conec wrote no include file for ", pkg.name.view(), " at ", incl.view())];
  }
  Ok[String, String][obj];
}

// Run conec with the -D defines after it, then rest, and show what it said
// but its closing 'Compile finished' line; whether it succeeded
fn runConec(conec &Array[u8], defines &List[String], rest List[String]) bool {
  mut args = argList(conec);
  mut d = 0usize;
  while d < defines.len() {
    args.push(String.from("-D"));
    args.push(defines[d].copy());
    d = d + 1usize;
  }
  mut r = 0usize;
  while r < rest.len() {
    args.push(rest[r].copy());
    r = r + 1usize;
  }
  mut chatter = String.empty();
  mut code = 0u32;
  match process.run(args.view()) {
    case imm ok Ok {
      chatter = utf8Text(ok.value.stdout.view());
      imm err = utf8Text(ok.value.stderr.view());
      chatter <- err.view();
      code = ok.value.exitCode;
    }
    case imm e Error {
      fail(e.value.message());
    }
  }
  imm lines = splitLines(chatter.view());
  mut shownLines = List[String].empty();
  mut i = 0usize;
  while i < lines.len() {
    if not isBlank(lines[i].view()) and not lines[i].startsWith("Compile finished") {
      shownLines.push(lines[i].copy());
    }
    i = i + 1usize;
  }
  if shownLines.len() > 0usize {
    imm said = String.join(shownLines.view(), "\n");
    printStr(said.view());
    printStr("\n");
    printFlush();
  }
  code == 0u32;
}

fn makeFolder(folder &Array[u8]) {
  match fs.makeDirAll(folder) {
    case is Ok {}
    case imm e Error {
      fail(e.value.message());
    }
  }
}

// Compile every unit of the plan not compiled in the session already, each
// after what it imports; answer the objects in the order's order. 'top' gets
// the output its manifest says, into topOut where that is given (a test
// program's own folder); every other package is a library, into the
// session's build folder. 'announce' is whether top's compile is announced;
// every other package's is.
fn compile(s &mut Session, plan &Plan, top usize, topOut &Array[u8], announce bool) Result[List[String], String] {
  // Found at the first compile, after the imports are resolved, so that an
  // error in the source is reported before anything about the machine
  if s.conec.isEmpty() {
    match findConec(s.repo.view()) {
      case mut ok Ok { s.conec <=> ok.value; }
      case imm e Error { return Error[List[String], String][e.value.copy()]; }
    }
  }
  imm out = s.out.copy();
  makeFolder(out.view());
  mut changes = noChanges();
  // Every package after core loads the prelude from core's generated
  // include file, which its package line names. core's own compile has no
  // such line, and loads the prelude from the package search path, which
  // must give the very file core is compiled from, or the two are two
  // modules named core: so the packages folder conec takes it from is the
  // registry folder Congo found core in
  mut core = 0usize;
  if plan.unitNamed(&s.reg, "core", &mut core) {
    imm root = s.reg.packages[plan.units[core].pkg].root.view();
    imm folder = parentOf(root);
    changes.set("CONE_PACKAGES", folder.view());
  }
  // An include file written by hand at a package's root is no longer read:
  // say so, once, so that nobody edits it expecting it to count
  mut i = 0usize;
  while i < plan.order.len() {
    imm pkg = s.reg.packages[plan.units[*plan.order[i]].pkg];
    imm hand = pkg.handInclude();
    if not pkg.lone and fs.isFile(hand.view()) and not holdsName(&s.warned, pkg.name.view()) {
      s.warned.push(pkg.name.copy());
      warn(cat("warning: ", hand.view(), " is not used: a package's importers compile against the include file its own compile generates, build/<mode>/",
        pkg.name.view(), ".cone"));
    }
    i = i + 1usize;
  }
  // Before anything is compiled: a package compiled for the GPU, and a
  // marked package being built, import only packages marked for it
  i = 0usize;
  while i < plan.order.len() {
    imm u = *plan.order[i];
    imm pkg = s.reg.packages[plan.units[u].pkg];
    imm compiledForGpu = plan.units[u].kernels or (plan.units[u].pkg == top and (pkg.gpu or plan.units[u].hasGpu));
    if compiledForGpu and not holdsName(&s.gpuChecked, pkg.name.view()) {
      match checkGpuMarks(plan, &s.reg, u) {
        case is Ok {}
        case imm e Error {
          changes.restore();
          return Error[List[String], String][e.value.copy()];
        }
      }
      s.gpuChecked.push(pkg.name.copy());
    }
    i = i + 1usize;
  }
  mut objs = List[String].empty();
  i = 0usize;
  while i < plan.order.len() {
    imm u = *plan.order[i];
    imm isTop = plan.units[u].pkg == top;
    imm name = s.reg.packages[plan.units[u].pkg].name.copy();
    if not isTop and s.objs.contains(name.view()) {
      objs.push(s.objs[name.view()].copy());
    }
    else {
      imm own = isTop and topOut.len > 0usize;
      imm dest = if own {String.fromBytes(topOut);} else {out.copy();};
      makeFolder(dest.view());
      mut obj = String.empty();
      match compileUnit(s.conec.view(), &s.reg, plan, u, dest.view(), out.view(), s.mode.view(), &s.defines, isTop,
        announce or not isTop) {
        case mut ok Ok { obj <=> ok.value; }
        case imm e Error {
          changes.restore();
          return Error[List[String], String][e.value.copy()];
        }
      }
      if not own and (not isTop or s.reg.packages[top].output.equals("library")) {
        s.objs.insert(name, obj.copy());
      }
      objs.push(obj);
    }
    i = i + 1usize;
  }
  // Then the kernels of each marked package that has them, once a session,
  // into the build folder, beside its object
  mut coreUnit = 0usize;
  imm hasCore = plan.unitNamed(&s.reg, "core", &mut coreUnit);
  i = 0usize;
  while i < plan.order.len() {
    imm u = *plan.order[i];
    imm name = s.reg.packages[plan.units[u].pkg].name.copy();
    if plan.units[u].kernels and hasCore and not s.spvs.contains(name.view()) {
      match compileGpu(s, plan, u, coreUnit) {
        case imm ok Ok { s.spvs.insert(name, ok.value.copy()); }
        case imm e Error {
          changes.restore();
          return Error[List[String], String][e.value.copy()];
        }
      }
    }
    i = i + 1usize;
  }
  changes.restore();
  Ok[List[String], String][objs];
}

// Whether list holds name
fn holdsName(list &List[String], name &Array[u8]) bool {
  mut i = 0usize;
  while i < list.len() {
    if list[i].equals(name as &str) { return true; }
    i = i + 1usize;
  }
  false;
}

// Whether list holds a path the same as p, as Windows compares them
fn holdsPath(list &List[String], p &Array[u8]) bool {
  mut i = 0usize;
  while i < list.len() {
    if list[i].equalsIgnoreAsciiCase(p as &str) { return true; }
    i = i + 1usize;
  }
  false;
}

// Congo building itself, where the executable it links is the one running.
// Windows will not remove a running program's file, but will rename it: so
// the running Congo is moved aside, to <exe>.old (one left by a build before
// removed first), and the new one is linked where any build links it.
fn moveAsideIfRunning(exe &Array[u8]) {
  mut running = String.empty();
  match process.currentExe() {
    case mut ok Ok { running <=> ok.value; }
    case is Error { return; }
  }
  imm spelled = winPath(running.view());
  if not samePath(spelled.view(), exe) { return; }
  imm old = cat(exe, ".old");
  match fs.removeFile(old.view()) {
    case is Ok {}
    case imm e Error {
      if not e.value.notFound() {
        fail(e.value.message());
      }
    }
  }
  match fs.rename(exe, old.view()) {
    case is Ok {}
    case imm e Error {
      fail(e.value.message());
    }
  }
}

// -------- runtime libraries: the DLLs a program needs beside it --------
//
// A package's [link] runtime list names the DLLs a program using it loads at
// run time (SDL3, OpenSSL's libssl-3 and libcrypto-3). Every executable
// Congo links gets the DLLs of every package of its build beside it, copied
// into its folder: so a program inherits them from whatever it imports, at
// any depth, and names nothing itself.

// The fetched-dependencies folder: CONE_DEPS, else deps/ in the repository,
// which tools/deps/fetch.py fills
fn depsFolder(repo &Array[u8]) String {
  imm named = envOr("CONE_DEPS", "");
  if not named.isEmpty() {
    imm p = winPath(named.view());
    return resolved(p.view());
  }
  joined(repo, "deps");
}

// The folders an environment variable lists, ';'-separated, onto out
fn envFolders(name &Array[u8], out &mut List[String]) {
  imm listed = envOr(name, "");
  imm entries = splitText(listed.view(), ';');
  mut i = 0usize;
  while i < entries.len() {
    if not entries[i].isEmpty() { out.push(entries[i].copy()); }
    i = i + 1usize;
  }
}

// Where a runtime DLL is looked for, in order: the build's [link] paths, in
// the order the linker is given them; each folder in the fetched-
// dependencies folder, by name; the folders LIB lists, where an import
// library's own DLL usually sits beside it (SDL3's development kit); then
// the folders PATH lists. The first copy found is the one copied.
fn runtimeFolders(repo &Array[u8], paths &List[String]) List[String] {
  mut folders = copyStrings(paths);
  imm deps = depsFolder(repo);
  if fs.isDir(deps.view()) {
    mut entries = List[fs.DirEntry].empty();
    match fs.readDir(deps.view()) {
      case mut ok Ok { entries <=> ok.value; }
      case is Error {}
    }
    mut i = 0usize;
    while i < entries.len() {
      if fs.isDir(entries[i].path.view()) { folders.push(entries[i].path.copy()); }
      i = i + 1usize;
    }
  }
  envFolders("LIB", &mut folders);
  envFolders("PATH", &mut folders);
  folders;
}

// The DLL a [link] runtime list names, where runtimeFolders finds it first;
// one that is nowhere is an error naming it and the package that asked
fn findRuntime(repo &Array[u8], name &Array[u8], pkgName &Array[u8], folders &List[String], paths &List[String]) Result[String, String] {
  imm file = cat(name, ".dll");
  mut i = 0usize;
  while i < folders.len() {
    imm candidate = joined(folders[i].view(), file.view());
    if fs.isFile(candidate.view()) { return Ok[String, String][candidate]; }
    i = i + 1usize;
  }
  mut listed = String.from("none");
  if paths.len() > 0usize { listed = String.join(paths.view(), ", "); }
  imm deps = depsFolder(repo);
  mut m = cat(pkgName, "'s [link] runtime names ", name, ", but ", file.view(), " is in none of the folders Congo looks in: [link] paths (");
  m <- listed.view(), "), then each folder in ", deps.view(), " (python tools/deps/fetch.py fills it), then the folders LIB lists, then the folders PATH lists";
  Error[String, String][m];
}

// Copy a runtime DLL into a program's folder, unless the copy there is the
// same already, byte for byte; whether it copied
fn copyRuntime(source &Array[u8], folder &Array[u8], name &Array[u8]) Result[bool, String] {
  imm file = cat(name, ".dll");
  imm target = joined(folder, file.view());
  copyIfChanged(source, target.view());
}

// Copy a file, unless the copy at target is the same already, byte for byte;
// whether it copied
fn copyIfChanged(source &Array[u8], target &Array[u8]) Result[bool, String] {
  mut data = String.empty();
  match fs.readFile(source) {
    case mut ok Ok { data <=> ok.value; }
    case imm e Error {
      imm why = e.value.message();
      return Error[bool, String][cat("cannot copy ", source, " to ", target, ": ", why.view())];
    }
  }
  if fs.isFile(target) {
    mut there = String.empty();
    match fs.readFile(target) {
      case mut ok Ok { there <=> ok.value; }
      case is Error {}
    }
    if there.len() == data.len() and there.equals(data.view()) { return Ok[bool, String][false]; }
  }
  match fs.writeFile(target, data.view()) {
    case is Ok {}
    case imm e Error {
      imm why = e.value.message();
      return Error[bool, String][cat("cannot copy ", source, " to ", target, ": ", why.view())];
    }
  }
  Ok[bool, String][true];
}

// Link the objects into exe: the program's object first, then the packages
// it imports, last built first; and the C libraries every one of them names,
// in the same order, each once. A C package's own object is linked like any
// other: it defines nothing (as core's does not), and so needs no case of
// its own. The linker is found at the session's first link.
fn link(s &mut Session, plan &Plan, objs &List[String], exe &Array[u8], announce bool) Result[void, String] {
  if not s.hasLinker {
    mut conestd = String.empty();
    match findConestd(s.conec.view()) {
      case mut ok Ok { conestd <=> ok.value; }
      case imm e Error { return Error[void, String][e.value.copy()]; }
    }
    match findLinker(conestd.view()) {
      case mut ok Ok { s.linker <=> ok.value; }
      case imm e Error { return Error[void, String][e.value.copy()]; }
    }
    s.hasLinker = true;
  }
  imm reg = &s.reg;
  // The units, the program's first, then the rest last built first
  mut units = List[usize].empty();
  mut objOrder = List[String].empty();
  imm n = plan.order.len();
  units.push(*plan.order[n - 1usize]);
  objOrder.push(objs[n - 1usize].copy());
  mut i = n - 1usize;
  while i > 0usize {
    i = i - 1usize;
    units.push(*plan.order[i]);
    objOrder.push(objs[i].copy());
  }
  mut libraries = List[String].empty();
  mut paths = List[String].empty();
  i = 0usize;
  while i < units.len() {
    imm pkg = reg.packages[plan.units[*units[i]].pkg];
    mut j = 0usize;
    while j < pkg.libraries.len() {
      mut seen = false;
      mut k = 0usize;
      while k < libraries.len() {
        if libraries[k].equals(pkg.libraries[j].view()) { seen = true; }
        k = k + 1usize;
      }
      if not seen { libraries.push(pkg.libraries[j].copy()); }
      j = j + 1usize;
    }
    j = 0usize;
    while j < pkg.linkPaths.len() {
      if not holdsPath(&paths, pkg.linkPaths[j].view()) { paths.push(pkg.linkPaths[j].copy()); }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  // The runtime DLLs every one of them names, each once, found before the
  // link: a missing one stops the build with no program linked, an earlier
  // build's removed, as a failed link leaves none
  mut runtimeNames = List[String].empty();
  mut runtimeFiles = List[String].empty();
  imm folders = runtimeFolders(s.repo.view(), &paths);
  i = 0usize;
  while i < units.len() {
    imm pkg = reg.packages[plan.units[*units[i]].pkg];
    mut j = 0usize;
    while j < pkg.runtime.len() {
      imm name = pkg.runtime[j].view();
      if not holdsName(&runtimeNames, name) {
        match findRuntime(s.repo.view(), name, pkg.name.view(), &folders, &paths) {
          case imm ok Ok { runtimeFiles.push(ok.value.copy()); }
          case imm e Error {
            fs.removeFile(exe);
            return Error[void, String][e.value.copy()];
          }
        }
        runtimeNames.push(String.from(name));
      }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  // The link line: the objects, conestd, then the C libraries the packages'
  // [link] tables name, each searched for first in their [link] paths
  mut command = List[String].empty();
  command.push(s.linker.tool.copy());
  command.push(String.from("/NOLOGO"));
  i = 0usize;
  while i < objOrder.len() {
    command.push(objOrder[i].copy());
    i = i + 1usize;
  }
  command.push(s.linker.conestd.copy());
  i = 0usize;
  while i < paths.len() {
    command.push(cat("/LIBPATH:", paths[i].view()));
    i = i + 1usize;
  }
  i = 0usize;
  while i < libraries.len() {
    command.push(cat(libraries[i].view(), ".lib"));
    i = i + 1usize;
  }
  command.push(cat("/OUT:", exe));
  command.push(String.from("/SUBSYSTEM:CONSOLE"));
  command.push(String.from("msvcrt.lib"));
  command.push(String.from("legacy_stdio_definitions.lib"));
  if announce {
    imm place = shown(exe);
    say("Linking", place.view());
  }
  moveAsideIfRunning(exe);
  match fs.removeFile(exe) {
    case is Ok {}
    case imm e Error {
      if not e.value.notFound() {
        fail(e.value.message());
      }
    }
  }
  mut changes = noChanges();
  s.linker.apply(&mut changes);
  mut code = 0u32;
  mut said = String.empty();
  match process.run(command.view()) {
    case imm ok Ok {
      code = ok.value.exitCode;
      said = consoleText(ok.value.stdout.view());
      imm err = consoleText(ok.value.stderr.view());
      said <- err.view();
    }
    case imm e Error {
      fail(e.value.message());
    }
  }
  changes.restore();
  if code != 0u32 {
    mut named = String.empty();
    i = 0usize;
    while i < units.len() {
      imm pkg = reg.packages[plan.units[*units[i]].pkg];
      if pkg.libraries.len() > 0usize {
        if not named.isEmpty() { named <- "; "; }
        imm libs = String.join(pkg.libraries.view(), ", ");
        named <- pkg.name.view(), " names ", libs.view();
      }
      i = i + 1usize;
    }
    imm line = String.join(command.view(), " ");
    mut m = cat("link failed:\n", line.view(), "\n", said.view());
    if not named.isEmpty() {
      m <- "\nC libraries linked (", named.view(),
        "): the linker looks for each in the folders [link] paths names, then in the folders the LIB environment variable lists";
    }
    return Error[void, String][m];
  }
  imm exeFolder = parentOf(exe);
  i = 0usize;
  while i < runtimeNames.len() {
    match copyRuntime(runtimeFiles[i].view(), exeFolder.view(), runtimeNames[i].view()) {
      case imm ok Ok {
        if ok.value and announce {
          imm place = shown(runtimeFiles[i].view());
          say("Copying", place.view());
        }
      }
      case imm e Error { return Error[void, String][e.value.copy()]; }
    }
    i = i + 1usize;
  }
  // The kernels of every package of the build, each beside the program as a
  // runtime DLL is, where gpuwork's readSpirv finds it by its name
  i = 0usize;
  while i < units.len() {
    imm name = reg.packages[plan.units[*units[i]].pkg].name.view();
    if s.spvs.contains(name) {
      imm spv = s.spvs[name].copy();
      imm spvFolder = parentOf(spv.view());
      if not samePath(spvFolder.view(), exeFolder.view()) {
        imm spvName = path.name(spv.view());
        imm target = joined(exeFolder.view(), spvName.view());
        match copyIfChanged(spv.view(), target.view()) {
          case imm ok Ok {
            if ok.value and announce {
              imm place = shown(spv.view());
              say("Copying", place.view());
            }
          }
          case imm e Error { return Error[void, String][e.value.copy()]; }
        }
      }
    }
    i = i + 1usize;
  }
  succeeded();
}
