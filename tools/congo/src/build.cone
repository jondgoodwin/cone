// Building: each package's compile, the link, a package's build as a whole,
// and a lone file standing as a package (congo.py's compile_unit, Session,
// build, build_folder, lone_package and lone_build_root).
//
// What can go wrong in a build that 'congo test' goes on after -- a source it
// cannot scan or resolve, a compile or a link that fails, no conec or linker
// -- is answered as a value, a Result whose Err is congo.py's CongoError
// message. 'congo build' and 'congo run' end on the first, in buildPackage.

// Where a package's build goes: build/<mode>/ in the package's folder; a
// lone file's under the Congo home
fn buildFolder(pkg: &Package, mode: &str) Path {
  if pkg.lone {
    let root = loneBuildRoot(&pkg.src);
    return root.join(mode);
  }
  let folder = pkg.root.join("build");
  folder.join(mode)
}

// The compiles of one build folder, and its link. A package is compiled at
// most once in a session: 'congo test' builds the package, then each test
// program against the objects and include files that build left, compiling
// only what a test imports that the package does not (stdio, say).
struct Session {
  pub repo: Path;
  pub reg: Registry;
  pub out: Path;
  pub mode: String;
  pub objs: Dict[String, Path];     // each library compiled into out, by name
  pub spvs: Dict[String, Path];     // each package's kernels compiled into out, by name
  pub gpuChecked: List[String];     // packages whose imports were checked for the GPU
  pub warned: List[String];         // the packages whose hand include file was warned of
  pub conec: Path;                  // found at the first compile; empty before
  pub hasLinker: bool;
  pub linker: Linker;               // found at the first link
  // TEMPORARY, a provisional mechanism whose final design is open: each
  // '-D NAME' or '-D NAME=123' given to build, run or test, passed to every
  // conec compile of the build, the packages it imports included (conec's
  // isDefined, definedInt)
  pub defines: List[String];
  // Whether a compile whose key is unchanged is skipped: '--no-cache' says
  // not (cache.cone)
  pub useCache: bool;
  // '--strip': conec is passed --strip for every compile of the build, and a
  // release link writes no PDB (congo.py, STRIP_DEBUG)
  pub strip: bool;
}

fn newSession(repo: &Path, reg: Registry, out: &Path, mode: &str, defines: &List[String], useCache: bool, strip: bool) Session {
  Session(repo.copy(), reg, out.copy(), String.from(mode), Dict[String, Path].empty(),
    Dict[String, Path].empty(), List[String].empty(), List[String].empty(), Path.from(""), false, noLinkerYet(),
    copyStrings(defines), useCache, strip)
}

// Build pkg and everything it imports into its build folder, each package
// compiled on its own; answer the executable, or for a library its object.
// Every description is written, and every package compiled unless its key is
// unchanged (cache.cone). The first failure ends Congo.
fn buildPackage(repo: &Path, pkg: Package, mode: &str, defines: &List[String], useCache: bool, strip: bool) Path {
  let folders = registryFolders(repo);
  let out = buildFolder(&pkg, mode);
  let indexes = registryIndexes();
  var s = newSession(repo, readRegistry(folders, &indexes), &out, mode, defines, useCache, strip);
  let top = s.reg.add(pkg);
  match build(&mut s, top) {
    case var Ok(ok) {
      var built: Path = "";
      built <-> ok;
      built
    }
    case let Err(e) { fail(e.copy()) }
  }
}

// Build the registry's package top, and everything it imports, in the
// session; answer the executable, or for a library its object
fn build(s: &mut Session, top: usize) Result[Path, String] {
  let isLibrary = s.reg.packages[top].output.equals("library");
  let name = s.reg.packages[top].name.copy();
  match restore(&mut s.reg, top) {
    case is Ok {}
    case let Err(e) { return Err[Path, String](e.copy()); }
  }
  var plan = emptyPlan();
  match buildOrder(&s.reg, top) {
    case var Ok(ok) { plan <-> ok; }
    case let Err(e) { return Err[Path, String](e.copy()); }
  }
  var objs = List[Path].empty();
  match compile(s, &plan, top, "", true) {
    case var Ok(ok) { objs <-> ok; }
    case let Err(e) { return Err[Path, String](e.copy()); }
  }
  if isLibrary {
    let obj = objs[objs.len() - 1usize].copy();
    let place = shown(&obj);
    var finished = cat(s.mode.view(), " library object ", place.view());
    if s.spvs.contains(name.view()) {
      let kernels = shown(&s.spvs[name.view()]);
      finished <- " and kernels ", kernels.view();
    }
    say("Finished", finished.view());
    return Ok[Path, String](obj);
  }
  let exeName = cat(name.view(), ".exe");
  let exe = s.out.join(exeName.view());
  match link(s, &plan, &objs, &exe, true) {
    case is Ok {}
    case let Err(e) { return Err[Path, String](e.copy()); }
  }
  let place = shown(&exe);
  let finished = cat(s.mode.view(), " ", place.view());
  say("Finished", finished.view());
  Ok[Path, String](exe)
}

// A test or example program, built as a lone file of its own that imports
// the package by name: its imports resolved through the session's
// registry, where the package under test is found first; the packages it
// imports compiled into the package's build folder (once each, most already
// there), and the program itself into a folder of its own, dest, then
// linked. Answers the executable.
fn buildProgram(s: &mut Session, file: &Path, dest: &Path) Result[Path, String] {
  var pkg = emptyPackage();
  match lonePackage(file) {
    case var Ok(ok) { pkg <-> ok; }
    case let Err(e) { return Err[Path, String](e.copy()); }
  }
  let exeName = cat(pkg.name.view(), ".exe");
  let top = s.reg.add(pkg);
  match restore(&mut s.reg, top) {
    case is Ok {}
    case let Err(e) { return Err[Path, String](e.copy()); }
  }
  var plan = emptyPlan();
  match buildOrder(&s.reg, top) {
    case var Ok(ok) { plan <-> ok; }
    case let Err(e) { return Err[Path, String](e.copy()); }
  }
  var objs = List[Path].empty();
  match compile(s, &plan, top, dest, false) {
    case var Ok(ok) { objs <-> ok; }
    case let Err(e) { return Err[Path, String](e.copy()); }
  }
  let exe = dest.join(exeName.view());
  match link(s, &plan, &objs, &exe, false) {
    case is Ok {}
    case let Err(e) { return Err[Path, String](e.copy()); }
  }
  Ok[Path, String](exe)
}

// A lone file's build goes under the Congo home, not beside the file: the
// folder a lone file sits in is nobody's package, and may well hold a
// 'build' folder of its own that 'congo clean' must not delete. Named for the
// file and the SHA-1 of its absolute path, lower-cased, as congo.py names it
// (with '\', as pathlib spells the path, so that both Congos agree).
fn loneBuildRoot(file: &Path) Path {
  let abs = resolved(file);
  var spelled = native(&abs);
  spelled.lowerAscii();
  let digest = sha1Hex(spelled.view());
  let home = congoHome();
  let lone = home.join("lone");
  let short = digest.sub(0usize, 10usize);
  let folder = cat(file.stem(), "-", short.view());
  lone.join(folder.view())
}

// A lone file with no manifest is a program of one module, named by its
// 'mod' line. A file with none is named by the file here, and the compiler
// refuses it for the missing line (ErrorNoModDcl).
fn lonePackage(given: &Path) Result[Package, String] {
  let file = resolved(given);
  let place = native(&file);
  if !fs.isFile(&file) { return Err[Package, String](cat("no file ", place.view())); }
  var header = noHeader();
  match scanHeader(&file) {
    case var Ok(ok) { header <-> ok; }
    case let Err(e) { return Err[Package, String](e.copy()); }
  }
  let name = if header.hasMod {header.modName.copy()} else {String.from(file.stem())};
  let fault = nameFault(name.view());
  if !header.hasMod && !fault.isEmpty() {
    return Err[Package, String](cat(place.view(), ": with no 'mod' line it is named by its file: '", name.view(), "' ", fault.view(),
      "; give the file a 'mod' line"));
  }
  if !fault.isEmpty() {
    return Err[Package, String](cat(place.view(), ": 'mod ", name.view(), "': '", name.view(), "' ", fault.view(),
      "; rename the module, and the file where it is named for it"));
  }
  let folder = file.parent();
  Ok[Package, String](Package(name, String.empty(), String.from("executable"), folder, file.copy(), true,
    List[String].empty(), List[Path].empty(), List[String].empty(), false))
}

// Write the package's build description into out and compile the package
// on its own. Every package but the one being built is a library; the one
// being built is what its manifest says. The description lists the unit's
// dependency closure for its include files, which are in 'includes': the
// session's build folder, where every package but a test program is
// compiled. A library's compile writes its include file beside its object,
// which is what every package compiled after it that imports it is compiled
// against.
//
// The compile is skipped where its key is unchanged (cache.cone). A
// description with no package line for core (core's own, and those of what
// core imports) has conec load the prelude from the packages folder
// CONE_PACKAGES names: what it reads there is part of the key. With no core
// in the build there is no CONE_PACKAGES, and Congo cannot say what conec
// reads, so that compile is never skipped. 'hasCore' and 'coreUnit' say
// whether the build has core, and where.
fn compileUnit(conec: &Path, reg: &Registry, plan: &Plan, u: usize, out: &Path, includes: &Path, mode: &str,
    defines: &List[String], strip: bool, top: bool, announce: bool, useCache: bool, hasCore: bool, coreUnit: usize) Result[Path, String] {
  let unit = &plan.units[u];
  let pkg = &reg.packages[unit.pkg];
  let output = if top {pkg.output.copy()} else {String.from("library")};
  let descName = cat(pkg.name.view(), ".conebuild");
  let desc = out.join(descName.view());
  let packages = closure(plan, reg, u);
  let text = description(reg, unit, mode, output.view(), includes, &packages);
  match fs.writeFile(&desc, text.view()) {
    case is Ok {}
    case let Err(e) {
      fail(fsMessage(&e));
    }
  }
  let incl = includeFor(pkg, out);
  let objName = cat(pkg.name.view(), ".obj");
  let obj = out.join(objName.view());
  let isLibrary = output.equals("library");
  var outputs = List[Path].empty();
  outputs.push(obj.copy());
  if isLibrary { outputs.push(incl.copy()); }
  let outText = native(out);
  let descText = native(&desc);
  let rest = argList("-o", outText.view(), descText.view());
  let command = conecCommand(conec, defines, strip, &rest);
  // What the compile reads: the manifest, the description, every source of
  // the package, the include file of every package the description names,
  // and where conec loads the prelude from the packages folder, what it
  // reads there
  var files = List[KeyFile].empty();
  if !pkg.lone {
    let manifest = pkg.root.join("congo.toml");
    files.push(keyFileOf("manifest", &manifest));
  }
  files.push(keyFileOf("description", &desc));
  let order = walkOrder(&unit.mods);
  var imported = copyIndices(&packages);
  var w = 0usize;
  while w < order.len() {
    let m = *order[w];
    var f = 0usize;
    while f < unit.mods[m].files.len() {
      files.push(keyFileOf("source", &unit.mods[m].files[f]));
      f = f + 1usize;
    }
    w = w + 1usize;
  }
  w = 0usize;
  while w < order.len() {
    let m = *order[w];
    var l = 0usize;
    while l < unit.mods[m].lines.len() {
      let dep = unit.mods[m].lines[l].pkg;
      if !holds(&imported, dep) { imported.push(dep); }
      l = l + 1usize;
    }
    w = w + 1usize;
  }
  var i = 0usize;
  while i < imported.len() {
    let theirs = includeFor(&reg.packages[*imported[i]], includes);
    files.push(keyFileOf("include", &theirs));
    i = i + 1usize;
  }
  var keyable = true;
  var preludeNamed = false;
  i = 0usize;
  while i < packages.len() {
    if reg.packages[*packages[i]].name.equals("core") { preludeNamed = true; }
    i = i + 1usize;
  }
  if !preludeNamed {
    if hasCore { searchedSources(&reg.packages[plan.units[coreUnit].pkg], "prelude", &mut files); }
    else { keyable = false; }
  }
  let inputs = keyInputs(&command, &files);
  let key = keyOf(&inputs);
  let keyName = cat(pkg.name.view(), ".key");
  let keyPath = out.join(keyName.view());
  if keyable && useCache && cacheFresh(&keyPath, key.view(), &outputs) { return Ok[Path, String](obj); }
  // No key stands while conec runs, so a compile that fails or is killed
  // leaves none; and a library's include file is written afresh, so one left
  // by an earlier build never stands in for it
  removeIfThere(&keyPath);
  removeIfThere(&incl);
  if announce {
    let label = pkg.label();
    let root = native(&pkg.root);
    let compiling = cat(label.view(), " (", root.view(), ")");
    say("Compiling", compiling.view());
  }
  if !runConec(&command) {
    return Err[Path, String](cat("could not compile ", pkg.name.view(), " (build description: ", descText.view(), ")"));
  }
  if !fs.isFile(&obj) {
    let place = native(&obj);
    return Err[Path, String](cat("conec wrote no object at ", place.view()));
  }
  if isLibrary && !fs.isFile(&incl) {
    let place = native(&incl);
    return Err[Path, String](cat("conec wrote no include file for ", pkg.name.view(), " at ", place.view()));
  }
  if keyable { recordKey(&keyPath, key.view(), &inputs, &outputs); }
  Ok[Path, String](obj)
}

// Run conec as the command line says (conecCommand), and show what it said
// but its closing 'Compile finished' line; whether it succeeded
fn runConec(args: &List[String]) bool {
  var chatter = String.empty();
  var code = 0u32;
  match process.run(args.view()) {
    case let Ok(ok) {
      chatter = utf8Text(ok.stdout.view());
      let err = utf8Text(ok.stderr.view());
      chatter <- err.view();
      code = ok.exitCode;
    }
    case let Err(e) {
      fail(e.message());
    }
  }
  let lines = splitLines(chatter.view());
  var shownLines = List[String].empty();
  var i = 0usize;
  while i < lines.len() {
    if !isBlank(lines[i].view()) && !lines[i].startsWith("Compile finished") {
      shownLines.push(lines[i].copy());
    }
    i = i + 1usize;
  }
  if shownLines.len() > 0usize {
    let said = String.join(shownLines.view(), "\n");
    printStr(said.view());
    printStr("\n");
    printFlush();
  }
  code == 0u32
}

fn makeFolder(folder: &Path) {
  match fs.makeDirAll(folder) {
    case is Ok {}
    case let Err(e) {
      fail(fsMessage(&e));
    }
  }
}

// Compile every unit of the plan not compiled in the session already, each
// after what it imports; answer the objects in the order's order. 'top' gets
// the output its manifest says, into topOut where that is given (a test
// program's own folder); every other package is a library, into the
// session's build folder. 'announce' is whether top's compile is announced;
// every other package's is.
fn compile(s: &mut Session, plan: &Plan, top: usize, topOut: &Path, announce: bool) Result[List[Path], String] {
  // Found at the first compile, after the imports are resolved, so that an
  // error in the source is reported before anything about the machine
  if s.conec.isEmpty() {
    match findConec(&s.repo) {
      case var Ok(ok) { s.conec <-> ok; }
      case let Err(e) { return Err[List[Path], String](e.copy()); }
    }
  }
  let out = s.out.copy();
  makeFolder(&out);
  var changes = noChanges();
  // Every package after core loads the prelude from core's generated
  // include file, which its package line names. core's own compile has no
  // such line, and loads the prelude from the package search path, which
  // must give the very file core is compiled from, or the two are two
  // modules named core: so the packages folder conec takes it from is the
  // registry folder Congo found core in
  var core = 0usize;
  let hasCoreUnit = plan.unitNamed(&s.reg, "core", &mut core);
  let coreOfBuild = core;
  if hasCoreUnit {
    let folder = s.reg.packages[plan.units[core].pkg].root.parent();
    let named = native(&folder);
    changes.set("CONE_PACKAGES", named.view());
  }
  // An include file written by hand at a package's root is no longer read:
  // say so, once, so that nobody edits it expecting it to count
  var i = 0usize;
  while i < plan.order.len() {
    let pkg = &s.reg.packages[plan.units[*plan.order[i]].pkg];
    let hand = pkg.handInclude();
    if !pkg.lone && fs.isFile(&hand) && !holdsName(&s.warned, pkg.name.view()) {
      s.warned.push(pkg.name.copy());
      let place = native(&hand);
      warn(cat("warning: ", place.view(), " is not used: a package's importers compile against the include file its own compile generates, build/<mode>/",
        pkg.name.view(), ".cone"));
    }
    i = i + 1usize;
  }
  // Before anything is compiled: a package compiled for the GPU, and a
  // marked package being built, import only packages marked for it
  i = 0usize;
  while i < plan.order.len() {
    let u = *plan.order[i];
    let pkg = &s.reg.packages[plan.units[u].pkg];
    let compiledForGpu = plan.units[u].kernels || (plan.units[u].pkg == top && (pkg.gpu || plan.units[u].hasGpu));
    if compiledForGpu && !holdsName(&s.gpuChecked, pkg.name.view()) {
      match checkGpuMarks(plan, &s.reg, u) {
        case is Ok {}
        case let Err(e) {
          changes.restore();
          return Err[List[Path], String](e.copy());
        }
      }
      s.gpuChecked.push(pkg.name.copy());
    }
    i = i + 1usize;
  }
  var objs = List[Path].empty();
  i = 0usize;
  while i < plan.order.len() {
    let u = *plan.order[i];
    let isTop = plan.units[u].pkg == top;
    let name = s.reg.packages[plan.units[u].pkg].name.copy();
    if !isTop && s.objs.contains(name.view()) {
      objs.push(s.objs[name.view()].copy());
    }
    else {
      let own = isTop && !topOut.isEmpty();
      let dest = if own {topOut.copy()} else {out.copy()};
      makeFolder(&dest);
      var obj: Path = "";
      match compileUnit(&s.conec, &s.reg, plan, u, &dest, &out, s.mode.view(), &s.defines, s.strip, isTop,
        announce || !isTop, s.useCache, hasCoreUnit, coreOfBuild) {
        case var Ok(ok) { obj <-> ok; }
        case let Err(e) {
          changes.restore();
          return Err[List[Path], String](e.copy());
        }
      }
      if !own && (!isTop || s.reg.packages[top].output.equals("library")) {
        s.objs.insert(name, obj.copy());
      }
      objs.push(obj);
    }
    i = i + 1usize;
  }
  // Then the kernels of each marked package that has them, once a session,
  // into the build folder, beside its object
  var coreUnit = 0usize;
  let hasCore = plan.unitNamed(&s.reg, "core", &mut coreUnit);
  i = 0usize;
  while i < plan.order.len() {
    let u = *plan.order[i];
    let name = s.reg.packages[plan.units[u].pkg].name.copy();
    if plan.units[u].kernels && hasCore && !s.spvs.contains(name.view()) {
      match compileGpu(s, plan, u, coreUnit) {
        case let Ok(ok) { s.spvs.insert(name, ok.copy()); }
        case let Err(e) {
          changes.restore();
          return Err[List[Path], String](e.copy());
        }
      }
    }
    i = i + 1usize;
  }
  changes.restore();
  Ok[List[Path], String](objs)
}

// Whether list holds name
fn holdsName(list: &List[String], name: &str) bool {
  var i = 0usize;
  while i < list.len() {
    if list[i].equals(name) { return true; }
    i = i + 1usize;
  }
  false
}

// Whether list holds a path the same as p, as Windows compares them
fn holdsPath(list: &List[Path], p: &Path) bool {
  var i = 0usize;
  while i < list.len() {
    if samePath(&list[i], p) { return true; }
    i = i + 1usize;
  }
  false
}

// Congo building itself, where the executable it links is the one running.
// Windows will not remove a running program's file, but will rename it: so
// the running Congo is moved aside, to <exe>.old (one left by a build before
// removed first), and the new one is linked where any build links it.
fn moveAsideIfRunning(exe: &Path) {
  var running: Path = "";
  match process.currentExe() {
    case var Ok(ok) { running <-> ok; }
    case is Err { return; }
  }
  if !samePath(&running, exe) { return; }
  let old = Path.fromString(cat(exe.view(), ".old"));
  match fs.removeFile(&old) {
    case is Ok {}
    case let Err(e) {
      if !e.notFound() {
        fail(fsMessage(&e));
      }
    }
  }
  match fs.rename(exe, &old) {
    case is Ok {}
    case let Err(e) {
      fail(fsMessage(&e));
    }
  }
}

// -------- runtime libraries: the DLLs a program needs beside it --------
//
// A package's [link] runtime list names the DLLs a program using it loads at
// run time (SDL3, OpenSSL's libssl-3 and libcrypto-3). Every executable
// Congo links gets the DLLs of every package of its build beside it, copied
// into its folder: so a program inherits them from whatever it imports, at
// any depth, and names nothing itself.

// The fetched-dependencies folder: CONE_DEPS, else deps/ in the repository,
// which tools/deps/fetch.py fills
fn depsFolder(repo: &Path) Path {
  let named = envOr("CONE_DEPS", "");
  if !named.isEmpty() {
    let given = Path.from(named.view());
    return resolved(&given);
  }
  repo.join("deps")
}

// The folders an environment variable lists, ';'-separated, onto out
fn envFolders(name: &str, out: &mut List[Path]) {
  let listed = envOr(name, "");
  let entries = splitText(listed.view(), ';');
  var i = 0usize;
  while i < entries.len() {
    if !entries[i].isEmpty() {
      let given = Path.from(entries[i].view());
      out.push(given.normalize());
    }
    i = i + 1usize;
  }
}

// Where a runtime DLL is looked for, in order: the build's [link] paths, in
// the order the linker is given them; each folder in the fetched-
// dependencies folder, by name; the folders LIB lists, where an import
// library's own DLL usually sits beside it (SDL3's development kit); then
// the folders PATH lists. The first copy found is the one copied.
fn runtimeFolders(repo: &Path, paths: &List[Path]) List[Path] {
  var folders = copyPaths(paths);
  let deps = depsFolder(repo);
  if fs.isDir(&deps) {
    var entries = List[fs.DirEntry].empty();
    match fs.readDir(&deps) {
      case var Ok(ok) { entries <-> ok; }
      case is Err {}
    }
    var i = 0usize;
    while i < entries.len() {
      if fs.isDir(&entries[i].path) { folders.push(entries[i].path.copy()); }
      i = i + 1usize;
    }
  }
  envFolders("LIB", &mut folders);
  envFolders("PATH", &mut folders);
  folders
}

// The DLL a [link] runtime list names, where runtimeFolders finds it first;
// one that is nowhere is an error naming it and the package that asked
fn findRuntime(repo: &Path, name: &str, pkgName: &str, folders: &List[Path], paths: &List[Path]) Result[Path, String] {
  let file = cat(name, ".dll");
  var i = 0usize;
  while i < folders.len() {
    let candidate = folders[i].join(file.view());
    if fs.isFile(&candidate) { return Ok[Path, String](candidate); }
    i = i + 1usize;
  }
  var listed = String.from("none");
  if paths.len() > 0usize { listed = nativeList(paths, ", "); }
  let deps = depsFolder(repo);
  let depsText = native(&deps);
  var m = cat(pkgName, "'s [link] runtime names ", name, ", but ", file.view(), " is in none of the folders Congo looks in: [link] paths (");
  m <- listed.view(), "), then each folder in ", depsText.view(), " (python tools/deps/fetch.py fills it), then the folders LIB lists, then the folders PATH lists";
  Err[Path, String](m)
}

// Copy a runtime DLL into a program's folder, unless the copy there is the
// same already, byte for byte; whether it copied
fn copyRuntime(source: &Path, folder: &Path, name: &str) Result[bool, String] {
  let file = cat(name, ".dll");
  let target = folder.join(file.view());
  copyIfChanged(source, &target)
}

// Copy a file, unless the copy at target is the same already, byte for byte;
// whether it copied
fn copyIfChanged(source: &Path, target: &Path) Result[bool, String] {
  var data = String.empty();
  match fs.readFile(source) {
    case var Ok(ok) { data <-> ok; }
    case let Err(e) {
      let why = fsMessage(&e);
      let from = native(source);
      let to = native(target);
      return Err[bool, String](cat("cannot copy ", from.view(), " to ", to.view(), ": ", why.view()));
    }
  }
  if fs.isFile(target) {
    var there = String.empty();
    match fs.readFile(target) {
      case var Ok(ok) { there <-> ok; }
      case is Err {}
    }
    if there.len() == data.len() && there.equals(data.view()) { return Ok[bool, String](false); }
  }
  match fs.writeFile(target, data.view()) {
    case is Ok {}
    case let Err(e) {
      let why = fsMessage(&e);
      let from = native(source);
      let to = native(target);
      return Err[bool, String](cat("cannot copy ", from.view(), " to ", to.view(), ": ", why.view()));
    }
  }
  Ok[bool, String](true)
}

// Link the objects into exe: the program's object first, then the packages
// it imports, last built first; and the C libraries every one of them names,
// in the same order, each once. A C package's own object is linked like any
// other: it defines nothing (as core's does not), and so needs no case of
// its own. The linker is found at the session's first link.
fn link(s: &mut Session, plan: &Plan, objs: &List[Path], exe: &Path, announce: bool) Result[void, String] {
  if !s.hasLinker {
    var conestd: Path = "";
    match findConestd(&s.conec) {
      case var Ok(ok) { conestd <-> ok; }
      case let Err(e) { return Err[void, String](e.copy()); }
    }
    match findLinker(&conestd, s.useCache) {
      case var Ok(ok) { s.linker <-> ok; }
      case let Err(e) { return Err[void, String](e.copy()); }
    }
    s.hasLinker = true;
  }
  let reg = &s.reg;
  // The units, the program's first, then the rest last built first
  var units = List[usize].empty();
  var objOrder = List[Path].empty();
  let n = plan.order.len();
  units.push(*plan.order[n - 1usize]);
  objOrder.push(objs[n - 1usize].copy());
  var i = n - 1usize;
  while i > 0usize {
    i = i - 1usize;
    units.push(*plan.order[i]);
    objOrder.push(objs[i].copy());
  }
  var libraries = List[String].empty();
  var paths = List[Path].empty();
  i = 0usize;
  while i < units.len() {
    let pkg = &reg.packages[plan.units[*units[i]].pkg];
    var j = 0usize;
    while j < pkg.libraries.len() {
      var seen = false;
      var k = 0usize;
      while k < libraries.len() {
        if libraries[k].equals(pkg.libraries[j].view()) { seen = true; }
        k = k + 1usize;
      }
      if !seen { libraries.push(pkg.libraries[j].copy()); }
      j = j + 1usize;
    }
    j = 0usize;
    while j < pkg.linkPaths.len() {
      if !holdsPath(&paths, &pkg.linkPaths[j]) { paths.push(pkg.linkPaths[j].copy()); }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  // The runtime DLLs every one of them names, each once, found before the
  // link: a missing one stops the build with no program linked, an earlier
  // build's removed, as a failed link leaves none
  var runtimeNames = List[String].empty();
  var runtimeFiles = List[Path].empty();
  let folders = runtimeFolders(&s.repo, &paths);
  i = 0usize;
  while i < units.len() {
    let pkg = &reg.packages[plan.units[*units[i]].pkg];
    var j = 0usize;
    while j < pkg.runtime.len() {
      let name = pkg.runtime[j].view();
      if !holdsName(&runtimeNames, name) {
        match findRuntime(&s.repo, name, pkg.name.view(), &folders, &paths) {
          case let Ok(ok) { runtimeFiles.push(ok.copy()); }
          case let Err(e) {
            _ = fs.removeFile(exe);
            return Err[void, String](e.copy());
          }
        }
        runtimeNames.push(String.from(name));
      }
      j = j + 1usize;
    }
    i = i + 1usize;
  }
  if announce {
    let place = shown(exe);
    say("Linking", place.view());
  }
  moveAsideIfRunning(exe);
  match fs.removeFile(exe) {
    case is Ok {}
    case let Err(e) {
      if !e.notFound() {
        fail(fsMessage(&e));
      }
    }
  }
  // The PDB of an earlier link is no part of this one's
  let pdbName = cat(exe.stem(), ".pdb");
  let pdb = exe.parent().join(pdbName.view());
  _ = fs.removeFile(&pdb);
  var attempt = runLink(s, &objOrder, exe, &libraries, &paths);
  var again = String.empty();
  // A link that failed the way a stale Visual Studio environment makes one
  // fail is tried once more, in the environment captured afresh
  if attempt.code != 0u32 && s.linker.environmental(attempt.said.view(), attempt.code, attempt.ran, &libraries)
      && s.linker.recapture() {
    attempt = runLink(s, &objOrder, exe, &libraries, &paths);
    again = String.from("\n(linked twice: the second time in Visual Studio's environment captured again from vcvars64.bat)");
  }
  if attempt.code != 0u32 {
    var named = String.empty();
    i = 0usize;
    while i < units.len() {
      let pkg = &reg.packages[plan.units[*units[i]].pkg];
      if pkg.libraries.len() > 0usize {
        if !named.isEmpty() { named <- "; "; }
        let libs = String.join(pkg.libraries.view(), ", ");
        named <- pkg.name.view(), " names ", libs.view();
      }
      i = i + 1usize;
    }
    let line = String.join(attempt.command.view(), " ");
    var m = cat("link failed:\n", line.view(), "\n", attempt.said.view());
    if !named.isEmpty() {
      m <- "\nC libraries linked (", named.view(),
        "): the linker looks for each in the folders [link] paths names, then in the folders the LIB environment variable lists";
    }
    m <- again.view();
    return Err[void, String](m);
  }
  let exeFolder = exe.parent();
  i = 0usize;
  while i < runtimeNames.len() {
    match copyRuntime(&runtimeFiles[i], &exeFolder, runtimeNames[i].view()) {
      case let Ok(ok) {
        if ok && announce {
          let place = shown(&runtimeFiles[i]);
          say("Copying", place.view());
        }
      }
      case let Err(e) { return Err[void, String](e.copy()); }
    }
    i = i + 1usize;
  }
  // The kernels of every package of the build, each beside the program as a
  // runtime DLL is, where gpuwork's readSpirv finds it by its name
  i = 0usize;
  while i < units.len() {
    let name = reg.packages[plan.units[*units[i]].pkg].name.view();
    if s.spvs.contains(name) {
      let spv = s.spvs[name].copy();
      let spvFolder = spv.parent();
      if !samePath(&spvFolder, &exeFolder) {
        let target = exeFolder.join(spv.name());
        match copyIfChanged(&spv, &target) {
          case let Ok(ok) {
            if ok && announce {
              let place = shown(&spv);
              say("Copying", place.view());
            }
          }
          case let Err(e) { return Err[void, String](e.copy()); }
        }
      }
    }
    i = i + 1usize;
  }
  succeeded()
}

// One run of the linker: the line it was given, its exit status, whether it
// could be started, and what it said
struct LinkRun {
  pub command: List[String];
  pub code: u32;
  pub ran: bool;
  pub said: String;
}

// Run the linker over the objects, in the session's linker environment. The
// link line: the objects, conestd, then the C libraries the packages' [link]
// tables name, each searched for first in their [link] paths. The C
// runtime's own libraries are the toolchain's and stay here; the Windows
// SDK's import libraries a package calls (sync's synchronization, process's
// shell32, iocore's ws2_32 and ntdll) are named by that package's
// [link.windows]. Built each time it is run, since a capture of Visual
// Studio's environment again may find another link.exe.
fn runLink(s: &mut Session, objOrder: &List[Path], exe: &Path, libraries: &List[String], paths: &List[Path]) LinkRun {
  var command = List[String].empty();
  command.push(native(&s.linker.tool));
  command.push(String.from("/NOLOGO"));
  var i = 0usize;
  while i < objOrder.len() {
    command.push(native(&objOrder[i]));
    i = i + 1usize;
  }
  command.push(native(&s.linker.conestd));
  i = 0usize;
  while i < paths.len() {
    let place = native(&paths[i]);
    command.push(cat("/LIBPATH:", place.view()));
    i = i + 1usize;
  }
  i = 0usize;
  while i < libraries.len() {
    command.push(cat(libraries[i].view(), ".lib"));
    i = i + 1usize;
  }
  let exeText = native(exe);
  command.push(cat("/OUT:", exeText.view()));
  command.push(String.from("/SUBSYSTEM:CONSOLE"));
  command.push(String.from("msvcrt.lib"));
  command.push(String.from("legacy_stdio_definitions.lib"));
  // A release link folds identical functions: the net under the compiler's size
  // gate on generic instances (congo.py, Linker.command)
  if s.mode.equals("release") {
    command.push(String.from("/OPT:REF,ICF"));
    // and, unless stripped, writes the objects' debug info into a PDB beside
    // the program, which a profiler reads for names and lines
    if !s.strip { command.push(String.from("/DEBUG")); }
  }
  var changes = noChanges();
  s.linker.apply(&mut changes);
  var code = 0u32;
  var ran = true;
  var said = String.empty();
  match process.run(command.view()) {
    case let Ok(ok) {
      code = ok.exitCode;
      said = consoleText(ok.stdout.view());
      let err = consoleText(ok.stderr.view());
      said <- err.view();
    }
    case let Err(e) {
      ran = false;
      let why = e.message();
      said = cat(command[0usize].view(), " could not run: ", why.view(), "\n");
    }
  }
  changes.restore();
  LinkRun(command, code, ran, said)
}
