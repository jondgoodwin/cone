// Paths as Congo holds and shows them, and the environment lookups congo.py
// makes through os.environ and os.path.
//
// Congo holds every path as a 'Path', normalized as the fs and process
// packages give one ('C:/work/src': '/' between names, '..' read off). It
// prints a path, and hands one to a program it starts, as congo.py's pathlib
// spells it on Windows, with '\': 'native' turns one round, 'shown' is what a
// message says of one, and 'fsMessage' and 'processMessage' are the messages
// of the two packages' failures, which name their paths as they were given.

// A path as pathlib writes it on Windows, and as a child program is given
// it: every separator '\'
fn native(p &Path) String { backslashed(p.view()) }

// Text with every '/' written '\'
fn backslashed(text &str) String {
  var s = String.from(text);
  s.replaceByte('/', '\\');
  s
}

// Paths one after another, 'native', with sep between each two
fn nativeList(list &List[Path], sep &str) String {
  var out = String.empty();
  var i = 0usize;
  while i < list.len() {
    if i > 0usize { out <- sep; }
    let place = native(list[i]);
    out <- place.view();
    i = i + 1usize;
  }
  out
}

// What a failure of the fs package says, its paths written as 'native' writes
// them
fn fsMessage(e &fs.FsError) String {
  let place = native(&e.path);
  let other = native(&e.other);
  let same = new fs.FsError(e.op.copy(), Path.from(place.view()), Path.from(other.view()), e.code);
  same.message()
}

// What a failure of the process package says, its working folder written as
// 'native' writes a path
fn processMessage(e &process.ProcessError) String {
  let place = native(&e.dir);
  let same = new process.ProcessError(e.op.copy(), e.program.copy(), Path.from(place.view()), e.code);
  same.message()
}

// The absolute path, '..' read off (Path.resolve() without following links)
fn resolved(p &Path) Path {
  match fs.absolute(p) {
    case var ok Ok {
      var abs Path = "";
      abs <=> ok;
      abs
    }
    case is Error { p.normalize() }
  }
}

// Two paths the same, as Windows compares them: ASCII case ignored
fn samePath(a &Path, b &Path) bool {
  let s = String.from(a.view());
  s.equalsIgnoreAsciiCase(b.view())
}

// A path as a message shows it: relative to the current folder where it is
// below it (Path.relative_to, case ignored as Windows ignores it), else as it is
fn shown(p &Path) String {
  if not p.isAbsolute() { return native(p); }
  var here Path = "";
  match fs.currentDir() {
    case var ok Ok { here <=> ok; }
    case is Error { return native(p); }
  }
  let hereParts = here.parts();
  let parts = p.parts();
  if hereParts.len() > parts.len() { return native(p); }
  var i = 0usize;
  while i < hereParts.len() {
    let a = backslashed(hereParts[i].view());
    let b = backslashed(parts[i].view());
    if not a.equalsIgnoreAsciiCase(b.view()) { return native(p); }
    i = i + 1usize;
  }
  if i == parts.len() { return String.from("."); }
  var out = String.empty();
  while i < parts.len() {
    if not out.isEmpty() { out.appendByte('\\'); }
    out <- parts[i].view();
    i = i + 1usize;
  }
  out
}

// A variable's value, or None when it is not set; Windows' names ignore case
fn envGet(name &str) Option[String] { env.get(name) }

// A variable's value, or otherwise when it is not set
fn envOr(name &str, otherwise &str) String {
  match env.get(name) {
    case var v Some {
      var s = String.empty();
      s <=> v;
      s
    }
    case is None { String.from(otherwise) }
  }
}

fn envHas(name &str) bool { env.get(name) is Some }

// os.path.expanduser, Windows' way: '~' or '~user' at the start, from
// USERPROFILE, else HOMEDRIVE and HOMEPATH
fn expandUser(p &str) String {
  if p.len() == 0usize or p[0usize] != '~' { return String.from(p); }
  var i = 1usize;
  while i < p.len() and not path.isSeparator(p[i]) { i = i + 1usize; }
  var home Path = "";
  if envHas("USERPROFILE") {
    home = Path.fromString(envOr("USERPROFILE", ""));
  }
  elif not envHas("HOMEPATH") {
    return String.from(p);
  }
  else {
    let drive = Path.fromString(envOr("HOMEDRIVE", ""));
    let hp = envOr("HOMEPATH", "");
    home = drive.join(hp.view());
  }
  if i != 1usize {
    let target = &p[1usize..<i];
    let hasUser = envHas("USERNAME");
    let current = envOr("USERNAME", "");
    if not (hasUser and current.view() == target) {
      let base = String.from(home.name());
      if not (hasUser and current.view() == base.view()) { return String.from(p); }
      let up = home.parent();
      home = up.join(target);
    }
  }
  var out = String.from(home.view());
  out.append(&p[i..]);
  out
}

fn isVarByte(b u8) bool { isNameByte(b) or b == '-' }

// The index of byte b in p at or after from, or the length of p
fn findByte(p &str, b u8, from usize) usize {
  var i = from;
  while i < p.len() and p[i] != b { i = i + 1usize; }
  i
}

// os.path.expandvars, Windows' way: '%var%', '${var}' and '$var' replaced by
// the variable's value, an unknown one left as written; '%%' and '$$' are one
// '%' and one '$'; nothing inside single quotes is expanded
fn expandVars(p &str) String {
  var out = String.empty();
  var i = 0usize;
  while i < p.len() {
    let c = p[i];
    if c == '\'' {
      let q = findByte(p, '\'', i + 1usize);
      if q == p.len() {
        out.append(&p[i..]);
        i = p.len();
      }
      else {
        out.append(&p[i..<q + 1usize]);
        i = q + 1usize;
      }
    }
    elif c == '%' {
      if i + 1usize < p.len() and p[i + 1usize] == '%' {
        out.appendByte('%');
        i = i + 2usize;
      }
      else {
        let q = findByte(p, '%', i + 1usize);
        if q == p.len() {
          out.append(&p[i..]);
          i = p.len();
        }
        else {
          let name = &p[i + 1usize..<q];
          match envGet(name) {
            case let v Some { out <- v.view(); }
            case is None { out <- "%"; out.append(name); out <- "%"; }
          }
          i = q + 1usize;
        }
      }
    }
    elif c == '$' {
      if i + 1usize < p.len() and p[i + 1usize] == '$' {
        out.appendByte('$');
        i = i + 2usize;
      }
      elif i + 1usize < p.len() and p[i + 1usize] == '{' {
        let q = findByte(p, '}', i + 2usize);
        if q == p.len() {
          out.append(&p[i..]);
          i = p.len();
        }
        else {
          let name = &p[i + 2usize..<q];
          match envGet(name) {
            case let v Some { out <- v.view(); }
            case is None { out <- "${"; out.append(name); out <- "}"; }
          }
          i = q + 1usize;
        }
      }
      else {
        var q = i + 1usize;
        while q < p.len() and isVarByte(p[q]) { q = q + 1usize; }
        let name = &p[i + 1usize..<q];
        match envGet(name) {
          case let v Some { out <- v.view(); }
          case is None { out <- "$"; out.append(name); }
        }
        i = q;
      }
    }
    else {
      out.appendByte(c);
      i = i + 1usize;
    }
  }
  out
}

// shutil.which on Windows: the current folder first (unless
// NoDefaultCurrentDirectoryInExePath is set), then each folder of the PATH
// given, each name tried as it is (when its extension is one of PATHEXT's)
// and then with each of PATHEXT's extensions; a folder that is spelled the
// same as one before (case ignored) is not looked in twice. The empty path
// when none.
fn which(cmd &str, pathList &str) Path {
  if path.isSeparator(cmd[0usize]) or findByte(cmd, '\\', 0usize) < cmd.len() or findByte(cmd, '/', 0usize) < cmd.len() {
    let given = Path.from(cmd);
    let folder = given.parent();
    return whichIn(cmd, folder.view(), given.name());
  }
  if pathList.len() == 0usize { return Path.from(""); }
  var folders = String.empty();
  if not envHas("NoDefaultCurrentDirectoryInExePath") { folders <- ".;"; }
  folders.append(pathList);
  whichIn(cmd, folders.view(), cmd)
}

fn whichIn(cmd &str, folderList &str, file &str) Path {
  let pathext = envOr("PATHEXT", ".COM;.EXE;.BAT;.CMD;.VBS;.JS;.WS;.MSC");
  let exts = pathext.split(';');
  var files = List[String].empty();
  var direct = false;
  var i = 0usize;
  while i < exts.len() {
    var ext = exts[i].copy();
    while ext.endsWith(".") { ext = ext.sub(0usize, ext.len() - 1usize); }
    if not ext.isEmpty() {
      var upper = String.from(file);
      upper.upperAscii();
      var e = ext.copy();
      e.upperAscii();
      if upper.endsWith(e.view()) { direct = true; }
      files.push(cat(file, ext.view()));
    }
    i = i + 1usize;
  }
  if direct {
    var all = List[String].empty();
    all.push(String.from(file));
    i = 0usize;
    while i < files.len() {
      all.push(files[i].copy());
      i = i + 1usize;
    }
    files = all;
  }
  let folders = splitText(folderList, ';');
  var seen = List[String].empty();
  i = 0usize;
  while i < folders.len() {
    let dir = folders[i].view();
    // os.path.normcase: '/' as '\', lower case
    var norm = backslashed(dir);
    norm.lowerAscii();
    var before = false;
    var s = 0usize;
    while s < seen.len() {
      if seen[s].equals(norm.view()) { before = true; }
      s = s + 1usize;
    }
    if not before {
      seen.push(norm);
      let folder = Path.from(dir);
      var f = 0usize;
      while f < files.len() {
        let candidate = folder.join(files[f].view());
        if fs.exists(&candidate) and not fs.isDir(&candidate) { return candidate; }
        f = f + 1usize;
      }
    }
    i = i + 1usize;
  }
  Path.from("")
}
