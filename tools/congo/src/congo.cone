// Congo, the Cone build tool, written in Cone: the port of congo.py, which
// it matches message for message.
//
//     congo new <name> [--lib]          make a package folder
//     congo build [--release]           build the package the current folder is in
//     congo run [--release] [file.cone] [-- args...]
//                                       build it (or one lone file) and run it
//     congo test [name] [--release] [--bless]
//                                       build the package, run each program in
//                                       its tests/ and build each in examples/
//     congo clean [file.cone]           delete what a build wrote
//
// tools/congo/congo.py is how this program is first built (README.md,
// "Congo in Cone").
//
// CONGO DISCOVERS, THE COMPILER IS TOLD. Congo reads each source file's
// header -- its leading comments, its 'mod' line and its 'import' lines, and
// nothing after them. It resolves every import that names another package
// through the package-folder registries, orders the packages so that each is
// built after what it imports (refusing an import loop between packages, or
// between the modules of one), writes each package's BUILD DESCRIPTION into
// the build folder, compiles each package on its own with conec, and links
// the objects with conestd, and with the C libraries the packages' [link]
// tables name, into the executable. A package that others import is compiled
// as a library, and that compile GENERATES its INCLUDE FILE, <name>.cone
// beside its object: what an importer is compiled against in place of the
// package's source.
//
// The files of this module: commands.cone (the commands, and the current
// package), header.cone (the header scan and the names a module may not
// have), paths.cone (paths and the environment as congo.py's pathlib and
// os.path read them), registry.cone (manifests, the machine config, the
// registry), modules.cone (a package's module tree and its loops), order.cone
// (the build order and the build descriptions), linker.cone (conec, conestd
// and Microsoft's linker), build.cone (the compiles, the link and a build),
// test.cone ('congo test'), sha1.cone and util.cone. Windows only, as the
// process package and Congo's linking are for now.

mod congo;

import stdio use *;
import collections use *;
import libc;
import fs;
import path;
import env;
import process;
import toml;
import textdiff;

// The Cone repository this Congo belongs to: the nearest folder above its
// executable holding packages/core, as conec finds its packages folder; ""
// when there is none
fn findRepo() String {
  mut exe = String.empty();
  match process.currentExe() {
    case mut ok Ok { exe <=> ok.value; }
    case is Error { return String.empty(); }
  }
  imm start = winPath(exe.view());
  mut folder = parentOf(start.view());
  while true {
    imm core = joined(folder.view(), "packages\\core\\src\\core.cone");
    imm designated = joined(folder.view(), "packages\\core\\core.cone");
    if fs.isFile(core.view()) or fs.isFile(designated.view()) { return folder; }
    imm up = parentOf(folder.view());
    if up.equals(folder.view()) { return String.empty(); }
    folder = up;
  }
  String.empty();
}

// -------- the command line, as congo.py's argparse reads it --------

fn usageError(msg String) i32 {
  printFlush();
  eprintStr("usage: congo [-h] command ...\ncongo: error: ");
  eprintStr(msg.view());
  eprintStr("\n");
  2i32;
}

// A command's own usage line
fn commandUsage(command &[]u8) String {
  mut usage = cat("usage: congo ", command, " [-h]");
  if command == "new" { usage <- " [--lib] name [path]"; }
  elif command == "build" { usage <- " [--release]"; }
  elif command == "run" { usage <- " [--release] [file]"; }
  elif command == "test" { usage <- " [--release] [--bless] [name]"; }
  else { usage <- " [file]"; }
  usage;
}

// An error the command's own parser reports, under its usage line
fn commandError(command &[]u8, msg String) i32 {
  printFlush();
  imm usage = commandUsage(command);
  eprintStr(usage.view());
  eprintStr("\ncongo ");
  eprintStr(command);
  eprintStr(": error: ");
  eprintStr(msg.view());
  eprintStr("\n");
  2i32;
}

// Whether arg is '--name', or a long option abbreviated to a prefix of it
fn isOption(arg &[]u8, name &[]u8) Bool {
  if arg.len < 3usize or arg.len > name.len { return false; }
  &name[..arg.len] == arg;
}

fn isHelp(arg &[]u8) Bool { arg == "-h" or isOption(arg, "--help"); }

// Whether argparse reads arg as an option: a '-' and more, but not a
// negative number
fn looksLikeOption(arg &[]u8) Bool {
  if arg.len < 2usize or arg[0usize] != '-' { return false; }
  mut i = 1usize;
  while i < arg.len {
    if not ((arg[i] >= '0' and arg[i] <= '9') or arg[i] == '.') { return true; }
    i = i + 1usize;
  }
  false;
}

fn topHelp() i32 {
  printStr("usage: congo [-h] command ...\n\nThe Cone build tool.\n\npositional arguments:\n  command\n");
  printStr("    new       make a package folder\n    build     build this package\n");
  printStr("    run       build this package or a lone file, and run it\n");
  printStr("    test      build this package, run its tests and build its examples\n");
  printStr("    clean     delete what a build wrote\n\noptions:\n  -h, --help  show this help message and exit\n");
  0i32;
}

fn commandHelp(command &[]u8) i32 {
  imm usage = commandUsage(command);
  printStr(usage.view());
  printStr("\n\n");
  if command == "new" {
    printStr("positional arguments:\n  name        the package's name\n");
    printStr("  path        the folder to make (default: the name)\n\noptions:\n");
    printStr("  -h, --help  show this help message and exit\n");
    printStr("  --lib       a library package, whose include file its build generates\n");
  }
  elif command == "build" {
    printStr("options:\n  -h, --help  show this help message and exit\n  --release   an optimised build\n");
  }
  elif command == "run" {
    printStr("positional arguments:\n  file        a lone .cone file, run with no manifest\n\noptions:\n");
    printStr("  -h, --help  show this help message and exit\n  --release   an optimised build\n\n");
    printStr("Arguments after '--' are passed to the program.\n");
  }
  elif command == "test" {
    printStr("positional arguments:\n  name        only the tests and examples whose file name contains this\n\noptions:\n");
    printStr("  -h, --help  show this help message and exit\n  --release   an optimised build\n");
    printStr("  --bless     write the expected output of a test that has none, from a run;\n");
    printStr("              check it by hand against the source\n");
  }
  else {
    printStr("positional arguments:\n  file        a lone .cone file whose build to delete\n\noptions:\n");
    printStr("  -h, --help  show this help message and exit\n");
  }
  0i32;
}

fn main() i32 {
  imm all = process.args();
  // What follows '--' is the program's, and the command line never sees it
  mut argv = List[String].empty();
  mut programArgs = List[String].empty();
  mut i = 1usize;
  mut after = false;
  while i < all.len() {
    if not after and all[i].equals("--") { after = true; }
    elif after { programArgs.push(all[i].copy()); }
    else { argv.push(all[i].copy()); }
    i = i + 1usize;
  }
  // The command: the first argument that is not an option
  mut extras = List[String].empty();
  mut at = 0usize;
  while at < argv.len() and looksLikeOption(argv[at].view()) {
    if isHelp(argv[at].view()) { return topHelp(); }
    extras.push(argv[at].copy());
    at = at + 1usize;
  }
  if at == argv.len() { return usageError(String.from("the following arguments are required: command")); }
  imm command = argv[at].view();
  if not (command == "new" or command == "build" or command == "run" or command == "test" or command == "clean") {
    return usageError(cat("argument command: invalid choice: '", command,
      "' (choose from new, build, run, test, clean)"));
  }
  // new name [path] [--lib]; build [--release]; run [--release] [file];
  // test [name] [--release] [--bless]; clean [file]. Each option is a
  // flag, read where it stands, as is '-h'
  mut release = false;
  mut lib = false;
  mut bless = false;
  mut positionals = List[String].empty();
  mut most = 1usize;
  if command == "new" { most = 2usize; }
  elif command == "build" { most = 0usize; }
  imm hasRelease = command == "build" or command == "run" or command == "test";
  i = at + 1usize;
  while i < argv.len() {
    imm arg = argv[i].view();
    if isHelp(arg) { return commandHelp(command); }
    imm eq = findByte(arg, '=', 0usize);
    mut explicit &[]u8 = "";
    if arg.len >= 2usize and arg[0usize] == '-' and eq < arg.len {
      // '--flag=value': a flag takes no value
      imm opt = &arg[..eq];
      if opt == "-h" or isOption(opt, "--help") { explicit = "-h/--help"; }
      elif hasRelease and isOption(opt, "--release") { explicit = "--release"; }
      elif command == "new" and isOption(opt, "--lib") { explicit = "--lib"; }
      elif command == "test" and isOption(opt, "--bless") { explicit = "--bless"; }
    }
    if explicit.len > 0usize {
      return commandError(command, cat("argument ", explicit, ": ignored explicit argument '", &arg[eq + 1usize..], "'"));
    }
    if hasRelease and isOption(arg, "--release") { release = true; }
    elif command == "new" and isOption(arg, "--lib") { lib = true; }
    elif command == "test" and isOption(arg, "--bless") { bless = true; }
    elif looksLikeOption(arg) or positionals.len() >= most { extras.push(String.from(arg)); }
    else { positionals.push(String.from(arg)); }
    i = i + 1usize;
  }
  if command == "new" and positionals.len() == 0usize {
    return commandError(command, String.from("the following arguments are required: name"));
  }
  if extras.len() > 0usize {
    imm listed = String.join(extras.view(), " ");
    return usageError(cat("unrecognized arguments: ", listed.view()));
  }
  if command == "new" {
    if positionals.len() > 1usize { return cmdNew(positionals[0usize].view(), positionals[1usize].view(), lib); }
    return cmdNew(positionals[0usize].view(), "", lib);
  }
  if command == "build" { return cmdBuild(release); }
  if command == "test" {
    if positionals.len() > 0usize { return cmdTest(positionals[0usize].view(), true, release, bless); }
    return cmdTest("", false, release, bless);
  }
  imm hasFile = positionals.len() > 0usize;
  mut file = String.empty();
  if hasFile { file = positionals[0usize].copy(); }
  if command == "run" { cmdRun(file.view(), hasFile, release, &programArgs); }
  else { cmdClean(file.view(), hasFile); }
}
