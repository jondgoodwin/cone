// Congo, the Cone build tool, written in Cone: stage 1 of the port from
// congo.py, which it matches message for message on what it does.
//
//     congo run [--release] <file.cone> [-- args...]
//                                       build one lone file and run it
//     congo clean <file.cone>           delete what a lone file's build wrote
//
// The rest of congo.py (a package's manifest: 'new', 'build', 'run' and
// 'clean' in a package, 'test') is not here yet; tools/congo/congo.py does
// it, and is how this program is built (README.md, "Congo in Cone").
//
// CONGO DISCOVERS, THE COMPILER IS TOLD. Congo reads each source file's
// header -- its leading comments, its 'mod' line and its 'import' lines, and
// nothing after them. It resolves every import that names another package
// through the package-folder registries, orders the packages so that each is
// built after what it imports (refusing an import loop between packages, or
// between the modules of one), writes each package's BUILD DESCRIPTION into
// the build folder, compiles each package on its own with conec, and links
// the objects with conestd, and with the C libraries the packages' [link]
// tables name, into the executable. A package that others import is compiled
// as a library, and that compile GENERATES its INCLUDE FILE, <name>.cone
// beside its object: what an importer is compiled against in place of the
// package's source.
//
// The files of this module: header.cone (the header scan and the names a
// module may not have), paths.cone (paths and the environment as congo.py's
// pathlib and os.path read them), registry.cone (manifests, the machine
// config, the registry), modules.cone (a package's module tree and its
// loops), order.cone (the build order and the build descriptions),
// linker.cone (conec, conestd and Microsoft's linker), build.cone (the
// compiles and the link), sha1.cone and util.cone. Windows only, as the
// process package and Congo's linking are for now.

mod congo;

import stdio use *;
import collections use *;
import libc;
import fs;
import path;
import env;
import process;
import toml;

// The Cone repository this Congo belongs to: the nearest folder above its
// executable holding packages/core, as conec finds its packages folder; ""
// when there is none
fn findRepo() String {
  mut exe = String.empty();
  match process.currentExe() {
    case mut ok Ok { exe <=> ok.value; }
    case is Error { return String.empty(); }
  }
  imm start = winPath(exe.view());
  mut folder = parentOf(start.view());
  while true {
    imm core = joined(folder.view(), "packages\\core\\src\\core.cone");
    imm designated = joined(folder.view(), "packages\\core\\core.cone");
    if fs.isFile(core.view()) or fs.isFile(designated.view()) { return folder; }
    imm up = parentOf(folder.view());
    if up.equals(folder.view()) { return String.empty(); }
    folder = up;
  }
  String.empty();
}

// -------- commands --------

// Build a lone file and run it, passing on its exit code
fn cmdRun(file &[]u8, release Bool, programArgs &List[String]) i32 {
  imm repo = findRepo();
  imm pkg = lonePackage(file);
  mut mode &[]u8 = "debug";
  if release { mode = "release"; }
  imm folders = registryFolders(repo.view());
  mut reg = readRegistry(folders);
  imm root = loneBuildRoot(pkg.src.view());
  imm out = joined(root.view(), mode);
  imm name = pkg.name.copy();
  imm top = reg.add(pkg);
  imm plan = buildOrder(&reg, top);
  // Found at the first compile, after the imports are resolved, so that an
  // error in the source is reported before anything about the machine
  imm conec = findConec(repo.view());
  imm objs = compileAll(&reg, &plan, top, out.view(), mode, conec.view());
  imm exeName = cat(name.view(), ".exe");
  imm exe = joined(out.view(), exeName.view());
  link(&reg, &plan, &objs, exe.view(), conec.view());
  imm place = shown(exe.view());
  imm finished = cat(mode, " ", place.view());
  say("Finished", finished.view());
  say("Running", place.view());
  mut args = List[String].empty();
  args.push(exe.copy());
  mut i = 0usize;
  while i < programArgs.len() {
    args.push(programArgs[i].copy());
    i = i + 1usize;
  }
  match process.run(args.view(), new process.Options(inherit: true)) {
    case imm ok Ok { ok.value.exitCode as i32; }
    case imm e Error {
      fail(e.value.message());
    }
  }
}

// Delete a lone file's build
fn cmdClean(file &[]u8) i32 {
  imm p = winPath(file);
  imm target = loneBuildRoot(p.view());
  if fs.exists(target.view()) {
    match fs.removeAll(target.view()) {
      case is Ok {}
      case imm e Error {
        fail(e.value.message());
      }
    }
    imm place = shown(target.view());
    say("Removed", place.view());
  }
  0i32;
}

// -------- the command line, as congo.py's argparse reads it --------

fn usageError(msg String) i32 {
  printFlush();
  eprintStr("usage: congo [-h] command ...\ncongo: error: ");
  eprintStr(msg.view());
  eprintStr("\n");
  2i32;
}

// Whether arg is '--name', or a long option abbreviated to a prefix of it
fn isOption(arg &[]u8, name &[]u8) Bool {
  if arg.len < 3usize or arg.len > name.len { return false; }
  &name[..arg.len] == arg;
}

fn isHelp(arg &[]u8) Bool { arg == "-h" or isOption(arg, "--help"); }

// Whether argparse reads arg as an option: a '-' and more, but not a
// negative number
fn looksLikeOption(arg &[]u8) Bool {
  if arg.len < 2usize or arg[0usize] != '-' { return false; }
  mut i = 1usize;
  while i < arg.len {
    if not ((arg[i] >= '0' and arg[i] <= '9') or arg[i] == '.') { return true; }
    i = i + 1usize;
  }
  false;
}

fn topHelp() i32 {
  printStr("usage: congo [-h] command ...\n\nThe Cone build tool.\n\npositional arguments:\n  command\n");
  printStr("    new       make a package folder\n    build     build this package\n");
  printStr("    run       build this package or a lone file, and run it\n");
  printStr("    test      build this package, run its tests and build its examples\n");
  printStr("    clean     delete what a build wrote\n\noptions:\n  -h, --help  show this help message and exit\n");
  0i32;
}

fn runHelp() i32 {
  printStr("usage: congo run [-h] [--release] [file]\n\npositional arguments:\n");
  printStr("  file        a lone .cone file, run with no manifest\n\noptions:\n");
  printStr("  -h, --help  show this help message and exit\n  --release   an optimised build\n\n");
  printStr("Arguments after '--' are passed to the program.\n");
  0i32;
}

fn cleanHelp() i32 {
  printStr("usage: congo clean [-h] [file]\n\npositional arguments:\n");
  printStr("  file        a lone .cone file whose build to delete\n\noptions:\n");
  printStr("  -h, --help  show this help message and exit\n");
  0i32;
}

// What this Congo cannot do yet: everything that reads a package's manifest
fn notYet(what &[]u8) i32 {
  fail(cat("'congo ", what, "' needs a package's manifest, which this Congo (written in Cone, stage 1) does not read yet; it runs and cleans a lone file. Python's tools/congo/congo.py does the rest"));
}

fn main() i32 {
  imm all = process.args();
  // What follows '--' is the program's, and the command line never sees it
  mut argv = List[String].empty();
  mut programArgs = List[String].empty();
  mut i = 1usize;
  mut after = false;
  while i < all.len() {
    if not after and all[i].equals("--") { after = true; }
    elif after { programArgs.push(all[i].copy()); }
    else { argv.push(all[i].copy()); }
    i = i + 1usize;
  }
  // The command: the first argument that is not an option
  mut extras = List[String].empty();
  mut at = 0usize;
  while at < argv.len() and looksLikeOption(argv[at].view()) {
    if isHelp(argv[at].view()) { return topHelp(); }
    extras.push(argv[at].copy());
    at = at + 1usize;
  }
  if at == argv.len() { return usageError(String.from("the following arguments are required: command")); }
  imm command = argv[at].view();
  if not (command == "new" or command == "build" or command == "run" or command == "test" or command == "clean") {
    return usageError(cat("argument command: invalid choice: '", command,
      "' (choose from new, build, run, test, clean)"));
  }
  if command == "new" or command == "build" or command == "test" { return notYet(command); }
  // run [--release] [file]; clean [file]
  mut release = false;
  mut file = String.empty();
  mut hasFile = false;
  i = at + 1usize;
  while i < argv.len() {
    imm arg = argv[i].view();
    if isHelp(arg) { return if command == "run" {runHelp();} else {cleanHelp();}; }
    if command == "run" and isOption(arg, "--release") { release = true; }
    elif looksLikeOption(arg) or hasFile { extras.push(String.from(arg)); }
    else {
      file = String.from(arg);
      hasFile = true;
    }
    i = i + 1usize;
  }
  if extras.len() > 0usize {
    imm listed = String.join(extras.view(), " ");
    return usageError(cat("unrecognized arguments: ", listed.view()));
  }
  if not hasFile {
    return notYet(if command == "run" {"run";} else {"clean";});
  }
  if command == "run" { cmdRun(file.view(), release, &programArgs); }
  else { cmdClean(file.view()); }
}
