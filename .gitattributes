.gitattributes export-ignore
.gitignore export-ignore
makebuild export-ignore

# Line endings under test/.
#
# The compiler echoes the offending source line verbatim into every located
# diagnostic, so a CRLF working tree changes what a compile prints: the echo
# loop copies the carriage return, and stderr's text mode then turns its own
# newline into a second line ending, moving the caret line that carries
# line:column. With core.autocrlf on, the same scenario therefore produced
# different output depending on how git checked it out.
#
# test/run.py tolerates both, and is tested both ways. This pins the question
# anyway, so that what a scenario provokes does not depend on the clone.
# Scoped to test/ deliberately: the rest of the repository is left alone rather
# than renormalized in a change about the test suite.
test/** text eol=lf

# The exceptions, kept byte for byte in every checkout: a scenario whose
# subject is a CRLF source, three whose source ends at a null character
# placed right after an unfinished token, and one that holds control
# characters, a byte that is not UTF-8 and a CRLF line. Git would call the next
# four binary, so 'diff' keeps their changes readable. The last two are a
# backslash before a line's end, one file LF and its twin CRLF, where which
# line end it is decides what the lexer does.
test/cases/lexical/lexical_mlstring_crlf.cone -text
test/cases/lexical/lexical_reject_unclosed_char.cone -text diff
test/cases/lexical/lexical_reject_unclosed_backtick.cone -text diff
test/cases/lexical/lexical_reject_short_escape_end.cone -text diff
test/cases/lexical/lexical_reject_bad_escape.cone -text diff
test/cases/lexical/lexical_reject_escape_newline.cone -text diff
test/cases/lexical/lexical_reject_escape_newline_crlf.cone -text diff
