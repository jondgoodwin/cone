<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Windows gives conec its arguments, environment, current folder and file
     names in UTF-8, which is what conec holds paths in and what LLVM reads
     them as (compiler/c/doc/compiler/architecture.md, "Paths are UTF-8") -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
